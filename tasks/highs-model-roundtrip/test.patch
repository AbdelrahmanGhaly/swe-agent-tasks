+#!/bin/bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")" || exit 1
+if [ -n "$OUTPUT_PATH" ]; then mkdir -p "$(dirname "$OUTPUT_PATH")"; fi
+
+TAG="[highs_model_round_trip]"
+BUILD_LOG=$(mktemp)
+
+cmake -S . -B build -GNinja -DCMAKE_BUILD_TYPE=Release -DALL_TESTS=ON \
+  > "$BUILD_LOG" 2>&1
+cmake --build build -j >> "$BUILD_LOG" 2>&1
+BUILD_STATUS=$?
+
+NEW_TESTS="round-trip-lp-boxed-row
+round-trip-lp-boxed-row-negative-bounds
+round-trip-lp-single-variable-range-stays-a-row
+round-trip-lp-free-row
+round-trip-lp-equality-row-unchanged
+round-trip-lp-one-sided-rows-unchanged
+read-lp-two-sided-constraint-ascending
+read-lp-two-sided-constraint-descending
+read-lp-two-sided-constraint-unnamed
+read-lp-two-sided-constraint-equal-bounds
+read-lp-reversed-range-is-an-error
+read-lp-mixed-orientation-range-is-an-error
+round-trip-lp-objective-name-is-preserved
+round-trip-lp-costless-empty-column-survives
+round-trip-lp-column-order-is-preserved
+read-lp-reversed-descending-range-is-an-error
+read-lp-opposite-mixed-orientation-range-is-an-error
+read-lp-bounds-section-still-bounds-columns
+round-trip-lp-semi-integer
+round-trip-lp-semi-continuous
+round-trip-lp-every-integrality
+round-trip-lp-objective-sense-and-offset
+round-trip-lp-solution-is-unchanged
+fixed-format-mps-binary-bound
+fixed-format-mps-integer-lower-bound
+fixed-format-mps-integer-upper-bound
+fixed-format-mps-semi-continuous-bound
+fixed-format-mps-semi-integer-bound
+fixed-format-mps-minus-infinity-bound-unchanged
+fixed-format-mps-upper-bound-unchanged
+fixed-format-mps-unknown-bound-is-an-error
+fixed-format-mps-unknown-bound-with-unknown-column-is-an-error
+round-trip-mps-integer-with-infinite-bounds
+round-trip-mps-under-both-parsers
+round-trip-mps-semi-variable-with-equal-bounds
+round-trip-mps-unbounded-integer-zero-column
