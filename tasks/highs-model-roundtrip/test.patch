+mps-discarded-free-row-ignores-its-range
+mps-kept-free-row-ignores-its-range
+round-trip-mps-objective-sense-and-offset-under-both-parsers
+mps-discarded-free-row-ignores-its-right-hand-side
+mps-free-row-kept-under-both-parsers
+mps-free-row-entries-dropped-under-both-parsers
+round-trip-lp-keyword-named-column-survives
+round-trip-lp-value-spelled-column-names-survive
+round-trip-lp-value-spelled-column-name-in-the-objective-survives
+round-trip-lp-value-spelled-column-name-in-a-quadratic-term-survives
+round-trip-lp-value-spelled-column-name-before-another-term-survives
+round-trip-lp-value-spelled-column-name-in-a-row-survives
+round-trip-lp-value-spelled-integrality-names-survive
+round-trip-mps-semi-variable-with-infinite-threshold
+write-lp-row-forms-are-as-described
+write-mps-free-row-is-an-n-row
+round-trip-mps-objective-name-under-both-parsers
+round-trip-mps-costless-empty-column-survives
+round-trip-mps-semi-variable-with-infinite-bound"
+
+write_build_failure_xml() {
+  local out="$1"
+  local detail
+  detail=$(tail -c 4000 "$BUILD_LOG" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' \
+    -e 's/>/\&gt;/g' -e 's/"/\&quot;/g')
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo '<testsuites>'
+    if [ "$MODE" = "new" ]; then
+      local n
+      n=$(printf '%s\n' "$NEW_TESTS" | wc -l)
+      echo "  <testsuite name=\"unit_tests\" tests=\"$n\" failures=\"$n\" errors=\"0\">"
+      printf '%s\n' "$NEW_TESTS" | while IFS= read -r name; do
+        [ -z "$name" ] && continue
+        echo "    <testcase classname=\"unit_tests\" name=\"$name\"><failure message=\"build failed\"><![CDATA[$detail]]></failure></testcase>"
+      done
+    else
+      echo '  <testsuite name="unit_tests" tests="1" failures="1" errors="0">'
+      echo "    <testcase classname=\"unit_tests\" name=\"compilation\"><failure message=\"build failed\"><![CDATA[$detail]]></failure></testcase>"
+    fi
+    echo '  </testsuite>'
+    echo '</testsuites>'
+  } > "$out"
+}
+
+if [ $BUILD_STATUS -ne 0 ]; then
+  cat "$BUILD_LOG" >&2
+  if [ -n "$OUTPUT_PATH" ]; then write_build_failure_xml "$OUTPUT_PATH"; fi
+  exit 1
+fi
+
+cd build || exit 1
+STATUS=0
+
+if [ "$MODE" = "base" ]; then
+  if [ -n "$OUTPUT_PATH" ]; then
+    ./bin/unit_tests "~$TAG" -r junit -o "$OUTPUT_PATH"
+  else
+    ./bin/unit_tests "~$TAG"
+  fi
+  STATUS=$?
+else
+  # Each new test runs in its own process. A test that makes the base binary
+  # abort would otherwise take the rest of the run with it, leaving those
+  # cases with no result at all
+  PARTS=$(mktemp -d)
+  INDEX=0
+  while IFS= read -r name; do
+    [ -z "$name" ] && continue
+    INDEX=$((INDEX + 1))
+    CASE_XML="$PARTS/$INDEX.xml"
+    CASE_LOG="$PARTS/$INDEX.log"
+    ./bin/unit_tests "$name" -r junit -o "$CASE_XML" > "$CASE_LOG" 2>&1
+    CASE_STATUS=$?
+    [ "$CASE_STATUS" -ne 0 ] && STATUS=1
+    if ! grep -q '<testcase' "$CASE_XML" 2>/dev/null; then
+      detail=$(tail -c 2000 "$CASE_LOG" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g'         -e 's/>/\&gt;/g' -e 's/"/\&quot;/g')
+      printf '    <testcase classname="unit_tests.global" name="%s"><failure message="test did not report a result"><![CDATA[%s]]></failure></testcase>
+'         "$name" "$detail" > "$CASE_XML"
+      STATUS=1
+    fi
+  done <<EOF
+$NEW_TESTS
+EOF
+  if [ -n "$OUTPUT_PATH" ]; then
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      echo '<testsuites>'
+      echo '  <testsuite name="unit_tests">'
+      for part in "$PARTS"/*.xml; do
+        sed -e '/<?xml/d' -e '/<testsuites/d' -e '/<\/testsuites>/d'             -e '/<testsuite /d' -e '/<\/testsuite>/d' "$part"
+      done
+      echo '  </testsuite>'
+      echo '</testsuites>'
+    } > "$OUTPUT_PATH"
+  fi
+  rm -rf "$PARTS"
+fi
+
+if [ -n "$OUTPUT_PATH" ] && ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  write_build_failure_xml "$OUTPUT_PATH"
+fi
+
+exit $STATUS
