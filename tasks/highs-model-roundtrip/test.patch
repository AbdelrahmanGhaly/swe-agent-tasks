+  REQUIRE(free_read.row_names_[0] == "FREE1");
+  requireRowEntries(free_read, 0, {}, {});
+  REQUIRE(free_read.row_names_[1] == "R1");
+  requireRowEntries(free_read, 1, {0}, {1});
+
+  const HighsLp fixed_read =
+      readWithKeepNRows("rt_nrow_entries_fixed_cb2617.mps", false, 0);
+  REQUIRE(fixed_read.num_row_ == free_read.num_row_);
+  REQUIRE(fixed_read.a_matrix_.numNz() == free_read.a_matrix_.numNz());
+  REQUIRE(fixed_read.row_names_[0] == "FREE1");
+  requireRowEntries(fixed_read, 0, {}, {});
+  REQUIRE(fixed_read.row_names_[1] == "R1");
+  requireRowEntries(fixed_read, 1, {0}, {1});
+}
