+TEST_CASE("mps-free-row-kept-under-both-parsers",
+          "[highs_model_round_trip]") {
+  const HighsLp free_drop =
+      readWithKeepNRows("rt_nrow_drop_free_cb2617.mps", true, -1);
+  REQUIRE(free_drop.num_row_ == 1);
+  const HighsLp fixed_drop =
+      readWithKeepNRows("rt_nrow_drop_fixed_cb2617.mps", false, -1);
+  REQUIRE(fixed_drop.num_row_ == 1);
+
+  const HighsLp free_read =
+      readWithKeepNRows("rt_nrow_keep_free_cb2617.mps", true, 1);
+  REQUIRE(free_read.num_row_ == 2);
+  REQUIRE(free_read.row_names_[0] == "FREE1");
+  REQUIRE(free_read.row_lower_[0] <= -rt_inf);
+  REQUIRE(free_read.row_upper_[0] >= rt_inf);
+  REQUIRE(free_read.a_matrix_.numNz() == 2);
+  requireRowEntries(free_read, 0, {0}, {3});
+  requireRowEntries(free_read, 1, {0}, {1});
+
+  const HighsLp fixed_read =
+      readWithKeepNRows("rt_nrow_keep_fixed_cb2617.mps", false, 1);
+  REQUIRE(fixed_read.num_row_ == free_read.num_row_);
+  REQUIRE(fixed_read.row_lower_[0] <= -rt_inf);
+  REQUIRE(fixed_read.row_upper_[0] >= rt_inf);
+  REQUIRE(fixed_read.a_matrix_.numNz() == free_read.a_matrix_.numNz());
+}
+
+TEST_CASE("mps-free-row-entries-dropped-under-both-parsers",
+          "[highs_model_round_trip]") {
+  const HighsLp free_read =
+      readWithKeepNRows("rt_nrow_entries_free_cb2617.mps", true, 0);
+  REQUIRE(free_read.num_row_ == 2);
