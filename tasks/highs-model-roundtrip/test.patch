+static HighsLp readWithKeepNRows(const std::string& file_name,
+                                 const bool free_parser,
+                                 const HighsInt keep_n_rows) {
+  writeTextFile(file_name, free_row_mps);
+  Highs highs;
+  quiet(highs);
+  REQUIRE(highs.setOptionValue("mps_parser_type_free", free_parser) ==
+          HighsStatus::kOk);
+  REQUIRE(highs.setOptionValue("keep_n_rows", keep_n_rows) == HighsStatus::kOk);
+  // Discarding a free row leaves its COLUMNS entries referring to a row the
+  // fixed format reader no longer knows, which it reports as a warning
+  REQUIRE(highs.readModel(file_name) != HighsStatus::kError);
+  return highs.getLp();
+}
