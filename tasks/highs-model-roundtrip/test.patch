+static HighsLp roundTripMps(const HighsLp& lp, const std::string& file_name,
+                            const bool free_parser) {
+  Highs writer;
+  quiet(writer);
+  REQUIRE(writer.passModel(lp) == HighsStatus::kOk);
+  REQUIRE(writer.writeModel(file_name) == HighsStatus::kOk);
+
+  Highs reader;
+  quiet(reader);
+  REQUIRE(reader.setOptionValue("mps_parser_type_free", free_parser) ==
+          HighsStatus::kOk);
+  REQUIRE(reader.readModel(file_name) == HighsStatus::kOk);
+  return reader.getLp();
+}
