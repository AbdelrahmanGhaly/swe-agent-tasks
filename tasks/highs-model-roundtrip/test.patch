+    "BOUNDS\n";
+
+static HighsLp readFixedFormat(const std::string& file_name,
+                               const std::string& bounds,
+                               const HighsStatus expected) {
+  writeTextFile(file_name, fixed_format_header + bounds + "ENDATA\n");
+  Highs highs;
+  quiet(highs);
+  REQUIRE(highs.setOptionValue("mps_parser_type_free", false) ==
+          HighsStatus::kOk);
+  REQUIRE(highs.readModel(file_name) == expected);
+  return highs.getLp();
+}
