+#include <algorithm>
+#include <cstdio>
+#include <fstream>
+#include <iterator>
+#include <utility>
+
+#include "HCheckConfig.h"
+#include "Highs.h"
+#include "catch.hpp"
+
+const bool dev_run = false;
+const double rt_inf = kHighsInf;
+
+static void quiet(Highs& highs) {
+  if (!dev_run) highs.setOptionValue("output_flag", false);
+}
+
+static void addNamedCol(Highs& highs, const std::string& name,
+                        const double cost, const double lower,
+                        const double upper) {
+  const HighsInt iCol = highs.getNumCol();
+  REQUIRE(highs.addCol(cost, lower, upper, 0, nullptr, nullptr) ==
+          HighsStatus::kOk);
+  REQUIRE(highs.passColName(iCol, name) == HighsStatus::kOk);
+}
+
+static void addNamedRow(Highs& highs, const std::string& name,
+                        const double lower, const double upper,
+                        const std::vector<HighsInt>& index,
+                        const std::vector<double>& value) {
+  const HighsInt iRow = highs.getNumRow();
+  REQUIRE(highs.addRow(lower, upper, HighsInt(index.size()), index.data(),
+                       value.data()) == HighsStatus::kOk);
+  REQUIRE(highs.passRowName(iRow, name) == HighsStatus::kOk);
+}
+
+static void addTwoColumns(Highs& highs) {
+  addNamedCol(highs, "x", 1, 0, 10);
+  addNamedCol(highs, "y", 2, 0, 10);
+}
+
+static void writeTextFile(const std::string& file_name,
+                          const std::string& contents) {
+  std::ofstream out(file_name.c_str());
+  out << contents;
+  out.close();
+}
+
+static std::vector<std::vector<std::pair<HighsInt, double>>> columnEntries(
+    const HighsLp& lp) {
+  HighsSparseMatrix matrix = lp.a_matrix_;
+  matrix.ensureColwise();
+  std::vector<std::vector<std::pair<HighsInt, double>>> entries(lp.num_col_);
+  for (HighsInt iCol = 0; iCol < lp.num_col_; iCol++) {
+    for (HighsInt iEl = matrix.start_[iCol]; iEl < matrix.start_[iCol + 1];
+         iEl++)
+      entries[iCol].push_back({matrix.index_[iEl], matrix.value_[iEl]});
+    std::sort(entries[iCol].begin(), entries[iCol].end());
+  }
+  return entries;
+}
+
+static void requireSameModel(const HighsLp& before, const HighsLp& after) {
+  REQUIRE(after.num_col_ == before.num_col_);
+  REQUIRE(after.num_row_ == before.num_row_);
+  REQUIRE(after.sense_ == before.sense_);
+  REQUIRE(after.offset_ == before.offset_);
+  for (HighsInt iCol = 0; iCol < before.num_col_; iCol++) {
+    REQUIRE(after.col_names_[iCol] == before.col_names_[iCol]);
+    REQUIRE(after.col_cost_[iCol] == before.col_cost_[iCol]);
+    REQUIRE(after.col_lower_[iCol] == before.col_lower_[iCol]);
+    REQUIRE(after.col_upper_[iCol] == before.col_upper_[iCol]);
+  }
+  for (HighsInt iRow = 0; iRow < before.num_row_; iRow++) {
+    REQUIRE(after.row_names_[iRow] == before.row_names_[iRow]);
+    REQUIRE(after.row_lower_[iRow] == before.row_lower_[iRow]);
+    REQUIRE(after.row_upper_[iRow] == before.row_upper_[iRow]);
+  }
+  REQUIRE(after.integrality_.size() == before.integrality_.size());
+  for (size_t iCol = 0; iCol < before.integrality_.size(); iCol++)
+    REQUIRE(after.integrality_[iCol] == before.integrality_[iCol]);
+  REQUIRE(columnEntries(after) == columnEntries(before));
+}
+
+static void requireRowEntries(const HighsLp& lp, const HighsInt iRow,
+                              const std::vector<HighsInt>& index,
+                              const std::vector<double>& value) {
+  HighsSparseMatrix matrix = lp.a_matrix_;
+  matrix.ensureRowwise();
+  const HighsInt from = matrix.start_[iRow];
+  const HighsInt to = matrix.start_[iRow + 1];
+  REQUIRE(to - from == HighsInt(index.size()));
+  for (HighsInt iEl = from; iEl < to; iEl++) {
+    REQUIRE(matrix.index_[iEl] == index[iEl - from]);
+    REQUIRE(matrix.value_[iEl] == value[iEl - from]);
+  }
+}
+
+static void requireIntegralityCount(const HighsLp& lp, const size_t count) {
+  REQUIRE(lp.integrality_.size() == count);
+}
+
+static HighsLp roundTripLp(const HighsLp& lp, const std::string& file_name) {
+  Highs writer;
+  quiet(writer);
+  REQUIRE(writer.passModel(lp) == HighsStatus::kOk);
+  REQUIRE(writer.writeModel(file_name) == HighsStatus::kOk);
+
+  Highs reader;
+  quiet(reader);
+  REQUIRE(reader.readModel(file_name) == HighsStatus::kOk);
+  return reader.getLp();
+}
+
+static void requireValidRangeParses(const std::string& file_name,
+                                    const std::string& body,
+                                    const double lower, const double upper) {
+  writeTextFile(file_name, body);
+  Highs highs;
+  quiet(highs);
+  REQUIRE(highs.readModel(file_name) == HighsStatus::kOk);
+  const HighsLp& lp = highs.getLp();
+  REQUIRE(lp.num_row_ == 1);
+  REQUIRE(lp.row_lower_[0] == lower);
+  REQUIRE(lp.row_upper_[0] == upper);
+}
+
+static void requireFileIsRejected(const std::string& file_name,
+                                  const std::string& body) {
+  writeTextFile(file_name, body);
+  Highs highs;
+  quiet(highs);
+  REQUIRE(highs.readModel(file_name) == HighsStatus::kError);
+}
+
+static std::string readTextFile(const std::string& file_name) {
+  std::ifstream in(file_name.c_str());
+  std::string contents((std::istreambuf_iterator<char>(in)),
+                       std::istreambuf_iterator<char>());
+  in.close();
+  return contents;
+}
+
+static std::string lineContaining(const std::string& text,
+                                  const std::string& needle) {
+  size_t at = text.find(needle);
+  REQUIRE(at != std::string::npos);
+  size_t begin = text.rfind('\n', at);
+  begin = begin == std::string::npos ? 0 : begin + 1;
+  size_t end = text.find('\n', at);
+  end = end == std::string::npos ? text.size() : end;
+  return text.substr(begin, end - begin);
+}
+
+static size_t countOccurrences(const std::string& text,
+                               const std::string& needle) {
+  size_t count = 0;
+  size_t at = text.find(needle);
+  while (at != std::string::npos) {
+    count++;
+    at = text.find(needle, at + needle.size());
+  }
+  return count;
+}
