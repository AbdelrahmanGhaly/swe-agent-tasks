+  this->writeToFile(file, " <=");
+  this->writeToFileMatrixRow(file, iRow, ar_matrix, lp.col_names_);
+  this->writeToFile(file, " <=");
+  this->writeToFileValue(file, lp.row_upper_[iRow], true);
+  this->writeToFileLineEnd(file);
+}
