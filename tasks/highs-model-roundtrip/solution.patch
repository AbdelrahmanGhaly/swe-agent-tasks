+// A row that is bounded on both sides, or on neither, cannot be written as a
+// single one-sided constraint without changing the number of rows
+static bool rowIsTwoSided(const double lower, const double upper) {
+  const bool boxed = lower > -kHighsInf && upper < kHighsInf;
+  const bool free_row = lower <= -kHighsInf && upper >= kHighsInf;
+  return boxed || free_row;
+}
+
+// A semi-integer column is identified by appearing in both the general and the
+// semi-continuous section, so section membership is decided in one place
+static bool colInGeneralSection(const HighsVarType type, const double lower,
+                                const double upper) {
+  if (type == HighsVarType::kSemiInteger) return true;
+  if (type != HighsVarType::kInteger) return false;
+  return lower != 0.0 || upper != 1.0;
+}
+
+static bool colInBinarySection(const HighsVarType type, const double lower,
+                               const double upper) {
+  return type == HighsVarType::kInteger && lower == 0.0 && upper == 1.0;
+}
+
+static bool colInSemiSection(const HighsVarType type) {
+  return type == HighsVarType::kSemiContinuous ||
+         type == HighsVarType::kSemiInteger;
+}
