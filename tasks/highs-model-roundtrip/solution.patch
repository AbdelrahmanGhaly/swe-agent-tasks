 using std::map;
 
+// The whole two-character type is needed because the abbreviated symbol is
+// shared by MI, LI, UI and SI
+static const char* const kFixedFormatBoundTypes[] = {
+    "LO", "UP", "FX", "FR", "MI", "PL", "BV", "LI", "UI", "SC", "SI"};
+
+static bool knownFixedFormatBound(const char* bound_type) {
+  const std::string type(bound_type, 2);
+  for (const char* known : kFixedFormatBoundTypes) {
+    if (type == known) return true;
+  }
+  return false;
+}
+
+// Apply one BOUNDS entry of a type that knownFixedFormatBound has accepted
+static void applyFixedFormatBound(const char* bound_type, const double value,
+                                  double& lower, double& upper,
+                                  HighsVarType& integrality) {
+  const std::string type(bound_type, 2);
+  if (type == "LO") {
+    lower = value;
+  } else if (type == "UP") {
+    upper = value;
+    if (lower == 0 && value < 0) lower = -kHighsInf;
+  } else if (type == "FX") {
+    lower = value;
+    upper = value;
+  } else if (type == "FR") {
+    lower = -kHighsInf;
+    upper = kHighsInf;
+  } else if (type == "MI") {
+    lower = -kHighsInf;
+  } else if (type == "PL") {
+    upper = kHighsInf;
+  } else if (type == "BV") {
+    lower = 0;
+    upper = 1;
+    integrality = HighsVarType::kInteger;
+  } else if (type == "LI") {
+    lower = value;
+    integrality = HighsVarType::kInteger;
+  } else if (type == "UI") {
+    upper = value;
+    integrality = HighsVarType::kInteger;
+  } else if (type == "SC") {
+    upper = value;
+    integrality = HighsVarType::kSemiContinuous;
+  } else if (type == "SI") {
+    upper = value;
+    integrality = HighsVarType::kSemiInteger;
+  }
+}
