+// A two-sided constraint opens with a constant and a comparison operator
+// ahead of the expression, which is what tells it apart from a term with a
+// leading coefficient
+static bool opensrange(std::vector<ProcessedToken>::iterator it,
+                       const std::vector<ProcessedToken>::iterator end) {
+  if (it == end || it->type != ProcessedTokenType::CONST) return false;
+  ++it;
+  return it != end && it->type == ProcessedTokenType::COMP;
+}
+
+// Both comparisons of a two-sided constraint must run the same way, so the
+// bounds are read off the orientation rather than the position
+static void applyrangebounds(const std::shared_ptr<Constraint>& con,
+                             const LpComparisonType opening_dir,
+                             const double opening_value,
+                             const LpComparisonType closing_dir,
+                             const double closing_value) {
+  lpassert(opening_dir == LpComparisonType::LEQ ||
+           opening_dir == LpComparisonType::GEQ);
+  lpassert(closing_dir == opening_dir);
+  if (opening_dir == LpComparisonType::LEQ) {
+    con->lowerbound = opening_value;
+    con->upperbound = closing_value;
+  } else {
+    con->lowerbound = closing_value;
+    con->upperbound = opening_value;
+  }
+  lpassert(con->lowerbound <= con->upperbound);
+}
