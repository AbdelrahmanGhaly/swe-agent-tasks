+std::string mpsTextFromValue(const double value) {
+  if (value >= kHighsInf) return "inf";
+  if (value <= -kHighsInf) return "-inf";
+  std::array<char, 32> text;
+  snprintf(text.data(), text.size(), "%.15g", value);
+  return std::string(text.data());
+}
+
+double mpsValueFromText(const char* text) {
+  const char* symbol = text;
+  while (*symbol == ' ' || *symbol == '\t') symbol++;
+  double sign = 1;
+  if (*symbol == '+' || *symbol == '-') {
+    if (*symbol == '-') sign = -1;
+    symbol++;
+  }
+  if ((symbol[0] == 'i' || symbol[0] == 'I') &&
+      (symbol[1] == 'n' || symbol[1] == 'N') &&
+      (symbol[2] == 'f' || symbol[2] == 'F'))
+    return sign * kHighsInf;
+  return atof(text);
+}
