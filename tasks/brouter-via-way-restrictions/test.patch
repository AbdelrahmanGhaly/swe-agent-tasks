+    Assert.assertEquals(path("B", "E", "J", "S"), border.route(car, "X", "B", 0.5, "S", "A", 0.5));
+  }
+
+  @Test
+  public void relationsWithoutAValidChainAreIgnored() throws Exception {
+    Built junction = built("junction-invalid", () -> {
+      ViaWayTestMapd093d5 map = junction();
+      map.viaWayRestriction(960, "no_straight_on", 1, 3, 6);
+      map.viaWayRestriction(961, "no_straight_on", 1, 3, 2).way("to", 8);
+      map.viaWayRestriction(962, "no_straight_on", 1, 3, 2).way("from", 5);
+      map.viaWayRestriction(963, "no_straight_on", 4, 2, 3);
+      map.relation(964).tag("type", "restriction").tag("restriction", "no_straight_on").way("via", 2).way("to", 3);
+      map.relation(965).tag("type", "restriction").tag("restriction", "no_straight_on").way("from", 1).way("via", 2);
+      map.relation(966).tag("type", "restriction").tag("restriction", "no_straight_on").way("from", 1).way("to", 3);
+      map.viaWayRestriction(967, "no_straight_on", 1, 3, 2, 7, 8);
+      return map;
+    });
+    Assert.assertEquals(path("S", "E", "B"), junction.route(car, "A", "S", 0.3, "B", "X", 0.5));
+    Assert.assertEquals(path("B", "E", "M", "N", "S"), junction.route(car, "X", "B", 0.5, "A", "S", 0.3));
+  }
+
+  @Test
+  public void fromAndToWaysWithShapeNodesStillMatch() throws Exception {
+    Built shaped = built("shaped", () -> {
+      ViaWayTestMapd093d5 map = new ViaWayTestMapd093d5()
+        .node("A", 0, 20).shape("a1", 10, 20).node("S", 20, 20).node("E", 45, 20).shape("b1", 57, 20)
+        .node("B", 70, 20).node("X", 90, 20).node("N", 20, 0).node("M", 45, 0).node("K", 45, 40)
+        .way(1, "A", "a1", "S").way(2, "S", "E").way(3, "E", "b1", "B").way(4, "B", "X")
+        .way(5, "S", "N").way(6, "N", "M").way(7, "M", "E").way(8, "E", "K");
+      map.viaWayRestriction(970, "no_straight_on", 1, 3, 2);
+      return map;
+    });
+    Assert.assertEquals(path("S", "N", "M", "E", "B"), shaped.route(car, "A", "S", 0.3, "B", "X", 0.5));
+  }
+}
diff --git a/brouter-server/src/test/java/btools/server/ViaWayTestMapd093d5.java b/brouter-server/src/test/java/btools/server/ViaWayTestMapd093d5.java
new file mode 100644
index 00000000..1bff1d2b
--- /dev/null
+++ b/brouter-server/src/test/java/btools/server/ViaWayTestMapd093d5.java
@@ -0,0 +1,365 @@
+package btools.server;
+
+import java.io.ByteArrayOutputStream;
+import java.io.DataOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import btools.mapcreator.OsmFastCutter;
+import btools.mapcreator.PosUnifier;
+import btools.mapcreator.WayLinker;
+import btools.router.OsmNodeNamed;
+import btools.router.OsmPathElement;
+import btools.router.OsmTrack;
+import btools.router.RoutingContext;
+import btools.router.RoutingEngine;
+
+final class ViaWayTestMapd093d5 {
+  private static final double BASE_LON = 8.72;
+  private static final double BASE_LAT = 50.02;
+  private static final double UNIT = 0.0001;
+
+  private final Map<String, Long> nodeIds = new LinkedHashMap<>();
+  private final Map<String, double[]> coords = new LinkedHashMap<>();
+  private final Set<String> shapeNodes = new HashSet<>();
+  private final List<Way> ways = new ArrayList<>();
+  private final List<Relation> relations = new ArrayList<>();
+  private long nextNodeId = 1000;
+
+  static final class Way {
+    final long id;
+    final String[] nodes;
+    final Map<String, String> tags = new LinkedHashMap<>();
+
+    Way(long id, String[] nodes) {
+      this.id = id;
+      this.nodes = nodes;
+      tags.put("highway", "residential");
+    }
+  }
+
+  static final class Relation {
+    final long id;
+    final Map<String, String> tags = new LinkedHashMap<>();
+    final List<Object[]> members = new ArrayList<>();
+
+    Relation(long id) {
+      this.id = id;
+    }
+
+    Relation tag(String key, String value) {
+      tags.put(key, value);
+      return this;
+    }
+
+    Relation way(String role, long wayId) {
+      members.add(new Object[]{role, wayId, 1});
+      return this;
+    }
+
+    Relation node(String role, long nodeId) {
+      members.add(new Object[]{role, nodeId, 0});
+      return this;
+    }
+  }
+
+  ViaWayTestMapd093d5 node(String name, int x, int y) {
+    nodeIds.put(name, nextNodeId++);
+    coords.put(name, new double[]{BASE_LON + x * UNIT, BASE_LAT + y * UNIT});
+    return this;
+  }
+
+  ViaWayTestMapd093d5 shape(String name, int x, int y) {
+    shapeNodes.add(name);
+    return node(name, x, y);
+  }
+
+  ViaWayTestMapd093d5 way(long id, String... nodeNames) {
+    ways.add(new Way(id, nodeNames));
+    return this;
+  }
+
+  Relation relation(long id) {
+    Relation relation = new Relation(id);
+    relations.add(relation);
+    return relation;
+  }
+
+  Relation viaWayRestriction(long id, String restriction, long fromWay, long toWay, long... viaWays) {
+    Relation relation = relation(id).tag("type", "restriction").tag("restriction", restriction).way("from", fromWay);
+    for (long via : viaWays) {
+      relation.way("via", via);
+    }
+    return relation.way("to", toWay);
+  }
+
+  Relation viaNodeRestriction(long id, String restriction, long fromWay, String viaNode, long toWay) {
+    return relation(id).tag("type", "restriction").tag("restriction", restriction)
+      .way("from", fromWay).node("via", nodeIds.get(viaNode)).way("to", toWay);
+  }
+
+  File build(File dir) throws Exception {
+    System.setProperty("avoidMapPolling", "true");
+    File profileDir = new File(new File(".").getCanonicalFile(), "../misc/profiles2");
+    File mapFile = new File(dir, "map.pbf");
+    try (FileOutputStream out = new FileOutputStream(mapFile)) {
+      out.write(toPbf());
+    }
+    File nodes = mkdir(dir, "nodetiles");
+    File waysDir = mkdir(dir, "waytiles");
+    File nodes55 = mkdir(dir, "nodes55");
+    File ways55 = mkdir(dir, "waytiles55");
+    File unodes55 = mkdir(dir, "unodes55");
+    File segments = mkdir(dir, "segments");
+    File lookupFile = new File(profileDir, "lookups.dat");
+    File borderFile = new File(dir, "bordernids.dat");
+    File borderNodes = new File(dir, "bordernodes.dat");
+    File relFile = new File(dir, "cycleways.dat");
+    File resFile = new File(dir, "restrictions.dat");
+
+    OsmFastCutter.doCut(lookupFile, nodes, waysDir, nodes55, ways55, borderFile, relFile, resFile,
+      new File(profileDir, "all.brf"), new File(profileDir, "trekking.brf"), new File(profileDir, "softaccess.brf"), mapFile, null);
+    new PosUnifier().process(nodes55, unodes55, borderFile, borderNodes, new File(dir, "srtm").getAbsolutePath(), null);
+    new WayLinker().process(unodes55, ways55, borderNodes, resFile, lookupFile, new File(profileDir, "all.brf"), segments, "rd5");
+    return segments;
+  }
+
+  List<String> route(File segments, File profile, String fromA, String fromB, double fromFraction,
+                     String toA, String toB, double toFraction) {
+    RoutingContext rctx = new RoutingContext();
+    rctx.localFunction = profile.getAbsolutePath();
+    List<OsmNodeNamed> waypoints = new ArrayList<>();
+    waypoints.add(waypoint("from", fromA, fromB, fromFraction));
+    waypoints.add(waypoint("to", toA, toB, toFraction));
+    String profileBaseDir = System.getProperty("profileBaseDir");
+    System.clearProperty("profileBaseDir");
+    RoutingEngine engine;
+    try {
+      engine = new RoutingEngine(null, null, segments, waypoints, rctx);
+      engine.quite = true;
+      engine.doRun(0);
+    } finally {
+      if (profileBaseDir != null) {
+        System.setProperty("profileBaseDir", profileBaseDir);
+      }
+    }
+    if (engine.getErrorMessage() != null) {
+      throw new AssertionError("routing failed: " + engine.getErrorMessage());
+    }
+    OsmTrack track = engine.getFoundTrack();
+    List<String> names = new ArrayList<>();
+    for (OsmPathElement element : track.nodes) {
+      String name = nameAt(element.getILon(), element.getILat());
+      if (name != null && !shapeNodes.contains(name) && (names.isEmpty() || !names.get(names.size() - 1).equals(name))) {
+        names.add(name);
+      }
+    }
+    return names;
+  }
+
+  private OsmNodeNamed waypoint(String name, String a, String b, double fraction) {
+    double[] pa = coords.get(a);
+    double[] pb = coords.get(b);
+    OsmNodeNamed n = new OsmNodeNamed();
+    n.name = name;
+    n.ilon = toILon(pa[0] + (pb[0] - pa[0]) * fraction);
+    n.ilat = toILat(pa[1] + (pb[1] - pa[1]) * fraction);
+    return n;
+  }
+
+  private String nameAt(int ilon, int ilat) {
+    for (Map.Entry<String, double[]> e : coords.entrySet()) {
+      if (Math.abs(toILon(e.getValue()[0]) - ilon) <= 2 && Math.abs(toILat(e.getValue()[1]) - ilat) <= 2) {
+        return e.getKey();
+      }
+    }
+    return null;
+  }
+
+  private static int toILon(double lon) {
+    return (int) Math.round((lon + 180.) * 1000000.);
+  }
+
+  private static int toILat(double lat) {
+    return (int) Math.round((lat + 90.) * 1000000.);
+  }
+
+  private static File mkdir(File parent, String name) {
+    File dir = new File(parent, name);
+    dir.mkdirs();
+    return dir;
+  }
+
+  private byte[] toPbf() throws IOException {
+    List<String> strings = new ArrayList<>();
+    strings.add("");
+
+    Proto nodeGroup = new Proto();
+    for (Map.Entry<String, Long> e : nodeIds.entrySet()) {
+      double[] c = coords.get(e.getKey());
+      nodeGroup.message(1, new Proto()
+        .sint(1, e.getValue())
+        .sint(8, Math.round(c[1] * 10000000.))
+        .sint(9, Math.round(c[0] * 10000000.)));
+    }
+
+    Proto wayGroup = new Proto();
+    for (Way way : ways) {
+      long[] refs = new long[way.nodes.length];
+      long last = 0;
+      for (int i = 0; i < refs.length; i++) {
+        long id = nodeIds.get(way.nodes[i]);
+        refs[i] = id - last;
+        last = id;
+      }
+      wayGroup.message(3, new Proto()
+        .varint(1, way.id)
+        .packed(2, keys(way.tags, strings), false)
+        .packed(3, values(way.tags, strings), false)
+        .packed(8, refs, true));
+    }
+
+    Proto relationGroup = new Proto();
+    for (Relation relation : relations) {
+      long[] roles = new long[relation.members.size()];
+      long[] memids = new long[roles.length];
+      long[] types = new long[roles.length];
+      long last = 0;
+      for (int i = 0; i < roles.length; i++) {
+        Object[] m = relation.members.get(i);
+        roles[i] = index((String) m[0], strings);
+        long id = (Long) m[1];
+        memids[i] = id - last;
+        last = id;
+        types[i] = (Integer) m[2];
+      }
+      relationGroup.message(4, new Proto()
+        .varint(1, relation.id)
+        .packed(2, keys(relation.tags, strings), false)
+        .packed(3, values(relation.tags, strings), false)
+        .packed(8, roles, false)
+        .packed(9, memids, true)
+        .packed(10, types, false));
+    }
+
+    Proto stringTable = new Proto();
+    for (String s : strings) {
+      stringTable.bytes(1, s.getBytes(StandardCharsets.UTF_8));
+    }
+    Proto block = new Proto()
+      .message(1, stringTable)
+      .message(2, new Proto().raw(nodeGroup))
+      .message(2, new Proto().raw(wayGroup))
+      .message(2, new Proto().raw(relationGroup));
+
+    ByteArrayOutputStream file = new ByteArrayOutputStream();
+    writeBlob(file, "OSMHeader", new Proto().string(4, "OsmSchema-V0.6").toByteArray());
+    writeBlob(file, "OSMData", block.toByteArray());
+    return file.toByteArray();
+  }
+
+  private static void writeBlob(ByteArrayOutputStream file, String type, byte[] data) throws IOException {
+    byte[] blob = new Proto().bytes(1, data).varint(2, data.length).toByteArray();
+    byte[] header = new Proto().string(1, type).varint(3, blob.length).toByteArray();
+    DataOutputStream dos = new DataOutputStream(file);
+    dos.writeInt(header.length);
+    dos.write(header);
+    dos.write(blob);
+    dos.flush();
+  }
+
+  private static long[] keys(Map<String, String> tags, List<String> strings) {
+    long[] result = new long[tags.size()];
+    int i = 0;
+    for (String key : tags.keySet()) {
+      result[i++] = index(key, strings);
+    }
+    return result;
+  }
+
+  private static long[] values(Map<String, String> tags, List<String> strings) {
+    long[] result = new long[tags.size()];
+    int i = 0;
+    for (String value : tags.values()) {
+      result[i++] = index(value, strings);
+    }
+    return result;
+  }
+
+  private static int index(String s, List<String> strings) {
+    int idx = strings.indexOf(s);
+    if (idx < 0) {
+      strings.add(s);
+      idx = strings.size() - 1;
+    }
+    return idx;
+  }
+
+  private static final class Proto {
+    private final ByteArrayOutputStream out = new ByteArrayOutputStream();
+
+    Proto varint(int field, long value) {
+      key(field, 0);
+      writeVarint(value);
+      return this;
+    }
+
+    Proto sint(int field, long value) {
+      return varint(field, (value << 1) ^ (value >> 63));
+    }
+
+    Proto bytes(int field, byte[] data) {
+      key(field, 2);
+      writeVarint(data.length);
+      out.write(data, 0, data.length);
+      return this;
+    }
+
+    Proto string(int field, String s) {
+      return bytes(field, s.getBytes(StandardCharsets.UTF_8));
+    }
+
+    Proto message(int field, Proto message) {
+      return bytes(field, message.toByteArray());
+    }
+
+    Proto raw(Proto content) {
+      byte[] data = content.toByteArray();
+      out.write(data, 0, data.length);
+      return this;
+    }
+
+    Proto packed(int field, long[] values, boolean zigzag) {
+      Proto inner = new Proto();
+      for (long v : values) {
+        inner.writeVarint(zigzag ? (v << 1) ^ (v >> 63) : v);
+      }
+      return bytes(field, inner.toByteArray());
+    }
+
+    byte[] toByteArray() {
+      return out.toByteArray();
+    }
+
+    private void key(int field, int wireType) {
+      writeVarint(((long) field << 3) | wireType);
+    }
+
+    private void writeVarint(long value) {
+      long v = value;
+      while ((v & ~0x7FL) != 0) {
+        out.write((int) ((v & 0x7F) | 0x80));
+        v >>>= 7;
+      }
+      out.write((int) v);
+    }
+  }
+}
