@@ -0,0 +1,95 @@
+#!/bin/bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-test-results.xml}"
+case "$OUTPUT_PATH" in
+  /*) ;;
+  *) OUTPUT_PATH="$(pwd)/$OUTPUT_PATH" ;;
+esac
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")"
+
+NEW_TESTS="brouter-server/src/test/java/btools/server/ViaWayRestrictionsd093d5Test.java brouter-server/src/test/java/btools/server/ViaWayTestMapd093d5.java"
+WORK_DIR="$(mktemp -d)"
+STASHED=""
+
+cleanup() {
+  for f in $STASHED; do
+    mv "$WORK_DIR/stash/$(basename "$f")" "$f"
+  done
+  rm -rf "$WORK_DIR"
+}
+trap cleanup EXIT
+
+SHARED_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
+GRADLE="./gradlew"
+DIST_GRADLE=$(ls -d "$SHARED_HOME"/wrapper/dists/gradle-*-bin/*/gradle-*/bin/gradle 2>/dev/null | head -1)
+if [ -n "$DIST_GRADLE" ]; then
+  GRADLE="$DIST_GRADLE"
+  export GRADLE_RO_DEP_CACHE="$SHARED_HOME/caches"
+  export GRADLE_USER_HOME="$WORK_DIR/gradle-home"
+fi
+
+if [ -n "$(find . -name .git -prune -o ! -writable -print -quit 2>/dev/null)" ]; then
+  mkdir -p "$WORK_DIR/tree"
+  tar -cf - --anchored --no-wildcards-match-slash --exclude=./.git --exclude=./.gradle --exclude=./build \
+    --exclude=./buildSrc/.gradle --exclude=./buildSrc/build --exclude='./brouter-*/build' . 2>/dev/null \
+    | tar -xf - -C "$WORK_DIR/tree"
+  cd "$WORK_DIR/tree"
+  if [ "$MODE" = "base" ]; then
+    rm -f $NEW_TESTS
+  fi
+else
+  rm -rf brouter-*/build/test-results/test
+  if [ "$MODE" = "base" ]; then
+    mkdir -p "$WORK_DIR/stash"
+    for f in $NEW_TESTS; do
+      if [ -f "$f" ]; then
+        mv "$f" "$WORK_DIR/stash/"
+        STASHED="$STASHED $f"
+      fi
+    done
+  fi
+fi
+
+touch "$WORK_DIR/started"
+if [ "$MODE" = "base" ]; then
+  "$GRADLE" --no-daemon --offline --continue test 2>&1 | tee "$WORK_DIR/gradle.log"
+  RC=${PIPESTATUS[0]}
+else
+  "$GRADLE" --no-daemon --offline :brouter-server:test --tests 'btools.server.ViaWayRestrictionsd093d5Test' 2>&1 | tee "$WORK_DIR/gradle.log"
+  RC=${PIPESTATUS[0]}
+fi
+
+REPORTS=$(find brouter-* -path '*/build/test-results/test/TEST-*.xml' -newer "$WORK_DIR/started" | sort)
+{
+  echo '<?xml version="1.0" encoding="UTF-8"?>'
+  echo '<testsuites>'
+  for f in $REPORTS; do
+    sed '1{/^<?xml/d}' "$f"
+  done
+  if [ -z "$REPORTS" ]; then
+    MESSAGE=$(grep -E 'error:|FAILED|What went wrong' "$WORK_DIR/gradle.log" | head -20 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g')
+    echo '<testsuite name="gradle" tests="1" failures="1" errors="0">'
+    echo "<testcase classname=\"gradle\" name=\"build\"><failure message=\"gradle exited with code $RC\">$MESSAGE</failure></testcase>"
+    echo '</testsuite>'
+  fi
+  echo '</testsuites>'
+} > "$OUTPUT_PATH"
+
+if [ -z "$REPORTS" ]; then
+  exit 1
+fi
+exit $RC
