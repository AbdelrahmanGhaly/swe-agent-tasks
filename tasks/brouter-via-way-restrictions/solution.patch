+      this.restriction = restriction;
+      this.nodes = nodes;
+    }
+  }
+
+  public void build(File restrictionsFile, File wayTilesIn, File nodeTilesIn) throws Exception {
+    List<RestrictionData> restrictions = readRestrictions(restrictionsFile);
+    if (restrictions.isEmpty()) {
+      return;
+    }
+    for (RestrictionData r : restrictions) {
+      memberWays.add(r.fromWid);
+      memberWays.add(r.toWid);
+      for (long wid : r.viaWids) {
+        memberWays.add(wid);
+      }
+    }
+    new WayIterator(this, false).processDir(wayTilesIn, ".wt5");
+
+    List<Chain> spanning = new ArrayList<>();
+    Set<String> spanningTiles = new TreeSet<>();
+    for (RestrictionData r : restrictions) {
+      long[] nodes = resolveChain(r);
+      if (nodes == null) {
+        continue;
+      }
+      Chain chain = new Chain(r, nodes);
+      Set<String> tiles = memberTiles(r);
+      if (tiles.size() == 1) {
+        String tile = tiles.iterator().next();
+        chainsForTile(tile).add(chain);
+        for (long nid : nodes) {
+          addSurvivor(tile, nid);
+        }
+      } else {
+        spanning.add(chain);
+        spanningTiles.addAll(tiles);
+        for (long nid : nodes) {
+          wantedNodes.add(nid);
+        }
+      }
+    }
+
+    for (String tile : spanningTiles) {
+      File nodeFile = nodeFile(nodeTilesIn, tile);
+      if (nodeFile != null) {
+        new NodeIterator(this, false).processFile(nodeFile);
+      }
+    }
+    for (Chain chain : spanning) {
+      int[] start = positions.get(chain.nodes[1]);
+      if (start == null) {
+        continue;
+      }
+      chainsForTile(tileName(start[0], start[1])).add(chain);
+      for (long nid : chain.nodes) {
+        int[] pos = positions.get(nid);
+        if (pos != null) {
+          addSurvivor(tileName(pos[0], pos[1]), nid);
+        }
+      }
+    }
+  }
+
+  public Map<OsmNodeP, RestrictionData> attach(File wayfile, CompactLongMap<OsmNodeP> nodes) {
+    Map<OsmNodeP, RestrictionData> byStartNode = new IdentityHashMap<>();
+    if (nodes == null) {
+      return byStartNode;
+    }
+    String tile = tileName(wayfile);
+    LongList survivors = survivorsByTile.get(tile);
+    for (int i = 0; survivors != null && i < survivors.size(); i++) {
+      OsmNodeP n = nodes.get(survivors.get(i));
+      if (n != null) {
+        n.bits |= OsmNodeP.DP_SURVIVOR_BIT;
+      }
+    }
+    List<Chain> chains = chainsByTile.get(tile);
+    if (chains != null) {
+      for (Chain chain : chains) {
+        OsmNodeP start = nodes.get(chain.nodes[1]);
+        RestrictionData res = start == null ? null : toRestriction(chain, nodes);
+        if (res != null) {
+          res.next = byStartNode.get(start);
+          byStartNode.put(start, res);
+        }
+      }
+    }
+    return byStartNode;
+  }
+
+  @Override
+  public boolean wayFileStart(File wayfile) {
+    currentTile = tileName(wayfile);
+    return true;
+  }
+
+  @Override
+  public void nextWay(WayData way) {
+    if (memberWays.contains(way.wid)) {
+      wayNodes.putIfAbsent(way.wid, way.nodes);
+      wayTiles.computeIfAbsent(way.wid, wid -> new TreeSet<>()).add(currentTile);
+    }
+  }
+
+  @Override
+  public void nextNode(NodeData n) {
+    if (wantedNodes.contains(n.nid)) {
+      positions.put(n.nid, new int[]{n.ilon, n.ilat});
+    }
+  }
+
+  private static List<RestrictionData> readRestrictions(File restrictionsFile) throws Exception {
+    List<RestrictionData> restrictions = new ArrayList<>();
+    if (restrictionsFile == null || !restrictionsFile.exists()) {
+      return restrictions;
+    }
+    try (DataInputStream di = new DataInputStream(new BufferedInputStream(new FileInputStream(restrictionsFile)))) {
+      for (; ; ) {
+        RestrictionData res = new RestrictionData(di);
+        if (res.viaWids != null && res.isValidViaWayRestriction()) {
+          restrictions.add(res);
+        }
+      }
+    } catch (EOFException eof) {
+      return restrictions;
+    }
+  }
+
+  private long[] resolveChain(RestrictionData r) {
+    LongList from = wayNodes.get(r.fromWid);
+    LongList to = wayNodes.get(r.toWid);
+    if (from == null || to == null || from.size() < 2 || to.size() < 2) {
+      return null;
+    }
+    List<LongList> vias = new ArrayList<>();
+    for (long wid : r.viaWids) {
+      LongList via = wayNodes.get(wid);
+      if (via == null) {
+        return null;
+      }
+      vias.add(via);
+    }
+    LongList chain = buildViaChain(from, vias, to);
+    if (chain == null) {
+      return null;
+    }
+    int size = chain.size();
+    long[] nodes = new long[size + 2];
+    nodes[0] = neighbour(from, chain.get(0));
+    for (int i = 0; i < size; i++) {
+      nodes[i + 1] = chain.get(i);
+    }
+    nodes[size + 1] = neighbour(to, chain.get(size - 1));
+    return nodes;
+  }
+
+  private Set<String> memberTiles(RestrictionData r) {
+    Set<String> tiles = new TreeSet<>(wayTiles.get(r.fromWid));
+    tiles.addAll(wayTiles.get(r.toWid));
+    for (long wid : r.viaWids) {
+      tiles.addAll(wayTiles.get(wid));
+    }
+    return tiles;
+  }
+
+  private static LongList buildViaChain(LongList from, List<LongList> vias, LongList to) {
+    long[] starts = {from.get(from.size() - 1), from.get(0)};
+    for (long start : starts) {
+      LongList chain = followViaWays(start, vias);
+      if (chain != null) {
+        long end = chain.get(chain.size() - 1);
+        if (end == to.get(0) || end == to.get(to.size() - 1)) {
+          return chain;
+        }
+      }
+    }
+    return null;
+  }
+
+  private static LongList followViaWays(long start, List<LongList> vias) {
+    List<LongList> remaining = new ArrayList<>(vias);
+    LongList chain = new LongList(16);
+    chain.add(start);
+    long current = start;
+    while (!remaining.isEmpty()) {
+      LongList next = null;
+      for (LongList via : remaining) {
+        if (via.get(0) == current || via.get(via.size() - 1) == current) {
+          next = via;
+          break;
+        }
+      }
+      if (next == null) {
+        return null;
+      }
+      remaining.remove(next);
+      boolean forward = next.get(0) == current;
+      int size = next.size();
+      for (int i = 1; i < size; i++) {
+        chain.add(next.get(forward ? i : size - 1 - i));
+      }
+      current = chain.get(chain.size() - 1);
+    }
+    return chain;
+  }
+
+  private static long neighbour(LongList way, long nid) {
+    return way.get(0) == nid ? way.get(1) : way.get(way.size() - 2);
+  }
+
+  private RestrictionData toRestriction(Chain chain, CompactLongMap<OsmNodeP> nodes) {
+    int count = chain.nodes.length;
+    int[] lons = new int[count];
+    int[] lats = new int[count];
+    for (int i = 0; i < count; i++) {
+      int[] pos = positions.get(chain.nodes[i]);
+      if (pos == null) {
+        OsmNodeP n = nodes.get(chain.nodes[i]);
+        if (n == null) {
+          return null;
+        }
+        pos = new int[]{n.ilon, n.ilat};
+      }
+      lons[i] = pos[0];
+      lats[i] = pos[1];
+    }
+    RestrictionData res = new RestrictionData();
+    res.restrictionKey = chain.restriction.restrictionKey;
+    res.restriction = chain.restriction.restriction;
+    res.exceptions = chain.restriction.exceptions;
+    res.fromLon = lons[0];
+    res.fromLat = lats[0];
+    res.viaLons = Arrays.copyOfRange(lons, 2, count - 1);
+    res.viaLats = Arrays.copyOfRange(lats, 2, count - 1);
+    res.toLon = lons[count - 1];
+    res.toLat = lats[count - 1];
+    return res;
+  }
+
+  private List<Chain> chainsForTile(String tile) {
+    return chainsByTile.computeIfAbsent(tile, t -> new ArrayList<>());
+  }
+
+  private void addSurvivor(String tile, long nid) {
+    survivorsByTile.computeIfAbsent(tile, t -> new LongList(16)).add(nid);
+  }
+
+  private static File nodeFile(File nodeTilesIn, String tile) {
+    for (String suffix : new String[]{"u5d_1", "u5d_3", "u5d"}) {
+      File file = new File(nodeTilesIn, tile + "." + suffix);
+      if (file.exists()) {
+        return file;
+      }
+    }
+    return null;
+  }
+
+  private static String tileName(File file) {
+    String name = file.getName();
+    return name.substring(0, name.lastIndexOf('.'));
+  }
+
+  private static String tileName(int ilon, int ilat) {
+    int lon = (ilon / 5000000) * 5 - 180;
+    int lat = (ilat / 5000000) * 5 - 90;
+    return (lon < 0 ? "W" + (-lon) : "E" + lon) + "_" + (lat < 0 ? "S" + (-lat) : "N" + lat);
+  }
+}
