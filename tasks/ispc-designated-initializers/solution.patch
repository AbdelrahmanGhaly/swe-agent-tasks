+static bool lResolveInitializerList(DesignatedInitNode &node, const Type *type, ExprList *list, bool requireConstant);
+
+static bool lHasExplicitInitializer(const DesignatedInitNode &node) {
+    if (node.expr != nullptr) {
+        return true;
+    }
+    for (const DesignatedInitNode &element : node.elements) {
+        if (lHasExplicitInitializer(element)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool lCheckOverriddenExpr(Expr *initExpr, const Type *type, bool requireConstant) {
+    if (initExpr == nullptr) {
+        Assert(m->errorCount > 0);
+        return false;
+    }
+    ExprList *list = llvm::dyn_cast<ExprList>(initExpr);
+    if (list != nullptr) {
+        const bool isBasic = !type->IsSOAType() && Type::IsBasicType(type);
+        if (isBasic && list->exprs.size() == 1) {
+            return lCheckOverriddenExpr(list->exprs[0], type, requireConstant);
+        }
+        if (isBasic && !type->IsVaryingType()) {
+            Error(list->pos, "Expression list initializers with multiple values can't be used with type \"%s\".",
+                  type->GetString().c_str());
+            return false;
+        }
+        if (!isBasic && !type->IsSOAType()) {
+            return true;
+        }
+        const int count = type->IsSOAType() ? type->GetSOAWidth() : g->target->getVectorWidth();
+        if ((int)list->exprs.size() > count || (isBasic && (int)list->exprs.size() < count)) {
+            Error(list->pos, "Initializer for type \"%s\" requires %d values; %d provided.", type->GetString().c_str(),
+                  count, (int)list->exprs.size());
+            return false;
+        }
+        for (Expr *element : list->exprs) {
+            if (!lCheckOverriddenExpr(element, type->GetAsUniformType(), requireConstant)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    Expr *expr = TypeCheck(initExpr);
+    if (expr == nullptr || !PossiblyResolveFunctionOverloads(expr, type)) {
+        return false;
+    }
+    const Type *exprType = expr->GetType();
+    if (exprType == nullptr) {
+        AssertPos(initExpr->pos, m->errorCount > 0);
+        return false;
+    }
+    if (exprType->IsDependent()) {
+        return true;
+    }
+    expr = TypeConvertExpr(expr, type, "initializer");
+    if (expr == nullptr) {
+        return false;
+    }
+    if (requireConstant) {
+        expr = TypeCheckAndOptimize(expr);
+        if (expr == nullptr) {
+            return false;
+        }
+        if (expr->GetStorageConstant(type).first == nullptr) {
+            Error(initExpr->pos, "Overridden initializer for a global or static variable must still be a constant.");
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool lCheckOverriddenInitializer(const DesignatedInitNode &node, const Type *type, bool requireConstant) {
+    if (node.isAggregate) {
+        const CollectionType *collectionType = CastType<CollectionType>(type);
+        for (size_t i = 0; i < node.elements.size(); ++i) {
+            if (!lCheckOverriddenInitializer(node.elements[i], collectionType->GetElementType(i), requireConstant)) {
+                return false;
+            }
+        }
+        return true;
+    }
+    return node.expr == nullptr || lCheckOverriddenExpr(node.expr, type, requireConstant);
+}
+
+static bool lStoreDesignatedInitializer(DesignatedInitNode &root, const Type *rootType, const std::vector<int> &path,
+                                        Expr *expr, bool requireConstant) {
+    DesignatedInitNode *node = &root;
+    const Type *type = rootType;
+    for (size_t depth = 0; depth < path.size(); ++depth) {
+        const Type *elementType = CastType<CollectionType>(type)->GetElementType(path[depth]);
+        if (node->elements.size() <= (size_t)path[depth]) {
+            node->elements.resize((size_t)path[depth] + 1);
+        }
+        DesignatedInitNode &child = node->elements[path[depth]];
+
+        if (depth + 1 == path.size()) {
+            if (lHasExplicitInitializer(child)) {
+                if (!lCheckOverriddenInitializer(child, elementType, requireConstant)) {
+                    return false;
+                }
+                Warning(expr->pos, "Initializer overrides an earlier initializer of the same element.");
+            }
+            DesignatedInitNode replacement;
+            ExprList *list = llvm::dyn_cast<ExprList>(expr);
+            if (list != nullptr && lIsDesignatableType(elementType)) {
+                if (!lResolveInitializerList(replacement, elementType, list, requireConstant)) {
+                    return false;
+                }
+            } else if (list != nullptr && list->HasDesignators()) {
+                Error(list->pos, "Designators can't be used to initialize type \"%s\".",
+                      elementType->GetString().c_str());
+                return false;
+            } else if (list == nullptr && lIsDesignatableType(elementType)) {
+                Error(expr->pos, "Initializer for type \"%s\" must be an initializer list.",
+                      elementType->GetString().c_str());
+                return false;
+            } else {
+                replacement.expr = expr;
+            }
+            child = std::move(replacement);
+            return true;
+        }
+
+        if (!child.isAggregate) {
+            child = DesignatedInitNode();
+            child.isAggregate = true;
+        }
+        node = &child;
+        type = elementType;
+    }
+    return true;
+}
+
+static bool lResolveInitializerList(DesignatedInitNode &node, const Type *type, ExprList *list, bool requireConstant) {
+    node.expr = nullptr;
+    node.isAggregate = true;
+    node.elements.clear();
+
+    std::vector<int> path;
+    std::vector<const Type *> pathTypes;
+    for (size_t i = 0; i < list->exprs.size(); ++i) {
+        if (list->exprs[i] == nullptr) {
+            AssertPos(list->pos, m->errorCount > 0);
+            return false;
+        }
+
+        if (i < list->designators.size() && !list->designators[i].empty()) {
+            path.clear();
+            pathTypes.clear();
+            const Type *current = type;
+            for (const Designator &designator : list->designators[i]) {
+                int index = 0;
+                const Type *elementType = lApplyDesignator(current, designator, &index);
+                if (elementType == nullptr) {
+                    return false;
+                }
+                pathTypes.push_back(current);
+                path.push_back(index);
+                current = elementType;
+            }
+        } else if (path.empty()) {
+            pathTypes.push_back(type);
+            path.push_back(0);
+        } else {
+            ++path.back();
+            while (path.size() > 1 && lIsPastEnd(pathTypes.back(), path.back())) {
+                path.pop_back();
+                pathTypes.pop_back();
+                ++path.back();
+            }
+        }
+
+        if (lIsPastEnd(pathTypes.back(), path.back())) {
+            Error(list->exprs[i]->pos, "Too many elements in initializer list for type \"%s\".",
+                  type->GetString().c_str());
+            return false;
+        }
+        if (!lStoreDesignatedInitializer(node, type, path, list->exprs[i], requireConstant)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static Expr *lDesignatedInitNodeToExpr(const DesignatedInitNode &node, const Type *type, SourcePos pos) {
+    if (!node.isAggregate) {
+        return node.expr != nullptr ? node.expr : lZeroInitializer(type, pos);
+    }
+
+    const CollectionType *collectionType = CastType<CollectionType>(type);
+    size_t count = node.elements.size();
+    while (count > 0 && !node.elements[count - 1].isAggregate && node.elements[count - 1].expr == nullptr) {
+        --count;
+    }
+    if (CastType<VectorType>(type) != nullptr) {
+        count = collectionType->GetElementCount();
+    }
+    ExprList *list = new ExprList(pos);
+    for (size_t i = 0; i < count; ++i) {
+        const Type *elementType = collectionType->GetElementType(i);
+        list->exprs.push_back(i < node.elements.size() ? lDesignatedInitNodeToExpr(node.elements[i], elementType, pos)
+                                                       : lZeroInitializer(elementType, pos));
+    }
+    return list;
+}
+
+Expr *ispc::ResolveDesignatedInitializer(const Type *type, Expr *initExpr, bool requireConstant) {
+    ExprList *list = llvm::dyn_cast_or_null<ExprList>(initExpr);
+    if (list == nullptr || type == nullptr || type->IsDependent() || !list->HasDesignators()) {
+        return initExpr;
+    }
+    if (!lIsDesignatableType(type)) {
+        Error(list->pos, "Designators can't be used to initialize type \"%s\".", type->GetString().c_str());
+        return nullptr;
+    }
+
+    DesignatedInitNode root;
+    if (!lResolveInitializerList(root, type, list, requireConstant)) {
+        return nullptr;
+    }
+    return TypeCheck(lDesignatedInitNodeToExpr(root, type, list->pos));
+}
+
+ConstExpr *ispc::GetSingleElementInitializerConstant(const Type *type, Expr *initExpr) {
+    ExprList *list = llvm::dyn_cast_or_null<ExprList>(initExpr);
+    if (list == nullptr || type == nullptr || !type->IsUniformType() ||
+        (CastType<AtomicType>(type) == nullptr && CastType<EnumType>(type) == nullptr)) {
+        return nullptr;
+    }
+    while (list != nullptr) {
+        if (list->exprs.size() != 1 || list->exprs[0] == nullptr) {
+            return nullptr;
+        }
+        initExpr = list->exprs[0];
+        list = llvm::dyn_cast<ExprList>(initExpr);
+    }
+
+    ConstExpr *value = llvm::dyn_cast_or_null<ConstExpr>(Optimize(initExpr));
+    if (value == nullptr || !value->GetType()->IsUniformType()) {
+        return nullptr;
+    }
+    TypeCastExpr *cast = new TypeCastExpr(type, value, value->pos);
+    cast->SetTypeChecked();
+    return llvm::dyn_cast_or_null<ConstExpr>(Optimize(cast));
+}
