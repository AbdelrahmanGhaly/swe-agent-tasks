+struct DesignatedInitNode {
+    Expr *expr = nullptr;
+    bool isAggregate = false;
+    std::vector<DesignatedInitNode> elements;
+};
+
+static int lIdentifierToVectorElement(char id);
+
+static bool lIsDesignatableType(const Type *type) {
+    return CastType<StructType>(type) != nullptr || CastType<ArrayType>(type) != nullptr ||
+           CastType<VectorType>(type) != nullptr;
+}
+
+static bool lIsPastEnd(const Type *type, int index) {
+    const ArrayType *arrayType = CastType<ArrayType>(type);
+    if (arrayType != nullptr && arrayType->GetElementCount() == 0) {
+        return index >= INT32_MAX;
+    }
+    return index >= CastType<CollectionType>(type)->GetElementCount();
+}
+
+static Expr *lZeroInitializer(const Type *type, SourcePos pos) {
+    if (type->IsSOAType()) {
+        return new ExprList(pos);
+    }
+    if (CastType<PointerType>(type) != nullptr) {
+        return new NullPointerExpr(pos);
+    }
+    const EnumType *enumType = CastType<EnumType>(type);
+    if (enumType != nullptr) {
+        return new ConstExpr(enumType->GetAsUniformType(), (uint32_t)0, pos);
+    }
+    if (CastType<AtomicType>(type) != nullptr) {
+        return new ConstExpr(AtomicType::UniformInt32, (int32_t)0, pos);
+    }
+    return new ExprList(pos);
+}
+
+static bool lGetDesignatorIndex(const Designator &designator, const CollectionType *type, int *index) {
+    Expr *indexExpr = designator.index != nullptr ? TypeCheckAndOptimize(designator.index) : nullptr;
+    if (indexExpr == nullptr) {
+        AssertPos(designator.pos, m->errorCount > 0);
+        return false;
+    }
+    const Type *indexType = indexExpr->GetType();
+    llvm::ConstantInt *ci = nullptr;
+    if (indexType != nullptr && indexType->IsUniformType() && !indexType->IsBoolType()) {
+        ci = llvm::dyn_cast_or_null<llvm::ConstantInt>(indexExpr->GetConstant(indexType).first);
+    }
+    if (ci == nullptr) {
+        Error(designator.pos, "Array designator index must be a compile-time integer constant.");
+        return false;
+    }
+    int64_t value = indexType->IsUnsignedType() ? (int64_t)ci->getZExtValue() : ci->getSExtValue();
+    if (value < 0 || value > INT32_MAX || lIsPastEnd(type, (int)value)) {
+        Error(designator.pos, "Array designator index %lld is out of bounds for type \"%s\".", (long long)value,
+              type->GetString().c_str());
+        return false;
+    }
+    *index = (int)value;
+    return true;
+}
+
+static const Type *lApplyDesignator(const Type *type, const Designator &designator, int *index) {
+    if (designator.isIndex) {
+        if ((CastType<ArrayType>(type) == nullptr && CastType<VectorType>(type) == nullptr) ||
+            !lIsDesignatableType(type)) {
+            Error(designator.pos, "Array designator can't be used to initialize non-array type \"%s\".",
+                  type->GetString().c_str());
+            return nullptr;
+        }
+        const CollectionType *collectionType = CastType<CollectionType>(type);
+        if (!lGetDesignatorIndex(designator, collectionType, index)) {
+            return nullptr;
+        }
+        return collectionType->GetElementType(*index);
+    }
+
+    const VectorType *vectorType = CastType<VectorType>(type);
+    if (vectorType != nullptr && lIsDesignatableType(type)) {
+        *index = designator.member.size() == 1 ? lIdentifierToVectorElement(designator.member[0]) : -1;
+        if (*index == -1 || *index >= vectorType->GetElementCount()) {
+            Error(designator.pos, "Member designator \".%s\" doesn't name an element of vector type \"%s\".",
+                  designator.member.c_str(), type->GetString().c_str());
+            return nullptr;
+        }
+        return vectorType->GetElementType();
+    }
+
+    const StructType *structType = CastType<StructType>(type);
+    if (structType == nullptr || !lIsDesignatableType(type)) {
+        Error(designator.pos, "Member designator \".%s\" can't be used to initialize non-struct type \"%s\".",
+              designator.member.c_str(), type->GetString().c_str());
+        return nullptr;
+    }
+    *index = structType->GetElementNumber(designator.member);
+    if (*index == -1) {
+        Error(designator.pos, "Element name \"%s\" not present in struct type \"%s\".", designator.member.c_str(),
+              structType->GetString().c_str());
+        return nullptr;
+    }
+    return structType->GetElementType(*index);
+}
