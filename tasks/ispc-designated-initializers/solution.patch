+bool ExprList::HasDesignators() const {
+    for (const std::vector<Designator> &chain : designators) {
+        if (!chain.empty()) {
+            return true;
+        }
+    }
+    for (const Expr *expr : exprs) {
+        const ExprList *nested = llvm::dyn_cast_or_null<ExprList>(expr);
+        if (nested != nullptr && nested->HasDesignators()) {
+            return true;
+        }
+    }
+    return false;
+}
