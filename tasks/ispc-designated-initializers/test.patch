index 0000000..ed5b5f1
--- /dev/null
+++ b/tests/lit-tests/designated-init-err-index-range-c2cf13.ispc
@@ -0,0 +1,35 @@
+// Array designator indices outside a sized array or vector are errors that include the index.
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DARRAY %s -o %t.o 2>&1 | FileCheck %s --check-prefix=ARRAY --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DNEGATIVE %s -o %t.o 2>&1 | FileCheck %s --check-prefix=NEGATIVE --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DVECTOR %s -o %t.o 2>&1 | FileCheck %s --check-prefix=VECTOR --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DNESTED %s -o %t.o 2>&1 | FileCheck %s --check-prefix=NESTED --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DGLOBAL %s -o %t.o 2>&1 | FileCheck %s --check-prefix=GLOBAL --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+
+// ARRAY: Error:{{.*}}9
+// NEGATIVE: Error:{{.*}}-1
+// VECTOR: Error:{{.*}}5
+// NESTED: Error:{{.*}}7
+// GLOBAL: Error:{{.*}}6
+
+struct Poly {
+    int32 pts[3];
+};
+
+#ifdef GLOBAL
+uniform int32 g[4] = { [6] = 1 };
+#endif
+
+void f() {
+#ifdef ARRAY
+    uniform int32 a[4] = { [9] = 1 };
+#endif
+#ifdef NEGATIVE
+    uniform int32 a[4] = { [-1] = 1 };
+#endif
+#ifdef VECTOR
+    uniform float<3> v = { [5] = 1 };
+#endif
+#ifdef NESTED
+    uniform Poly p = { .pts[7] = 1 };
+#endif
+}
diff --git a/tests/lit-tests/designated-init-err-index-type-c2cf13.ispc b/tests/lit-tests/designated-init-err-index-type-c2cf13.ispc
