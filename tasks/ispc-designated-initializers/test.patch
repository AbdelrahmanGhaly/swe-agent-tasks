index 0000000..1b66268
--- /dev/null
+++ b/tests/lit-tests/designated-init-array-index-c2cf13.ispc
@@ -0,0 +1,25 @@
+// Array index designators with continuation, using constant and runtime values.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: a1 0 10 11 30
+// CHECK-NEXT: a2 1 2 3 0 5
+// CHECK-NEXT: a3 0 10 11 0 40
+// CHECK-NEXT: a4 2 3 1
+
+noinline uniform int32 id(uniform int32 v) { return v; }
+
+extern "C" uniform int main() {
+    uniform int32 a1[4] = { [3] = 30, [1] = 10, 11 };
+    print("a1 % % % %\n", a1[0], a1[1], a1[2], a1[3]);
+    uniform int32 a2[5] = { 1, 2, [4] = 5, [2] = 3 };
+    print("a2 % % % % %\n", a2[0], a2[1], a2[2], a2[3], a2[4]);
+    uniform int32 a3[5] = { [1] = id(10), id(11), [4] = id(40) };
+    print("a3 % % % % %\n", a3[0], a3[1], a3[2], a3[3], a3[4]);
+    uniform int32 a4[3] = { [2] = 1, [0] = id(2), 3 };
+    print("a4 % % %\n", a4[0], a4[1], a4[2]);
+    return 0;
+}
