+// Short vector elements designated with the one-letter vector member names.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: c 20 0 15 0
+// CHECK-NEXT: p 0 1 2
+// CHECK-NEXT: q 1 2 0 4
+// CHECK-NEXT: uv 6 0 0 5
+// CHECK-NEXT: vx 0 0 3 9
+// CHECK-NEXT: gcol 0 7 0
+// CHECK-NEXT: xa 30 0 0 5
+
+struct Vertex {
+    float<3> pos;
+    int32 id;
+};
+
+uniform int32<3> gcol = { .g = 7 };
+
+noinline uniform int32 id(uniform int32 v) { return v; }
+
+extern "C" uniform int main() {
+    uniform float<4> c = { .b = 1.5, .r = 2 };
+    print("c % % % %\n", (uniform int32)(c[0] * 10), (uniform int32)(c[1] * 10), (uniform int32)(c[2] * 10),
+          (uniform int32)(c[3] * 10));
+    uniform int32<3> p = { .y = 1, 2 };
+    print("p % % %\n", p[0], p[1], p[2]);
+    uniform int32<4> q = { .w = id(4), .u = id(1), .v = 2 };
+    print("q % % % %\n", q[0], q[1], q[2], q[3]);
+    uniform int32<2> uv[2] = { [1].v = 5, [0].u = 6 };
+    print("uv % % % %\n", uv[0][0], uv[0][1], uv[1][0], uv[1][1]);
+    uniform Vertex vx = { .pos.z = 3, .id = 9 };
+    print("vx % % % %\n", (uniform int32)vx.pos[0], (uniform int32)vx.pos[1], (uniform int32)vx.pos[2], vx.id);
+    print("gcol % % %\n", gcol[0], gcol[1], gcol[2]);
+    uniform float<4> xa = { .a = 0.5, .x = id(3) };
+    print("xa % % % %\n", (uniform int32)(xa[0] * 10), (uniform int32)(xa[1] * 10), (uniform int32)(xa[2] * 10),
+          (uniform int32)(xa[3] * 10));
+    return 0;
+}
