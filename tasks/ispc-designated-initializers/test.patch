+// Unsized global arrays take their size from the highest initialized element.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: u1 6 0 0 3 4 0 1
+// CHECK-NEXT: u2 3 0 5 6
+// CHECK-NEXT: u3 2 9 2
+// CHECK-NEXT: u4 3 0 1
+// CHECK-NEXT: u5 3 0 7 0 0 5 6
+
+struct Point {
+    int32 x, y;
+};
+
+uniform int32 u1[] = { [5] = 1, [2] = 3, 4 };
+static const uniform int32 u2[] = { [1] = 5, 6 };
+uniform int32 u3[] = { 1, 2, [0] = 9 };
+uniform Point u4[] = { [2].y = 1 };
+uniform int32 u5[][2] = { [2] = { 5, 6 }, [0][1] = 7 };
+
+extern "C" uniform int main() {
+    print("u1 % % % % % % %\n", (uniform int32)(sizeof(u1) / sizeof(u1[0])), u1[0], u1[1], u1[2], u1[3], u1[4],
+          u1[5]);
+    print("u2 % % % %\n", (uniform int32)(sizeof(u2) / sizeof(u2[0])), u2[0], u2[1], u2[2]);
+    print("u3 % % %\n", (uniform int32)(sizeof(u3) / sizeof(u3[0])), u3[0], u3[1]);
+    print("u4 % % %\n", (uniform int32)(sizeof(u4) / sizeof(u4[0])), u4[2].x, u4[2].y);
+    print("u5 % % % % % % %\n", (uniform int32)(sizeof(u5) / sizeof(u5[0])), u5[0][0], u5[0][1], u5[1][0], u5[1][1],
+          u5[2][0], u5[2][1]);
+    return 0;
+}
