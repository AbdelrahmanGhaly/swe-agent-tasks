diff --git a/tests/lit-tests/designated-init-err-too-many-c2cf13.ispc b/tests/lit-tests/designated-init-err-too-many-c2cf13.ispc
new file mode 100644
index 0000000..b08fdf0
--- /dev/null
+++ b/tests/lit-tests/designated-init-err-too-many-c2cf13.ispc
@@ -0,0 +1,65 @@
+// Items that continue past the end of the object after a designator are an error; plain lists with too many items keep their existing diagnostics.
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DARRAY %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DSTRUCT %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DGLOBAL %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DNESTED %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DCHAIN %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DVECTOR %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DPLAIN_ARRAY %s -o %t.o 2>&1 | FileCheck %s --check-prefix=PLAIN_ARRAY --implicit-check-not=Error:
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DPLAIN_STRUCT %s -o %t.o 2>&1 | FileCheck %s --check-prefix=PLAIN_STRUCT --implicit-check-not=Error:
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DPLAIN_VECTOR %s -o %t.o 2>&1 | FileCheck %s --check-prefix=PLAIN_VECTOR --implicit-check-not=Error:
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DPLAIN_GLOBAL %s -o %t.o 2>&1 | FileCheck %s --check-prefix=PLAIN_GLOBAL --implicit-check-not=Error:
+
+// CHECK: Error:
+
+struct Point {
+    int32 x, y;
+};
+
+struct Rect {
+    Point lo, hi;
+    int32 tag;
+};
+
+#ifdef GLOBAL
+uniform int32 g[2] = { [1] = 1, 2 };
+#endif
+
+#ifdef PLAIN_GLOBAL
+// PLAIN_GLOBAL: {{.*}}:[[@LINE+2]]:25: Error: Initializer list for array "uniform int32[2]" must have no more than 2 elements (has 3).
+// PLAIN_GLOBAL: {{.*}}:[[@LINE+1]]:25: Error: Initializer for global variable "ga" must be a constant.
+uniform int32 ga[2] = { 1, 2, 3 };
+#endif
+
+void f() {
+#ifdef ARRAY
+    uniform int32 a[3] = { [2] = 1, 2 };
+#endif
+#ifdef STRUCT
+    uniform Point p = { .y = 1, 2 };
+#endif
+#ifdef NESTED
+    uniform Rect r = { .hi = { .y = 1, 2 } };
+#endif
+#ifdef CHAIN
+    uniform Rect r = { .hi.y = 1, .tag = 2, 3 };
+#endif
+#ifdef VECTOR
+    uniform float<3> v = { [2] = 1, 2 };
+#endif
+#ifdef PLAIN_ARRAY
+    // PLAIN_ARRAY: {{.*}}:[[@LINE+2]]:28: Error: Initializer list for array "uniform int32[2]" must have no more than 2 elements (has 3).
+    // PLAIN_ARRAY: {{.*}}:[[@LINE+1]]:28: Error: Initializer for array type "uniform int32[2]" requires no more than 2 values; 3 provided.
+    uniform int32 a[2] = { 1, 2, 3 };
+#endif
+#ifdef PLAIN_STRUCT
+    // PLAIN_STRUCT: {{.*}}:[[@LINE+2]]:25: Error: Initializer list for struct "uniform struct Point" must have no more than 2 elements (has 3).
+    // PLAIN_STRUCT: {{.*}}:[[@LINE+1]]:25: Error: Initializer for struct type "uniform struct Point" requires no more than 2 values; 3 provided.
+    uniform Point p = { 1, 2, 3 };
+#endif
+#ifdef PLAIN_VECTOR
+    // PLAIN_VECTOR: {{.*}}:[[@LINE+2]]:28: Error: Initializer list for vector "uniform int32<2>" must have no more than 2 elements (has 3).
+    // PLAIN_VECTOR: {{.*}}:[[@LINE+1]]:28: Error: Initializer for vector type "uniform int32<2>" requires no more than 2 values; 3 provided.
+    uniform int32<2> v = { 1, 2, 3 };
+#endif
+}
