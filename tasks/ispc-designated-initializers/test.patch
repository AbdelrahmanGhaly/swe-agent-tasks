diff --git a/tests/lit-tests/designated-init-err-brace-elision-c2cf13.ispc b/tests/lit-tests/designated-init-err-brace-elision-c2cf13.ispc
new file mode 100644
index 0000000..e99d9d9
--- /dev/null
+++ b/tests/lit-tests/designated-init-err-brace-elision-c2cf13.ispc
@@ -0,0 +1,45 @@
+// An item that lands on a struct or array must be a brace list.
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DLOCAL %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DGLOBAL %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DARRAY %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DDESIGNATED %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DARRAY_MEMBER %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DARRAY_MEMBER_CONTINUED %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+
+// CHECK: Error:
+
+struct Point {
+    int32 x, y;
+};
+
+struct Rect {
+    Point lo, hi;
+    int32 tag;
+};
+
+struct Poly {
+    int32 n;
+    int32 pts[3];
+};
+
+#ifdef GLOBAL
+uniform Rect g = { .lo.y = 1, 2 };
+#endif
+
+void f() {
+#ifdef LOCAL
+    uniform Rect r = { .lo.y = 1, 2 };
+#endif
+#ifdef ARRAY
+    uniform Point pts[2] = { [0].y = 1, 2 };
+#endif
+#ifdef DESIGNATED
+    uniform Rect r = { .hi = 5 };
+#endif
+#ifdef ARRAY_MEMBER
+    uniform Poly p = { .pts = 5 };
+#endif
+#ifdef ARRAY_MEMBER_CONTINUED
+    uniform Poly p = { .n = 1, 2 };
+#endif
+}
diff --git a/tests/lit-tests/designated-init-err-global-nonconstant-c2cf13.ispc b/tests/lit-tests/designated-init-err-global-nonconstant-c2cf13.ispc
new file mode 100644
index 0000000..b1983e7
--- /dev/null
+++ b/tests/lit-tests/designated-init-err-global-nonconstant-c2cf13.ispc
@@ -0,0 +1,36 @@
+// Designated initializers for global and static variables must still be compile-time constants, just like positional ones.
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DDESIGNATED_CALL %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DDESIGNATED_VARIABLE %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DDESIGNATED_SOA_GLOBAL %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DDESIGNATED_SOA_STATIC %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DPOSITIONAL %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+
+// CHECK: Error:{{.*}}constant
+
+struct Point {
+    int32 x, y;
+};
+
+uniform int32 counter = 3;
+
+uniform int32 next() { return counter + 1; }
+
+#ifdef DESIGNATED_CALL
+uniform int32 g[2] = { [1] = next() };
+#endif
+
+#ifdef DESIGNATED_VARIABLE
+uniform Point gp = { .y = counter };
+#endif
+
+#ifdef DESIGNATED_SOA_GLOBAL
+const soa<4> Point gs[1] = { [0].y = { 1, 2, 3, 4 } };
+#endif
+
+#ifdef DESIGNATED_SOA_STATIC
+void staticSoa() { static soa<4> Point ls[2] = { [1] = { .x = { 1, 2, 3, 4 } } }; }
+#endif
+
+#ifdef POSITIONAL
+uniform int32 h[2] = { 0, next() };
+#endif
diff --git a/tests/lit-tests/designated-init-err-inconsistent-2d-c2cf13.ispc b/tests/lit-tests/designated-init-err-inconsistent-2d-c2cf13.ispc
