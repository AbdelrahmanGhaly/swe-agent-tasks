+// Designated sub-lists in multi-dimensional arrays declared without any sizes; a replaced sub-list does not count for sizing.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: g1 2 3 0 0 1 4 5 6
+// CHECK-NEXT: g2 3 2 0 0 0 2 3 4
+// CHECK-NEXT: g3 2 2 3 4 5 6
+// CHECK-NEXT: g4 1 1 2
+// CHECK-NEXT: g5 1 4 0 0 0 1
+
+uniform int32 g1[][] = { { [2] = 1 }, { 4, 5, 6 } };
+uniform int32 g2[][] = { [1] = { [1] = 2 }, { 3, 4 } };
+uniform int32 g4[][] = { [0] = { [3] = 1 }, [0] = { 2 } };
+
+extern "C" uniform int main() {
+    print("g1 % % % % % % % %\n", (uniform int32)(sizeof(g1) / sizeof(g1[0])),
+          (uniform int32)(sizeof(g1[0]) / sizeof(g1[0][0])), g1[0][0], g1[0][1], g1[0][2], g1[1][0], g1[1][1], g1[1][2]);
+    print("g2 % % % % % % % %\n", (uniform int32)(sizeof(g2) / sizeof(g2[0])),
+          (uniform int32)(sizeof(g2[0]) / sizeof(g2[0][0])), g2[0][0], g2[0][1], g2[1][0], g2[1][1], g2[2][0], g2[2][1]);
+    uniform int32 g3[][] = { [0] = { 1, 2 }, [1] = { 5, 6 }, [0] = { 3, 4 } };
+    print("g3 % % % % % %\n", (uniform int32)(sizeof(g3) / sizeof(g3[0])),
+          (uniform int32)(sizeof(g3[0]) / sizeof(g3[0][0])), g3[0][0], g3[0][1], g3[1][0], g3[1][1]);
+    print("g4 % % %\n", (uniform int32)(sizeof(g4) / sizeof(g4[0])), (uniform int32)(sizeof(g4[0]) / sizeof(g4[0][0])),
+          g4[0][0]);
+    uniform int32 g5[][] = { [0] = { 2 }, [0] = { [3] = 1 } };
+    print("g5 % % % % % %\n", (uniform int32)(sizeof(g5) / sizeof(g5[0])),
+          (uniform int32)(sizeof(g5[0]) / sizeof(g5[0][0])), g5[0][0], g5[0][1], g5[0][2], g5[0][3]);
+    return 0;
+}
