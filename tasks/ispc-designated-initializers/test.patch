+// Designators in multi-dimensional arrays.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: m 1 0 0 4 0 9
+// CHECK-NEXT: n 6 7 0 5
+// CHECK-NEXT: k 1 0 0 2 0 3 0 0
+// CHECK-NEXT: r 0 3 2 4
+
+noinline uniform int32 id(uniform int32 v) { return v; }
+
+extern "C" uniform int main() {
+    uniform int32 m[2][3] = { [1][2] = 9, [0] = { 1 }, [1][0] = 4 };
+    print("m % % % % % %\n", m[0][0], m[0][1], m[0][2], m[1][0], m[1][1], m[1][2]);
+    uniform int32 n[2][2] = { [1] = { [1] = 5 }, [0][0] = 6, 7 };
+    print("n % % % %\n", n[0][0], n[0][1], n[1][0], n[1][1]);
+    uniform int32 k[2][2][2] = { [1][0][1] = 3, [0] = { { 1 }, [1][1] = 2 } };
+    print("k % % % % % % % %\n", k[0][0][0], k[0][0][1], k[0][1][0], k[0][1][1], k[1][0][0], k[1][0][1], k[1][1][0],
+          k[1][1][1]);
+    uniform int32 r[2][2] = { [1][1] = id(4), [0][1] = id(3), [1][0] = id(2) };
+    print("r % % % %\n", r[0][0], r[0][1], r[1][0], r[1][1]);
+    return 0;
+}
