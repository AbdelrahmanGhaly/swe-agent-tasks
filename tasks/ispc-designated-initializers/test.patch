+          (uniform int32)wide[7].y);
+    soa<8> Point direct = { .z = { 8, 7, 6, 5, 4, 3, 2, 1 }, .x = { 1, 2, 3, 4, 5, 6, 7, 8 } };
+    soa<8> Point *uniform dp = &direct;
+    print("direct % % % %\n", (uniform int32)dp[6].x, (uniform int32)dp[1].z, (uniform int32)dp[5].y,
+          (uniform int32)dp[7].z);
