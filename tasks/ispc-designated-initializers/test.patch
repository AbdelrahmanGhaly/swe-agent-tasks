diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..bb333f5
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,98 @@
+#!/bin/bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+    --output_path=*)
+        OUTPUT_PATH="${1#--output_path=}"
+        shift
+        ;;
+    --output_path)
+        OUTPUT_PATH="$2"
+        shift 2
+        ;;
+    base | new)
+        MODE="$1"
+        shift
+        ;;
+    *)
+        shift
+        ;;
+    esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-$(pwd)/test-results.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+BUILD_DIR="$ROOT/build"
+NEW_TEST_PATTERN='designated-init-*-c2cf13.ispc'
+
+xml_escape() {
+    tr -d '\000-\010\013\014\016-\037' | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+write_failure() {
+    local details
+    details="$(printf '%s\n' "${3:-$2}" | xml_escape)"
+    cat >"$OUTPUT_PATH" <<EOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+<testsuite name="ispc-$MODE" tests="1" failures="1" errors="0">
+<testcase classname="ispc.$MODE" name="$1">
+<failure message="$2">$details</failure>
+</testcase>
+</testsuite>
+</testsuites>
+EOF
+}
+
+JOBS="$(nproc)"
+if [ "$JOBS" -gt 8 ]; then
+    JOBS=8
+fi
+if ! cmake --build "$BUILD_DIR" --target ispc ispc-opt generic-target-bc stdlibs-bc stdlib-headers \
+    -j"$JOBS" >"$BUILD_DIR/test-build.log" 2>&1; then
+    tail -n 60 "$BUILD_DIR/test-build.log"
+    write_failure "build" "ispc failed to build" "$(tail -n 60 "$BUILD_DIR/test-build.log")"
+    exit 1
+fi
+
+LIT_ARGS=(
+    "--path=$BUILD_DIR/bin"
+    "--path=/usr/lib/llvm-21/bin"
+    "-Dispc_build_dir=$BUILD_DIR"
+    "-Dispc_test_exec_root=$BUILD_DIR/bin/tests"
+    "-Dispc_llvm_version_number=$(/usr/lib/llvm-21/bin/llvm-config --version)"
+    -Dx86_enabled=ON -Darm_enabled=OFF -Driscv_enabled=OFF -Dppc64_enabled=OFF -Dwasm_enabled=OFF -Dxe_enabled=OFF
+    -Dwindows_enabled=OFF -Dlinux_enabled=ON -Dps_enabled=OFF -Dmacos_arm_enabled=OFF -Dmacos_ios_enabled=OFF
+    "-Dfile_check_executable=/usr/lib/llvm-21/bin/FileCheck"
+    -Dispc_lib_enabled=OFF -Dispc_lib_jit_enabled=OFF
+    "--xunit-xml-output=$OUTPUT_PATH"
+)
+if [ "$MODE" = "new" ]; then
+    mapfile -t TESTS < <(find "$ROOT/tests/lit-tests" -maxdepth 1 -type f -name "$NEW_TEST_PATTERN" | sort)
+else
+    # 2334_unroll.ispc and 3081.ispc match exact loop-unroll and fptosi codegen that the LLVM 21.1.8
+    # packages in this image do not produce; both already fail on the unmodified base commit and
+    # neither involves initializers.
+    mapfile -t TESTS < <(find "$ROOT/tests/lit-tests" -maxdepth 1 -type f \( -name '*.ispc' -o -name '*.ll' -o -name '*.cpp' \) \
+        ! -name "$NEW_TEST_PATTERN" ! -name '2334_unroll.ispc' ! -name '3081.ispc' | sort)
+fi
+if [ "${#TESTS[@]}" -eq 0 ]; then
+    write_failure "discovery" "no lit tests found for mode $MODE"
+    exit 1
+fi
+
+rm -f "$OUTPUT_PATH"
+python3 "$ROOT/utils/lit/lit.py" "${LIT_ARGS[@]}" -v "${TESTS[@]}"
+STATUS=$?
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q "<testcase" "$OUTPUT_PATH"; then
+    write_failure "lit" "lit produced no test results"
+    if [ $STATUS -eq 0 ]; then
+        STATUS=1
+    fi
+fi
+exit $STATUS
diff --git a/tests/lit-tests/designated-init-array-index-c2cf13.ispc b/tests/lit-tests/designated-init-array-index-c2cf13.ispc
