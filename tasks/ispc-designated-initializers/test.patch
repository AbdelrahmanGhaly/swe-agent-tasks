@@ -0,0 +1,52 @@
+// Members and elements that no item initializes are zero, and pointers are null.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: g 0 true false 0 true true 0 0
+// CHECK-NEXT: l 3 true false 0 true true 0 7
+// CHECK-NEXT: h true true true 0 4 true
+// CHECK-NEXT: s true 0 5 true
+
+enum Axis { AX, AY, AZ };
+
+struct Node {
+    int32 value;
+    Node *uniform next;
+    bool flag;
+    Axis axis;
+    float w;
+    double d;
+    int8 small;
+    uint16 tiny;
+};
+
+struct Holder {
+    Node node;
+    int32 arr[2];
+    Node *uniform ptrs[2];
+};
+
+uniform Node g = { .d = 2.5 };
+
+noinline uniform int32 id(uniform int32 v) { return v; }
+
+noinline void staticCase() {
+    static uniform Holder s = { .arr[1] = 5 };
+    print("s % % % %\n", s.node.next == NULL, s.arr[0], s.arr[1], s.ptrs[0] == NULL && s.ptrs[1] == NULL);
+}
+
+extern "C" uniform int main() {
+    print("g % % % % % % % %\n", g.value, g.next == NULL, g.flag, (uniform int32)g.axis, g.w == 0, g.d == 2.5, g.small,
+          g.tiny);
+    uniform Node l = { .tiny = 7, .value = id(3) };
+    print("l % % % % % % % %\n", l.value, l.next == NULL, l.flag, (uniform int32)l.axis, l.w == 0, l.d == 0, l.small,
+          l.tiny);
+    uniform Holder h = { .arr[1] = id(4) };
+    print("h % % % % % %\n", h.node.next == NULL, h.ptrs[0] == NULL, h.ptrs[1] == NULL, h.arr[0], h.arr[1],
+          h.node.d == 0);
+    staticCase();
+    return 0;
+}
