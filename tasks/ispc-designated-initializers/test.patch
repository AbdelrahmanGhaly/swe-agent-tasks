+// Designators are rejected in initializers for types other than structs, arrays and vectors.
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DVARYING %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DUNIFORM %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DMEMBER %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DGLOBAL_VARYING %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DPOINTER %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DPOINTER_TO_STRUCT %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DENUM %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DGLOBAL_ENUM %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DFLOAT %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+
+// CHECK: Error:
+
+struct Point {
+    int32 x, y;
+};
+
+enum Axis { AX, AY };
+
+#ifdef GLOBAL_VARYING
+static const varying int32 gx = { [0] = 1 };
+#endif
+
+#ifdef GLOBAL_ENUM
+uniform Axis ge = { .x = 1 };
+#endif
+
+void f() {
+#ifdef VARYING
+    varying int32 x = { [0] = 1 };
+#endif
+#ifdef UNIFORM
+    uniform int32 y = { .a = 1 };
+#endif
+#ifdef MEMBER
+    uniform Point p = { .x = { [0] = 1 } };
+#endif
+#ifdef POINTER
+    uniform int32 *uniform ptr = { [0] = 1 };
+#endif
+#ifdef POINTER_TO_STRUCT
+    uniform Point *uniform pp = { .x = 1 };
+#endif
+#ifdef ENUM
+    uniform Axis e = { [0] = AX };
+#endif
+#ifdef FLOAT
+    uniform float fl = { [0] = 1 };
+#endif
+}
