diff --git a/tests/lit-tests/designated-init-global-c2cf13.ispc b/tests/lit-tests/designated-init-global-c2cf13.ispc
new file mode 100644
index 0000000..6302dc6
--- /dev/null
+++ b/tests/lit-tests/designated-init-global-c2cf13.ispc
@@ -0,0 +1,39 @@
+// Designated initializers for global variables.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: grect 1 0 0 2 3
+// CHECK-NEXT: garr 0 10 11 40
+// CHECK-NEXT: gpts 6 0 0 5
+// CHECK-NEXT: ctable 5 0 0 0 0 50
+// CHECK-NEXT: gm 2 3 0 1
+// CHECK-NEXT: crect 1 3 0 0 7
+
+struct Point {
+    int32 x, y;
+};
+
+struct Rect {
+    Point lo, hi;
+    int32 tag;
+};
+
+uniform Rect grect = { .hi = { .y = 2 }, .tag = 3, .lo.x = 1 };
+uniform int32 garr[4] = { [3] = 40, [1] = 10, 11 };
+uniform Point gpts[2] = { [1].y = 5, [0] = { 6 } };
+static const uniform int32 ctable[6] = { [5] = 50, [0] = 5 };
+uniform int32 gm[2][2] = { [1][1] = 1, [0] = { 2, 3 } };
+const uniform Rect crect = { .tag = 7, .lo = { 1, 2 }, .lo.y = 3 };
+
+extern "C" uniform int main() {
+    print("grect % % % % %\n", grect.lo.x, grect.lo.y, grect.hi.x, grect.hi.y, grect.tag);
+    print("garr % % % %\n", garr[0], garr[1], garr[2], garr[3]);
+    print("gpts % % % %\n", gpts[0].x, gpts[0].y, gpts[1].x, gpts[1].y);
+    print("ctable % % % % % %\n", ctable[0], ctable[1], ctable[2], ctable[3], ctable[4], ctable[5]);
+    print("gm % % % %\n", gm[0][0], gm[0][1], gm[1][0], gm[1][1]);
+    print("crect % % % % %\n", crect.lo.x, crect.lo.y, crect.hi.x, crect.hi.y, crect.tag);
+    return 0;
+}
diff --git a/tests/lit-tests/designated-init-local-const-c2cf13.ispc b/tests/lit-tests/designated-init-local-const-c2cf13.ispc
new file mode 100644
index 0000000..d8abd62
--- /dev/null
+++ b/tests/lit-tests/designated-init-local-const-c2cf13.ispc
@@ -0,0 +1,56 @@
+// Local const variables, plain or brace-initialized, as array designator indices, and designated initializers for local const aggregates.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: a 0 7 8
+// CHECK-NEXT: b 0 4 9
+// CHECK-NEXT: c 0 0 5
+// CHECK-NEXT: e 4 5 6
+// CHECK-NEXT: s 0 3 0
+// CHECK-NEXT: t 0 0 4
+// CHECK-NEXT: cp 0 2 6
+// CHECK-NEXT: d 1 0
+
+enum Axis { AX, AY, AZ };
+
+struct Point {
+    int32 x, y;
+};
+
+noinline void staticCase() {
+    const uniform int32 k = 1;
+    static uniform int32 s[3] = { [k] = 3 };
+    print("s % % %\n", s[0], s[1], s[2]);
+    const uniform int32 j = { 2 };
+    static uniform int32 t[3] = { [j] = 4 };
+    print("t % % %\n", t[0], t[1], t[2]);
+}
+
+extern "C" uniform int main() {
+    const uniform int32 k = 1;
+    uniform int32 a[3] = { [k] = 7, 8 };
+    print("a % % %\n", a[0], a[1], a[2]);
+    const uniform int32 k2 = k + 1;
+    uniform int32 b[3] = { [k2] = 9, [k2 - k] = 4 };
+    print("b % % %\n", b[0], b[1], b[2]);
+    const uniform Axis last = AZ;
+    uniform int32 c[3] = { [last] = 5 };
+    print("c % % %\n", c[0], c[1], c[2]);
+    const uniform int32 slot = { 1 };
+    const uniform Axis mid = { AZ };
+    const uniform int8 first = { 0 };
+    uniform int32 e[3] = { [mid] = 6, [slot] = 5, [first] = 4 };
+    print("e % % %\n", e[0], e[1], e[2]);
+    staticCase();
+    const uniform Point cp = { .y = 2 };
+    print("cp % % %\n", cp.x, cp.y, cp.y * 3);
+    {
+        const uniform int32 j = 0;
+        uniform int32 d[2] = { [j] = 1 };
+        print("d % %\n", d[0], d[1]);
+    }
+    return 0;
+}
diff --git a/tests/lit-tests/designated-init-multidim-c2cf13.ispc b/tests/lit-tests/designated-init-multidim-c2cf13.ispc
