index 0000000..285b497
--- /dev/null
+++ b/tests/lit-tests/designated-init-soa-c2cf13.ispc
@@ -0,0 +1,41 @@
+// Designated initializers for soa<N> structs and arrays of them, including const arrays.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: pts 3 18 0 0 20
+// CHECK-NEXT: direct 3 6 0 1
+// CHECK-NEXT: one 11 4 0 0
+// CHECK-NEXT: u 8 6 0 3
+// CHECK-NEXT: rt 7 0 12
+// CHECK-NEXT: cpts 6 3 0 0
+
+struct Point {
+    float x, y, z;
+};
+
+noinline uniform float idf(uniform float v) { return v; }
+
+extern "C" uniform int main() {
+    soa<4> Point pts[2] = { [1] = { .y = { 17, 18, 19, 20 } }, [0].x = { 1, 2, 3, 4 } };
+    print("pts % % % % %\n", (uniform int32)pts[2].x, (uniform int32)pts[5].y, (uniform int32)pts[1].z,
+          (uniform int32)pts[4].x, (uniform int32)pts[7].y);
+    soa<4> Point direct = { .y = { 5, 6, 7, 8 }, .x = { 1, 2, 3, 4 } };
+    soa<4> Point *uniform dp = &direct;
+    print("direct % % % %\n", (uniform int32)dp[2].x, (uniform int32)dp[1].y, (uniform int32)dp[3].z,
+          (uniform int32)dp[0].x);
+    soa<4> Point one[1] = { { .z = { 9, 10, 11, 12 }, .x = { 1, 2, 3, 4 } } };
+    print("one % % % %\n", (uniform int32)one[2].z, (uniform int32)one[3].x, (uniform int32)one[1].y,
+          (uniform int32)one[0].y);
+    soa<4> Point u[] = { [1].y = { 5, 6, 7, 8 }, [0].z = { 1, 2, 3, 4 } };
+    print("u % % % %\n", (uniform int32)(sizeof(u) / sizeof(u[0])), (uniform int32)u[5].y, (uniform int32)u[5].x,
+          (uniform int32)u[2].z);
+    soa<4> Point r[1] = { { .y = { idf(5), 6, idf(7), 8 }, .z = { 9, 10, 11, idf(12) } } };
+    print("rt % % %\n", (uniform int32)r[2].y, (uniform int32)r[0].x, (uniform int32)r[3].z);
+    const soa<4> Point cpts[2] = { [1].y = { 5, 6, 7, 8 }, [0] = { .z = { 1, 2, 3, 4 } } };
+    print("cpts % % % %\n", (uniform int32)cpts[5].y, (uniform int32)cpts[2].z, (uniform int32)cpts[6].x,
+          (uniform int32)cpts[0].y);
+    return 0;
+}
