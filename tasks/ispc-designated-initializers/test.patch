+    print("case79 % % % % % % % % % % %\n", v.m0.m0, v.m0.m1.m0, v.m0.m1.m1, v.m1, v.m2.m0, v.m2.m1.m0, v.m2.m1.m1, v.m2.m1.m2, v.m2.m2[0], v.m2.m2[1], v.m2.m2[2]);
