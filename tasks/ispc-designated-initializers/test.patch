+// Designators that mix array elements and struct members.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: p1 4 5 0 0 0 9
+// CHECK-NEXT: p2 0 0 0 4 5 6
+// CHECK-NEXT: p3 0 1 0 0 7 8
+
+struct Point {
+    int32 x, y;
+};
+
+noinline uniform int32 id(uniform int32 v) { return v; }
+
+extern "C" uniform int main() {
+    uniform Point p1[3] = { [2] = { .y = 9 }, [0].x = 4, 5 };
+    print("p1 % % % % % %\n", p1[0].x, p1[0].y, p1[1].x, p1[1].y, p1[2].x, p1[2].y);
+    uniform Point p2[3] = { [1].y = 4, { 5, 6 } };
+    print("p2 % % % % % %\n", p2[0].x, p2[0].y, p2[1].x, p2[1].y, p2[2].x, p2[2].y);
+    uniform Point p3[3] = { { .y = 1 }, [2].x = id(7), id(8) };
+    print("p3 % % % % % %\n", p3[0].x, p3[0].y, p3[1].x, p3[1].y, p3[2].x, p3[2].y);
+    return 0;
+}
diff --git a/tests/lit-tests/designated-init-const-index-c2cf13.ispc b/tests/lit-tests/designated-init-const-index-c2cf13.ispc
new file mode 100644
index 0000000..da0fd31
--- /dev/null
+++ b/tests/lit-tests/designated-init-const-index-c2cf13.ispc
@@ -0,0 +1,36 @@
+// Array designator indices given by enum values, plain and brace-initialized const variables, and constant arithmetic.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: v 0 5 6 7
+// CHECK-NEXT: w 2 0 1 0
+// CHECK-NEXT: u 0 4 3 0
+// CHECK-NEXT: gv 2 0 0 1
+// CHECK-NEXT: gb 3 0 7 8
+// CHECK-NEXT: lb 0 0 9 4
+
+enum Axis { AX, AY, AZ, AW };
+
+static const uniform int32 LAST = 3;
+static const uniform int32 SLOT = { 1 };
+const uniform Axis BRACED = { AZ };
+
+uniform int32 gv[4] = { [LAST] = 1, [AX] = 2 };
+uniform int32 gb[] = { [SLOT] = 7, [BRACED] = 8 };
+
+extern "C" uniform int main() {
+    uniform int32 v[4] = { [LAST] = 7, [AY] = 5, [AX + 2] = 6 };
+    print("v % % % %\n", v[0], v[1], v[2], v[3]);
+    uniform int32 w[LAST + 1] = { [LAST - 1] = 1, [2 * 0] = 2 };
+    print("w % % % %\n", w[0], w[1], w[2], w[3]);
+    uniform int32 u[4] = { [AW - AY] = 3, [(LAST + AZ) / 5] = 4 };
+    print("u % % % %\n", u[0], u[1], u[2], u[3]);
+    print("gv % % % %\n", gv[0], gv[1], gv[2], gv[3]);
+    print("gb % % % %\n", (uniform int32)(sizeof(gb) / sizeof(gb[0])), gb[0], gb[1], gb[2]);
+    uniform int32 lb[4] = { [BRACED + SLOT] = 4, [BRACED] = 9 };
+    print("lb % % % %\n", lb[0], lb[1], lb[2], lb[3]);
+    return 0;
+}
diff --git a/tests/lit-tests/designated-init-conversion-c2cf13.ispc b/tests/lit-tests/designated-init-conversion-c2cf13.ispc
new file mode 100644
index 0000000..b759346
--- /dev/null
+++ b/tests/lit-tests/designated-init-conversion-c2cf13.ispc
@@ -0,0 +1,41 @@
+// Designated values are converted to the type of the member they initialize.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: m1 false 5 3
+// CHECK-NEXT: m2 true 7 100
+// CHECK-NEXT: t1 2 42 false
+// CHECK-NEXT: t2 0 9 true
+// CHECK-NEXT: gm false 11 0
+
+enum Level { LOW, MID, HIGH };
+
+struct Mixed {
+    bool flag;
+    int32 count;
+    int8 small;
+};
+
+struct Tagged {
+    Level level;
+    int32 value;
+    bool on;
+};
+
+uniform Mixed gm = { .count = 11 };
+
+extern "C" uniform int main() {
+    uniform Mixed m1 = { .count = 5, .small = 3 };
+    print("m1 % % %\n", m1.flag, m1.count, m1.small);
+    uniform Mixed m2 = { .small = 100, .flag = true, 7 };
+    print("m2 % % %\n", m2.flag, m2.count, m2.small);
+    uniform Tagged t1 = { .value = 42, .level = HIGH };
+    print("t1 % % %\n", (uniform int32)t1.level, t1.value, t1.on);
+    uniform Tagged t2 = { .on = true, .value = 9 };
+    print("t2 % % %\n", (uniform int32)t2.level, t2.value, t2.on);
+    print("gm % % %\n", gm.flag, gm.count, gm.small);
+    return 0;
+}
