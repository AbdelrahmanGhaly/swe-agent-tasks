+
+noinline void case296() {
+    static uniform C296_S1 v = { .m0 = 79, .m1 = { .m2 = { [1] = 43, [1] = 42, [0] = 7, [0] = 75, [1] = 5 } } };
+    print("case296 % % % % % % % % %\n", v.m0, v.m1.m0[0], v.m1.m1, v.m1.m2[0], v.m1.m2[1], v.m1.m3[0], v.m1.m3[1], v.m1.m3[2], v.m2);
