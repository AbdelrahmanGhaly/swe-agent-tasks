+// A designator reaching inside an element set by an earlier brace list only changes that part.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: q1 1 5 0
+// CHECK-NEXT: q2 3 5 4
+// CHECK-NEXT: q3 8 2 0
+// CHECK-NEXT: m 0 0 7 2
+// CHECK-NEXT: g 1 6 0
+
+struct P {
+    int32 x, y;
+};
+
+struct Q {
+    P p;
+    int32 d;
+};
+
+uniform Q g = { .p = { 1, 2 }, .p.y = 6 };
+
+noinline uniform int32 id(uniform int32 v) { return v; }
+
+extern "C" uniform int main() {
+    uniform Q q1 = { .p = { 1, 2 }, .p.y = 5 };
+    print("q1 % % %\n", q1.p.x, q1.p.y, q1.d);
+    uniform Q q2 = { .p.x = 3, .d = 4, .p.y = 5 };
+    print("q2 % % %\n", q2.p.x, q2.p.y, q2.d);
+    uniform Q q3 = { .p = { id(1), id(2) }, .p.x = id(8) };
+    print("q3 % % %\n", q3.p.x, q3.p.y, q3.d);
+    uniform int32 m[2][2] = { [1] = { 1, 2 }, [1][0] = 7 };
+    print("m % % % %\n", m[0][0], m[0][1], m[1][0], m[1][1]);
+    print("g % % %\n", g.p.x, g.p.y, g.d);
+    return 0;
+}
diff --git a/tests/lit-tests/designated-init-override-warning-c2cf13.ispc b/tests/lit-tests/designated-init-override-warning-c2cf13.ispc
new file mode 100644
index 0000000..4f6c6ce
--- /dev/null
+++ b/tests/lit-tests/designated-init-override-warning-c2cf13.ispc
@@ -0,0 +1,71 @@
+// Overwriting something an earlier item explicitly initialized is accepted with a warning at the later item.
+// RUN: %{ispc} --target=host --nowrap --nostdlib %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not=Warning: --implicit-check-not=Error:
+
+struct P {
+    int32 x, y;
+};
+
+struct Q {
+    P p;
+    int32 d;
+};
+
+uniform Q gq = {
+    .d = 1,
+    // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+    .d = 2
+};
+
+void f() {
+    uniform int32 a[4] = {
+        [2] = 7,
+        [0] = 1,
+        2,
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        3
+    };
+    uniform Q q1 = {
+        .p = { 1, 2 },
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        .p.y = 5
+    };
+    uniform Q q2 = {
+        .p.y = 5,
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        .p = { 1 }
+    };
+    uniform Q q3 = {
+        .p = { 1 },
+        .p.y = 5
+    };
+    uniform Q q4 = {
+        .p = {
+            .x = 1,
+            // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+            .x = 2
+        }
+    };
+    uniform int32 m[2][2] = {
+        [1] = { 1, 2 },
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        [1][0] = 7
+    };
+    uniform int32 k[3] = { [0] = 1, 2, [2] = 3 };
+    uniform P plain = { 1, 2 };
+    uniform float<3> v = {
+        .x = 1,
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        .x = 2
+    };
+    uniform int32<4> w = {
+        [0] = 1,
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        [0] = 2
+    };
+    uniform P *uniform ptr = uniform new uniform P(
+        .x = 1,
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        .x = 2
+    );
+    delete ptr;
+}
diff --git a/tests/lit-tests/designated-init-override-warning-replaced-c2cf13.ispc b/tests/lit-tests/designated-init-override-warning-replaced-c2cf13.ispc
