+++ b/tests/lit-tests/designated-init-struct-members-c2cf13.ispc
@@ -0,0 +1,35 @@
+// Designated struct members with gaps and continuation, using constant and runtime values.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: c1 1 0 3 4
+// CHECK-NEXT: c2 1 0 3 4
+// CHECK-NEXT: c3 0 0 7 8
+// CHECK-NEXT: c4 0 5 0 0
+// CHECK-NEXT: c5 9 6 7 2
+// CHECK-NEXT: c6 9 6 7 2
+
+struct Color {
+    int32 r, g, b, a;
+};
+
+noinline uniform int32 id(uniform int32 v) { return v; }
+
+extern "C" uniform int main() {
+    uniform Color c1 = { .b = 3, 4, .r = 1 };
+    print("c1 % % % %\n", c1.r, c1.g, c1.b, c1.a);
+    uniform Color c2 = { .b = id(3), id(4), .r = id(1) };
+    print("c2 % % % %\n", c2.r, c2.g, c2.b, c2.a);
+    uniform Color c3 = { .b = 7, 8 };
+    print("c3 % % % %\n", c3.r, c3.g, c3.b, c3.a);
+    uniform Color c4 = { .g = id(5) };
+    print("c4 % % % %\n", c4.r, c4.g, c4.b, c4.a);
+    uniform Color c5 = { 9, .a = 2, .g = 6, 7 };
+    print("c5 % % % %\n", c5.r, c5.g, c5.b, c5.a);
+    uniform Color c6 = { id(9), .a = id(2), .g = id(6), id(7) };
+    print("c6 % % % %\n", c6.r, c6.g, c6.b, c6.a);
+    return 0;
+}
diff --git a/tests/lit-tests/designated-init-struct-value-c2cf13.ispc b/tests/lit-tests/designated-init-struct-value-c2cf13.ispc
new file mode 100644
index 0000000..f86fd84
--- /dev/null
+++ b/tests/lit-tests/designated-init-struct-value-c2cf13.ispc
@@ -0,0 +1,52 @@
+// Plain initializer lists still take struct and vector values for struct and vector members; with designators the same members take brace lists.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: plain 1 3 4 9
+// CHECK-NEXT: plain-array 3 4 3 4
+// CHECK-NEXT: designated 2 3 4 0
+// CHECK-NEXT: element 0 0 3 4
+// CHECK-NEXT: plain-vector 1 7 8 2 3 3
+// CHECK-NEXT: designated-vector 5 7 8
+
+struct Point {
+    int32 x, y;
+};
+
+struct Rect {
+    int32 tag;
+    Point pos;
+    int32 area;
+};
+
+struct Tagged {
+    int32 tag;
+    uniform int32<2> v;
+};
+
+noinline uniform Point make(uniform int32 x, uniform int32 y) {
+    uniform Point p = { x, y };
+    return p;
+}
+
+extern "C" uniform int main() {
+    uniform Point p = make(3, 4);
+    uniform Rect r1 = { 1, p, 9 };
+    print("plain % % % %\n", r1.tag, r1.pos.x, r1.pos.y, r1.area);
+    uniform Point pts[2] = { p, p };
+    print("plain-array % % % %\n", pts[0].x, pts[0].y, pts[1].x, pts[1].y);
+    uniform Rect r2 = { .pos = { p.x, p.y }, .tag = 2 };
+    print("designated % % % %\n", r2.tag, r2.pos.x, r2.pos.y, r2.area);
+    uniform Point qs[2] = { [1] = { p.x, p.y } };
+    print("element % % % %\n", qs[0].x, qs[0].y, qs[1].x, qs[1].y);
+    uniform int32<2> pv = { p.x + 4, p.y + 4 };
+    uniform Tagged t1 = { 1, pv };
+    uniform Tagged t2 = { 2, 3 };
+    print("plain-vector % % % % % %\n", t1.tag, t1.v.x, t1.v.y, t2.tag, t2.v.x, t2.v.y);
+    uniform Tagged t3 = { .v = { pv.x, pv.y }, .tag = 5 };
+    print("designated-vector % % %\n", t3.tag, t3.v.x, t3.v.y);
+    return 0;
+}
diff --git a/tests/lit-tests/designated-init-templates-c2cf13.ispc b/tests/lit-tests/designated-init-templates-c2cf13.ispc
new file mode 100644
index 0000000..b5972b3
--- /dev/null
+++ b/tests/lit-tests/designated-init-templates-c2cf13.ispc
@@ -0,0 +1,44 @@
+// Designated initializers inside function templates.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: add 53
+// CHECK-NEXT: make 0 3
+// CHECK-NEXT: fill3 98
+// CHECK-NEXT: fill2 980
+
+struct Point {
+    int32 x, y;
+};
+
+struct Rect {
+    Point lo, hi;
+    int32 tag;
+};
+
+template <typename T> noinline T addTag(T v) {
+    uniform Rect r = { .tag = 5, .lo.y = 2 };
+    return v + r.tag * 10 + r.lo.y;
+}
+
+template <typename T> noinline T makeValue() {
+    T v = { .y = 3 };
+    return v;
+}
+
+template <int N> noinline uniform int32 fill() {
+    uniform int32 a[4] = { [N - 1] = 9, 8 };
+    return a[0] * 1000 + a[1] * 100 + a[2] * 10 + a[3];
+}
+
+extern "C" uniform int main() {
+    print("add %\n", addTag<uniform int32>(1));
+    uniform Point p = makeValue<uniform Point>();
+    print("make % %\n", p.x, p.y);
+    print("fill3 %\n", fill<3>());
+    print("fill2 %\n", fill<2>());
+    return 0;
+}
diff --git a/tests/lit-tests/designated-init-unsized-2d-c2cf13.ispc b/tests/lit-tests/designated-init-unsized-2d-c2cf13.ispc
