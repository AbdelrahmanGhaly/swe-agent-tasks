+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DINDEX_ON_SCALAR %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+
+// CHECK: Error:
+
+struct Point {
+    int32 x, y;
