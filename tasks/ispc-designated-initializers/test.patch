+#endif
+#ifdef INDEX_ON_SCALAR
+    uniform Point p = { .x[0] = 1 };
+#endif
+}
diff --git a/tests/lit-tests/designated-init-err-non-aggregate-c2cf13.ispc b/tests/lit-tests/designated-init-err-non-aggregate-c2cf13.ispc
