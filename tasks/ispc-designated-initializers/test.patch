+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DVALUE %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DVALUE_THEN_LANE %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DVALUE_THEN_INDEX %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DCONTINUED %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DELEMENT_THEN_LANE %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DSCALAR %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DGLOBAL_CONST %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
