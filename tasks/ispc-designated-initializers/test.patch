+// Array designator indices of boolean or floating-point type are errors, constant or not.
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DBOOL_LITERAL %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DBOOL_CONST %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DFLOAT_LITERAL %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DDOUBLE_CONST %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+// RUN: not %{ispc} --target=host --nowrap --nostdlib -DGLOBAL_FLOAT_CONST %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not="syntax error" --implicit-check-not="FATAL ERROR"
+
+// CHECK: Error:
+
+#ifdef GLOBAL_FLOAT_CONST
+static const uniform float ONE = 1.0f;
+uniform int32 g[2] = { [ONE] = 1 };
+#endif
+
+void f() {
+#ifdef BOOL_LITERAL
+    uniform int32 a[2] = { [true] = 1 };
+#endif
+#ifdef BOOL_CONST
+    const uniform bool flag = true;
+    uniform int32 b[2] = { [flag] = 1 };
+#endif
+#ifdef FLOAT_LITERAL
+    uniform int32 c[2] = { [1.0f] = 1 };
+#endif
+#ifdef DOUBLE_CONST
+    const uniform double half = 0.5d;
+    uniform int32 d[2] = { [half] = 1 };
+#endif
+}
