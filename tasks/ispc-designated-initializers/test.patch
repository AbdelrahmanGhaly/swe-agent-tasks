--- /dev/null
+++ b/tests/lit-tests/designated-init-override-warning-replaced-c2cf13.ispc
@@ -0,0 +1,65 @@
+// Items in a brace list that replaces an element only override each other, and parts of the replaced element no longer count as initialized.
+// RUN: %{ispc} --target=host --nowrap --nostdlib %s -o %t.o 2>&1 | FileCheck %s --implicit-check-not=Warning: --implicit-check-not=Error:
+
+struct P {
+    int32 x, y;
+};
+
+struct Q {
+    P p;
+    int32 d;
+};
+
+uniform Q g1 = {
+    .p.x = 1,
+    // CHECK: {{.*}}:[[@LINE+2]]:{{[0-9]+}}: Warning:
+    // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+    .p = { .y = 2, .y = 3 }
+};
+
+uniform Q g2 = {
+    .p.x = 1,
+    // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+    .p = { .y = 2 },
+    .p.x = 3
+};
+
+void f() {
+    uniform Q q1 = {
+        .p.x = 1,
+        // CHECK: {{.*}}:[[@LINE+2]]:{{[0-9]+}}: Warning:
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        .p = { .y = 2, .y = 3 }
+    };
+    uniform Q q2 = {
+        .p.x = 1,
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        .p = { .y = 2 },
+        .p.x = 3
+    };
+    uniform Q q3 = {
+        .p = { 1, 2 },
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        .p = { .y = 3 },
+        .p.x = 4
+    };
+    uniform int32 m1[2][2] = {
+        [1][0] = 1,
+        // CHECK: {{.*}}:[[@LINE+2]]:{{[0-9]+}}: Warning:
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        [1] = { [1] = 2, [1] = 3 }
+    };
+    uniform int32 m2[2][2] = {
+        [1][0] = 1,
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        [1] = { [1] = 2 },
+        [1][0] = 3
+    };
+    uniform Q *uniform n1 = uniform new uniform Q(
+        .p.x = 1,
+        // CHECK: {{.*}}:[[@LINE+2]]:{{[0-9]+}}: Warning:
+        // CHECK: {{.*}}:[[@LINE+1]]:{{[0-9]+}}: Warning:
+        .p = { .y = 2, .y = 3 }
+    );
+    delete n1;
+}
diff --git a/tests/lit-tests/designated-init-override-whole-c2cf13.ispc b/tests/lit-tests/designated-init-override-whole-c2cf13.ispc
new file mode 100644
index 0000000..1297011
--- /dev/null
+++ b/tests/lit-tests/designated-init-override-whole-c2cf13.ispc
@@ -0,0 +1,55 @@
+// A later brace list for an element replaces everything earlier items set inside it.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: q1 1 0 0
+// CHECK-NEXT: q2 0 9 0
+// CHECK-NEXT: q3 7 0 6
+// CHECK-NEXT: m 8 0 0 0
+// CHECK-NEXT: u 3 1.000000 3 7.000000 -2 4.250000 0.000000
+// CHECK-NEXT: s 4 0 0
+
+struct P {
+    int32 x, y;
+};
+
+struct Q {
+    P p;
+    int32 d;
+};
+
+struct In {
+    int32 a;
+    float b;
+};
+
+struct Out {
+    In inner[2];
+    double d;
+};
+
+noinline uniform int32 id(uniform int32 v) { return v; }
+
+noinline void staticCase() {
+    static uniform Q s = { .p.y = 3, .d = 0, .p = { 4 } };
+    print("s % % %\n", s.p.x, s.p.y, s.d);
+}
+
+extern "C" uniform int main() {
+    uniform Q q1 = { .p.y = 5, .p = { 1 } };
+    print("q1 % % %\n", q1.p.x, q1.p.y, q1.d);
+    uniform Q q2 = { .p = { 1, 2 }, .p = { .y = 9 } };
+    print("q2 % % %\n", q2.p.x, q2.p.y, q2.d);
+    uniform Q q3 = { .p.x = id(4), .p.y = id(5), .d = 6, .p = { id(7) } };
+    print("q3 % % %\n", q3.p.x, q3.p.y, q3.d);
+    uniform int32 m[2][2] = { [0][1] = 3, [0] = { 8 } };
+    print("m % % % %\n", m[0][0], m[0][1], m[1][0], m[1][1]);
+    uniform Out u[] = { [1].inner[0].b = 2.75, [0].d = 1, [1].inner[0] = { 3.9, 7 }, [2].inner[1].a = -2.5, 4.25 };
+    print("u % % % % % % %\n", sizeof(u) / sizeof(u[0]), u[0].d, u[1].inner[0].a, u[1].inner[0].b, u[2].inner[1].a,
+          u[2].inner[1].b, u[1].d);
+    staticCase();
+    return 0;
+}
diff --git a/tests/lit-tests/designated-init-reference-member-c2cf13.ispc b/tests/lit-tests/designated-init-reference-member-c2cf13.ispc
new file mode 100644
index 0000000..dad7093
--- /dev/null
+++ b/tests/lit-tests/designated-init-reference-member-c2cf13.ispc
@@ -0,0 +1,49 @@
+// Designated initializers for structs with reference members: an omitted reference is zero, as in positional lists.
+// RUN: %{ispc} --pic -O2 --target=host --nowrap %s -o %t.o
+// RUN: %{cc} %t.o -o %t.bin
+// RUN: %t.bin | FileCheck %s --match-full-lines
+
+// REQUIRES: !MACOS_HOST
+
+// CHECK: local 1 2
+// CHECK-NEXT: new 3
+// CHECK-NEXT: nested 4 5
+// CHECK-NEXT: global 6
+// CHECK-NEXT: static 7
+// CHECK-NEXT: bound 8 9
+
+struct S {
+    uint &ref;
+    int32 value;
+};
+
+struct Outer {
+    S s;
+    int32 z;
+};
+
+uniform S gs = { .value = 6 };
+
+noinline uniform int32 id(uniform int32 v) { return v; }
+
+noinline void bound(uniform uint32 &r) {
+    uniform S s = { .value = 9, .ref = r };
+    print("bound % %\n", s.ref, s.value);
+}
+
+extern "C" uniform int main() {
+    uniform S c = { .value = 1 };
+    uniform S d = { .value = id(2) };
+    print("local % %\n", c.value, d.value);
+    uniform S *uniform p = uniform new uniform S(.value = 3);
+    print("new %\n", p->value);
+    delete p;
+    uniform Outer o = { .s.value = id(4), .z = 5 };
+    print("nested % %\n", o.s.value, o.z);
+    print("global %\n", gs.value);
+    static uniform S st = { .value = 7 };
+    print("static %\n", st.value);
+    uniform uint32 x = 8;
+    bound(x);
+    return 0;
+}
diff --git a/tests/lit-tests/designated-init-soa-c2cf13.ispc b/tests/lit-tests/designated-init-soa-c2cf13.ispc
