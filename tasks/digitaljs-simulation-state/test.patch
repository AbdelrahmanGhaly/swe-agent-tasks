+        { from: { id: 'n', port: 'out' }, to: { id: 'o', port: 'in' } }
+    ]
+};
+
+function withChanges(data, change) {
+    const copy = clone(data);
+    change(copy);
+    return copy;
+}
+
+function renamed(data, from, to, celltype) {
+    return withChanges(data, copy => {
+        const circuit = celltype ? copy.subcircuits[celltype] : copy;
+        circuit.devices = Object.fromEntries(Object.entries(circuit.devices).map(([id, dev]) => [id == from ? to : id, dev]));
+        for (const conn of circuit.connectors)
+            for (const end of [conn.from, conn.to])
+                if (end.id == from) end.id = to;
+    });
+}
+
+let evaluations = 0;
+const countedCells = {};
+for (const kind of ['Not', 'And', 'Xor', 'Addition', 'Constant'])
+    countedCells['Counted' + kind] = class extends cells[kind] {
+        operation(...args) {
+            evaluations++;
+            return super.operation(...args);
+        }
+    };
+
+function counted(data) {
+    return withChanges(data, copy => {
+        for (const circuit of [copy].concat(Object.values(copy.subcircuits || {})))
+            for (const dev of Object.values(circuit.devices))
+                if (countedCells['Counted' + dev.type]) dev.type = 'Counted' + dev.type;
+    });
+}
+
+const reversedKeys = obj => Object.fromEntries(Object.entries(obj).reverse());
+
+function reordered(data) {
+    return withChanges(data, copy => {
+        for (const circuit of [copy].concat(Object.values(copy.subcircuits || {}))) {
+            circuit.devices = reversedKeys(circuit.devices);
+            circuit.connectors.reverse();
+        }
+        if (copy.subcircuits) copy.subcircuits = reversedKeys(copy.subcircuits);
+    });
+}
+
+function relabeled(data) {
+    return withChanges(data, copy => {
+        for (const circuit of [copy].concat(Object.values(copy.subcircuits || {})))
