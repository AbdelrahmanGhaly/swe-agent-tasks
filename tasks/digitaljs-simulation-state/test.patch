+
+async function savedCircuit(fixture, engine, observed = false) {
+    const circuit = build(fixture.data, engine);
+    if (observed) observeAll(circuit);
+    await run(circuit, fixture, 0, fixture.save);
+    const tick = circuit.tick;
+    const state = clone(await circuit.saveState());
+    return { circuit, state, tick };
+}
+
+describe.each(Object.keys(fixtures).filter(name => name != 'horner'))('%s', (name) => {
+    const fixture = fixtures[name];
+
+    describe.each(enginePairs)('saved with %s, loaded with %s', (_n1, _n2, saveEngine, loadEngine) => {
+        test('a fresh circuit continues exactly like the saved one', async () => {
+            const { circuit, state, tick } = await savedCircuit(fixture, saveEngine);
+            const expected = await run(circuit, fixture, fixture.save, fixture.save + fixture.more);
+            const target = build(fixture.data, loadEngine);
+            await target.loadState(state);
+            await target.synchronize();
+            expect(target.tick).toBe(tick);
+            expect(await run(target, fixture, fixture.save, fixture.save + fixture.more)).toEqual(expected);
+        });
+    });
+
+    describe.each(engines)('%s', (_n, engine) => {
+        test('loading into the saved circuit rewinds it', async () => {
+            const { circuit, state, tick } = await savedCircuit(fixture, engine);
+            const first = await run(circuit, fixture, fixture.save, fixture.save + fixture.more);
+            await circuit.loadState(state);
+            await circuit.synchronize();
+            expect(circuit.tick).toBe(tick);
+            expect(await run(circuit, fixture, fixture.save, fixture.save + fixture.more)).toEqual(first);
+        });
+
+        test('a circuit that has simulated something else takes over the saved simulation', async () => {
+            const { circuit, state, tick } = await savedCircuit(fixture, engine);
+            const expected = await run(circuit, fixture, fixture.save, fixture.save + fixture.more);
+            const target = build(fixture.data, engine);
+            await run(target, { script: fixture.other }, 0, fixture.save + 17);
+            await target.loadState(state);
+            await target.synchronize();
+            expect(target.tick).toBe(tick);
+            expect(await run(target, fixture, fixture.save, fixture.save + fixture.more)).toEqual(expected);
+        });
+
+        test('a circuit constructed with the state starts from it', async () => {
+            const { circuit, state, tick } = await savedCircuit(fixture, engine);
+            const expected = await run(circuit, fixture, fixture.save, fixture.save + fixture.more);
+            const target = build(fixture.data, engine, { state });
+            await target.synchronize();
+            expect(target.tick).toBe(tick);
+            expect(await run(target, fixture, fixture.save, fixture.save + fixture.more)).toEqual(expected);
