+    test('switches engines and carries on exactly where it was', async () => {
+        const fixture = fixtures.twins;
+        const circuit = build(fixture.data, engine, {}, Circuit);
+        const twin = build(fixture.data, engine);
+        const calls = [], twinCalls = [];
+        watch(circuit, fixture.watch, calls);
+        watch(twin, fixture.watch, twinCalls);
+        await run(circuit, fixture, 0, fixture.save);
+        await run(twin, fixture, 0, fixture.save);
+        const ticks = [];
+        circuit.on('postUpdateGates', (tick) => { ticks.push(tick); });
+        await circuit.switchEngine(engine == SynchEngine ? WorkerEngine : SynchEngine, engineOptions);
+        expect(circuit.tick).toBe(twin.tick);
+        expect(await run(circuit, fixture, fixture.save, fixture.save + fixture.more))
+            .toEqual(await run(twin, fixture, fixture.save, fixture.save + fixture.more));
+        await circuit.synchronize();
+        await twin.synchronize();
+        expect(calls).toEqual(twinCalls);
+        expect(ticks).toContain(fixture.save + fixture.more - 1);
+    });
+});
