+async function until(check, what, tries = 2000) {
+    for (let i = 0; i < tries && !check(); i++)
+        await new Promise(resolve => setTimeout(resolve, 10));
+    if (!check()) throw new Error('gave up after 20 s waiting for ' + what);
+}
