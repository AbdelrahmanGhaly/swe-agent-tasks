+function build(data, engine, extra = {}, Class = HeadlessCircuit) {
+    const circuit = new Class(clone(data), Object.assign({ engine, engineOptions }, extra));
+    live.push(circuit);
+    circuit.observeGraph();
+    return circuit;
+}
+
+function observeAll(circuit, where = []) {
+    if (where.length) circuit.observeGraph(where);
+    for (const label of Object.keys(circuit.getLabelIndex(where).subcircuits))
+        observeAll(circuit, where.concat([label]));
+}
+
+function outputs(circuit) {
+    return circuit.getOutputCells().map(cell => cell.id + '=' + cell.getOutput().toBin()).sort().join(' ');
+}
+
+function devicesAt(circuit, where = [], out = {}) {
+    const index = circuit.getLabelIndex(where);
+    for (const [label, cell] of Object.entries(index.devices)) {
+        const key = where.concat([label]).join(' / ');
+        out[key] = [cell.get('inputSignals'), cell.get('outputSignals')]
+            .map(sigs => Object.keys(sigs).sort().map(port => port + ':' + sigs[port].toBin()).join(','))
+            .join(' -> ');
+    }
+    for (const label of Object.keys(index.subcircuits))
+        devicesAt(circuit, where.concat([label]), out);
+    return out;
+}
+
+async function run(circuit, fixture, from, to, log = []) {
+    await circuit.synchronize();
+    for (let step = from; step < to; step++) {
+        for (const [at, id, bin] of fixture.script)
+            if (at == step) circuit.setInput(id, sig(bin));
+        await circuit.updateGates({ synchronous: true });
+        log.push(circuit.tick + ' ' + outputs(circuit));
+    }
+    return log;
+}
+
+function watch(circuit, targets, calls, options = {}) {
+    return targets.map(([label, where, port]) => {
+        const cell = circuit.findDeviceByLabel(label, where);
+        return circuit.monitor(cell, port, (tick, value) => {
+            calls.push([label, where.join('/'), port, tick, value.toBin()].join(' '));
+        }, options);
+    });
+}
