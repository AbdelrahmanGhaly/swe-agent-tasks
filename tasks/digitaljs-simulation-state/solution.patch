index 0000000..2ef025c
--- /dev/null
+++ b/src/engines/state.mjs
@@ -0,0 +1,94 @@
+"use strict";
+
+import { Vector3vl } from '3vl';
+
+export function signalsToJSON(sigs) {
+    const ret = {};
+    for (const [port, sig] of Object.entries(sigs))
+        ret[port] = sig.toBin();
+    return ret;
+}
+
+export function signalsFromJSON(data) {
+    const ret = {};
+    for (const [port, bin] of Object.entries(data))
+        ret[port] = Vector3vl.fromBin(bin, bin.length);
+    return ret;
+}
+
+function sameSignalShape(sigs, data) {
+    if (typeof data !== 'object' || data === null) return false;
+    const ports = Object.keys(sigs);
+    if (ports.length != Object.keys(data).length) return false;
+    return ports.every(port => typeof data[port] === 'string' && data[port].length == sigs[port].bits && /^[01x]*$/.test(data[port]));
+}
+
+export const jointGraphModel = {
+    gates: (graph) => graph.getElements(),
+    subgraph: (gate) => gate.get('type') == 'Subcircuit' ? gate.get('graph') : undefined
+};
+
+export function saveGraphState(graph, model, path = [], paths = new Map()) {
+    const devices = Object.create(null);
+    for (const gate of model.gates(graph)) {
+        const devpath = path.concat([gate.id]);
+        paths.set(gate, devpath);
+        const dev = {
+            type: gate.get('type'),
+            inputSignals: signalsToJSON(gate.get('inputSignals')),
+            outputSignals: signalsToJSON(gate.get('outputSignals'))
+        };
+        if (gate._saveState) dev.state = gate._saveState();
+        const subgraph = model.subgraph(gate);
+        if (subgraph) dev.devices = saveGraphState(subgraph, model, devpath, paths);
+        devices[gate.id] = dev;
+    }
+    return devices;
+}
+
+export function savePendingState(queue, paths) {
+    const pending = [];
+    for (const tick of Array.from(queue.keys()).sort((a, b) => a - b)) {
+        for (const [gate, sigs] of queue.get(tick)) {
+            if (!paths.has(gate)) continue;
+            pending.push({ tick, device: paths.get(gate), inputSignals: signalsToJSON(sigs) });
+        }
+    }
+    return pending;
+}
+
+function matchGraphState(graph, devices, model, path, entries, byPath) {
+    const gates = model.gates(graph);
+    if (typeof devices !== 'object' || devices === null || Object.keys(devices).length != gates.length)
+        throw new Error("Saved state does not match the circuit at [" + path.join(', ') + "]");
+    for (const gate of gates) {
+        const devpath = path.concat([gate.id]);
+        const dev = devices[gate.id];
+        if (!dev || dev.type != gate.get('type') ||
+            !sameSignalShape(gate.get('inputSignals'), dev.inputSignals) ||
+            !sameSignalShape(gate.get('outputSignals'), dev.outputSignals) ||
+            (gate._checkState && !gate._checkState(dev.state)))
+            throw new Error("Saved state does not match the circuit at [" + devpath.join(', ') + "]");
+        entries.push([gate, dev]);
+        byPath.set(JSON.stringify(devpath), gate);
+        const subgraph = model.subgraph(gate);
+        if (subgraph) matchGraphState(subgraph, dev.devices, model, devpath, entries, byPath);
+        else if (dev.devices !== undefined)
+            throw new Error("Saved state does not match the circuit at [" + devpath.join(', ') + "]");
+    }
+}
+
+export function prepareLoadState(graph, state, model) {
+    if (typeof state !== 'object' || state === null || !Number.isInteger(state.tick) || state.tick < 0 || !Array.isArray(state.pending))
+        throw new Error("Invalid saved state");
+    const entries = [];
+    const byPath = new Map();
+    matchGraphState(graph, state.devices, model, [], entries, byPath);
+    const pending = state.pending.map(({ tick, device, inputSignals }) => {
+        const gate = byPath.get(JSON.stringify(device));
+        if (!gate || !Number.isInteger(tick) || tick < state.tick || !sameSignalShape(gate.get('inputSignals'), inputSignals))
+            throw new Error("Invalid pending evaluation in saved state");
+        return { tick, gate, inputSignals: signalsFromJSON(inputSignals) };
+    });
+    return { entries, pending };
+}
