+use {
+  crate::{errors::UnsupportedConfigError, specifier::Specifier},
+  serde::Deserialize,
+  std::{cmp::Ordering, rc::Rc},
+  syncpack_specifier::workspace_specifier::WorkspaceSpecifier,
+};
+
+/// The raw `partitionBy` value as written in the rcfile: either the name of a
+/// built-in dimension or a list of semver ranges.
+#[derive(Clone, Debug, Deserialize)]
+#[serde(untagged)]
+pub enum RawPartitionBy {
+  Named(String),
+  Ranges(Vec<String>),
+}
+
+/// One range a version group divides its instances by, kept alongside the text
+/// the user wrote so it can be reported back to them.
+#[derive(Clone, Debug)]
+pub struct PartitionRange {
+  pub raw: String,
+  pub range: Rc<node_semver::Range>,
+}
+
+/// The dimension a version group divides its instances into before a preferred
+/// version is elected. Each partition elects its own version, so instances in
+/// different partitions are never compared to one another.
+#[derive(Clone, Debug)]
+pub enum PartitionBy {
+  Major,
+  Minor,
+  ReleaseChannel,
+  Ranges(Vec<PartitionRange>),
+}
+
+impl PartitionBy {
+  /// Reject anything which is not a supported dimension or a list of parseable
+  /// ranges, so a typo is reported instead of silently disabling partitioning.
+  pub fn from_config(raw: &RawPartitionBy) -> Result<Self, UnsupportedConfigError> {
+    match raw {
+      RawPartitionBy::Named(name) => match name.as_str() {
+        "major" => Ok(Self::Major),
+        "minor" => Ok(Self::Minor),
+        "releaseChannel" => Ok(Self::ReleaseChannel),
+        other => Err(UnsupportedConfigError::InvalidVersionGroupPartition(other.to_string())),
+      },
+      RawPartitionBy::Ranges(raws) => {
+        if raws.is_empty() {
+          return Err(UnsupportedConfigError::InvalidVersionGroupPartition("[]".to_string()));
+        }
+        raws
+          .iter()
+          .map(|raw| match Specifier::new_node_range(raw) {
+            Some(range) => Ok(PartitionRange { raw: raw.clone(), range }),
+            None => Err(UnsupportedConfigError::InvalidVersionGroupPartition(raw.clone())),
+          })
+          .collect::<Result<Vec<PartitionRange>, UnsupportedConfigError>>()
+          .map(Self::Ranges)
+      }
+    }
+  }
+
+  /// The partition a specifier belongs to, or `None` when it has no comparable
+  /// version to divide on. A dependency which is itself a package in this
+  /// monorepo is never divided, so its instances keep the local package as the
+  /// single version they are all measured against. `latest`, `*`, `workspace:*`, catalogs, tags, files,
+  /// links and urls all fall into that case, as do git urls without a semver
+  /// fragment and aliases wrapping any of them.
+  pub fn key_for(&self, specifier: &Specifier) -> Option<String> {
+    let version = comparable_version(specifier)?;
+    match self {
+      Self::Major => Some(version.major.to_string()),
+      Self::Minor => {
+        if is_major_only(specifier) {
+          None
+        } else {
+          Some(format!("{}.{}", version.major, version.minor))
+        }
+      }
+      Self::ReleaseChannel => Some(release_channel_of(&version)),
+      Self::Ranges(ranges) => ranges
+        .iter()
+        .find(|partition| version.satisfies(&partition.range))
+        .map(|partition| partition.raw.clone()),
+    }
+  }
+
+  /// Where a partition sits in the order the user configured. Ranges are tried
+  /// in the order they are written, so they are reported in that same order
+  /// rather than by how their text happens to sort. Every other dimension
+  /// derives its key from the version itself and has no configured order.
+  pub fn rank_of(&self, partition: &str) -> Option<usize> {
+    match self {
+      Self::Ranges(ranges) => ranges.iter().position(|candidate| candidate.raw == partition),
+      _ => None,
+    }
+  }
+}
+
+/// The version a specifier carries for the purpose of partitioning.
+fn comparable_version(specifier: &Specifier) -> Option<Rc<node_semver::Version>> {
+  if resolves_to_latest(specifier) || !specifier.has_comparable_version() {
+    return None;
+  }
+  specifier.get_node_version()
+}
+
+/// Whether a specifier resolves to a `latest` value at any depth. `latest` and
+/// `x` carry a huge synthetic version so that they sort above everything, which
+/// is a sorting device rather than a version anyone pinned, so they name no
+/// partition however they are wrapped.
+fn resolves_to_latest(specifier: &Specifier) -> bool {
+  match specifier {
+    Specifier::Latest(_) => true,
+    Specifier::Alias(alias) => resolves_to_latest(&alias.inner_specifier),
+    Specifier::WorkspaceProtocol(workspace) => match &workspace.inner_specifier {
+      WorkspaceSpecifier::Resolved(inner) => resolves_to_latest(inner),
+      WorkspaceSpecifier::RangeOnly(_) => false,
+    },
+    _ => false,
+  }
+}
+
+/// Whether a specifier names a major version and nothing more, such as "1" or
+/// "^1". Such a specifier belongs to no single minor partition. This asks the
+/// specifier what form it takes rather than looking at the completed version,
+/// because the padding used to complete a shorthand is a value an exact
+/// specifier is also allowed to pin.
+fn is_major_only(specifier: &Specifier) -> bool {
+  match specifier {
+    Specifier::Major(_) | Specifier::RangeMajor(_) => true,
+    Specifier::Alias(alias) => is_major_only(&alias.inner_specifier),
+    Specifier::WorkspaceProtocol(workspace) => match &workspace.inner_specifier {
+      WorkspaceSpecifier::Resolved(inner) => is_major_only(inner),
+      WorkspaceSpecifier::RangeOnly(_) => false,
+    },
+    Specifier::Git(git) => git.semver_number.as_ref().is_some_and(|number| !number.contains('.')),
+    _ => false,
+  }
+}
+
+/// The release channel of a version: `stable` when it has no prerelease, and
+/// otherwise the first prerelease identifier, so `1.2.3-alpha.1` and
+/// `2.0.0-alpha.4` share the `alpha` channel.
+fn release_channel_of(version: &node_semver::Version) -> String {
+  match version.pre_release.first() {
+    Some(identifier) => identifier.to_string(),
+    None => "stable".to_string(),
+  }
+}
+
+/// The key an instance is grouped under. Instances which cannot be partitioned
+/// stay together under the dependency's own name, so they keep being compared
+/// to each other exactly as they are when no partitioning is configured.
+pub fn partition_name(internal_name: &str, partition: Option<&str>) -> String {
+  match partition {
+    Some(key) => format!("{internal_name} {key}"),
+    None => internal_name.to_string(),
+  }
+}
+
+/// One run of a partition key: digits are compared as numbers so that `9`
+/// comes before `10`, everything else is compared as text.
+#[derive(Clone, Debug, Eq, Ord, PartialEq, PartialOrd)]
+enum Segment {
+  Number(u64),
+  Text(String),
+}
+
+/// A partition key in the order a person reads it. A configured rank wins when
+/// there is one, so range partitions keep the order they were written in.
+/// Otherwise keys are split into runs of digits and runs of everything else, so
+/// `5.9` precedes `5.10` where sorting the raw strings would not. Instances
+/// which could not be partitioned sort after every partition of the dependency.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct PartitionOrder {
+  is_unpartitioned: bool,
+  rank: Option<usize>,
+  segments: Vec<Segment>,
+}
+
+impl PartitionOrder {
+  pub fn new(partition: Option<&str>, rank: Option<usize>) -> Self {
+    let Some(key) = partition else {
+      return Self {
+        is_unpartitioned: true,
+        rank: None,
+        segments: vec![],
+      };
+    };
+    let mut segments = vec![];
+    let mut rest = key;
+    while !rest.is_empty() {
+      let is_digit = rest.starts_with(|c: char| c.is_ascii_digit());
+      let end = rest.find(|c: char| c.is_ascii_digit() != is_digit).unwrap_or(rest.len());
+      let (run, remainder) = rest.split_at(end);
+      segments.push(match run.parse::<u64>() {
+        Ok(number) if is_digit => Segment::Number(number),
+        _ => Segment::Text(run.to_string()),
+      });
+      rest = remainder;
+    }
+    Self {
+      is_unpartitioned: false,
+      rank,
+      segments,
+    }
+  }
+}
+
+impl Ord for PartitionOrder {
+  fn cmp(&self, other: &Self) -> Ordering {
+    self
+      .is_unpartitioned
+      .cmp(&other.is_unpartitioned)
+      .then_with(|| self.rank.cmp(&other.rank))
+      .then_with(|| self.segments.cmp(&other.segments))
+  }
+}
+
+impl PartialOrd for PartitionOrder {
+  fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+    Some(self.cmp(other))
+  }
+}
