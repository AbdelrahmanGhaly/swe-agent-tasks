+fn strip_ansi(raw: &str) -> String {
+  let mut plain = String::new();
+  let mut chars = raw.chars();
+  while let Some(character) = chars.next() {
+    if character == '\u{1b}' {
+      for escaped in chars.by_ref() {
+        if escaped.is_ascii_alphabetic() {
+          break;
+        }
+      }
+    } else {
+      plain.push(character);
+    }
+  }
+  plain
+}
