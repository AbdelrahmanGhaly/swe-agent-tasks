+++ b/tests/partitioned_election_49cccc_test.rs
@@ -0,0 +1,1375 @@
+use {
+  serde_json::Value,
+  std::{
+    path::{Path, PathBuf},
+    process::Command,
+  },
+};
+
+fn fixture_dir(name: &str) -> PathBuf {
+  PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("fixtures").join(name)
+}
+
+fn run_in(fixture: &str, args: &[&str]) -> (String, String, i32) {
+  let output = Command::new(env!("CARGO_BIN_EXE_syncpack"))
+    .args(args)
+    .current_dir(fixture_dir(fixture))
+    .output()
+    .expect("failed to run syncpack");
+  let stdout = String::from_utf8(output.stdout).unwrap();
+  let stderr = String::from_utf8(output.stderr).unwrap();
+  let code = output.status.code().unwrap_or(1);
+  (stdout, stderr, code)
+}
+
+fn rows_of(stdout: &str) -> Vec<Value> {
+  stdout
+    .lines()
+    .filter(|line| line.starts_with('{'))
+    .map(|line| serde_json::from_str::<Value>(line).unwrap_or_else(|_| panic!("invalid JSON line: {line}")))
+    .collect()
+}
+
+fn instances() -> Vec<Value> {
+  let (stdout, _, _) = run_in("partitioned-election", &["json"]);
+  rows_of(&stdout)
+}
+
+fn find(rows: &[Value], dependency: &str, package: &str) -> Value {
+  let needle = format!("/packages/{package}/package.json");
+  rows
+    .iter()
+    .find(|row| {
+      row["dependency"] == dependency
+        && row["package"]
+          .as_str()
+          .is_some_and(|path| path.replace('\\', "/").ends_with(&needle))
+    })
+    .unwrap_or_else(|| panic!("no instance of {dependency} in {package}"))
+    .clone()
+}
+
+fn actual_of(row: &Value) -> &str {
+  row["actual"]["raw"].as_str().unwrap_or_default()
+}
+
+fn expected_of(row: &Value) -> &str {
+  row["expected"]["raw"].as_str().unwrap_or_default()
+}
+
+fn status_of(row: &Value) -> &str {
+  row["statusCode"].as_str().unwrap_or_default()
+}
+
+fn partition_of(row: &Value) -> Option<&str> {
+  row["partition"].as_str()
+}
+
+#[test]
+fn partitioned_each_major_partition_elects_its_own_version() {
+  let rows = instances();
+  assert_eq!(expected_of(&find(&rows, "zod", "a")), "3.23.0");
+  assert_eq!(expected_of(&find(&rows, "zod", "c")), "4.1.0");
+}
+
+#[test]
+fn partitioned_the_highest_member_of_a_partition_is_valid() {
+  let rows = instances();
+  assert_eq!(status_of(&find(&rows, "zod", "b")), "IsHighestOrLowestSemver");
+  assert_eq!(status_of(&find(&rows, "zod", "d")), "IsHighestOrLowestSemver");
+}
+
+#[test]
+fn partitioned_a_lower_member_of_a_partition_is_a_fixable_mismatch() {
+  let rows = instances();
+  let lower = find(&rows, "zod", "a");
+  assert_eq!(actual_of(&lower), "3.22.0");
+  assert_eq!(status_of(&lower), "DiffersToHighestOrLowestSemver");
+}
+
+#[test]
+fn partitioned_no_instance_is_expected_to_match_another_partition() {
+  let rows = instances();
+  for package in ["a", "b"] {
+    let row = find(&rows, "zod", package);
+    assert!(
+      expected_of(&row).starts_with('3'),
+      "{package} was expected to use {} from another partition",
+      expected_of(&row)
+    );
+  }
+  for package in ["c", "d"] {
+    let row = find(&rows, "zod", package);
+    assert!(
+      expected_of(&row).starts_with('4'),
+      "{package} was expected to use {} from another partition",
+      expected_of(&row)
+    );
+  }
+}
+
+#[test]
+fn partitioned_release_channel_partitions_elect_within_their_channel() {
+  let rows = instances();
+  let beta = find(&rows, "chalk", "b");
+  assert_eq!(actual_of(&beta), "5.1.0-beta.1");
+  assert_eq!(expected_of(&beta), "5.2.0-beta.2");
+}
+
+#[test]
+fn partitioned_a_lone_member_of_a_release_channel_is_valid() {
+  let rows = instances();
+  let stable = find(&rows, "chalk", "a");
+  assert_eq!(actual_of(&stable), "5.0.0");
+  assert_eq!(status_of(&stable), "IsHighestOrLowestSemver");
+}
+
+#[test]
+fn partitioned_a_stable_version_is_never_expected_to_become_a_prerelease() {
+  let rows = instances();
+  let stable = find(&rows, "chalk", "a");
+  assert!(
+    !expected_of(&stable).contains("beta"),
+    "stable chalk was expected to become {}",
+    expected_of(&stable)
+  );
+}
+
+#[test]
+fn partitioned_a_specifier_with_no_comparable_version_is_not_partitioned() {
+  let rows = instances();
+  let row = find(&rows, "chalk", "d");
+  assert_eq!(actual_of(&row), "workspace:*");
+  assert_eq!(partition_of(&row), None);
+  assert!(!status_of(&row).is_empty(), "an unpartitionable specifier must still be reported");
+}
+
+#[test]
+fn partitioned_a_group_without_partitioning_is_unchanged() {
+  let rows = instances();
+  assert_eq!(expected_of(&find(&rows, "lodash", "a")), "4.17.21");
+  assert_eq!(status_of(&find(&rows, "lodash", "a")), "DiffersToHighestOrLowestSemver");
+  assert_eq!(status_of(&find(&rows, "lodash", "b")), "IsHighestOrLowestSemver");
+}
+
+#[test]
+fn partitioned_every_partitioned_instance_is_reported_exactly_once() {
+  let rows = instances();
+  for (dependency, package) in [("zod", "a"), ("zod", "b"), ("zod", "c"), ("zod", "d")] {
+    let needle = format!("/packages/{package}/package.json");
+    let count = rows
+      .iter()
+      .filter(|row| {
+        row["dependency"] == dependency
+          && row["package"]
+            .as_str()
+            .is_some_and(|path| path.replace('\\', "/").ends_with(&needle))
+      })
+      .count();
+    assert_eq!(count, 1, "{dependency} in {package} was reported {count} times");
+  }
+}
+
+#[test]
+fn partitioned_fix_targets_the_partition_version() {
+  let (stdout, _, _) = run_in("partitioned-election", &["fix", "--dry-run", "--reporter", "json"]);
+  let rows = rows_of(&stdout);
+  let fix = find(&rows, "zod", "a");
+  assert_eq!(expected_of(&fix), "3.23.0", "fix must not move a v3 dependency to v4");
+}
+
+#[test]
+fn partitioned_only_instances_behind_their_own_partition_are_fixable() {
+  let rows = instances();
+  let mut fixable: Vec<String> = rows
+    .iter()
+    .filter(|row| row["dependency"] == "zod" && row["statusType"] == "Fixable")
+    .filter_map(|row| row["package"].as_str())
+    .map(|path| {
+      let path = path.replace('\\', "/");
+      let (prefix, _) = path.rsplit_once("/package.json").unwrap();
+      prefix.rsplit_once('/').unwrap().1.to_string()
+    })
+    .collect();
+  fixable.sort();
+  assert_eq!(
+    fixable,
+    vec!["a".to_string(), "c".to_string()],
+    "only the lower member of each partition should be fixable"
+  );
+}
+
+#[test]
+fn partitioned_range_partitions_elect_within_their_range() {
+  let rows = instances();
+  let behind = find(&rows, "react", "a");
+  assert_eq!(actual_of(&behind), "17.0.1");
+  assert_eq!(expected_of(&behind), "17.0.2");
+  assert_eq!(status_of(&find(&rows, "react", "b")), "IsHighestOrLowestSemver");
+}
+
+#[test]
+fn partitioned_a_version_matching_several_ranges_joins_the_first() {
+  let rows = instances();
+  assert_eq!(partition_of(&find(&rows, "react", "a")), Some("<18"));
+  assert_eq!(partition_of(&find(&rows, "react", "b")), Some("<18"));
+  assert_eq!(partition_of(&find(&rows, "react", "c")), Some("<99"));
+}
+
+#[test]
+fn partitioned_a_version_matching_no_range_is_not_partitioned() {
+  let rows = instances();
+  let lower = find(&rows, "react", "d");
+  let higher = find(&rows, "react", "e");
+  assert_eq!(actual_of(&lower), "100.0.0");
+  assert_eq!(actual_of(&higher), "101.0.0");
+  assert_eq!(partition_of(&lower), None);
+  assert_eq!(partition_of(&higher), None);
+  assert_eq!(status_of(&higher), "IsHighestOrLowestSemver");
+  assert_eq!(expected_of(&lower), "101.0.0");
+}
+
+#[test]
+fn partitioned_minor_partitions_elect_within_their_minor() {
+  let rows = instances();
+  let behind = find(&rows, "vite", "a");
+  assert_eq!(partition_of(&behind), Some("5.1"));
+  assert_eq!(expected_of(&behind), "5.1.4");
+  assert_eq!(status_of(&find(&rows, "vite", "b")), "IsHighestOrLowestSemver");
+}
+
+#[test]
+fn partitioned_a_specifier_without_its_own_minor_is_not_partitioned() {
+  let rows = instances();
+  let major_only = find(&rows, "vite", "c");
+  assert_eq!(actual_of(&major_only), "^5");
+  assert_eq!(partition_of(&major_only), None);
+  assert_eq!(status_of(&major_only), "IsHighestOrLowestSemver");
+}
+
+#[test]
+fn partitioned_a_lone_minor_partition_is_valid() {
+  let rows = instances();
+  let lone = find(&rows, "vite", "d");
+  assert_eq!(partition_of(&lone), Some("5.2"));
+  assert_eq!(status_of(&lone), "IsHighestOrLowestSemver");
+}
+
+#[test]
+fn partitioned_the_partition_key_is_reported_for_each_instance() {
+  let rows = instances();
