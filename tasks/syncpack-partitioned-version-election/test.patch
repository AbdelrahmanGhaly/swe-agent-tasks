new file mode 100644
index 00000000..1504de2a
--- /dev/null
+++ b/fixtures/partitioned-types/accepts.ts
@@ -0,0 +1,34 @@
+import type { JsonOutput, RcFile, StatusCode } from '../../npm/syncpack.ts';
+
+type Group = NonNullable<RcFile['versionGroups']>[number];
+type OptionOf<T, K extends PropertyKey> = T extends unknown ? (K extends keyof T ? T[K] : never) : never;
+type SameMinorGroup = Extract<Group, { policy: 'sameMinor' }>;
+type GroupWithoutPolicy = Exclude<Group, { policy: string }>;
+
+const config: RcFile = {
+  versionGroups: [
+    { dependencies: ['zod'], preferVersion: 'highestSemver', partitionBy: 'major', maxPartitions: 2 },
+    { dependencies: ['ky'], preferVersion: 'lowestSemver', partitionBy: ['<2', '>=2'] },
+    { dependencies: ['ora'], policy: 'sameMinor', preferVersion: 'highestSemver', partitionBy: 'releaseChannel', maxPartitions: 2 },
+  ],
+};
+
+const standardPartitionBy: OptionOf<GroupWithoutPolicy, 'partitionBy'> = ['<2', '>=2'];
+const standardMaxPartitions: OptionOf<GroupWithoutPolicy, 'maxPartitions'> = 2;
+const sameMinorPartitionBy: OptionOf<SameMinorGroup, 'partitionBy'> = 'releaseChannel';
+const sameMinorMaxPartitions: OptionOf<SameMinorGroup, 'maxPartitions'> = 2;
+
+const named: JsonOutput['partition'] = '1';
+const absent: JsonOutput['partition'] = null;
+const status: StatusCode = 'PartitionLimitExceeded';
+
+export {
+  absent,
+  config,
+  named,
+  sameMinorMaxPartitions,
+  sameMinorPartitionBy,
+  standardMaxPartitions,
+  standardPartitionBy,
+  status,
+};
