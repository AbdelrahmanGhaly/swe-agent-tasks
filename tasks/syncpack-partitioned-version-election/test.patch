index 00000000..aaf86f76
--- /dev/null
+++ b/junit_from_libtest.py
@@ -0,0 +1,112 @@
+"""Convert libtest JSON events into JUnit XML.
+
+`cargo2junit` is not present in the base image and installing it needs network
+access at image-build time, so the reporter cannot be relied on at run time.
+This produces the same shape: one testcase per test, with the real panic block
+preserved inside the failure element rather than a placeholder message.
+"""
+
+import json
+import os
+import sys
+from xml.sax.saxutils import escape, quoteattr
+
+
+def main() -> int:
+    out_path = sys.argv[1]
+    default_classname = sys.argv[2] if len(sys.argv) > 2 else "cargo-test"
+    fixed_classname = len(sys.argv) > 3 and sys.argv[3] == "fixed"
+
+    suite_index = 0
+    cases = []
+    for line in sys.stdin:
+        line = line.strip()
+        if not line.startswith("{"):
+            continue
+        try:
+            event = json.loads(line)
+        except ValueError:
+            continue
+        kind = event.get("type")
+        if kind == "suite" and event.get("event") == "started":
+            suite_index += 1
+            continue
+        if kind != "test":
+            continue
+        outcome = event.get("event")
+        if outcome not in ("ok", "failed", "ignored"):
+            continue
+        name = event.get("name", "")
+        if fixed_classname:
+            # Running inside tests/main.rs reports "module::test"; the build-failure
+            # fallback can only know the bare name, so strip the prefix to keep the
+            # same names every time.
+            classname = default_classname
+            prefix = default_classname + "::"
+            if name.startswith(prefix):
+                name = name[len(prefix):]
+        elif "::" not in name:
+            classname = f"{default_classname}-{suite_index}"
+        else:
+            classname = name.rsplit("::", 1)[0]
+        detail = event.get("stdout") or event.get("message") or ""
+        cases.append((classname, name, outcome, event.get("exec_time") or 0, detail))
+
+    # A nonzero cargo status must be visible even when some tests already reported.
+    # Without this, a later target failing to build leaves a report of only passes.
+    # Only when something actually ran: with no events at all the caller writes a
+    # richer report naming every test the module declares, and emitting a lone
+    # synthetic case here would suppress it.
+    exit_code = os.environ.get("CARGO_EXIT", "0")
+    if cases and exit_code not in ("", "0") and not any(c[2] == "failed" for c in cases):
+        detail = ""
+        stderr_path = os.environ.get("CARGO_STDERR")
+        if stderr_path:
+            try:
+                with open(stderr_path, encoding="utf-8", errors="replace") as handle:
+                    detail = handle.read()[-4000:]
+            except OSError:
+                detail = ""
+        cases.append(
+            (
+                default_classname,
+                "cargo-exit",
+                "failed",
+                0,
+                detail or f"cargo exited with status {exit_code}",
+            )
+        )
+
+    failures = sum(1 for c in cases if c[2] == "failed")
+    skipped = sum(1 for c in cases if c[2] == "ignored")
+    lines = [
+        '<?xml version="1.0" encoding="UTF-8"?>',
+        f'<testsuites tests="{len(cases)}" failures="{failures}">',
+        f'  <testsuite name="cargo-test" tests="{len(cases)}" failures="{failures}" '
+        f'skipped="{skipped}" errors="0">',
+    ]
+    for classname, name, outcome, exec_time, detail in cases:
+        head = (
+            f"    <testcase name={quoteattr(name)} classname={quoteattr(classname)} "
+            f'time="{exec_time}"'
+        )
+        if outcome == "ok":
+            lines.append(head + " />")
+        elif outcome == "ignored":
+            lines.append(head + "><skipped /></testcase>")
+        else:
+            first = (detail.strip().splitlines() or ["test failed"])[0][:300]
+            body = escape(detail[-4000:]) if detail else "test failed"
+            lines.append(
+                head + f"><failure message={quoteattr(first)}>{body}</failure></testcase>"
+            )
+    lines.append("  </testsuite>")
+    lines.append("</testsuites>")
+
+    with open(out_path, "w", encoding="utf-8", newline="\n") as handle:
+        handle.write("\n".join(lines) + "\n")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
