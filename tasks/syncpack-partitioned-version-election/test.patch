index 00000000..b70ee5f3
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,196 @@
+#!/usr/bin/env bash
+set -uo pipefail
+CALLER_DIR="$PWD"
+cd "$(dirname "$0")" || exit 1
+export CARGO_INCREMENTAL=0
+export RUSTC_BOOTSTRAP=1
+export CARGO_NET_OFFLINE=true
+unset RUSTUP_TOOLCHAIN
+
+MODULE="partitioned_election_49cccc_test"
+TEST_FILE="tests/${MODULE}.rs"
+CONVERTER="$PWD/junit_from_libtest.py"
+PYBIN="$(command -v python3 || command -v python || true)"
+JSON_FLAGS="-Z unstable-options --format json --report-time"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+case "$OUTPUT_PATH" in
+  /* | "") ;;
+  *) OUTPUT_PATH="$CALLER_DIR/$OUTPUT_PATH" ;;
+esac
+
+# The suite has to run offline under any uid, whatever environment the caller
+# brings. The image vendored every crate and installed the pinned toolchain at
+# build time, so both are located on disk instead of being taken from inherited
+# variables, and the toolchain's own binaries are run directly so that rustup
+# never gets a chance to download anything. The shared target directory is only
+# used when this user owns all of it; otherwise a private one is used.
+can_write() {
+  [ -d "$1" ] && touch "$1/.write-probe" 2>/dev/null && rm -f "$1/.write-probe" 2>/dev/null
+}
+
+# A build script may reset the permissions or timestamps of files it wrote on an
+# earlier run, which needs ownership rather than write access, so a target
+# directory is only reused when this user owns everything in it.
+owns_throughout() {
+  can_write "$1" && [ -z "$(find "$1" ! -user "$(id -u)" -print -quit 2>/dev/null)" ]
+}
+
+has_registry() {
+  [ -d "$1/registry/cache" ] || [ -d "$1/registry/index" ]
+}
+
+# Every temporary file this script and the compiler create goes to a scratch
+# directory this user can write, so an unwritable /tmp cannot stop the suite.
+SCRATCH=""
+for candidate in "${TMPDIR:-}" /tmp /var/tmp "$PWD/target" "$PWD"; do
+  [ -n "$candidate" ] || continue
+  mkdir -p "$candidate" 2>/dev/null
+  if can_write "$candidate"; then
+    SCRATCH="$candidate/syncpack-harness-$(id -u)"
+    break
+  fi
+done
+mkdir -p "$SCRATCH" 2>/dev/null
+export TMPDIR="$SCRATCH"
+
+PINNED_TOOLCHAIN="$(sed -n 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' rust-toolchain.toml 2>/dev/null)"
+TOOLCHAIN_DIR=""
+for home in /opt/rustup "${RUSTUP_HOME:-}" "${HOME:-/nonexistent}/.rustup" /root/.rustup; do
+  [ -n "$home" ] && [ -d "$home/toolchains" ] || continue
+  for dir in "$home/toolchains/${PINNED_TOOLCHAIN}"*; do
+    if [ -x "$dir/bin/cargo" ] && [ -x "$dir/bin/rustc" ]; then
+      TOOLCHAIN_DIR="$dir"
+      export RUSTUP_HOME="$home"
+      break 2
+    fi
+  done
+done
+if [ -n "$TOOLCHAIN_DIR" ]; then
+  export PATH="$TOOLCHAIN_DIR/bin:$PATH"
+  export RUSTC="$TOOLCHAIN_DIR/bin/rustc" RUSTDOC="$TOOLCHAIN_DIR/bin/rustdoc"
+  CARGO="$TOOLCHAIN_DIR/bin/cargo"
+else
+  export PATH="/opt/cargo/bin:/root/.cargo/bin:$PATH"
+  CARGO="cargo"
+fi
+
+# The image vendors every crate at build time. A directory source is only ever
+# read, so pointing a private cargo home at it resolves every crate offline no
+# matter who owns the shared registry.
+VENDOR_CONFIG=/opt/syncpack-vendor.toml
+if [ -r "$VENDOR_CONFIG" ]; then
+  export CARGO_HOME="$SCRATCH/cargo-home"
+  mkdir -p "$CARGO_HOME"
+  cp "$VENDOR_CONFIG" "$CARGO_HOME/config.toml"
+else
+  CARGO_HOME_DIR=""
+  for home in /opt/cargo "${CARGO_HOME:-}" "${HOME:-/nonexistent}/.cargo" /root/.cargo; do
+    if [ -n "$home" ] && has_registry "$home"; then
+      CARGO_HOME_DIR="$home"
+      break
+    fi
+  done
+  export CARGO_HOME="${CARGO_HOME_DIR:-${CARGO_HOME:-/opt/cargo}}"
+fi
+
+if ! can_write "${HOME:-/nonexistent}"; then
+  export HOME="$SCRATCH/home"
+  mkdir -p "$HOME"
+fi
+
+CARGO_TARGET_DIR=""
+for candidate in "$PWD/target" "$SCRATCH/target"; do
+  mkdir -p "$candidate" 2>/dev/null
+  if owns_throughout "$candidate"; then
+    CARGO_TARGET_DIR="$candidate"
+    break
+  fi
+done
+[ -n "$CARGO_TARGET_DIR" ] || CARGO_TARGET_DIR="$SCRATCH/target"
+mkdir -p "$CARGO_TARGET_DIR" 2>/dev/null
+export CARGO_TARGET_DIR
+
+TEST_JSON="$(mktemp)"
+TEST_ERR="$(mktemp)"
+STATUS=0
+
+case "$MODE" in
+  base)
+    # Every pre-existing test. The new tests all share one name prefix, so a
+    # single run-time filter skips them without touching Cargo.toml or the
+    # build fingerprint, keeping one warm target directory for both modes.
+    "$CARGO" test --workspace -- $JSON_FLAGS --skip partitioned_ > "$TEST_JSON" 2> "$TEST_ERR"
+    STATUS=$?
+    ;;
+  new)
+    "$CARGO" test --test "$MODULE" -- $JSON_FLAGS > "$TEST_JSON" 2> "$TEST_ERR"
+    STATUS=$?
+    ;;
+esac
+
+cat "$TEST_ERR" >&2
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  CONV_ERR="$(mktemp)"
+  export CARGO_EXIT="$STATUS" CARGO_STDERR="$TEST_ERR"
+  if [ -z "$PYBIN" ]; then
+    echo "no python interpreter available to run $CONVERTER" > "$CONV_ERR"
+  elif [ "$MODE" = "new" ]; then
+    "$PYBIN" "$CONVERTER" "$OUTPUT_PATH" "$MODULE" fixed < "$TEST_JSON" 2> "$CONV_ERR"
+  else
+    "$PYBIN" "$CONVERTER" "$OUTPUT_PATH" "cargo-test" < "$TEST_JSON" 2> "$CONV_ERR"
+  fi
+  cat "$CONV_ERR" >&2
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    # Nothing ran, which is a failure however cargo exited.
+    [ "$STATUS" -ne 0 ] || STATUS=1
+    sanitized=$( { cat "$CONV_ERR"; tail -c 4000 "$TEST_ERR"; } \
+      | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
+    reason=$( { cat "$CONV_ERR"; grep -E '^(error|thread)' "$TEST_ERR"; } | grep -m1 . \
+      | cut -c1-300 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g')
+    [ -n "$reason" ] || reason="build produced no test events"
+    NAMES=""
+    if [ "$MODE" = "new" ] && [ -f "$TEST_FILE" ]; then
+      NAMES=$(grep -A1 '^#\[test\]' "$TEST_FILE" | sed -n 's/^fn \([a-z0-9_]*\)().*/\1/p')
+    fi
+    if [ -n "$NAMES" ]; then
+      COUNT=$(printf '%s\n' "$NAMES" | wc -l | tr -d ' ')
+      {
+        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
+        printf '<testsuites tests="%s" failures="%s">\n' "$COUNT" "$COUNT"
+        printf '  <testsuite name="%s" tests="%s" failures="%s" errors="0">\n' "$MODULE" "$COUNT" "$COUNT"
+        printf '%s\n' "$NAMES" | while IFS= read -r t; do
+          [ -n "$t" ] || continue
+          printf '    <testcase name="%s" classname="%s"><failure message="%s">%s</failure></testcase>\n' \
+            "$t" "$MODULE" "$reason" "$sanitized"
+        done
+        printf '%s\n' '  </testsuite>'
+        printf '%s\n' '</testsuites>'
+      } > "$OUTPUT_PATH"
+    else
+      {
+        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
+        printf '%s\n' '<testsuites tests="1" failures="1">'
+        printf '%s\n' '  <testsuite name="cargo-test" tests="1" failures="1" errors="0">'
+        printf '    <testcase name="compilation" classname="cargo-test"><failure message="%s">%s</failure></testcase>\n' \
+          "$reason" "$sanitized"
+        printf '%s\n' '  </testsuite>'
+        printf '%s\n' '</testsuites>'
+      } > "$OUTPUT_PATH"
+    fi
+  fi
+fi
+
+exit $STATUS
