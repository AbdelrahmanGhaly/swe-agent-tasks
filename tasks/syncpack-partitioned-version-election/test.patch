+fn tsc(case: &str) -> (bool, String) {
+  let output = Command::new("tsc")
+    .args(["--noEmit", "--strict", "--skipLibCheck", "--allowImportingTsExtensions", case])
+    .current_dir(fixture_dir("partitioned-types"))
+    .output()
+    .expect("tsc should be available to check the published declarations");
+  let diagnostics = format!(
+    "{}{}",
+    String::from_utf8_lossy(&output.stdout),
+    String::from_utf8_lossy(&output.stderr)
+  );
+  (output.status.success(), diagnostics)
+}
+
+fn assert_typechecks(case: &str, reason: &str) {
+  let (compiled, diagnostics) = tsc(case);
+  assert!(compiled, "{reason}: tsc rejected {case}\n{diagnostics}");
+}
+
+fn assert_type_error(case: &str, reason: &str) {
+  let (compiled, diagnostics) = tsc(case);
+  assert!(!compiled, "{reason}: tsc accepted {case}\n{diagnostics}");
+}
