+fn copy_dir(from: &Path, to: &Path) {
+  std::fs::create_dir_all(to).expect("the copy should be creatable");
+  for entry in std::fs::read_dir(from).expect("the fixture should be readable") {
+    let entry = entry.expect("each fixture entry should be readable");
+    let target = to.join(entry.file_name());
+    if entry.file_type().expect("each entry should have a type").is_dir() {
+      copy_dir(&entry.path(), &target);
+    } else {
+      std::fs::copy(entry.path(), &target).expect("each fixture file should be copyable");
+    }
+  }
+}
+
+fn fix_in_copy(fixture: &str) -> PathBuf {
+  let stamp = std::time::SystemTime::now()
+    .duration_since(std::time::UNIX_EPOCH)
+    .expect("the clock should be set")
+    .as_nanos();
+  let target = PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join(format!("syncpack-{fixture}-{stamp}"));
+  copy_dir(&fixture_dir(fixture), &target);
+  Command::new(env!("CARGO_BIN_EXE_syncpack"))
+    .arg("fix")
+    .current_dir(&target)
+    .output()
+    .expect("failed to run syncpack fix");
+  target
+}
+
+fn specifier_on_disk(root: &Path, package: &str, block: &str, dependency: &str) -> String {
+  let raw =
+    std::fs::read_to_string(root.join("packages").join(package).join("package.json")).expect("the fixed package file should be readable");
+  let parsed: Value = serde_json::from_str(&raw).expect("the fixed package file should be valid JSON");
+  parsed[block][dependency].as_str().unwrap_or_default().to_string()
+}
