+fn list_rows(output: &str) -> Vec<String> {
+  output
+    .lines()
+    .filter_map(|line| {
+      let (count, rest) = line.trim_start().split_once(' ')?;
+      let is_count = count.ends_with('x') && count[..count.len() - 1].chars().all(|c| c.is_ascii_digit());
+      is_count.then(|| rest.trim().to_string())
+    })
+    .collect()
+}
