+  let listed = list_rows(&strip_ansi(&format!("{stdout}{stderr}")));
+  let chalk: Vec<&String> = listed.iter().filter(|row| row.starts_with("chalk")).collect();
+  let heads_a_partition = |row: &str| keys.iter().any(|key| row.starts_with(&format!("chalk {key}")));
+  let last_partition = chalk
+    .iter()
+    .rposition(|row| heads_a_partition(row))
+    .expect("no chalk partition rows were listed");
+  let first_unpartitioned = chalk
+    .iter()
+    .position(|row| !heads_a_partition(row))
+    .expect("no unpartitioned chalk row was listed");
+  assert!(
+    last_partition < first_unpartitioned,
+    "the unpartitioned chalk row must be listed after every partition: {chalk:?}"
