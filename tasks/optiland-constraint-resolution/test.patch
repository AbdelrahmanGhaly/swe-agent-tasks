+
+    def test_solve_manager_applies_its_own_list_exactly_once(self, set_test_backend):
+        lens = doublet()
+        lens.solves.add("marginal_ray_height", 4, 1.0)
+        lens.solves.add("marginal_ray_height", 2, 3.0)
+        lens.updater.set_radius(37.0, 1)
+        tallies = counted(list(lens.solves.solves))
+        lens.solves.apply()
+        assert applications(tallies) == [1, 1]
+        assert marginal_height(lens, 2) == pytest.approx(3.0, abs=1e-9)
+        assert marginal_height(lens, 4) == pytest.approx(1.0, abs=1e-9)
