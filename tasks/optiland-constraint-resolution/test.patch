+"""Dependency-ordered resolution of pickups and solves."""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+import optiland.backend as be
+from optiland.multiconfig import MultiConfiguration
+from optiland.optic import Optic
+
+RADIUS_PATH = "surfaces.surfaces[i].geometry.radius"
+SHORT_RADIUS_PATH = "surfaces[i].geometry.radius"
+CONIC_PATH = "surfaces.surfaces[i].geometry.k"
+SHORT_CONIC_PATH = "surfaces[i].geometry.k"
+SHORT_MATERIAL_PATH = "surfaces[i].material_post"
+MATERIAL_PATH = "surfaces.surfaces[i].material_post"
+COMMENT_PATH = "surfaces.surfaces[i].comment"
+OFFSET_PATH = "surfaces.surfaces[i].geometry.cs.x"
+THICKNESS_PATH = "surfaces.surfaces[i].thickness"
+SHORT_THICKNESS_PATH = "surfaces[i].thickness"
+
+
+def scalar(value):
+    return float(be.to_numpy(value).reshape(-1)[0])
+
+
+def doublet():
+    lens = Optic()
+    lens.surfaces.add(index=0, radius=be.inf, thickness=be.inf)
+    lens.surfaces.add(
+        index=1, radius=50.0, thickness=6.0, material="N-BK7", is_stop=True
+    )
+    lens.surfaces.add(index=2, radius=-80.0, thickness=35.0)
+    lens.surfaces.add(index=3, radius=120.0, thickness=6.0, material="N-BK7")
+    lens.surfaces.add(index=4, radius=-140.0, thickness=45.0)
+    lens.surfaces.add(index=5)
+    lens.set_aperture(aperture_type="EPD", value=10.0)
+    lens.fields.set_type(field_type="angle")
+    lens.fields.add(y=0)
+    lens.wavelengths.add(value=0.5876, is_primary=True)
+    return lens
+
+
+def singlet():
+    lens = Optic()
+    lens.surfaces.add(index=0, radius=be.inf, thickness=be.inf)
+    lens.surfaces.add(
+        index=1, radius=60.0, thickness=8.0, material="N-BK7", is_stop=True
+    )
+    lens.surfaces.add(index=2, radius=-60.0, thickness=90.0)
+    lens.surfaces.add(index=3)
+    lens.set_aperture(aperture_type="EPD", value=12.0)
+    lens.fields.set_type(field_type="angle")
+    lens.fields.add(y=0)
+    lens.wavelengths.add(value=0.5876, is_primary=True)
+    return lens
+
+
+def two_glass_doublet():
+    lens = Optic()
+    lens.surfaces.add(index=0, radius=be.inf, thickness=be.inf)
+    lens.surfaces.add(
+        index=1, radius=50.0, thickness=6.0, material="N-BK7", is_stop=True
+    )
+    lens.surfaces.add(index=2, radius=-80.0, thickness=35.0)
+    lens.surfaces.add(index=3, radius=120.0, thickness=6.0, material="N-SF11")
+    lens.surfaces.add(index=4, radius=-140.0, thickness=45.0)
+    lens.surfaces.add(index=5)
+    lens.set_aperture(aperture_type="EPD", value=10.0)
+    lens.fields.set_type(field_type="angle")
+    lens.fields.add(y=0)
+    lens.wavelengths.add(value=0.5876, is_primary=True)
+    return lens
+
+
+def chief_height(lens, index):
+    y, _ = lens.paraxial.chief_ray()
+    return scalar(y[index])
+
+
+def finite_object_doublet():
+    lens = Optic()
+    lens.surfaces.add(index=0, radius=be.inf, thickness=200.0)
+    lens.surfaces.add(
+        index=1, radius=50.0, thickness=6.0, material="N-BK7", is_stop=True
+    )
+    lens.surfaces.add(index=2, radius=-80.0, thickness=35.0)
+    lens.surfaces.add(index=3, radius=120.0, thickness=6.0, material="N-BK7")
+    lens.surfaces.add(index=4, radius=-140.0, thickness=45.0)
+    lens.surfaces.add(index=5)
+    lens.set_aperture(aperture_type="EPD", value=10.0)
+    lens.fields.set_type(field_type="angle")
+    lens.fields.add(y=0)
+    lens.wavelengths.add(value=0.5876, is_primary=True)
+    return lens
+
+
+def stopped_doublet(stop_index):
+    lens = doublet()
+    lens.fields.add(y=4.0)
+    for index in range(1, 5):
+        lens.surfaces[index].is_stop = index == stop_index
+    return lens
+
+
+def glass(lens, index):
+    return lens.surfaces[index].material_post
+
+
+def glass_index(lens, index):
+    wavelength = lens.wavelengths.primary_wavelength.value
+    return scalar(glass(lens, index).n(wavelength))
+
+
+def conic_doublet():
+    lens = doublet()
+    for index in (1, 2, 3, 4):
+        lens.updater.set_conic(-0.5, index)
+    return lens
+
+
+def radius(lens, index):
+    return scalar(lens.surfaces.radii[index])
+
+
+def conic(lens, index):
+    return scalar(lens.surfaces.conic[index])
+
+
+def gap(lens, index):
+    return scalar(lens.surfaces.get_thickness(index))
+
+
+def recorded_gap(lens, index):
+    return scalar(lens.surfaces[index].thickness)
+
+
+def marginal_height(lens, index):
+    y, _ = lens.paraxial.marginal_ray()
+    return scalar(y[index])
+
+
+def marginal_slope(lens, index):
+    _, u = lens.paraxial.marginal_ray()
+    return scalar(u[index])
+
+
+def linked(lens, source, target, scale=1.0, offset=0.0, attr="radius"):
+    lens.pickups.add(source, attr, target, scale=scale, offset=offset)
+
+
+def counted(constraints):
+    tallies = []
+    for constraint in constraints:
+        tally = [0]
+
+        def wrapper(tally=tally, inner=constraint.apply):
+            tally[0] += 1
+            return inner()
+
+        constraint.apply = wrapper
+        tallies.append(tally)
+    return tallies
+
+
+def applications(tallies):
+    return [tally[0] for tally in tallies]
+
+
+class TestPickupChains:
+    def test_reverse_order_chain_resolves(self, set_test_backend):
+        lens = doublet()
+        linked(lens, 3, 4, scale=-1.0)
+        linked(lens, 1, 3, scale=2.0)
+        lens.updater.set_radius(37.0, 1)
+        lens.updater.update()
+        assert radius(lens, 3) == pytest.approx(74.0)
+        assert radius(lens, 4) == pytest.approx(-74.0)
+
+    def test_reverse_order_chain_with_offsets_composes(self, set_test_backend):
+        lens = doublet()
+        linked(lens, 3, 4, scale=-2.0, offset=5.0)
+        linked(lens, 1, 3, scale=3.0, offset=-4.0)
+        lens.updater.set_radius(20.0, 1)
+        lens.updater.update()
+        assert radius(lens, 3) == pytest.approx(56.0)
+        assert radius(lens, 4) == pytest.approx(-107.0)
+
+    def test_three_deep_chain_resolves_in_one_update(self, set_test_backend):
+        lens = doublet()
+        linked(lens, 3, 4, scale=1.0, offset=1.0)
+        linked(lens, 2, 3, scale=1.0, offset=1.0)
+        linked(lens, 1, 2, scale=1.0, offset=1.0)
+        lens.updater.set_radius(10.0, 1)
+        lens.updater.update()
+        assert radius(lens, 2) == pytest.approx(11.0)
+        assert radius(lens, 3) == pytest.approx(12.0)
+        assert radius(lens, 4) == pytest.approx(13.0)
+
+    def test_chain_is_stable_across_repeated_updates(self, set_test_backend):
+        lens = doublet()
+        linked(lens, 3, 4, scale=-1.0)
+        linked(lens, 1, 3, scale=2.0)
+        lens.updater.set_radius(31.0, 1)
+        lens.updater.update()
+        first = (radius(lens, 3), radius(lens, 4))
+        lens.updater.update()
+        assert (radius(lens, 3), radius(lens, 4)) == first
+
+    def test_conic_chain_resolves(self, set_test_backend):
+        lens = conic_doublet()
+        linked(lens, 3, 4, scale=-1.0, attr="conic")
+        linked(lens, 1, 3, scale=2.0, attr="conic")
+        lens.updater.set_conic(-0.25, 1)
+        lens.updater.update()
+        assert conic(lens, 3) == pytest.approx(-0.5)
+        assert conic(lens, 4) == pytest.approx(0.5)
+
+    def test_reader_runs_after_every_writer_of_its_source(self, set_test_backend):
+        lens = doublet()
+        linked(lens, 3, 4, scale=1.0)
+        linked(lens, 1, 2, scale=-1.0)
+        linked(lens, 2, 3, scale=-0.5)
+        lens.updater.set_radius(9.0, 1)
+        lens.updater.update()
+        assert radius(lens, 2) == pytest.approx(-9.0)
+        assert radius(lens, 3) == pytest.approx(4.5)
+        assert radius(lens, 4) == pytest.approx(4.5)
+
+    def test_last_added_writer_of_a_value_wins(self, set_test_backend):
+        lens = doublet()
+        linked(lens, 3, 4, scale=1.0)
+        linked(lens, 1, 3, scale=2.0)
+        linked(lens, 1, 3, scale=3.0)
+        lens.updater.set_radius(9.0, 1)
+        lens.updater.update()
+        assert radius(lens, 3) == pytest.approx(27.0)
+        assert radius(lens, 4) == pytest.approx(27.0)
+
+    def test_registration_order_decides_between_independent_pickups(
+        self, set_test_backend
+    ):
+        lens = doublet()
+        linked(lens, 1, 3, scale=0.0, offset=3.0)
+        linked(lens, 1, 4, scale=0.0, offset=4.0)
+        order = lens.updater.resolution_order()
+        assert [item.target_surface_idx for item in order] == [3, 4]
+
+
+class TestWriterPrecedence:
+    def test_three_writers_of_one_value_run_in_the_order_they_were_added(
+        self, set_test_backend
+    ):
+        lens = doublet()
+        lens.solves.add("marginal_ray_angle", 3, -0.05)
+        linked(lens, 1, 3, scale=0.5)
+        lens.solves.add("marginal_ray_angle", 3, -0.08)
+        order = lens.updater.resolution_order()
+        assert order == [
+            lens.solves.solves[0],
+            lens.pickups.pickups[0],
+            lens.solves.solves[1],
+        ]
+        lens.updater.update()
+        assert marginal_slope(lens, 3) == pytest.approx(-0.08, abs=1e-9)
+        assert lens.updater.driven_values()["radius[3]"] is lens.solves.solves[1]
+
+    def test_a_pickup_added_after_a_solve_wins_the_radius(self, set_test_backend):
+        lens = doublet()
+        lens.solves.add("marginal_ray_angle", 3, -0.05)
+        linked(lens, 1, 3, scale=0.5)
+        lens.updater.update()
+        assert radius(lens, 3) == pytest.approx(0.5 * radius(lens, 1))
+
+    def test_a_pickup_added_after_a_solve_is_credited_with_the_radius(
+        self, set_test_backend
+    ):
+        lens = doublet()
+        lens.solves.add("marginal_ray_angle", 3, -0.05)
+        linked(lens, 1, 3, scale=0.5)
+        driven = lens.updater.driven_values()
+        assert driven["radius[3]"] is lens.pickups.pickups[0]
+
+    def test_a_solve_added_after_a_pickup_wins_the_radius(self, set_test_backend):
+        lens = doublet()
+        linked(lens, 1, 3, scale=0.5)
+        lens.solves.add("marginal_ray_angle", 3, -0.05)
+        lens.updater.update()
+        assert marginal_slope(lens, 3) == pytest.approx(-0.05, abs=1e-9)
+        assert lens.updater.driven_values()["radius[3]"] is lens.solves.solves[0]
+
+    def test_a_later_solve_runs_after_the_pickup_it_overrides(self, set_test_backend):
+        lens = doublet()
+        linked(lens, 1, 3, scale=0.5)
+        lens.solves.add("marginal_ray_angle", 3, -0.05)
+        order = lens.updater.resolution_order()
+        assert order == [lens.pickups.pickups[0], lens.solves.solves[0]]
+
+    def test_an_earlier_solve_runs_before_the_pickup_that_overrides_it(
+        self, set_test_backend
+    ):
+        lens = doublet()
+        lens.solves.add("marginal_ray_angle", 3, -0.05)
+        linked(lens, 1, 3, scale=0.5)
+        order = lens.updater.resolution_order()
+        assert order == [lens.solves.solves[0], lens.pickups.pickups[0]]
+
+    def test_a_later_pickup_waits_only_on_the_solve_it_overrides(
+        self, set_test_backend
+    ):
+        lens = doublet()
+        lens.solves.add("marginal_ray_angle", 3, -0.05)
+        linked(lens, 1, 3, scale=0.5)
+        report = dict(
+            (id(item), waits) for item, waits in lens.updater.dependency_report()
+        )
+        pickup = lens.pickups.pickups[0]
+        assert report[id(pickup)] == [lens.solves.solves[0]]
+
+
+class TestRoundTrips:
+    def test_writer_precedence_survives_a_round_trip(self, set_test_backend):
+        lens = doublet()
+        lens.solves.add("marginal_ray_angle", 3, -0.05)
+        lens.pickups.add(1, "radius", 3, scale=2.0, offset=1.0)
+        lens.updater.update()
+        settled = radius(lens, 3)
+        back = Optic.from_dict(lens.to_dict())
+        back.updater.update()
+        assert radius(back, 3) == pytest.approx(settled, abs=1e-9)
+        assert radius(back, 3) == pytest.approx(2.0 * radius(back, 1) + 1.0, abs=1e-9)
+
+    def test_writer_precedence_survives_a_json_round_trip(self, set_test_backend):
+        lens = doublet()
+        lens.solves.add("marginal_ray_angle", 3, -0.05)
+        lens.pickups.add(1, "radius", 3, scale=2.0, offset=1.0)
+        lens.updater.update()
+        settled = radius(lens, 3)
+        back = Optic.from_dict(json.loads(json.dumps(lens.to_dict())))
+        back.updater.update()
+        assert radius(back, 3) == pytest.approx(settled, abs=1e-9)
+        assert radius(back, 3) == pytest.approx(2.0 * radius(back, 1) + 1.0, abs=1e-9)
+
+    def test_a_solve_driven_space_survives_a_round_trip(self, set_test_backend):
+        lens = doublet()
+        lens.solves.add("marginal_ray_height", 2, 3.0)
+        lens.pickups.add(2, "thickness", 1, scale=0.2)
+        lens.updater.update()
+        settled = gap(lens, 1)
+        back = Optic.from_dict(lens.to_dict())
+        back.updater.update()
+        assert gap(back, 1) == pytest.approx(settled, abs=1e-9)
+        assert gap(back, 1) == pytest.approx(0.2 * gap(back, 2), abs=1e-9)
+
+    def test_a_loaded_prescription_keeps_what_its_last_writer_settled(
+        self, set_test_backend
+    ):
+        lens = doublet()
+        lens.pickups.add(1, "radius", 3, scale=0.5)
+        lens.solves.add("marginal_ray_angle", 3, -0.05)
+        lens.updater.update()
+        settled = radius(lens, 3)
+        back = Optic.from_dict(lens.to_dict())
+        assert radius(back, 3) == pytest.approx(settled, abs=1e-9)
+
+    def test_the_earlier_writer_still_loses_after_a_round_trip(self, set_test_backend):
+        lens = doublet()
+        lens.pickups.add(1, "radius", 3, scale=2.0, offset=1.0)
+        lens.solves.add("marginal_ray_angle", 3, -0.05)
+        lens.updater.update()
+        back = Optic.from_dict(lens.to_dict())
+        back.updater.update()
+        assert marginal_slope(back, 3) == pytest.approx(-0.05, abs=1e-9)
+        assert back.updater.driven_values()["radius[3]"] is back.solves.solves[0]
+
