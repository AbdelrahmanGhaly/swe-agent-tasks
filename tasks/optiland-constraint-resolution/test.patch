+class TestExactlyOnce:
+    def test_update_applies_every_constraint_exactly_once(self, set_test_backend):
+        lens = doublet()
+        linked(lens, 3, 4, scale=-1.0)
+        linked(lens, 1, 3, scale=2.0)
+        lens.solves.add("marginal_ray_height", 2, 3.0)
+        lens.solves.add("quick_focus")
+        tallies = counted(lens.updater.resolution_order())
+        lens.updater.update()
+        assert applications(tallies) == [1, 1, 1, 1]
+
+    def test_a_source_read_by_two_pickups_is_applied_once(self, set_test_backend):
+        lens = doublet()
+        linked(lens, 1, 2, scale=0.5)
+        linked(lens, 2, 3, scale=2.0)
+        linked(lens, 2, 4, scale=-1.0)
+        tallies = counted(lens.updater.resolution_order())
+        lens.updater.update()
+        assert applications(tallies) == [1, 1, 1]
+
+    def test_a_solve_feeding_two_readers_is_applied_once(self, set_test_backend):
+        lens = doublet()
+        lens.solves.add("marginal_ray_height", 2, 3.0)
+        linked(lens, 1, 3, attr="thickness", scale=2.0)
+        linked(lens, 1, 4, attr="thickness", scale=3.0)
+        tallies = counted(lens.updater.resolution_order())
+        lens.updater.update()
+        assert applications(tallies) == [1, 1, 1]
+
+    def test_managers_apply_their_own_list_exactly_once(self, set_test_backend):
+        lens = doublet()
+        linked(lens, 3, 4, scale=-1.0)
+        linked(lens, 1, 3, scale=2.0)
+        tallies = counted(lens.updater.resolution_order())
