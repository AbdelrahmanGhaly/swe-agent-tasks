+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/results.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd /app
+
+export HOME="${HOME:-/tmp}"
+export MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp/matplotlib}"
+export MPLBACKEND=Agg
+export QT_QPA_PLATFORM=offscreen
+mkdir -p "$MPLCONFIGDIR"
+
+NEW_TESTS="tests/test_constraint_resolution_93d6d4.py"
+PYTEST_LOG="$(mktemp)"
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_TESTS" \
+    -p no:randomly -p no:cacheprovider --junitxml="$OUTPUT_PATH" -q 2>&1 | tee "$PYTEST_LOG"
+  EXIT_CODE=${PIPESTATUS[0]}
+else
+  # Base mode covers the modules this change touches and the callers that
+  # depend on them: pickups, solves, the optic updater, multi-configuration,
+  # paraxial rays, materials, coordinate systems, position reconstruction
+  # after a thickness write, serialization round trips and prescription
+  # output. That is 2371 of the repository's tests.
+  #
+  # tests/gui is left out: it drives PySide6 through worker processes, and its
+  # assertions about which event-loop turn a job lands on depend on how busy
+  # the machine is, so it is not a deterministic baseline.
+  BASE_TESTS="tests/test_pickup.py
+              tests/test_solves.py
+              tests/test_optic.py
+              tests/test_optic_deprecated.py
+              tests/test_multiconfig.py
+              tests/test_paraxial.py
+              tests/test_materials.py
+              tests/test_coordinate_system.py
+              tests/test_folded_paraxial.py
+              tests/test_folded_paraxial_finalization.py
+              tests/test_folded_paraxial_hardening.py
+              tests/test_optimization_recovery.py
+              tests/test_fileio
+              tests/prescription"
+
+  # Pre-existing failure on the base commit, unrelated to this change: a
+  # wall-clock performance ratio assertion (limit 40) that this container
+  # cannot satisfy, measuring 82-110 over five runs of an unpatched checkout.
+  PERF_RATIO_TEST="tests/test_materials.py::TestBaseMaterial::test_large_array_cache_key_avoids_python_scalar_overhead"
+
+  python -m pytest $BASE_TESTS \
+    --ignore="$NEW_TESTS" \
+    --deselect "$PERF_RATIO_TEST" \
+    -p no:randomly -p no:cacheprovider --junitxml="$OUTPUT_PATH" -q 2>&1 | tee "$PYTEST_LOG"
+  EXIT_CODE=${PIPESTATUS[0]}
+fi
+
+if [ ! -f "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  DETAIL="$(tail -n 80 "$PYTEST_LOG" 2>/dev/null \
+    | tr -d '\000-\010\013\014\016-\037' \
+    | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+  if [ -z "$DETAIL" ]; then
+    DETAIL="pytest produced no test cases and no output."
+  fi
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo '<testsuites>'
+    echo '  <testsuite name="pytest" tests="1" failures="1" errors="0" time="0">'
+    echo '    <testcase name="collection" classname="pytest">'
+    echo "      <failure message=\"pytest produced no test cases (exit $EXIT_CODE)\">"
+    echo "$DETAIL"
+    echo '      </failure>'
+    echo '    </testcase>'
+    echo '  </testsuite>'
+    echo '</testsuites>'
+  } > "$OUTPUT_PATH"
+fi
+
+rm -f "$PYTEST_LOG"
+exit $EXIT_CODE
