+    @classmethod
+    def from_greyordinate_labels(cls, brain_model, labels, label_table):
+        """
+        Creates a Parcel axis by grouping the greyordinates of a brain model by label
+
+        Parameters
+        ----------
+        brain_model : BrainModelAxis
+            axis describing the greyordinate carrying each label
+        labels : array_like
+            (N, ) array with one label key per greyordinate of `brain_model`
+        label_table : dict
+            maps label keys to (name, rgba) pairs, the way a :class:`LabelAxis` stores them
+
+        Returns
+        -------
+        ParcelsAxis
+            one parcel for every label key that names a region and covers at least one
+            greyordinate, in ascending order of the key
+        """
+        labels = np.asanyarray(labels)
+        if labels.shape != (len(brain_model),):
+            raise ValueError(
+                f'Got labels of shape {labels.shape} for a brain model '
+                f'of {len(brain_model)} greyordinates'
+            )
+        if np.issubdtype(labels.dtype, np.integer):
+            exact = labels.ravel().tolist()
+        else:
+            values = labels.astype('f8')
+            if not np.isfinite(values).all() or not np.array_equal(values, np.rint(values)):
+                raise ValueError('Label values should be whole numbers')
+            exact = np.rint(values).ravel().tolist()
+        keys = np.asarray([int(value) for value in exact], dtype=object)
+        table = {int(key): value for key, value in label_table.items()}
+        missing = sorted(set(keys.tolist()) - set(table))
+        if missing:
+            raise ValueError(f'Label keys {missing} are missing from the label table')
+        surface_mask = brain_model.surface_mask
+        all_names = []
+        all_voxels = []
+        all_vertices = []
+        nvertices = {}
+        affine = None
+        volume_shape = None
+        for key in sorted(table):
+            name = table[key][0]
+            if name == UNLABELED_PARCEL_NAME:
+                continue
+            selected = keys == key
+            if not selected.any():
+                continue
+            voxels = brain_model.voxel[selected & ~surface_mask]
+            vertices = {}
+            for structure in brain_model.name[selected & surface_mask]:
+                structure = str(structure)
+                if structure in vertices:
+                    continue
+                in_structure = selected & surface_mask & (brain_model.name == structure)
+                vertices[structure] = brain_model.vertex[in_structure]
+                nvertices[structure] = brain_model.nvertices[structure]
+            if len(voxels) > 0:
+                affine = brain_model.affine
+                volume_shape = brain_model.volume_shape
+            all_names.append(name)
+            all_voxels.append(voxels)
+            all_vertices.append(vertices)
+        return cls(all_names, all_voxels, all_vertices, affine, volume_shape, nvertices)
