+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/results.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd /app
+
+NEW_TESTS="nibabel/cifti2/tests/test_operations_ac8f96.py"
+PYTEST_LOG="$(mktemp)"
+BASETEMP="$(mktemp -d)"
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_TESTS" \
+    -p no:cacheprovider --basetemp="$BASETEMP" --junitxml="$OUTPUT_PATH" -q 2>&1 | tee "$PYTEST_LOG"
+  EXIT_CODE=${PIPESTATUS[0]}
+else
+  python -m pytest nibabel --ignore="$NEW_TESTS" \
+    -p no:cacheprovider --basetemp="$BASETEMP" --junitxml="$OUTPUT_PATH" -q 2>&1 | tee "$PYTEST_LOG"
+  EXIT_CODE=${PIPESTATUS[0]}
+fi
+
+if [ ! -f "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  DETAIL="$(tail -n 80 "$PYTEST_LOG" 2>/dev/null \
+    | tr -d '\000-\010\013\014\016-\037' \
+    | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+  if [ -z "$DETAIL" ]; then
+    DETAIL="pytest produced no test cases and no output."
+  fi
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo '<testsuites>'
+    echo '  <testsuite name="pytest" tests="1" failures="1" errors="0" time="0">'
+    echo '    <testcase name="collection" classname="pytest">'
+    echo "      <failure message=\"pytest produced no test cases (exit $EXIT_CODE)\">"
+    echo "$DETAIL"
+    echo '      </failure>'
+    echo '    </testcase>'
+    echo '  </testsuite>'
+    echo '</testsuites>'
+  } > "$OUTPUT_PATH"
+  if [ "$EXIT_CODE" -eq 0 ]; then
+    EXIT_CODE=1
+  fi
+fi
+
+rm -rf "$PYTEST_LOG" "$BASETEMP"
+exit $EXIT_CODE
