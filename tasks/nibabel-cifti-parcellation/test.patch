+import numpy as np
+import pytest
+
+import nibabel.cifti2.cifti2_axes as axes
+from nibabel import cifti2
+
+VOL_SHAPE = (2, 3, 2)
+VOL_AFFINE = np.array(
+    [[2.0, 0.0, 0.0, -10.0], [0.0, 2.0, 0.0, -12.0], [0.0, 0.0, 2.0, -8.0], [0.0, 0.0, 0.0, 1.0]]
+)
+OTHER_AFFINE = np.array(
+    [[3.0, 0.0, 0.0, -10.0], [0.0, 2.0, 0.0, -12.0], [0.0, 0.0, 2.0, -8.0], [0.0, 0.0, 0.0, 1.0]]
+)
+LEFT = 'CIFTI_STRUCTURE_CORTEX_LEFT'
+RIGHT = 'CIFTI_STRUCTURE_CORTEX_RIGHT'
+THALAMUS = 'CIFTI_STRUCTURE_THALAMUS_LEFT'
+RED = (1.0, 0.0, 0.0, 1.0)
+
+
+def parcellate(img, parcels, axis=None, method='mean'):
+    from nibabel.cifti2 import parcellate as operation
+
+    return operation(img, parcels, axis=axis, method=method)
+
+
+def merge_parcels(img, groups, axis=None, method='mean'):
+    from nibabel.cifti2 import merge_parcels as operation
+
+    return operation(img, groups, axis=axis, method=method)
+
+
+def concat(images, axis=0):
+    from nibabel.cifti2 import concat as operation
+
+    return operation(images, axis=axis)
+
+
+def split(img, axis=0, sizes=None):
+    from nibabel.cifti2 import split as operation
+
+    return operation(img, axis=axis, sizes=sizes)
+
+
+def cortex_left():
+    """Surface brain model over four of six left cortical vertices"""
+    return axes.BrainModelAxis.from_surface([0, 2, 3, 5], 6, 'cortex_left')
+
+
+def cortex_right():
+    """Surface brain model over two of five right cortical vertices"""
+    return axes.BrainModelAxis.from_surface([1, 4], 5, 'cortex_right')
+
+
+def thalamus():
+    """Volumetric brain model with three voxels"""
+    mask = np.zeros(VOL_SHAPE, dtype=bool)
+    mask[0, 0, 0] = True
+    mask[0, 1, 1] = True
+    mask[1, 2, 0] = True
+    return axes.BrainModelAxis.from_mask(mask, 'thalamus_left', VOL_AFFINE)
+
+
+def mixed():
+    """Nine greyordinates: four left, two right, three thalamic"""
+    return cortex_left() + cortex_right() + thalamus()
+
+
+def scalar(names=('one', 'two')):
+    return axes.ScalarAxis(list(names))
+
+
+def series(start=0.0, step=2.0, size=2, unit='SECOND'):
+    return axes.SeriesAxis(start, step, size, unit)
+
+
+def ramp(*shape):
+    return np.arange(int(np.prod(shape)), dtype=float).reshape(shape)
+
+
+def image(row_axis, column_axis, data=None):
+    if data is None:
+        data = ramp(len(row_axis), len(column_axis))
+    return cifti2.Cifti2Image(data, cifti2.Cifti2Header.from_axes((row_axis, column_axis)))
+
+
+def raw_name_parcels():
+    """Parcels written with everyday structure names instead of CIFTI-2 names"""
+    return axes.ParcelsAxis(
+        ['front', 'deep'],
+        [np.zeros((0, 3), dtype=int), thalamus().voxel],
+        [{'cortex_left': np.array([0, 3])}, {}],
+        affine=VOL_AFFINE,
+        volume_shape=VOL_SHAPE,
+        nvertices={'cortex_left': 6},
+    )
+
+
+def surface_parcels():
+    return axes.ParcelsAxis.from_brain_models([('left', cortex_left()), ('right', cortex_right())])
+
+
+def single_parcel(name, vertices):
+    return axes.ParcelsAxis(
+        [name],
+        [np.zeros((0, 3), dtype=int)],
+        [{'cortex_left': np.array(vertices)}],
+        nvertices={'cortex_left': 6},
+    )
+
+
+def shared_index_model():
+    """Right then left surface, both carrying vertex 2, so the index alone is ambiguous"""
+    right = axes.BrainModelAxis.from_surface([2, 4], 5, 'cortex_right')
+    left = axes.BrainModelAxis.from_surface([0, 2], 6, 'cortex_left')
+    return right + left
+
+
+def single_named_parcel(structure, nvertex, vertices):
+    return axes.ParcelsAxis(
+        ['p'],
+        [np.zeros((0, 3), dtype=int)],
+        [{structure: np.array(vertices)}],
+        nvertices={structure: nvertex},
+    )
+
+
+def left_parcels():
+    return axes.ParcelsAxis.from_brain_models([('left', cortex_left())])
+
+
+def label_table():
+    return {
+        3: ('second', RED),
+        7: ('unused', RED),
+        0: ('zero', RED),
+        2: ('???', RED),
+        1: ('first', RED),
+    }
+
+
+def label_image(brain_model, keys, table=None):
+    table = label_table() if table is None else table
+    label_axis = axes.LabelAxis(['maps'], [table])
+    data = np.asarray(keys, dtype=float)[None, :]
+    return cifti2.Cifti2Image(data, cifti2.Cifti2Header.from_axes((label_axis, brain_model)))
+
+
+def written_and_read(img):
+    """The image after a round trip through the CIFTI-2 serialisation"""
+    return cifti2.Cifti2Image.from_bytes(img.to_bytes())
+
+
+def assert_round_trips(img):
+    copy = written_and_read(img)
+    assert len(copy.shape) == len(img.shape)
+    for index in range(len(img.shape)):
+        assert copy.header.get_axis(index) == img.header.get_axis(index)
+    assert np.array_equal(copy.get_fdata(), img.get_fdata())
+
+
+def test_parcellate_surface_mean_values():
+    brain_model = cortex_left()
+    img = image(scalar(), brain_model)
+    data = img.get_fdata()
+    result = parcellate(img, left_parcels(), axis=1)
+    assert np.allclose(result.get_fdata()[:, 0], data.mean(axis=1))
+
+
+def test_parcellate_reduces_axis_length_to_parcel_count():
+    img = image(scalar(), mixed())
+    result = parcellate(img, raw_name_parcels(), axis=1)
+    assert result.shape == (2, 2)
+
+
+def test_parcellate_replaces_axis_with_parcels():
+    img = image(scalar(), mixed())
+    result = parcellate(img, raw_name_parcels(), axis=1)
