+    data = img.get_fdata()
+    result = parcellate(img, raw_name_parcels(), axis=1)
+    assert np.allclose(result.get_fdata()[:, 1], data[:, [6, 7, 8]].mean(axis=1))
+
+
+def test_parcellate_stores_canonical_structure_names():
+    img = image(scalar(), mixed())
+    result = parcellate(img, raw_name_parcels(), axis=1)
+    assert list(result.header.get_axis(1).vertices[0]) == [LEFT]
+
+
+def test_parcellate_takes_vertex_counts_from_the_image():
+    img = image(scalar(), cortex_left())
+    parcels = axes.ParcelsAxis(
+        ['front'],
+        [np.zeros((0, 3), dtype=int)],
+        [{'cortex_left': np.array([0, 2])}],
+    )
+    result = parcellate(img, parcels, axis=1)
+    assert result.header.get_axis(1).nvertices == {LEFT: 6}
+    assert_round_trips(result)
+
+
+def test_parcellate_takes_the_volume_from_the_image():
+    img = image(scalar(), thalamus())
+    parcels = axes.ParcelsAxis(['deep'], [thalamus().voxel], [{}])
+    result = parcellate(img, parcels, axis=1)
+    assert tuple(result.header.get_axis(1).volume_shape) == VOL_SHAPE
+    assert np.allclose(result.header.get_axis(1).affine, VOL_AFFINE)
+    assert_round_trips(result)
+
+
+def test_parcellate_result_round_trips():
+    img = image(scalar(), mixed())
+    assert_round_trips(parcellate(img, raw_name_parcels(), axis=1))
+
+
+def test_parcellate_surface_only_result_round_trips():
