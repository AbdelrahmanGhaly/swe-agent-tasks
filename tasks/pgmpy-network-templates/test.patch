+import itertools
+
+import numpy as np
+import pytest
+
+from pgmpy import models
+from pgmpy.factors.discrete import TabularCPD
+from pgmpy.inference import VariableElimination
+from pgmpy.models import DiscreteBayesianNetwork
+
+BINARY = ["no", "yes"]
+
+
+def _cpd(variable, values, evidence=None, evidence_card=None, states=None):
+    names = {variable: BINARY}
+    names.update({name: BINARY for name in (evidence or [])})
+    if states:
+        names.update(states)
+    return TabularCPD(variable, len(values), values, evidence=evidence, evidence_card=evidence_card, state_names=names)
+
+
+def _template(edges, boundary):
+    return models.NetworkTemplate(edges, boundary=boundary)
+
+
+def forked():
+    template = _template([("b", "hidden"), ("hidden", "c1"), ("hidden", "c2"), ("b", "c2")], ["b"])
+    template.add_cpds(
+        _cpd("hidden", [[0.7, 0.1], [0.3, 0.9]], ["b"], [2]),
+        _cpd("c1", [[0.8, 0.25], [0.2, 0.75]], ["hidden"], [2]),
+        _cpd("c2", [[0.9, 0.4, 0.35, 0.05], [0.1, 0.6, 0.65, 0.95]], ["hidden", "b"], [2, 2]),
+    )
+    return template
+
+
+def unit():
+    template = _template([("src", "out")], ["src"])
+    template.add_cpds(_cpd("out", [[0.55, 0.15], [0.45, 0.85]], ["src"], [2]))
+    return template
+
+
+def deterministic():
+    template = _template([("b", "hidden"), ("hidden", "c1"), ("hidden", "c2")], ["b"])
+    template.add_cpds(
+        _cpd("hidden", [[1.0, 0.0], [0.0, 1.0]], ["b"], [2]),
+        _cpd("c1", [[1.0, 0.0], [0.0, 1.0]], ["hidden"], [2]),
+        _cpd("c2", [[0.3, 0.8], [0.7, 0.2]], ["hidden"], [2]),
+    )
+    return template
+
+
+def dangling():
+    template = _template([("b", "only")], ["b"])
+    template.add_nodes_from(["extra"])
+    template.add_cpds(
+        _cpd("only", [[0.7, 0.2], [0.3, 0.8]], ["b"], [2]),
+        _cpd("extra", [[0.45], [0.55]]),
+    )
+    return template
+
+
+def two_sided():
+    template = _template([("b", "out"), ("scale", "out")], ["b", "scale"])
+    template.add_cpds(
+        _cpd(
+            "out",
+            [[0.9, 0.6, 0.3, 0.7, 0.4, 0.1], [0.1, 0.4, 0.7, 0.3, 0.6, 0.9]],
+            ["b", "scale"],
+            [2, 3],
+            states={"scale": TRIPLE},
+        )
+    )
+    return template
+
+
+def relay():
+    template = _template([("h", "q"), ("q", "x"), ("x", "z"), ("h", "z")], [])
+    template.add_cpds(
+        _cpd("h", [[0.65], [0.35]]),
+        _cpd("q", [[0.6, 0.15], [0.4, 0.85]], ["h"], [2]),
+        _cpd("x", [[0.55, 0.25], [0.45, 0.75]], ["q"], [2]),
+        _cpd("z", [[0.9, 0.3, 0.7, 0.1], [0.1, 0.7, 0.3, 0.9]], ["h", "x"], [2, 2]),
+    )
+    return template
+
+
+def mismatched():
+    template = _template([("src", "out")], ["src"])
+    template.add_cpds(_cpd("out", [[0.5, 0.5], [0.5, 0.5]], ["src"], [2], states={"src": ["low", "high"]}))
+    return template
+
+
+def host():
+    network = DiscreteBayesianNetwork([("season", "b")])
+    network.add_cpds(
+        _cpd("season", [[0.5], [0.5]], states={"season": ["dry", "wet"]}),
+        _cpd("b", [[0.6, 0.3], [0.4, 0.7]], ["season"], [2], states={"season": ["dry", "wet"]}),
+    )
+    return network
+
+
+def prior():
+    return {"b": _cpd("b", [[0.6], [0.4]])}
+
+
+TRIPLE = ["low", "mid", "high"]
+
+
+def wide():
+    template = _template([("b", "hidden"), ("hidden", "c1"), ("hidden", "c2")], ["b"])
+    template.add_cpds(
+        _cpd("hidden", [[1.0, 0.0], [0.0, 1.0]], ["b"], [2]),
+        _cpd("c1", [[1.0, 0.0], [0.0, 1.0]], ["hidden"], [2]),
+        _cpd("c2", [[0.2, 0.5], [0.3, 0.1], [0.5, 0.4]], ["hidden"], [2], states={"c2": TRIPLE}),
+    )
+    return template
+
+
+def broad():
+    template = _template([("b", "hidden"), ("hidden", "x"), ("hidden", "y"), ("hidden", "z"), ("b", "z")], ["b"])
+    template.add_cpds(
+        _cpd("hidden", [[0.5, 0.2], [0.3, 0.3], [0.2, 0.5]], ["b"], [2], states={"hidden": TRIPLE}),
+        _cpd("x", [[0.8, 0.4, 0.1], [0.2, 0.6, 0.9]], ["hidden"], [3], states={"hidden": TRIPLE}),
+        _cpd(
+            "y",
+            [[0.7, 0.2, 0.1], [0.2, 0.5, 0.3], [0.1, 0.3, 0.6]],
+            ["hidden"],
+            [3],
+            states={"hidden": TRIPLE, "y": TRIPLE},
+        ),
+        _cpd(
+            "z",
+            [[0.9, 0.8, 0.5, 0.4, 0.2, 0.1], [0.1, 0.2, 0.5, 0.6, 0.8, 0.9]],
+            ["hidden", "b"],
+            [3, 2],
+            states={"hidden": TRIPLE},
+        ),
+    )
+    return template
+
+
+def paired():
+    template = _template([("left", "joint"), ("right", "joint")], ["left", "right"])
+    template.add_cpds(_cpd("joint", [[0.9, 0.5, 0.4, 0.05], [0.1, 0.5, 0.6, 0.95]], ["left", "right"], [2, 2]))
+    return template
+
+
+def _table(model, variables, given):
+    infer = VariableElimination(model)
+    states = model.states
+    rows = {}
+    for outer in itertools.product(*[states[name] for name in given]):
+        result = infer.query(list(variables), evidence=dict(zip(given, outer)), show_progress=False)
+        for inner in itertools.product(*[states[name] for name in variables]):
+            rows[outer + inner] = round(float(result.get_value(**dict(zip(variables, inner)))), 10)
+    return rows
+
+
+def _reference():
+    return _table(forked().to_network(prior()), ["c1", "c2"], ["b"])
+
