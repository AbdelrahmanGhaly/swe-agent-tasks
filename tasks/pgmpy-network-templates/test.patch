+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd /app || exit 1
+
+NEW_TESTS="pgmpy/tests/test_models/test_network_template_2ec64f.py"
+BLAST_RADIUS=(
+  pgmpy/tests/test_base
+  pgmpy/tests/test_factors
+  pgmpy/tests/test_models
+  pgmpy/tests/test_inference
+)
+
+ARGS=(-p no:cacheprovider -W ignore)
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  ARGS+=(--junitxml="$OUTPUT_PATH")
+fi
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "${ARGS[@]}" "$NEW_TESTS"
+else
+  python -m pytest "${ARGS[@]}" --ignore="$NEW_TESTS" "${BLAST_RADIUS[@]}"
+fi
+exit $?
