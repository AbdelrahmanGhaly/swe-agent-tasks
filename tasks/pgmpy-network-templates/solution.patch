+    def rename(self, mapping: dict[Hashable, Hashable]) -> "TabularCPD":
+        """
+        Returns a copy of the CPD with some of its variables renamed.
+
+        The table itself is untouched, so every entry keeps the states it was
+        written for.
+
+        Parameters
+        ----------
+        mapping: dict
+            A dict of the form {old name: new name} over any subset of the
+            variables of the CPD.
+
+        Returns
+        -------
+        Renamed CPD: pgmpy.factors.discrete.TabularCPD
+
+        Examples
+        --------
+        >>> from pgmpy.factors.discrete import TabularCPD
+        >>> cpd = TabularCPD(
+        ...     "grade", 2, [[0.7, 0.2], [0.3, 0.8]], evidence=["diff"], evidence_card=[2]
+        ... )
+        >>> cpd.rename({"diff": "difficulty"}).variables
+        ['grade', 'difficulty']
+        """
+        if not isinstance(mapping, dict):
+            raise ValueError("mapping must be a dict of the form {old_name: new_name}")
+
+        unknown = set(mapping) - set(self.variables)
+        if unknown:
+            raise ValueError(f"Not variables of this CPD: {sorted(unknown, key=str)}")
+
+        renamed = [mapping.get(variable, variable) for variable in self.variables]
+        if len(set(renamed)) != len(renamed):
+            raise ValueError(f"Renaming the CPD of {self.variable} would give two variables the same name")
+
+        cpd = self.copy()
+        cpd.variables = renamed
+        cpd.variable = renamed[0]
+        cpd.state_names = {mapping.get(key, key): value for key, value in cpd.state_names.items()}
+        cpd.name_to_no = {mapping.get(key, key): value for key, value in cpd.name_to_no.items()}
+        cpd.no_to_name = {mapping.get(key, key): value for key, value in cpd.no_to_name.items()}
+        return cpd
