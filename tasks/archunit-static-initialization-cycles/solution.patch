+package com.tngtech.archunit.core.domain;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.HashSet;
+import java.util.Optional;
+import java.util.Set;
+import java.util.SortedSet;
+import java.util.TreeSet;
+
+import com.tngtech.archunit.core.domain.AccessTarget.MethodCallTarget;
+
+import static com.tngtech.archunit.core.domain.JavaModifier.ABSTRACT;
+import static com.tngtech.archunit.core.domain.JavaModifier.PRIVATE;
+import static com.tngtech.archunit.core.domain.JavaModifier.PROTECTED;
+import static com.tngtech.archunit.core.domain.JavaModifier.PUBLIC;
+import static com.tngtech.archunit.core.domain.JavaModifier.STATIC;
+
+class JavaClassStaticInitialization {
+    private final JavaClass initializedClass;
+    private final SortedSet<Dependency> dependencies = new TreeSet<>();
+    private final Set<JavaCodeUnit> visitedCodeUnits = new HashSet<>();
+    private final Deque<JavaCodeUnit> codeUnitsToVisit = new ArrayDeque<>();
+
+    private JavaClassStaticInitialization(JavaClass initializedClass) {
+        this.initializedClass = initializedClass;
+    }
+
+    static SortedSet<Dependency> findStaticInitializationDependenciesFrom(JavaClass javaClass) {
+        JavaClassStaticInitialization initialization = new JavaClassStaticInitialization(javaClass);
+        initialization.addSupertypesInitializedBefore();
+        initialization.addClassesInitializedByExecutedCode();
+        return initialization.dependencies;
+    }
+
+    private void addSupertypesInitializedBefore() {
+        if (initializedClass.isInterface()) {
+            return;
+        }
+        initializedClass.getRawSuperclass().ifPresent(this::addInheritanceDependency);
+        Set<JavaClass> visitedInterfaces = new HashSet<>();
+        initializedClass.getRawInterfaces().forEach(anInterface -> addInterfacesDeclaringDefaultMethods(anInterface, visitedInterfaces));
+    }
+
+    private void addInterfacesDeclaringDefaultMethods(JavaClass anInterface, Set<JavaClass> visitedInterfaces) {
+        if (!visitedInterfaces.add(anInterface)) {
+            return;
+        }
+        if (declaresDefaultMethod(anInterface)) {
+            addInheritanceDependency(anInterface);
+        }
+        anInterface.getRawInterfaces().forEach(superInterface -> addInterfacesDeclaringDefaultMethods(superInterface, visitedInterfaces));
+    }
+
+    private static boolean declaresDefaultMethod(JavaClass anInterface) {
+        return anInterface.getMethods().stream()
+                .map(JavaMethod::getModifiers)
+                .anyMatch(modifiers -> !modifiers.contains(ABSTRACT) && !modifiers.contains(STATIC) && !modifiers.contains(PRIVATE));
+    }
+
+    private void addInheritanceDependency(JavaClass supertype) {
+        if (isRelevantTarget(supertype)) {
+            dependencies.add(Dependency.fromInheritance(initializedClass, supertype));
+        }
+    }
+
+    private void addClassesInitializedByExecutedCode() {
+        initializedClass.getStaticInitializer().ifPresent(this::scheduleVisit);
+        while (!codeUnitsToVisit.isEmpty()) {
+            JavaCodeUnit codeUnit = codeUnitsToVisit.pop();
+            codeUnit.getFieldAccesses().stream()
+                    .filter(access -> !access.isDeclaredInLambda())
+                    .forEach(this::handleFieldAccess);
+            codeUnit.getMethodCallsFromSelf().stream()
+                    .filter(call -> !call.isDeclaredInLambda())
+                    .forEach(this::handleMethodCall);
+            codeUnit.getConstructorCallsFromSelf().stream()
+                    .filter(call -> !call.isDeclaredInLambda())
+                    .forEach(this::handleConstructorCall);
+        }
+    }
+
+    private void handleFieldAccess(JavaFieldAccess access) {
+        access.getTarget().resolveMember()
+                .filter(field -> field.getModifiers().contains(STATIC))
+                .ifPresent(field -> addInitializationTrigger(access, field.getOwner()));
+    }
+
+    private void handleMethodCall(JavaMethodCall call) {
+        Optional<JavaMethod> method = call.getTarget().resolveMember();
+        method.filter(it -> it.getModifiers().contains(STATIC))
+                .ifPresent(it -> addInitializationTrigger(call, it.getOwner()));
+        method.ifPresent(this::scheduleVisit);
+        if (call.isDynamicallyDispatched() && !method.filter(JavaClassStaticInitialization::cannotBeOverridden).isPresent()) {
+            scheduleVisitOfOverridingMethods(call.getTarget(), method);
+        }
+    }
+
+    private static boolean cannotBeOverridden(JavaMethod method) {
+        return method.getModifiers().contains(STATIC) || method.getModifiers().contains(PRIVATE);
+    }
+
+    private void scheduleVisitOfOverridingMethods(MethodCallTarget target, Optional<JavaMethod> calledMethod) {
+        String[] parameterTypeNames = target.getRawParameterTypes().stream().map(JavaClass::getName).toArray(String[]::new);
+        for (JavaClass subclass : target.getOwner().getAllSubclasses()) {
+            subclass.tryGetMethod(target.getName(), parameterTypeNames)
+                    .filter(candidate -> overrides(candidate, calledMethod))
+                    .ifPresent(this::scheduleVisit);
+        }
+    }
+
+    private static boolean overrides(JavaMethod candidate, Optional<JavaMethod> calledMethod) {
+        if (cannotBeOverridden(candidate)) {
+            return false;
+        }
+        return !calledMethod.filter(JavaClassStaticInitialization::isPackagePrivate).isPresent()
+                || calledMethod.get().getOwner().getPackageName().equals(candidate.getOwner().getPackageName());
+    }
+
+    private static boolean isPackagePrivate(JavaMethod method) {
+        Set<JavaModifier> modifiers = method.getModifiers();
+        return !modifiers.contains(PUBLIC) && !modifiers.contains(PROTECTED) && !modifiers.contains(PRIVATE);
+    }
+
+    private void handleConstructorCall(JavaConstructorCall call) {
+        if (!isConstructorDelegation(call)) {
+            addInitializationTrigger(call, call.getTargetOwner());
+        }
+        call.getTarget().resolveMember().ifPresent(this::scheduleVisit);
+    }
+
+    private static boolean isConstructorDelegation(JavaConstructorCall call) {
+        if (!(call.getOrigin() instanceof JavaConstructor)) {
+            return false;
+        }
+        JavaClass callingClass = call.getOriginOwner();
+        JavaClass targetClass = call.getTargetOwner();
+        return targetClass.equals(callingClass) || callingClass.getRawSuperclass().map(targetClass::equals).orElse(false);
+    }
+
+    private void addInitializationTrigger(JavaAccess<?> access, JavaClass triggeredClass) {
+        if (isRelevantTarget(triggeredClass)) {
+            dependencies.add(Dependency.fromStaticInitializationTrigger(initializedClass, triggeredClass, access));
+        }
+    }
+
+    private boolean isRelevantTarget(JavaClass targetClass) {
+        return !targetClass.equals(initializedClass);
+    }
+
+    private void scheduleVisit(JavaCodeUnit codeUnit) {
+        if (visitedCodeUnits.add(codeUnit)) {
+            codeUnitsToVisit.push(codeUnit);
+        }
+    }
+}
