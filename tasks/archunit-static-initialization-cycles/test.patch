+    private static final SliceAssignment BY_SIMPLE_NAME_PREFIX = new SliceAssignment() {
+        @Override
+        public SliceIdentifier getIdentifierOf(JavaClass javaClass) {
+            String simpleName = javaClass.getSimpleName();
+            for (String prefix : Arrays.asList("Alpha", "Beta", "Gamma")) {
+                if (simpleName.startsWith(prefix)) {
+                    return SliceIdentifier.of(prefix);
+                }
+            }
+            return SliceIdentifier.ignore();
+        }
+
+        @Override
+        public String getDescription() {
+            return "simple name prefix";
+        }
+    };
