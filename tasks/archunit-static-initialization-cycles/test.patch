+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/archunit-junit.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")"
+
+NEW_TEST_CLASS="com.tngtech.archunit.library.StaticInitializationE3af4aTest"
+NEW_TEST_FILE_PATTERN="**/StaticInitializationE3af4aTest.java"
+GRADLE=(./gradlew --no-daemon --offline --continue)
+
+# compileJdk9mainJava writes into the same directory as compileJava, so after a change to the public API of the
+# main sources an incremental build can delete classes of the main source set. Every run therefore starts clean.
+CLEAN=(:archunit:clean)
+
+merge_results() {
+  python3 - "$OUTPUT_PATH" "$@" <<'PYEOF'
+import glob, re, sys
+out = sys.argv[1]
+patterns = sys.argv[2:]
+suites = []
+for pattern in patterns:
+    for path in sorted(glob.glob(pattern, recursive=True)):
+        text = open(path, encoding="utf-8").read()
+        suites.append(re.sub(r"^<\?xml[^>]*\?>\s*", "", text))
+with open(out, "w", encoding="utf-8") as f:
+    f.write('<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n')
+    f.write("\n".join(suites))
+    f.write("\n</testsuites>\n")
+PYEOF
+}
+
+if [ "$MODE" = "base" ]; then
+  # Base mode runs the whole :archunit module, which contains every core, lang and library test the change can
+  # affect. The other modules (JUnit engines, examples, Maven and module-path integration) do not depend on the
+  # changed code paths and add about 25 minutes. The new test class uses API that only exists once the feature
+  # is implemented, and Gradle compiles the test source set of :archunit as a whole, so base mode leaves that
+  # single file out of compilation.
+  # Parameterized tests are named by method and index instead of by argument values, because several arguments
+  # print object identities or temporary paths that change on every run. The Random*SyntaxTest classes are left
+  # out: they build their rules from an unseeded java.util.Random, so both their cases and names differ per run.
+  INIT_SCRIPT="$(mktemp --suffix=.gradle)"
+  cat > "$INIT_SCRIPT" <<EOF
+allprojects {
+    if (path == ':archunit') {
+        afterEvaluate {
+            sourceSets.test.java.exclude '${NEW_TEST_FILE_PATTERN}'
+            tasks.named('test') {
+                systemProperty 'junit.jupiter.params.displayname.default', '{displayName} [{index}]'
+                filter {
+                    excludeTestsMatching 'com.tngtech.archunit.lang.syntax.RandomClassesSyntaxTest'
+                    excludeTestsMatching 'com.tngtech.archunit.lang.syntax.RandomMembersSyntaxTest'
+                    excludeTestsMatching 'com.tngtech.archunit.library.dependencies.RandomSlicesSyntaxTest'
+                    excludeTestsMatching 'com.tngtech.archunit.library.modules.RandomModulesSyntaxTest'
+                }
+            }
+        }
+    }
+}
+EOF
+  "${GRADLE[@]}" -I "$INIT_SCRIPT" "${CLEAN[@]}" :archunit:test
+  STATUS=$?
+  merge_results 'archunit/build/test-results/test/*.xml' || STATUS=1
+  exit $STATUS
+fi
+
+GRADLE_LOG="$(mktemp)"
+"${GRADLE[@]}" "${CLEAN[@]}" :archunit:test --tests "$NEW_TEST_CLASS" 2>&1 | tee "$GRADLE_LOG"
+STATUS=${PIPESTATUS[0]}
+RESULT_FILE="archunit/build/test-results/test/TEST-${NEW_TEST_CLASS}.xml"
+if [ -f "$RESULT_FILE" ]; then
+  merge_results "$RESULT_FILE" || STATUS=1
+else
+  # Without a result file the test class did not compile, so every test is reported as failed together with
+  # the compiler diagnostic from the Gradle output.
+  python3 - "$OUTPUT_PATH" "$NEW_TEST_CLASS" "archunit/src/test/java/com/tngtech/archunit/library/StaticInitializationE3af4aTest.java" "$GRADLE_LOG" <<'PYEOF'
+import re, sys
+from xml.sax.saxutils import escape
+out, test_class, test_file, log_file = sys.argv[1:5]
+names = re.findall(r"@Test\s+public void (\w+)\(", open(test_file, encoding="utf-8").read())
+lines = open(log_file, encoding="utf-8", errors="replace").read().splitlines()
+errors = [i for i, line in enumerate(lines) if ": error:" in line]
+if errors:
+    block = lines[errors[0]:]
+    end = next((i for i, line in enumerate(block) if re.match(r"^\d+ errors?$", line.strip())), len(block) - 1)
+    diagnostic = "\n".join(block[:end + 1])
+else:
+    diagnostic = "\n".join(lines[-60:])
+diagnostic = escape(diagnostic[:8000], {'"': "&quot;"})
+with open(out, "w", encoding="utf-8") as f:
+    f.write('<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n')
+    f.write('<testsuite name="%s" tests="%d" failures="%d" errors="0">\n' % (test_class, len(names), len(names)))
+    for name in names:
+        f.write('<testcase name="%s" classname="%s"><failure message="test compilation failed">%s</failure></testcase>\n'
+                % (name, test_class, diagnostic))
+    f.write("</testsuite>\n</testsuites>\n")
+PYEOF
+  [ $STATUS -eq 0 ] && STATUS=1
+fi
+exit $STATUS
