+    private static Set<Dependency> initializationDependenciesOf(Class<?> initialized, Class<?>... alsoImported) {
+        List<Class<?>> imported = new ArrayList<>(Arrays.asList(alsoImported));
+        imported.add(initialized);
+        return importClasses(imported.toArray(new Class<?>[0])).get(initialized).getStaticInitializationDependenciesFromSelf();
+    }
+
+    private static Set<String> initializedClassesOf(Class<?> initialized, Class<?>... alsoImported) {
+        return initializationDependenciesOf(initialized, alsoImported).stream()
+                .map(Dependency::getTargetClass)
+                .filter(target -> !target.isEquivalentTo(Object.class))
+                .map(JavaClass::getSimpleName)
+                .collect(toSet());
+    }
+
+    private static Dependency dependencyOn(Class<?> target, Set<Dependency> dependencies) {
+        List<Dependency> matching = dependencies.stream()
+                .filter(dependency -> dependency.getTargetClass().isEquivalentTo(target))
+                .collect(toList());
+        assertThat(matching).as("dependencies on " + target.getSimpleName()).hasSize(1);
+        return matching.get(0);
+    }
+
+    private static List<String> violationsOf(ArchRule rule, JavaClasses classes) {
+        EvaluationResult result = rule.evaluate(classes);
+        return result.getFailureReport().getDetails();
+    }
+
+    private static Set<List<String>> cyclesReportedBy(ArchRule rule, JavaClasses classes) {
+        return violationsOf(rule, classes).stream()
+                .map(StaticInitializationE3af4aTest::cycleOf)
+                .collect(toSet());
+    }
+
+    private static List<String> cycleOf(String violation) {
+        assertThat(violation).startsWith("Cycle detected: ");
+        String header = violation.substring(0, violation.indexOf("  1. Dependencies of "));
+        Matcher matcher = Pattern.compile("(?:Class|Slice) <?([^>\\s]+)>?").matcher(header);
+        List<String> cycle = new ArrayList<>();
+        while (matcher.find()) {
+            String name = matcher.group(1);
+            cycle.add(name.substring(name.lastIndexOf('$') + 1));
+        }
+        return cycle;
+    }
+
+    private static String cycleLine(Class<?>... classes) {
+        String indent = "                ";
+        return Arrays.stream(classes).map(c -> "Class <" + c.getName() + ">").collect(java.util.stream.Collectors.joining(" -> " + System.lineSeparator() + indent));
+    }
