+    def test_far_boxes_match_the_exhaustive_hull(self):
+        masks = ((62, 66), (126, 130), (254, 258), (1022, 1026),
+                 (-130, -126), (-66, -62), (96, 100))
+        for symbol in ('&', '|', '^'):
+            for left in masks:
+                for right in masks:
+                    self.assertEqual(reported(symbol, left, right),
+                                     hull(symbol, left, right),
