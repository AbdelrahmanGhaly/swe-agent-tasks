+    SYMBOLS = ('+', '-', '*', '//', '<<', '>>', '&', '|', '^', '**')
+
+    def test_every_ordinary_operator_matches_the_exhaustive_hull(self):
+        boxes = windows(-5, 5, 3)
+        for symbol in self.SYMBOLS:
+            for left in boxes:
+                for right in boxes:
+                    if symbol == '**' and right[0] < 0:
+                        continue
+                    expected = hull(symbol, left, right)
+                    if expected is None:
+                        expected = (-INF, INF)
+                    self.assertEqual(reported(symbol, left, right), expected,
+                                     (symbol, left, right))
