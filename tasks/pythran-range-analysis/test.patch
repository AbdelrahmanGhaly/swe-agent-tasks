+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd /app || exit 1
+
+export PYTHONDONTWRITEBYTECODE=1
+
+NEW_TESTS="pythran/tests/test_range_analysis_a473f1.py"
+
+# Every other module under pythran/tests drives the C++ toolchain once per test
+# case, which takes hours; test_xdoc runs the doctests of every pythran module,
+# including the range analysis, its consumers and the compilation toolchain.
+BASE_TESTS="pythran/tests/test_xdoc.py pythran/tests/test_spec_parser.py"
+
+ARGS=(-p no:cacheprovider -o addopts=)
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  ARGS+=(--junitxml="$OUTPUT_PATH")
+fi
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "${ARGS[@]}" "$NEW_TESTS"
+else
+  python -m pytest "${ARGS[@]}" $BASE_TESTS
+fi
+exit $?
