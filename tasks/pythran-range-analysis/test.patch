+import builtins
+import contextlib
+import io
+import operator
+import unittest
+
+import gast as ast
+
+from pythran import backend, passmanager
+from pythran.analyses import RangeValues
+from pythran.optimizations import RangeBasedSimplify
+
+INF = float('inf')
+
+OPERATIONS = {
+    '&': operator.and_,
+    '|': operator.or_,
+    '^': operator.xor,
+    '%': operator.mod,
+    '//': operator.floordiv,
+    '<<': operator.lshift,
+    '>>': operator.rshift,
+    '**': operator.pow,
+    '*': operator.mul,
+    '+': operator.add,
+    '-': operator.sub,
+}
+
+
+def pins(name, window):
+    low, high = window
+    lines = []
+    if low != -INF:
+        lines.append('    assert {} >= {}'.format(name, low))
+    if high != INF:
+        lines.append('    assert {} <= {}'.format(name, high))
+    return lines
+
+
+def analyse(source):
+    return passmanager.PassManager('test').gather(RangeValues, ast.parse(source))
+
+
+def bounds(source, name='outcome'):
+    reported = analyse(source)[name]
+    return reported.low, reported.high
+
+
+def kernel(expression, left=None, right=None):
+    body = ['def kernel(a, b):']
+    if left is not None:
+        body.extend(pins('a', left))
+    if right is not None:
+        body.extend(pins('b', right))
+    body.append('    outcome = ' + expression)
+    return '\n'.join(body)
+
+
+def reported(symbol, left, right):
+    return bounds(kernel('a {} b'.format(symbol), left, right))
+
+
+def hull(symbol, left, right):
+    operation = OPERATIONS[symbol]
+    values = []
+    for x in range(left[0], left[1] + 1):
+        for y in range(right[0], right[1] + 1):
+            try:
+                values.append(operation(x, y))
+            except (ZeroDivisionError, ValueError):
+                continue
+    return (min(values), max(values)) if values else None
+
+
+def windows(lowest, highest, span):
+    return [(low, high) for low in range(lowest, highest + 1)
+            for high in range(low, min(highest, low + span) + 1)]
+
+
+def plain(source):
+    return passmanager.PassManager('test').dump(backend.Python, ast.parse(source))
+
+
+def simplified(source):
+    manager = passmanager.PassManager('test')
+    _, node = manager.apply(RangeBasedSimplify, ast.parse(source))
+    return manager.dump(backend.Python, node)
+
+
+def run(source, name, *args):
+    namespace = {'builtins': builtins}
+    exec(compile(source, '<range-analysis-test>', 'exec'), namespace)
+    return namespace[name](*args)
+
+
+def effects(source, name, *args):
+    stream = io.StringIO()
+    with contextlib.redirect_stdout(stream):
+        value = run(source, name, *args)
+    return value, stream.getvalue().count('\n')
+
+
