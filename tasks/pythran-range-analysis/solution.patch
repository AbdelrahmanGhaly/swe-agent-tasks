+def narrow(mapping, node, target, modified):
+    """
+    Bound the identifiers `node' reaches through the sums, the differences and
+    the minus signs it applies to them, by undoing those steps on `target'.
+
+    `mapping' and `modified' are updated in place, and a bound that leaves an
+    identifier nothing to take is dropped rather than recorded.
