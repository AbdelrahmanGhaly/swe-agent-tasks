+def without_zero(range_):
+    """ Drop zero from a range, or None when nothing else is left. """
+    if range_.low == 0 == range_.high:
+        return None
+    if range_.low == 0:
+        return Interval(1, range_.high)
+    if range_.high == 0:
+        return Interval(range_.low, -1)
+    return range_
+
+
+def holds_zero(range_):
+    """ Whether zero lies between the bounds of a range. """
+    return range_.low <= 0 <= range_.high
+
+
+def reaches_other(range_):
+    """ Whether a range holds anything besides zero. """
+    return not (range_.low == 0 == range_.high)
+
+
+def negation_of(range_):
+    """
+    The truth value `not' gives an operand, as narrow as the operand settles.
+
+    It is one exactly where the operand holds zero and nought exactly where
+    the operand holds something else, so an operand settled either way leaves
+    a single value rather than the pair.
+    """
+    return Interval(0 if reaches_other(range_) else 1,
+                    1 if holds_zero(range_) else 0)
+
+
+def bool_state(range_):
+    """ A range, whether it can be zero, and whether it can be else. """
+    return range_, holds_zero(range_), reaches_other(range_)
+
+
+def combine_bool(op, left, right):
+    """
+    Fold one step of a boolean chain, which yields one of its operands.
+
+    `or` gives its left operand unless that one is zero, `and` gives zero
+    when its left operand is zero and its right operand otherwise. Only the
+    left operand decides which of the two a step can reach, so the right side
+    arrives as a plain range and the step hands back one as well.
+    """
+    left_range, left_zero, left_other = left
+    parts = []
+    if isinstance(op, ast.Or):
+        if left_other:
+            parts.append(without_zero(left_range))
+        if left_zero:
+            parts.append(right)
+    else:
+        if left_zero:
+            parts.append(Interval(0, 0))
+        if left_other:
+            parts.append(right)
+    if not parts:
+        return UNKNOWN_RANGE
+    res = parts[0]
+    for part in parts[1:]:
+        res = res.union(part)
+    return res
+
