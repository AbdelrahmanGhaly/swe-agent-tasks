+use common::{get_test_context, get_test_context_without_prelude};
+
+use numbat::markup::{Formatter, PlainTextFormatter};
+use numbat::resolver::CodeSource;
+use numbat::{Context, InterpreterResult};
+
+const DBX: &str = "@logarithmic(10)\n@aliases(dBx: short)\nunit decibel_x: Power = 1 milliwatt\n";
+
+#[track_caller]
+fn output(code: &str) -> String {
+    let mut context = get_test_context();
+    match context.interpret(code, CodeSource::Internal) {
+        Ok((_, InterpreterResult::Value(value))) => PlainTextFormatter {}
+            .format(&value.pretty_print(), false)
+            .trim()
+            .to_string(),
+        Ok((_, result)) => panic!("expected a value for {code:?}, got {result:?}"),
+        Err(error) => panic!("expected {code:?} to succeed, got:\n{error}"),
+    }
+}
+
+#[track_caller]
+fn error(code: &str) -> String {
+    let mut context = get_test_context();
+    match context.interpret(code, CodeSource::Internal) {
+        Err(error) => error.to_string(),
+        Ok((_, result)) => panic!("expected {code:?} to fail, got {result:?}"),
+    }
+}
+
+#[track_caller]
+fn expect_success(code: &str) {
+    let mut context = get_test_context();
+    if let Err(error) = context.interpret(code, CodeSource::Internal) {
+        panic!("expected {code:?} to succeed, got:\n{error}");
+    }
+}
+
+#[track_caller]
+fn expect_output(code: &str, expected: &str) {
+    assert_eq!(output(code), expected, "for {code:?}");
+}
+
+/// A level that has to work, used to anchor the checks that would otherwise also hold
+/// on a build without any logarithmic units.
+#[track_caller]
+fn expect_levels_exist() {
+    expect_output("0 dBm -> mW", "1 mW");
+}
+
+#[track_caller]
+fn expect_preserved(code: &str, expected: &str) {
+    expect_levels_exist();
+    expect_output(code, expected);
+}
+
+#[track_caller]
+fn expect_error(code: &str) {
+    expect_levels_exist();
+    let message = error(code);
+    assert!(
+        !message.trim().is_empty(),
+        "expected a diagnostic for {code:?}"
+    );
+}
+
+#[track_caller]
+fn expect_output_without_prelude(code: &str, expected: &str) {
+    let mut context = get_test_context_without_prelude();
+    match context.interpret(code, CodeSource::Internal) {
+        Ok((_, InterpreterResult::Value(value))) => assert_eq!(
+            PlainTextFormatter {}
+                .format(&value.pretty_print(), false)
+                .trim(),
+            expected,
+            "for {code:?}"
+        ),
+        other => panic!("expected a value for {code:?}, got {other:?}"),
+    }
+}
+
+fn declaring(declaration: &str, expression: &str) -> String {
+    format!("{declaration}\n{expression}")
+}
