@@ -0,0 +1,104 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+export PATH="/opt/cargo/bin:$PATH"
+export CARGO_INCREMENTAL=0
+# libtest's json output is nightly-gated; this unlocks it on the pinned stable toolchain.
+export RUSTC_BOOTSTRAP=1
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+
+NEW_TEST=logarithmic_units_9dec42
+TEST_JSON=$(mktemp)
+TEST_ERR=$(mktemp)
+RUN_JSON=$(mktemp)
+RUN_ERR=$(mktemp)
+SYNTH=$(mktemp)
+STATUS=0
+
+# Each cargo invocation is converted on its own terms: a command that dies before emitting
+# any test event leaves nothing for cargo2junit to report, and an earlier command's passing
+# cases must not hide that. Such a command contributes its own failing case instead.
+run_suite() {
+  local label="$1"; shift
+  cargo test --offline "$@" \
+    -- -Z unstable-options --format json --report-time > "$RUN_JSON" 2> "$RUN_ERR"
+  local status=$?
+
+  cat "$RUN_JSON" >> "$TEST_JSON"
+  cat "$RUN_ERR" >> "$TEST_ERR"
+
+  if [ "$status" -ne 0 ]; then
+    STATUS=1
+    if ! grep -q '"type" *: *"test"' "$RUN_JSON" 2>/dev/null; then
+      {
+        printf '  <testsuite name="%s" tests="1" failures="1" errors="0">\n' "$label"
+        printf '    <testcase name="compilation" classname="%s">' "$label"
+        printf '<failure message="build failed"><![CDATA['
+        { cat "$RUN_ERR"; cat "$RUN_JSON"; } | tail -c 4000 | sed -e 's/]]>/]]]]><![CDATA[>/g'
+        printf ']]></failure></testcase>\n  </testsuite>\n'
+      } >> "$SYNTH"
+    fi
+  fi
+}
+
+if [ "$MODE" = new ]; then
+  run_suite "$NEW_TEST" -p numbat --test "$NEW_TEST"
+else
+  # The repository's own suites. The library unit tests and the three integration targets
+  # the crate ships are listed explicitly so the target added by the test patch is not
+  # picked up here as well.
+  run_suite numbat -p numbat --lib --test interpreter --test prelude_and_examples \
+    --test example_snapshots
+  run_suite numbat-cli -p numbat-cli -p numbat-exchange-rates
+fi
+
+cat "$TEST_ERR" >&2
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  cargo2junit < "$TEST_JSON" > "$OUTPUT_PATH" 2>/dev/null || true
+
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    if [ ! -s "$SYNTH" ]; then
+      {
+        printf '  <testsuite name="cargo-test" tests="1" failures="1" errors="0">\n'
+        printf '    <testcase name="collection" classname="cargo-test">'
+        printf '<failure message="no tests were reported"><![CDATA['
+        tail -c 4000 "$TEST_ERR" | sed -e 's/]]>/]]]]><![CDATA[>/g'
+        printf ']]></failure></testcase>\n  </testsuite>\n'
+      } >> "$SYNTH"
+    fi
+    {
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n'
+      cat "$SYNTH"
+      printf '</testsuites>\n'
+    } > "$OUTPUT_PATH"
+    STATUS=1
+  elif [ -s "$SYNTH" ]; then
+    MERGED=$(mktemp)
+    awk -v synth="$SYNTH" '
+      /<\/testsuites>/ && !inserted {
+        while ((getline line < synth) > 0) print line
+        inserted = 1
+      }
+      { print }
+    ' "$OUTPUT_PATH" > "$MERGED"
+    mv "$MERGED" "$OUTPUT_PATH"
+  fi
+fi
+
+rm -f "$TEST_JSON" "$TEST_ERR" "$RUN_JSON" "$RUN_ERR" "$SYNTH"
+exit $STATUS
