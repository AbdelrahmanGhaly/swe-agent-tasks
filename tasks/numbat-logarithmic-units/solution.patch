+use crate::{number::Number, prefix_parser::AcceptsPrefix, span::Span, unit::CanonicalName};
+
+/// The two parameters of a logarithmic unit definition: a value `x` in the unit denotes
+/// `reference * base^(x / scale)`. The base defaults to ten.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct LogarithmicScale {
+    pub scale: Number,
+    pub base: Number,
+}
+
+impl LogarithmicScale {
+    /// Describes why this definition can not be used, given the value of its reference,
+    /// or `None` if it is well formed.
+    pub fn problem(&self, reference: f64) -> Option<&'static str> {
+        let base = self.base.to_f64();
+        let scale = self.scale.to_f64();
+        if scale <= 0.0 || scale.is_nan() {
+            Some("the scale must be positive")
+        } else if base <= 0.0 || base.is_nan() || base == 1.0 {
+            Some("the base must be positive and not one")
+        } else if reference <= 0.0 || reference.is_nan() {
+            Some("the reference must be positive")
+        } else {
+            None
+        }
+    }
+}
 
