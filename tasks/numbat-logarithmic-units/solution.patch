+/// A level stands for the linear quantity it denotes as soon as it is handed to a
+/// function. This is the single place that decides it, so no call path can forget.
+fn holds_level(value: &Value) -> bool {
+    match value {
+        Value::Quantity(quantity) => quantity.unit().has_logarithmic(),
+        Value::List(elements) => elements.iter().any(holds_level),
+        Value::StructInstance(_, fields) => fields.iter().any(holds_level),
+        _ => false,
+    }
+}
+
+fn linearize_level(value: &mut Value) {
+    match value {
+        Value::Quantity(quantity) => {
+            if let Some(linear) = quantity.linearized() {
+                *quantity = linear;
+            }
+        }
+        // A level reaches a function nested in a list or a struct just as easily as it
+        // does directly. The list is only rebuilt when it actually holds one, so ordinary
+        // lists are scanned and left alone.
+        Value::List(elements) if elements.iter().any(holds_level) => {
+            let mut linearized = NumbatList::new();
+            for element in elements.iter() {
+                let mut element = element.clone();
+                linearize_level(&mut element);
+                linearized.push_back(element);
+            }
+            *elements = linearized;
+        }
+        Value::StructInstance(_, fields) => {
+            for field in fields.iter_mut() {
+                linearize_level(field);
+            }
+        }
+        _ => {}
+    }
+}
