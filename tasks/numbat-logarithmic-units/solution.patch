+pub fn logarithmic_scale(decorators: &[Decorator]) -> Option<LogarithmicScale> {
+    for decorator in decorators {
+        if let Decorator::Logarithmic(logarithmic) = decorator {
+            return Some(*logarithmic);
+        }
+    }
