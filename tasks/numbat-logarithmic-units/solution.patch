+use units::si
+
+### Logarithmic level units
+
+@name("Bel")
+@url("https://en.wikipedia.org/wiki/Decibel#Definition")
+@logarithmic(1)
+@metric_prefixes
+@aliases(bels)
+unit bel = 1
+
+@name("Decibel-milliwatt")
+@url("https://en.wikipedia.org/wiki/DBm")
+@logarithmic(10)
+@aliases(dBm: short)
+unit decibel_milliwatt: Power = 1 milliwatt
+
+@name("Decibel-watt")
+@url("https://en.wikipedia.org/wiki/Decibel_watt")
+@logarithmic(10)
+@aliases(dBW: short)
+unit decibel_watt: Power = 1 watt
+
+@name("Decibel-volt")
+@url("https://en.wikipedia.org/wiki/Decibel#Voltage")
+@logarithmic(20)
+@aliases(dBV: short)
+unit decibel_volt: Voltage = 1 volt
+
+@name("Decibel-unloaded")
+@url("https://en.wikipedia.org/wiki/Decibel#Voltage")
+@logarithmic(20)
+@aliases(dBu: short)
+unit decibel_unloaded: Voltage = 0.7745966692414834 volt
+
+@name("Decibel sound pressure level")
+@url("https://en.wikipedia.org/wiki/Sound_pressure#Sound_pressure_level")
+@logarithmic(20)
+@aliases(dBSPL: short)
+unit decibel_sound_pressure: Pressure = 20 micropascal
+
+@name("Neper")
+@url("https://en.wikipedia.org/wiki/Neper")
+@logarithmic(0.5, 2.718281828459045)
+@aliases(nepers)
+unit neper = 1
