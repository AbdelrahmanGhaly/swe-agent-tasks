+import glob
+import os
+import sys
+import types
+import unittest
+from unittest import mock
+
+from pony.orm import *
+from pony.orm.tests import setup_database, teardown_database, testutils
+
+db = Database()
+
+
+class Store(db.Entity):
+    name = Required(str)
+    items = Set("Item")
+
+
+class Item(db.Entity):
+    id = PrimaryKey(int)
+    name = Required(str)
+    store = Optional(Store)
+    tags = Optional(StrArray)
+    sizes = Optional(IntArray)
+    prices = Optional(FloatArray)
+    codes = Optional(IntArray, nullable=True)
+    specs = Optional(Json)
+
+
+def by_repr(rows):
+    return sorted(rows, key=repr)
+
+
+def mocked_record_entity(provider, server_version, **bind_options):
+    class MockedDatabase(testutils.TestDatabase):
+        real_provider_name = provider
+        raw_server_version = server_version
+
+    mocked = MockedDatabase()
+
+    class Record(mocked.Entity):
+        payload = Optional(Json)
+        if provider not in ("mysql", "oracle"):
+            tags = Optional(StrArray)
+            sizes = Optional(IntArray)
+            prices = Optional(FloatArray)
+
+    mocked.bind(provider, **bind_options)
+    mocked.generate_mapping()
+    return Record
+
+
