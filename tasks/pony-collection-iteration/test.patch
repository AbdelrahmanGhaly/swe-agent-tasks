+
+start_postgres() {
+  PG_BIN="$(ls -d /usr/lib/postgresql/*/bin 2>/dev/null | head -n 1)"
+  [ -n "$PG_BIN" ] || return 1
+  PG_DIR="$(mktemp -d)"
+  if [ "$(id -u)" = "0" ]; then
+    chown postgres "$PG_DIR" || return 1
+    PG_RUN="runuser -u postgres --"
+  else
+    PG_RUN=""
+    if ! getent passwd "$(id -u)" >/dev/null 2>&1; then
+      export LD_PRELOAD=libnss_wrapper.so
+      export NSS_WRAPPER_PASSWD="$PG_DIR/passwd"
+      export NSS_WRAPPER_GROUP="$PG_DIR/group"
+      printf 'pony:x:%s:%s:pony:%s:/bin/false\n' "$(id -u)" "$(id -g)" "$PG_DIR" \
+        > "$NSS_WRAPPER_PASSWD"
+      printf 'pony:x:%s:\n' "$(id -g)" > "$NSS_WRAPPER_GROUP"
+    fi
+  fi
+  $PG_RUN "$PG_BIN/initdb" -D "$PG_DIR/data" -U postgres --auth=trust -E UTF8 \
+    > "$PG_DIR/initdb.log" 2>&1 || return 1
+  $PG_RUN "$PG_BIN/pg_ctl" -D "$PG_DIR/data" \
+    -o "-k $PG_DIR -c listen_addresses=''" -w -t 60 start \
+    > "$PG_DIR/pg_ctl.log" 2>&1 || return 1
+  export PONY_ELEMENT_PG_SOCKET="$PG_DIR"
+  return 0
+}
+
+stop_postgres() {
+  if [ -n "$PG_DIR" ] && [ -d "$PG_DIR/data" ]; then
+    $PG_RUN "$PG_BIN/pg_ctl" -D "$PG_DIR/data" -w -t 60 stop > /dev/null 2>&1
+  fi
+}
+
+trap stop_postgres EXIT
+
+if [ "$MODE" = "base" ]; then
+  python -m pytest -p no:cacheprovider --basetemp="$BASETEMP" \
+    --junitxml="$OUTPUT_PATH" \
+    --ignore="$NEW_TESTS" \
+    --deselect pony/orm/tests/test_decompiler.py::test_method \
+    pony/orm/tests
+  EXIT_CODE=$?
+else
+  if ! start_postgres; then
+    echo "PostgreSQL server unavailable; its cases will be skipped"
+  fi
+  python -m pytest -p no:cacheprovider --basetemp="$BASETEMP" \
+    --junitxml="$OUTPUT_PATH" \
+    "$NEW_TESTS"
+  EXIT_CODE=$?
+  stop_postgres
+fi
+
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH"; then
+  cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+<testsuite name="pony" tests="1" failures="1" errors="0">
+<testcase name="collect pony tests" classname="pony">
+<failure message="pytest collected no tests">pytest did not collect any tests; see the output above.</failure>
+</testcase>
+</testsuite>
+</testsuites>
+XMLEOF
+  [ "$EXIT_CODE" -eq 0 ] && EXIT_CODE=1
+fi
+
+rm -rf "$BASETEMP"
+exit $EXIT_CODE
