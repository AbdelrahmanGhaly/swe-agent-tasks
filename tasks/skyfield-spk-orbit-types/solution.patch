+class _OrbitSegment(SPICESegment):
+    def _at(self, t):
+        segment = self.spk_segment
+        seconds = (t.whole - T0) * DAY_S + t.tdb_fraction * DAY_S
+        outside = ((seconds < segment.start_second)
+                   | (seconds > segment.end_second))
+        if outside.any():
+            raise self._range_error(t.ts, np.atleast_1d(outside))
+        shape = (3,) + np.shape(seconds)
+        if not np.size(seconds):
+            return np.empty(shape), np.empty(shape), None, None
+        position, velocity = self._compute(np.ravel(seconds))
+        position = position.reshape(shape) / AU_KM
+        velocity = velocity.reshape(shape) * DAY_S / AU_KM
+        return position, velocity, None, None
