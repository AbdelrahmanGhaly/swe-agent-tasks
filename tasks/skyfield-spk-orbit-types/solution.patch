+def discrete_states_at(seconds, states, epochs, gm):
+    """Blend the two-body propagations of the states bracketing each time.
+
+    This is how SPICE evaluates an SPK type 5 segment: each time is
+    reached from the latest epoch before it and from the next epoch,
+    and the two results are mixed with a cosine weight.
+
+    """
+    count = len(epochs)
+    i = searchsorted(epochs, seconds)
+    before = clip(i - 1, 0, count - 1)
+    after = clip(i, 0, count - 1)
+    p1, v1 = _propagate_states(states, epochs, before, seconds, gm)
+    p2, v2 = _propagate_states(states, epochs, after, seconds, gm)
+
+    t1 = epochs[before]
+    span = epochs[after] - t1
+    alone = (span == 0.0)
+    span[alone] = 1.0
+    angle = pi * (seconds - t1) / span
+    w = where(alone, 1.0, 0.5 + 0.5 * cos(angle))
+    dw = where(alone, 0.0, -0.5 * pi / span * sin(angle))
+    position = w * p1 + (1.0 - w) * p2
+    velocity = w * v1 + (1.0 - w) * v2 + dw * (p1 - p2)
+    return position, velocity
+
+def _propagate_states(states, epochs, index, seconds, gm):
+    position = empty((3, len(seconds)))
+    velocity = empty((3, len(seconds)))
+    for j in unique(index):
+        chosen = (index == j)
+        position[:,chosen], velocity[:,chosen] = propagate(
+            states[j,:3], states[j,3:], epochs[j], seconds[chosen], gm)
+    return position, velocity
+
+def precessing_conic_at(seconds, record):
+    """Compute states from an SPK type 15 precessing conic record."""
+    epoch = record[0]
+    pole = record[1:4] / length_of(record[1:4])
+    periapsis = record[4:7] / length_of(record[4:7])
+    p, e, flag = record[7], record[8], int(record[9])
+    body_pole = record[10:13] / length_of(record[10:13])
+    gm, j2, radius = record[13:16]
+
+    near = p / (1.0 + e)
+    speed = sqrt(gm / p) * (1.0 + e)
+    dt = seconds - epoch
+    position, velocity = propagate(near * periapsis,
+                                   speed * _cross(pole, periapsis),
+                                   0.0, dt, gm)
+
+    if flag == 3 or j2 == 0.0 or e >= 1.0 or near <= radius:
+        return position, velocity
+
+    one_minus_e2 = 1.0 - e * e
+    mean_anomaly = one_minus_e2 / p * sqrt(gm * one_minus_e2 / p) * dt
+    theta = fmod(mean_anomaly, tau)
+    theta -= where(abs(theta) > pi, sign(theta) * tau, 0.0)
+    true_anomaly = angle_between(periapsis[:,newaxis], position)
+    true_anomaly = where(theta < 0.0, -true_anomaly, true_anomaly)
+    z = 1.5 * j2 * (radius / p) ** 2 * (true_anomaly + mean_anomaly - theta)
+    c = dots(body_pole, pole)
+
+    if flag != 1:
+        angle = z * (2.5 * c * c - 0.5)
+        position = _rotate(position, pole, angle)
+        velocity = _rotate(velocity, pole, angle)
+    if flag != 2:
+        angle = -z * c
+        position = _rotate(position, body_pole, angle)
+        velocity = _rotate(velocity, body_pole, angle)
+    return position, velocity
+
+def _rotate(vectors, axis, angle):
+    axis = axis[:,newaxis]
+    c = cos(angle)
+    return (vectors * c + _cross(axis, vectors) * sin(angle)
+            + axis * dots(axis, vectors) * (1.0 - c))
+
+def equinoctial_elements_at(seconds, record):
+    """Compute states from an SPK type 17 equinoctial elements record."""
+    epoch, a, h, k, mean_longitude, p, q = record[:7]
+    periapsis_rate, longitude_rate, node_rate, ra, dec = record[7:12]
+    dt = seconds - epoch
+
+    turn = periapsis_rate * dt
+    h, k = h * cos(turn) + k * sin(turn), k * cos(turn) - h * sin(turn)
+    turn = node_rate * dt
+    p, q = p * cos(turn) + q * sin(turn), q * cos(turn) - p * sin(turn)
+    L = mean_longitude + fmod(longitude_rate * dt, tau)
+
+    F = L
+    for _ in range(30):
+        cos_F = cos(F)
+        sin_F = sin(F)
+        step = (F + h * cos_F - k * sin_F - L) / (1.0 - h * sin_F - k * cos_F)
+        F = F - step
+        if abs(step).max() < 1e-15:
+            break
+    cos_F = cos(F)
+    sin_F = sin(F)
+
+    b = 1.0 / (1.0 + sqrt(1.0 - h * h - k * k))
+    x = a * ((1.0 - b * h * h) * cos_F + h * k * b * sin_F - k)
+    y = a * ((1.0 - b * k * k) * sin_F + h * k * b * cos_F - h)
+    rb = h * sin_F + k * cos_F
+    rate = (longitude_rate - periapsis_rate) * a / (1.0 - rb)
+    apsis_rate = periapsis_rate - node_rate
+    dx = rate * (h * b * rb - sin_F) - apsis_rate * y
+    dy = rate * (cos_F - k * b * rb) + apsis_rate * x
+
+    d = 1.0 / (1.0 + p * p + q * q)
+    f = array((1.0 - p * p + q * q, 2.0 * p * q, -2.0 * p)) * d
+    g = array((2.0 * p * q, 1.0 + p * p - q * q, 2.0 * q)) * d
+    position = x * f + y * g
+    velocity = dx * f + dy * g
+    velocity[0] -= node_rate * position[1]
+    velocity[1] += node_rate * position[0]
+
