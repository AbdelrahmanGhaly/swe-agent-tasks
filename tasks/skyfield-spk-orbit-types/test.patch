+import os
+
+import numpy as np
+from assay import assert_raises
+from skyfield.api import PlanetaryConstants, load, load_file
+from skyfield.constants import T0
+from skyfield.errors import EphemerisRangeError
+
+ts = load.timescale()
+_kernels = {}
+
+
+def _path(name):
+    return os.path.join(os.path.dirname(os.path.abspath(__file__)), 'data', name)
+
+
+def _orbits():
+    if 'orbits' not in _kernels:
+        _kernels['orbits'] = load_file(_path('spk-orbit-types.bsp'))
+    return _kernels['orbits']
+
+
+def _tdb(seconds):
+    days, rest = np.divmod(np.asarray(seconds, dtype=float), 86400.0)
+    return ts.tdb_jd(T0 + days, rest / 86400.0)
+
+
+def _target(name, target):
+    if name not in _kernels:
+        _kernels[name] = load_file(_path(name))
+    for segment in _kernels[name].segments:
+        if segment.target == target:
+            return segment
+
+
+def _invalid_segment(target):
+    if 'invalid' not in _kernels:
+        _kernels['invalid'] = load_file(_path('spk-invalid-orbits.bsp'))
+    for segment in _kernels['invalid'].segments:
+        if segment.target == target:
+            return segment
+
+
+def _segment(target, data_type):
+    for segment in _orbits().segments:
+        spk = segment.spk_segment
+        if spk.target == target and spk.data_type == data_type:
+            return segment
+
+
+def _assert_states(function, rows):
+    rows = np.array(rows)
+    position = function.at(_tdb(rows[:, 0]))
+    assert position.position.km.shape == (3, len(rows))
+    assert np.abs(position.position.km - rows[:, 1:4].T).max() < 1e-5
+    assert np.abs(position.velocity.km_per_s - rows[:, 4:7].T).max() < 1e-8
+
+
+def _assert_state(function, row):
+    position = function.at(_tdb(row[0]))
+    assert position.position.km.shape == (3,)
+    assert np.abs(position.position.km - row[1:4]).max() < 1e-5
+    assert np.abs(position.velocity.km_per_s - row[4:7]).max() < 1e-8
+
+
+def _moon_constants(*binary_paths):
+    pc = PlanetaryConstants()
+    pc.read_text(load('moon_080317.tf'))
+    pc.read_text(load('pck00008.tpc'))
+    for path in binary_paths:
+        pc.read_binary(load(path))
+    return pc
+
+
+def _assert_rotations(frame, rows):
+    t = _tdb([row[0] for row in rows])
+    R = frame.rotation_at(t)
+    assert R.shape == (3, 3, len(rows))
+    for i, row in enumerate(rows):
+        assert np.abs(R[:, :, i] - row[1]).max() < 1e-9
+
