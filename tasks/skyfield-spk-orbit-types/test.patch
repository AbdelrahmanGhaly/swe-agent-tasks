+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() { echo "usage: $0 [--output_path <path>] base|new" >&2; exit 2; }
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new) MODE="$1"; MODE_COUNT=$((MODE_COUNT + 1)); shift ;;
+    --output_path) shift; [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }; OUTPUT_PATH="$1"; shift ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    *) echo "unknown argument: $1" >&2; usage ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+[ -n "$OUTPUT_PATH" ] || OUTPUT_PATH="$(pwd)/test-results-$MODE.xml"
+case "$OUTPUT_PATH" in /*) ;; *) OUTPUT_PATH="$(pwd)/$OUTPUT_PATH" ;; esac
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+cd "$(dirname "$0")" || exit 1
+ROOT="$(pwd)"
+
+NEW_TESTS=("$ROOT/skyfield/tests/test_spk_orbits_e45f55.py")
+
+PYTEST=(python -m pytest -p no:cacheprovider -o addopts= -v --junitxml="$OUTPUT_PATH")
+
+LOG="$(mktemp 2>/dev/null || echo "$OUTPUT_PATH.log")"
+
+if [ "$MODE" = "new" ]; then
+  timeout 1800 "${PYTEST[@]}" "${NEW_TESTS[@]}" 2>&1 | tee "$LOG"
+  STATUS=${PIPESTATUS[0]}
+else
+  IGNORES=()
+  for t in "${NEW_TESTS[@]}"; do
+    IGNORES+=("--ignore=$t")
+  done
+  timeout 1800 "${PYTEST[@]}" "${IGNORES[@]}" "$ROOT/skyfield/tests" 2>&1 | tee "$LOG"
+  STATUS=${PIPESTATUS[0]}
+fi
+
+if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  DETAIL="$(tail -n 200 "$LOG" 2>/dev/null | LC_ALL=C tr -cd '\11\12\15\40-\176' | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+  cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="utf-8"?>
+<testsuites><testsuite name="pytest" tests="1" failures="1" errors="0" time="0">
+<testcase classname="test.sh" name="${MODE}_suite"><failure message="no test results">pytest exited with status ${STATUS} before reporting any test.
+${DETAIL}</failure></testcase>
+</testsuite></testsuites>
+XMLEOF
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+rm -f "$LOG"
+exit "$STATUS"
