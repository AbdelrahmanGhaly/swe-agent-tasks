+db = Database()
+
+
+class Basket(db.Entity):
+    code = Required(int)
+    items = Set("Item")
+
+
+class Item(db.Entity):
+    tag = Required(str)
+    basket = Required(Basket)
+    qty = Required(int)
+    step = Required(int)
+    ratio = Required(float)
+    factor = Required(float)
+    price = Required(Decimal)
+    scale = Required(float)
+    one = Required(float)
+    tenth = Required(float)
+    huge = Required(float)
+    active = Required(bool)
+    label = Required(str)
+    note = Optional(str)
+    wide = Required(int, size=64)
+
+
+ROWS = [
+    ("t1", 1, 7, 3, 2.5, 2.0, Decimal("10.5"), 2.25, 1.0, 0.1, 1e20, True, "abcabc",
+     "", -9223372036854775808),
+    ("t2", 1, -7, 3, -2.5, 2.0, Decimal("-10.5"), -2.25, -1.0, 0.1, -1e20, False, "aaa",
+     "x", 9223372036854775806),
+    ("t3", 2, 7, -3, 3.5, -2.0, Decimal("7.25"), 7.75, 2.5, 0.1, 1e19, True, "xyz",
+     "", -9223372036854775807),
+    ("t4", 2, -7, -3, -3.5, -2.0, Decimal("-7.25"), -7.75, -2.5, 0.1, -1e19, False, "ab",
+     "yy", 9223372036854775807),
+    ("t5", 3, 6, 3, 0.5, 4.0, Decimal("2.5"), 0.25, 3.0, 0.1, 9e18, True, "zzzz",
+     "", -1),
+    ("t6", 3, 0, 5, -0.5, 4.0, Decimal("-0.5"), -0.25, 0.0, 0.1, 0.0, False, "-42",
+     "z", 0),
+]
+
+
+def by_tag(rows):
+    return {tag: value for tag, value in rows}
+
+
+def types_by_tag(rows):
+    return {tag: type(value) for tag, value in rows}
+
+
+class TestPythonNumericSemantics(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        setup_database(db)
+        with db_session:
+            baskets = {code: Basket(code=code) for code in (1, 2, 3, 4)}
+            for row in ROWS:
+                Item(
+                    tag=row[0],
+                    basket=baskets[row[1]],
+                    qty=row[2],
+                    step=row[3],
+                    ratio=row[4],
+                    factor=row[5],
+                    price=row[6],
+                    scale=row[7],
+                    one=row[8],
+                    tenth=row[9],
+                    huge=row[10],
+                    active=row[11],
+                    label=row[12],
+                    note=row[13],
+                    wide=row[14],
+                )
+
+    @classmethod
+    def tearDownClass(cls):
+        teardown_database(db)
+
+    def setUp(self):
+        rollback()
+        db_session.__enter__()
+
+    def tearDown(self):
+        rollback()
+        db_session.__exit__()
+
+    def test_truediv_of_two_int_columns_keeps_the_fraction(self):
+        rows = select((i.tag, i.qty / i.step) for i in Item)[:]
+        self.assertEqual(
+            by_tag(rows),
+            {
+                "t1": 7 / 3,
+                "t2": -7 / 3,
+                "t3": 7 / -3,
+                "t4": -7 / -3,
+                "t5": 2.0,
+                "t6": 0.0,
+            },
+        )
+
