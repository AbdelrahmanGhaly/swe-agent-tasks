--- a/pony/orm/ormtypes.py
+++ b/pony/orm/ormtypes.py
@@ -286,6 +286,35 @@ def coerce_types(t1, t2):
     return result
 
 
+python_division_ops = {
+    ("/", float): "PY_TRUEDIV",
+    ("/", Decimal): "PY_DECIMAL_TRUEDIV",
+    ("//", int): "PY_FLOORDIV_INT",
+    ("//", float): "PY_FLOORDIV_REAL",
+    ("//", Decimal): "PY_DECIMAL_DIV",
+    ("%", int): "PY_MOD_INT",
+    ("%", float): "PY_MOD_REAL",
+    ("%", Decimal): "PY_DECIMAL_MOD",
+}
+
+
+def python_numeric_type(op, coerced_type):
+    if op not in ("/", "//", "%") or coerced_type not in numeric_types:
+        return coerced_type
+    if coerced_type is Decimal:
+        return Decimal
+    if op == "/":
+        return float
+    if coerced_type is bool:
+        return int
+    return coerced_type
+
+
+def python_numeric_binop(op, sqlop, coerced_type):
+    result_type = python_numeric_type(op, coerced_type)
+    return result_type, python_division_ops.get((op, result_type), sqlop)
+
+
 def are_comparable_types(t1, t2, op="=="):
     # types must be normalized already!
     tt1 = type(t1)
