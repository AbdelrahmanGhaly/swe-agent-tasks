+from decimal import Decimal
+import datetime
+
+import pytest
+
+from basana.backtesting import exchange, fees, liquidity, requests
+from basana.backtesting.lending import margin
+from basana.core import bar, dt, event, helpers
+from basana.core.enums import OrderOperation
+from basana.core.pair import Pair, PairInfo
+
+
+BTC_USD = Pair("BTC", "USD")
+ETH_USD = Pair("ETH", "USD")
+ETH_BTC = Pair("ETH", "BTC")
+ONE_DAY = datetime.timedelta(days=1)
+BUY = OrderOperation.BUY
+SELL = OrderOperation.SELL
+
+
+def day(number):
+    return dt.local_datetime(2000, 1, number)
+
+
+def bar_event(pair, number, open, close=None, low=None, high=None, volume=1000):
+    open = Decimal(open)
+    close = open if close is None else Decimal(close)
+    low = min(open, close) if low is None else Decimal(low)
+    high = max(open, close) if high is None else Decimal(high)
+    return bar.BarEvent(
+        day(number) + ONE_DAY, bar.Bar(day(number), pair, open, high, low, close, Decimal(volume), ONE_DAY)
+    )
+
+
+def bar_source(*bar_events):
+    source = event.FifoQueueEventSource()
+    for bar_event_ in bar_events:
+        source.push(bar_event_)
+    return source
+
+
+def margin_loans(margin_requirement="0.5", interest_symbol="USD", interest_percentage=0, **kwargs):
+    return margin.MarginLoans(
+        "USD", Decimal(margin_requirement),
+        default_conditions=margin.MarginLoanConditions(
+            interest_symbol=interest_symbol, interest_percentage=Decimal(interest_percentage),
+            interest_period=datetime.timedelta(days=4), min_interest=Decimal(0)
+        ),
+        **kwargs
+    )
+
+
+def build_exchange(
+        dispatcher, balances, lending_strategy, liquidity_strategy_factory=liquidity.InfiniteLiquidity,
+        fee_strategy=None, btc_usd_info=PairInfo(8, 2)
+):
+    ret = exchange.Exchange(
+        dispatcher, {symbol: Decimal(amount) for symbol, amount in balances.items()},
+        liquidity_strategy_factory=liquidity_strategy_factory, fee_strategy=fee_strategy or fees.NoFee(),
+        lending_strategy=lending_strategy
+    )
+    for symbol, precision in {"BTC": 8, "ETH": 8, "USD": 2}.items():
+        ret.set_symbol_precision(symbol, precision)
+    ret.set_pair_info(BTC_USD, btc_usd_info)
+    ret.set_pair_info(ETH_USD, PairInfo(8, 2))
+    ret.set_pair_info(ETH_BTC, PairInfo(8, 8))
+    return ret
+
+
+def run_actions(e, actions, pair=BTC_USD):
+    async def on_bar(bar_event_):
+        if action := actions.get(bar_event_.when):
+            await action()
+
+    e.subscribe_to_bar_events(pair, on_bar)
+
+
+class Recorder:
+    def __init__(self, e):
+        self.margin_calls = []
+        self.margin_call_types = []
+        self.order_events = []
+        e.subscribe_to_margin_call_events(self.on_margin_call)
+        e.subscribe_to_order_events(self.on_order_event)
+
+    async def on_margin_call(self, margin_call):
+        self.margin_call_types.append(type(margin_call).__name__)
+        self.margin_calls.append((margin_call.when, helpers.round_decimal(margin_call.margin_level, 2)))
+
+    async def on_order_event(self, order_event):
+        self.order_events.append(order_event.order)
+
+
+def rounded(value):
+    return helpers.round_decimal(value, 2)
+
+
+async def balance(e, symbol):
+    ret = await e.get_balance(symbol)
+    return ret.available, ret.hold, ret.borrowed
+
+
+async def only_liquidation(e):
+    liquidations = await e.get_liquidations()
+    assert len(liquidations) == 1
+    return liquidations[0]
+
+
+async def liquidation_orders(e, liquidation):
+    return [await e.get_order_info(order_id) for order_id in liquidation.order_ids]
+
+
+def open_long(e, created):
+    async def action():
+        created["entry"] = await e.create_market_order(BUY, BTC_USD, Decimal(2), auto_borrow=True)
+
+    return action
+
+
+def open_short(e, created, amount=Decimal(1)):
+    async def action():
+        created["entry"] = await e.create_market_order(SELL, BTC_USD, amount, auto_borrow=True)
+
+    return action
+
+
+def btc_bars(*bars):
+    return bar_source(
+        bar_event(BTC_USD, 1, 1000), bar_event(BTC_USD, 2, 1000),
+        *[bar_event(BTC_USD, number, *prices) for number, prices in enumerate(bars, start=3)]
+    )
+
+
+async def test_nothing_changes_without_margin_levels(backtesting_dispatcher):
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000}, margin_loans())
+    recorder = Recorder(e)
+    created = {}
+
+    async def place_exit():
+        created["exit"] = await e.create_limit_order(SELL, BTC_USD, Decimal(1), Decimal(2000))
+
+    async def after_crash():
+        created["late"] = await e.create_limit_order(SELL, BTC_USD, Decimal(1), Decimal(3000))
+
+    run_actions(e, {day(2): open_long(e, created), day(3): place_exit, day(4): after_crash})
+    e.add_bar_source(btc_bars((1000, 300), (300,)))
+    await backtesting_dispatcher.run()
+
+    assert await e.get_liquidations() == []
+    assert recorder.margin_calls == []
+    assert (await e.get_order_info(created["exit"].id)).is_open
+    assert (await e.get_order_info(created["late"].id)).is_open
+    assert len(await e.get_loans(is_open=True)) == 1
+    assert await balance(e, "BTC") == (0, 2, 0)
+    assert await balance(e, "USD") == (0, 0, 1000)
+
+
+async def test_levels_that_are_never_crossed_do_nothing(backtesting_dispatcher):
+    lending_strategy = margin_loans(margin_call_level=Decimal(75), liquidation_level=Decimal(40))
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000}, lending_strategy)
+    recorder = Recorder(e)
+    created = {}
+
+    async def place_exit():
+        created["exit"] = await e.create_limit_order(SELL, BTC_USD, Decimal(1), Decimal(2000))
+
+    run_actions(e, {day(2): open_long(e, created), day(3): place_exit})
+    e.add_bar_source(btc_bars((1000, 810), (900,)))
+    await backtesting_dispatcher.run()
+
+    assert await e.get_liquidations() == []
+    assert recorder.margin_calls == []
+    assert (await e.get_order_info(created["exit"].id)).is_open
+
+
+async def test_exchange_without_margin_loans_reports_no_liquidations(backtesting_dispatcher):
+    e = exchange.Exchange(backtesting_dispatcher, {"USD": Decimal(1000)})
+    e.add_bar_source(btc_bars((1000, 100)))
+    await backtesting_dispatcher.run()
+
+    assert await e.get_liquidations() == []
+
+
+async def test_margin_call_is_sent_once_while_level_stays_below(backtesting_dispatcher):
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000}, margin_loans(margin_call_level=Decimal(75)))
+    recorder = Recorder(e)
+    created = {}
+    run_actions(e, {day(2): open_long(e, created)})
+    e.add_bar_source(btc_bars((1000, 780), (760,), (700,)))
+    await backtesting_dispatcher.run()
+
+    assert recorder.margin_calls == [(day(4), Decimal("71.79"))]
+    assert recorder.margin_call_types == ["MarginCallEvent"]
+    assert await e.get_liquidations() == []
+    assert len(await e.get_loans(is_open=True)) == 1
+
+
+async def test_margin_call_needs_level_strictly_below_and_rearms_at_or_above(backtesting_dispatcher):
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000}, margin_loans(margin_call_level=Decimal(75)))
+    recorder = Recorder(e)
+    created = {}
+    run_actions(e, {day(2): open_long(e, created)})
+    e.add_bar_source(btc_bars((1000, 800), (780,), (800,), (780,), (770,)))
+    await backtesting_dispatcher.run()
+
+    assert recorder.margin_calls == [(day(5), Decimal("71.79")), (day(7), Decimal("71.79"))]
+
+
+def test_margin_levels_are_refused_unless_below_100():
+    for level in (Decimal("99.99"), Decimal(0), Decimal(-50)):
+        margin_loans(margin_call_level=level, liquidation_level=level)
+    for level in (Decimal(100), Decimal(150)):
+        with pytest.raises(Exception):
+            margin_loans(margin_call_level=level)
+        with pytest.raises(Exception):
+            margin_loans(liquidation_level=level)
+
+
+async def test_margin_call_level_of_zero_calls_once_the_margin_level_is_negative(backtesting_dispatcher):
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000}, margin_loans(margin_call_level=Decimal(0)))
+    recorder = Recorder(e)
+    created = {}
+    run_actions(e, {day(2): open_long(e, created)})
+    e.add_bar_source(btc_bars((1000, 550), (500,), (450,)))
+    await backtesting_dispatcher.run()
+
+    assert recorder.margin_calls == [(day(6), Decimal("-22.22"))]
+    assert await e.get_liquidations() == []
+
+
+async def test_liquidation_level_of_zero_liquidates_once_the_margin_level_is_negative(backtesting_dispatcher):
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000}, margin_loans(liquidation_level=Decimal(0)))
+    created = {}
+    run_actions(e, {day(2): open_long(e, created)})
+    e.add_bar_source(btc_bars((1000, 550), (500,), (450,)))
+    await backtesting_dispatcher.run()
+
+    liquidation = await only_liquidation(e)
+    assert liquidation.started_at == day(6)
+    assert rounded(liquidation.margin_level) == Decimal("-22.22")
+
+
+async def test_margin_call_carries_the_exact_margin_level(backtesting_dispatcher):
+    lending_strategy = margin_loans(margin_call_level=Decimal(75))
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000}, lending_strategy)
+    created = {}
+    received = []
+
+    async def on_margin_call(margin_call):
+        received.append((margin_call.margin_level, lending_strategy.margin_level))
+
+    e.subscribe_to_margin_call_events(on_margin_call)
+    run_actions(e, {day(2): open_long(e, created)})
+    e.add_bar_source(btc_bars((1000, 780), (760,)))
+    await backtesting_dispatcher.run()
+
+    [(carried, current)] = received
+    assert carried == current
+    assert rounded(carried) == Decimal("71.79")
+
+
+async def test_long_position_is_sold_on_the_bar_after_the_liquidation_starts(backtesting_dispatcher):
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000}, margin_loans(liquidation_level=Decimal(40)))
+    recorder = Recorder(e)
+    created = {}
+    run_actions(e, {day(2): open_long(e, created)})
+    e.add_bar_source(btc_bars((1000, 600), (610, 620), (650,)))
+    await backtesting_dispatcher.run()
+
+    liquidation = await only_liquidation(e)
+    assert liquidation.started_at == day(4)
+    assert liquidation.ended_at == day(5)
+    assert rounded(liquidation.margin_level) == Decimal("33.33")
+    assert liquidation.canceled_order_ids == []
+    assert liquidation.repaid_loan_ids == created["entry"].loan_ids
+
+    [order] = await liquidation_orders(e, liquidation)
+    assert order.operation == SELL
+    assert order.pair == BTC_USD
+    assert order.amount == Decimal(2)
+    assert order.amount_filled == Decimal(2)
+    assert order.is_open is False
+    assert order.fees == {}
+    assert [(fill.when, fill.price) for fill in order.fills] == [(day(4), Decimal(610))]
+    assert order.id in [order_info.id for order_info in await e.get_orders()]
+    reported = [
+        (order_info.is_open, order_info.amount_filled)
+        for order_info in recorder.order_events if order_info.id == order.id
+    ]
+    assert reported and reported[-1] == (False, Decimal(2))
+
+    assert await balance(e, "USD") == (220, 0, 0)
+    assert await balance(e, "BTC") == (0, 0, 0)
+    assert await e.get_loans(is_open=True) == []
+
+
+async def test_level_equal_to_liquidation_level_does_not_start_liquidation(backtesting_dispatcher):
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000}, margin_loans(liquidation_level=Decimal(40)))
+    created = {}
+    run_actions(e, {day(2): open_long(e, created)})
+    e.add_bar_source(btc_bars((1000, 625), (620,), (630,)))
+    await backtesting_dispatcher.run()
+
+    liquidation = await only_liquidation(e)
+    assert liquidation.started_at == day(5)
+    assert liquidation.ended_at == day(6)
+    assert rounded(liquidation.margin_level) == Decimal("38.71")
+    [order] = await liquidation_orders(e, liquidation)
+    assert order.fills[0].price == Decimal(630)
+    assert await balance(e, "USD") == (260, 0, 0)
+
+
+async def test_open_orders_on_every_pair_are_canceled_when_liquidation_starts(backtesting_dispatcher):
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000, "ETH": 1}, margin_loans(liquidation_level=Decimal(40)))
+    recorder = Recorder(e)
+    created = {}
+
+    async def place_exits():
+        created["btc_exit"] = await e.create_limit_order(SELL, BTC_USD, Decimal(1), Decimal(2000))
+        created["eth_exit"] = await e.create_limit_order(SELL, ETH_USD, Decimal(1), Decimal(500))
+
+    run_actions(e, {day(2): open_long(e, created), day(3): place_exits})
+    e.add_bar_source(bar_source(
+        bar_event(ETH_USD, 1, 100), bar_event(BTC_USD, 1, 1000),
+        bar_event(ETH_USD, 2, 100), bar_event(BTC_USD, 2, 1000),
+        bar_event(ETH_USD, 3, 100), bar_event(BTC_USD, 3, 1000, 550),
+        bar_event(ETH_USD, 4, 100), bar_event(BTC_USD, 4, 560),
+        bar_event(ETH_USD, 5, 100), bar_event(BTC_USD, 5, 600),
+    ))
+    await backtesting_dispatcher.run()
+
+    liquidation = await only_liquidation(e)
+    assert sorted(liquidation.canceled_order_ids) == sorted([created["btc_exit"].id, created["eth_exit"].id])
+    for key in ("btc_exit", "eth_exit"):
+        order = await e.get_order_info(created[key].id)
+        assert order.is_open is False
+        assert order.amount_filled == 0
+        assert (False, Decimal(0)) in [
+            (order_info.is_open, order_info.amount_filled)
+            for order_info in recorder.order_events if order_info.id == order.id
+        ]
+
+    orders = await liquidation_orders(e, liquidation)
+    assert [(order.pair, order.operation, order.amount_filled) for order in orders] == [
+        (ETH_USD, SELL, Decimal(1)), (BTC_USD, SELL, Decimal(2))
+    ]
+    assert liquidation.started_at == day(4)
+    assert liquidation.ended_at == day(5)
+    assert await balance(e, "USD") == (220, 0, 0)
+    assert await balance(e, "ETH") == (0, 0, 0)
+    assert await balance(e, "BTC") == (0, 0, 0)
+
+
+async def test_every_kind_of_open_order_is_canceled_keeping_its_fills(backtesting_dispatcher):
+    e = build_exchange(
+        backtesting_dispatcher, {"USD": 1000}, margin_loans(liquidation_level=Decimal(50)),
+        liquidity_strategy_factory=lambda: liquidity.VolumeShareImpact(price_impact=Decimal(0))
+    )
+    created = {}
+
+    async def place_exits():
+        created["limit"] = await e.create_limit_order(SELL, BTC_USD, Decimal(1), Decimal(1000))
+        created["stop"] = await e.create_stop_order(SELL, BTC_USD, Decimal("0.5"), Decimal(300))
+        created["stop_limit"] = await e.create_stop_limit_order(
+            SELL, BTC_USD, Decimal("0.5"), Decimal(300), Decimal(290)
+        )
+
+    run_actions(e, {day(2): open_long(e, created), day(3): place_exits})
+    e.add_bar_source(btc_bars((1000, 550, None, None, 2), (560,), (570,)))
+    await backtesting_dispatcher.run()
+
+    liquidation = await only_liquidation(e)
+    assert liquidation.started_at == day(4)
+    assert liquidation.ended_at == day(5)
+    assert sorted(liquidation.canceled_order_ids) == sorted(
+        created[key].id for key in ("limit", "stop", "stop_limit")
+    )
+    limit = await e.get_order_info(created["limit"].id)
+    assert (limit.is_open, limit.amount_filled) == (False, Decimal("0.5"))
+    assert [fill.price for fill in limit.fills] == [Decimal(1000)]
+    for key in ("stop", "stop_limit"):
+        order = await e.get_order_info(created[key].id)
+        assert (order.is_open, order.amount_filled) == (False, Decimal(0))
+    [order] = await liquidation_orders(e, liquidation)
+    assert (order.operation, order.amount_filled, order.fills[0].price) == (SELL, Decimal("1.5"), Decimal(560))
+    assert await balance(e, "USD") == (340, 0, 0)
+    assert await balance(e, "BTC") == (0, 0, 0)
+
+
+async def test_pairs_not_quoted_in_the_quote_symbol_are_not_traded(backtesting_dispatcher):
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000, "ETH": 1}, margin_loans(liquidation_level=Decimal(40)))
+    created = {}
+    run_actions(e, {day(2): open_long(e, created)})
+    e.add_bar_source(bar_source(
+        bar_event(ETH_BTC, 1, "0.1"), bar_event(ETH_USD, 1, 100), bar_event(BTC_USD, 1, 1000),
+        bar_event(ETH_BTC, 2, "0.1"), bar_event(ETH_USD, 2, 100), bar_event(BTC_USD, 2, 1000),
+        bar_event(ETH_BTC, 3, "0.1"), bar_event(ETH_USD, 3, 100), bar_event(BTC_USD, 3, 1000, 550),
+        bar_event(ETH_BTC, 4, "0.1"), bar_event(ETH_USD, 4, 100), bar_event(BTC_USD, 4, 560),
+        bar_event(ETH_BTC, 5, "0.1"), bar_event(ETH_USD, 5, 100), bar_event(BTC_USD, 5, 600),
+    ))
+    await backtesting_dispatcher.run()
+
+    liquidation = await only_liquidation(e)
+    assert liquidation.started_at == day(4)
+    assert liquidation.ended_at == day(5)
+    orders = await liquidation_orders(e, liquidation)
+    assert [(order.pair, order.operation, order.amount_filled) for order in orders] == [
+        (ETH_USD, SELL, Decimal(1)), (BTC_USD, SELL, Decimal(2))
+    ]
+    assert await balance(e, "USD") == (220, 0, 0)
+    assert await balance(e, "ETH") == (0, 0, 0)
+    assert await balance(e, "BTC") == (0, 0, 0)
+
+
+async def test_orders_and_loans_are_rejected_until_liquidation_ends(backtesting_dispatcher):
+    e = build_exchange(
+        backtesting_dispatcher, {"USD": 1000}, margin_loans(liquidation_level=Decimal(40)),
+        liquidity_strategy_factory=lambda: liquidity.VolumeShareImpact(price_impact=Decimal(0))
+    )
+    created = {}
+    rejected = []
+
+    async def try_everything():
+        attempts = [
+            e.create_limit_order(BUY, BTC_USD, Decimal("0.1"), Decimal(100)),
+            e.create_market_order(SELL, BTC_USD, Decimal("0.1")),
+            e.create_stop_order(BUY, BTC_USD, Decimal("0.1"), Decimal(900)),
+            e.create_stop_limit_order(BUY, BTC_USD, Decimal("0.1"), Decimal(900), Decimal(910)),
