+        )
+        created["loan"] = await e.create_loan("USD", Decimal(10))
+
+    run_actions(e, {
+        day(2): open_long(e, created), day(4): try_everything, day(5): try_everything, day(6): after_end
+    })
+    e.add_bar_source(btc_bars((1000, 600), (600, 600, None, None, 4), (620, 620, None, None, 6), (620,)))
