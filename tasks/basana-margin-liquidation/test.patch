+async def test_a_margin_call_reaches_its_handler_before_the_bars_of_that_timestamp(backtesting_dispatcher):
+    e = build_exchange(backtesting_dispatcher, {"USD": 1000}, margin_loans(margin_call_level=Decimal(75)))
+    created = {}
+    calls = []
+    seen = []
+
+    async def on_margin_call(margin_call):
+        calls.append(margin_call.when)
+
+    async def on_bar(bar_event_):
+        seen.append((bar_event_.when, list(calls)))
+
+    e.subscribe_to_margin_call_events(on_margin_call)
+    e.subscribe_to_bar_events(BTC_USD, on_bar)
+    run_actions(e, {day(2): open_long(e, created)})
+    e.add_bar_source(btc_bars((1000, 780), (760,)))
+    await backtesting_dispatcher.run()
+
+    assert calls == [day(4)]
+    assert seen == [(day(2), []), (day(3), []), (day(4), [day(4)]), (day(5), [day(4)])]
