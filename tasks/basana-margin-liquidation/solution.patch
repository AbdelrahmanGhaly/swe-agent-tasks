+
+from decimal import Decimal
+from typing import Any, Awaitable, Callable, List, Optional, cast
+import dataclasses
+import datetime
+import decimal
+import logging
+import uuid
+
+from basana.backtesting import account_balances, config, errors, helpers, loan_mgr, order_mgr, orders
+from basana.backtesting.lending import margin
+from basana.backtesting.value_map import ValueMap
+from basana.core import dispatcher, helpers as core_helpers, logs
+from basana.core.bar import Bar, BarEvent
+from basana.core.enums import OrderOperation
+from basana.core.pair import PairInfo
+import basana as bs
+
+
+logger = logging.getLogger(__name__)
+
+MarginCallEventHandler = Callable[["MarginCallEvent"], Awaitable[Any]]
+MARGIN_CALL_PRIORITY = order_mgr.ORDER_UPDATE_PRIORITY + 1
+MAX_SIZING_STEPS = 128
+
+
+class MarginCallEvent(bs.Event):
+    """
+    An event for margin calls.
+    """
+
+    def __init__(self, when: datetime.datetime, margin_level: Decimal):
+        super().__init__(when)
+        #: The margin level that triggered the margin call.
+        self.margin_level: Decimal = margin_level
+
+
+@dataclasses.dataclass
+class LiquidationInfo:
+    #: When the liquidation started.
+    started_at: datetime.datetime
+    #: The margin level that triggered the liquidation.
+    margin_level: Decimal
+    #: When the liquidation ended, or None if it is still in progress.
+    ended_at: Optional[datetime.datetime] = None
+    #: The ids of the orders that were canceled when the liquidation started.
+    canceled_order_ids: List[str] = dataclasses.field(default_factory=list)
+    #: The ids of the orders placed by the liquidation.
+    order_ids: List[str] = dataclasses.field(default_factory=list)
+    #: The ids of the loans repaid by the liquidation.
+    repaid_loan_ids: List[str] = dataclasses.field(default_factory=list)
+
+
+@dataclasses.dataclass
+class ExchangeContext:
+    dispatcher: dispatcher.BacktestingDispatcher
+    account_balances: account_balances.AccountBalances
+    config: config.Config
+    loan_mgr: loan_mgr.LoanManager
+    order_mgr: order_mgr.OrderManager
+
+
+class Liquidator:
+    """
+    Issues margin calls and liquidates the account when the margin level gets too low.
+
+    :param exchange_ctx: The exchange context that provides access to balances, loans, orders, etc.
+    :param margin_loans: The margin lending strategy, or None if the exchange is not lending on margin.
+    """
+
+    def __init__(self, exchange_ctx: ExchangeContext, margin_loans: Optional[margin.MarginLoans]):
+        self._ctx = exchange_ctx
+        self._margin_loans = margin_loans
+        self._liquidations: List[LiquidationInfo] = []
+        self._margin_call_at: Optional[datetime.datetime] = None
+        self._check_scheduled_at: Optional[datetime.datetime] = None
+        self._margin_calls = core_helpers.LazyProxy(lambda: bs.FifoQueueEventSource(priority=MARGIN_CALL_PRIORITY))
+
+    @property
+    def in_progress(self) -> bool:
+        return bool(self._liquidations) and self._liquidations[-1].ended_at is None
+
+    def get_liquidations(self) -> List[LiquidationInfo]:
+        return [
+            dataclasses.replace(
+                liquidation, canceled_order_ids=list(liquidation.canceled_order_ids),
+                order_ids=list(liquidation.order_ids), repaid_loan_ids=list(liquidation.repaid_loan_ids)
+            )
+            for liquidation in self._liquidations
+        ]
+
+    def subscribe_to_margin_call_events(self, event_handler: MarginCallEventHandler):
+        self._ctx.dispatcher.subscribe(self._margin_calls.obj, cast(dispatcher.EventHandler, event_handler))
+
+    def on_bar_event(self, bar_event: BarEvent):
+        # This should be called once the orders for the bar have been processed.
+        margin_loans = self._margin_loans
+        if margin_loans is None or (margin_loans.margin_call_level is None and margin_loans.liquidation_level is None):
+            return
+
+        # Nothing is traded or repaid once the account owes nothing; the liquidation ends at the next check.
+        if self.in_progress and self._ctx.loan_mgr.get_loans(is_open=True):
+            liquidation = self._liquidations[-1]
+            if order := self._build_order(bar_event.bar, margin_loans):
+                self._ctx.order_mgr.execute_order(order, bar_event.bar)
+                liquidation.order_ids.append(order.id)
+            liquidation.repaid_loan_ids.extend(self._repay_loans())
+
+        # Scheduled jobs run once every event for the current time has been dispatched, so the margin level gets
+        # checked after all the bars sharing this timestamp were processed, and before they get forwarded.
+        now = self._ctx.dispatcher.now()
+        if self._check_scheduled_at != now:
+            self._check_scheduled_at = now
+            self._ctx.dispatcher.schedule(now, self._on_check_scheduled)
+
+    async def _on_check_scheduled(self):
+        assert self._margin_loans is not None
+        self._check_margin_level(self._margin_loans)
+
+    def _check_margin_level(self, margin_loans: margin.MarginLoans):
+        now = self._ctx.dispatcher.now()
+        margin_level = margin_loans.margin_level
+
+        # A single margin call is issued until the margin level recovers.
+        margin_call_level = margin_loans.margin_call_level
+        if margin_call_level is not None:
+            if margin_level >= margin_call_level:
+                self._margin_call_at = None
+            elif self._margin_call_at is None:
+                self._margin_call_at = now
+                logger.debug(logs.StructuredMessage("Margin call", margin_level=margin_level))
+                if self._margin_calls.initialized:
+                    self._margin_calls.push(MarginCallEvent(now, margin_level))
+
+        if self.in_progress:
+            if margin_level >= margin.MIN_MARGIN_LEVEL or not self._ctx.loan_mgr.get_loans(is_open=True):
+                logger.debug(logs.StructuredMessage("Liquidation finished", margin_level=margin_level))
+                self._liquidations[-1].ended_at = now
+        elif self._should_liquidate(margin_loans, margin_level, now):
+            logger.debug(logs.StructuredMessage("Liquidation started", margin_level=margin_level))
+            canceled_order_ids = self._ctx.order_mgr.cancel_open_orders()
+            self._liquidations.append(
+                LiquidationInfo(started_at=now, margin_level=margin_level, canceled_order_ids=canceled_order_ids)
+            )
+
+    def _should_liquidate(
+            self, margin_loans: margin.MarginLoans, margin_level: Decimal, now: datetime.datetime
+    ) -> bool:
+        liquidation_level = margin_loans.liquidation_level
+        if liquidation_level is not None and margin_level < liquidation_level:
+            return True
+        # A margin call that was not met in time also leads to a liquidation.
+        timeout = margin_loans.margin_call_timeout
+        return timeout is not None and self._margin_call_at is not None and now - self._margin_call_at >= timeout
+
+    def _build_order(self, bar: Bar, margin_loans: margin.MarginLoans) -> Optional[orders.Order]:
+        pair = bar.pair
+        if pair.quote_symbol != margin_loans.quote_symbol:
+            return None
+
+        pair_info = self._ctx.config.get_pair_info(pair)
+        liquidity_strategy = self._ctx.order_mgr.get_liquidity_strategy(pair)
+        owed = self._get_owed_balances().get(pair.base_symbol, Decimal(0))
+        available = self._ctx.account_balances.get_available_balance(pair.base_symbol)
+
+        # Buy what is missing to repay what is owed in the base symbol, or sell whatever is not needed for that.
+        if owed > available:
+            operation = OrderOperation.BUY
+            amount = self._calculate_buy_amount(bar, pair_info, owed - available, margin_loans)
+        else:
+            operation = OrderOperation.SELL
+            amount = available - owed
+        amount = pair_info.truncate_base(min(amount, liquidity_strategy.available_liquidity))
+        if amount:
+            amount = self._calculate_feasible_amount(bar, pair_info, operation, amount, available - owed, margin_loans)
+        if not amount:
+            return None
+        # Orders whose quote amount rounds to zero can't be filled, and the fill uses the slipped price.
+        probe = self._build_probe_order(bar, pair_info, operation, amount, margin_loans)
+        if not pair_info.round_quote(orders.slipped_price(bar.open, amount, probe, liquidity_strategy) * amount):
+            return None
+
+        return orders.LiquidationOrder(
+            uuid.uuid4().hex, operation, pair, pair_info, amount, margin_loans.liquidation_fee
+        )
+
+    def _calculate_buy_amount(
+            self, bar: Bar, pair_info: PairInfo, shortfall: Decimal, margin_loans: margin.MarginLoans
+    ) -> Decimal:
+        # Fees charged in the base symbol reduce the amount received, so we may need to buy a bit more.
+        amount = pair_info.round_base(shortfall, rounding=decimal.ROUND_UP)
+        for _ in range(MAX_SIZING_STEPS):
+            order = self._build_probe_order(bar, pair_info, OrderOperation.BUY, amount, margin_loans)
+            received = self._estimate_fill(order, bar.open)[bar.pair.base_symbol]
+            if received >= shortfall:
+                break
+            amount = pair_info.round_base(amount + shortfall - received, rounding=decimal.ROUND_UP)
+        return amount
+
+    def _calculate_feasible_amount(
+            self, bar: Bar, pair_info: PairInfo, operation: OrderOperation, amount: Decimal, excess: Decimal,
+            margin_loans: margin.MarginLoans
+    ) -> Decimal:
+        base_available = self._ctx.account_balances.get_available_balance(bar.pair.base_symbol)
+        quote_available = self._ctx.account_balances.get_available_balance(bar.pair.quote_symbol)
+        liquidity_strategy = self._ctx.order_mgr.get_liquidity_strategy(bar.pair)
+
+        # The account has to be able to pay for the trade, slippage and fees included: no balance the fill touches
+        # can end up negative, and fees charged in the base symbol for selling come out of what is not owed.
+        def is_feasible(amount: Decimal) -> bool:
+            order = self._build_probe_order(bar, pair_info, operation, amount, margin_loans)
+            price = orders.slipped_price(bar.open, amount, order, liquidity_strategy)
+            updates = self._estimate_fill(order, price)
+            if quote_available + updates.get(bar.pair.quote_symbol, Decimal(0)) < 0:
+                return False
+            base_update = updates.get(bar.pair.base_symbol, Decimal(0))
+            if base_available + base_update < 0:
+                return False
+            return operation == OrderOperation.BUY or -base_update <= excess
+
+        # If the whole amount is not feasible, we look for the largest amount that is.
+        if is_feasible(amount):
+            return amount
+        # Precision modes like significant digits have no smallest positive amount, so the steps are bounded.
+        low, high = Decimal(0), amount
+        for _ in range(MAX_SIZING_STEPS):
+            mid = pair_info.truncate_base((low + high) / Decimal(2))
+            if mid <= low:
+                break
+            if is_feasible(mid):
+                low = mid
+            else:
+                high = mid
+        return low
+
+    def _build_probe_order(
+            self, bar: Bar, pair_info: PairInfo, operation: OrderOperation, amount: Decimal,
+            margin_loans: margin.MarginLoans
+    ) -> orders.LiquidationOrder:
+        return orders.LiquidationOrder("", operation, bar.pair, pair_info, amount, margin_loans.liquidation_fee)
+
+    def _estimate_fill(self, order: orders.Order, price: Decimal) -> ValueMap:
+        # Balance updates for filling the order at the given price, including fees.
+        base_sign = helpers.get_base_sign_for_operation(order.operation)
+        balance_updates = ValueMap({
+            order.pair.base_symbol: order.amount * base_sign,
+            order.pair.quote_symbol: order.pair_info.round_quote(price * order.amount * -base_sign),
+        })
+        balance_updates.prune()
+        return balance_updates + self._ctx.order_mgr.calculate_fees(order, balance_updates)
+
+    def _get_owed_balances(self) -> ValueMap:
+        ret = ValueMap()
+        for loan in self._ctx.loan_mgr.get_loans(is_open=True):
+            ret += {loan.borrowed_symbol: loan.borrowed_amount}
+            ret += loan.outstanding_interest
+        return ret
+
+    def _repay_loans(self) -> List[str]:
+        # Loans are repaid in the order they were taken out, skipping the ones that can't be repaid in full.
+        ret = []
+        for loan in self._ctx.loan_mgr.get_loans(is_open=True):
+            try:
+                self._ctx.loan_mgr.repay_loan(loan.id)
+                ret.append(loan.id)
+            except errors.NotEnoughBalance:
+                pass
+        return ret
