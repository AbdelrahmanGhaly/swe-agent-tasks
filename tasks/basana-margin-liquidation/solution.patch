+class LiquidationOrder(MarketOrder):
+    def __init__(
+            self, id: str, operation: OrderOperation, pair: Pair, pair_info: PairInfo,
+            amount: Decimal, fee_percentage: Decimal
+    ):
+        super().__init__(id, operation, pair, pair_info, amount)
+        self._fee_percentage = fee_percentage
+
+    def calculate_additional_fees(self, balance_updates: Dict[str, Decimal]) -> Dict[str, Decimal]:
+        # The liquidation fee is charged in quote currency.
+        ret = {}
+        quote_amount = abs(balance_updates.get(self.pair.quote_symbol, Decimal(0)))
+        if fee := quote_amount * self._fee_percentage / Decimal(100):
+            ret[self.pair.quote_symbol] = -fee
+        return ret
