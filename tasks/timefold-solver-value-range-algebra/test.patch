+@PlanningEntity
+public class TestdataComposedListEntity {
+
+    private String code;
+    private List<TestdataComposedListValue> allowedValueList;
+    private List<TestdataComposedListValue> forbiddenValueList;
+    private List<TestdataComposedListValue> valueList;
