+class ComposedValueRangeSolverAa92bcTest {
+
+    @Test
+    void solvesWithComposedRangeOnSolution() {
+        var solverConfig = PlannerTestUtils.buildSolverConfig(TestdataComposedRangeSolution.class,
+                TestdataComposedRangeEntity.class).withRandomSeed(0L);
+        var solution = new TestdataComposedRangeSolution(List.of(new TestdataComposedRangeEntity("e1"),
+                new TestdataComposedRangeEntity("e2"), new TestdataComposedRangeEntity("e3"),
+                new TestdataComposedRangeEntity("e4"), new TestdataComposedRangeEntity("e5")));
+        solution = PlannerTestUtils.solve(solverConfig, solution);
+        assertThat(solution.getScore()).isNotNull();
+        for (var entity : solution.getEntityList()) {
+            assertThat(entity.getValue()).isIn(0, 1, 2, 10, 11);
+        }
+    }
+
+    @Test
+    void countsComposedValuesOnSolution() {
+        var solutionDescriptor = TestdataComposedRangeSolution.buildSolutionDescriptor();
+        var valueRangeDescriptor = solutionDescriptor.findEntityDescriptorOrFail(TestdataComposedRangeEntity.class)
+                .getGenuineVariableDescriptor("value").getValueRangeDescriptor();
+        var solution = new TestdataComposedRangeSolution(List.of(new TestdataComposedRangeEntity("e1"),
+                new TestdataComposedRangeEntity("e2")));
+        var valueRangeManager = ValueRangeManager.of(solutionDescriptor, solution);
+        assertThat(valueRangeManager.countOnSolution(valueRangeDescriptor, solution)).isEqualTo(5L);
+        assertThat(valueRangeManager.getProblemSizeStatistics().approximateValueCount()).isEqualTo(5L);
+        var valueRange = valueRangeManager.<Integer> getFromSolution(valueRangeDescriptor);
+        assertThat(valueRange.getSize()).isEqualTo(5L);
+        assertAllElementsOfIterator(valueRange.createOriginalIterator(), 0, 1, 2, 10, 11);
+    }
+
+    @Test
+    void solvesWithComposedRangeOnEntity() {
+        var solverConfig = PlannerTestUtils.buildSolverConfig(TestdataComposedEntityRangeSolution.class,
+                TestdataComposedEntityRangeEntity.class).withRandomSeed(0L);
+        var solution = new TestdataComposedEntityRangeSolution(List.of(
+                new TestdataComposedEntityRangeEntity("e1", List.of(50, 3, 200)),
+                new TestdataComposedEntityRangeEntity("e2", List.of(7, 3, 7)),
+                new TestdataComposedEntityRangeEntity("e3", List.of(99, -1))));
+        solution = PlannerTestUtils.solve(solverConfig, solution);
+        assertThat(solution.getScore()).isNotNull();
+        var entityList = solution.getEntityList();
+        assertThat(entityList.get(0).getValue()).isIn(3, 50);
+        assertThat(entityList.get(1).getValue()).isIn(3, 7);
+        assertThat(entityList.get(2).getValue()).isEqualTo(99);
+    }
+
+    @Test
+    void countsComposedValuesOnEntity() {
+        var solutionDescriptor = TestdataComposedEntityRangeSolution.buildSolutionDescriptor();
+        var valueRangeDescriptor = solutionDescriptor
+                .findEntityDescriptorOrFail(TestdataComposedEntityRangeEntity.class)
+                .getGenuineVariableDescriptor("value").getValueRangeDescriptor();
+        var first = new TestdataComposedEntityRangeEntity("e1", List.of(50, 3, 200));
+        var second = new TestdataComposedEntityRangeEntity("e2", List.of(7, 3, 7));
+        var solution = new TestdataComposedEntityRangeSolution(List.of(first, second));
+        var valueRangeManager = ValueRangeManager.of(solutionDescriptor, solution);
+        assertThat(valueRangeManager.countOnEntity(valueRangeDescriptor, first)).isEqualTo(2L);
+        assertThat(valueRangeManager.countOnEntity(valueRangeDescriptor, second)).isEqualTo(2L);
+        var firstRange = valueRangeManager.<TestdataComposedEntityRangeEntity, Integer> getFromEntity(
