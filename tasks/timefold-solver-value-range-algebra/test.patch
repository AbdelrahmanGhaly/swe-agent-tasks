+            List<TestdataComposedListValue> forbiddenValueList) {
+        this.code = code;
+        this.allowedValueList = allowedValueList;
+        this.forbiddenValueList = forbiddenValueList;
+        this.valueList = new ArrayList<>();
+    }
+
+    public String getCode() {
+        return code;
+    }
+
+    public List<TestdataComposedListValue> getAllowedValueList() {
+        return allowedValueList;
+    }
+
+    public void setAllowedValueList(List<TestdataComposedListValue> allowedValueList) {
+        this.allowedValueList = allowedValueList;
+    }
+
+    public List<TestdataComposedListValue> getForbiddenValueList() {
+        return forbiddenValueList;
+    }
+
+    public void setForbiddenValueList(List<TestdataComposedListValue> forbiddenValueList) {
+        this.forbiddenValueList = forbiddenValueList;
+    }
+
+    @PlanningListVariable(valueRangeProviderRefs = "valueRange")
+    public List<TestdataComposedListValue> getValueList() {
+        return valueList;
+    }
+
+    public void setValueList(List<TestdataComposedListValue> valueList) {
+        this.valueList = valueList;
+    }
+
+    @ValueRangeProvider(id = "valueRange")
+    public ValueRange<TestdataComposedListValue> getValueRange(TestdataComposedListSolution solution) {
+        var allValues = ValueRangeFactory.createCollectionValueRange(solution.getValueList());
+        if (allowedValueList != null) {
+            return ValueRangeFactory.createIntersectionValueRange(allValues,
+                    ValueRangeFactory.createCollectionValueRange(allowedValueList));
+        }
+        return ValueRangeFactory.createDifferenceValueRange(allValues,
+                ValueRangeFactory.createCollectionValueRange(forbiddenValueList));
+    }
+
+    @Override
+    public String toString() {
+        return code;
+    }
+
