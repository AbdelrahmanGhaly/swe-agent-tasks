+    @Test
+    void compositionsWithSameMembersAreEqual() {
+        assertThat(union(ints(0, 3), list(5))).isEqualTo(union(ints(0, 3), list(5)));
+        assertThat(union(ints(0, 3), list(5))).hasSameHashCodeAs(union(ints(0, 3), list(5)));
+        assertThat(intersection(ints(0, 3), ints(1, 4))).isEqualTo(intersection(ints(0, 3), ints(1, 4)));
+        assertThat(difference(ints(0, 3), ints(1, 4))).isEqualTo(difference(ints(0, 3), ints(1, 4)));
