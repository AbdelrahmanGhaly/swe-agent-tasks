diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000000..257b0dc4e9
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,170 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+cd "$(dirname "$0")"
+
+NEW_TESTS="ValueRangeCompositionAa92bcTest,ComposedValueRangeSolverAa92bcTest"
+NEW_TEST_CLASS_FILES=(
+  core/src/test/java/ai/timefold/solver/core/impl/domain/valuerange/ValueRangeCompositionAa92bcTest.java
+  core/src/test/java/ai/timefold/solver/core/api/domain/valuerange/ComposedValueRangeSolverAa92bcTest.java
+)
+NEW_TEST_SOURCES=(
+  core/src/test/java/ai/timefold/solver/core/impl/domain/valuerange/ValueRangeCompositionAa92bcTest.java
+  core/src/test/java/ai/timefold/solver/core/api/domain/valuerange/ComposedValueRangeSolverAa92bcTest.java
+  core/src/test/java/ai/timefold/solver/core/testdomain/valuerange/composition
+)
+REPORT_DIR="core/target/surefire-reports"
+rm -rf "$REPORT_DIR"
+
+# Base mode measures the existing suite only; the new test sources are set aside so they do not take part in test compilation.
+STASH_DIR=""
+restore_new_test_sources() {
+  if [ -n "$STASH_DIR" ]; then
+    for p in "${NEW_TEST_SOURCES[@]}"; do
+      if [ -e "$STASH_DIR/$p" ]; then
+        mkdir -p "$(dirname "$p")"
+        mv "$STASH_DIR/$p" "$p"
+      fi
+    done
+    rm -rf "$STASH_DIR"
+    STASH_DIR=""
+  fi
+}
+trap restore_new_test_sources EXIT
+if [ "$MODE" != "new" ]; then
+  STASH_DIR="$(mktemp -d)"
+  for p in "${NEW_TEST_SOURCES[@]}"; do
+    if [ -e "$p" ]; then
+      mkdir -p "$STASH_DIR/$(dirname "$p")"
+      mv "$p" "$STASH_DIR/$p"
+    fi
+  done
+fi
+
+# core/src/test/resources/junit-platform.properties enables JUnit parallel execution with
+# "dynamic.factor = 0.75", so the thread count follows the host's CPU count. Pinning execution to a single
+# thread keeps these runs reproducible from machine to machine, and costs nothing on this module.
+# Base mode runs the value-range subsystem: every existing test for the packages this change touches
+# (ValueRangeFactory, the sealed range base and the int/long/BigInteger/BigDecimal ranges), plus the
+# ValueRangeManager, ProblemSizeStatistics and ReachableValues tests that consume value ranges. Those are the
+# tests that can regress because of this change, and they pass identically before and after it.
+#
+# The remainder of the module's suite is not run here because it does not pass reliably on this commit
+# outside this image: a large part of it reports errors on the base repository, before this change is
+# applied at all, and none of those tests touch value ranges.
+# The two TemporalValueRangeTest methods and ReachableValuesTest below are left out: they build Mockito
+# mocks, and core/src/test/resources/mockito-extensions/org.mockito.plugins.MockMaker selects
+# "mock-maker-inline", which has to attach an instrumentation agent to the running JVM. That attachment
+# is refused on hardened container runtimes, so these error on the base repository before this change is
+# applied. The JVM flags above ask for the attachment to be permitted; these few are dropped so the
+# baseline is green even where the runtime still refuses it. Neither class covers code this change
+# touches, and the remaining TemporalValueRangeTest methods still run.
+BASE_TESTS="AnonymousValueRangeFactoryTest,BigDecimalValueRangeTest,BigIntegerValueRangeTest,BooleanValueRangeTest,CompositeValueRangeTest,EmptyValueRangeTest,IntValueRangeTest,ListValueRangeTest,LongValueRangeTest,NullAllowingValueRangeTest,SetValueRangeTest,TemporalValueRangeTest,ValueRangeFactoryTest,ValueRangeManagerTest,ProblemSizeStatisticsTest,!TemporalValueRangeTest#incrementUnitTypeNotSupportedByFrom,!TemporalValueRangeTest#incrementUnitTypeNotSupportedByTo"
+
+MVN_ARGS=(-B -o -Dmaven.repo.local=/opt/m2 -Dspotless.skip=true -Denforcer.skip=true -Djacoco.skip=true
+  -Dmaven.gitcommitid.skip=true
+  -DargLine="-XX:+EnableDynamicAgentLoading -Djdk.attach.allowAttachSelf=true -Djunit.jupiter.execution.parallel.enabled=false"
+  -Dmaven.test.failure.ignore=true -Dsurefire.failIfNoSpecifiedTests=false -Dsurefire.printSummary=true -pl core clean test)
+
+MVN_LOG="$(mktemp)"
+if [ "$MODE" = "new" ]; then
+  mvn "${MVN_ARGS[@]}" -Dtest="$NEW_TESTS" 2>&1 | tee "$MVN_LOG"
+else
+  mvn "${MVN_ARGS[@]}" -Dtest="$BASE_TESTS" 2>&1 | tee "$MVN_LOG"
+fi
+MVN_EXIT=${PIPESTATUS[0]}
+
+write_report() {
+  local target="$1"
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo '<testsuites>'
+    for f in "$REPORT_DIR"/TEST-*.xml; do
+      [ -f "$f" ] || continue
+      sed -e '1{/^<?xml/d;}' "$f"
+    done
+    echo '</testsuites>'
+  } > "$target"
+}
+
+# When the new tests cannot compile, Surefire writes no report at all. Name every new test as a failure here
+# instead of inventing a synthetic one, so the run reports exactly the tests the new set is made of.
+write_failure_report() {
+  local target="$1"
+  local total=0
+  local log="${2:-}"
+  BUILD_DIAGNOSTIC="The Maven build produced no test reports."
+  if [ -n "$log" ] && [ -f "$log" ]; then
+    captured=$(grep -E '^\[ERROR\]' "$log" | head -40 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
+    if [ -n "$captured" ]; then
+      BUILD_DIAGNOSTIC="$captured"
+    fi
+  fi
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo '<testsuites>'
+    for src in "${NEW_TEST_CLASS_FILES[@]}"; do
+      [ -f "$src" ] || continue
+      rel="${src#core/src/test/java/}"
+      rel="${rel%.java}"
+      fqcn="${rel////.}"
+      names=$(awk '/@Test/{t=1} t && match($0, /void [A-Za-z0-9_]+\(/){print substr($0, RSTART+5, RLENGTH-6); t=0}' "$src")
+      count=$(echo "$names" | grep -c .)
+      [ "$count" -eq 0 ] && continue
+      total=$((total + count))
+      echo "<testsuite name=\"$fqcn\" tests=\"$count\" failures=\"$count\" errors=\"0\" time=\"0\">"
+      for n in $names; do
+        echo "<testcase name=\"$n\" classname=\"$fqcn\"><failure message=\"The module did not build\">$BUILD_DIAGNOSTIC</failure></testcase>"
+      done
+      echo '</testsuite>'
+    done
+    if [ "$total" -eq 0 ]; then
+      echo '<testsuite name="build" tests="1" failures="1" errors="0" time="0">'
+      echo '<testcase name="core module build" classname="build">'
+      echo "<failure message=\"The module did not build\">$BUILD_DIAGNOSTIC</failure>"
+      echo '</testcase>'
+      echo '</testsuite>'
+    fi
+    echo '</testsuites>'
+  } > "$target"
+}
+
+REPORT_COUNT=$(ls "$REPORT_DIR"/TEST-*.xml 2>/dev/null | wc -l)
+if [ "$REPORT_COUNT" -eq 0 ]; then
+  if [ -n "$OUTPUT_PATH" ]; then
+    write_failure_report "$OUTPUT_PATH" "$MVN_LOG"
+  fi
+  rm -f "$MVN_LOG"
+  echo "No surefire reports were produced (maven exit $MVN_EXIT)."
+  exit 1
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+  write_report "$OUTPUT_PATH"
+fi
+rm -f "$MVN_LOG"
+
+FAILED=$(grep -h -o '<testsuite [^>]*' "$REPORT_DIR"/TEST-*.xml \
+  | grep -o -E '(failures|errors)="[0-9]+"' | grep -o -E '[0-9]+' | awk '{s+=$1} END {print s+0}')
+TESTS=$(grep -h -o '<testsuite [^>]*' "$REPORT_DIR"/TEST-*.xml \
+  | grep -o -E ' tests="[0-9]+"' | grep -o -E '[0-9]+' | awk '{s+=$1} END {print s+0}')
+echo "Tests run: $TESTS, failures+errors: $FAILED (maven exit $MVN_EXIT)"
+if [ "$MVN_EXIT" -ne 0 ] || [ "$FAILED" -ne 0 ] || [ "$TESTS" -eq 0 ]; then
+  exit 1
+fi
+exit 0
