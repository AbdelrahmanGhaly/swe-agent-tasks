+        assertThat(valueRange.contains(new BigDecimal("1.50"))).isTrue();
+        assertThat(valueRange.contains(new BigDecimal("1.25"))).isFalse();
+    }
+
+    @Test
+    void intersectionOfBigDecimalsKeepsFirstMemberScale() {
+        assertProduces(intersection(decimals("1.00", "2.00", "0.25"), decimals("1.0", "3.0", "0.5")),
