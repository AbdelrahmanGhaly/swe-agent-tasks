+        assertAllElementsOfIterator(firstRange.createOriginalIterator(), 3, 50);
+        var secondRange = valueRangeManager.<TestdataComposedEntityRangeEntity, Integer> getFromEntity(
+                valueRangeDescriptor, second);
+        assertAllElementsOfIterator(secondRange.createOriginalIterator(), 3, 7);
+        assertThat(valueRangeManager.getProblemSizeStatistics().approximateValueCount()).isEqualTo(4L);
+    }
+
+    @Test
+    void solvesListVariableWithComposedRangeOnSolution() {
+        var v1 = new TestdataComposedSolutionListValue("v1");
+        var v2 = new TestdataComposedSolutionListValue("v2");
+        var v3 = new TestdataComposedSolutionListValue("v3");
+        var v4 = new TestdataComposedSolutionListValue("v4");
+        var solution = new TestdataComposedSolutionListSolution(List.of(v1, v2, v3, v4),
+                List.of(new TestdataComposedSolutionListEntity("e1"), new TestdataComposedSolutionListEntity("e2")));
+        var solutionDescriptor = TestdataComposedSolutionListSolution.buildSolutionDescriptor();
+        var valueRangeDescriptor = solutionDescriptor
+                .findEntityDescriptorOrFail(TestdataComposedSolutionListEntity.class)
+                .getGenuineVariableDescriptor("valueList").getValueRangeDescriptor();
+        var valueRangeManager = ValueRangeManager.of(solutionDescriptor, solution);
+        assertThat(valueRangeManager.countOnSolution(valueRangeDescriptor, solution)).isEqualTo(4L);
+        assertThat(valueRangeManager.getProblemSizeStatistics().approximateValueCount()).isEqualTo(4L);
+        var valueRange = valueRangeManager.<TestdataComposedSolutionListValue> getFromSolution(valueRangeDescriptor);
+        assertAllElementsOfIterator(valueRange.createOriginalIterator(), v1, v2, v3, v4);
+        var solverConfig = PlannerTestUtils.buildSolverConfig(TestdataComposedSolutionListSolution.class,
+                TestdataComposedSolutionListEntity.class, TestdataComposedSolutionListValue.class).withRandomSeed(0L);
+        var solved = PlannerTestUtils.solve(solverConfig, solution);
+        assertThat(solved.getScore()).isNotNull();
+        var assigned = new ArrayList<TestdataComposedSolutionListValue>();
+        for (var entity : solved.getEntityList()) {
+            assigned.addAll(entity.getValueList());
+        }
+        assertThat(assigned).containsExactlyInAnyOrderElementsOf(solved.getValueList());
+    }
+
+    @Test
+    void solvesListVariableWithComposedRangesOnEntities() {
+        var v1 = new TestdataComposedListValue("v1");
+        var v2 = new TestdataComposedListValue("v2");
+        var v3 = new TestdataComposedListValue("v3");
+        var v4 = new TestdataComposedListValue("v4");
+        var v5 = new TestdataComposedListValue("v5");
+        var first = new TestdataComposedListEntity("e1", List.of(v1, v2, v3), null);
+        var second = new TestdataComposedListEntity("e2", null, List.of(v1));
+        var solution = new TestdataComposedListSolution(List.of(v1, v2, v3, v4, v5), List.of(first, second));
+        var solverConfig = PlannerTestUtils.buildSolverConfig(TestdataComposedListSolution.class,
+                TestdataComposedListEntity.class, TestdataComposedListValue.class).withRandomSeed(0L);
+        var solved = PlannerTestUtils.solve(solverConfig, solution);
+        assertThat(solved.getScore()).isNotNull();
+        var solvedFirst = solved.getEntityList().get(0);
+        var solvedSecond = solved.getEntityList().get(1);
+        var allowedForFirst = solvedFirst.getAllowedValueList();
+        assertThat(solvedFirst.getValueList()).allMatch(allowedForFirst::contains);
+        assertThat(solvedSecond.getValueList()).noneMatch(solvedSecond.getForbiddenValueList()::contains);
+        var assigned = new ArrayList<>(solvedFirst.getValueList());
+        assigned.addAll(solvedSecond.getValueList());
+        assertThat(assigned).containsExactlyInAnyOrderElementsOf(solved.getValueList());
+        for (var value : solved.getValueList()) {
+            assertThat(value.getEntity()).isNotNull();
+            assertThat(value.getEntity().getValueList().get(value.getIndex())).isSameAs(value);
+        }
+    }
+
+    @Test
+    void countsComposedValuesOnListEntities() {
+        var v1 = new TestdataComposedListValue("v1");
+        var v2 = new TestdataComposedListValue("v2");
+        var v3 = new TestdataComposedListValue("v3");
+        var v4 = new TestdataComposedListValue("v4");
+        var first = new TestdataComposedListEntity("e1", List.of(v3, v1, v9()), null);
+        var second = new TestdataComposedListEntity("e2", null, List.of(v1, v4));
+        var solution = new TestdataComposedListSolution(List.of(v1, v2, v3, v4), List.of(first, second));
+        var solutionDescriptor = TestdataComposedListSolution.buildSolutionDescriptor();
+        var valueRangeDescriptor = solutionDescriptor.findEntityDescriptorOrFail(TestdataComposedListEntity.class)
+                .getGenuineVariableDescriptor("valueList").getValueRangeDescriptor();
+        var valueRangeManager = ValueRangeManager.of(solutionDescriptor, solution);
+        assertThat(valueRangeManager.countOnEntity(valueRangeDescriptor, first)).isEqualTo(2L);
+        assertThat(valueRangeManager.countOnEntity(valueRangeDescriptor, second)).isEqualTo(2L);
+        var firstRange = valueRangeManager.<TestdataComposedListEntity, TestdataComposedListValue> getFromEntity(
+                valueRangeDescriptor, first);
+        assertAllElementsOfIterator(firstRange.createOriginalIterator(), v1, v3);
+        var secondRange = valueRangeManager.<TestdataComposedListEntity, TestdataComposedListValue> getFromEntity(
+                valueRangeDescriptor, second);
+        assertAllElementsOfIterator(secondRange.createOriginalIterator(), v2, v3);
+        assertThat(valueRangeManager.getProblemSizeStatistics().approximateValueCount()).isEqualTo(4L);
+    }
+
+    private static TestdataComposedListValue v9() {
+        return new TestdataComposedListValue("v9");
+    }
+
+}
