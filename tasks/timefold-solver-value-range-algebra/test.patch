+
+class ValueRangeCompositionAa92bcTest {
+
+    private static final long HUGE = 1L << 40;
+
+    private static ValueRange<Integer> ints(int from, int to) {
+        return ValueRangeFactory.createIntValueRange(from, to);
+    }
+
+    private static ValueRange<Integer> ints(int from, int to, int incrementUnit) {
+        return ValueRangeFactory.createIntValueRange(from, to, incrementUnit);
+    }
+
+    private static ValueRange<Long> longs(long from, long to, long incrementUnit) {
+        return ValueRangeFactory.createLongValueRange(from, to, incrementUnit);
+    }
+
+    private static ValueRange<BigInteger> bigIntegers(long from, long to, long incrementUnit) {
+        return ValueRangeFactory.createBigIntegerValueRange(BigInteger.valueOf(from), BigInteger.valueOf(to),
+                BigInteger.valueOf(incrementUnit));
+    }
+
+    private static ValueRange<BigDecimal> decimals(String from, String to, String incrementUnit) {
+        return ValueRangeFactory.createBigDecimalValueRange(new BigDecimal(from), new BigDecimal(to),
+                new BigDecimal(incrementUnit));
+    }
+
+    private static ValueRange<LocalDate> months(LocalDate from, int count) {
+        return ValueRangeFactory.createLocalDateValueRange(from, from.plusMonths(count), 1, ChronoUnit.MONTHS);
+    }
+
+    private static ValueRange<LocalTime> minutes(LocalTime from, LocalTime to, int step) {
+        return ValueRangeFactory.createLocalTimeValueRange(from, to, step, ChronoUnit.MINUTES);
+    }
+
+    @SafeVarargs
+    private static <T> ValueRange<T> list(T... values) {
+        return ValueRangeFactory.createCollectionValueRange(Arrays.asList(values));
+    }
+
+    @SafeVarargs
+    private static <T> ValueRange<T> union(ValueRange<T>... members) {
+        return ValueRangeFactory.createUnionValueRange(members);
+    }
+
+    @SafeVarargs
+    private static <T> ValueRange<T> intersection(ValueRange<T>... members) {
+        return ValueRangeFactory.createIntersectionValueRange(members);
+    }
+
+    private static <T> ValueRange<T> difference(ValueRange<T> valueRange, ValueRange<T> excludedValueRange) {
+        return ValueRangeFactory.createDifferenceValueRange(valueRange, excludedValueRange);
+    }
+
+    private static SelectionSorterAdapter<Object, Integer> ascending() {
+        return new SelectionSorterAdapter<>(null, new ComparatorSelectionSorter<>(
+                Comparator.comparingInt(Integer::intValue), SelectionSorterOrder.ASCENDING));
+    }
+
+    private static SelectionSorterAdapter<Object, Integer> descending() {
+        return new SelectionSorterAdapter<>(null, new ComparatorSelectionSorter<>(
+                Comparator.comparingInt(Integer::intValue), SelectionSorterOrder.DESCENDING));
+    }
+
+    private static <T> ValueRange<T> sorted(ValueRange<T> valueRange, SelectionSorterAdapter<Object, T> sorter) {
+        return ((SortableValueRange<T>) valueRange).sort(sorter);
+    }
+
+    @SafeVarargs
+    private static <T> void assertProduces(ValueRange<T> valueRange, T... expected) {
+        assertThat(valueRange.getSize()).isEqualTo(expected.length);
+        assertThat(valueRange.isEmpty()).isEqualTo(expected.length == 0);
+        for (var i = 0; i < expected.length; i++) {
+            assertThat(valueRange.get(i)).isEqualTo(expected[i]);
+            assertThat(valueRange.contains(expected[i])).isTrue();
+        }
+        assertAllElementsOfIterator(valueRange.createOriginalIterator(), expected);
+    }
+
+    @Test
+    void unionRejectsNoMembers() {
+        assertThatIllegalArgumentException().isThrownBy(() -> ValueRangeFactory.<Integer> createUnionValueRange());
+    }
+
+    @Test
+    void intersectionRejectsNoMembers() {
+        assertThatIllegalArgumentException()
+                .isThrownBy(() -> ValueRangeFactory.<Integer> createIntersectionValueRange());
+    }
+
+    @Test
+    void unionRejectsNullMember() {
+        assertThatIllegalArgumentException().isThrownBy(() -> union(ints(0, 3), null));
+    }
+
+    @Test
+    void intersectionRejectsNullMember() {
+        assertThatIllegalArgumentException().isThrownBy(() -> intersection(null, ints(0, 3)));
+    }
+
+    @Test
+    void differenceRejectsNullArgument() {
+        assertThatIllegalArgumentException().isThrownBy(() -> difference(ints(0, 3), null));
+        assertThatIllegalArgumentException().isThrownBy(() -> difference(null, ints(0, 3)));
+    }
+
+    @Test
+    void collectionRangeKeepsCollectionOrder() {
+        assertProduces(list(5, 1, 9), 5, 1, 9);
+        assertProduces(ValueRangeFactory.createCollectionValueRange(new TreeSet<>(List.of(5, 1, 9))), 1, 5, 9);
+        assertProduces(ValueRangeFactory.createCollectionValueRange(new LinkedHashSet<>(List.of(5, 1, 9))), 5, 1, 9);
+    }
+
+    @Test
+    void collectionRangeRejectsUnorderedSet() {
+        assertThatIllegalArgumentException()
+                .isThrownBy(() -> ValueRangeFactory.createCollectionValueRange(new HashSet<>(List.of(1, 2))));
+    }
+
+    @Test
+    void collectionRangeRejectsNullCollectionAndNullElement() {
+        assertThatIllegalArgumentException().isThrownBy(() -> ValueRangeFactory.createCollectionValueRange(null));
+        assertThatIllegalArgumentException()
+                .isThrownBy(() -> ValueRangeFactory.createCollectionValueRange(Arrays.asList(1, null, 3)));
+        assertThatIllegalArgumentException().isThrownBy(
+                () -> ValueRangeFactory.createCollectionValueRange(new LinkedHashSet<>(Arrays.asList(null, 1))));
+    }
+
+    @Test
+    void compositionFactoriesRejectNullMemberArray() {
+        assertThatIllegalArgumentException()
+                .isThrownBy(() -> ValueRangeFactory.createUnionValueRange((ValueRange<Integer>[]) null));
+        assertThatIllegalArgumentException()
+                .isThrownBy(() -> ValueRangeFactory.createIntersectionValueRange((ValueRange<Integer>[]) null));
+    }
+
+    @Test
+    void intersectionOfStepTwoAndStepThree() {
+        assertProduces(intersection(ints(0, 30, 2), ints(0, 30, 3)), 0, 6, 12, 18, 24);
+    }
+
+    @Test
+    void intersectionOfOffsetProgressions() {
+        assertProduces(intersection(ints(1, 40, 3), ints(2, 42, 5)), 7, 22, 37);
+        assertProduces(intersection(ints(2, 42, 5), ints(1, 40, 3)), 7, 22, 37);
+    }
+
+    @Test
+    void intersectionOfDisjointProgressionsIsEmpty() {
+        var valueRange = intersection(ints(0, 10, 2), ints(1, 11, 2));
+        assertProduces(valueRange);
+        assertThat(valueRange.contains(2)).isFalse();
+        assertThat(valueRange.createRandomIterator(new TestRandom(0)).hasNext()).isFalse();
+    }
+
+    @Test
+    void intersectionOfSingleMemberIsThatMember() {
+        assertProduces(intersection(ints(3, 6)), 3, 4, 5);
+    }
+
+    @Test
+    void intersectionOfThreeProgressions() {
+        assertProduces(intersection(ints(0, 120, 2), ints(0, 120, 3), ints(0, 120, 5)), 0, 30, 60, 90);
+    }
+
+    @Test
+    void intersectionListsCollectionValuesInFirstMemberOrder() {
+        assertProduces(intersection(longs(0L, HUGE, 1L), list(5L, 3L, 9L, 3L, 12L, -4L)), 3L, 5L, 9L, 12L);
+    }
+
+    @Test
+    void intersectionWithCollectionFirstKeepsCollectionOrder() {
+        assertProduces(intersection(list(5, 3, 9, 3, 12), ints(0, 10)), 5, 3, 9);
+    }
+
+    @Test
+    void intersectionOfCollections() {
+        assertProduces(intersection(list("c", "a", "b", "a"), list("b", "c", "d")), "c", "b");
+    }
+
+    @Test
+    void intersectionWithNestedUnionKeepsUnionOrder() {
+        assertProduces(intersection(union(ints(0, 10), ints(20, 30)), ints(5, 25)), 5, 6, 7, 8, 9, 20, 21, 22, 23, 24);
+    }
+
+    @Test
+    void intersectionOfBigDecimalsUsesNumericMembership() {
+        var valueRange = intersection(decimals("1.0", "3.0", "0.5"), decimals("1.00", "3.00", "0.25"));
+        assertProduces(valueRange, new BigDecimal("1.0"), new BigDecimal("1.5"), new BigDecimal("2.0"),
