+    }
+
+    @Test
+    void intersectionOfBigIntegers() {
+        assertProduces(intersection(bigIntegers(0L, 112L, 7L), bigIntegers(0L, 112L, 4L)), BigInteger.ZERO,
+                BigInteger.valueOf(28L), BigInteger.valueOf(56L), BigInteger.valueOf(84L));
+    }
+
+    @Test
+    void intersectionOfMonthlyDatesFollowsTheCalendar() {
+        var fromJanuary = months(LocalDate.of(2024, 1, 31), 4);
