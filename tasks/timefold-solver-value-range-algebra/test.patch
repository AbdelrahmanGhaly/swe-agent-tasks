+    @Test
+    @SuppressWarnings("unchecked")
+    void compositionsMatchMaterializedModel() {
+        var random = new Random(0L);
+        for (var i = 0; i < 400; i++) {
+            var members = new ArrayList<ValueRange<Integer>>();
+            var memberCount = 1 + random.nextInt(3);
+            for (var j = 0; j < memberCount; j++) {
+                members.add(randomMember(random, 2));
+            }
+            var union = ValueRangeFactory.createUnionValueRange(members.toArray(new ValueRange[0]));
+            assertMatches(union, modelUnion(members));
+            var intersection = ValueRangeFactory.createIntersectionValueRange(members.toArray(new ValueRange[0]));
+            assertMatches(intersection, modelIntersection(members));
+            if (members.size() >= 2) {
+                var difference = ValueRangeFactory.createDifferenceValueRange(members.get(0), members.get(1));
+                assertMatches(difference, modelDifference(members.get(0), members.get(1)));
+            }
+        }
+    }
+
+    private static ValueRange<Integer> randomMember(Random random, int depth) {
+        var kind = random.nextInt(depth > 0 ? 6 : 4);
+        switch (kind) {
+            case 0, 1 -> {
+                var from = random.nextInt(21) - 10;
+                var step = 1 + random.nextInt(4);
+                return ints(from, from + step * random.nextInt(8), step);
+            }
+            case 2, 3 -> {
+                var values = new ArrayList<Integer>();
+                var count = random.nextInt(7);
+                for (var i = 0; i < count; i++) {
+                    values.add(random.nextInt(31) - 10);
+                }
+                return ValueRangeFactory.createCollectionValueRange(values);
+            }
+            case 4 -> {
+                return union(randomMember(random, depth - 1), randomMember(random, depth - 1));
+            }
+            default -> {
+                return random.nextBoolean()
+                        ? intersection(randomMember(random, depth - 1), randomMember(random, depth - 1))
+                        : difference(randomMember(random, depth - 1), randomMember(random, depth - 1));
+            }
+        }
+    }
+
+    private static List<Integer> modelUnion(List<ValueRange<Integer>> members) {
+        var result = new LinkedHashSet<Integer>();
+        for (var i = 0; i < members.size(); i++) {
+            var iterator = members.get(i).createOriginalIterator();
+            while (iterator.hasNext()) {
+                var value = iterator.next();
+                var containedEarlier = false;
+                for (var j = 0; j < i; j++) {
+                    if (members.get(j).contains(value)) {
+                        containedEarlier = true;
+                        break;
+                    }
+                }
+                if (!containedEarlier) {
+                    result.add(value);
+                }
+            }
+        }
+        return new ArrayList<>(result);
+    }
+
+    private static List<Integer> modelIntersection(List<ValueRange<Integer>> members) {
+        var result = new LinkedHashSet<Integer>();
+        var iterator = members.get(0).createOriginalIterator();
+        while (iterator.hasNext()) {
+            var value = iterator.next();
+            var containedEverywhere = true;
+            for (var j = 1; j < members.size(); j++) {
+                if (!members.get(j).contains(value)) {
+                    containedEverywhere = false;
+                    break;
+                }
+            }
+            if (containedEverywhere) {
+                result.add(value);
+            }
+        }
+        return new ArrayList<>(result);
+    }
+
+    private static List<Integer> modelDifference(ValueRange<Integer> valueRange, ValueRange<Integer> excludedValueRange) {
+        var result = new LinkedHashSet<Integer>();
+        var iterator = valueRange.createOriginalIterator();
+        while (iterator.hasNext()) {
+            var value = iterator.next();
+            if (!excludedValueRange.contains(value)) {
+                result.add(value);
+            }
+        }
+        return new ArrayList<>(result);
+    }
+
+    private static void assertMatches(ValueRange<Integer> valueRange, List<Integer> expected) {
+        assertThat(valueRange.getSize()).isEqualTo(expected.size());
+        assertThat(valueRange.isEmpty()).isEqualTo(expected.isEmpty());
+        var iterator = valueRange.createOriginalIterator();
+        for (var i = 0; i < expected.size(); i++) {
+            assertThat(iterator.hasNext()).isTrue();
+            assertThat(iterator.next()).isEqualTo(expected.get(i));
+            assertThat(valueRange.get(i)).isEqualTo(expected.get(i));
+        }
+        assertThat(iterator.hasNext()).isFalse();
+        for (var probe = -12; probe <= 32; probe++) {
+            assertThat(valueRange.contains(probe)).isEqualTo(expected.contains(probe));
+        }
+        if (!expected.isEmpty()) {
+            var index = expected.size() - 1;
+            assertElementsOfIterator(valueRange.createRandomIterator(new TestRandom(index, 0)), expected.get(index),
+                    expected.get(0));
+        }
+    }
+
+    private static final class CountingRandom extends Random {
+
+        int boundedCallCount = 0;
+        int lastBound = -1;
+        int lastIndex = -1;
+        private final Random delegate = new Random(0L);
+
+        CountingRandom() {
+            super(0L);
+        }
+
+        @Override
+        public int nextInt(int bound) {
+            boundedCallCount++;
+            lastBound = bound;
+            lastIndex = delegate.nextInt(bound);
+            return lastIndex;
+        }
+
+    }
+
+    private static final class UnsortableValueRange implements ValueRange<Integer>, SortableValueRange<Integer> {
+
+        private static final String MESSAGE = "this value range refuses to sort";
+
+        private final ValueRange<Integer> delegate;
+
+        UnsortableValueRange(List<Integer> values) {
+            this.delegate = ValueRangeFactory.createCollectionValueRange(values);
+        }
+
+        @Override
+        public ValueRange<Integer> sort(ValueRangeSorter<Integer> sorter) {
+            throw new UnsupportedOperationException(MESSAGE);
+        }
+
+        @Override
+        public boolean isEmpty() {
+            return delegate.isEmpty();
+        }
+
+        @Override
+        public boolean contains(Integer value) {
+            return delegate.contains(value);
+        }
+
+        @Override
+        public long getSize() {
+            return delegate.getSize();
+        }
+
+        @Override
+        public Integer get(long index) {
+            return delegate.get(index);
+        }
+
+        @Override
+        public Iterator<Integer> createOriginalIterator() {
+            return delegate.createOriginalIterator();
+        }
+
+        @Override
+        public Iterator<Integer> createRandomIterator(RandomGenerator workingRandom) {
+            return delegate.createRandomIterator(workingRandom);
+        }
+
+    }
+
+    private static final class NullableSortableValueRange implements ValueRange<Integer>, SortableValueRange<Integer> {
+
+        private final ValueRange<Integer> delegate;
+
+        NullableSortableValueRange(List<Integer> values) {
+            this.delegate = new ListValueRange<>(values);
+        }
+
+        @Override
+        public ValueRange<Integer> sort(ValueRangeSorter<Integer> sorter) {
+            var sortedList = new ArrayList<Integer>();
+            delegate.createOriginalIterator().forEachRemaining(sortedList::add);
+            sorter.sort(sortedList);
+            return new ListValueRange<>(sortedList);
+        }
+
+        @Override
+        public boolean isEmpty() {
+            return delegate.isEmpty();
+        }
+
+        @Override
+        public boolean contains(Integer value) {
+            return delegate.contains(value);
+        }
+
+        @Override
+        public long getSize() {
+            return delegate.getSize();
+        }
+
+        @Override
+        public Integer get(long index) {
+            return delegate.get(index);
+        }
+
+        @Override
+        public Iterator<Integer> createOriginalIterator() {
+            return delegate.createOriginalIterator();
+        }
+
+        @Override
+        public Iterator<Integer> createRandomIterator(RandomGenerator workingRandom) {
+            return delegate.createRandomIterator(workingRandom);
+        }
+
+    }
+
+    private static final class CustomSortableValueRange implements ValueRange<Integer>, SortableValueRange<Integer> {
+
+        private final ValueRange<Integer> delegate;
+
+        CustomSortableValueRange(List<Integer> values) {
+            this.delegate = ValueRangeFactory.createCollectionValueRange(values);
+        }
+
+        @Override
+        public ValueRange<Integer> sort(ValueRangeSorter<Integer> sorter) {
+            var sortedList = new ArrayList<Integer>();
+            delegate.createOriginalIterator().forEachRemaining(sortedList::add);
+            sorter.sort(sortedList);
+            return ValueRangeFactory.createCollectionValueRange(sortedList);
+        }
+
+        @Override
+        public boolean isEmpty() {
+            return delegate.isEmpty();
+        }
+
+        @Override
+        public boolean contains(Integer value) {
+            return delegate.contains(value);
+        }
+
+        @Override
+        public long getSize() {
+            return delegate.getSize();
+        }
+
+        @Override
+        public Integer get(long index) {
+            return delegate.get(index);
+        }
+
+        @Override
+        public Iterator<Integer> createOriginalIterator() {
+            return delegate.createOriginalIterator();
+        }
+
+        @Override
+        public Iterator<Integer> createRandomIterator(RandomGenerator workingRandom) {
+            return delegate.createRandomIterator(workingRandom);
+        }
+
+    }
