+        assertThat(intersection(ints(0, 3), ints(1, 4))).hasSameHashCodeAs(intersection(ints(0, 3), ints(1, 4)));
+        assertThat(intersection(ints(0, 3), ints(1, 4))).isNotEqualTo(intersection(ints(0, 3), ints(1, 5)));
