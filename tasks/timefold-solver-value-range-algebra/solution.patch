+package ai.timefold.solver.core.impl.domain.valuerange;
+
+import java.util.List;
+
+import ai.timefold.solver.core.api.domain.valuerange.ValueRange;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.All;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.Minus;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.Node;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+@NullMarked
+public final class DifferenceValueRange<T> extends AbstractCompositionValueRange<T> {
+
+    private final Minus<T> node;
+
+    public DifferenceValueRange(ValueRange<T> valueRange, ValueRange<T> excludedValueRange) {
+        super(List.of(valueRange, excludedValueRange));
+        this.node = new Minus<>(nodeOf(valueRange), nodeOf(excludedValueRange));
+    }
+
+    @Override
+    protected ValueSequence<T> buildSequence() {
+        return FilteredSequence.of(sequenceOf(memberList.get(0)), new Minus<>(new All<>(), nodeOf(memberList.get(1))));
+    }
+
+    @Override
+    Node<T> node() {
+        return node;
+    }
+
+    @Override
+    public boolean contains(@Nullable T value) {
+        return memberList.get(0).contains(value) && !memberList.get(1).contains(value);
+    }
+
+    @Override
+    protected String getOperatorSymbol() {
+        return "\\";
+    }
+
+}
