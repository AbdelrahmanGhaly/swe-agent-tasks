+import ai.timefold.solver.core.impl.solver.random.RandomUtils;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * A {@link ValueRange} built from other value ranges.
+ */
+@NullMarked
+public abstract sealed class AbstractCompositionValueRange<T> extends AbstractValueRange<T>
+        permits UnionValueRange, IntersectionValueRange, DifferenceValueRange {
+
+    static <T> ValueSequence<T> sequenceOf(ValueRange<T> valueRange) {
+        if (valueRange instanceof AbstractCompositionValueRange<T> composition) {
+            return composition.getSequence();
+        } else if (valueRange instanceof ProgressionBacked<T> progressionBacked) {
+            return new ProgressionSequence<>(progressionBacked.progression());
+        } else if (valueRange instanceof NullAllowingValueRange<T> nullAllowing) {
+            return ConcatSequence.of(List.of(ListSequence.ofRange(nullOnlyRange()),
+                    sequenceOf(nullAllowing.getChildValueRange())));
+        }
+        return ListSequence.ofRange(valueRange);
+    }
+
+    static <T> Node<T> nodeOf(ValueRange<T> valueRange) {
+        if (valueRange instanceof AbstractCompositionValueRange<T> composition) {
+            return composition.node();
+        } else if (valueRange instanceof ProgressionBacked<T> progressionBacked) {
+            return new Leaf<>(progressionBacked.progression());
+        } else if (valueRange instanceof NullAllowingValueRange<T> nullAllowing) {
+            return new Or<>(List.of(new Finite<>(nullOnlyRange()), nodeOf(nullAllowing.getChildValueRange())));
+        }
+        return new Finite<>(valueRange);
+    }
+
+    private static <T> ValueRange<T> nullOnlyRange() {
+        return new NullAllowingValueRange<>(EmptyValueRange.<T> instance());
+    }
+
+    protected final List<ValueRange<T>> memberList;
+    private @Nullable ValueSequence<T> sequence;
+
+    protected AbstractCompositionValueRange(List<ValueRange<T>> memberList) {
+        this.memberList = List.copyOf(memberList);
+    }
+
+    protected abstract ValueSequence<T> buildSequence();
+
+    abstract Node<T> node();
+
+    protected abstract String getOperatorSymbol();
+
+    protected final ValueSequence<T> getSequence() {
+        if (sequence == null) {
+            sequence = buildSequence();
+        }
+        return sequence;
+    }
+
+    @Override
+    public long getSize() {
+        return getSequence().size();
+    }
+
+    @Override
+    public T get(long index) {
+        var size = getSize();
+        if (index < 0L || index >= size) {
+            throw new IndexOutOfBoundsException("The index (" + index + ") must be >= 0 and < size ("
+                    + size + ").");
+        }
+        return getSequence().get(index);
+    }
+
+    @Override
+    public ValueRange<T> sort(ValueRangeSorter<T> sorter) {
+        var probeSorter = new NullFilteringSorter<>(sorter);
+        for (var member : memberList) {
+            requireSortableMember(member, probeSorter);
+        }
+        var sortableList = new ArrayList<T>((int) getSize());
+        var nullProduced = false;
+        var iterator = getSequence().iterator();
+        while (iterator.hasNext()) {
+            var value = iterator.next();
+            if (value == null) {
+                nullProduced = true;
+            } else {
+                sortableList.add(value);
+            }
+        }
+        sorter.sort(sortableList);
+        var sortedValueRange = new ListValueRange<>(sortableList);
+        return nullProduced ? new NullAllowingValueRange<>(sortedValueRange) : sortedValueRange;
+    }
+
+    /**
+     * Sorting a member is what decides whether that member can be sorted,
+     * so a member which declines raises its own error and the caller sees that error.
+     * The member is sorted through a sorter which drops null first, because a member may hold null
+     * and only the values the composition produces, without null, reach the caller's own sorter.
+     */
+    @SuppressWarnings({ "rawtypes", "unchecked" })
+    private static <T> void requireSortableMember(ValueRange<T> member, ValueRangeSorter<T> sorter) {
+        if (member instanceof AbstractCompositionValueRange<T> composition) {
+            for (var nestedMember : composition.memberList) {
+                requireSortableMember(nestedMember, sorter);
+            }
+        } else if (member instanceof SortableValueRange sortableMember) {
+            sortableMember.sort(sorter);
+        } else {
+            throw new UnsupportedOperationException();
+        }
+    }
+
+    private record NullFilteringSorter<T>(ValueRangeSorter<T> delegate) implements ValueRangeSorter<T> {
+
+        @Override
+        public void sort(List<T> selectionList) {
+            var nonNullList = new ArrayList<T>(selectionList.size());
+            for (var value : selectionList) {
+                if (value != null) {
+                    nonNullList.add(value);
+                }
+            }
+            delegate.sort(nonNullList);
+        }
+
+        @Override
+        public SortedSet<T> sort(Set<T> selectionSet) {
+            var nonNullSet = new LinkedHashSet<T>();
+            for (var value : selectionSet) {
+                if (value != null) {
+                    nonNullSet.add(value);
+                }
+            }
+            return delegate.sort(nonNullSet);
+        }
+
+        @Override
+        public SelectionSorter<?, T> getInnerSorter() {
+            return delegate.getInnerSorter();
+        }
+
+    }
+
+    @Override
+    public Iterator<T> createOriginalIterator() {
+        return getSequence().iterator();
+    }
+
+    @Override
+    public Iterator<T> createRandomIterator(RandomGenerator workingRandom) {
+        return new RandomCompositionValueRangeIterator(workingRandom);
+    }
+
+    private final class RandomCompositionValueRangeIterator extends ValueRangeIterator<T> {
+
+        private final RandomGenerator workingRandom;
+        private final long size = getSize();
+
+        private RandomCompositionValueRangeIterator(RandomGenerator workingRandom) {
+            this.workingRandom = workingRandom;
+        }
+
+        @Override
+        public boolean hasNext() {
+            return size > 0L;
+        }
+
+        @Override
+        public T next() {
+            if (size <= 0L) {
+                throw new NoSuchElementException();
+            }
+            return getSequence().get(RandomUtils.nextLong(workingRandom, size));
+        }
+
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) {
+            return true;
+        }
+        return o != null && getClass() == o.getClass() &&
+                memberList.equals(((AbstractCompositionValueRange<?>) o).memberList);
+    }
+
+    @Override
+    public int hashCode() {
+        var hash = 1;
+        hash = 31 * hash + getClass().hashCode();
+        return 31 * hash + memberList.hashCode();
+    }
+
+    @Override
+    public String toString() {
+        var builder = new StringBuilder();
+        for (var member : memberList) {
+            if (!builder.isEmpty()) {
+                builder.append(getOperatorSymbol());
+            }
+            builder.append(member);
+        }
+        return builder.toString();
+    }
+
+}
