+    /**
+     * Build a {@link ValueRange} of the values of a collection, in the iteration order of the collection.
+     *
+     * @param values a {@link Set} must be a {@link SortedSet} or a {@link LinkedHashSet}, so that its order is defined
+     */
+    public static <T> ValueRange<T> createCollectionValueRange(Collection<T> values) {
+        if (values == null) {
+            throw new IllegalArgumentException("The values must not be null.");
+        }
+        if (values instanceof Set<T> set) {
+            if (!(set instanceof SortedSet<T> || set instanceof LinkedHashSet<T>)) {
+                throw new IllegalArgumentException("The values (%s) must be a %s or a %s, because a %s has no defined order."
+                        .formatted(set.getClass().getSimpleName(), SortedSet.class.getSimpleName(),
+                                LinkedHashSet.class.getSimpleName(), Set.class.getSimpleName()));
+            }
+            requireNoNullElement(set);
+            return new SetValueRange<>(set);
+        }
+        requireNoNullElement(values);
+        return new ListValueRange<>(List.copyOf(values));
+    }
+
+    private static void requireNoNullElement(Collection<?> values) {
+        for (var value : values) {
+            if (value == null) {
+                throw new IllegalArgumentException("The values must not contain a null element.");
+            }
+        }
+    }
+
+    /**
+     * Build a {@link ValueRange} of the values of the first value range,
+     * followed by the values of every later value range which no earlier value range contains.
+     * Each value range keeps its own order.
+     *
+     * @param valueRanges at least one
+     */
+    @SafeVarargs
+    public static <T> ValueRange<T> createUnionValueRange(ValueRange<T>... valueRanges) {
+        return new UnionValueRange<>(toMemberList(valueRanges));
+    }
+
+    /**
+     * Build a {@link ValueRange} of the values of the first value range, in its order,
+     * which every other value range contains.
+     *
+     * @param valueRanges at least one
+     */
+    @SafeVarargs
+    public static <T> ValueRange<T> createIntersectionValueRange(ValueRange<T>... valueRanges) {
+        return new IntersectionValueRange<>(toMemberList(valueRanges));
+    }
+
+    /**
+     * Build a {@link ValueRange} of the values of a value range, in its order,
+     * which the excluded value range does not contain.
+     */
+    public static <T> ValueRange<T> createDifferenceValueRange(ValueRange<T> valueRange,
+            ValueRange<T> excludedValueRange) {
+        return new DifferenceValueRange<>(requireMember(valueRange), requireMember(excludedValueRange));
+    }
+
+    @SafeVarargs
+    private static <T> List<ValueRange<T>> toMemberList(ValueRange<T>... valueRanges) {
+        if (valueRanges == null) {
+            throw new IllegalArgumentException("The valueRanges must not be null.");
+        }
+        if (valueRanges.length == 0) {
+            throw new IllegalArgumentException("The valueRanges must contain at least one value range.");
+        }
+        for (var valueRange : valueRanges) {
