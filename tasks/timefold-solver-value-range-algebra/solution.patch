+ */
+@NullMarked
+sealed interface ValueSequence<T> permits ProgressionSequence, ListSequence, FilteredSequence, ConcatSequence {
+
+    long size();
+
+    T get(long position);
+
+    /**
+     * @return the position of the value, or a negative number if the sequence does not produce it
+     */
+    long positionOf(@Nullable T value);
+
+    /**
+     * @return how many of the first {@code prefixLength} values of this sequence the node contains
+     */
+    long countInPrefix(Node<T> node, long prefixLength);
+
+    Node<T> node();
+
+    default Iterator<T> iterator() {
+        return new PositionIterator<>(this);
+    }
+
+    final class PositionIterator<T> extends ValueRangeIterator<T> {
+
+        private final ValueSequence<T> sequence;
+        private final long size;
+        private long position = 0L;
+
+        PositionIterator(ValueSequence<T> sequence) {
+            this.sequence = sequence;
+            this.size = sequence.size();
+        }
+
+        @Override
+        public boolean hasNext() {
+            return position < size;
+        }
+
+        @Override
+        public T next() {
+            if (position >= size) {
+                throw new NoSuchElementException();
+            }
+            return sequence.get(position++);
+        }
+
+    }
+
+}
