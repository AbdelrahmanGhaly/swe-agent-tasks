+package ai.timefold.solver.core.impl.domain.valuerange;
+
+import java.util.List;
+
+import ai.timefold.solver.core.api.domain.valuerange.ValueRange;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.And;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.Node;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+@NullMarked
+public final class IntersectionValueRange<T> extends AbstractCompositionValueRange<T> {
+
+    private final And<T> node;
+
+    public IntersectionValueRange(List<ValueRange<T>> memberList) {
+        super(memberList);
+        this.node = new And<>(this.memberList.stream().map(AbstractCompositionValueRange::nodeOf).toList());
+    }
+
+    @Override
+    protected ValueSequence<T> buildSequence() {
+        var firstSequence = sequenceOf(memberList.get(0));
+        if (memberList.size() == 1) {
+            return firstSequence;
+        }
+        var otherNodes = memberList.subList(1, memberList.size()).stream()
+                .map(AbstractCompositionValueRange::nodeOf)
+                .toList();
+        return FilteredSequence.of(firstSequence, new And<>(otherNodes));
+    }
+
+    @Override
+    Node<T> node() {
+        return node;
+    }
+
+    @Override
+    public boolean contains(@Nullable T value) {
+        for (var member : memberList) {
+            if (!member.contains(value)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    @Override
+    protected String getOperatorSymbol() {
+        return "∩";
+    }
+
+}
