+package ai.timefold.solver.core.impl.domain.valuerange;
+
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.util.function.Function;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * The values {@code origin + index * step} for every index below {@code count},
+ * expressed as unscaled integers so that the ranges of all numeric types share one arithmetic.
+ */
+@NullMarked
+final class NumericProgression<T> {
+
+    record Numeric(BigInteger unscaled, int scale) {
+    }
+
+    static NumericProgression<Integer> ofInt(int from, int to, int incrementUnit) {
+        return new NumericProgression<>(BigInteger.valueOf(from), BigInteger.valueOf(incrementUnit),
+                (to - (long) from) / incrementUnit, 0, BigInteger::intValueExact,
+                value -> new Numeric(BigInteger.valueOf(value), 0));
+    }
+
+    static NumericProgression<Long> ofLong(long from, long to, long incrementUnit) {
+        return new NumericProgression<>(BigInteger.valueOf(from), BigInteger.valueOf(incrementUnit),
+                (to - from) / incrementUnit, 0, BigInteger::longValueExact,
+                value -> new Numeric(BigInteger.valueOf(value), 0));
+    }
+
+    static NumericProgression<BigInteger> ofBigInteger(BigInteger from, BigInteger to, BigInteger incrementUnit) {
+        return new NumericProgression<>(from, incrementUnit, to.subtract(from).divide(incrementUnit).longValue(), 0,
+                Function.identity(), value -> new Numeric(value, 0));
+    }
+
+    static NumericProgression<BigDecimal> ofBigDecimal(BigDecimal from, BigDecimal to, BigDecimal incrementUnit) {
+        var scale = from.scale();
+        return new NumericProgression<>(from.unscaledValue(), incrementUnit.unscaledValue(),
+                to.unscaledValue().subtract(from.unscaledValue()).divide(incrementUnit.unscaledValue()).longValue(),
+                scale, unscaled -> new BigDecimal(unscaled, scale),
+                value -> new Numeric(value.unscaledValue(), value.scale()));
+    }
+
+    private final BigInteger origin;
+    private final BigInteger step;
+    private final long count;
+    private final int scale;
+    private final Function<BigInteger, T> decoder;
+    private final Function<T, Numeric> encoder;
+
+    private NumericProgression(BigInteger origin, BigInteger step, long count, int scale,
+            Function<BigInteger, T> decoder, Function<T, Numeric> encoder) {
+        this.origin = origin;
+        this.step = step;
+        this.count = count;
+        this.scale = scale;
+        this.decoder = decoder;
+        this.encoder = encoder;
+    }
+
+    long getCount() {
+        return count;
+    }
+
+    T valueAt(long index) {
+        return decoder.apply(origin.add(step.multiply(BigInteger.valueOf(index))));
+    }
+
+    long indexOf(@Nullable T value) {
+        if (value == null) {
+            return -1L;
+        }
+        var numeric = encoder.apply(value);
+        var commonScale = Math.max(scale, numeric.scale());
+        var difference = rescale(numeric.unscaled(), numeric.scale(), commonScale)
+                .subtract(rescale(origin, scale, commonScale));
+        if (difference.signum() < 0) {
+            return -1L;
+        }
+        var quotientAndRemainder = difference.divideAndRemainder(rescale(step, scale, commonScale));
+        if (quotientAndRemainder[1].signum() != 0) {
+            return -1L;
+        }
+        var index = quotientAndRemainder[0];
+        return index.compareTo(BigInteger.valueOf(count)) < 0 ? index.longValue() : -1L;
+    }
+
+    boolean contains(@Nullable T value) {
+        return indexOf(value) >= 0L;
+    }
+
+    NumericProgression<T> prefix(long length) {
+        if (length >= count) {
+            return this;
+        }
+        return new NumericProgression<>(origin, step, Math.max(length, 0L), scale, decoder, encoder);
+    }
+
+    /**
+     * @return the progression made of the values of this progression which the other progression also contains,
+     *         in the representation of this progression
+     */
+    NumericProgression<T> restrict(NumericProgression<T> other) {
+        var commonScale = Math.max(scale, other.scale);
+        var thisOrigin = rescale(origin, scale, commonScale);
+        var thisStep = rescale(step, scale, commonScale);
+        var otherOrigin = rescale(other.origin, other.scale, commonScale);
+        var otherStep = rescale(other.step, other.scale, commonScale);
+        var gcd = thisStep.gcd(otherStep);
+        var offset = otherOrigin.subtract(thisOrigin);
+        if (offset.mod(gcd).signum() != 0) {
+            return empty();
+        }
+        var modulus = otherStep.divide(gcd);
+        var residue = modulus.equals(BigInteger.ONE) ? BigInteger.ZERO
+                : offset.divide(gcd).multiply(thisStep.divide(gcd).modInverse(modulus)).mod(modulus);
+        var lowerBound = ceilDiv(offset, thisStep).max(BigInteger.ZERO);
+        var otherEnd = otherOrigin.add(otherStep.multiply(BigInteger.valueOf(other.count)));
+        var upperBound = ceilDiv(otherEnd.subtract(thisOrigin), thisStep).min(BigInteger.valueOf(count));
+        if (lowerBound.compareTo(upperBound) >= 0) {
+            return empty();
+        }
+        var start = lowerBound.add(residue.subtract(lowerBound).mod(modulus));
+        if (start.compareTo(upperBound) >= 0) {
+            return empty();
+        }
+        var restrictedCount = upperBound.subtract(BigInteger.ONE).subtract(start).divide(modulus).add(BigInteger.ONE);
+        return new NumericProgression<>(origin.add(step.multiply(start)), step.multiply(modulus),
+                restrictedCount.longValue(), scale, decoder, encoder);
+    }
+
+    private NumericProgression<T> empty() {
+        return new NumericProgression<>(origin, step, 0L, scale, decoder, encoder);
+    }
+
+    private static BigInteger rescale(BigInteger unscaled, int fromScale, int toScale) {
+        return unscaled.multiply(BigInteger.TEN.pow(toScale - fromScale));
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) {
+            return true;
+        }
+        return o instanceof NumericProgression<?> that &&
+                count == that.count &&
+                scale == that.scale &&
+                origin.equals(that.origin) &&
+                step.equals(that.step);
+    }
+
+    @Override
+    public int hashCode() {
+        var hash = 1;
+        hash = 31 * hash + Long.hashCode(count);
+        hash = 31 * hash + Integer.hashCode(scale);
+        hash = 31 * hash + origin.hashCode();
+        return 31 * hash + step.hashCode();
+    }
+
+    private static BigInteger ceilDiv(BigInteger dividend, BigInteger positiveDivisor) {
+        var quotientAndRemainder = dividend.divideAndRemainder(positiveDivisor);
+        return quotientAndRemainder[1].signum() > 0 ? quotientAndRemainder[0].add(BigInteger.ONE)
+                : quotientAndRemainder[0];
+    }
+
+}
