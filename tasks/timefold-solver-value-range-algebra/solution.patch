+package ai.timefold.solver.core.impl.domain.valuerange;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+
+import ai.timefold.solver.core.api.domain.valuerange.ValueRange;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Set expressions over value ranges, and the number of values of a {@link NumericProgression}
+ * which such an expression contains, computed without visiting the values of the progression.
+ */
+@NullMarked
+final class ValueSetAlgebra {
+
+    sealed interface Node<T> permits Leaf, Finite, All, And, Or, Minus {
+    }
+
+    record Leaf<T>(NumericProgression<T> progression) implements Node<T> {
+    }
+
+    record Finite<T>(ValueRange<T> valueRange) implements Node<T> {
+    }
+
+    record All<T>() implements Node<T> {
+    }
+
+    record And<T>(List<Node<T>> members) implements Node<T> {
+    }
+
+    record Or<T>(List<Node<T>> members) implements Node<T> {
+    }
+
+    record Minus<T>(Node<T> included, Node<T> excluded) implements Node<T> {
+    }
+
+    private record CountKey(NumericProgression<?> progression, Node<?> node) {
+    }
+
+    private ValueSetAlgebra() {
+    }
+
+    static <T> boolean contains(Node<T> node, @Nullable T value) {
+        return switch (node) {
+            case Leaf<T> leaf -> leaf.progression().contains(value);
+            case Finite<T> finite -> finite.valueRange().contains(value);
+            case All<T> all -> true;
+            case And<T> and -> and.members().stream().allMatch(member -> contains(member, value));
+            case Or<T> or -> or.members().stream().anyMatch(member -> contains(member, value));
+            case Minus<T> minus -> contains(minus.included(), value) && !contains(minus.excluded(), value);
+        };
+    }
+
+    static <T> long count(NumericProgression<T> progression, Node<T> node) {
+        return count(progression, node, new HashMap<>());
+    }
+
+    /**
+     * Equal subexpressions recur across the segments of a union,
+     * so every result is memoized for the duration of the top-level count.
+     */
+    private static <T> long count(NumericProgression<T> progression, Node<T> node, Map<CountKey, Long> memo) {
+        if (progression.getCount() == 0L) {
+            return 0L;
+        }
+        var key = new CountKey(progression, node);
+        var memoized = memo.get(key);
+        if (memoized != null) {
+            return memoized;
+        }
+        var count = switch (node) {
+            case Leaf<T> leaf -> progression.restrict(leaf.progression()).getCount();
+            case Finite<T> finite -> countFinite(progression, finite, List.of());
+            case All<T> all -> progression.getCount();
+            case And<T> and -> countIntersection(progression, and.members(), memo);
+            case Or<T> or -> countUnion(progression, or.members(), memo);
+            case Minus<T> minus -> count(progression, minus.included(), memo)
+                    - count(progression, new And<>(List.of(minus.included(), minus.excluded())), memo);
+        };
+        memo.put(key, count);
+        return count;
+    }
+
+    private static <T> long countUnion(NumericProgression<T> progression, List<Node<T>> members,
+            Map<CountKey, Long> memo) {
+        var distinctMembers = distinct(members);
+        if (distinctMembers.isEmpty()) {
+            return 0L;
+        }
+        for (var member : distinctMembers) {
+            if (coversAll(progression, member)) {
+                return progression.getCount();
+            }
+        }
+        var first = distinctMembers.get(0);
+        if (distinctMembers.size() == 1) {
+            return count(progression, first, memo);
+        }
+        var rest = new Or<>(distinctMembers.subList(1, distinctMembers.size()));
+        return count(progression, first, memo) + count(progression, rest, memo)
+                - count(progression, new And<>(List.of(first, rest)), memo);
+    }
+
+    private static <T> long countIntersection(NumericProgression<T> progression, List<Node<T>> members,
+            Map<CountKey, Long> memo) {
+        var flattened = new ArrayList<Node<T>>();
+        for (var member : distinct(flattenIntersection(members))) {
+            if (!coversAll(progression, member)) {
+                flattened.add(member);
+            }
+        }
+        if (flattened.isEmpty()) {
+            return progression.getCount();
+        }
+        for (var member : flattened) {
+            if (member instanceof Finite<T> finite) {
+                var others = new ArrayList<>(flattened);
+                others.remove(finite);
+                return countFinite(progression, finite, others);
+            }
+        }
+        var first = flattened.get(0);
+        var rest = flattened.subList(1, flattened.size());
+        return switch (first) {
+            case Leaf<T> leaf -> count(progression.restrict(leaf.progression()), new And<>(rest), memo);
+            case Or<T> or -> countUnion(progression, or.members().stream()
+                    .map(member -> (Node<T>) new And<>(prepend(member, rest)))
+                    .toList(), memo);
+            case Minus<T> minus -> count(progression,
+                    new Minus<>(new And<>(prepend(minus.included(), rest)), minus.excluded()), memo);
+            case Finite<T> finite -> throw new IllegalStateException("Impossible state: finite member not handled.");
+            case All<T> all -> throw new IllegalStateException("Impossible state: universal member not flattened.");
+            case And<T> and -> throw new IllegalStateException("Impossible state: nested intersection not flattened.");
+        };
+    }
+
+    private static <T> List<Node<T>> flattenIntersection(List<Node<T>> members) {
+        var flattened = new ArrayList<Node<T>>(members.size());
+        for (var member : members) {
+            if (member instanceof And<T> and) {
+                flattened.addAll(flattenIntersection(and.members()));
+            } else if (!(member instanceof All<T>)) {
+                flattened.add(member);
+            }
+        }
+        return flattened;
+    }
+
+    /**
+     * @return true if every value of the progression belongs to the node,
+     *         which makes the node redundant in an intersection and decisive in a union
+     */
+    private static <T> boolean coversAll(NumericProgression<T> progression, Node<T> node) {
+        return switch (node) {
+            case All<T> all -> true;
+            case Leaf<T> leaf -> progression.restrict(leaf.progression()).getCount() == progression.getCount();
+            case And<T> and -> and.members().stream().allMatch(member -> coversAll(progression, member));
+            case Or<T> or -> or.members().stream().anyMatch(member -> coversAll(progression, member));
+            default -> false;
+        };
+    }
+
+    private static <T> List<Node<T>> distinct(List<Node<T>> members) {
+        var seen = new HashSet<Node<T>>(members.size());
+        var distinctMembers = new ArrayList<Node<T>>(members.size());
+        for (var member : members) {
+            if (seen.add(member)) {
+                distinctMembers.add(member);
+            }
+        }
+        return distinctMembers;
+    }
+
+    private static <T> List<Node<T>> prepend(Node<T> first, List<Node<T>> rest) {
+        var list = new ArrayList<Node<T>>(rest.size() + 1);
+        list.add(first);
+        list.addAll(rest);
+        return list;
+    }
+
+    private static <T> long countFinite(NumericProgression<T> progression, Finite<T> finite, List<Node<T>> others) {
+        var countedIndexSet = new HashSet<Long>();
+        var count = 0L;
+        var iterator = finite.valueRange().createOriginalIterator();
+        while (iterator.hasNext()) {
+            var index = progression.indexOf(iterator.next());
+            if (index < 0L || !countedIndexSet.add(index)) {
+                continue;
+            }
+            var value = progression.valueAt(index);
+            var contained = finite.valueRange().contains(value);
+            for (var other : others) {
+                if (!contained) {
+                    break;
+                }
+                if (!contains(other, value)) {
+                    contained = false;
+                    break;
+                }
+            }
+            if (contained) {
+                count++;
+            }
+        }
+        return count;
+    }
+
+}
