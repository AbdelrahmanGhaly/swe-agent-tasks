+package ai.timefold.solver.core.impl.domain.valuerange;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+
+import ai.timefold.solver.core.api.domain.valuerange.ValueRange;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.Finite;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.Node;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * A sequence which holds its distinct values in memory, in the order they were first produced.
+ */
+@NullMarked
+final class ListSequence<T> implements ValueSequence<T> {
+
+    static <T> ListSequence<T> ofRange(ValueRange<T> valueRange) {
+        var values = new ArrayList<T>();
+        var positionMap = new HashMap<T, Long>();
+        var iterator = valueRange.createOriginalIterator();
+        while (iterator.hasNext()) {
+            var value = iterator.next();
+            if (positionMap.putIfAbsent(value, (long) values.size()) == null) {
+                values.add(value);
+            }
+        }
+        return new ListSequence<>(values, positionMap, new Finite<>(valueRange));
+    }
+
+    static <T> ListSequence<T> ofDistinctValues(List<T> values) {
+        var positionMap = new HashMap<T, Long>();
+        for (var value : values) {
+            positionMap.put(value, (long) positionMap.size());
+        }
+        return new ListSequence<>(values, positionMap, new Finite<>(new ListValueRange<>(values)));
+    }
+
+    private final List<T> values;
+    private final Map<T, Long> positionMap;
+    private final Finite<T> finite;
+
+    private ListSequence(List<T> values, Map<T, Long> positionMap, Finite<T> finite) {
+        this.values = values;
+        this.positionMap = positionMap;
+        this.finite = finite;
+    }
+
+    List<T> getValues() {
+        return values;
+    }
+
+    @Override
+    public long size() {
+        return values.size();
+    }
+
+    @Override
+    public T get(long position) {
+        return values.get((int) position);
+    }
+
+    @Override
+    public long positionOf(@Nullable T value) {
+        var position = positionMap.get(value);
+        return position == null ? -1L : position;
+    }
+
+    @Override
+    public long countInPrefix(Node<T> node, long prefixLength) {
+        var end = (int) Math.min(prefixLength, values.size());
+        var count = 0L;
+        for (var i = 0; i < end; i++) {
+            if (ValueSetAlgebra.contains(node, values.get(i))) {
+                count++;
+            }
+        }
+        return count;
+    }
+
+    @Override
+    public Node<T> node() {
+        return finite;
+    }
+
+    @Override
+    public Iterator<T> iterator() {
+        return values.iterator();
+    }
+
+}
