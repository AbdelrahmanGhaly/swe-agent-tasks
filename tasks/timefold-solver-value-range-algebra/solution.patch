+package ai.timefold.solver.core.impl.domain.valuerange;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.And;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.Node;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * The values of a base sequence, in their order, which a set expression contains.
+ */
+@NullMarked
+final class FilteredSequence<T> implements ValueSequence<T> {
+
+    static <T> ValueSequence<T> of(ValueSequence<T> base, Node<T> keep) {
+        if (base instanceof ListSequence<T> listSequence) {
+            var kept = new ArrayList<T>();
+            for (var value : listSequence.getValues()) {
+                if (ValueSetAlgebra.contains(keep, value)) {
+                    kept.add(value);
+                }
+            }
+            return ListSequence.ofDistinctValues(kept);
+        }
+        return new FilteredSequence<>(base, keep);
+    }
+
+    private final ValueSequence<T> base;
+    private final Node<T> keep;
+    private final And<T> node;
+    private long size = -1L;
+
+    private FilteredSequence(ValueSequence<T> base, Node<T> keep) {
+        this.base = base;
+        this.keep = keep;
+        this.node = new And<>(List.of(base.node(), keep));
+    }
+
+    @Override
