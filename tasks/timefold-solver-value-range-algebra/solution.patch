+package ai.timefold.solver.core.impl.domain.valuerange;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import ai.timefold.solver.core.api.domain.valuerange.ValueRange;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.All;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.Minus;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.Node;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.Or;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+@NullMarked
+public final class UnionValueRange<T> extends AbstractCompositionValueRange<T> {
+
+    private final Or<T> node;
+
+    public UnionValueRange(List<ValueRange<T>> memberList) {
+        super(memberList);
+        this.node = new Or<>(this.memberList.stream().map(AbstractCompositionValueRange::nodeOf).toList());
+    }
+
+    @Override
+    protected ValueSequence<T> buildSequence() {
+        var segments = new ArrayList<ValueSequence<T>>(memberList.size());
+        var earlierNodes = new ArrayList<Node<T>>(memberList.size());
+        for (var member : memberList) {
+            var memberSequence = sequenceOf(member);
+            if (earlierNodes.isEmpty()) {
+                segments.add(memberSequence);
+            } else {
+                segments.add(FilteredSequence.of(memberSequence,
+                        new Minus<>(new All<>(), new Or<>(List.copyOf(earlierNodes)))));
+            }
+            earlierNodes.add(nodeOf(member));
+        }
+        return ConcatSequence.of(segments);
+    }
+
+    @Override
+    Node<T> node() {
+        return node;
+    }
+
+    @Override
+    public boolean contains(@Nullable T value) {
+        for (var member : memberList) {
+            if (member.contains(value)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    @Override
+    protected String getOperatorSymbol() {
+        return "∪";
+    }
+
+}
