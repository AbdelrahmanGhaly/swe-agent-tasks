@@ -0,0 +1,87 @@
+package ai.timefold.solver.core.impl.domain.valuerange;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.Node;
+import ai.timefold.solver.core.impl.domain.valuerange.ValueSetAlgebra.Or;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * The values of several disjoint sequences, one sequence after the other.
+ */
+@NullMarked
+final class ConcatSequence<T> implements ValueSequence<T> {
+
+    static <T> ValueSequence<T> of(List<ValueSequence<T>> segments) {
+        var nonEmptySegments = new ArrayList<ValueSequence<T>>(segments.size());
+        for (var segment : segments) {
+            if (segment.size() > 0L) {
+                nonEmptySegments.add(segment);
+            }
+        }
+        if (nonEmptySegments.size() == 1) {
+            return nonEmptySegments.get(0);
+        }
+        return new ConcatSequence<>(nonEmptySegments);
+    }
+
+    private final List<ValueSequence<T>> segments;
+    private final long[] offsets;
+    private final long size;
+    private final Or<T> node;
+
+    private ConcatSequence(List<ValueSequence<T>> segments) {
+        this.segments = segments;
+        this.offsets = new long[segments.size()];
+        var total = 0L;
+        for (var i = 0; i < segments.size(); i++) {
+            offsets[i] = total;
+            total = Math.addExact(total, segments.get(i).size());
+        }
+        this.size = total;
+        this.node = new Or<>(segments.stream().map(ValueSequence::node).toList());
+    }
+
+    @Override
+    public long size() {
+        return size;
+    }
+
+    @Override
+    public T get(long position) {
+        var segmentIndex = segments.size() - 1;
+        while (segmentIndex > 0 && offsets[segmentIndex] > position) {
+            segmentIndex--;
+        }
+        return segments.get(segmentIndex).get(position - offsets[segmentIndex]);
+    }
+
+    @Override
+    public long positionOf(@Nullable T value) {
+        for (var i = 0; i < segments.size(); i++) {
+            var position = segments.get(i).positionOf(value);
+            if (position >= 0L) {
+                return offsets[i] + position;
+            }
+        }
+        return -1L;
+    }
+
+    @Override
+    public long countInPrefix(Node<T> other, long prefixLength) {
+        var count = 0L;
+        for (var i = 0; i < segments.size() && offsets[i] < prefixLength; i++) {
+            count += segments.get(i).countInPrefix(other, prefixLength - offsets[i]);
+        }
+        return count;
+    }
+
+    @Override
+    public Node<T> node() {
+        return node;
+    }
+
+}
