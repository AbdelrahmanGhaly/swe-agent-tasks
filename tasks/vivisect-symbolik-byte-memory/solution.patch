+class RepeatEffect(SymbolikEffect):
+    '''
+    RepeatEffect represents effects which run as many times as the count
+    variable holds when they are applied (such as a rep prefixed string
+    instruction), after which the count variable is zero.  A count which is
+    not discrete runs the effects once.
+
+    Applying a RepeatEffect returns the list of every applied effect.
+    '''
+    efftype = EFFTYPE_REPEAT
+
+    def __init__(self, va, countsym, effects):
+        SymbolikEffect.__init__(self, va)
+        self.countsym = countsym
+        self.effects = effects
+
+    def __repr__(self):
+        return 'RepeatEffect( 0x%.8x, %s, %s )' % (self.va, repr(self.countsym), repr(self.effects))
+
+    def __str__(self):
+        return 'repeat %s { %s }' % (str(self.countsym), '; '.join(str(eff) for eff in self.effects))
+
+    def __eq__(self, other):
+        if other is None:
+            return False
+        if self.__class__ != other.__class__:
+            return False
+        if not self.countsym == other.countsym:
+            return False
+        if not self.effects == other.effects:
+            return False
+
+        return True
+
+    def walkTree(self, cb, ctx=None, once=True):
+        self.countsym = self.countsym.walkTree(cb, ctx=ctx, once=once)
+        for eff in self.effects:
+            eff.walkTree(cb, ctx=ctx, once=once)
+
+    def reduce(self, emu=None):
+        self.countsym = self.countsym.reduce(emu=emu)
+        for eff in self.effects:
+            eff.reduce(emu=emu)
+
+    def applyEffect(self, emu):
+        count = self.countsym.update(emu)
+        if not count.isDiscrete():
+            return emu.applyEffects(self.effects)
+
+        applied = []
+        for i in range(count.solve()):
+            applied.extend(emu.applyEffects(self.effects))
+
+        zero = SetVariable(self.va, self.countsym.name, Const(0, self.countsym.getWidth()))
+        applied.append(zero.applyEffect(emu))
+        return applied
+
 class ConstrainPath(SymbolikEffect):
 
     efftype = EFFTYPE_CONSTRAIN
