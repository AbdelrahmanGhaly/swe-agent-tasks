+import unittest
+
+import envi.const as e_const
+
+import vivisect
+import vivisect.const as v_const
+
+from vivisect.analysis.generic.symswitchcase import TrackingSymbolikEmulator
+from vivisect.symboliks.common import Const, Var, Mem
+
+
+TABLE = 0x402000
+DATA = bytes(range(0x10, 0x30))
+EAX = 0x11223344
+VALS = {'eax': EAX}
+
+
+def workspace():
+    vw = vivisect.VivWorkspace()
+    vw.setMeta('Architecture', 'i386')
+    vw.setMeta('Platform', 'windows')
+    vw.setMeta('Format', 'blob')
+    vw.addMemoryMap(TABLE, e_const.MM_READ, 'test', DATA)
+    return vw
+
+
+def addr(va):
+    return Const(va, 4)
+
+
+def plain(va, size):
+    return Mem(addr(va), Const(size, 4)).solve()
+
+
+class TrackingEmulatorMemoryTest(unittest.TestCase):
+
+    def setUp(self):
+        self.vw = workspace()
+        self.emu = TrackingSymbolikEmulator(self.vw)
+
+    def read(self, va, size, vals=VALS):
+        sym = self.emu.readSymMemory(addr(va), Const(size, 4))
+        self.assertEqual(sym.getWidth(), size)
+        return sym.solve(vals=vals)
+
+    def test_written_byte_inside_mapped_memory(self):
+        self.assertEqual(self.read(TABLE + 4, 4), 0x17161514)
+        self.emu.writeSymMemory(addr(TABLE + 5), Const(0x41, 1))
+        self.assertEqual(self.read(TABLE + 4, 4), 0x17164114)
+        self.assertEqual(self.read(TABLE + 5, 2), 0x1641)
+
+    def test_written_dword_read_back_in_pieces(self):
+        self.emu.writeSymMemory(addr(TABLE), Var('eax', 4))
+        self.assertEqual(self.read(TABLE + 2, 1), 0x22)
+        self.assertEqual(self.read(TABLE + 2, 4), 0x15141122)
+        self.assertEqual(repr(self.emu.readSymMemory(addr(TABLE), Const(4, 4))), repr(Var('eax', 4)))
+
