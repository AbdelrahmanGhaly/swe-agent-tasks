+import re
+import binascii
+import unittest
+
+import envi.const as e_const
+import envi.memcanvas as e_mcanvas
+
+import vivisect
+import vivisect.cli as viv_cli
+import vivisect.symboliks.analysis as vsym_analysis
+
+from vivisect.symboliks.common import Const
+
+
+FVA = 0x401000
+ARG0 = 0x11223344
+ARG1 = 0x55667788
+ARG4 = 0x0123456789abcdef
+VALS = {'arg0': ARG0, 'arg1': ARG1, 'arg4': ARG4}
+
+BRANCHY = (
+    '8b442404'
+    '894424f8'
+    'c64424f941'
+    '85c9'
+    '7405'
+    'c64424fa42'
+    '8b4424f8'
+    'c3'
+)
+
+
+def workspace(arch, hexcode, cconv='cdecl', argc=2, vw=None):
+    code = binascii.unhexlify(hexcode)
+    if vw is None:
+        vw = vivisect.VivWorkspace()
+    vw.setMeta('Architecture', arch)
+    vw.setMeta('Platform', 'windows')
+    vw.setMeta('Format', 'blob')
+    vw.addMemoryMap(FVA, e_const.MM_RWX, 'test', code)
+    vw.addSegment(FVA, len(code), '.text', 'test')
+    vw.addFuncAnalysisModule('vivisect.analysis.generic.codeblocks')
+    vw.makeFunction(FVA)
+    vw.setFunctionApi(FVA, ('int', None, cconv, 'func', [('int', None)] * argc))
+    return vw
+
+
+def returns(arch, hexcode, cconv='cdecl', argc=2):
+    vw = workspace(arch, hexcode, cconv=cconv, argc=argc)
+    ctx = vsym_analysis.getSymbolikAnalysisContext(vw)
+    return sorted(emu.getFunctionReturn().solve(vals=VALS) for emu, effs in ctx.getSymbolikPaths(FVA))
+
+
+class SymbolikPathMemoryTest(unittest.TestCase):
+
+    def test_paths_of_a_branching_function(self):
+        self.assertEqual(returns('i386', BRANCHY), [0x11224144, 0x11424144])
+
+    def test_walked_paths_of_a_branching_function(self):
+        vw = workspace('i386', BRANCHY)
+        ctx = vsym_analysis.getSymbolikAnalysisContext(vw)
+        rets = []
+        bytes6 = []
+        for emu, effs in ctx.walkSymbolikPaths(FVA):
+            rets.append(emu.getFunctionReturn().solve(vals=VALS))
+            byte6 = emu.readSymMemory(Const(0xbfbfeffa, 4), Const(1, 4))
+            bytes6.append(byte6.solve(vals=VALS))
+        self.assertEqual(sorted(rets), [0x11224144, 0x11424144])
+        self.assertEqual(sorted(bytes6), [0x22, 0x42])
+
+    def test_walked_path_memory_does_not_leak_between_paths(self):
+        vw = workspace('i386', BRANCHY)
+        ctx = vsym_analysis.getSymbolikAnalysisContext(vw)
+        seen = {}
+        for emu, effs in ctx.walkSymbolikPaths(FVA):
+            ret = emu.getFunctionReturn().solve(vals=VALS)
+            word = emu.readSymMemory(Const(0xbfbfeff9, 4), Const(2, 4))
+            seen[ret] = word.solve(vals=VALS)
+        self.assertEqual(seen, {0x11224144: 0x2241, 0x11424144: 0x4241})
+
+    def test_byte_of_an_argument(self):
+        self.assertEqual(returns('i386', '0fb6442405' 'c3'), [(ARG0 >> 8) & 0xff])
+
+    def test_word_of_an_argument(self):
+        self.assertEqual(returns('i386', '0fb7442406' 'c3'), [ARG0 >> 16])
+
+    def test_read_straddling_two_arguments(self):
+        self.assertEqual(returns('i386', '8b442406' 'c3'), [(ARG0 >> 16) | ((ARG1 & 0xffff) << 16)])
+
+    def test_function_patching_a_byte_of_its_argument(self):
+        self.assertEqual(returns('i386', 'c64424057f' '8b442404' 'c3'), [(ARG0 & 0xffff00ff) | 0x7f00])
+
+    def test_stdcall_argument_bytes(self):
+        self.assertEqual(returns('i386', '8a442407' '0fb6c0' 'c20800', cconv='stdcall'), [ARG0 >> 24])
+
+    def test_amd64_spilled_register_argument(self):
+        code = '48897c24f8' 'c64424f941' '488b4424f8' 'c3'
+        self.assertEqual(returns('amd64', code, cconv='sysvamd64call', argc=1), [(ARG0 & ~0xff00) | 0x4100])
+
+    def test_amd64_stack_argument_bytes(self):
+        self.assertEqual(returns('amd64', '0fb744242a' 'c3', cconv='msx64call', argc=5), [(ARG4 >> 16) & 0xffff])
+        self.assertEqual(returns('amd64', '8b44242c' 'c3', cconv='msx64call', argc=5), [ARG4 >> 32])
+
+    def test_outputs_include_every_repeated_store(self):
+        vw = workspace('i386', '8b7c2404' 'fc' 'b902000000' 'b841414141' 'f3ab' 'c3', argc=1)
+        ctx = vsym_analysis.getSymbolikAnalysisContext(vw)
+        outputs = list(ctx.getSymbolikOutputs(FVA))
+        self.assertEqual(len(outputs), 1)
+        ret, writes = outputs[0]
+        self.assertEqual(ret.solve(vals=VALS), 0x41414141)
+        self.assertEqual([eff.symaddr.solve(vals=VALS) for eff in writes], [ARG0, ARG0 + 4])
+        self.assertEqual([eff.symval.solve(vals=VALS) for eff in writes], [0x41414141, 0x41414141])
+
+    def test_walked_paths_apply_repeated_stores(self):
+        code = '8b7c2404' 'fc' 'b903000000' 'b841424344' 'f3aa' '8b442404' '8b00' 'c3'
+        vw = workspace('i386', code, argc=1)
+        ctx = vsym_analysis.getSymbolikAnalysisContext(vw)
+        rets = [emu.getFunctionReturn().solve(vals=VALS) for emu, effs in ctx.walkSymbolikPaths(FVA)]
+        self.assertEqual(len(rets), 1)
+        self.assertEqual(rets[0] & 0x00ffffff, 0x414141)
+
+    def test_cli_symboliks_lists_every_repeated_store(self):
+        code = 'bf00204000' 'b903000000' 'b041' 'fc' 'f3aa' 'c3'
+        vw = workspace('i386', code, argc=0, vw=viv_cli.VivCli())
+        vw.canvas = e_mcanvas.StringMemoryCanvas(vw)
+        vw.do_symboliks('0x%x' % FVA)
+        out = vw.canvas.strval
+        self.assertIn('RETURN', out)
+        writes = sorted(int(va, 16) for va in re.findall(r'\[ (0x[0-9a-fA-F]+) \]', out))
+        self.assertEqual(writes, [0x402000, 0x402001, 0x402002])
+
+    def test_cli_symboliks_lists_the_writes_of_each_path(self):
+        code = 'bf00204000' 'b041' 'fc' '85c9' '7407' 'b902000000' 'f3aa' 'c6050030400042' 'c3'
+        vw = workspace('i386', code, argc=0, vw=viv_cli.VivCli())
+        vw.canvas = e_mcanvas.StringMemoryCanvas(vw)
+        vw.do_symboliks('0x%x' % FVA)
+        paths = vw.canvas.strval.split('PATH ')[1:]
+        writes = sorted(sorted(int(va, 16) for va in re.findall(r'\[ (0x[0-9a-fA-F]+) \]', path)) for path in paths)
+        self.assertEqual(writes, [[0x402000, 0x402001, 0x403000], [0x403000]])
