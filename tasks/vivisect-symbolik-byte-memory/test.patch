index 00000000..b6221dd2
--- /dev/null
+++ b/vivisect/symboliks/tests/test_bytemem_9ebbd4.py
@@ -0,0 +1,418 @@
+import unittest
+
+import vivisect.const as v_const
+
+from vivisect.symboliks.common import Const, Var, Mem
+from vivisect.symboliks.effects import WriteMemory, SetVariable
+from vivisect.symboliks.tests.helpers import MockEmulator
+
+from vivisect.tests.helpers import MockVw
+
+
+EAX = 0x11223344
+EBX = 0x55667788
+ECX = 0x99aabbcc
+AX = 0xabcd
+XMM0 = 0x00112233445566778899aabbccddeeff
+
+VALS = {'eax': EAX, 'ebx': EBX, 'ecx': ECX, 'ax': AX, 'xmm0': XMM0}
+
+
+def sp(off):
+    return Var('esp', 4) + Const(off, 4)
+
+
+def plain(addr, size):
+    return Mem(addr, Const(size, 4)).solve()
+
+
+def mask(size):
+    return (1 << (size * 8)) - 1
+
+
+class ByteMemoryTest(unittest.TestCase):
+
+    def setUp(self):
+        self.vw = MockVw()
+        self.emu = MockEmulator(self.vw)
+
+    def value(self, addr, size, emu=None):
+        emu = emu or self.emu
+        sym = emu.readSymMemory(addr, Const(size, 4))
+        self.assertIsNotNone(sym)
+        self.assertEqual(sym.getWidth(), size)
+        return sym.solve(vals=VALS)
+
+    def test_byte_reads_inside_a_dword_write(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.assertEqual(self.value(sp(0), 1), 0x44)
+        self.assertEqual(self.value(sp(1), 1), 0x33)
+        self.assertEqual(self.value(sp(2), 1), 0x22)
+        self.assertEqual(self.value(sp(3), 1), 0x11)
+
+    def test_word_reads_at_every_offset_of_a_dword_write(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.assertEqual(self.value(sp(0), 2), 0x3344)
+        self.assertEqual(self.value(sp(1), 2), 0x2233)
+        self.assertEqual(self.value(sp(2), 2), 0x1122)
+
+    def test_byte_store_into_a_stored_dword(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.emu.writeSymMemory(sp(1), Const(0x41, 4), symsize=1)
+        self.assertEqual(self.value(sp(0), 4), 0x11224144)
+        self.assertEqual(self.value(sp(0), 2), 0x4144)
+        self.assertEqual(self.value(sp(2), 2), 0x1122)
+
+    def test_three_overlapping_writes_keep_the_most_recent_byte(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.emu.writeSymMemory(sp(2), Const(0xbeef, 2))
+        self.emu.writeSymMemory(sp(1), Const(0x5a, 1))
+        self.assertEqual(self.value(sp(0), 4), 0xbeef5a44)
+        self.assertEqual(self.value(sp(1), 2), 0xef5a)
+        self.assertEqual(self.value(sp(3), 1), 0xbe)
+
+    def test_older_bytes_survive_between_newer_writes(self):
+        self.emu.writeSymMemory(sp(0), Var('ebx', 4))
+        self.emu.writeSymMemory(sp(4), Var('ecx', 4))
+        self.emu.writeSymMemory(sp(2), Var('eax', 4))
+        self.emu.writeSymMemory(sp(3), Const(0x99, 1))
+        self.assertEqual(self.value(sp(0), 8), 0x99aa112299447788)
+        self.assertEqual(self.value(sp(2), 4), 0x11229944)
+
+    def test_rewriting_the_same_start_hides_an_inner_byte(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.emu.writeSymMemory(sp(1), Const(0x41, 1))
+        self.emu.writeSymMemory(sp(0), Var('ebx', 4))
+        self.assertEqual(repr(self.emu.readSymMemory(sp(0), Const(4, 4))), repr(Var('ebx', 4)))
+        self.assertEqual(self.value(sp(1), 1), 0x77)
+        self.assertEqual(self.value(sp(0), 4), EBX)
+
+    def test_shorter_rewrite_at_the_same_start(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.emu.writeSymMemory(sp(0), Const(0x99, 1))
+        self.assertEqual(self.value(sp(0), 4), 0x11223399)
+        self.assertEqual(self.value(sp(0), 1), 0x99)
+
+    def test_read_spanning_two_adjacent_writes(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.emu.writeSymMemory(sp(4), Var('ebx', 4))
+        self.assertEqual(self.value(sp(0), 8), (EBX << 32) | EAX)
+        self.assertEqual(self.value(sp(2), 4), ((EBX & 0xffff) << 16) | (EAX >> 16))
+        self.assertEqual(self.value(sp(3), 2), ((EBX & 0xff) << 8) | (EAX >> 24))
+
+    def test_exact_match_returns_the_written_value_itself(self):
+        self.emu.writeSymMemory(sp(8), Var('ecx', 4))
+        self.emu.writeSymMemory(sp(12), Var('ax', 2), symsize=2)
+        self.assertEqual(repr(self.emu.readSymMemory(sp(8), Const(4, 4))), repr(Var('ecx', 4)))
+        self.assertEqual(repr(self.emu.readSymMemory(sp(12), Const(2, 4))), repr(Var('ax', 2)))
+        self.assertEqual(self.value(sp(9), 2), 0xaabb)
+
+    def test_wider_value_is_cut_to_its_write_size(self):
+        self.emu.writeSymMemory(sp(0), Const(0x12345678, 4), symsize=1)
+        self.assertEqual(self.value(sp(0), 1), 0x78)
+        self.assertEqual(self.value(sp(0), 4), 0x78 | (plain(sp(0), 4) & 0xffffff00))
+
+    def test_wider_symbolik_value_is_cut_to_its_write_size(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4), symsize=2)
+        self.assertEqual(self.value(sp(0), 2), 0x3344)
+        self.assertEqual(self.value(sp(0), 4), 0x3344 | (plain(sp(0), 4) & 0xffff0000))
+
+    def test_narrower_value_is_zero_extended_to_its_write_size(self):
+        self.emu.writeSymMemory(sp(0), Var('ax', 2), symsize=4)
+        self.assertEqual(self.value(sp(0), 4), AX)
+        self.assertEqual(self.value(sp(3), 1), 0)
+        self.assertEqual(self.value(sp(1), 2), AX >> 8)
+
+    def test_write_size_defaults_to_the_value_width(self):
+        self.emu.writeSymMemory(sp(0), Var('ax', 2))
+        self.assertEqual(self.value(sp(0), 4), AX | (plain(sp(0), 4) & 0xffff0000))
+        self.assertEqual(repr(self.emu.readSymMemory(sp(0), Const(2, 4))), repr(Var('ax', 2)))
+
+    def test_symsize_accepts_ints_and_symboliks(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4), symsize=2)
+        self.emu.writeSymMemory(sp(8), Var('ebx', 4), symsize=Const(1, 4))
+        self.assertEqual(self.value(sp(0), 2), 0x3344)
+        self.assertEqual(self.value(sp(8), 2), 0x88 | (plain(sp(8), 2) & 0xff00))
+
+    def test_unwritten_bytes_below_written_bytes(self):
+        self.emu.writeSymMemory(sp(3), Const(0x41, 1))
+        self.assertEqual(self.value(sp(0), 4), (0x41 << 24) | (plain(sp(0), 4) & 0x00ffffff))
+
+    def test_unwritten_bytes_around_a_written_byte(self):
+        self.emu.writeSymMemory(sp(1), Const(0x5a, 1))
+        self.assertEqual(self.value(sp(0), 4), (0x5a << 8) | (plain(sp(0), 4) & 0xffff00ff))
+        self.assertEqual(self.value(sp(1), 2), 0x5a | (plain(sp(1), 2) & 0xff00))
+
+    def test_unwritten_bytes_between_two_writes(self):
+        self.emu.writeSymMemory(sp(0), Const(0x11, 1))
+        self.emu.writeSymMemory(sp(3), Const(0x44, 1))
+        self.assertEqual(self.value(sp(0), 4), 0x44000011 | (plain(sp(0), 4) & 0x00ffff00))
+
+    def test_read_with_no_written_byte_is_none(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.assertIsNone(self.emu.readSymMemory(sp(4), Const(4, 4)))
+        self.assertIsNone(self.emu.readSymMemory(Var('esp', 4) - Const(4, 4), Const(4, 4)))
+        self.assertEqual(self.value(sp(2), 4), (EAX >> 16) | (plain(sp(2), 4) & 0xffff0000))
+
+    def test_import_slot_answers_only_when_nothing_was_written(self):
+        self.vw._addLocation(0x1000, 4, v_const.LOC_IMPORT, 'kernel32.CreateFileA')
+        slot = Const(0x1000, 4)
+        self.assertEqual(repr(self.emu.readSymMemory(slot, Const(4, 4))), repr(Var('kernel32.CreateFileA', 4)))
+        self.emu.writeSymMemory(Const(0x1001, 4), Const(0x41, 1))
+        self.assertEqual(self.value(slot, 4), 0x4100 | (plain(slot, 4) & 0xffff00ff))
+
+    def test_values_that_are_not_symboliks_keep_exact_address_reads(self):
+        self.emu.writeSymMemory(sp(0), 'opaque')
+        self.assertEqual(self.emu.readSymMemory(sp(0), Const(4, 4)), 'opaque')
+        self.assertEqual(self.emu.readSymMemory(sp(0), 1024), 'opaque')
+        self.assertIsNone(self.emu.readSymMemory(sp(1), Const(1, 4)))
+        self.emu.writeSymMemory(sp(0), Const(0x41, 4), symsize=1)
+        self.assertEqual(self.value(sp(0), 1), 0x41)
+        self.assertEqual(self.value(sp(0), 2), 0x41 | (plain(sp(0), 2) & 0xff00))
+
+    def test_int_values_keep_exact_address_reads(self):
+        self.emu.writeSymMemory(sp(0), 0x41424344)
+        self.assertEqual(self.emu.readSymMemory(sp(0), Const(4, 4)), 0x41424344)
+        self.assertIsNone(self.emu.readSymMemory(sp(1), Const(1, 4)))
+        self.assertIsNone(self.emu.readSymMemory(sp(2), Const(2, 4)))
+        self.emu.writeSymMemory(sp(0), Const(0x55, 1))
+        self.assertEqual(self.value(sp(0), 2), 0x55 | (plain(sp(0), 2) & 0xff00))
+
+    def test_non_symbolik_values_with_a_symsize_keep_exact_address_reads(self):
+        self.emu.writeSymMemory(sp(0), 0x41424344, symsize=4)
+        self.assertEqual(self.emu.readSymMemory(sp(0), Const(4, 4)), 0x41424344)
+        self.assertIsNone(self.emu.readSymMemory(sp(1), Const(1, 4)))
+        self.emu.writeSymMemory(sp(8), 'opaque', symsize=Const(4, 4))
+        self.assertEqual(self.emu.readSymMemory(sp(8), Const(4, 4)), 'opaque')
+        self.assertIsNone(self.emu.readSymMemory(sp(9), Const(1, 4)))
+
+
+    def test_sized_write_from_an_earlier_start_hides_older_values(self):
+        self.emu.writeSymMemory(sp(1), 0x41424344)
+        self.emu.writeSymMemory(sp(5), 'opaque')
+        self.emu.writeSymMemory(sp(9), Mem(Const(0x2000, 4), Var('n', 1)))
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.emu.writeSymMemory(sp(4), Var('ebx', 4))
+        self.emu.writeSymMemory(sp(8), Var('ecx', 4))
+        self.assertEqual(self.value(sp(1), 1), (EAX >> 8) & 0xff)
+        self.assertEqual(self.value(sp(5), 2), (EBX >> 8) & 0xffff)
+        self.assertEqual(self.value(sp(9), 1), (ECX >> 8) & 0xff)
+        self.assertIsNone(self.emu.readSymMemory(sp(1), Var('n', 1)))
+        self.assertIsNone(self.emu.readSymMemory(sp(5), Var('n', 1)))
+        self.assertIsNone(self.emu.readSymMemory(sp(9), Var('n', 1)))
+
+
+    def test_non_symbolik_value_over_a_sized_write_is_read_only_at_its_address(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.emu.writeSymMemory(sp(0), 0x1234)
+        self.assertEqual(self.emu.readSymMemory(sp(0), Const(4, 4)), 0x1234)
+        self.assertEqual(self.emu.readSymMemory(sp(0), Const(2, 4)), 0x1234)
+        self.assertEqual(self.value(sp(1), 2), (EAX >> 8) & 0xffff)
+
+    def test_non_symbolik_value_stays_readable_beside_a_later_byte_write(self):
+        self.emu.writeSymMemory(sp(0), 0x41424344)
+        self.emu.writeSymMemory(sp(2), Const(0x99, 1))
+        self.assertEqual(self.emu.readSymMemory(sp(0), Const(4, 4)), 0x41424344)
+        self.assertEqual(self.value(sp(1), 2), 0x9900 | (plain(sp(1), 2) & 0xff))
+
+    def test_value_of_unknown_width_is_cut_to_an_explicit_symsize(self):
+        m = Mem(Const(0x2000, 4), Var('n', 1))
+        self.emu.writeSymMemory(Const(0x1000, 4), m, symsize=2)
+        self.assertEqual(self.value(Const(0x1000, 4), 2), m.solve(vals=VALS) & 0xffff)
+        self.assertEqual(self.value(Const(0x1001, 4), 1), (m.solve(vals=VALS) >> 8) & 0xff)
+
+    def test_mem_values_without_a_known_width_keep_exact_address_reads(self):
+        m = Mem(Const(0x2000, 4), Var('n', 1))
+        self.emu.writeSymMemory(Const(0x1000, 4), m)
+        self.assertEqual(repr(self.emu.readSymMemory(Const(0x1000, 4), Const(4, 4))), repr(m))
+        self.assertIsNone(self.emu.readSymMemory(Const(0x1001, 4), Const(1, 4)))
+        self.emu.writeSymMemory(Const(0x1000, 4), Const(0x41, 1))
+        self.assertEqual(self.value(Const(0x1000, 4), 2), 0x41 | (plain(Const(0x1000, 4), 2) & 0xff00))
+
+    def test_read_of_unknown_size_sees_only_a_write_at_that_address(self):
+        size = Var('n', 4)
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.emu.writeSymMemory(sp(1), Const(0x41, 4), symsize=1)
+        self.assertEqual(self.emu.readSymMemory(sp(0), size).solve(vals=VALS), EAX)
+        self.assertEqual(self.emu.readSymMemory(sp(1), size).solve(vals=VALS), 0x41)
+        self.assertIsNone(self.emu.readSymMemory(sp(2), size))
+        self.assertEqual(self.value(sp(0), 4), 0x11224144)
+
+    def test_sizes_with_a_variable_stay_unknown_under_vals(self):
+        size = Var('n', 1)
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.emu.writeSymMemory(sp(8), Var('ebx', 4), vals=VALS, symsize=size)
+        self.assertEqual(self.emu.readSymMemory(sp(0), size, vals=VALS).solve(vals=VALS), EAX)
+        self.assertIsNone(self.emu.readSymMemory(sp(1), size, vals=VALS))
+        self.assertEqual(self.emu.readSymMemory(sp(8), Const(4, 4)).solve(vals=VALS), EBX)
+        self.assertIsNone(self.emu.readSymMemory(sp(9), Const(1, 4)))
+
+    def test_addresses_are_solved_with_the_vals_of_each_call(self):
+        foo = Var('bar', 4) * Const(5, 4)
+        self.emu.writeSymMemory(foo, Var('eax', 4), vals={'bar': 20})
+        self.assertEqual(self.value(Const(101, 4), 1), 0x33)
+        self.assertEqual(self.value(Const(98, 4), 4), 0x33440000 | (plain(Const(98, 4), 4) & 0xffff))
+        sym = self.emu.readSymMemory(foo, Const(2, 4), vals={'bar': 20})
+        self.assertEqual(sym.solve(vals=VALS), 0x3344)
+        self.assertIsNone(self.emu.readSymMemory(foo, Const(2, 4)))
+
+    def test_addresses_are_used_as_given(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.emu.setSymVariable('esp', Var('esp', 4) - Const(4, 4))
+        self.assertEqual(self.value(sp(1), 1), 0x33)
+        self.assertEqual(self.value(sp(0), 4), EAX)
+
+    def test_sixteen_byte_value_slices(self):
+        self.emu.writeSymMemory(sp(0), Var('xmm0', 16))
+        self.assertEqual(self.value(sp(4), 4), (XMM0 >> 32) & mask(4))
+        self.assertEqual(self.value(sp(12), 4), (XMM0 >> 96) & mask(4))
+        self.assertEqual(self.value(sp(6), 8), (XMM0 >> 48) & mask(8))
+        self.assertEqual(self.value(sp(15), 1), 0x00)
+
+
+
+    def test_thirty_two_byte_reads_compose(self):
+        self.emu.writeSymMemory(sp(5), Const(0x41, 1))
+        self.emu.writeSymMemory(sp(24), Var('eax', 4))
+        unwritten = plain(sp(0), 32) & mask(32) & ~((0xff << 40) | (mask(4) << 192))
+        self.assertEqual(self.value(sp(0), 32), (EAX << 192) | (0x41 << 40) | unwritten)
+
+class ByteMemoryEffectsTest(unittest.TestCase):
+
+    def setUp(self):
+        self.emu = MockEmulator(MockVw())
+
+    def test_write_effect_uses_its_own_size(self):
+        self.emu.applyEffects([
+            WriteMemory(0x10, sp(0), Const(4, 4), Var('eax', 4)),
+            WriteMemory(0x11, sp(1), Const(1, 4), Const(0x41414141, 4)),
+        ])
+        sym = self.emu.readSymMemory(sp(0), Const(4, 4))
+        self.assertEqual(sym.solve(vals=VALS), 0x11224144)
+
+    def test_write_effect_of_a_word_inside_a_qword(self):
+        self.emu.applyEffects([
+            WriteMemory(0x10, sp(0), Const(4, 4), Var('eax', 4)),
+            WriteMemory(0x11, sp(4), Const(4, 4), Var('ebx', 4)),
+            WriteMemory(0x12, sp(3), Const(2, 4), Var('ecx', 4)),
+        ])
+        sym = self.emu.readSymMemory(sp(0), Const(8, 4))
+        self.assertEqual(sym.solve(vals=VALS), 0x556677bbcc223344)
+
+    def test_set_variable_reads_composed_memory(self):
+        effs = self.emu.applyEffects([
+            WriteMemory(0x10, sp(0), Const(4, 4), Var('eax', 4)),
+            WriteMemory(0x11, sp(1), Const(1, 4), Const(0x41, 4)),
+            SetVariable(0x12, 'edx', Mem(sp(1), Const(2, 4))),
+        ])
+        edx = self.emu.getSymVariable('edx')
+        self.assertEqual(edx.getWidth(), 2)
+        self.assertEqual(edx.solve(vals=VALS), 0x2241)
+        self.assertEqual(effs[2].symobj.solve(vals=VALS), 0x2241)
+
+    def test_write_effect_of_unknown_size_is_hidden_by_a_sized_write(self):
+        self.emu.applyEffects([
+            WriteMemory(0x10, sp(0), Var('n', 4), Var('eax', 4)),
+        ])
+        self.assertEqual(repr(self.emu.readSymMemory(sp(0), Const(4, 4))), repr(Var('eax', 4)))
+        self.assertIsNone(self.emu.readSymMemory(sp(1), Const(1, 4)))
+        self.emu.applyEffects([
+            WriteMemory(0x11, sp(0), Const(1, 4), Const(0x41, 4)),
+        ])
+        sym = self.emu.readSymMemory(sp(0), Const(4, 4))
+        self.assertEqual(sym.solve(vals=VALS), 0x41 | (plain(sp(0), 4) & 0xffffff00))
+
+
+class ByteMemorySolveTest(unittest.TestCase):
+
+    def setUp(self):
+        self.vw = MockVw()
+        self.emu = MockEmulator(self.vw)
+
+    def test_solving_memory_with_an_emulator_uses_written_bytes(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.assertEqual(Mem(sp(1), Const(1, 4)).solve(emu=self.emu, vals=VALS), 0x33)
+        self.assertEqual(Mem(sp(0), Const(4, 4)).solve(emu=self.emu, vals=VALS), EAX)
+        self.assertEqual(Mem(sp(2), Const(2, 4)).solve(emu=self.emu, vals=VALS), 0x1122)
+
+    def test_solving_partly_written_memory_with_an_emulator(self):
+        self.emu.writeSymMemory(sp(1), Const(0x5a, 1))
+        expected = (0x5a << 8) | (plain(sp(0), 4) & 0xffff00ff)
+        self.assertEqual(Mem(sp(0), Const(4, 4)).solve(emu=self.emu), expected)
+        self.assertEqual(Mem(sp(0), Const(4, 4)).solve(emu=self.emu, vals=VALS), expected)
+
+    def test_solving_unwritten_memory_with_an_emulator_matches_the_plain_reference(self):
+        self.emu.writeSymMemory(sp(0), Const(0x41, 1))
+        self.assertEqual(Mem(sp(16), Const(4, 4)).solve(emu=self.emu), plain(sp(16), 4))
+        self.assertEqual(Mem(sp(0), Const(2, 4)).solve(emu=self.emu), 0x41 | (plain(sp(0), 2) & 0xff00))
+
+    def test_solving_an_import_slot_with_an_emulator(self):
+        self.vw._addLocation(0x2000, 4, v_const.LOC_IMPORT, 'kernel32.ExitProcess')
+        expected = Var('kernel32.ExitProcess', 4).solve()
+        self.assertEqual(Mem(Const(0x2000, 4), Const(4, 4)).solve(emu=self.emu), expected)
+
+    def test_solving_memory_of_unknown_size_with_an_emulator(self):
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.emu.writeSymMemory(sp(1), Const(0x41, 1))
+        self.assertEqual(Mem(sp(0), Var('n', 1)).solve(emu=self.emu, vals=VALS), EAX)
+
+    def test_solving_memory_through_a_pointer_in_emulator_memory(self):
+        self.emu.writeSymMemory(sp(0), Const(0x2000, 4))
+        self.emu.writeSymMemory(Const(0x2000, 4), Const(0x11, 1))
+        self.emu.writeSymMemory(Const(0x2001, 4), Const(0x22, 1))
+        self.assertEqual(Mem(Mem(sp(0), Const(4, 4)), Const(2, 4)).solve(emu=self.emu, vals=VALS), 0x2211)
+
+    def test_solving_memory_that_holds_a_raw_int_with_an_emulator(self):
+        self.emu.writeSymMemory(Const(0x1000, 4), 0x12345678)
+        self.assertEqual(Mem(Const(0x1000, 4), Const(4, 4)).solve(emu=self.emu), 0x12345678)
+        self.assertEqual(Mem(Const(0x1000, 4), Const(4, 4)).solve(emu=self.emu, vals=VALS), 0x12345678)
+        self.emu.writeSymMemory(sp(0), 0x2000)
+        self.emu.writeSymMemory(Const(0x2000, 4), Const(0x41, 1))
+        self.assertEqual(Mem(Mem(sp(0), Const(4, 4)), Const(1, 4)).solve(emu=self.emu, vals=VALS), 0x41)
+
+
+
+    def test_solving_with_an_emulator_never_reuses_an_earlier_plain_solve(self):
+        m = Mem(sp(0), Const(4, 4))
+        self.assertEqual(m.solve(), plain(sp(0), 4))
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+        self.assertEqual(m.solve(emu=self.emu, vals=VALS), EAX)
+        self.assertEqual(m.solve(emu=self.emu), Var('eax', 4).solve())
+
+class ByteMemorySnapshotTest(unittest.TestCase):
+
+    def setUp(self):
+        self.emu = MockEmulator(MockVw())
+        self.emu.writeSymMemory(sp(0), Var('eax', 4))
+
+    def restored(self, snap):
+        emu = MockEmulator(MockVw())
+        emu.setSymSnapshot(snap)
+        return emu
+
+    def value(self, emu, addr, size):
+        return emu.readSymMemory(addr, Const(size, 4)).solve(vals=VALS)
+
+    def test_restoring_one_snapshot_twice_gives_independent_memory(self):
+        snap = self.emu.getSymSnapshot()
+        emu1 = self.restored(snap)
+        emu2 = self.restored(snap)
+        emu1.writeSymMemory(sp(1), Const(0x41, 1))
+        self.assertEqual(self.value(emu1, sp(0), 4), 0x11224144)
+        self.assertEqual(self.value(emu2, sp(0), 4), EAX)
+        self.assertEqual(self.value(emu2, sp(1), 1), 0x33)
+        self.assertEqual(self.value(self.restored(snap), sp(1), 1), 0x33)
+
+    def test_writes_after_restoring_never_change_the_snapshot(self):
+        snap = self.emu.getSymSnapshot()
+        self.emu.setSymSnapshot(snap)
+        self.emu.writeSymMemory(sp(2), Const(0xbeef, 2))
+        self.assertEqual(self.value(self.emu, sp(0), 4), 0xbeef3344)
+        self.assertEqual(self.value(self.restored(snap), sp(2), 2), 0x1122)
+
+    def test_snapshot_taken_before_a_write_does_not_see_it(self):
+        snap = self.emu.getSymSnapshot()
+        self.emu.writeSymMemory(sp(3), Const(0x77, 1))
+        self.assertEqual(self.value(self.emu, sp(0), 4), 0x77223344)
+        self.assertEqual(self.value(self.restored(snap), sp(2), 2), 0x1122)
+        self.assertEqual(self.value(self.restored(snap), sp(3), 1), 0x11)
