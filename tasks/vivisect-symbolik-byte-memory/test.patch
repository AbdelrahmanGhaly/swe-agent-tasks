+import binascii
+import unittest
+
+import vivisect
+import vivisect.const as v_const
+import vivisect.symboliks.analysis as vsym_analysis
+
+from vivisect.symboliks.common import Const, Var
+
+
+EAX = 0x11223344
+EBX = 0x55667788
+ECX = 0x99aabbcc
+EDX = 0xddeeff01
+ESI = 0x00410000
+EDI = 0x00420000
+EFLAGS = 0x00000246
+XMM0 = 0x00112233445566778899aabbccddeeff
+
+RAX = 0x1122334455667788
+RBX = 0x8877665544332211
+RCX = 0x0123456789abcdef
+RSI = 0x0000000000510000
+RDI = 0x0000000000520000
+
+STACK = 0xbfbff000
+
+
+def later(emu, addr, value, size, width, vals=None):
+    if isinstance(addr, str):
+        addr = Var(addr, width)
+    else:
+        addr = Const(addr, width)
+    emu.writeSymMemory(addr, Const(value, size), vals=vals)
+
+
+def applied(arch, hexcode):
+    vw = vivisect.VivWorkspace()
+    vw.setMeta('Architecture', arch)
+    ctx = vsym_analysis.getSymbolikAnalysisContext(vw)
+    xlate = ctx.getTranslator()
+    code = binascii.unhexlify(hexcode)
+    off = 0
+    while off < len(code):
+        op = vw.arch.archParseOpcode(code, off, 0x1000 + off)
+        xlate.translateOpcode(op)
+        off += len(op)
+    emu = ctx.getFuncEmu(None)
+    return emu, emu.applyEffects(xlate.getEffects())
+
+
+def run(arch, hexcode):
+    return applied(arch, hexcode)[0]
+
+
+class I386WidthTest(unittest.TestCase):
+
+    def vals(self, df=0):
+        return {'eax': EAX, 'ebx': EBX, 'ecx': ECX, 'edx': EDX, 'esi': ESI, 'edi': EDI, 'eflags_df': df,
+                'eflags': EFLAGS, 'xmm0': XMM0}
+
+    def reg(self, emu, name, df=0):
+        return emu.getSymVariable(name).solve(vals=self.vals(df))
+
+    def solved(self, emu, name):
+        return emu.getSymVariable(name).solve(emu=emu, vals=self.vals())
+
+    def mem(self, emu, addr, size, df=0):
+        if isinstance(addr, str):
+            addr = Var(addr, 4)
+        else:
+            addr = Const(addr, 4)
+        sym = emu.readSymMemory(addr, Const(size, 4))
+        self.assertEqual(sym.getWidth(), size)
+        return sym.solve(vals=self.vals(df))
+
+    def test_stosb_stores_only_al(self):
+        emu = run('i386', '891f' 'aa')
+        self.assertEqual(self.mem(emu, 'edi', 4), (EBX & 0xffffff00) | (EAX & 0xff))
+        self.assertEqual(self.reg(emu, 'edi'), EDI + 1)
+
+    def test_stosw_stores_only_ax(self):
+        emu = run('i386', '891f' '66ab')
+        self.assertEqual(self.mem(emu, 'edi', 4), (EBX & 0xffff0000) | (EAX & 0xffff))
+        self.assertEqual(self.reg(emu, 'edi'), EDI + 2)
+
+    def test_stosd_stores_eax_and_keeps_the_next_dword(self):
+        emu = run('i386', '891f' '894f04' 'ab')
+        self.assertEqual(self.mem(emu, 'edi', 8), (ECX << 32) | EAX)
+        self.assertEqual(self.reg(emu, 'edi'), EDI + 4)
+
+    def test_stos_moves_backwards_when_the_direction_flag_is_set(self):
+        emu = run('i386', 'aa')
+        self.assertEqual(self.reg(emu, 'edi', df=1), EDI - 1)
+        emu = run('i386', '66ab')
+        self.assertEqual(self.reg(emu, 'edi', df=1), EDI - 2)
+        emu = run('i386', '891f' '66ab')
+        self.assertEqual(self.mem(emu, 'edi', 4, df=1), (EBX & 0xffff0000) | (EAX & 0xffff))
+
+    def test_movsb_copies_one_byte(self):
+        emu = run('i386', '891e' '890f' 'a4')
+        self.assertEqual(self.mem(emu, 'edi', 4), (ECX & 0xffffff00) | (EBX & 0xff))
+        self.assertEqual(self.reg(emu, 'esi'), ESI + 1)
+        self.assertEqual(self.reg(emu, 'edi'), EDI + 1)
+
+    def test_movsw_copies_two_bytes(self):
+        emu = run('i386', '891e' '890f' '66a5')
+        self.assertEqual(self.mem(emu, 'edi', 4), (ECX & 0xffff0000) | (EBX & 0xffff))
+        self.assertEqual(self.reg(emu, 'esi'), ESI + 2)
+        self.assertEqual(self.reg(emu, 'edi'), EDI + 2)
+
+    def test_movsd_copies_four_bytes(self):
+        emu = run('i386', '891e' '890f' '895704' 'a5')
+        self.assertEqual(self.mem(emu, 'edi', 8), (EDX << 32) | EBX)
+        self.assertEqual(self.reg(emu, 'esi', df=1), ESI - 4)
+        self.assertEqual(self.reg(emu, 'edi', df=1), EDI - 4)
+
+    def test_lodsb_loads_al_and_keeps_the_rest_of_eax(self):
+        emu = run('i386', '891e' 'ac')
+        self.assertEqual(self.reg(emu, 'eax'), (EAX & 0xffffff00) | (EBX & 0xff))
+        self.assertEqual(self.reg(emu, 'esi'), ESI + 1)
+
+    def test_lodsw_loads_ax(self):
+        emu = run('i386', '891e' '66ad')
+        self.assertEqual(self.reg(emu, 'eax'), (EAX & 0xffff0000) | (EBX & 0xffff))
+        self.assertEqual(self.reg(emu, 'esi', df=1), ESI - 2)
+
+    def test_lodsd_loads_eax(self):
+        emu = run('i386', '891e' 'c6460141' 'ad')
+        self.assertEqual(self.reg(emu, 'eax'), (EBX & 0xffff00ff) | 0x4100)
+        self.assertEqual(self.reg(emu, 'esi'), ESI + 4)
+
+    def test_push_with_operand_size_prefix_moves_two_bytes(self):
+        emu = run('i386', 'c74424fc78563412' '6650')
+        self.assertEqual(self.reg(emu, 'esp'), STACK - 2)
+        self.assertEqual(self.mem(emu, STACK - 2, 2), EAX & 0xffff)
+        self.assertEqual(self.mem(emu, STACK - 4, 4), ((EAX & 0xffff) << 16) | 0x5678)
+
+    def test_pop_with_operand_size_prefix_moves_two_bytes(self):
+        emu = run('i386', 'c74424fc78563412' '83ec04' '665b')
+        self.assertEqual(self.reg(emu, 'ebx'), (EBX & 0xffff0000) | 0x5678)
+        self.assertEqual(self.reg(emu, 'esp'), STACK - 2)
+
+    def test_push_of_a_word_immediate(self):
+        emu = run('i386', 'c74424fc78563412' '666aff')
+        self.assertEqual(self.reg(emu, 'esp'), STACK - 2)
+        self.assertEqual(self.mem(emu, STACK - 4, 4), 0xffff5678)
+
+    def test_pushf_with_operand_size_prefix_moves_two_bytes(self):
+        emu = run('i386', 'c74424fc78563412' '669c')
+        self.assertEqual(self.reg(emu, 'esp'), STACK - 2)
+        self.assertEqual(self.mem(emu, STACK - 4, 4), ((EFLAGS & 0xffff) << 16) | 0x5678)
+
+    def test_cmps_compares_elements_of_the_operand_size(self):
+        emu = run('i386', '891e' '891f' 'c647037f' '66a7')
+        self.assertEqual(self.reg(emu, 'eflags_eq'), 1)
+        emu = run('i386', '891e' '891f' 'c647037f' 'a7')
+        self.assertEqual(self.reg(emu, 'eflags_eq'), 0)
+
+    def test_cmps_compares_bytes_and_dwords(self):
+        emu = run('i386', '891e' '891f' 'c6470141' 'a6')
+        self.assertEqual(self.reg(emu, 'eflags_eq'), 1)
+        emu = run('i386', '891e' '891f' 'c6470141' 'a7')
+        self.assertEqual(self.reg(emu, 'eflags_eq'), 0)
+
+    def test_cmps_steps_both_index_registers(self):
+        emu = run('i386', 'a6')
+        self.assertEqual(self.reg(emu, 'esi'), ESI + 1)
+        self.assertEqual(self.reg(emu, 'edi'), EDI + 1)
+        self.assertEqual(self.reg(emu, 'esi', df=1), ESI - 1)
+        emu = run('i386', '66a7')
+        self.assertEqual(self.reg(emu, 'esi'), ESI + 2)
+        self.assertEqual(self.reg(emu, 'edi'), EDI + 2)
+
+    def test_add_to_one_byte_of_a_stored_dword(self):
+        emu = run('i386', '894424fc' '804424fd41')
+        self.assertEqual(self.mem(emu, STACK - 4, 4), (EAX & 0xffff00ff) | ((((EAX >> 8) + 0x41) & 0xff) << 8))
+
+    def test_byte_poke_between_push_and_pop(self):
+        emu = run('i386', '50' 'c644240141' '5b')
+        self.assertEqual(self.reg(emu, 'ebx'), (EAX & 0xffff00ff) | 0x4100)
+        self.assertEqual(self.reg(emu, 'esp'), STACK)
+
+    def test_byte_immediate_store_writes_one_byte(self):
+        emu = run('i386', '894424f8' 'c64424f941' '8b5c24f8')
+        self.assertEqual(self.reg(emu, 'ebx'), 0x11224144)
+
+    def test_word_immediate_store_writes_two_bytes(self):
+        emu = run('i386', '894424f8' '66c74424fa3412' '8b5c24f8')
+        self.assertEqual(self.reg(emu, 'ebx'), 0x12343344)
+
+    def test_partial_register_loads_keep_the_other_bits(self):
+        emu = run('i386', '894424f8' '8a5c24f9' '8a7c24fa' '668b4c24fa')
+        self.assertEqual(self.reg(emu, 'ebx'), (EBX & 0xffff0000) | 0x2233)
