+# KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE
+# WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+# NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
+# LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
+# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
+# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+"""
+Verify that a built directory leaves file targets alone: under
+Decider('timestamp-match') a file target is still rebuilt when the file it
+depends on keeps its contents but gets a different timestamp, while the
+directory beside it rebuilds from its own source.
+"""
+
+import os
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+env = Environment(tools=[])
+timed = env.Clone()
+timed.Decider('timestamp-match')
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(out, exist_ok=True)
+    with open(os.path.join(out, 'data.txt'), 'w') as f:
+        f.write(source[0].get_text_contents())
+    with open('gen.log', 'a') as f:
+        f.write('gen\\n')
+
+def copy(target, source, env):
+    with open(str(target[0]), 'w') as f:
+        f.write(source[0].get_text_contents())
+    with open('copy.log', 'a') as f:
+        f.write(str(target[0]) + '\\n')
+
+env.Command(Dir('out'), 'in.txt', gen)
+timed.Command('mid.txt', 'a.in', copy)
+timed.Command('final.txt', 'mid.txt', copy)
+""")
+
+test.write('in.txt', "one\n")
+test.write('a.in', "alpha\n")
+
+test.run(arguments='.')
+test.must_match('gen.log', "gen\n", mode='r')
+test.must_match('copy.log', "mid.txt\nfinal.txt\n", mode='r')
+test.must_match('final.txt', "alpha\n", mode='r')
+
+test.up_to_date(arguments='.')
+
+stamp = os.path.getmtime(test.workpath('mid.txt')) - 3600
+os.utime(test.workpath('mid.txt'), (stamp, stamp))
+
+test.run(arguments='.')
+test.must_match('copy.log', "mid.txt\nfinal.txt\nfinal.txt\n", mode='r')
+test.must_match('gen.log', "gen\n", mode='r')
+test.must_match('final.txt', "alpha\n", mode='r')
+
+test.up_to_date(arguments='.')
+
+test.write('in.txt', "two\n")
+test.run(arguments='--debug=explain .')
+test.must_contain_all_lines(test.stdout(), ["rebuilding `out' because"])
+test.must_match(['out', 'data.txt'], "two\n", mode='r')
+test.must_match('gen.log', "gen\ngen\n", mode='r')
+test.must_match('copy.log', "mid.txt\nfinal.txt\nfinal.txt\n", mode='r')
+
+test.up_to_date(arguments='.')
+
+test.pass_test()
