+# WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+# NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
+# LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
+# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
+# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+"""
+Verify that a CacheDir entry for a built directory only matches the same
+scanned dependencies, explicit dependencies, action and every direct
+source, so changing any of them (a second source, a varlist variable or
+the action function itself included) rebuilds the directory instead of
+restoring an entry made from the old ones.
+"""
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+cache = test.workpath('cache')
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+CacheDir(r'%s')
+env = Environment(tools=[], MARKER=ARGUMENTS.get('marker', 'm1'))
+
+def scan(node, env, path):
+    lines = node.get_text_contents().splitlines()
+    return [env.File(line.split()[1]) for line in lines if line.startswith('include ')]
+
+def collect(source, env):
+    parts = [env.subst('$MARKER') + '\\n']
+    for line in source[0].get_text_contents().splitlines():
+        with open(line.split()[1]) as f:
+            parts.append(f.read())
+    parts.append(source[1].get_text_contents())
+    with open('settings.txt') as f:
+        parts.append(f.read())
+    return ''.join(parts)
+
+def write(target, text):
+    out = target[0].get_abspath()
+    os.makedirs(out, exist_ok=True)
+    with open(os.path.join(out, 'result.txt'), 'w') as f:
+        f.write(text)
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+def gen(target, source, env):
+    write(target, collect(source, env))
+
+def gen_upper(target, source, env):
+    write(target, collect(source, env).upper())
+
+action = gen_upper if ARGUMENTS.get('impl') == 'upper' else gen
+out = env.Command(Dir('out'), ['main.in', 'second.in'],
+                  Action(action, varlist=['MARKER']), source_scanner=Scanner(scan))
+env.Depends(out, 'settings.txt')
+""" % cache)
+
+test.write('main.in', "include inc.txt\n")
+test.write('inc.txt', "i1\n")
+test.write('second.in', "x1\n")
+test.write('settings.txt', "s1\n")
+
+test.run(arguments='.')
+test.must_match(['out', 'result.txt'], "m1\ni1\nx1\ns1\n", mode='r')
+
+test.write('inc.txt', "i2\n")
+test.run(arguments='.')
+test.must_not_contain_any_line(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match(['out', 'result.txt'], "m1\ni2\nx1\ns1\n", mode='r')
+
+test.write('inc.txt', "i1\n")
+test.write('settings.txt', "s2\n")
+test.run(arguments='.')
+test.must_not_contain_any_line(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match(['out', 'result.txt'], "m1\ni1\nx1\ns2\n", mode='r')
+
+test.write('settings.txt', "s1\n")
+test.run(arguments='marker=m2 .')
+test.must_not_contain_any_line(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match(['out', 'result.txt'], "m2\ni1\nx1\ns1\n", mode='r')
+
+test.write('second.in', "x2\n")
+test.run(arguments='marker=m2 .')
+test.must_not_contain_any_line(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match(['out', 'result.txt'], "m2\ni1\nx2\ns1\n", mode='r')
+test.must_match('build.log', "gen\ngen\ngen\ngen\ngen\n", mode='r')
+
+test.run(arguments='marker=m2 impl=upper .')
+test.must_not_contain_any_line(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match(['out', 'result.txt'], "M2\nI1\nX2\nS1\n", mode='r')
+test.must_match('build.log', "gen\ngen\ngen\ngen\ngen\ngen\n", mode='r')
+
+test.write('second.in', "x1\n")
+test.run(arguments='.')
+test.must_contain_all_lines(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match(['out', 'result.txt'], "m1\ni1\nx1\ns1\n", mode='r')
+test.must_match('build.log', "gen\ngen\ngen\ngen\ngen\ngen\n", mode='r')
+
+test.pass_test()
