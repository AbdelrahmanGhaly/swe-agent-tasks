+# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
+# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+"""
+Verify that restoring a built directory from a CacheDir replaces what the
+directory held before, stale files and directories alike, while a file
+inside it that belongs to another target is kept as that target built it.
+"""
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+cache = test.workpath('cache')
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+CacheDir(r'%s')
+env = Environment(tools=[])
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(out, exist_ok=True)
+    for word in source[0].get_text_contents().split():
+        with open(os.path.join(out, word + '.txt'), 'w') as f:
+            f.write(word + '\\n')
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+env.Command(Dir('out'), 'in.txt', gen)
+env.Command('out/extra.txt', 'extra.in', Copy('$TARGET', '$SOURCE'))
+""" % cache)
+
+test.write('extra.in', "extra one\n")
+test.write('in.txt', "alpha\n")
+
+test.run(arguments='.')
+test.must_match(['out', 'alpha.txt'], "alpha\n", mode='r')
+test.must_match(['out', 'extra.txt'], "extra one\n", mode='r')
+
+test.write('in.txt', "beta\n")
+test.run(arguments='.')
+test.must_match(['out', 'beta.txt'], "beta\n", mode='r')
+
+test.write(['out', 'hand.txt'], "by hand\n")
+test.subdir(['out', 'handdir'])
+test.write(['out', 'handdir', 'inner.txt'], "inner\n")
+
+test.write('in.txt', "alpha\n")
+test.write('extra.in', "extra two\n")
+test.run(arguments='.')
+test.must_contain_all_lines(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match(['out', 'alpha.txt'], "alpha\n", mode='r')
+test.must_not_exist(['out', 'beta.txt'])
+test.must_not_exist(['out', 'hand.txt'])
+test.must_not_exist(['out', 'handdir'])
+test.must_match(['out', 'extra.txt'], "extra two\n", mode='r')
+test.must_match('build.log', "gen\ngen\n", mode='r')
+
+test.up_to_date(arguments='.')
+
+test.pass_test()
