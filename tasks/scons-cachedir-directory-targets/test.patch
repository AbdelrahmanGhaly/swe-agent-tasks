@@ -0,0 +1,67 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")" || exit 1
+export PYTHONPATH="$PWD:$PWD/testing/framework${PYTHONPATH:+:$PYTHONPATH}"
+
+XML_DIR="$(mktemp -d)"
+trap 'rm -rf "$XML_DIR"' EXIT
+STATUS=0
+
+run_pytest() {
+  local name="$1"
+  shift
+  python -m pytest -p no:cacheprovider -o addopts= --rootdir="$PWD" \
+    --junitxml="$XML_DIR/$name.xml" "$@" || STATUS=1
+}
+
+if [ "$MODE" = "new" ]; then
+  E2E_SCRIPTS="$(ls test/Dir/*-502425.py test/CacheDir/*-502425.py)"
+  export E2E_SCRIPTS
+  run_pytest e2e testing/junit_e2e_502425.py
+else
+  for module in SCons/CacheDirTests.py SCons/ExecutorTests.py SCons/Node/FSTests.py \
+      SCons/Node/NodeTests.py SCons/SConsignTests.py SCons/Taskmaster/TaskmasterTests.py; do
+    run_pytest "unit-$(basename "$module" .py)" "$module"
+  done
+  E2E_SCRIPTS="$(ls test/CacheDir/*.py test/Dir/*.py test/Batch/*.py test/Clean/*.py \
+    test/Install/*.py test/explain/*.py test/Decider/*.py test/Depends/*.py \
+    test/Scanner/*.py test/sconsign/*.py test/sconsign/script/*.py | grep -v -- '-502425\.py$')"
+  export E2E_SCRIPTS
+  run_pytest e2e testing/junit_e2e_502425.py
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  python - "$OUTPUT_PATH" "$XML_DIR" <<'PY'
+import glob
+import os
+import sys
+import xml.etree.ElementTree as ET
+
+merged = ET.Element('testsuites')
+for path in sorted(glob.glob(os.path.join(sys.argv[2], '*.xml'))):
+    try:
+        root = ET.parse(path).getroot()
+    except ET.ParseError:
+        continue
+    for suite in [root] if root.tag == 'testsuite' else list(root):
+        suite.set('name', os.path.splitext(os.path.basename(path))[0])
+        merged.append(suite)
+ET.ElementTree(merged).write(sys.argv[1], encoding='utf-8', xml_declaration=True)
+PY
+fi
+
+exit "$STATUS"
