+# KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE
+# WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+# NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
+# LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
+# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
+# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+"""
+Verify that a target using a built directory as a source is rebuilt when
+the files in the directory change, at any depth and by hand included, and
+not when the directory is rebuilt with the same files.
+"""
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+env = Environment(tools=[])
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(os.path.join(out, 'sub'), exist_ok=True)
+    lines = source[0].get_text_contents().splitlines()
+    with open(os.path.join(out, 'count.txt'), 'w') as f:
+        f.write('%d\\n' % len(lines))
+    with open(os.path.join(out, 'sub', 'base.txt'), 'w') as f:
+        f.write('base\\n')
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+def pack(target, source, env):
+    d = source[0].get_abspath()
+    lines = []
+    for root, dirs, files in os.walk(d):
+        for name in files:
+            path = os.path.join(root, name)
+            with open(path) as g:
+                rel = os.path.relpath(path, d).replace(os.sep, '/')
+                lines.append(rel + ':' + g.read())
+    with open(target[0].get_abspath(), 'w') as f:
+        f.write(''.join(sorted(lines)))
+    with open('build.log', 'a') as f:
+        f.write('pack\\n')
+
+out = env.Command(Dir('out'), 'in.txt', gen)
+env.Command('pack.txt', out, pack)
+""")
+
+test.write('in.txt', "a\nb\n")
+
+test.run(arguments='.')
+test.must_match('pack.txt', "count.txt:2\nsub/base.txt:base\n", mode='r')
+test.must_match('build.log', "gen\npack\n", mode='r')
+
+test.write('in.txt', "c\nd\n")
+test.run(arguments='.')
+test.must_match('pack.txt', "count.txt:2\nsub/base.txt:base\n", mode='r')
+test.must_match('build.log', "gen\npack\ngen\n", mode='r')
+
+test.write('in.txt', "c\nd\ne\n")
+test.run(arguments='.')
+test.must_match('pack.txt', "count.txt:3\nsub/base.txt:base\n", mode='r')
+test.must_match('build.log', "gen\npack\ngen\ngen\npack\n", mode='r')
+
+test.write(['out', 'count.txt'], "99\n")
+test.run(arguments='.')
+test.must_match(['out', 'count.txt'], "99\n", mode='r')
