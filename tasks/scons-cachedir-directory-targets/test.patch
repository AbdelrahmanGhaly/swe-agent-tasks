+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+CacheDir(r'%s')
+env = Environment(tools=[])
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(out, exist_ok=True)
+    with open(os.path.join(out, 'version.txt'), 'w') as f:
+        f.write(source[0].get_text_contents())
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+env.Command(Dir('out'), 'in.txt', gen)
+""" % cache)
+
+test.write('in.txt', "version one\n")
+test.run(arguments='.')
+
+test.write('in.txt', "version two\n")
+test.run(arguments='.')
+test.must_match(['out', 'version.txt'], "version two\n", mode='r')
+test.must_match('build.log', "gen\ngen\n", mode='r')
+
+test.write('in.txt', "version one\n")
+test.run(arguments='.')
+test.must_contain_all_lines(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match(['out', 'version.txt'], "version one\n", mode='r')
+test.must_match('build.log', "gen\ngen\n", mode='r')
+
+test.up_to_date(arguments='.')
+
+test.pass_test()
