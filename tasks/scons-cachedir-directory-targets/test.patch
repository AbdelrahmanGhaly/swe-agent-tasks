+
+"""
+Verify that editing or deleting files a builder wrote inside a built
+directory does not by itself cause a rebuild, while a source change
+still does.
+"""
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+env = Environment(tools=[])
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(out, exist_ok=True)
+    text = source[0].get_text_contents()
+    for name in ('a.txt', 'b.txt'):
+        with open(os.path.join(out, name), 'w') as f:
+            f.write(text)
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+env.Command(Dir('out'), 'in.txt', gen)
+""")
+
+test.write('in.txt', "one\n")
+
+test.run(arguments='.')
+
+test.write(['out', 'a.txt'], "edited by hand\n")
+test.up_to_date(arguments='.')
+test.must_match(['out', 'a.txt'], "edited by hand\n", mode='r')
+
+test.unlink(['out', 'b.txt'])
+test.up_to_date(arguments='.')
+test.must_not_exist(['out', 'b.txt'])
+test.must_match('build.log', "gen\n", mode='r')
+
+test.write('in.txt', "two\n")
+test.run(arguments='.')
+test.must_match(['out', 'a.txt'], "two\n", mode='r')
+test.must_match(['out', 'b.txt'], "two\n", mode='r')
+test.must_match('build.log', "gen\ngen\n", mode='r')
+
+test.pass_test()
