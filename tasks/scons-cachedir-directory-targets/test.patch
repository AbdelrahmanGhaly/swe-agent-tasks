+# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
+# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+"""
+Verify that a target reading files inside a directory restored from a
+CacheDir works in the same run, and that the next run is up to date.
+"""
+
+import shutil
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+cache = test.workpath('cache')
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+CacheDir(r'%s')
+env = Environment(tools=[])
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(out, exist_ok=True)
+    with open(os.path.join(out, 'top.txt'), 'w') as f:
+        f.write(source[0].get_text_contents())
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+def summarize(target, source, env):
+    with open(os.path.join('out', 'top.txt')) as f:
+        text = f.read()
+    with open(str(target[0]), 'w') as f:
+        f.write('summary: ' + text)
+    with open('build.log', 'a') as f:
+        f.write('summarize\\n')
+
+d = env.Command(Dir('out'), 'in.txt', gen)
+summary = env.Command('summary.txt', 'in.txt', summarize)
+env.Depends(summary, d)
+env.NoCache(summary)
+""" % cache)
+
+test.write('in.txt', "restored\n")
+
+test.run(arguments='.')
+test.must_match('build.log', "gen\nsummarize\n", mode='r')
+
+shutil.rmtree(test.workpath('out'))
+test.unlink('summary.txt')
+
+test.run(arguments='.')
+test.must_contain_all_lines(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match('summary.txt', "summary: restored\n", mode='r')
+test.must_match('build.log', "gen\nsummarize\nsummarize\n", mode='r')
+
+test.up_to_date(arguments='.')
+
+test.pass_test()
