+# WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+# NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
+# LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
+# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
+# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+"""
+Verify that a dependency a source scanner finds for a built directory
+still counts when the file lives inside that directory and another target
+builds it: changing it rebuilds the directory instead of restoring an
+older CacheDir entry, and changing it back restores the matching entry.
+"""
+
+import os
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+cache = test.workpath('cache')
+
+test.subdir('out')
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+CacheDir(r'%s')
+env = Environment(tools=[])
+
+def scan(node, env, path):
+    lines = node.get_text_contents().splitlines()
+    return [env.File(line.split()[1]) for line in lines if line.startswith('include ')]
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    with open(os.path.join(out, 'config.txt')) as f:
+        text = f.read()
+    with open(os.path.join(out, 'result.txt'), 'w') as f:
+        f.write(text.upper())
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+env.Command(Dir('out'), 'main.in', gen, source_scanner=Scanner(scan))
+env.Command('out/config.txt', 'config.in', Copy('$TARGET', '$SOURCE'))
+""" % cache)
+
+test.write('main.in', "include out/config.txt\n")
+test.write('config.in', "alpha\n")
+
+test.run(arguments='.')
+test.must_match(['out', 'result.txt'], "ALPHA\n", mode='r')
+test.up_to_date(arguments='.')
+
+test.write('config.in', "beta\n")
+test.run(arguments='--debug=explain .')
+test.must_contain_all_lines(test.stdout(), [
+    "rebuilding `out' because",
+    "`%s' changed" % os.path.join('out', 'config.txt'),
+])
+test.must_not_contain_any_line(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match(['out', 'result.txt'], "BETA\n", mode='r')
+test.must_match('build.log', "gen\ngen\n", mode='r')
+
+test.write('config.in', "alpha\n")
+test.run(arguments='.')
+test.must_contain_all_lines(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match(['out', 'result.txt'], "ALPHA\n", mode='r')
+test.must_match(['out', 'config.txt'], "alpha\n", mode='r')
+test.must_match('build.log', "gen\ngen\n", mode='r')
+
+test.up_to_date(arguments='.')
+
+test.pass_test()
