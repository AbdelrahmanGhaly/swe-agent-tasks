+# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
+# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+"""
+Verify that NoCache keeps a built directory out of the CacheDir while
+another built directory in the same build is still cached.
+"""
+
+import shutil
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+cache = test.workpath('cache')
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+CacheDir(r'%s')
+env = Environment(tools=[])
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(out, exist_ok=True)
+    with open(os.path.join(out, 'data.txt'), 'w') as f:
+        f.write(source[0].get_text_contents())
+    with open('build.log', 'a') as f:
+        f.write('gen %%s\\n' %% target[0].name)
+
+env.Command(Dir('kept'), 'in.txt', gen)
+env.NoCache(env.Command(Dir('skipped'), 'in.txt', gen))
+""" % cache)
+
+test.write('in.txt', "data\n")
+
+test.run(arguments='.')
+
+shutil.rmtree(test.workpath('kept'))
+shutil.rmtree(test.workpath('skipped'))
+
+test.run(arguments='.')
+test.must_contain_all_lines(test.stdout(), ["Retrieved `kept' from cache"])
+test.must_not_contain_any_line(test.stdout(), ["Retrieved `skipped' from cache"])
+test.must_match(['kept', 'data.txt'], "data\n", mode='r')
+test.must_match(['skipped', 'data.txt'], "data\n", mode='r')
+
+log = test.read('build.log', mode='r')
+test.fail_test(log.count('gen kept\n') != 1)
+test.fail_test(log.count('gen skipped\n') != 2)
+
+test.pass_test()
