+# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+"""
+Verify that when one built directory of an action can be restored from a
+CacheDir but the other one cannot, the action runs again and a file that a
+different target built inside the restored directory is left in place.
+"""
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+cache = test.workpath('cache')
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+CacheDir(r'%s')
+env = Environment(tools=[])
+
+def gen(target, source, env):
+    text = source[0].get_text_contents()
+    for d in target:
+        os.makedirs(d.get_abspath(), exist_ok=True)
+    with open(os.path.join(target[0].get_abspath(), 'data.txt'), 'w') as f:
+        f.write(text)
+    with open(os.path.join(target[1].get_abspath(), 'stamp.txt'), 'w') as f:
+        f.write('stamp ' + text)
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+env.Command([Dir('out'), Dir('logs')], 'in.txt', gen)
+env.NoCache(Dir('logs'))
+env.Command('out/extra.txt', 'extra.in', Copy('$TARGET', '$SOURCE'))
+""" % cache)
+
+test.write('extra.in', "extra\n")
+test.write('in.txt', "one\n")
+
+test.run(arguments='.')
+test.must_match(['out', 'extra.txt'], "extra\n", mode='r')
+
+test.write('in.txt', "two\n")
+test.run(arguments='.')
+test.must_match(['out', 'data.txt'], "two\n", mode='r')
+test.must_match(['logs', 'stamp.txt'], "stamp two\n", mode='r')
+
+test.write('in.txt', "one\n")
+test.run(arguments='.')
+test.must_match(['out', 'data.txt'], "one\n", mode='r')
+test.must_match(['logs', 'stamp.txt'], "stamp one\n", mode='r')
+test.must_match(['out', 'extra.txt'], "extra\n", mode='r')
+test.must_match('build.log', "gen\ngen\ngen\n", mode='r')
+
+test.up_to_date(arguments='.')
+
+test.pass_test()
