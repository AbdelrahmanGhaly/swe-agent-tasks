+
+import shutil
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+cache = test.workpath('cache')
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+CacheDir(r'%s')
+env = Environment(tools=[])
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(os.path.join(out, 'sub'), exist_ok=True)
+    text = source[0].get_text_contents()
+    with open(os.path.join(out, 'top.txt'), 'w') as f:
+        f.write(text)
+    with open(os.path.join(out, 'sub', 'inner.txt'), 'w') as f:
+        f.write(text.upper())
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+env.Command(Dir('out'), 'in.txt', gen)
+""" % cache)
+
