+
+"""
+Verify that a directory built by a builder is rebuilt when its build
+action changes, through a variable in its varlist or through a different
+action function, and that --debug=explain says the action changed.
+"""
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+env = Environment(tools=[], MARKER=ARGUMENTS.get('marker', 'first'))
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(out, exist_ok=True)
+    with open(os.path.join(out, 'data.txt'), 'w') as f:
+        f.write(env.subst('$MARKER'))
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+def gen_upper(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(out, exist_ok=True)
+    with open(os.path.join(out, 'data.txt'), 'w') as f:
+        f.write(env.subst('$MARKER').upper())
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+action = gen_upper if ARGUMENTS.get('impl') == 'upper' else gen
+env.Command(Dir('out'), 'in.txt', Action(action, varlist=['MARKER']))
+""")
+
+test.write('in.txt', "input\n")
+
+test.run(arguments='.')
+test.must_match(['out', 'data.txt'], "first", mode='r')
+test.up_to_date(arguments='.')
+
+test.run(arguments='--debug=explain marker=second .')
+test.must_contain_all_lines(test.stdout(), ["rebuilding `out' because", "build action changed"])
+test.must_match(['out', 'data.txt'], "second", mode='r')
+test.must_match('build.log', "gen\ngen\n", mode='r')
+
+test.run(arguments='marker=second .')
+test.must_contain_all_lines(test.stdout(), ["scons: `.' is up to date."])
+test.must_match('build.log', "gen\ngen\n", mode='r')
+
+test.run(arguments='--debug=explain marker=second impl=upper .')
+test.must_contain_all_lines(test.stdout(), ["rebuilding `out' because", "build action changed"])
+test.must_match(['out', 'data.txt'], "SECOND", mode='r')
+test.must_match('build.log', "gen\ngen\ngen\n", mode='r')
+
+test.run(arguments='marker=second impl=upper .')
+test.must_contain_all_lines(test.stdout(), ["scons: `.' is up to date."])
+test.must_match('build.log', "gen\ngen\ngen\n", mode='r')
+
+test.pass_test()
