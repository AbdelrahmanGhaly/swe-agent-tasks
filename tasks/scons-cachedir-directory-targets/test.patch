+# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+"""
+Verify that --cache-force pushes an up-to-date built directory into a
+CacheDir, so a later build restores it.
+"""
+
+import shutil
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+cache = test.workpath('cache')
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+if ARGUMENTS.get('cache'):
+    CacheDir(r'%s')
+env = Environment(tools=[])
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(out, exist_ok=True)
+    with open(os.path.join(out, 'data.txt'), 'w') as f:
+        f.write(source[0].get_text_contents())
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+env.Command(Dir('out'), 'in.txt', gen)
+""" % cache)
+
+test.write('in.txt', "forced\n")
+
+test.run(arguments='.')
+
+test.run(arguments='cache=1 --cache-force .')
+test.must_contain_all_lines(test.stdout(), ["scons: `.' is up to date."])
+test.must_match('build.log', "gen\n", mode='r')
+
+shutil.rmtree(test.workpath('out'))
+
+test.run(arguments='cache=1 .')
+test.must_contain_all_lines(test.stdout(), ["Retrieved `out' from cache"])
+test.must_match(['out', 'data.txt'], "forced\n", mode='r')
+test.must_match('build.log', "gen\n", mode='r')
+
+test.pass_test()
