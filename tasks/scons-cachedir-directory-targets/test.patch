+import os
+import subprocess
+import sys
+
+import pytest
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+SCRIPTS = os.environ.get('E2E_SCRIPTS', '').split()
+
+
+@pytest.mark.parametrize('script', SCRIPTS)
+def test_e2e(script):
+    result = subprocess.run(
+        [sys.executable, os.path.join(ROOT, 'runtest.py'), script],
+        cwd=ROOT,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+    )
+    if result.returncode == 0 and 'NO RESULT' in result.stdout:
+        pytest.skip('no result: ' + script)
+    assert result.returncode == 0, result.stdout[-8000:]
