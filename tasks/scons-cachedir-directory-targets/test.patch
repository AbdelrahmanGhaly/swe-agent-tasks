+# THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY
+# KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE
+# WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
+# NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
+# LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
+# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
+# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
+
+"""
+Verify that a directory restored from a CacheDir keeps the exact permission
+bits of its files, its empty subdirectories and its symbolic links, a link
+to a directory and a dangling link included.
+"""
+
+import os
+import shutil
+import stat
+import sys
+
+import TestSCons
+
+test = TestSCons.TestSCons()
+
+if not hasattr(os, 'symlink') or sys.platform == 'win32':
+    test.skip_test('No os.symlink() method, skipping test.\n')
+
+cache = test.workpath('cache')
+
+test.write('SConstruct', """\
+import os
+DefaultEnvironment(tools=[])
+CacheDir(r'%s')
+env = Environment(tools=[])
+
+def gen(target, source, env):
+    out = target[0].get_abspath()
+    os.makedirs(os.path.join(out, 'empty'), exist_ok=True)
+    os.makedirs(os.path.join(out, 'bin'), exist_ok=True)
+    data = os.path.join(out, 'data.txt')
+    with open(data, 'w') as f:
+        f.write(source[0].get_text_contents())
+    os.chmod(data, 0o640)
+    tool = os.path.join(out, 'bin', 'tool.sh')
+    with open(tool, 'w') as f:
+        f.write('#!/bin/sh\\n')
+    os.chmod(tool, 0o541)
+    os.symlink('data.txt', os.path.join(out, 'link.txt'))
+    os.symlink('bin', os.path.join(out, 'bin-link'))
+    os.symlink('missing.txt', os.path.join(out, 'dangling'))
+    with open('build.log', 'a') as f:
+        f.write('gen\\n')
+
+env.Command(Dir('out'), 'in.txt', gen)
+""" % cache)
+
+test.write('in.txt', "linked\n")
+
+test.run(arguments='.')
+
+shutil.rmtree(test.workpath('out'))
+
+test.run(arguments='.')
+test.must_match('build.log', "gen\n", mode='r')
+test.must_match(['out', 'data.txt'], "linked\n", mode='r')
+
+test.fail_test(not os.path.isdir(test.workpath('out', 'empty')))
+test.fail_test(os.listdir(test.workpath('out', 'empty')) != [])
+
+tool_mode = stat.S_IMODE(os.stat(test.workpath('out', 'bin', 'tool.sh')).st_mode)
+test.fail_test(tool_mode != 0o541)
+data_mode = stat.S_IMODE(os.stat(test.workpath('out', 'data.txt')).st_mode)
+test.fail_test(data_mode != 0o640)
+
+link = test.workpath('out', 'link.txt')
+test.fail_test(not os.path.islink(link))
+test.fail_test(os.readlink(link) != 'data.txt')
+test.must_match(['out', 'link.txt'], "linked\n", mode='r')
+
+dir_link = test.workpath('out', 'bin-link')
+test.fail_test(not os.path.islink(dir_link))
+test.fail_test(os.readlink(dir_link) != 'bin')
+
+dangling = test.workpath('out', 'dangling')
+test.fail_test(not os.path.islink(dangling))
+test.fail_test(os.readlink(dangling) != 'missing.txt')
+
+test.pass_test()
