+    def _tree_timestamp(self, path: str) -> int:
+        stamp = self.fs.lstat(path)[stat.ST_MTIME]
+        if self.fs.isdir(path) and not self.fs.islink(path):
+            for name in self.fs.listdir(path):
+                stamp = max(stamp, self._tree_timestamp(os.path.join(path, name)))
+        return stamp
+
+    def is_built_directory(self) -> bool:
+        """Return whether this directory is the target of a builder other than Mkdir."""
+        return self.has_builder() and self.builder is not MkdirBuilder
+
+    def is_cacheable(self) -> bool:
+        """Return whether a CacheDir may store and restore this directory."""
+        return self.is_built_directory() and not self.nocache
+
+    def new_binfo(self) -> BuildInfoBase:
+        """A directory built by a builder records its build like a file does."""
+        if self.is_built_directory():
+            return FileBuildInfo()
+        return SCons.Node.Node.new_binfo(self)
+
+    def get_stored_info(self) -> SConsignEntry | None:
+        if not self.is_built_directory():
+            return None
+        try:
+            return self._memo['get_stored_info']
+        except KeyError:
+            pass
+        try:
+            sconsign_entry = self.dir.sconsign().get_entry(self.name)
+        except (KeyError, OSError):
+            sconsign_entry = SCons.SConsign.SConsignEntry()
+            sconsign_entry.binfo = self.new_binfo()
+            sconsign_entry.ninfo = self.new_ninfo()
+        self._memo['get_stored_info'] = sconsign_entry
+        return sconsign_entry
+
+    def builder_set(self, builder: BuilderBase | None) -> None:
+        SCons.Node.Node.builder_set(self, builder)
+        self.changed_since_last_build = 1 if self.is_built_directory() else 3
+
+    def changed_build_inputs(self) -> bool:
+        """Return whether the sources, dependencies or action of a built
+        directory differ from the ones recorded when it was last built."""
+        old = self.get_stored_info().binfo
+        then = (
+            getattr(old, 'bsourcesigs', [])
+            + getattr(old, 'bdependsigs', [])
+            + getattr(old, 'bimplicitsigs', [])
+        )
+        new = self.get_binfo()
+        kids = new.bsources + new.bdepends + new.bimplicit
+        changed = len(kids) != len(then)
+        then.extend([None] * (len(kids) - len(then)))
+        for kid, prev_ni in zip(kids, then):
+            if SCons.Node._decider_map[kid.changed_since_last_build](
+                kid, self, prev_ni, self
+            ):
+                changed = True
+        if getattr(old, 'bactsig', None) != new.bactsig:
+            changed = True
+        return changed
+
+    def get_contents_sig(self) -> str:
+        """Return the signature of the action that builds this directory."""
+        try:
+            return self.contentsig
+        except AttributeError:
+            pass
+        self.contentsig = hash_signature(self.get_executor().get_contents())
+        return self.contentsig
+
+    def get_cachedir_bsig(self) -> str:
+        """Return the CacheDir signature for a built directory.
+
+        The entries found inside the directory are left out: they only exist
+        once the directory has been built, so including them would give the
+        same build a different signature before and after it runs.
+        """
+        try:
+            return self.cachesig
+        except AttributeError:
+            pass
+        binfo = self.get_binfo()
+        sigs = [
+            n.get_cachedir_csig()
+            for n in binfo.bsources + binfo.bdepends + binfo.bimplicit
+        ]
+        sigs.append(self.get_contents_sig())
+        sigs.append(self.get_internal_path())
+        self.cachesig = hash_collect(sigs)
+        return self.cachesig
+
+    def _tree_signatures(self, path: str, prefix: str) -> list[str]:
+        """Return a line naming each entry below *path* and what it holds."""
+        lines = []
+        for name in sorted(self.fs.listdir(path)):
+            entry = os.path.join(path, name)
+            if self.fs.islink(entry):
+                lines.append(f'{prefix}{name} -> {self.fs.readlink(entry)}')
+            elif self.fs.isdir(entry):
+                lines.append(f'{prefix}{name}/')
+                lines.extend(self._tree_signatures(entry, prefix + name + '/'))
+            else:
+                csig = hash_file_signature(entry, chunksize=File.hash_chunksize)
+                lines.append(f'{prefix}{name} {csig}')
+        return lines
+
+    def get_contained_targets(self) -> list[Base]:
+        """Return the Nodes below this directory that other builders produce."""
+        found = []
+        for name, node in self.entries.items():
+            if name in ('.', '..'):
+                continue
+            if isinstance(node, Dir) and not node.is_built_directory():
+                found.extend(node.get_contained_targets())
+            elif node.is_derived():
+                found.append(node)
+        return found
+
+    def remove_contents(self) -> None:
+        """Remove what this directory holds on disk, except the entries
+        that belong to other targets and the directories leading to them."""
+        keep = [n.get_internal_path() for n in self.get_contained_targets()]
+        self._remove_entries(self.get_internal_path(), keep)
+        self._forget_disk_state()
+
+    def _remove_entries(self, path: str, keep: list[str]) -> None:
+        for name in self.fs.listdir(path):
+            entry = os.path.join(path, name)
+            if entry in keep:
+                continue
+            if self.fs.isdir(entry) and not self.fs.islink(entry):
+                if any(k.startswith(entry + OS_SEP) for k in keep):
+                    self._remove_entries(entry, keep)
+                else:
+                    self._remove_tree(entry)
+            else:
+                self._remove_entry(entry)
+
+    def _remove_tree(self, path: str) -> None:
+        """Remove a directory and everything below it."""
+        for name in self.fs.listdir(path):
+            entry = os.path.join(path, name)
+            if self.fs.isdir(entry) and not self.fs.islink(entry):
+                self._remove_tree(entry)
+            else:
+                self._remove_entry(entry)
+        try:
+            os.rmdir(path)
+        except OSError:
+            self._make_writable(path)
+            os.rmdir(path)
+
+    def _remove_entry(self, path: str) -> None:
+        """Remove a file or a link, a read-only one included."""
+        try:
+            self.fs.unlink(path)
+        except OSError:
+            self._make_writable(path)
+            self.fs.unlink(path)
+
+    def _make_writable(self, path: str) -> None:
+        """Clear the read-only bit the restored tree may carry."""
+        mode = stat.S_IMODE(self.fs.lstat(path)[stat.ST_MODE])
+        self.fs.chmod(path, mode | stat.S_IWRITE)
+
+    def push_to_cache(self) -> bool:
+        """Try to push this built directory tree into a cache."""
+        if not self.is_cacheable():
+            return False
+        self.clear_memoized_values()
+        if self.exists():
+            return self.get_build_env().get_CacheDir().push_dir(self)
+        return False
+
+    def retrieve_from_cache(self) -> bool:
+        """Try to retrieve this directory tree from a cache.
+
+        Returns True if the tree was successfully retrieved.
+        """
+        if not self.is_cacheable():
+            return False
+        if not self.get_build_env().get_CacheDir().retrieve_dir(self):
+            return False
+        self._forget_disk_state()
+        return True
+
+    def _forget_disk_state(self) -> None:
+        """Drop what this directory and the Nodes below it remember about the disk."""
+        self.clear_memoized_values()
+        try:
+            del self.on_disk_entries
+        except AttributeError:
+            pass
+        for name, node in list(self.entries.items()):
+            if name in ('.', '..'):
+                continue
+            if isinstance(node, Dir):
+                node._forget_disk_state()
+            else:
+                node.clear_memoized_values()
+
+    def visited(self) -> None:
+        if not self.is_built_directory():
+            SCons.Node.Node.visited(self)
+            return
+        if self.executor is not None and not self.nocache and self.exists():
+            self.get_build_env().get_CacheDir().push_dir_if_forced(self)
+        # Deciding computes the signatures of the sources that get recorded.
+        self.changed_build_inputs()
+        if SCons.Node.do_store_info:
+            entry = SCons.SConsign.SConsignEntry()
+            entry.binfo = self.new_binfo()
+            entry.binfo.merge(self.get_binfo())
+            entry.ninfo = self.get_ninfo()
+            self.dir.sconsign().set_entry(self.name, entry)
+            self._memo.pop('get_stored_info', None)
+
     def get_abspath(self) -> str:
         """Get the absolute path of the file."""
         return self._abspath
