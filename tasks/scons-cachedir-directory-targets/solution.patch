+def _copy_tree(cd, env, fs, src, dst, to_cache: bool, skip) -> None:
+    """Copy the directory tree at *src* to *dst*, keeping symlinks as links.
+
+    Entries whose path in the build tree is in *skip* belong to other
+    targets and are left alone.
+    """
+    fs.makedirs(dst, exist_ok=True)
+    for name in sorted(fs.listdir(src)):
+        src_path = os.path.join(src, name)
+        dst_path = os.path.join(dst, name)
+        if (src_path if to_cache else dst_path) in skip:
+            continue
+        if fs.islink(src_path):
+            fs.symlink(fs.readlink(src_path), dst_path)
+        elif fs.isdir(src_path):
+            _copy_tree(cd, env, fs, src_path, dst_path, to_cache, skip)
+        elif to_cache:
+            cd.copy_to_cache(env, src_path, dst_path)
+        else:
+            cd.copy_from_cache(env, src_path, dst_path)
+            fs.chmod(dst_path, stat.S_IMODE(fs.stat(src_path).st_mode))
+
+
+def CacheRetrieveDirFunc(target, source, env) -> int:
+    t = target[0]
+    fs = t.fs
+    cd = env.get_CacheDir()
+    cd.requests += 1
+    cachefile = cd.cachepath(t)[1]
+    if not fs.isdir(cachefile):
+        cd.CacheDebug('CacheRetrieve(%s):  %s not in cache\n', t, cachefile)
+        return 1
+    cd.hits += 1
+    cd.CacheDebug('CacheRetrieve(%s):  retrieving from %s\n', t, cachefile)
+    if SCons.Action.execute_actions:
+        path = t.get_internal_path()
+        if fs.islink(path) or fs.isfile(path):
+            fs.unlink(path)
+        elif fs.isdir(path):
+            t.remove_contents()
+        skip = [n.get_internal_path() for n in t.get_contained_targets()]
+        _copy_tree(cd, env, fs, cachefile, path, False, skip)
+    return 0
+
+
+def CacheRetrieveDirString(target, source, env) -> str:
+    t = target[0]
+    cachefile = env.get_CacheDir().cachepath(t)[1]
+    if t.fs.isdir(cachefile):
+        return f"Retrieved `{t.get_internal_path()}' from cache"
+    return ""
+
+
+CacheRetrieveDir = SCons.Action.Action(CacheRetrieveDirFunc, CacheRetrieveDirString)
+
+CacheRetrieveDirSilent = SCons.Action.Action(CacheRetrieveDirFunc, None)
+
+
+def CachePushDirFunc(target, source, env) -> None:
+    if cache_readonly:
+        return
+
+    t = target[0]
+    if t.nocache:
+        return
+    fs = t.fs
+    cd = env.get_CacheDir()
+    cachedir, cachefile = cd.cachepath(t)
+    if fs.exists(cachefile):
+        cd.CacheDebug('CachePush(%s):  %s already exists in cache\n', t, cachefile)
+        return
+
+    cd.CacheDebug('CachePush(%s):  pushing to %s\n', t, cachefile)
+
+    try:
+        fs.makedirs(cachedir, exist_ok=True)
+        skip = [n.get_internal_path() for n in t.get_contained_targets()]
+        with tempfile.TemporaryDirectory(dir=cachedir) as temp_dir:
+            temp_tree = os.path.join(temp_dir, os.path.basename(cachefile))
+            _copy_tree(cd, env, fs, t.get_internal_path(), temp_tree, True, skip)
+            fs.rename(temp_tree, cachefile)
+    except OSError:
+        msg = f"Unable to copy {t} to cache. Cache file is {cachefile}"
+        cd.CacheDebug(
+            "Unable to copy %s to cache. Cache file is %s\n", str(t), cachefile
+        )
+        SCons.Warnings.warn(SCons.Warnings.CacheWriteErrorWarning, msg)
+
+
+CachePushDir = SCons.Action.Action(CachePushDirFunc, None)
+
+
 class CacheDir:
 
     def __init__(self, path) -> None:
@@ -374,3 +466,30 @@ class CacheDir:
     def push_if_forced(self, node):
         if cache_force:
             return self.push(node)
+
+    def retrieve_dir(self, node) -> bool:
+        """Retrieve a built directory tree from cache.
+
+        Returns ``True`` if the whole tree was retrieved.
+        """
+        if not self.is_enabled():
+            return False
+
+        env = node.get_build_env()
+        if cache_show:
+            if CacheRetrieveDirSilent(node, [], env, execute=1) == 0:
+                node.build(presub=0, execute=0)
+                return True
+        elif CacheRetrieveDir(node, [], env, execute=1) == 0:
+            return True
+
+        return False
+
+    def push_dir(self, node):
+        if self.is_readonly() or not self.is_enabled():
+            return
+        return CachePushDir(node, [], node.get_build_env())
+
+    def push_dir_if_forced(self, node):
+        if cache_force:
+            return self.push_dir(node)
