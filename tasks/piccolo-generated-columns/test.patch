+def get_column_ddl(table_class: type[Table], column_name: str) -> str:
+    return table_class._meta.get_column_by_name(column_name).ddl
+
+
+def build_column_ddl(generated_value, column_name: str = "name_upper") -> str:
+    return bound_ddl(Varchar(generated=generated_value), column_name)
+
+
+def text_column():
