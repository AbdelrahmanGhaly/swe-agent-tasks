+class TestGeneratedMigrationFile(TestCase):
+    def build_schema(self, sql: str, stored: bool = True):
+        name = Varchar()
+        name._meta._name = "name"
+
+        shout = Varchar(generated=generated(sql, name, stored=stored))
+        shout._meta._name = "shout"
+
+        return DiffableTable(
+            class_name="Item", tablename="item", columns=[name, shout]
+        ), DiffableTable(class_name="Item", tablename="item", columns=[name])
+
+    def get_statements(self, sql: str = "UPPER({})", stored: bool = True):
+        schema, snapshot = self.build_schema(sql, stored=stored)
+        differ = SchemaDiffer(
+            schema=[schema], schema_snapshot=[snapshot], auto_input="n"
+        )
+        return differ.get_alter_statements()
+
+    def rendered(self, **kwargs) -> str:
+        return " ".join(
+            statement
+            for group in self.get_statements(**kwargs)
+            for statement in group.statements
+        )
+
+    def restore(self, rendered: str):
+        start = rendered.index("Generated(")
+        end = start
+        depth = 0
+        for character in rendered[start:]:
+            end += 1
+            if character == "(":
+                depth += 1
+            elif character == ")":
+                depth -= 1
+                if depth == 0:
+                    break
+        return eval(  # noqa: S307
+            rendered[start:end], {"Generated": piccolo_columns.Generated}
+        )
+
+    def test_file_contains_a_generated_call(self):
+        rendered = " ".join(
+            statement
+            for group in self.get_statements()
+            for statement in group.statements
+        )
+
+        self.assertIn("Generated(", rendered)
+
+    def test_file_contains_the_rendered_column_name(self):
+        rendered = " ".join(
+            statement
+            for group in self.get_statements()
+            for statement in group.statements
+        )
+
+        self.assertIn('UPPER("name")', rendered)
+        self.assertNotIn("object at", rendered)
+
+    def test_file_keeps_a_stored_expression(self):
+        self.assertIn(
+            'GENERATED ALWAYS AS (UPPER("name")) STORED',
+            build_column_ddl(self.restore(self.rendered()), "shout"),
+        )
+
+    def test_file_keeps_a_virtual_expression(self):
+        self.assertIn(
+            'GENERATED ALWAYS AS (UPPER("name")) VIRTUAL',
+            build_column_ddl(
+                self.restore(self.rendered(stored=False)), "shout"
+            ),
+        )
+
+    def test_file_imports_generated(self):
+        imports = [
+            str(i)
+            for group in self.get_statements()
+            for i in group.extra_imports
+        ]
+
+        self.assertTrue(
+            any("Generated" in i for i in imports), msg=str(imports)
+        )
+
