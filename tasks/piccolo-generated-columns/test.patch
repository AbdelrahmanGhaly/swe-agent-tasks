+class TestGeneratedChangedExpressionEndToEnd(DBTestCase):
+    def build_delta(self):
+        name = Varchar()
+        name._meta._name = "name"
+
+        old_column = Varchar(generated=generated("UPPER({})", name))
+        old_column._meta._name = "name_upper"
+
+        new_column = Varchar(generated=generated("LOWER({})", name))
+        new_column._meta._name = "name_upper"
+
+        return DiffableTable(
