+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd /app || exit 1
+
+export PICCOLO_CONF="tests.sqlite_conf"
+
+NEW_TESTS="tests/columns/test_generated_7f3a1c.py"
+ARGS=(-p no:cacheprovider -o addopts= -m "not integration")
+
+# Compares wall clock timings with timeit, so it fails under CPU contention
+# regardless of the code under test.
+FLAKY_TEST="tests/query/test_freeze.py::TestFreeze::test_frozen_performance"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  ARGS+=(--junitxml="$OUTPUT_PATH")
+fi
+
+LOG_FILE="$(mktemp)"
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "${ARGS[@]}" "$NEW_TESTS" 2>&1 | tee "$LOG_FILE"
+else
+  python -m pytest "${ARGS[@]}" --deselect "$FLAKY_TEST"     --ignore="$NEW_TESTS" tests 2>&1 | tee "$LOG_FILE"
+fi
+STATUS=${PIPESTATUS[0]}
+
+if [ -n "$OUTPUT_PATH" ] && ! grep -q "<testcase" "$OUTPUT_PATH" 2>/dev/null; then
+  python - "$OUTPUT_PATH" "$LOG_FILE" "$MODE" <<'PY'
+import html
+import sys
+
+output_path, log_file, mode = sys.argv[1:4]
+
+with open(log_file, encoding="utf-8", errors="replace") as f:
+    details = f.read()[-4000:]
+
+with open(output_path, "w", encoding="utf-8") as f:
+    f.write(
+        '<?xml version="1.0" encoding="utf-8"?>\n'
+        '<testsuites name="pytest tests">\n'
+        '<testsuite name="pytest" errors="1" failures="0" skipped="0" '
+        'tests="1" time="0">\n'
+        f'<testcase classname="pytest" name="{mode} test run" time="0">\n'
+        '<error message="pytest did not produce a report">'
+        f"{html.escape(details)}</error>\n"
+        "</testcase>\n</testsuite>\n</testsuites>\n"
+    )
+PY
+  if [ "$STATUS" -eq 0 ]; then STATUS=1; fi
+fi
+
+rm -f "$LOG_FILE"
+exit $STATUS
