+
+def virtual(*args, **kwargs):
+    """
+    A generated value which isn't stored, which is the only kind SQLite adds
+    with ALTER TABLE.
+    """
+    return piccolo_columns.Generated(*args, stored=False, **kwargs)
+
+
+def added_ddl(column_class, expression, column_name: str) -> str:
+    """
+    The DDL for a generated column added to the table which owns the columns
+    its expression names.
+    """
+    return (
+        get_tables()
+        .Expression.alter()
+        .add_column(
+            name=column_name, column=column_class(generated=expression)
+        )
+        .ddl[0]
+    )
+
+
+def flag_column():
+    return get_tables().Expression.flag
+
+
+def bound_ddl(column, column_name: str = "name_upper", **extra_columns) -> str:
+    """
+    Read a column's DDL once the metaclass has bound it to a table, which is
+    how a table is always built.
+    """
+    members = {"name": Varchar(), **extra_columns, column_name: column}
+    table = create_table_class(class_name="Rendered", class_members=members)
+    return table._meta.get_column_by_name(column_name).ddl
+
