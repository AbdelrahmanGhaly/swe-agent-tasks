new file mode 100644
index 00000000..e0d3743c
--- /dev/null
+++ b/piccolo/columns/generated.py
@@ -0,0 +1,316 @@
+from __future__ import annotations
+
+import datetime
+import decimal
+import math
+import uuid
+from collections.abc import Sequence
+from typing import TYPE_CHECKING, Any, Union
+
+from piccolo.columns.combination import Combination, Where
+from piccolo.custom_types import Combinable
+from piccolo.querystring import QueryString
+
+if TYPE_CHECKING:  # pragma: no cover
+    from piccolo.columns.base import Column
+
+
+def _is_sql(operand: Any) -> bool:
+    """
+    SQL a caller assembled elsewhere, such as a function call or a sub
+    select. It reaches a generated column through the placeholder form.
+    """
+    from piccolo.query.base import Query
+
+    return isinstance(operand, (QueryString, Query))
+
+
+def _is_comparison(expression: Any) -> bool:
+    """
+    A comparison, or comparisons combined with ``&`` and ``|``. Neither a raw
+    SQL where clause nor a comparison carrying SQL of its own is one, so both
+    have to use the placeholder form.
+    """
+    if isinstance(expression, Combination):
+        return _is_comparison(expression.first) and _is_comparison(
+            expression.second
+        )
+
+    if not isinstance(expression, Where):
+        return False
+
+    operands = [expression.value]
+    values = expression.values
+    if isinstance(values, (list, tuple)):
+        operands.extend(values)
+    else:
+        operands.append(values)
+
+    return not any(_is_sql(i) for i in operands)
+
+
+class Generated:
+    """
+    Describes a value which the database calculates for us. For example::
+
+        from piccolo.columns import (
+            Boolean,
+            Generated,
+            Integer,
+            Varchar,
+        )
+
+        class Band(Table):
+            name = Varchar()
+            popularity = Integer()
+
+            upper_name = Varchar(generated=Generated("UPPER({})", name))
+            is_popular = Boolean(generated=Generated(popularity > 1000))
+
+    :param expression:
+        Either the SQL for the expression, with curly brackets as placeholders
+        for any columns, or a Piccolo expression such as ``popularity > 1000``.
+    :param columns:
+        The columns which fill the placeholders (one column is needed for each
+        set of curly brackets). Only allowed when the expression is SQL.
+    :param stored:
+        If ``True``, the value is calculated when the row is written, and is
+        stored on disk. If ``False``, it's calculated each time the row is
+        read.
+
+    """
+
+    __slots__ = ("expression", "columns", "stored")
+
+    def __init__(
+        self,
+        expression: Union[str, Combinable],
+        *columns: Column,
+        stored: bool = True,
+    ):
+        if isinstance(expression, str):
+            placeholder_count = expression.count("{}")
+
+            if placeholder_count != len(columns):
+                raise ValueError(
+                    f"{placeholder_count} placeholders were given, but "
+                    f"{len(columns)} columns."
+                )
+        elif not _is_comparison(expression):
+            raise ValueError(
+                "Only SQL with placeholders, or a comparison such as "
+                "`popularity > 100`, can be used here. Anything else, "
+                "including a function call, needs the placeholder form."
+            )
+        elif columns:
+            raise ValueError(
+                "Columns can only be passed in alongside SQL which has "
+                "placeholders for them."
+            )
+
+        self.expression = expression
+        self.columns = columns
+        self.stored = stored
+
+    def get_columns(self) -> list[Column]:
+        """
+        Every column the expression names, wherever it appears in it.
+        """
+        if self.columns:
+            return list(self.columns)
+
+        return self._walk(self.expression)
+
+    @classmethod
+    def _walk(cls, expression: Any) -> list[Column]:
+        from piccolo.columns.base import Column
+
+        if isinstance(expression, Column):
+            return [expression]
+
+        if isinstance(expression, QueryString):
+            columns = list(expression.columns)
+            for arg in expression.args:
+                columns.extend(cls._walk(arg))
+            return columns
+
+        if isinstance(expression, Combination):
+            return cls._walk(expression.first) + cls._walk(expression.second)
+
+        if isinstance(expression, Where):
+            columns = cls._walk(expression.column)
+
+            for side in (expression.value, expression.values):
+                if isinstance(side, (list, tuple)):
+                    for item in side:
+                        columns.extend(cls._walk(item))
+                else:
+                    columns.extend(cls._walk(side))
+
+            return columns
+
+        return []
+
+    def get_sql(self) -> str:
+        """
+        The SQL expression, ready for a table definition.
+
+        The column names are only known once the ``Table`` metaclass has
+        assigned them, which is why this is deferred until the SQL is needed.
+        """
+        expression = self.expression
+
+        if isinstance(expression, str):
+            if not self.columns:
+                return expression
+
+            return expression.format(
+                *[
+                    f'"{column._meta.db_column_name}"'
+                    for column in self.columns
+                ]
+            )
+
+        if isinstance(expression, QueryString):
+            querystring = expression
+        else:
+            querystring = expression.querystring_for_constraint
+
+        return self._render(querystring)
+
+    @classmethod
+    def _render(cls, querystring: QueryString) -> str:
+        """
+        A database rejects both bind parameters and table names inside a
+        generated column's expression, so the values are written into the SQL,
+        and each column is left with just its own name.
+
+        Column names only ever reach the SQL through a fragment's prefix, and
+        values only ever arrive as arguments, so the two are unqualified and
+        written separately. Rewriting the finished SQL instead would change a
+        value which happens to look like a column name.
+        """
+        unqualified = {
+            column._meta.get_full_name(
+                with_alias=False
+            ): f'"{column._meta.db_column_name}"'
+            for column in querystring.columns
+            if column._meta._table is not None
+        }
+
+        _, fragments, args = querystring.bundle(
+            start_index=1, bundled=[], combined_args=[]
+        )
+
+        parts: list[str] = []
+        index = 0
+
+        for fragment in fragments:
+            prefix = fragment.prefix
+            for full_name, name in unqualified.items():
+                prefix = prefix.replace(full_name, name)
+
+            parts.append(prefix)
+
+            if not fragment.no_arg:
+                parts.append(cls._render_value(args[index]))
+                index += 1
+
+        return "".join(parts)
+
+    @staticmethod
+    def _render_value(value: Any) -> str:
+        """
+        Write a value into the SQL, as the expression can't carry it
+        separately.
+        """
+        if value is None:
+            return "null"
+
+        if isinstance(value, bool):
+            return "true" if value else "false"
+
+        if isinstance(value, (int, float, decimal.Decimal)):
+            unusable = isinstance(
+                value, (float, decimal.Decimal)
+            ) and not math.isfinite(value)
+            if unusable:
+                raise ValueError(
+                    f"{value} has no SQL form which works everywhere."
+                )
+
+            return str(value)
+
+        if isinstance(
+            value,
+            (
+                datetime.datetime,
+                datetime.date,
+                datetime.time,
+                uuid.UUID,
+            ),
+        ):
+            value = str(value)
+
+        if isinstance(value, str):
+            escaped = value.replace("'", "''")
+            return f"'{escaped}'"
+
+        raise ValueError(
+            f"A {type(value).__name__} can't be written into a generated "
+            "column's expression."
+        )
+
+    @property
+    def ddl(self) -> str:
+        storage = "STORED" if self.stored else "VIRTUAL"
+        return f"GENERATED ALWAYS AS ({self.get_sql()}) {storage}"
+
+    def __hash__(self) -> int:
+        return hash((self.get_sql(), self.stored))
+
+    def __eq__(self, other: Any) -> bool:
+        if not isinstance(other, Generated):
+            return False
+        return (
+            self.get_sql() == other.get_sql() and self.stored == other.stored
+        )
+
+    def __repr__(self) -> str:
+        return f"Generated({self.get_sql()!r}, stored={self.stored})"
+
+
+def read_generated_values(
+    row: dict[str, Any], columns: Sequence[Column]
+) -> dict[str, Any]:
+    """
+    Pick the calculated values out of a row which the database handed back,
+    keyed by the name of the attribute they belong to.
+    """
+    return {
+        column._meta.name: row[column._meta.db_column_name]
+        for column in columns
+        if column._meta.db_column_name in row
+    }
+
+
+def reject_generated_write(column: Column) -> None:
+    """
+    The database works out a generated column's value, so it can't be given
+    one deliberately.
+    """
+    if column._meta.generated is not None:
+        raise ValueError(
+            f"{column._meta.name} is a generated column - the database "
+            "works out its value."
+        )
+
+
+def reject_named_generated_write(table: Any, name: Any) -> None:
+    """
+    The same guard, for the write APIs which take a column's name instead of
+    the column itself. Either name reaches the same column.
+    """
+    for column in table._meta.columns:
+        if name in (column._meta.name, column._meta.db_column_name):
+            reject_generated_write(column)
