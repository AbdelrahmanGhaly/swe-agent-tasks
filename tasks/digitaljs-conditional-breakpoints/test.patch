+"use strict";
+
+import { HeadlessCircuit } from '../lib/circuit.mjs';
+import { Circuit } from '../lib/index.mjs';
+import { Vector3vl } from '3vl';
+import { SynchEngine } from '../lib/engines/synch.mjs';
+import { BrowserSynchEngine } from '../lib/engines/browsersynch.mjs';
+import { WorkerEngine } from '../lib/engines/worker.mjs';
+
+jest.mock('jquery', () => { const $ = () => $; return $; });
+jest.mock('jquery-ui/ui/widgets/dialog.js', () => ({}));
+jest.mock('jquery-ui/themes/base/all.css', () => ({}));
+jest.mock('../lib/style.css.js', () => ({}), { virtual: true });
+
+console.assert = (stmt, msg) => { if (!stmt) throw new Error(msg); };
+
+jest.setTimeout(60000);
+
+const workerURL = new URL('../lib/engines/worker-worker.js', require('url').pathToFileURL(__filename).toString());
+const engineOptions = { workerURL };
+const engines = [["synch", SynchEngine], ["worker", WorkerEngine], ["browser", BrowserSynchEngine]];
+
+const clone = x => JSON.parse(JSON.stringify(x));
+const sig = bin => Vector3vl.fromBin(bin, bin.length);
+
+const live = [];
+afterEach(() => {
+    while (live.length) live.pop().shutdown();
+});
+
+function build(data, engine, Class = HeadlessCircuit) {
+    const circuit = new Class(clone(data), { engine, engineOptions });
+    live.push(circuit);
+    circuit.observeGraph();
+    return circuit;
+}
+
+function record(circuit) {
+    const hits = [];
+    circuit.on('breakpoint', (id, tick) => hits.push([id, tick]));
+    return hits;
+}
+
+async function step(circuit, script, from, to, next = false) {
+    await circuit.synchronize();
+    for (let s = from; s < to; s++) {
+        for (const [at, id, bin] of script)
+            if (at == s) circuit.setInput(id, sig(bin));
+        if (next) await circuit.updateGatesNext({ synchronous: true });
+        else await circuit.updateGates({ synchronous: true });
+    }
+    await circuit.synchronize();
+}
+
+async function truth(data, script, steps, condition, next = false) {
+    const twin = build(data, SynchEngine);
+    const values = [[undefined, condition(twin)]];
+    for (let s = 0; s < steps; s++) {
+        for (const [at, id, bin] of script)
+            if (at == s) twin.setInput(id, sig(bin));
+        if (next) await twin.updateGatesNext();
+        else await twin.updateGates();
+        values.push([twin.tick - 1, condition(twin)]);
+    }
+    return values;
+}
+
+function firings(values, id) {
+    const out = [];
+    for (let i = 1; i < values.length; i++)
+        if (values[i][1] && !values[i - 1][1]) out.push([id, values[i][0]]);
+    return out;
+}
+
+function accepted(circuit, ...conditions) {
+    return conditions.flatMap(condition => {
+        try {
+            return [circuit.addBreakpoint(condition)];
+        } catch (e) {
+            return [];
+        }
+    });
+}
+
+const port = (circuit, label, name, where = []) => {
+    const cell = circuit.findDeviceByLabel(label, where);
+    const dir = cell.getPort(name).dir;
+    return cell.get(dir == 'in' ? 'inputSignals' : 'outputSignals')[name].toBin();
+};
+
+const COUNT = {
+    devices: {
+        clk: { type: 'Clock', label: 'clk', propagation: 2 },
+        ff: { type: 'Dff', label: 'ff', bits: 4, polarity: { clock: true }, initial: '0000' },
+        one: { type: 'Constant', label: 'one', constant: '0001' },
+        add: { type: 'Addition', label: 'add', bits: { in1: 4, in2: 4, out: 4 }, propagation: 1 },
+        q: { type: 'Output', label: 'q', net: 'q', bits: 4 }
+    },
+    connectors: [
+        { from: { id: 'clk', port: 'out' }, to: { id: 'ff', port: 'clk' } },
+        { from: { id: 'ff', port: 'out' }, to: { id: 'add', port: 'in1' } },
+        { from: { id: 'one', port: 'out' }, to: { id: 'add', port: 'in2' } },
+        { from: { id: 'add', port: 'out' }, to: { id: 'ff', port: 'in' } },
+        { from: { id: 'ff', port: 'out' }, to: { id: 'q', port: 'in' } }
+    ]
+};
+
+const GATES = {
+    devices: {
+        a: { type: 'Input', label: 'a', net: 'a', bits: 1 },
+        b: { type: 'Input', label: 'b', net: 'b', bits: 1 },
+        n: { type: 'Not', label: 'n', bits: 1, propagation: 3 },
+        g: { type: 'And', label: 'g', bits: 1, propagation: 2 },
+        m: { type: 'Output', label: 'm', net: 'm', bits: 1 },
+        o: { type: 'Output', label: 'o', net: 'o', bits: 1 }
+    },
+    connectors: [
+        { from: { id: 'a', port: 'out' }, to: { id: 'n', port: 'in' } },
+        { from: { id: 'n', port: 'out' }, to: { id: 'g', port: 'in1' } },
+        { from: { id: 'b', port: 'out' }, to: { id: 'g', port: 'in2' } },
+        { from: { id: 'n', port: 'out' }, to: { id: 'm', port: 'in' } },
+        { from: { id: 'g', port: 'out' }, to: { id: 'o', port: 'in' } }
+    ]
+};
+
+const PINS = {
+    devices: {
+        en: { type: 'Input', label: 'en', net: 'en', bits: 1 },
+        clk: { type: 'Input', label: 'clk', net: 'clk', bits: 1 },
+        d: { type: 'Input', label: 'd', net: 'd', bits: 4 },
+        y: { type: 'Output', label: 'y', net: 'y', bits: 4 }
+    },
+    connectors: [
+        { from: { id: 'd', port: 'out' }, to: { id: 'y', port: 'in' } }
+    ]
+};
+
+const MEM = {
+    devices: {
+        ra: { type: 'Input', label: 'ra', net: 'ra', bits: 2 },
+        sa: { type: 'Input', label: 'sa', net: 'sa', bits: 2 },
+        mem: { type: 'Memory', label: 'mem', bits: 4, abits: 2, words: 4, propagation: 2, rdports: [{}, {}], wrports: [], memdata: ['0001', '0010', '0011', '0100'] },
+        c: { type: 'Output', label: 'c', net: 'c', bits: 4 },
+        s: { type: 'Output', label: 's', net: 's', bits: 4 }
+    },
+    connectors: [
+        { from: { id: 'ra', port: 'out' }, to: { id: 'mem', port: 'rd0addr' } },
+        { from: { id: 'sa', port: 'out' }, to: { id: 'mem', port: 'rd1addr' } },
+        { from: { id: 'mem', port: 'rd0data' }, to: { id: 'c', port: 'in' } },
+        { from: { id: 'mem', port: 'rd1data' }, to: { id: 's', port: 'in' } }
+    ]
+};
+
+const TWINS = {
+    devices: {
+        clk: { type: 'Input', label: 'clk', net: 'clk', bits: 1 },
+        d1: { type: 'Input', label: 'd1', net: 'd1', bits: 4 },
+        d2: { type: 'Input', label: 'd2', net: 'd2', bits: 4 },
+        dev4: { type: 'Subcircuit', label: 'r1', celltype: 'reg' },
+        dev5: { type: 'Subcircuit', label: 'r2', celltype: 'reg' },
+        q1: { type: 'Output', label: 'q1', net: 'q1', bits: 4 },
+        q2: { type: 'Output', label: 'q2', net: 'q2', bits: 4 }
+    },
+    connectors: [
+        { from: { id: 'clk', port: 'out' }, to: { id: 'dev4', port: 'clk' } },
+        { from: { id: 'clk', port: 'out' }, to: { id: 'dev5', port: 'clk' } },
+        { from: { id: 'd1', port: 'out' }, to: { id: 'dev4', port: 'd' } },
+        { from: { id: 'd2', port: 'out' }, to: { id: 'dev5', port: 'd' } },
+        { from: { id: 'dev4', port: 'q' }, to: { id: 'q1', port: 'in' } },
+        { from: { id: 'dev5', port: 'q' }, to: { id: 'q2', port: 'in' } }
+    ],
+    subcircuits: {
+        reg: {
+            devices: {
+                clk: { type: 'Input', label: 'clk', net: 'clk', bits: 1 },
+                d: { type: 'Input', label: 'd', net: 'd', bits: 4 },
+                ff: { type: 'Dff', label: 'ff', bits: 4, polarity: { clock: true } },
+                dev7: { type: 'Subcircuit', label: 'inv', celltype: 'invert' },
+                q: { type: 'Output', label: 'q', net: 'q', bits: 4 }
+            },
+            connectors: [
+                { from: { id: 'clk', port: 'out' }, to: { id: 'ff', port: 'clk' } },
+                { from: { id: 'd', port: 'out' }, to: { id: 'dev7', port: 'i' } },
+                { from: { id: 'dev7', port: 'o' }, to: { id: 'ff', port: 'in' } },
+                { from: { id: 'ff', port: 'out' }, to: { id: 'q', port: 'in' } }
+            ]
+        },
+        invert: {
+            devices: {
+                i: { type: 'Input', label: 'i', net: 'i', bits: 4 },
+                n: { type: 'Not', label: 'n', bits: 4, propagation: 2 },
+                o: { type: 'Output', label: 'o', net: 'o', bits: 4 }
+            },
+            connectors: [
+                { from: { id: 'i', port: 'out' }, to: { id: 'n', port: 'in' } },
+                { from: { id: 'n', port: 'out' }, to: { id: 'o', port: 'in' } }
+            ]
+        }
+    }
+};
+
+const TWINS_SCRIPT = [[0, 'clk', '0'], [0, 'd1', '0011'], [0, 'd2', '1100'], [3, 'clk', '1'], [6, 'clk', '0'], [8, 'd1', '0101'], [9, 'clk', '1'], [12, 'clk', '0'], [14, 'd2', '0110'], [15, 'clk', '1'], [18, 'clk', '0'], [21, 'clk', '1']];
+
+const SHARED_LABELS = {
+    dup1: { type: 'Input', label: 'dup', net: 'dup1', bits: 1 },
+    dup2: { type: 'Input', label: 'dup', net: 'dup2', bits: 1 },
+    dev8: { type: 'Subcircuit', label: 'pair', celltype: 'reg' },
+    dev9: { type: 'Subcircuit', label: 'pair', celltype: 'reg' }
+};
+
+describe.each(engines)('stepping on %s', (_n, engine) => {
+    test('a breakpoint fires after the tick in which its condition becomes true and reports that tick', async () => {
+        const c = build(COUNT, engine);
+        const hits = record(c);
+        const id = c.addBreakpoint("q == 'b0011");
+        await step(c, [], 0, 40);
+        const expected = firings(await truth(COUNT, [], 40, t => t.getOutput('q').toBin() == '0011'), id);
+        expect(expected.length).toBe(1);
+        expect(hits).toEqual(expected);
+        expect(typeof id).toBe('number');
+    });
+
+    test('a condition that stays true fires once, and again only after it was false at a check', async () => {
+        const c = build(COUNT, engine);
+        const hits = record(c);
+        const id = c.addBreakpoint("q[0] == 'b1");
+        await step(c, [], 0, 60);
+        const expected = firings(await truth(COUNT, [], 60, t => t.getOutput('q').toBin().endsWith('1')), id);
+        expect(expected.length).toBeGreaterThan(3);
+        expect(hits).toEqual(expected);
+    });
+
+    test('a condition already true when the breakpoint is added fires only after it has been false', async () => {
+        const c = build(GATES, engine);
+        const hits = record(c);
+        await step(c, [[0, 'a', '0'], [0, 'b', '1']], 0, 8);
+        const id = c.addBreakpoint("m == 'b1");
+        await step(c, [[10, 'a', '1'], [16, 'a', '0']], 8, 24);
+        expect(hits).toEqual([[id, 19]]);
+    });
+
+    test('ticks without events count as checks when stepping one tick at a time', async () => {
+        const c = build(PINS, engine);
+        const hits = record(c);
+        const id = c.addBreakpoint("en == 'b1");
+        await step(c, [[0, 'en', '0'], [5, 'en', '1'], [7, 'en', '0'], [9, 'en', '1']], 0, 12);
+        expect(hits).toEqual([[id, 5], [id, 9]]);
+    });
+
+    test('rose and fell compare with the previous check even when the rest of the condition is false', async () => {
+        const c = build(PINS, engine);
+        const hits = record(c);
+        const up = c.addBreakpoint("en == 'b1 && rose(clk)");
+        const down = c.addBreakpoint("en == 'b1 && fell(clk)");
+        const script = [[0, 'en', '0'], [0, 'clk', '0'], [2, 'clk', '1'], [4, 'en', '1'], [6, 'clk', '0'], [8, 'clk', '1'], [10, 'en', '0'], [12, 'clk', '0'], [13, 'en', '1']];
+        await step(c, script, 0, 16);
+        expect(hits).toEqual([[down, 6], [up, 8]]);
+    });
+
+    test('a change to or from an undefined bit is not an edge', async () => {
+        const c = build(PINS, engine);
+        const hits = record(c);
+        const up = c.addBreakpoint("rose(clk)");
+        const down = c.addBreakpoint("fell(clk)");
+        const script = [[0, 'clk', 'x'], [2, 'clk', '1'], [4, 'clk', 'x'], [6, 'clk', '0'], [8, 'clk', '1'], [10, 'clk', '0']];
+        await step(c, script, 0, 12);
+        expect(hits).toEqual([[up, 8], [down, 10]]);
+    });
+
+    test('rose and fell also work on a one-bit selection', async () => {
+        const c = build(PINS, engine);
+        const hits = record(c);
+        const up = c.addBreakpoint("rose(d[2])");
+        const down = c.addBreakpoint("fell(y[0])");
+        await step(c, [[0, 'd', '0000'], [2, 'd', '0100'], [4, 'd', '0101'], [6, 'd', '0000']], 0, 8);
+        expect(hits).toEqual([[up, 2], [down, 6]]);
+    });
+
+    test('rose and fell follow a clock while stepping from event to event', async () => {
+        const c = build(COUNT, engine);
+        const hits = record(c);
+        const up = c.addBreakpoint("rose(clk)");
+        await step(c, [], 0, 30, true);
+        const values = [];
+        const twin = build(COUNT, SynchEngine);
+        let previous = port(twin, 'clk', 'out');
+        for (let s = 0; s < 30; s++) {
+            await twin.updateGatesNext();
+            const now = port(twin, 'clk', 'out');
+            if (previous == '0' && now == '1') values.push([up, twin.tick - 1]);
+            previous = now;
+        }
+        expect(values.length).toBeGreaterThan(5);
+        expect(hits).toEqual(values);
+    });
+
+    test('an x in a literal matches any value', async () => {
+        const c = build(COUNT, engine);
+        const hits = record(c);
+        const id = c.addBreakpoint("q == 'b1x0x");
+        await step(c, [], 0, 80);
+        const expected = firings(await truth(COUNT, [], 80, t => /^1.0.$/.test(t.getOutput('q').toBin())), id);
+        expect(expected.length).toBeGreaterThan(1);
+        expect(hits).toEqual(expected);
+    });
+
+    test('an x in a literal also matches an undefined bit', async () => {
+        const c = build(PINS, engine);
+        const hits = record(c);
+        const id = c.addBreakpoint("d == 'b1x0x");
+        await step(c, [[0, 'd', '0000'], [2, 'd', '1x0x'], [4, 'd', '0000'], [6, 'd', 'x101'], [8, 'd', '1x01']], 0, 10);
+        expect(hits).toEqual([[id, 2], [id, 8]]);
+    });
+
+    test('an undefined bit of a signal never equals 0 or 1', async () => {
+        const c = build(PINS, engine);
+        const hits = record(c);
+        const zero = c.addBreakpoint("d[1] == 'b0");
+        const notZero = c.addBreakpoint("d[1] != 'b0");
+        const one = c.addBreakpoint("d[1] == 'b1");
+        await step(c, [[0, 'd', '0000'], [2, 'd', '00x0'], [4, 'd', '0010'], [6, 'd', '0000']], 0, 8);
+        expect(hits).toEqual([[zero, 0], [notZero, 2], [one, 4], [zero, 6]]);
+    });
+
+    test('bit i counts from the least significant bit, and a range compares like a number whichever end is written first', async () => {
+        const c = build(PINS, engine);
+        const hits = record(c);
+        const top = accepted(c, "d[3:2] == 'b10", "d[2:3] == 'b10");
+        const low = c.addBreakpoint("d[0] == 'b1");
+        const mid = accepted(c, "y[2:1] != 'b00", "y[1:2] != 'b00");
+        await step(c, [[0, 'd', '0000'], [2, 'd', '1000'], [4, 'd', '0001'], [6, 'd', '0100']], 0, 8);
+        expect(top.length).toBeGreaterThan(0);
+        expect(mid.length).toBeGreaterThan(0);
+        for (const id of top) expect(hits.filter(hit => hit[0] == id)).toEqual([[id, 2]]);
+        expect(hits.filter(hit => hit[0] == low)).toEqual([[low, 4]]);
+        for (const id of mid) expect(hits.filter(hit => hit[0] == id)).toEqual([[id, 6]]);
+    });
+
+    test('a device name alone means an input device output, an output device input or the only output', async () => {
+        const c = build(GATES, engine);
+        const hits = record(c);
+        const input = c.addBreakpoint("a == 'b1");
+        const output = c.addBreakpoint("o == 'b1");
+        const gate = c.addBreakpoint("n == 'b0");
+        const named = c.addBreakpoint("g:in2 == 'b1 && g:in1 == 'b1");
+        await step(c, [[0, 'a', '0'], [0, 'b', '0'], [6, 'b', '1'], [12, 'a', '1']], 0, 20);
+        expect(hits).toEqual([[input, 12], [gate, 15], [named, 6], [output, 8]].sort((x, y) => x[1] - y[1]));
+    });
+
+    test('names reach devices inside subcircuits by their labels', async () => {
