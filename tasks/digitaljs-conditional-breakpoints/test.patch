+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() { echo "usage: $0 [--output_path <path>] base|new" >&2; exit 2; }
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new) MODE="$1"; MODE_COUNT=$((MODE_COUNT + 1)); shift ;;
+    --output_path) shift; [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }; OUTPUT_PATH="$1"; shift ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    *) echo "unknown argument: $1" >&2; usage ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")"
+ROOT="$(pwd)"
+[ -n "$OUTPUT_PATH" ] || OUTPUT_PATH="$ROOT/junit-$MODE.xml"
+case "$OUTPUT_PATH" in /*) ;; *) OUTPUT_PATH="$ROOT/$OUTPUT_PATH" ;; esac
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+NEW_TESTS="tests/stop_conditions_3e4e16.test.mjs"
+JEST_JUNIT_REPORTER="$(npm root -g)/jest-junit"
+export JEST_JUNIT_OUTPUT_FILE="$OUTPUT_PATH"
+export JEST_JUNIT_REPORT_TEST_SUITE_ERRORS=true
+
+write_failure() {
+  cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites name="jest tests" tests="1" failures="1" errors="0" time="0">
+<testsuite name="$MODE" tests="1" failures="1" errors="0" time="0">
+<testcase classname="$MODE" name="$1" time="0">
+<failure message="$1">$2</failure>
+</testcase>
+</testsuite>
+</testsuites>
+XMLEOF
+}
+
+rm -rf lib
+if ! BUILD_LOG="$(./node_modules/.bin/babel src -d lib 2>&1)"; then
+  printf '%s\n' "$BUILD_LOG" >&2
+  write_failure "library build" "$(printf '%s' "$BUILD_LOG" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+  exit 1
+fi
+
+JEST_LOG="$(mktemp)"
+if [ "$MODE" = "base" ]; then
+  # The generated suite reuses identical test names within a describe block; the environment
+  # numbers repeated names so every result is reported under its own name.
+  # The two constant-operand arithmetic families (10,344 of the suite's 11,880 cases) are left
+  # out: they only cover the constant arithmetic cells and the constant-folding transform, which
+  # this change does not touch, and one of them draws its constants at random.
+  # Math.random is seeded, so the randomized logic table checks draw the same inputs on every run.
+  timeout 1500 ./node_modules/.bin/jest tests/index.test.mjs --ci --forceExit \
+    --testEnvironment "$ROOT/tests/unique_names_970a20.js" \
+    --setupFiles "$ROOT/tests/seeded_random_d654a5.js" \
+    -t '^(?!.*(with constant|bits constant)).*$' \
+    --reporters=default --reporters="$JEST_JUNIT_REPORTER" 2>&1 | tee "$JEST_LOG"
+  STATUS=${PIPESTATUS[0]}
+  # jest reports the cases left out by -t as skipped; keep only the cases that ran in the report.
+  if [ -f "$OUTPUT_PATH" ]; then
+    node -e '
+      const fs = require("fs");
+      const file = process.argv[1];
+      let dropped = 0;
+      const xml = fs.readFileSync(file, "utf8")
+        .replace(/\n\s*<testcase [^>]*>\s*<skipped\/>\s*<\/testcase>/g, () => { dropped++; return ""; });
+      fs.writeFileSync(file, xml
+        .replace(/ tests="(\d+)"/g, (m, n) => ` tests="${n - dropped}"`)
+        .replace(/ skipped="(\d+)"/g, (m, n) => ` skipped="${n - dropped}"`));
+    ' "$OUTPUT_PATH"
+  fi
+else
+  timeout 1500 ./node_modules/.bin/jest "$NEW_TESTS" --ci --forceExit \
+    --reporters=default --reporters="$JEST_JUNIT_REPORTER" 2>&1 | tee "$JEST_LOG"
+  STATUS=${PIPESTATUS[0]}
+fi
+
+if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  write_failure "jest run" "jest exited with status $STATUS without reporting any test. Last lines of its output:
+$(tail -n 60 "$JEST_LOG" | tr -d '\000-\010\013\014\016-\037' | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+  [ "$STATUS" -ne 0 ] || STATUS=1
+fi
+rm -f "$JEST_LOG"
+exit "$STATUS"
