+        return id;
+    }
+    removeBreakpoint(id) {
+        this._engine.removeBreakpoint(id);
+    }
+    _breakpointNames(text, pos) {
+        const names = [];
+        const walk = (graph, from) => {
+            for (const cell of graph.getElements()) {
+                if (!cell.has('label')) continue;
+                const label = String(cell.get('label'));
+                if (label == '' || !text.startsWith(label, from)) continue;
+                const end = from + label.length;
+                names.push({ end, resolve: () => this._breakpointTarget(cell) });
+                if (text[end] == ':')
+                    for (const port of cell.getPorts())
+                        if (text.startsWith(port.id, end + 1))
+                            names.push({ end: end + 1 + port.id.length, resolve: () => this._breakpointTarget(cell, port) });
+                if (text[end] == '.' && cell instanceof this._cells.Subcircuit)
+                    walk(cell.get('graph'), end + 1);
+            }
+        };
+        walk(this._graph, pos);
+        return names;
+    }
+    _breakpointTarget(cell, port) {
+        if (port === undefined) {
+            if (cell.isInput) {
+                port = cell.getPort('out');
+            } else if (cell.isOutput) {
+                port = cell.getPort('in');
+            } else {
+                const outputs = cell.getPorts().filter(p => p.dir == 'out');
+                if (outputs.length != 1)
+                    throw new Error("Device " + cell.get('label') + " has no single output in breakpoint condition");
+                port = outputs[0];
+            }
+        }
+        return { graph: cell.graph.cid, gate: cell.id, port: port.id, dir: port.dir, bits: port.bits };
+    }
 };
 
