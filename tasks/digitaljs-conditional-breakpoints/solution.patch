+"use strict";
+
+const SPACE = /\s*/y;
+const FOLLOWER = /\s*(?:==|!=|&&|\|\||\)|\[|$)/y;
+const LITERAL = /'b([01x]+)/y;
+const EDGE = /(rose|fell)\s*\(/y;
+const COMPARE = /==|!=/y;
+const INDEX = /[0-9]+/y;
+
+class Parser {
+    constructor(text, names) {
+        this.text = text;
+        this.names = names;
+        this.pos = 0;
+    }
+    error(what) {
+        return new Error(what + " in condition: " + this.text);
+    }
+    skip() {
+        SPACE.lastIndex = this.pos;
+        SPACE.exec(this.text);
+        this.pos = SPACE.lastIndex;
+    }
+    peek(token) {
+        this.skip();
+        return this.text.startsWith(token, this.pos);
+    }
+    take(token) {
+        if (!this.peek(token))
+            throw this.error("Expected " + token);
+        this.pos += token.length;
+    }
+    match(re) {
+        this.skip();
+        re.lastIndex = this.pos;
+        const m = re.exec(this.text);
+        if (m) this.pos = re.lastIndex;
+        return m;
+    }
+    parse() {
+        const node = this.parseOr();
+        this.skip();
+        if (this.pos != this.text.length)
+            throw this.error("Unexpected input");
+        return node;
+    }
+    parseOr() {
+        const args = [this.parseAnd()];
+        while (this.peek('||')) {
+            this.take('||');
+            args.push(this.parseAnd());
+        }
+        return args.length == 1 ? args[0] : { op: 'or', args };
+    }
+    parseAnd() {
+        const args = [this.parseUnary()];
+        while (this.peek('&&')) {
+            this.take('&&');
+            args.push(this.parseUnary());
+        }
+        return args.length == 1 ? args[0] : { op: 'and', args };
+    }
+    parseUnary() {
+        if (this.peek('!')) {
+            this.take('!');
+            return { op: 'not', arg: this.parseUnary() };
+        }
+        if (this.peek('(')) {
+            this.take('(');
+            const node = this.parseOr();
+            this.take(')');
+            return node;
+        }
+        const edge = this.match(EDGE);
+        if (edge) {
+            const ref = this.parseSignal();
+            this.take(')');
+            if (ref.hi != ref.lo)
+                throw this.error("Edge of a signal wider than one bit");
+            return { op: edge[1], ref };
+        }
+        return this.parseComparison();
+    }
+    parseComparison() {
+        let literal = this.match(LITERAL), ref;
+        if (!literal) ref = this.parseSignal();
+        const op = this.match(COMPARE);
+        if (!op) throw this.error("Expected == or !=");
+        if (literal) ref = this.parseSignal();
+        else literal = this.match(LITERAL);
+        if (!literal) throw this.error("Expected a binary literal");
+        if (literal[1].length != ref.hi - ref.lo + 1)
+            throw this.error("Literal width does not match");
+        return { op: op[0] == '==' ? 'eq' : 'ne', ref, literal: literal[1] };
+    }
+    parseSignal() {
+        this.skip();
+        const found = this.names(this.text, this.pos).filter(name => {
+            FOLLOWER.lastIndex = name.end;
+            return FOLLOWER.test(this.text);
+        });
+        if (found.length == 0)
+            throw this.error("Unknown device or port");
+        if (found.length > 1)
+            throw this.error("Ambiguous name");
+        this.pos = found[0].end;
+        const target = found[0].resolve();
+        let hi = target.bits - 1, lo = 0;
+        if (this.peek('[')) {
+            this.take('[');
+            hi = lo = this.parseIndex();
+            if (this.peek(':')) {
+                this.take(':');
+                lo = this.parseIndex();
+            }
+            this.take(']');
+            if (hi < lo || hi >= target.bits)
+                throw this.error("Bit selection out of range");
+        }
+        return { graph: target.graph, gate: target.gate, port: target.port, dir: target.dir, hi, lo };
+    }
+    parseIndex() {
+        const index = this.match(INDEX);
+        if (!index)
+            throw this.error("Bad bit index");
+        return Number(index[0]);
+    }
+}
+
+export function compileCondition(text, names) {
+    if (typeof text != 'string')
+        throw new Error("A breakpoint condition must be a string");
+    return new Parser(text, names).parse();
+}
+
+function edgeRefs(node, refs = []) {
+    if (node.op == 'rose' || node.op == 'fell') {
+        node.edge = refs.length;
+        refs.push(node.ref);
+    } else if (node.op == 'not') {
+        edgeRefs(node.arg, refs);
+    } else if (node.op == 'and' || node.op == 'or') {
+        for (const arg of node.args) edgeRefs(arg, refs);
+    }
+    return refs;
+}
+
+function evaluate(node, read, before, now) {
+    switch (node.op) {
+        case 'or': return node.args.some(arg => evaluate(arg, read, before, now));
+        case 'and': return node.args.every(arg => evaluate(arg, read, before, now));
+        case 'not': return !evaluate(node.arg, read, before, now);
+        case 'rose': return before !== undefined && before[node.edge] == -1 && now[node.edge] == 1;
+        case 'fell': return before !== undefined && before[node.edge] == 1 && now[node.edge] == -1;
+        default: {
+            const sig = read(node.ref);
+            const width = node.literal.length;
+            let equal = true;
+            for (let i = 0; i < width; i++) {
+                const expected = node.literal[width - 1 - i];
+                if (expected == 'x') continue;
+                if (sig.get(node.ref.lo + i) != (expected == '1' ? 1 : -1)) {
+                    equal = false;
+                    break;
+                }
+            }
+            return node.op == 'eq' ? equal : !equal;
+        }
+    }
+}
+
+export class Breakpoint {
+    constructor(id, tree, read) {
+        this.id = id;
+        this.tree = tree;
+        this.edges = edgeRefs(tree);
+        this.samples = undefined;
+        this.active = this.check(read);
+    }
+    check(read) {
+        const now = this.edges.map(ref => read(ref).get(ref.lo));
+        const value = evaluate(this.tree, read, this.samples, now);
+        this.samples = now;
+        return value;
+    }
+    fires(read) {
+        const wasActive = this.active;
+        this.active = this.check(read);
+        return this.active && !wasActive;
+    }
+}
