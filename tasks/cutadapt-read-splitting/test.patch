index 0000000..189c1ca
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd /app
+
+NEW_TESTS="tests/test_split_051aa9.py"
+
+JUNIT_ARG=""
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  JUNIT_ARG="--junitxml=$OUTPUT_PATH"
+fi
+
+BASETEMP="$(mktemp -d)"
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_TESTS" -p no:cacheprovider --basetemp="$BASETEMP" $JUNIT_ARG
+else
+  python -m pytest tests --ignore="$NEW_TESTS" -p no:cacheprovider --basetemp="$BASETEMP" $JUNIT_ARG
+fi
+EXIT_CODE=$?
+
+rm -rf "$BASETEMP"
+
+if [ -n "$OUTPUT_PATH" ] && ! grep -q "<testcase" "$OUTPUT_PATH" 2>/dev/null; then
+  cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="utf-8"?>
+<testsuites><testsuite name="pytest" errors="1" failures="0" tests="1" time="0">
+<testcase classname="cutadapt.tests" name="collection" time="0">
+<error message="pytest collected no tests">The test run produced no results; see the standard error output for the build or collection diagnostic.</error>
+</testcase></testsuite></testsuites>
+XMLEOF
+  if [ "$EXIT_CODE" -eq 0 ]; then
+    EXIT_CODE=1
+  fi
+fi
+
+exit $EXIT_CODE
