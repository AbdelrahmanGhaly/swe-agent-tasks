+
+def test_unconditional_cut_happens_before_splitting(tmp_path):
+    read = "TTT" + HEAD + ADAPTER + TAIL
+    _, outpath = run_split(tmp_path, [("r", read)], extra=["-u", "3"])
+    assert sequences(outpath) == [HEAD, TAIL]
