+import gzip
+import json
+import os
+
+import dnaio
+import pytest
+
+from cutadapt.cli import main
+
+ADAPTER = "TGCAGGTACT"
+ADAPTER_1MM = "TGCATGTACT"
+ADAPTER_2MM = "TGCTGGAACT"
+ADAPTER2 = "CATTCGAATC"
+ADAPTER_DEL = "TGCAGTACT"
+ADAPTER_WILDCARD = "TGCAGGTACN"
+SHORT = "TTAGCCGA"
+LONG = "CATTCGAATCGA"
+HEAD = "AAAAAAAA"
+MID = "CCCCCCCC"
+TAIL = "GGGGGGGG"
+
+
+def write_fastq(tmp_path, reads, name="in.fastq"):
+    path = tmp_path / name
+    lines = []
+    for read in reads:
+        if len(read) == 3:
+            header, sequence, qualities = read
+        else:
+            header, sequence = read
+            qualities = "I" * len(sequence)
+        lines.append(f"@{header}\n{sequence}\n+\n{qualities}\n")
+    path.write_text("".join(lines))
+    return path
+
+
+def write_fasta(tmp_path, reads, name="in.fasta"):
+    path = tmp_path / name
+    path.write_text("".join(f">{header}\n{sequence}\n" for header, sequence in reads))
+    return path
+
+
+def records(path):
+    with dnaio.open(os.fspath(path)) as reader:
+        return [(record.name, record.sequence, record.qualities) for record in reader]
+
+
+def sequences(path):
+    return [sequence for _, sequence, _ in records(path)]
+
+
+def names(path):
+    return [name for name, _, _ in records(path)]
+
+
+def run_split(tmp_path, reads, extra=(), adapter=ADAPTER, out="out.fastq"):
+    inpath = write_fastq(tmp_path, reads)
+    outpath = tmp_path / out
+    args = ["--action=split", "-a", adapter, "-o", os.fspath(outpath)]
+    args += [str(argument) for argument in extra]
+    args += [os.fspath(inpath)]
+    stats = main(args)
+    return stats, outpath
+
+
+def read_counts(stats):
+    return stats.as_json()["read_counts"]
+
+
+def run_split_adapters(tmp_path, reads, adapters, extra=(), out="out.fastq"):
+    inpath = write_fastq(tmp_path, reads)
+    outpath = tmp_path / out
+    args = ["--action=split"]
+    for adapter in adapters:
+        args += ["-a", adapter]
+    args += ["-o", os.fspath(outpath)]
+    args += [str(argument) for argument in extra]
+    args += [os.fspath(inpath)]
+    stats = main(args)
+    return stats, outpath
+
+
+def run_split_paired(tmp_path, reads1, reads2, extra=()):
+    in1 = write_fastq(tmp_path, reads1, name="in1.fastq")
+    in2 = write_fastq(tmp_path, reads2, name="in2.fastq")
+    out1 = tmp_path / "out1.fastq"
+    out2 = tmp_path / "out2.fastq"
+    args = [
+        "--action=split",
+        "-a",
+        ADAPTER,
+        "-A",
+        ADAPTER2,
+        "-o",
+        os.fspath(out1),
+        "-p",
+        os.fspath(out2),
+    ]
+    args += [str(argument) for argument in extra]
+    args += [os.fspath(in1), os.fspath(in2)]
+    stats = main(args)
+    return stats, out1, out2
+
+
+def assert_split_action_works(tmp_path):
+    _, outpath = run_split(
+        tmp_path, [("control", HEAD + ADAPTER + TAIL)], out="control.fastq"
+    )
+    assert sequences(outpath) == [HEAD, TAIL]
+
+
+def test_one_internal_occurrence_gives_two_pieces(tmp_path):
+    _, outpath = run_split(tmp_path, [("r", HEAD + ADAPTER + TAIL)])
+    assert sequences(outpath) == [HEAD, TAIL]
+
+
+def test_two_internal_occurrences_give_three_pieces(tmp_path):
+    _, outpath = run_split(tmp_path, [("r", HEAD + ADAPTER + MID + ADAPTER + TAIL)])
+    assert sequences(outpath) == [HEAD, MID, TAIL]
+
+
+def test_pieces_are_written_in_read_order(tmp_path):
+    read = "AAA" + ADAPTER + "CC" + ADAPTER + "GGGG"
+    _, outpath = run_split(tmp_path, [("r", read)])
+    assert sequences(outpath) == ["AAA", "CC", "GGGG"]
+
+
+def test_read_without_occurrence_is_written_unchanged(tmp_path):
+    _, outpath = run_split(tmp_path, [("r", HEAD + MID)])
+    assert records(outpath) == [("r", HEAD + MID, "I" * 16)]
+
+
+def test_qualities_are_cut_with_the_sequence(tmp_path):
+    read = HEAD + ADAPTER + TAIL
+    qualities = "A" * len(HEAD) + "#" * len(ADAPTER) + "J" * len(TAIL)
+    _, outpath = run_split(tmp_path, [("r", read, qualities)])
+    assert [quality for _, _, quality in records(outpath)] == ["A" * 8, "J" * 8]
+
+
+def test_several_reads_are_split_independently(tmp_path):
+    reads = [
+        ("r1", HEAD + ADAPTER + TAIL),
+        ("r2", MID),
+        ("r3", HEAD + ADAPTER + MID + ADAPTER + TAIL),
+    ]
+    _, outpath = run_split(tmp_path, reads)
+    assert sequences(outpath) == [HEAD, TAIL, MID, HEAD, MID, TAIL]
+
+
+def test_fasta_input_is_split(tmp_path):
+    inpath = write_fasta(tmp_path, [("r", HEAD + ADAPTER + TAIL)])
+    outpath = tmp_path / "out.fasta"
+    main(
+        [
+            "--action=split",
+            "-a",
+            ADAPTER,
+            "-o",
+            os.fspath(outpath),
+            os.fspath(inpath),
+        ]
+    )
+    assert sequences(outpath) == [HEAD, TAIL]
+
+
+def test_weaker_occurrence_before_the_best_one_is_also_removed(tmp_path):
+    read = HEAD + SHORT + MID + LONG + TAIL
+    _, outpath = run_split_adapters(tmp_path, [("r", read)], [SHORT, LONG])
+    assert sequences(outpath) == [HEAD, MID, TAIL]
+
+
+def test_weaker_occurrence_between_two_best_ones_is_also_removed(tmp_path):
+    read = HEAD + LONG + MID + SHORT + MID + LONG + TAIL
+    _, outpath = run_split_adapters(tmp_path, [("r", read)], [SHORT, LONG])
+    assert sequences(outpath) == [HEAD, MID, MID, TAIL]
+
+
+def test_no_written_piece_still_contains_an_occurrence(tmp_path):
+    read = HEAD + SHORT + MID + LONG + MID + SHORT + TAIL
+    _, outpath = run_split_adapters(tmp_path, [("r", read)], [SHORT, LONG])
+    for sequence in sequences(outpath):
+        assert SHORT not in sequence
+        assert LONG not in sequence
+
+
+def test_inexact_occurrence_is_removed_like_an_exact_one(tmp_path):
+    read = HEAD + ADAPTER_1MM + MID + ADAPTER + TAIL
+    _, outpath = run_split(tmp_path, [("r", read)])
+    assert sequences(outpath) == [HEAD, MID, TAIL]
+
+
+def test_piece_carries_the_occurrence_next_to_it(tmp_path):
+    read = HEAD + SHORT + MID + LONG + TAIL
+    _, outpath = run_split_adapters(
+        tmp_path,
+        [("r", read)],
+        [f"short={SHORT}", f"long={LONG}"],
+        extra=["--rename", "{id} {adapter_name}"],
+    )
+    written = names(outpath)
+    assert written[0] == "r_1 short"
+    assert written[-1] == "r_3 long"
+
+
+def test_four_occurrences_give_five_pieces(tmp_path):
+    read = "AA" + ADAPTER + "CC" + ADAPTER + "GG" + ADAPTER + "TT" + ADAPTER + "AC"
+    _, outpath = run_split(tmp_path, [("r", read)])
+    assert sequences(outpath) == ["AA", "CC", "GG", "TT", "AC"]
+
+
+def test_occurrence_at_the_start_gives_an_empty_first_piece(tmp_path):
+    _, outpath = run_split(tmp_path, [("r", ADAPTER + TAIL)])
+    assert sequences(outpath) == ["", TAIL]
+
+
+def test_occurrence_at_the_end_gives_an_empty_last_piece(tmp_path):
+    _, outpath = run_split(tmp_path, [("r", HEAD + ADAPTER)])
+    assert sequences(outpath) == [HEAD, ""]
+
+
+def test_adjacent_occurrences_give_an_empty_piece_between_them(tmp_path):
+    _, outpath = run_split(tmp_path, [("r", HEAD + ADAPTER + ADAPTER + TAIL)])
+    assert sequences(outpath) == [HEAD, "", TAIL]
+
+
+def test_read_that_is_only_an_adapter_gives_two_empty_pieces(tmp_path):
+    _, outpath = run_split(tmp_path, [("r", ADAPTER)])
+    assert sequences(outpath) == ["", ""]
+
+
+def test_minimum_length_removes_empty_pieces(tmp_path):
+    _, outpath = run_split(tmp_path, [("r", ADAPTER + TAIL)], extra=["-m", "1"])
+    assert sequences(outpath) == [TAIL]
+
+
+def test_pieces_are_numbered_when_the_read_is_cut(tmp_path):
+    _, outpath = run_split(tmp_path, [("r", HEAD + ADAPTER + MID + ADAPTER + TAIL)])
+    assert names(outpath) == ["r_1", "r_2", "r_3"]
+
+
+def test_read_that_is_not_cut_keeps_its_name(tmp_path):
+    _, outpath = run_split(tmp_path, [("r", HEAD + MID)])
+    assert names(outpath) == ["r"]
+
+
+def test_numbering_keeps_the_rest_of_the_header(tmp_path):
+    _, outpath = run_split(tmp_path, [("r some comment", HEAD + ADAPTER + TAIL)])
+    assert names(outpath) == ["r_1 some comment", "r_2 some comment"]
+
+
+def test_empty_pieces_are_numbered_like_any_other(tmp_path):
+    _, outpath = run_split(tmp_path, [("r", ADAPTER + TAIL)])
+    assert names(outpath) == ["r_1", "r_2"]
+
+
+def test_split_suffix_template_is_used(tmp_path):
+    _, outpath = run_split(
+        tmp_path,
+        [("r", HEAD + ADAPTER + MID + ADAPTER + TAIL)],
+        extra=["--split-suffix", ".{piece}"],
+    )
+    assert names(outpath) == ["r.1", "r.2", "r.3"]
+
+
+def test_split_suffix_knows_how_many_pieces_there_are(tmp_path):
+    _, outpath = run_split(
+        tmp_path,
+        [("r", HEAD + ADAPTER + MID + ADAPTER + TAIL)],
+        extra=["--split-suffix", "_{piece}of{pieces}"],
+    )
+    assert names(outpath) == ["r_1of3", "r_2of3", "r_3of3"]
+
+
+def test_split_suffix_is_not_applied_to_an_uncut_read(tmp_path):
+    _, outpath = run_split(
+        tmp_path, [("r", HEAD + MID)], extra=["--split-suffix", "_{piece}"]
+    )
+    assert names(outpath) == ["r"]
+
+
+def test_split_suffix_without_piece_variable_is_rejected(tmp_path):
+    assert_split_action_works(tmp_path)
+    with pytest.raises(SystemExit) as exception:
+        run_split(tmp_path, [("r", HEAD)], extra=["--split-suffix", "_{pieces}"])
+    assert exception.value.args[0] == 2
+
+
+def test_split_suffix_with_unknown_variable_is_rejected(tmp_path):
+    assert_split_action_works(tmp_path)
+    with pytest.raises(SystemExit) as exception:
+        run_split(tmp_path, [("r", HEAD)], extra=["--split-suffix", "_{id}"])
+    assert exception.value.args[0] == 2
+
+
+def test_split_suffix_needs_the_split_action(tmp_path):
+    assert_split_action_works(tmp_path)
+    inpath = write_fastq(tmp_path, [("r", HEAD + ADAPTER + TAIL)])
+    with pytest.raises(SystemExit) as exception:
+        main(
+            [
+                "-a",
+                ADAPTER,
+                "--split-suffix",
+                "_{piece}",
+                "-o",
+                os.fspath(tmp_path / "out.fastq"),
+                os.fspath(inpath),
+            ]
+        )
+    assert exception.value.args[0] == 2
+
+
+def test_minimum_length_applies_to_each_piece(tmp_path):
+    read = "AA" + ADAPTER + MID + ADAPTER + "GGG"
+    _, outpath = run_split(tmp_path, [("r", read)], extra=["-m", "4"])
+    assert sequences(outpath) == [MID]
+
+
+def test_maximum_length_applies_to_each_piece(tmp_path):
+    read = "AA" + ADAPTER + MID + ADAPTER + "GGG"
+    _, outpath = run_split(tmp_path, [("r", read)], extra=["-M", "3"])
+    assert sequences(outpath) == ["AA", "GGG"]
+
+
+def test_too_short_output_receives_the_short_pieces(tmp_path):
+    read = "AA" + ADAPTER + MID
+    short = tmp_path / "short.fastq"
+    _, outpath = run_split(
+        tmp_path, [("r", read)], extra=["-m", "4", "--too-short-output", short]
+    )
+    assert sequences(outpath) == [MID]
+    assert sequences(short) == ["AA"]
+
+
+def test_length_shortening_applies_to_each_piece(tmp_path):
+    read = HEAD + ADAPTER + TAIL
+    _, outpath = run_split(tmp_path, [("r", read)], extra=["--length", "3"])
+    assert sequences(outpath) == ["AAA", "GGG"]
+
+
+def test_expected_error_filter_applies_to_each_piece(tmp_path):
+    read = "AAAA" + ADAPTER + "GGGG"
+    qualities = "IIII" + "I" * len(ADAPTER) + "####"
+    _, outpath = run_split(
+        tmp_path, [("r", read, qualities)], extra=["--max-expected-errors", "1"]
+    )
+    assert sequences(outpath) == ["AAAA"]
+
+
+def test_too_long_output_receives_the_long_pieces(tmp_path):
+    read = "AAAA" + ADAPTER + "GG"
+    long_path = tmp_path / "long.fastq"
+    _, outpath = run_split(
+        tmp_path, [("r", read)], extra=["-M", "3", "--too-long-output", long_path]
+    )
+    assert sequences(outpath) == ["GG"]
+    assert sequences(long_path) == ["AAAA"]
+
+
+def test_n_trimming_applies_to_each_piece(tmp_path):
+    read = "NNAAAA" + ADAPTER + "GGGGNN"
+    _, outpath = run_split(tmp_path, [("r", read)], extra=["--trim-n"])
+    assert sequences(outpath) == ["AAAA", "GGGG"]
+
+
+def test_max_n_filter_applies_to_each_piece(tmp_path):
+    read = "AAAA" + ADAPTER + "GNNG"
+    _, outpath = run_split(tmp_path, [("r", read)], extra=["--max-n", "1"])
+    assert sequences(outpath) == ["AAAA"]
+
+
+def test_name_suffix_option_applies_to_each_piece(tmp_path):
+    read = HEAD + ADAPTER + TAIL
+    _, outpath = run_split(tmp_path, [("r", read)], extra=["-y", "_done"])
+    assert names(outpath) == ["r_1_done", "r_2_done"]
+
+
+def test_poly_a_trimming_applies_to_each_piece(tmp_path):
+    read = "CCCCAAAAAA" + ADAPTER + "GGGGAAAAAA"
+    _, outpath = run_split(tmp_path, [("r", read)], extra=["--poly-a"])
+    assert sequences(outpath) == ["CCCC", "GGGG"]
+
+
+def test_prefix_option_applies_to_each_piece(tmp_path):
+    read = HEAD + ADAPTER + TAIL
+    _, outpath = run_split(tmp_path, [("r", read)], extra=["-x", "pre_"])
+    assert names(outpath) == ["pre_r_1", "pre_r_2"]
+
+
+def test_length_tag_applies_to_each_piece(tmp_path):
+    read = HEAD + ADAPTER + TAIL
+    _, outpath = run_split(
+        tmp_path, [("r length=26", read)], extra=["--length-tag", "length="]
+    )
+    assert names(outpath) == ["r_1 length=8", "r_2 length=8"]
+
+
+def test_strip_suffix_applies_to_each_piece(tmp_path):
+    reads = [("r1.gone", HEAD + ADAPTER + TAIL), ("r2.gone", MID)]
+    _, outpath = run_split(tmp_path, reads, extra=["--strip-suffix", ".gone"])
+    assert names(outpath) == ["r1.gone_1", "r1.gone_2", "r2"]
+
+
+def test_shortening_from_the_end_applies_to_each_piece(tmp_path):
+    read = "ACGTACGT" + ADAPTER + "TTTTGGGG"
+    _, outpath = run_split(tmp_path, [("r", read)], extra=["--length", "-3"])
+    assert sequences(outpath) == ["CGT", "GGG"]
+
+
+def test_casava_filter_applies_to_each_piece(tmp_path):
+    reads = [
+        ("kept 1:N:0:ATC", HEAD + ADAPTER + TAIL),
+        ("dropped 1:Y:0:ATC", MID + ADAPTER + TAIL),
+    ]
+    _, outpath = run_split(tmp_path, reads, extra=["--discard-casava"])
+    assert sequences(outpath) == [HEAD, TAIL]
