+class SplittingModifier(ABC):
+    """
+    A modification that turns one read into any number of reads
+
+    Unlike a SingleEndModifier, which maps a record to a record, this maps a record to a
+    list of (record, ModificationInfo) pairs. The pipeline passes each of them on to the
+    modifications and steps that follow.
+    """
+
+    @abstractmethod
+    def split(
+        self, read: SequenceRecord, info: ModificationInfo
+    ) -> list[tuple[SequenceRecord, ModificationInfo]]:
+        """Return the pieces the read is made of, in the order they occur in it"""
+
+
+class ReadSplitter(SplittingModifier):
+    """
+    Cut reads apart at every occurrence of one of multiple adapters
+
+    Each occurrence is removed and the read is cut where it stood, so a read with n
+    occurrences becomes n+1 pieces. The search covers the sequence on both sides of every
+    occurrence, so that no piece that is handed on still contains one.
+    """
+
+    variables = {"piece", "pieces"}
+
+    def __init__(self, adapters: Sequence[Adapter], suffix: str = "_{piece}"):
+        self.suffix = suffix
+        self.with_adapters = 0
+        self.split_reads = 0
+        self.pieces = 0
+        self.adapter_statistics = {a: a.create_statistics() for a in adapters}
+        self.adapters = MultipleAdapters(list(adapters))
+        self._check_suffix(suffix)
+
+    def __repr__(self):
+        return f"ReadSplitter(adapters={self.adapters!r}, suffix='{self.suffix}')"
+
+    @classmethod
+    def _check_suffix(cls, suffix: str) -> None:
+        try:
+            tokens = list(tokenize_braces(suffix))
+        except TokenizeError as e:
+            raise InvalidTemplate(f"Error in template '{suffix}': {e}")
+        Renamer.raise_if_invalid_variable(tokens, cls.variables)
+        placeholders = {
+            token.value for token in tokens if isinstance(token, BraceToken)
+        }
+        if "piece" not in placeholders:
+            raise InvalidTemplate(
+                "Error in template: The '{piece}' variable is required"
+            )
+
+    def cut_intervals(self, sequence: str) -> list[tuple[int, int, SingleMatch]]:
+        """
+        Return the intervals covered by adapter occurrences, sorted by start position
+
+        After the best-matching occurrence has been located, the stretches of sequence to
+        its left and to its right are searched in the same way.
+        """
+        intervals: list[tuple[int, int, SingleMatch]] = []
+        pending = [(sequence, 0)]
+        while pending:
+            subsequence, offset = pending.pop()
+            match = self.adapters.match_to(subsequence)
+            if match is None or match.rstop <= match.rstart:
+                continue
+            intervals.append((offset + match.rstart, offset + match.rstop, match))
+            if match.rstart > 0:
+                pending.append((subsequence[: match.rstart], offset))
+            if match.rstop < len(subsequence):
+                pending.append((subsequence[match.rstop :], offset + match.rstop))
+        intervals.sort(key=lambda interval: interval[0])
+        return intervals
+
+    @staticmethod
+    def occurrence_match(match: SingleMatch) -> SingleMatch:
+        """
+        Return a copy of a match that reports the matched interval as the removed sequence
+
+        The per-adapter statistics record how much sequence an adapter took out. Trimming
+        takes the sequence up- or downstream of the match with it, while splitting takes
+        out the match alone, so the copy is narrowed to it. A 3' match keeps the base in
+        front of it because the statistics count those bases separately.
+        """
+        length = match.rstop - match.rstart
+        if isinstance(match, RemoveAfterMatch):
+            start = min(match.rstart, 1)
+        else:
+            start = 0
+        return type(match)(
+            match.astart,
+            match.astop,
+            start,
+            start + length,
+            match.score,
+            match.errors,
+            match.adapter,
+            match.sequence[match.rstart - start : match.rstop],
+        )
+
+    @staticmethod
+    def parse_header(name: str) -> tuple[str, str]:
+        """Return the id of a read and the remainder of its header, separator included"""
+        index = 0
+        while index < len(name) and not name[index].isspace():
+            index += 1
+        return name[:index], name[index:]
+
+    def piece_name(self, name: str, index: int, count: int) -> str:
+        read_id, rest = self.parse_header(name)
+        return read_id + self.suffix.format(piece=index, pieces=count) + rest
+
+    def cut(
+        self, read: SequenceRecord, info: ModificationInfo
+    ) -> list[tuple[SequenceRecord, ModificationInfo]]:
+        """
+        Return the pieces of a read, each with its own ModificationInfo
+
+        The occurrences that were removed are added to the adapter statistics, but the
+        piece counters are left alone so that a caller can still drop the whole read.
+        """
+        intervals = self.cut_intervals(read.sequence)
+        if intervals:
+            self.with_adapters += 1
+            for _, _, match in intervals:
+                self.adapter_statistics[match.adapter].add_match(
+                    self.occurrence_match(match)
+                )
+        pieces = []
+        neighbors: list[tuple[Optional[SingleMatch], Optional[SingleMatch]]] = []
+        start = 0
+        previous: Optional[SingleMatch] = None
+        for cut_start, cut_stop, match in intervals:
+            pieces.append(read[start:cut_start])
+            neighbors.append((previous, match))
+            previous = match
+            start = cut_stop
+        pieces.append(read[start:])
+        neighbors.append((previous, None))
+
+        count = len(pieces)
+        result: list[tuple[SequenceRecord, ModificationInfo]] = []
+        for index, (piece, (left, right)) in enumerate(zip(pieces, neighbors), 1):
+            if count > 1:
+                piece.name = self.piece_name(piece.name, index, count)
+            piece_info = PieceInfo(info.original_read)
+            piece_info.cut_prefix = info.cut_prefix
+            piece_info.cut_suffix = info.cut_suffix
+            piece_info.is_rc = info.is_rc
+            piece_info.matches = [match for match in (left, right) if match is not None]
+            result.append((piece, piece_info))
+        return result
+
+    def split(
+        self, read: SequenceRecord, info: ModificationInfo
+    ) -> list[tuple[SequenceRecord, ModificationInfo]]:
+        pieces = self.cut(read, info)
+        self.pieces += len(pieces)
+        if len(pieces) > 1:
+            self.split_reads += 1
+        return pieces
+
+
+class PairedSplittingModifier(ABC):
+    """
+    A modification that turns one read pair into any number of read pairs
+    """
+
+    @abstractmethod
+    def split(
+        self,
+        read1: SequenceRecord,
+        read2: SequenceRecord,
+        info1: ModificationInfo,
+        info2: ModificationInfo,
+    ) -> list[
+        tuple[SequenceRecord, SequenceRecord, ModificationInfo, ModificationInfo]
+    ]:
+        """Return the piece pairs the read pair is made of"""
+
+
+class PairedReadSplitter(PairedSplittingModifier):
+    """
+    Cut both reads of a pair apart and pair up the pieces by their position
+
+    A pair whose reads do not fall into the same number of pieces is dropped, since its
+    pieces cannot be paired up.
+    """
+
+    def __init__(
+        self,
+        adapters1: Sequence[Adapter],
+        adapters2: Sequence[Adapter],
+        suffix: str = "_{piece}",
+    ):
+        self.splitter1 = ReadSplitter(adapters1, suffix)
+        self.splitter2 = ReadSplitter(adapters2, suffix)
+        self.split_reads = 0
+        self.pieces = 0
+        self.unequal_pairs = 0
+
+    def __repr__(self):
+        return (
+            f"PairedReadSplitter(splitter1={self.splitter1!r}, "
+            f"splitter2={self.splitter2!r})"
+        )
+
+    def split(
+        self,
+        read1: SequenceRecord,
+        read2: SequenceRecord,
+        info1: ModificationInfo,
+        info2: ModificationInfo,
+    ) -> list[
+        tuple[SequenceRecord, SequenceRecord, ModificationInfo, ModificationInfo]
+    ]:
+        first = self.splitter1.cut(read1, info1)
+        second = self.splitter2.cut(read2, info2)
+        if len(first) != len(second):
+            self.unequal_pairs += 1
+            return []
+        self.pieces += len(first)
+        if len(first) > 1:
+            self.split_reads += 1
+        return [
+            (piece1, piece2, piece_info1, piece_info2)
+            for (piece1, piece_info1), (piece2, piece_info2) in zip(first, second)
+        ]
