+#[test]
+fn backend_removal_fades_from_backend_time() {
+    let mut front = Sequencer::new(0, 1, ReplayMode::None);
+    let mut back = front.backend();
+    let id = dc_event(&mut front, 0, 1000, 1.0);
+    dc_event(&mut front, 0, 1000, 0.25);
+    front.commit();
+    let first = ticks(&mut back, 20);
+    front.remove(id, at(10));
+    let second = ticks(&mut back, 5);
+    front.commit();
+    let third = blocks(&mut back, 40, &[64]);
+    let output = [first, second, third].concat();
+    assert_same("before", &segments(&[(1.25, 26)]), &output[0..26]);
+    for i in 26..35 {
+        assert!(output[i] < output[i - 1] && output[i] > 0.25, "sample {i}");
+    }
+    assert_same("after", &segments(&[(0.25, 30)]), &output[35..65]);
+}
