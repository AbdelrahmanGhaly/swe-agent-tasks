+#[test]
+fn backend_removes_events_after_commit() {
+    let mut front = Sequencer::new(0, 1, ReplayMode::All);
+    let mut back = front.backend();
+    let a = dc_event(&mut front, 0, 100, 1.0);
+    let b = dc_event(&mut front, 0, 100, 2.0);
+    front.set_at(at(40), Setting::value(4.0).event(b));
+    front.commit();
+    let first = ticks(&mut back, 10);
+    front.remove(a, 0.0);
+    let second = blocks(&mut back, 10, &[64]);
+    front.commit();
+    let third = blocks(&mut back, 90, &[64]);
+    back.reset();
+    let fourth = ticks(&mut back, 50);
+    assert_same(
+        "output",
+        &segments(&[(3.0, 20), (2.0, 20), (4.0, 60), (0.0, 10)]),
+        &[first, second, third].concat(),
+    );
+    assert_same("replay", &segments(&[(2.0, 40), (4.0, 10)]), &fourth);
+}
