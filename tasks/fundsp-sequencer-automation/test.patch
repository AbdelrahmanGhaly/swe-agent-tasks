+fn stereo_events_receive_settings_on_both_channels() {
+    let build = || {
+        let mut seq = Sequencer::new(0, 2, ReplayMode::All);
+        let id = seq.push(
+            at(9),
+            at(120),
+            Fade::Smooth,
+            at(6),
+            at(17),
+            Box::new(dc((1.0, 2.0))),
+        );
+        seq.set_at(at(40), Setting::value(5.0).event(id));
+        let other = seq.push(
+            at(30),
+            at(90),
+            Fade::Power,
+            0.0,
+            0.0,
+            Box::new(dc((0.5, -0.5))),
+        );
+        seq.set_at(at(70), Setting::value(-3.0).event(other));
+        seq
+    };
+    let mut seq = build();
+    let mut expected = Vec::new();
+    let mut frame = [0.0f32; 2];
+    for _ in 0..140 {
+        seq.tick(&[], &mut frame);
+        expected.push(frame);
+    }
+    for sizes in BLOCKS {
+        let mut seq = build();
+        let input = BufferVec::new(0);
+        let mut output = BufferVec::new(2);
+        let mut actual = Vec::new();
+        let mut k = 0;
+        while actual.len() < 140 {
+            let size = core::cmp::min(sizes[k % sizes.len()], 140 - actual.len());
+            k += 1;
+            seq.process(size, &input.buffer_ref(), &mut output.buffer_mut());
+            for i in 0..size {
+                actual.push([output.at_f32(0, i), output.at_f32(1, i)]);
+            }
+        }
+        for channel in 0..2 {
+            let a: Vec<f32> = expected.iter().map(|x| x[channel]).collect();
+            let b: Vec<f32> = actual.iter().map(|x| x[channel]).collect();
+            assert_same(&format!("channel {channel} block sizes {sizes:?}"), &a, &b);
+        }
+    }
+    assert_eq!(expected[20], [1.0, 2.0]);
+    assert_eq!(expected[50], [5.5, 4.5]);
+    assert_eq!(expected[80], [2.0, 2.0]);
+    assert_eq!(expected[130], [0.0, 0.0]);
+}
