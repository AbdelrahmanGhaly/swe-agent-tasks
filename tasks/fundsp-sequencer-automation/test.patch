+#[test]
+fn backend_matches_plain_sequencer() {
+    let mut plain = Sequencer::new(0, 1, ReplayMode::Loop(at(150)));
+    let mut front = Sequencer::new(0, 1, ReplayMode::Loop(at(150)));
+    let mut back = front.backend();
+    let mut output_plain = Vec::new();
+    let mut output_back = Vec::new();
+    for round in 0..4 {
+        for seq in [&mut plain, &mut front] {
+            let id = seq.push_relative(
+                at(3 + round),
+                at(90 + round * 7),
+                Fade::Smooth,
+                at(4),
+                at(9),
+                Box::new(dc(1.0 + round as f32)),
+            );
+            seq.set_at_relative(at(20), Setting::value(-1.0).event(id));
+            seq.set_at(at(140), Setting::value(5.0).event(id));
+        }
+        front.commit();
+        output_plain.extend(ticks(&mut plain, 70));
+        output_back.extend(blocks(&mut back, 70, &[64, 6]));
+    }
+    assert_same("backend", &output_plain, &output_back);
+}
