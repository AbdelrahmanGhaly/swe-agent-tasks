+#[test]
+fn clone_keeps_scheduled_settings() {
+    let mut seq = Sequencer::new(0, 1, ReplayMode::All);
+    let id = dc_event(&mut seq, 10, 90, 1.0);
+    let other = dc_event(&mut seq, 0, 50, 2.0);
+    seq.set_at(at(40), Setting::value(4.0).event(id));
+    seq.set_at(at(20), Setting::value(3.0).event(other));
+    let first = ticks(&mut seq, 30);
+    let mut copy = seq.clone();
+    let rest = ticks(&mut seq, 70);
+    let rest_copy = blocks(&mut copy, 70, &[64]);
+    assert_same("copy", &rest, &rest_copy);
+    assert_same(
+        "output",
+        &segments(&[
+            (2.0, 10),
+            (3.0, 10),
+            (4.0, 20),
+            (7.0, 10),
+            (4.0, 40),
+            (0.0, 10),
+        ]),
+        &[first, rest].concat(),
+    );
+}
