+#[test]
+fn reset_without_replay_drops_events_and_settings() {
+    let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+    let id = dc_event(&mut seq, 0, 100, 1.0);
+    let later = dc_event(&mut seq, 50, 100, 1.0);
+    seq.set_at(at(10), Setting::value(2.0).event(id));
+    seq.set_at(at(60), Setting::value(3.0).event(later));
+    let first = ticks(&mut seq, 20);
+    seq.reset();
+    seq.set_at(at(5), Setting::value(4.0).event(id));
+    let second = blocks(&mut seq, 100, &[64]);
+    assert_same("first", &segments(&[(1.0, 10), (2.0, 10)]), &first);
+    assert_same("second", &segments(&[(0.0, 100)]), &second);
+}
