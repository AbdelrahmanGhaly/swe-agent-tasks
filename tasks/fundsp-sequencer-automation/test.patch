+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      [ -n "$OUTPUT_PATH" ] || { echo "missing value for --output_path" >&2; usage; }
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")" || exit 2
+
+export CARGO_HOME="${CARGO_HOME:-/opt/cargo}"
+export PATH="$CARGO_HOME/bin:$PATH"
+export CARGO_NET_OFFLINE=true
+export CARGO_TERM_COLOR=never
+export RUSTC_BOOTSTRAP=1
+
+NEW_TARGET="sequencer_settings_127feb"
+TEST_JSON="$(mktemp)"
+TEST_ERR="$(mktemp)"
+trap 'rm -f "$TEST_JSON" "$TEST_ERR"' EXIT
+
+LIMIT=""
+if command -v timeout >/dev/null 2>&1; then
+  LIMIT="timeout 1800"
+fi
+
+if [ "$MODE" = "base" ]; then
+  $LIMIT cargo test --offline --lib \
+    --test test_basic --test test_dynamics --test test_flow --test test_follow \
+    -- -Z unstable-options --format json --report-time >"$TEST_JSON" 2>"$TEST_ERR"
+  STATUS=$?
+else
+  $LIMIT cargo test --offline --test "$NEW_TARGET" \
+    -- -Z unstable-options --format json --report-time >"$TEST_JSON" 2>"$TEST_ERR"
+  STATUS=$?
+fi
+tail -n 200 "$TEST_ERR" >&2
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+expected_tests() {
+  awk '/#\[test\]/ { want = 1; next }
+       want && /fn [A-Za-z0-9_]+/ { sub(/.*fn /, ""); sub(/\(.*/, ""); print; want = 0 }' \
+    "tests/$NEW_TARGET.rs"
+}
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  cargo2junit <"$TEST_JSON" >"$OUTPUT_PATH" 2>/dev/null || true
+  DETAIL="$({ tail -c 3000 "$TEST_ERR"; tail -c 1000 "$TEST_JSON"; } | xml_escape)"
+  if [ "$MODE" = "new" ]; then
+    MISSING=0
+    for name in $(expected_tests); do
+      grep -q "name=\"$name\"" "$OUTPUT_PATH" 2>/dev/null || MISSING=1
+    done
+    if [ "$MISSING" -eq 1 ]; then
+      [ "$STATUS" -eq 0 ] && STATUS=1
+      {
+        echo '<?xml version="1.0" encoding="UTF-8"?>'
+        echo '<testsuites>'
+        echo '  <testsuite name="cargo test #0" errors="0">'
+        for name in $(expected_tests); do
+          if grep -q "\"name\": \"$name\", \"event\": \"ok\"" "$TEST_JSON"; then
+            echo "    <testcase name=\"$name\" classname=\"\" />"
+          else
+            echo "    <testcase name=\"$name\" classname=\"\"><failure message=\"test did not run to completion\">$DETAIL</failure></testcase>"
+          fi
+        done
+        echo '  </testsuite>'
+        echo '</testsuites>'
+      } >"$OUTPUT_PATH"
+    fi
+  elif ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    [ "$STATUS" -eq 0 ] && STATUS=1
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      echo '<testsuites>'
+      echo '  <testsuite name="cargo test #0" errors="0">'
+      echo "    <testcase name=\"compilation\" classname=\"\"><failure message=\"build failed\">$DETAIL</failure></testcase>"
+      echo '  </testsuite>'
+      echo '</testsuites>'
+    } >"$OUTPUT_PATH"
+  fi
+fi
+
+exit "$STATUS"
