@@ -0,0 +1,1721 @@
+#![allow(
+    clippy::float_cmp,
+    clippy::manual_range_contains,
+    clippy::needless_range_loop
+)]
+
+use fundsp::prelude64::*;
+use std::sync::{Arc, Mutex};
+
+const SR: f64 = 44100.0;
+
+const BLOCKS: [&[usize]; 6] = [&[64], &[1], &[7], &[13, 51], &[32, 3, 64, 29], &[60, 4]];
+
+type Log = Arc<Mutex<Vec<(usize, f32)>>>;
+
+#[derive(Clone)]
+struct Probe {
+    value: f32,
+    rendered: usize,
+    log: Log,
+}
+
+fn probe(value: f32) -> (Box<dyn AudioUnit>, Log) {
+    let log: Log = Arc::new(Mutex::new(Vec::new()));
+    let unit = Probe {
+        value,
+        rendered: 0,
+        log: log.clone(),
+    };
+    (Box::new(unit), log)
+}
+
+impl AudioUnit for Probe {
+    fn reset(&mut self) {
+        self.rendered = 0;
+    }
+
+    fn tick(&mut self, _input: &[f32], output: &mut [f32]) {
+        output[0] = self.value;
+        self.rendered += 1;
+    }
+
+    fn process(&mut self, size: usize, _input: &BufferRef, output: &mut BufferMut) {
+        for i in 0..size {
+            output.set_f32(0, i, self.value);
+        }
+        self.rendered += size;
+    }
+
+    fn set(&mut self, setting: Setting) {
+        if let Parameter::Value(value) = setting.parameter() {
+            self.value = *value;
+            self.log.lock().unwrap().push((self.rendered, *value));
+        }
+    }
+
+    fn inputs(&self) -> usize {
+        0
+    }
+
+    fn outputs(&self) -> usize {
+        1
+    }
+
+    fn route(&mut self, input: &SignalFrame, _frequency: f64) -> SignalFrame {
+        Routing::Generator(0.0).route(input, 1)
+    }
+
+    fn get_id(&self) -> u64 {
+        0x127feb
+    }
+
+    fn footprint(&self) -> usize {
+        core::mem::size_of::<Self>()
+    }
+}
+
+fn at(sample: usize) -> f64 {
+    sample as f64 / SR
+}
+
+fn entries(log: &Log) -> Vec<(usize, f32)> {
+    log.lock().unwrap().clone()
+}
+
+fn ticks(unit: &mut dyn AudioUnit, length: usize) -> Vec<f32> {
+    let input = vec![0.0; unit.inputs()];
+    let mut output = vec![0.0; unit.outputs()];
+    let mut result = Vec::with_capacity(length);
+    for _ in 0..length {
+        unit.tick(&input, &mut output);
+        result.push(output[0]);
+    }
+    result
+}
+
+fn blocks(unit: &mut dyn AudioUnit, length: usize, sizes: &[usize]) -> Vec<f32> {
+    let input = BufferVec::new(unit.inputs());
+    let mut output = BufferVec::new(unit.outputs());
+    let mut result = Vec::with_capacity(length);
+    let mut k = 0;
+    while result.len() < length {
+        let size = core::cmp::min(sizes[k % sizes.len()], length - result.len());
+        k += 1;
+        unit.process(size, &input.buffer_ref(), &mut output.buffer_mut());
+        for i in 0..size {
+            result.push(output.at_f32(0, i));
+        }
+    }
+    result
+}
+
+fn ticks_with_input(unit: &mut dyn AudioUnit, input: &[f32]) -> Vec<f32> {
+    let mut output = vec![0.0; unit.outputs()];
+    let mut result = Vec::with_capacity(input.len());
+    for x in input {
+        unit.tick(&[*x], &mut output);
+        result.push(output[0]);
+    }
+    result
+}
+
+fn blocks_with_input(unit: &mut dyn AudioUnit, input: &[f32], sizes: &[usize]) -> Vec<f32> {
+    let mut input_buffer = BufferVec::new(1);
+    let mut output = BufferVec::new(unit.outputs());
+    let mut result = Vec::with_capacity(input.len());
+    let mut k = 0;
+    while result.len() < input.len() {
+        let offset = result.len();
+        let size = core::cmp::min(sizes[k % sizes.len()], input.len() - offset);
+        k += 1;
+        for i in 0..size {
+            input_buffer.set_f32(0, i, input[offset + i]);
+        }
+        unit.process(size, &input_buffer.buffer_ref(), &mut output.buffer_mut());
+        for i in 0..size {
+            result.push(output.at_f32(0, i));
+        }
+    }
+    result
+}
+
+fn assert_same(context: &str, expected: &[f32], actual: &[f32]) {
+    assert_eq!(expected.len(), actual.len(), "{context}: length");
+    for i in 0..expected.len() {
+        assert!(
+            (expected[i] - actual[i]).abs() <= 1.0e-4,
+            "{context}: sample {i}: expected {} got {}",
+            expected[i],
+            actual[i]
+        );
+    }
+}
+
+fn segments(parts: &[(f32, usize)]) -> Vec<f32> {
+    let mut result = Vec::new();
+    for (value, length) in parts {
+        result.extend(core::iter::repeat_n(*value, *length));
+    }
+    result
+}
+
+fn check_blocks(build: impl Fn() -> Sequencer, length: usize) -> Vec<f32> {
+    let expected = ticks(&mut build(), length);
+    for sizes in BLOCKS {
+        let actual = blocks(&mut build(), length, sizes);
+        assert_same(&format!("block sizes {sizes:?}"), &expected, &actual);
+    }
+    expected
+}
+
+fn check_blocks_with_input(build: impl Fn() -> Sequencer, input: &[f32]) -> Vec<f32> {
+    let expected = ticks_with_input(&mut build(), input);
+    for sizes in BLOCKS {
+        let actual = blocks_with_input(&mut build(), input, sizes);
+        assert_same(&format!("block sizes {sizes:?}"), &expected, &actual);
+    }
+    expected
+}
+
+fn dc_event(seq: &mut Sequencer, start: usize, end: usize, value: f32) -> EventId {
+    seq.push(
+        at(start),
+        at(end),
+        Fade::Smooth,
+        0.0,
+        0.0,
+        Box::new(dc(value)),
+    )
+}
+
+#[test]
+fn setting_arrives_on_its_sample() {
+    let build = || {
+        let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+        let id = dc_event(&mut seq, 0, 44100, 1.0);
+        seq.set_at(at(10), Setting::value(5.0).event(id));
+        seq
+    };
+    let output = check_blocks(build, 40);
+    assert_same("output", &segments(&[(1.0, 10), (5.0, 30)]), &output);
+}
+
+#[test]
+fn fractional_times_round_to_the_nearest_sample() {
+    let build = || {
+        let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+        let id = seq.push(0.0, 1.0, Fade::Smooth, 0.0, 0.0, Box::new(dc(1.0)));
+        seq.set_at(10.3 / SR, Setting::value(2.0).event(id));
+        seq.set_at(20.7 / SR, Setting::value(3.0).event(id));
+        seq.set_at(63.6 / SR, Setting::value(4.0).event(id));
+        seq.set_at(70.2 / SR, Setting::value(5.0).event(id));
+        let late = seq.push(30.8 / SR, 1.0, Fade::Smooth, 0.0, 0.0, Box::new(dc(10.0)));
+        seq.set_at(29.9 / SR, Setting::value(20.0).event(late));
+        seq.set_at(45.4 / SR, Setting::value(30.0).event(late));
+        seq
+    };
+    let output = check_blocks(build, 100);
+    let expected = segments(&[
+        (1.0, 10),
+        (2.0, 11),
+        (3.0, 10),
+        (23.0, 14),
+        (33.0, 19),
+        (34.0, 6),
+        (35.0, 30),
+    ]);
+    assert_same("output", &expected, &output);
+}
+
+#[test]
+fn event_address_is_peeled_in_order() {
+    let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+    let id = dc_event(&mut seq, 0, 100, 1.0);
+    let node = NodeId::new();
+    let setting = Setting::value(1.0).event(id).node(node);
+    match setting.direction() {
+        Address::Event(event) => assert!(event == id),
+        _ => panic!("expected an event address"),
+    }
+    match setting.peel().direction() {
+        Address::Node(inner) => assert!(inner == node),
+        _ => panic!("expected a node address"),
+    }
+    let outer = Setting::value(1.0).node(node).event(id);
+    match outer.peel().direction() {
+        Address::Event(event) => assert!(event == id),
+        _ => panic!("expected an event address"),
+    }
+}
+
+#[test]
+fn settings_on_block_edges_arrive_on_their_samples() {
+    let build = || {
+        let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+        let id = dc_event(&mut seq, 0, 44100, 1.0);
+        seq.set_at(at(63), Setting::value(2.0).event(id));
+        seq.set_at(at(64), Setting::value(3.0).event(id));
+        seq.set_at(at(65), Setting::value(4.0).event(id));
+        seq.set_at(at(127), Setting::value(5.0).event(id));
+        seq.set_at(at(128), Setting::value(6.0).event(id));
+        seq
+    };
+    let output = check_blocks(build, 200);
+    let expected = segments(&[
+        (1.0, 63),
+        (2.0, 1),
+        (3.0, 1),
+        (4.0, 62),
+        (5.0, 1),
+        (6.0, 72),
+    ]);
+    assert_same("output", &expected, &output);
+}
+
+#[test]
+fn many_settings_inside_one_block() {
+    let build = || {
+        let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+        let id = dc_event(&mut seq, 0, 44100, 0.0);
+        for i in 1..40 {
+            seq.set_at(at(i * 3), Setting::value(i as f32).event(id));
+        }
+        seq
+    };
+    let output = check_blocks(build, 150);
+    for i in 0..150 {
+        let expected = core::cmp::min(i / 3, 39) as f32;
+        assert_eq!(output[i], expected, "sample {i}");
+    }
+}
+
+#[test]
+fn setting_before_start_arrives_before_first_sample() {
+    let build = || {
+        let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+        let id = dc_event(&mut seq, 5, 40, 1.0);
+        seq.set_at(at(2), Setting::value(3.0).event(id));
+        seq
+    };
+    let output = check_blocks(build, 50);
+    assert_same(
+        "output",
+        &segments(&[(0.0, 5), (3.0, 35), (0.0, 10)]),
+        &output,
+    );
+}
+
+#[test]
+fn setting_at_start_arrives_before_first_sample() {
+    let build = || {
+        let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+        let a = dc_event(&mut seq, 20, 90, 1.0);
+        let b = dc_event(&mut seq, 70, 100, 10.0);
+        seq.set_at(at(20), Setting::value(2.0).event(a));
+        seq.set_at(at(70), Setting::value(30.0).event(b));
+        seq
+    };
+    let output = check_blocks(build, 110);
+    let expected = segments(&[(0.0, 20), (2.0, 50), (32.0, 20), (30.0, 10), (0.0, 10)]);
+    assert_same("output", &expected, &output);
+}
+
+#[test]
+fn settings_at_or_after_end_never_arrive() {
+    for sizes in [None, Some(&[64usize][..]), Some(&[3usize][..])] {
+        let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+        let (unit, log) = probe(1.0);
+        let id = seq.push(0.0, at(10), Fade::Smooth, 0.0, 0.0, unit);
+        seq.set_at(at(9), Setting::value(6.0).event(id));
+        seq.set_at(at(10), Setting::value(7.0).event(id));
+        seq.set_at(at(30), Setting::value(8.0).event(id));
+        let output = match sizes {
+            None => ticks(&mut seq, 40),
+            Some(sizes) => blocks(&mut seq, 40, sizes),
+        };
+        assert_same(
+            "output",
+            &segments(&[(1.0, 9), (6.0, 1), (0.0, 30)]),
+            &output,
+        );
+        assert_eq!(entries(&log), vec![(9, 6.0)], "{sizes:?}");
+    }
+}
+
+#[test]
+fn setting_after_edited_end_never_arrives() {
+    let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+    let (unit, log) = probe(1.0);
+    let id = seq.push(0.0, 1.0, Fade::Smooth, 0.0, 0.0, unit);
+    seq.set_at(at(15), Setting::value(2.0).event(id));
+    seq.set_at(at(25), Setting::value(3.0).event(id));
+    let first = ticks(&mut seq, 10);
+    seq.edit(id, at(20), 0.0);
+    let second = ticks(&mut seq, 30);
+    assert_same("first", &segments(&[(1.0, 10)]), &first);
+    assert_same(
+        "second",
+        &segments(&[(1.0, 5), (2.0, 5), (0.0, 20)]),
+        &second,
+    );
+    assert_eq!(entries(&log), vec![(15, 2.0)]);
+}
+
+#[test]
+fn same_sample_settings_arrive_in_scheduling_order() {
+    for sizes in [None, Some(&[64usize][..]), Some(&[5usize][..])] {
+        let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+        let (unit, log) = probe(1.0);
+        let id = seq.push(0.0, 1.0, Fade::Smooth, 0.0, 0.0, unit);
+        seq.set_at(at(8), Setting::value(5.0).event(id));
+        seq.set_at(at(4), Setting::value(2.0).event(id));
+        seq.set_at(at(4), Setting::value(3.0).event(id));
+        seq.set_at(at(6), Setting::value(7.0).event(id));
+        seq.set_at(at(4), Setting::value(9.0).event(id));
+        seq.set_at(at(8), Setting::value(4.0).event(id));
+        let output = match sizes {
+            None => ticks(&mut seq, 12),
+            Some(sizes) => blocks(&mut seq, 12, sizes),
+        };
+        assert_same(
+            "output",
+            &segments(&[(1.0, 4), (9.0, 2), (7.0, 2), (4.0, 4)]),
+            &output,
+        );
+        assert_eq!(
+            entries(&log),
+            vec![(4, 2.0), (4, 3.0), (4, 9.0), (6, 7.0), (8, 5.0), (8, 4.0)],
+            "{sizes:?}"
+        );
+    }
+}
+
+#[test]
+fn same_sample_settings_keep_scheduling_order_across_fractions() {
+    for sizes in [None, Some(&[64usize][..]), Some(&[3usize][..])] {
+        let mut seq = Sequencer::new(0, 1, ReplayMode::All);
+        let (unit, log) = probe(1.0);
+        let id = seq.push(0.0, at(40), Fade::Smooth, 0.0, 0.0, unit);
+        seq.set_at(10.4 / SR, Setting::value(2.0).event(id));
+        seq.set_at(10.3 / SR, Setting::value(3.0).event(id));
+        seq.set_at(20.2 / SR, Setting::value(5.0).event(id));
+        seq.set_at(19.6 / SR, Setting::value(6.0).event(id));
+        seq.set_at(30.6 / SR, Setting::value(7.0).event(id));
+        seq.set_at(30.2 / SR, Setting::value(8.0).event(id));
+        let render = |seq: &mut Sequencer| match sizes {
+            None => ticks(seq, 50),
+            Some(sizes) => blocks(seq, 50, sizes),
+        };
+        let expected = segments(&[
+            (1.0, 10),
+            (3.0, 10),
+            (6.0, 10),
+            (8.0, 1),
+            (7.0, 9),
+            (0.0, 10),
+        ]);
+        let pass = [
+            (10, 2.0),
+            (10, 3.0),
+            (20, 5.0),
+            (20, 6.0),
+            (30, 8.0),
+            (31, 7.0),
+        ];
+        assert_same("first pass", &expected, &render(&mut seq));
+        assert_eq!(entries(&log), pass.to_vec(), "{sizes:?}");
+        seq.reset();
+        assert_same("replay", &expected, &render(&mut seq));
+        assert_eq!(entries(&log), [pass, pass].concat(), "{sizes:?}");
+    }
+}
+
+#[test]
+fn late_setting_arrives_before_next_sample() {
+    let mut seq = Sequencer::new(0, 1, ReplayMode::None);
+    let (unit, log) = probe(1.0);
+    let id = seq.push(0.0, 1.0, Fade::Smooth, 0.0, 0.0, unit);
+    let first = ticks(&mut seq, 20);
+    seq.set_at(at(3), Setting::value(4.0).event(id));
+    let second = ticks(&mut seq, 5);
+    assert_same("first", &segments(&[(1.0, 20)]), &first);
+    assert_same("second", &segments(&[(4.0, 5)]), &second);
+    assert_eq!(entries(&log), vec![(20, 4.0)]);
+}
+
+#[test]
+fn late_setting_before_a_delivered_one_arrives_next() {
+    for sizes in [None, Some(&[64usize][..]), Some(&[9usize][..])] {
+        let mut seq = Sequencer::new(0, 1, ReplayMode::All);
+        let (unit, log) = probe(1.0);
+        let id = seq.push(0.0, at(40), Fade::Smooth, 0.0, 0.0, unit);
+        seq.set_at(at(10), Setting::value(2.0).event(id));
+        let render = |seq: &mut Sequencer, length: usize| match sizes {
+            None => ticks(seq, length),
+            Some(sizes) => blocks(seq, length, sizes),
+        };
+        let first = render(&mut seq, 20);
+        seq.set_at(at(5), Setting::value(3.0).event(id));
+        let second = render(&mut seq, 30);
+        seq.reset();
+        let third = render(&mut seq, 50);
+        assert_same(
+            "first pass",
+            &segments(&[(1.0, 10), (2.0, 10), (3.0, 20), (0.0, 10)]),
+            &[first, second].concat(),
+        );
+        assert_same(
+            "replay",
+            &segments(&[(1.0, 5), (3.0, 5), (2.0, 30), (0.0, 10)]),
+            &third,
+        );
+        assert_eq!(
+            entries(&log),
+            vec![(10, 2.0), (20, 3.0), (5, 3.0), (10, 2.0)],
+            "{sizes:?}"
+        );
+    }
+}
+
