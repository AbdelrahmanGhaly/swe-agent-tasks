+#[test]
+fn backend_set_applies_at_backend_time() {
+    let mut front = Sequencer::new(0, 1, ReplayMode::All);
+    let mut back = front.backend();
+    let id = dc_event(&mut front, 0, 60, 1.0);
+    front.commit();
+    let first = ticks(&mut back, 10);
+    back.set(Setting::value(3.0).event(id));
+    let second = blocks(&mut back, 70, &[64]);
+    back.reset();
+    let third = ticks(&mut back, 70);
+    assert_same(
+        "first",
+        &[first, second].concat(),
+        &segments(&[(1.0, 10), (3.0, 50), (0.0, 20)]),
+    );
+    assert_same(
+        "replay",
+        &segments(&[(1.0, 10), (3.0, 50), (0.0, 10)]),
+        &third,
+    );
+}
