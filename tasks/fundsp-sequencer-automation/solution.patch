+    /// Schedule a setting for an event. The event is picked with the `event` address of the setting.
+    /// The setting is applied to the unit of the event at `time` seconds, with sample accuracy.
+    /// Settings are retained with the event and applied again when the event is replayed.
+    pub fn set_at(&mut self, time: f64, setting: Setting) {
+        if let Some((_sender, receiver)) = &mut self.front {
+            // Deallocate all past events.
+            while receiver.dequeue().is_some() {}
+            // Send the new setting over.
+            self.commit_message
+                .edits
+                .push(Message::SetAt(time, setting));
+        } else if let Address::Event(id) = setting.direction() {
+            let setting = setting.peel();
+            let replay = self.is_replay();
+            let (first, last) = setting_range(&self.settings, id);
+            let event = match self.active_map.get(&id) {
+                Some(&i) => Some(&mut self.active[i]),
+                None if replay => self.past.iter_mut().find(|event| event.id == id),
+                None => None,
+            };
+            let (start_time, position) = if let Some(event) = event {
+                if replay {
+                    event.make_template();
+                }
+                let offset = time - event.start_time;
+                let position = setting_position(
+                    &self.settings[first..last],
+                    event.start_time,
+                    offset,
+                    self.sample_rate,
+                );
+                if position < event.next_setting {
+                    event.unit.set(setting.clone());
+                    event.next_setting += 1;
+                }
+                (event.start_time, position)
+            } else if let Some(event) = self.ready.iter().find(|event| event.id == id) {
+                let offset = time - event.start_time;
+                let position = setting_position(
+                    &self.settings[first..last],
+                    event.start_time,
+                    offset,
+                    self.sample_rate,
+                );
+                (event.start_time, position)
+            } else {
+                return;
+            };
+            self.settings.insert(
+                first + position,
+                Scheduled {
+                    id,
+                    offset: time - start_time,
+                    sequence: self.sequence,
+                    setting,
+                },
+            );
+            self.sequence += 1;
+        }
+    }
