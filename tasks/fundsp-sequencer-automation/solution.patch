+/// Position of a new setting `offset` seconds from `start_time` among the settings of an event.
+/// Settings are ordered by delivery sample and then by scheduling order.
+#[inline]
+fn setting_position(
+    settings: &[Scheduled],
+    start_time: f64,
+    offset: f64,
+    sample_rate: f64,
+) -> usize {
+    let sample = delivery_sample(start_time, offset, sample_rate);
+    settings.partition_point(|setting| {
+        delivery_sample(start_time, setting.offset, sample_rate) <= sample
+    })
 }
 
