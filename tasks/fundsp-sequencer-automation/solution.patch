+    /// Remove an event. If the event is playing, it fades out over `fade_out_time` seconds
+    /// starting from current time. Removed events are not replayed.
+    pub fn remove(&mut self, id: EventId, fade_out_time: f64) {
+        if let Some((_sender, receiver)) = &mut self.front {
+            // Deallocate all past events.
+            while receiver.dequeue().is_some() {}
+            // Send the removal over.
+            self.commit_message
+                .edits
+                .push(Message::Remove(id, fade_out_time));
+        } else {
+            self.remove_event(id, fade_out_time);
+        }
+    }
+
+    /// Remove an event. This is an internal method.
+    pub(crate) fn remove_event(&mut self, id: EventId, fade_out_time: f64) {
+        self.edit_map.remove(&id);
+        if let Some(&i) = self.active_map.get(&id) {
+            if fade_out_time > 0.0
+                && self.active[i].end_time > self.time + 0.5 * self.sample_duration
+            {
+                let event = &mut self.active[i];
+                event.removed = true;
+                event.end_time = self.time + fade_out_time;
+                event.fade_out = fade_out_time;
+                return;
+            }
+            self.active_map.remove(&id);
+            if i + 1 < self.active.len() {
+                self.active_map
+                    .insert(self.active[self.active.len() - 1].id, i);
+            }
+            let event = self.active.swap_remove(i);
+            self.removed.push(event);
+        } else if let Some(i) = self.past.iter().position(|event| event.id == id) {
+            let event = self.past.swap_remove(i);
+            self.removed.push(event);
+        } else if self.ready.iter().any(|event| event.id == id) {
+            let mut ready = core::mem::take(&mut self.ready).into_vec();
+            if let Some(i) = ready.iter().position(|event| event.id == id) {
+                let event = ready.swap_remove(i);
+                self.removed.push(event);
+            }
+            self.ready = BinaryHeap::from(ready);
+        }
+        self.remove_settings(id);
+    }
+
+    /// Remove the scheduled settings of event `id`.
+    fn remove_settings(&mut self, id: EventId) {
+        let (first, last) = setting_range(&self.settings, id);
+        self.settings.drain(first..last);
+    }
+
+    /// Create replay templates for all events.
+    fn make_templates(&mut self) {
+        for event in self.active.iter_mut().chain(self.past.iter_mut()) {
+            event.make_template();
+        }
+        let mut ready = core::mem::take(&mut self.ready).into_vec();
+        for event in ready.iter_mut() {
+            event.make_template();
+        }
+        self.ready = BinaryHeap::from(ready);
+    }
+
