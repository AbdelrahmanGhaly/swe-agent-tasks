+#!/bin/sh
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/results.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+cd "$(dirname "$0")" || exit 1
+. ./env.sh
+export JSON2XML=json2xml
+export YANG2HTML=yang2html
+export YANG2DSDL="env PYANG=$PYANG $W/bin/yang2dsdl"
+
+BASETEMP="$(mktemp -d)"
+
+if [ "$MODE" = "new" ]; then
+  TESTS="test/test_resolve/test_resolved_output_3ff91a.py"
+else
+  TESTS="test/test_makefile_suite_3ff91a.py"
+  umask 0000
+  ACCESS=test/test_bad/access.yang
+  if [ -f "$ACCESS" ] && [ ! -O "$ACCESS" ]; then
+    cp "$ACCESS" "$ACCESS.$$" && mv -f "$ACCESS.$$" "$ACCESS"
+  fi
+fi
+
+LOG="$BASETEMP.log"
+python -m pytest "$TESTS" -v -p no:cacheprovider --basetemp="$BASETEMP" \
+    --junitxml="$OUTPUT_PATH" > "$LOG" 2>&1
+EXIT_CODE=$?
+cat "$LOG"
+rm -rf "$BASETEMP"
+
+if [ ! -f "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  python - "$OUTPUT_PATH" "$LOG" <<'PYEOF'
+import sys
+from xml.sax.saxutils import escape, quoteattr
+with open(sys.argv[2], errors='replace') as f:
+    output = f.read()
+with open(sys.argv[1], 'w') as f:
+    f.write('<?xml version="1.0" encoding="utf-8"?>\n'
+            '<testsuites><testsuite name="pytest" tests="1" failures="1" '
+            'errors="0" time="0">\n'
+            '<testcase classname="test.sh" name="collection">\n'
+            '<failure message=%s>%s</failure>\n'
+            '</testcase>\n</testsuite></testsuites>\n'
+            % (quoteattr('pytest did not report any test results'),
+               escape(output)))
+PYEOF
+  rm -f "$LOG"
+  exit 1
+fi
+rm -f "$LOG"
+
+exit $EXIT_CODE
