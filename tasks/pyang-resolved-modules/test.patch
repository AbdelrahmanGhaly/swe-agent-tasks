+      refine rows { max-elements 5; }
+    }
+  }
+"""
+    modules = {'main.yang': main_module(body, 'import shapes { prefix s; }'),
+               'shapes.yang': SHAPES}
+    assert_resolved(tmp_path, fmt, modules)
+
+
+@FORMATS
+def test_module_without_groupings(tmp_path, fmt):
+    body = """
+  typedef count { type uint16; }
+  container top {
+    presence "enabled";
+    leaf total { type count; default 3; }
+    list rows {
+      key "a b";
+      unique "c";
+      min-elements 1;
+      leaf a { type string; }
+      leaf b { type string; }
+      leaf c { type string; status deprecated; }
+    }
+  }
+"""
+    assert_resolved(tmp_path, fmt, {'main.yang': main_module(body)})
+
+
+@FORMATS
+def test_output_without_option_is_unchanged(tmp_path, fmt):
+    body = """
+  grouping pair { leaf left { type string; } }
+  container top { uses pair; }
+"""
+    assert_resolved(tmp_path, fmt, {'main.yang': main_module(body)})
+    source = tmp_path / 'source'
+    proc = run_pyang(source, '-f', fmt, 'main.yang')
+    assert proc.returncode == 0, proc.stderr
+    (tmp_path / ('plain.' + fmt)).write_text(proc.stdout)
+    _ctx, module = compile_module(tmp_path, 'plain.' + fmt)
+    keywords = [s.keyword for s in statements_of(module)]
+    assert 'uses' in keywords
+    assert 'grouping' in keywords
+
+
+def test_options_are_listed_in_help(tmp_path):
+    proc = run_pyang(tmp_path, '--help')
+    assert '--yang-resolve' in proc.stdout
+    assert '--yin-resolve' in proc.stdout
