@@ -0,0 +1,25 @@
+import os
+import subprocess
+
+import pytest
+
+TEST_DIR = os.path.dirname(os.path.abspath(__file__))
+
+DIRS = sorted(d for d in os.listdir(TEST_DIR)
+              if os.path.isfile(os.path.join(TEST_DIR, d, 'Makefile')))
+
+
+def run_make(cwd, target):
+    proc = subprocess.run(['make', target], cwd=cwd,
+                          capture_output=True, text=True)
+    assert proc.returncode == 0, proc.stdout[-4000:] + proc.stderr[-4000:]
+
+
+@pytest.mark.parametrize('target', ['selftest', 'mtest'])
+def test_toplevel_target(target):
+    run_make(TEST_DIR, target)
+
+
+@pytest.mark.parametrize('directory', DIRS)
+def test_directory(directory):
+    run_make(os.path.join(TEST_DIR, directory), 'test')
diff --git a/test/test_resolve/test_resolved_output_3ff91a.py b/test/test_resolve/test_resolved_output_3ff91a.py
new file mode 100644
index 0000000..9da6410
--- /dev/null
+++ b/test/test_resolve/test_resolved_output_3ff91a.py
@@ -0,0 +1,2066 @@
+import os
+import subprocess
+import sys
+
+import pytest
+
+from pyang import context, plugin, repository, syntax, util, xpath_parser
+
+SCHEMA_ONLY = ('choice', 'case', 'input', 'output')
+
+LIB = """
+module lib {
+  yang-version 1.1;
+  namespace "urn:lib";
+  prefix lib;
+  typedef percent { type uint8 { range "0..100"; } }
+  identity base-kind;
+  identity fast { base base-kind; }
+  identity slow { base base-kind; }
+  feature extra;
+  feature turbo;
+  extension hint { argument text; }
+  container settings {
+    leaf level { type uint8; }
+    leaf-list names { type string; }
+  }
+}
+"""
+
+GRP = """
+module grp {
+  yang-version 1.1;
+  namespace "urn:grp";
+  prefix g;
+  import lib { prefix l; }
+  typedef label { type string { length "1..16"; } }
+  identity color;
+  identity red { base color; }
+  identity dark-red { base red; }
+  list registry {
+    key "name";
+    leaf name { type string; }
+    leaf value { type int32; }
+  }
+  grouping basic {
+    leaf name { type label; }
+    leaf speed { type l:percent; }
+  }
+  grouping styled {
+    leaf paint { type identityref { base color; } default red; }
+    leaf mood { type identityref { base l:base-kind; } default l:slow; }
+    leaf ok {
+      type boolean;
+      must "derived-from-or-self(../paint, 'red') and derived-from(../mood, 'l:base-kind')";
+    }
+  }
+  grouping wired {
+    leaf target { type leafref { path "/g:registry[g:name = current()/../key]/g:value"; } }
+    leaf key { type string; }
+    leaf boosted { type string; if-feature "l:turbo or not l:extra"; }
+    leaf guarded { type string; if-feature "not (l:turbo and l:extra)"; }
+    leaf noted { type string; l:hint "kept" { l:hint "inner"; } }
+  }
+  grouping scoped {
+    typedef small { type int16 { range "-10..10"; } }
+    leaf s { type small; }
+    container box {
+      typedef tiny { type uint8 { range "1..3"; } }
+      leaf t { type tiny; }
+    }
+  }
+  grouping outer {
+    uses basic;
+    container more {
+      uses styled;
+    }
+  }
+  grouping painted {
+    uses styled {
+      refine paint { default dark-red; }
+    }
+  }
+}
+"""
+
+
+class _Opts(object):
+    def __getattr__(self, _name):
+        return None
+
+
+_plugins_ready = []
+
+
+def compile_module(path, filename, features=None, deviations=()):
+    if not _plugins_ready:
+        plugin.init([])
+        _plugins_ready.append(True)
+    repo = repository.FileRepository(str(path), use_env=False)
+    ctx = context.Context(repo)
+    ctx.opts = _Opts()
+    ctx.opts.features = []
+    ctx.opts.deviations = []
+    ctx.trim_yin = False
+    for modulename, names in (features or {}).items():
+        ctx.features[modulename] = names
+    fmt = 'yin' if filename.endswith('.yin') else 'yang'
+    with open(os.path.join(str(path), filename)) as fd:
+        module = ctx.add_module(filename, fd.read(), in_format=fmt)
+    for filename_ in deviations:
+        with open(os.path.join(str(path), filename_)) as fd:
+            ctx.deviation_modules.append(ctx.add_module(filename_, fd.read()))
+    ctx.validate()
+    module.prune()
+    return ctx, module
+
+
+def run_pyang(path, *args):
+    return subprocess.run(
+        [sys.executable, '-m', 'pyang.scripts.pyang_tool',
+         '-p', str(path)] + list(args),
+        capture_output=True, text=True, cwd=str(path))
+
+
+def module_name(stmt, prefix):
+    src = stmt.i_orig_module
+    if prefix is None or prefix == src.i_prefix:
+        return src.i_modulename
+    return src.i_prefixes.get(prefix, ('?' + prefix, None))[0]
+
+
+def qualify(stmt, identifier):
+    prefix, name = util.split_identifier(identifier)
+    return '%s:%s' % (module_name(stmt, prefix), name)
+
+
+def context_node(node):
+    while node.keyword in SCHEMA_ONLY:
+        node = node.parent
+    return node
+
+
+def data_children(node):
+    result = []
+    for child in getattr(node, 'i_children', []):
+        if child.keyword in SCHEMA_ONLY:
+            result.extend(data_children(child))
+        else:
+            result.append(child)
+    return result
+
+
+def node_path(node):
+    parts = []
+    while node.keyword not in ('module', 'submodule'):
+        if node.keyword in ('input', 'output'):
+            parts.append(node.keyword)
+        elif node.keyword not in ('choice', 'case'):
+            parts.append('%s:%s' % (node.i_module.i_modulename, node.arg))
+        node = node.parent
+    return '/' + '/'.join(reversed(parts))
+
+
+def default_value(type_stmt, stmt):
+    spec = getattr(type_stmt, 'i_type_spec', None)
+    if spec is not None and spec.name == 'identityref':
+        return qualify(stmt, stmt.arg)
+    return stmt.arg
+
+
+def restriction_signature(stmt):
+    if stmt.keyword == 'if-feature':
+        return (stmt.keyword, str(feature_signature(
+            stmt, syntax.parse_if_feature_expr(stmt.arg))))
+    substmts = tuple(
+        restriction_signature(s) for s in stmt.substmts
+        if s.keyword not in ('description', 'reference', 'error-message',
+                             'error-app-tag', 'value', 'position'))
+    if stmt.keyword in ('enum', 'bit'):
+        explicit = stmt.search_one('value' if stmt.keyword == 'enum'
+                                   else 'position')
+        effective = getattr(stmt, 'i_value' if stmt.keyword == 'enum'
+                            else 'i_position', None)
+        if effective is None and explicit is not None:
+            effective = explicit.arg
+        return (stmt.keyword, stmt.arg, str(effective), substmts)
+    return (stmt.keyword, stmt.arg, substmts)
+
+
+def bounds(stmt, spec, attr):
+    values = []
+    for lo, hi in getattr(spec, attr):
+        if hi is None:
+            hi = lo
+        values.append(tuple(
+            str(getattr(spec.base, v, v) if v in ('min', 'max') else v)
+            for v in (lo, hi)))
+    return (stmt.keyword, tuple(values), tuple(
+        restriction_signature(s) for s in stmt.substmts
+        if util.is_prefixed(s.raw_keyword)))
+
+
+def type_signature(type_stmt):
+    restrictions = {}
+    patterns = []
+    while True:
+        frame = {}
+        for s in type_stmt.substmts:
+            if s.keyword == 'type':
+                frame.setdefault('member', []).append(type_signature(s))
+            elif s.keyword == 'base':
+                frame.setdefault('base', []).append(qualify(s, s.arg))
+            elif s.keyword == 'pattern':
+                patterns.append(restriction_signature(s))
+            elif (s.keyword in ('range', 'length') and hasattr(
+                    getattr(type_stmt, 'i_type_spec', None),
+                    s.keyword + 's')):
+                frame.setdefault(s.keyword, []).append(bounds(
+                    s, type_stmt.i_type_spec, s.keyword + 's'))
+            elif s.keyword not in ('path', 'description', 'reference'):
+                frame.setdefault(s.keyword, []).append(restriction_signature(s))
+        for keyword, values in frame.items():
+            restrictions.setdefault(keyword, tuple(values))
+        typedef = getattr(type_stmt, 'i_typedef', None)
+        if typedef is None:
+            return (type_stmt.arg, tuple(sorted(restrictions.items())),
+                    tuple(sorted(patterns, key=repr)))
+        type_stmt = typedef.search_one('type')
+
+
+def typedef_chain(type_stmt):
+    while True:
+        typedef = getattr(type_stmt, 'i_typedef', None)
+        if typedef is None:
+            return
+        yield typedef
+        type_stmt = typedef.search_one('type')
+
+
+def commutative(op, operands):
+    flat = []
+    for e in operands:
+        if isinstance(e, tuple) and e[:len(op)] == op:
+            flat.extend(e[len(op):])
+        else:
+            flat.append(e)
+    return op + tuple(sorted(flat, key=repr))
+
+
+def feature_signature(stmt, expr):
+    if isinstance(expr, str):
+        return qualify(stmt, expr)
+    op, first, second = expr
+    if op == 'not':
+        return (op, feature_signature(stmt, first))
+    return commutative((op,), (feature_signature(stmt, first),
+                               feature_signature(stmt, second)))
+
+
+def current_filter(q):
+    preds = []
+    while q[0] == 'path':
+        preds.insert(0, q[3])
+        q = q[2]
+    if q[0] == 'path_expr':
+        q = q[1]
+    if isinstance(q, list):
+        head = current_filter(q[0])
+        if head is None:
+            return None
+        steps = head + q[1:]
+    elif q[0] == 'function_call' and q[1] == 'current':
+        steps = []
+    else:
+        return None
+    return steps + [('step', 'self', ('node_type', 'node'), preds)]
+
+
+def expression_meaning(stmt, start):
+    def child(node, prefix, name):
+        if node is None:
+            return None
+        if prefix is None and start.keyword == 'module':
+            modulename = start.i_modulename
+        elif prefix is None:
+            modulename = start.i_module.i_modulename
+        else:
+            modulename = module_name(stmt, prefix)
+        if node == 'root':
+            top = stmt.i_orig_module.i_ctx.get_module(modulename)
+            candidates = data_children(top) if top is not None else []
+        else:
+            candidates = data_children(node)
+        for c in candidates:
+            if c.arg == name and c.i_module.i_modulename == modulename:
+                return c
+        return None
+
+    def steps(node, path):
+        shape = []
+        for step in path:
+            if step[0] != 'step':
+                shape.append(meaning(step, node))
+                node = None
+                continue
+            axis, test, preds = step[1], step[2], step[3]
+            if axis == 'parent' and test == ('node_type', 'node'):
+                if node in (None, 'root') or node.keyword == 'module':
+                    node = None
+                else:
+                    parent = context_node(node.parent)
+                    node = 'root' if parent.keyword == 'module' else parent
+                shape.append(tuple(meaning(p, node) for p in preds) or '..')
+            elif axis == 'self' and test == ('node_type', 'node'):
+                shape.append(tuple(meaning(p, node) for p in preds))
+            elif axis == 'child' and isinstance(test, tuple) and test[0] == 'name':
+                node = child(node, test[1], test[2])
+                shape.append(tuple(meaning(p, node) for p in preds))
+            else:
+                shape.append((axis, str(test),
+                              tuple(meaning(p, None) for p in preds)))
+                node = None
+        return node, shape
+
+    def located(node, shape):
+        if node == 'root':
+            return ('node', '/')
+        if node is not None:
+            return ('node', node_path(node), tuple(s for s in shape if s and s != '..'))
+        return ('unresolved', tuple(shape))
+
+    def meaning(q, node):
+        if isinstance(q, list):
+            head = current_filter(q[0])
+            if head is not None:
+                return located(*steps(start, head + q[1:]))
+            return ('filter', meaning(q[0], node), tuple(steps(None, q[1:])[1]))
+        kind = q[0]
+        if kind == 'bool':
+            return commutative((kind, q[1]), (meaning(q[2], node),
+                                              meaning(q[3], node)))
+        if kind in ('comp', 'arith'):
+            return (kind, q[1], meaning(q[2], node), meaning(q[3], node))
+        if kind == 'negative':
+            return (kind, meaning(q[1], node))
+        if kind == 'union':
+            return (kind, tuple(meaning(m, node) for m in q[1]))
+        if kind == 'relative':
+            return located(*steps(node, q[1]))
+        if kind == 'absolute':
+            return located(*steps('root', q[1]))
+        if kind == 'path_expr':
+            if q[1][0] == 'function_call' and q[1][1] == 'current':
+                return ('node', node_path(start), ())
+            return meaning(q[1], node)
+        if kind == 'path':
+            head = current_filter(q)
+            if head is not None:
+                return located(*steps(start, head))
+            return ('filter', meaning(q[2], node), meaning(q[3], None))
+        if kind == 'function_call':
+            args = [meaning(a, node) for a in q[2]]
+            if (q[1] in ('derived-from', 'derived-from-or-self')
+                    and len(q[2]) == 2 and q[2][1][0] == 'path_expr'
+                    and q[2][1][1][0] == 'literal'):
+                args[1] = ('identity',
+                           qualify(stmt, q[2][1][1][1][1:-1].strip()))
+            return ('call', q[1], tuple(args))
+        if kind == 'literal':
+            return ('literal', q[1][1:-1])
+        if kind == 'number':
+            return ('number', float(q[1]))
+        return q
+
+    return meaning(xpath_parser.parse(stmt.arg), start)
+
+
+def conjuncts(expr):
+    if expr[:2] == ('bool', 'and'):
+        return [c for e in expr[2:] for c in conjuncts(e)]
+    return [expr]
+
+
+def when_meanings(module, node):
+    result = []
+    for s in node.search('when'):
+        if getattr(s, 'i_origin', None) == 'uses':
+            start = context_node(node.parent)
+        else:
+            start = context_node(node)
+        result.extend(conjuncts(expression_meaning(s, start)))
+    augment = merged_augment(module, node)
+    if augment is not None:
+        start = context_node(node.parent)
+        for s in augment.search('when'):
+            result.extend(conjuncts(expression_meaning(s, start)))
+    return sorted(str(m) for m in result)
+
+
+def merged_augment(module, node):
+    augment = getattr(node, 'i_augment', None)
+    if augment is None:
+        return None
+    if (augment.parent.keyword == 'uses'
+            or augment.i_target_node.i_module.i_modulename == module.i_modulename):
+        return augment
+    return None
+
+
+def feature_conjuncts(expr):
+    if not isinstance(expr, str) and expr[0] == 'and':
+        return [c for e in expr[1:] for c in feature_conjuncts(e)]
+    return [expr]
+
+
+def feature_meanings(module, node):
+    stmts = list(node.search('if-feature'))
+    augment = getattr(node, 'i_augment', None)
+    if augment is not None:
+        stmts.extend(augment.search('if-feature'))
+    result = []
+    for s in stmts:
+        signature = feature_signature(s, syntax.parse_if_feature_expr(s.arg))
+        result.extend(str(c) for c in feature_conjuncts(signature))
+    return sorted(set(result))
+
+
+def extension_signature(stmt):
+    return (stmt.keyword, stmt.arg,
+            tuple(extension_signature(s) for s in stmt.substmts))
+
+
+def describe(module, node):
+    entry = {'path': node_path(node), 'keyword': node.keyword,
+             'config': getattr(node, 'i_config', None)}
+    for keyword in ('mandatory', 'presence', 'status', 'units',
+                    'min-elements', 'max-elements'):
+        s = node.search_one(keyword)
+        if s is not None:
+            entry[keyword] = s.arg
+    key = node.search_one('key')
+    if key is not None:
+        entry['key'] = [util.split_identifier(k)[1] for k in key.arg.split()]
+    entry['unique'] = sorted(
+        ' '.join('/'.join(util.split_identifier(p)[1] for p in part.split('/'))
+                 for part in u.arg.split())
+        for u in node.search('unique'))
+    type_stmt = node.search_one('type')
+    defaults = [default_value(type_stmt, s) for s in node.search('default')]
+    if type_stmt is not None:
+        entry['type'] = type_signature(type_stmt)
+        pointer = getattr(node, 'i_leafref_ptr', None)
+        if pointer:
+            entry['leafref'] = node_path(pointer[0])
+        for typedef in typedef_chain(type_stmt):
+            if 'units' not in entry and typedef.search_one('units'):
+                entry['units'] = typedef.search_one('units').arg
+            if not defaults:
+                defaults = [default_value(typedef.search_one('type'), s)
+                            for s in typedef.search('default')]
+    if node.keyword == 'choice':
+        cases = [c.arg for c in node.i_children]
+        defaults = [d for d in defaults if d in cases]
+    entry['default'] = sorted(defaults)
+    entry['if-feature'] = feature_meanings(module, node)
+    entry['when'] = when_meanings(module, node)
+    entry['must'] = sorted(str(expression_meaning(s, context_node(node)))
+                           for s in node.search('must'))
+    entry['extensions'] = sorted(
+        str(extension_signature(s)) for s in node.substmts
+        if util.is_prefixed(s.raw_keyword))
+    return entry
+
+
+def schema(module):
+    entries = []
+
+    def walk(node, inherited):
+        for child in getattr(node, 'i_children', []):
+            if (child.i_module.i_modulename != module.i_modulename
+                    or hasattr(child, 'i_target_node')):
+                continue
+            if child.keyword in ('input', 'output') and not child.i_children:
+                continue
+            entry = describe(module, child)
+            for key in ('if-feature', 'when'):
+                entry[key] = sorted(set(entry[key]) | set(inherited[key]))
+            entries.append(entry)
+            walk(child, entry)
+
+    walk(module, {'if-feature': [], 'when': []})
+    for augment in [a for a in module.substmts
+                    if a.keyword != 'deviation' and hasattr(a, 'i_target_node')]:
+        target = getattr(augment, 'i_target_node', None)
+        if target is not None and target.i_module.i_modulename != module.i_modulename:
+            whens = [str(c) for s in augment.search('when')
+                     for c in conjuncts(expression_meaning(s, context_node(target)))]
+            features = [str(c) for s in augment.search('if-feature')
+                        for c in feature_conjuncts(feature_signature(
+                            s, syntax.parse_if_feature_expr(s.arg)))]
+            entries.append({'augment': node_path(target)})
+            walk(augment, {'if-feature': features, 'when': whens})
+    return entries
+
+
+def statements_of(stmt):
+    result = [stmt]
+    for s in stmt.substmts:
+        result.extend(statements_of(s))
+    return result
+
+
+def resolve(tmp_path, fmt, modules, main='main.yang', options=(),
+            features=None, deviations=()):
+    source = tmp_path / 'source'
+    source.mkdir()
+    for name, text in modules.items():
+        (source / name).write_text(text)
+    _ctx, original = compile_module(source, main, features, deviations)
+    proc = run_pyang(source, '-f', fmt, '--%s-resolve' % fmt,
+                     *(list(options) + [main]))
+    assert proc.returncode == 0, proc.stderr
+    printed = tmp_path / 'printed'
+    printed.mkdir()
+    for name, text in modules.items():
+        if name != main:
+            (printed / name).write_text(text)
+    filename = main.rsplit('.', 1)[0] + '.' + fmt
+    (printed / filename).write_text(proc.stdout)
+    ctx, result = compile_module(printed, filename, features)
+    return original, result, ctx.errors, proc.stdout
+
+
+def assert_resolved(tmp_path, fmt, modules, **kwargs):
+    original, result, errors, text = resolve(tmp_path, fmt, modules, **kwargs)
+    assert [(str(p), tag, args) for (p, tag, args) in errors] == []
+    assert schema(result) == schema(original)
+    keywords = [s.keyword for s in statements_of(result)]
+    assert 'uses' not in keywords
+    assert 'grouping' not in keywords
+    return result, text
+
