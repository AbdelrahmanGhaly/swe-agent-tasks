+def test_extensions_nested_in_schema_properties_are_preserved(tmp_path, fmt):
+    body = """
+  grouping checked {
+    leaf code {
+      type string {
+        pattern '[a-z]+' {
+          l:hint "pattern" { l:hint "pattern-inner"; }
+        }
+      }
+      must "string-length(.) > 0" {
+        l:hint "must" { l:hint "must-inner"; }
+      }
+    }
+    leaf level {
+      type uint8 {
+        range "1..9" { l:hint "range"; }
+      }
+    }
+    leaf mode {
+      type enumeration {
+        enum on { l:hint "enum" { l:hint "enum-inner"; } }
+        enum off;
+      }
+    }
+  }
+  container top { uses checked; }
+"""
+    modules = {'main.yang': main_module(body, 'import lib { prefix l; }'),
+               'lib.yang': LIB}
+    result, _text = assert_resolved(tmp_path, fmt, modules)
+    code = result.search_one('container', 'top').search_one('leaf', 'code')
+    pattern = code.search_one('type').search_one('pattern')
+    must = code.search_one('must')
+    assert extension_signature(pattern.search_one(('lib', 'hint'))) == (
+        ('lib', 'hint'), 'pattern',
+        ((('lib', 'hint'), 'pattern-inner', ()),))
+    assert extension_signature(must.search_one(('lib', 'hint'))) == (
+        ('lib', 'hint'), 'must',
+        ((('lib', 'hint'), 'must-inner', ()),))
+    top = result.search_one('container', 'top')
+    level = top.search_one('leaf', 'level').search_one('type')
+    assert extension_signature(
+        level.search_one('range').search_one(('lib', 'hint'))) == (
+        ('lib', 'hint'), 'range', ())
+    mode = top.search_one('leaf', 'mode').search_one('type')
+    assert extension_signature(
+        mode.search_one('enum', 'on').search_one(('lib', 'hint'))) == (
+        ('lib', 'hint'), 'enum', ((('lib', 'hint'), 'enum-inner', ()),))
