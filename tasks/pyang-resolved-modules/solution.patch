diff --git a/pyang/resolve.py b/pyang/resolve.py
new file mode 100644
index 0000000..716ebf6
--- /dev/null
+++ b/pyang/resolve.py
@@ -0,0 +1,349 @@
+"""Resolved module output"""
+
+from . import statements
+from . import syntax
+from . import util
+from . import xpath
+from . import xpath_lexer
+from . import xpath_parser
+
+_schema_keywords = ('container', 'leaf', 'leaf-list', 'list', 'choice', 'case',
+                    'anydata', 'anyxml', 'rpc', 'action', 'notification',
+                    'input', 'output')
+
+_dropped_keywords = ('uses', 'grouping', 'augment', 'refine', 'include',
+                     'import', 'when', 'typedef', '_comment')
+
+_meta_keywords = ('organization', 'contact', 'description', 'reference',
+                  'revision')
+
+_definition_keywords = ('typedef', 'identity', 'feature', 'extension')
+
+_if_feature_prec = {'or': 1, 'and': 2, 'not': 3}
+
+
+def resolve_module(ctx, module):
+    """Return a copy of `module` where groupings, augments of the module
+    itself, deviations and features are resolved."""
+    return _Resolver(ctx, module).resolve()
+
+
+def _is_schema_keyword(keyword):
+    return keyword in _schema_keywords or keyword in statements.data_keywords
+
+
+def _context_node(node):
+    while node.keyword in ('choice', 'case', 'input', 'output'):
+        node = node.parent
+    return node
+
+
+def _data_depth(node):
+    node = _context_node(node)
+    depth = 0
+    while node.keyword not in ('module', 'submodule'):
+        depth += 1
+        node = _context_node(node.parent)
+    return depth
+
+
+def _if_feature_to_string(expr, ref, outer=0):
+    if isinstance(expr, str):
+        return ref(expr)
+    (op, op1, op2) = expr
+    prec = _if_feature_prec[op]
+    if op == 'not':
+        s = 'not ' + _if_feature_to_string(op1, ref, prec)
+    else:
+        s = '%s %s %s' % (_if_feature_to_string(op2, ref, prec), op,
+                          _if_feature_to_string(op1, ref, prec))
+    if prec < outer:
+        return '(' + s + ')'
+    return s
+
+
+class _Resolver(object):
+
+    def __init__(self, ctx, module):
+        self.ctx = ctx
+        self.module = module
+        self.modulename = module.i_modulename
+        self.res = None
+        self.prefixes = {}
+        self.taken_prefixes = set([module.i_prefix])
+        self.used_prefixes = set()
+        self.new_imports = []
+        self.typedef_names = set(t.arg for t in module.search('typedef'))
+        self.hoisted_names = {}
+        self.hoisted = []
+        for imp in module.search('import'):
+            prefix = imp.search_one('prefix').arg
+            self.prefixes.setdefault(imp.arg, prefix)
+            self.taken_prefixes.add(prefix)
+
+    def resolve(self):
+        m = self.module
+        res = statements.new_statement(None, None, m.pos, m.keyword, m.arg)
+        res.top = res
+        res.i_ctx = m.i_ctx
+        res.i_unused_prefixes = {}
+        self.res = res
+        header = []
+        meta = []
+        body = []
+        for s in m.substmts:
+            if s.keyword in ('yang-version', 'namespace', 'prefix'):
+                header.append(self.copy(s, res))
+            elif s.keyword in _meta_keywords:
+                meta.append(self.copy(s, res))
+            elif (s.keyword in _definition_keywords
+                  or (util.is_prefixed(s.raw_keyword)
+                      and not _is_schema_keyword(s.keyword))):
+                body.append(self.copy(s, res))
+        for ch in m.i_children:
+            if hasattr(ch, 'i_target_node'):
+                continue
+            node = self.copy_node(ch, res)
+            if node is not None:
+                body.append(node)
+        for s in m.substmts:
+            if hasattr(s, 'i_target_node') and not self.is_own(s):
+                body.append(self.copy_target_stmt(s, res))
+        res.substmts = (header + self.import_stmts(res) + meta +
+                        self.hoisted + body)
+        return res
+
+    def is_own(self, stmt):
+        target = getattr(stmt, 'i_target_node', None)
+        return (target is not None and target.i_module is not None
+                and target.i_module.i_modulename == self.modulename)
+
+    def merged_augment(self, node):
+        augment = getattr(node, 'i_augment', None)
+        if augment is None:
+            return None
+        if augment.parent.keyword == 'uses' or self.is_own(augment):
+            return augment
+        return None
+
+    def source(self, stmt):
+        return getattr(stmt, 'i_orig_module', None) or self.module
+
+    def new_stmt(self, parent, stmt, keyword, arg):
+        new = statements.new_statement(self.res, parent, stmt.pos, keyword, arg)
+        if util.is_prefixed(stmt.raw_keyword):
+            (prefix, identifier) = stmt.raw_keyword
+            new.raw_keyword = (self.remap(self.source(stmt), prefix, True),
+                               identifier)
+            new.keyword = stmt.keyword
+            new.i_extension = getattr(stmt, 'i_extension', None)
+        return new
+
+    def copy(self, stmt, parent, up=0, owner=None):
+        new = self.new_stmt(parent, stmt, stmt.keyword,
+                            self.arg(stmt, up, owner))
+        for s in stmt.substmts:
+            if _is_schema_keyword(s.keyword) or s.keyword in _dropped_keywords:
+                continue
+            new.substmts.append(self.copy(s, new, owner=stmt))
+        return new
+
+    def copy_node(self, node, parent):
+        if getattr(node, 'i_not_implemented', False):
+            return None
+        if (node.i_module is None
+            or node.i_module.i_modulename != self.modulename):
+            return None
+        children = getattr(node, 'i_children', [])
+        if node.keyword in ('input', 'output') and len(children) == 0:
+            return None
+        new = self.copy(node, parent)
+        when = self.when_stmt(node, new)
+        if when is not None:
+            new.substmts.insert(0, when)
+        augment = self.merged_augment(node)
+        if augment is not None:
+            new.substmts.extend([self.copy(s, new)
+                                 for s in augment.search('if-feature')])
+        for ch in children:
+            c = self.copy_node(ch, new)
+            if c is not None:
+                new.substmts.append(c)
+        if node.keyword == 'choice':
+            self.drop_lost_default(new)
+        return new
+
+    def drop_lost_default(self, new):
+        default = new.search_one('default')
+        if default is None:
+            return
+        cases = [s.arg for s in new.substmts if _is_schema_keyword(s.keyword)]
+        if default.arg not in cases:
+            new.substmts.remove(default)
+
+    def copy_target_stmt(self, stmt, parent):
+        new = self.copy(stmt, parent)
+        for s in stmt.search('when'):
+            new.substmts.insert(0, self.copy(s, new))
+        for ch in getattr(stmt, 'i_children', []):
+            c = self.copy_node(ch, new)
+            if c is not None:
+                new.substmts.append(c)
+        return new
+
+    def when_stmt(self, node, parent):
+        up = _data_depth(node) - _data_depth(node.parent)
+        whens = []
+        for s in node.search('when'):
+            if getattr(s, 'i_origin', None) == 'uses':
+                whens.append((s, up))
+            else:
+                whens.append((s, 0))
+        augment = self.merged_augment(node)
+        if augment is not None:
+            whens.extend([(s, up) for s in augment.search('when')])
+        if len(whens) == 0:
+            return None
+        exprs = [self.xpath_ast(s, up_) for (s, up_) in whens]
+        if None in exprs:
+            return self.copy(whens[0][0], parent, whens[0][1])
+        q = exprs[0]
+        for e in exprs[1:]:
+            q = ('bool', 'and', q, e)
+        new = self.new_stmt(parent, whens[0][0], 'when',
+                            xpath.xpath_to_string(q))
+        for s in whens[0][0].substmts:
+            new.substmts.append(self.copy(s, new))
+        for (s, _up) in whens[1:]:
+            new.substmts.extend([self.copy(e, new) for e in s.substmts
+                                 if util.is_prefixed(e.raw_keyword)])
+        return new
+
+    def arg(self, stmt, up=0, owner=None):
+        keyword = stmt.keyword
+        if stmt.arg is None or keyword in ('input', 'output'):
+            return None
+        src = self.source(stmt)
+        if keyword == 'type':
+            return self.type_arg(stmt)
+        if keyword == 'base':
+            return self.identifier_ref(stmt.arg, src)
+        if keyword == 'if-feature':
+            expr = syntax.parse_if_feature_expr(stmt.arg)
+            if expr is None:
+                return stmt.arg
+            return _if_feature_to_string(
+                expr, lambda i: self.identifier_ref(i, src))
+        if keyword in ('must', 'when', 'path'):
+            q = self.xpath_ast(stmt, up)
+            if q is None:
+                return stmt.arg
+            return xpath.xpath_to_string(q)
+        if keyword == 'default':
+            spec = getattr((owner or stmt.parent).search_one('type'),
+                           'i_type_spec', None)
+            if spec is not None and spec.name == 'identityref':
+                return self.identifier_ref(stmt.arg, src)
+        if hasattr(stmt, 'i_target_node'):
+            return self.schema_node_ids(stmt.arg, src)
+        return stmt.arg
+
+    def xpath_ast(self, stmt, up):
+        src = self.source(stmt)
+        try:
+            q = xpath_parser.parse(stmt.arg)
+        except (xpath_lexer.XPathError, SyntaxError):
+            return None
+        return xpath.rewrite_xpath(
+            q, lambda prefix, is_identity:
+            self.remap(src, prefix, is_identity), up)
+
+    def type_arg(self, stmt):
+        typedef = getattr(stmt, 'i_typedef', None)
+        if typedef is None:
+            return stmt.arg
+        owner = typedef.parent
+        if owner.keyword in ('module', 'submodule'):
+            if owner.i_modulename == self.modulename:
+                return typedef.arg
+            (prefix, _name) = util.split_identifier(stmt.arg)
+            return '%s:%s' % (self.prefix_for(owner.i_modulename, prefix),
+                              typedef.arg)
+        return self.hoist(typedef)
+
+    def hoist(self, typedef):
+        name = self.hoisted_names.get(typedef)
+        if name is None:
+            name = typedef.arg
+            i = 0
+            while name in self.typedef_names:
+                i += 1
+                name = '%s-%d' % (typedef.arg, i)
+            self.typedef_names.add(name)
+            self.hoisted_names[typedef] = name
+            new = self.copy(typedef, self.res)
+            new.arg = name
+            self.hoisted.append(new)
+        return name
+
+    def identifier_ref(self, arg, src):
+        (prefix, name) = util.split_identifier(arg)
+        prefix = self.remap(src, prefix, True)
+        if prefix is None:
+            return name
+        return '%s:%s' % (prefix, name)
+
+    def schema_node_ids(self, arg, src):
+        def remap_part(part):
+            (prefix, name) = util.split_identifier(part)
+            if prefix is None:
+                return part
+            return '%s:%s' % (self.remap(src, prefix, False), name)
+        return ' '.join(['/'.join([remap_part(p) for p in ids.split('/')])
+                         for ids in arg.split()])
+
+    def remap(self, src, prefix, is_identity):
+        if prefix is None and not is_identity:
+            return None
+        if prefix is None or prefix == src.i_prefix:
+            modulename = src.i_modulename
+        elif prefix in src.i_prefixes:
+            modulename = src.i_prefixes[prefix][0]
+        else:
+            return prefix
+        return self.prefix_for(modulename, prefix)
+
+    def prefix_for(self, modulename, src_prefix):
+        if modulename == self.modulename:
+            return self.module.i_prefix
+        prefix = self.prefixes.get(modulename)
+        if prefix is None:
+            base = src_prefix
+            if base is None:
+                imported = self.ctx.get_module(modulename)
+                base = imported.i_prefix if imported is not None else modulename
+            prefix = base
+            i = 0
+            while prefix in self.taken_prefixes:
+                i += 1
+                prefix = '%s%d' % (base, i)
+            self.prefixes[modulename] = prefix
+            self.taken_prefixes.add(prefix)
+            self.new_imports.append((modulename, prefix))
+        self.used_prefixes.add(prefix)
+        return prefix
+
+    def import_stmts(self, parent):
+        stmts = []
+        for imp in self.module.search('import'):
+            prefix = imp.search_one('prefix').arg
+            if (prefix in self.used_prefixes
+                and self.prefixes.get(imp.arg) == prefix):
+                stmts.append(self.copy(imp, parent))
+        for (modulename, prefix) in self.new_imports:
+            imp = statements.new_statement(self.res, parent, self.module.pos,
+                                           'import', modulename)
+            imp.substmts.append(statements.new_statement(
+                self.res, imp, self.module.pos, 'prefix', prefix))
+            stmts.append(imp)
+        return stmts
