diff --git a/pyang/xpath.py b/pyang/xpath.py
index af5ce33..f9d9142 100644
--- a/pyang/xpath.py
+++ b/pyang/xpath.py
@@ -2,7 +2,8 @@ from . import xpath_lexer
 from . import xpath_parser
 from . import types
 from .error import err_add
-from .util import prefix_to_module, search_data_node, data_node_up
+from .util import prefix_to_module, search_data_node, data_node_up, \
+    split_identifier
 from .syntax import re_identifier
 
 core_functions = {
@@ -349,3 +350,170 @@ def chk_xpath_path(ctx, mod, pos, initial, node, path):
         for p in preds:
             chk_xpath_expr(ctx, mod, pos, initial, node1, p, None)
         return chk_xpath_path(ctx, mod, pos, initial, node1, path[1:])
+
+_binary_prec = {
+    'or': 1,
+    'and': 2,
+    '=': 3, '!=': 3,
+    '<': 4, '<=': 4, '>': 4, '>=': 4,
+    '+': 5, '-': 5,
+    '*': 6, 'div': 6, 'mod': 6,
+}
+
+def _prec(q):
+    if isinstance(q, list):
+        return 9
+    if q[0] in ('bool', 'comp', 'arith'):
+        return _binary_prec[q[1]]
+    if q[0] == 'negative':
+        return 7
+    if q[0] == 'union':
+        return 8
+    return 9
+
+def _wrap(q, parens):
+    s = xpath_to_string(q)
+    if parens:
+        return '(' + s + ')'
+    return s
+
+def xpath_to_string(q):
+    """Return the XPath string for the parsed expression `q`."""
+    if isinstance(q, list):
+        return '/'.join([_primary_to_string(q[0])] +
+                        [_step_to_string(s) for s in q[1:]])
+    kind = q[0]
+    if kind in ('bool', 'comp', 'arith'):
+        p = _binary_prec[q[1]]
+        return '%s %s %s' % (_wrap(q[2], _prec(q[2]) < p), q[1],
+                             _wrap(q[3], _prec(q[3]) <= p))
+    if kind == 'negative':
+        return '-' + _wrap(q[1], _prec(q[1]) <= 7)
+    if kind == 'union':
+        return ' | '.join([_wrap(m, _prec(m) < 9) for m in q[1]])
+    if kind == 'relative':
+        return '/'.join([_step_to_string(s) for s in q[1]])
+    if kind == 'absolute':
+        return '/' + '/'.join([_step_to_string(s) for s in q[1]])
+    if kind == 'path_expr':
+        return _primary_to_string(q[1])
+    return _primary_to_string(q)
+
+def _primary_to_string(q):
+    kind = q[0]
+    if kind in ('literal', 'number'):
+        return q[1]
+    if kind == 'variable':
+        return '$' + q[1]
+    if kind == 'function_call':
+        return '%s(%s)' % (q[1], ', '.join([xpath_to_string(a)
+                                            for a in q[2]]))
+    if kind == 'path':
+        return '%s[%s]' % (_primary_to_string(q[2]), xpath_to_string(q[3]))
+    return '(' + xpath_to_string(q) + ')'
+
+def _step_to_string(step):
+    (_, axis, test, preds) = step
+    if axis == 'self' and test == ('node_type', 'node') and not preds:
+        s = '.'
+    elif axis == 'parent' and test == ('node_type', 'node') and not preds:
+        s = '..'
+    else:
+        s = _node_test_to_string(test)
+        if axis == 'attribute':
+            s = '@' + s
+        elif axis != 'child':
+            s = axis + '::' + s
+    return s + ''.join(['[%s]' % xpath_to_string(p) for p in preds])
+
+def _node_test_to_string(test):
+    if test == 'wildcard':
+        return '*'
+    if not isinstance(test, tuple):
+        return test
+    if test[0] == 'name':
+        if test[1] is None:
+            return test[2]
+        return '%s:%s' % (test[1], test[2])
+    if test[0] == 'has_namespace':
+        return test[1]
+    if test[0] == 'node_type':
+        return test[1] + '()'
+    return 'processing-instruction(%s)' % test[1]
+
+def rewrite_xpath(q, remap, up=0):
+    """Return a copy of the parsed expression `q` with rewritten prefixes.
+
+    `remap(prefix, is_identity)` returns the prefix to use instead of
+    `prefix` (None for no prefix).  If `up` is greater than zero, the
+    expression is moved `up` data node levels below its original context
+    node, and the paths that start at the context node are adjusted."""
+    return _rewrite(q, remap, up, True)
+
+def _parent_steps(up):
+    return [('step', 'parent', ('node_type', 'node'), [])
+            for _i in range(up)]
+
+def _rewrite(q, remap, up, at_context):
+    if isinstance(q, list):
+        head = q[0]
+        rest = [_rewrite_step(s, remap, up) for s in q[1:]]
+        if head[0] == 'function_call' and head[1] == 'current':
+            return [head] + _parent_steps(up) + rest
+        return [_rewrite(head, remap, up, at_context)] + rest
+    kind = q[0]
+    if kind in ('bool', 'comp', 'arith'):
+        return (kind, q[1], _rewrite(q[2], remap, up, at_context),
+                _rewrite(q[3], remap, up, at_context))
+    if kind == 'negative':
+        return (kind, _rewrite(q[1], remap, up, at_context))
+    if kind == 'union':
+        return (kind, [_rewrite(m, remap, up, at_context) for m in q[1]])
+    if kind == 'relative':
+        steps = [_rewrite_step(s, remap, up) for s in q[1]]
+        if at_context:
+            steps = _parent_steps(up) + steps
+        return (kind, steps)
+    if kind == 'absolute':
+        return (kind, [_rewrite_step(s, remap, up) for s in q[1]])
+    if kind == 'path_expr':
+        inner = q[1]
+        if (up > 0 and inner[0] == 'function_call'
+            and inner[1] == 'current'):
+            return [inner] + _parent_steps(up)
+        return (kind, _rewrite(inner, remap, up, at_context))
+    if kind == 'path':
+        return (kind, q[1], _rewrite(q[2], remap, up, at_context),
+                _rewrite(q[3], remap, up, False))
+    if kind == 'function_call':
+        args = [_rewrite(a, remap, up, at_context) for a in q[2]]
+        if (q[1] in ('derived-from', 'derived-from-or-self')
+            and len(args) == 2
+            and q[2][1][0] == 'path_expr' and q[2][1][1][0] == 'literal'):
+            args[1] = ('path_expr', _rewrite_literal(q[2][1][1], remap))
+        return (kind, q[1], args)
+    return q
+
+def _rewrite_step(step, remap, up):
+    (_, axis, test, preds) = step
+    if isinstance(test, tuple) and test[0] == 'name':
+        test = ('name', remap(test[1], False), test[2])
+    elif isinstance(test, tuple) and test[0] == 'has_namespace':
+        prefix = remap(test[1][:-2], False)
+        test = ('has_namespace', '%s:*' % prefix)
+    return ('step', axis, test, [_rewrite(p, remap, up, False) for p in preds])
+
+def _rewrite_literal(lit, remap):
+    text = lit[1]
+    body = text[1:-1]
+    name = body.strip()
+    (prefix, identifier) = split_identifier(name)
+    if (re_identifier.search(identifier) is None
+        or (prefix is not None and re_identifier.search(prefix) is None)):
+        return lit
+    prefix = remap(prefix, True)
+    if prefix is not None:
+        identifier = '%s:%s' % (prefix, identifier)
+    start = body.index(name)
+    return ('literal', text[0] + body[:start] + identifier +
+            body[start + len(name):] + text[0])
