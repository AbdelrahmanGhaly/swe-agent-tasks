+import MessageFormat from '@messageformat/core';
+import { spawnSync } from 'node:child_process';
+import { createRequire } from 'node:module';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { describe, expect, test } from 'vitest';
+import { ParseError, parse, type ParseOptions } from './parser.ts';
+
+const collect = (src: string, options = {}) => {
+  const errors: ParseError[] = [];
+  const tokens = parse(src, { ...options, onError: e => errors.push(e) });
+  return { errors, tokens: tokens as any[] };
+};
+
+const codes = (src: string, options = {}) =>
+  collect(src, options).errors.map(e => e.code);
+
+const firstSelect = (tokens: any[]) => tokens.find(t => 'cases' in t);
+
+describe('unchanged without onError', () => {
+  const bad: [string, string][] = [
+    ['Hello {name', 'missing-end'],
+    ['{m, select, =2{bad} other{y}}', 'invalid-select-key'],
+    ['{n, plural, xyzzy{a} other{b}}', 'invalid-plural-key'],
+    ['{n, select, offset:1 other{a}}', 'unexpected-offset'],
+    ['{n, plural, other{a} offset:1}', 'offset-after-cases']
+  ];
+
+  test.each(bad)('%s throws without onError and reports %s with it', (src, code) => {
+    expect(() => parse(src)).toThrow(ParseError);
+    expect(() => parse(src, { onError: () => {} })).not.toThrow();
+    expect(codes(src)).toContain(code);
+  });
+
+  test('a lexer error throws without onError and recovers with it', () => {
+    expect(() => parse('ok {b, } end')).toThrow();
+    expect(() => parse('ok {b, } end', { onError: () => {} })).not.toThrow();
+    expect(codes('ok {b, } end')).toEqual(['invalid-syntax']);
+  });
+
+  test('the new checks never throw without onError', () => {
+    expect(() => parse('{n, plural, one{a} one{b} other{c}}')).not.toThrow();
+    expect(() => parse('{n, plural, one{a}}')).not.toThrow();
+    expect(codes('{n, plural, one{a} one{b} other{c}}')).toEqual([
+      'duplicate-case'
+    ]);
+  });
+
+  test('valid input is unaffected in either mode', () => {
+    const plain = parse('a {b} c');
+    expect(plain).toMatchObject([
+      { type: 'content', value: 'a ' },
+      { type: 'argument', arg: 'b' },
+      { type: 'content', value: ' c' }
+    ]);
+    const { errors, tokens } = collect('a {b} c');
+    expect(errors).toHaveLength(0);
+    expect(tokens).toMatchObject(plain);
+    expect(codes('a {b, } c')).toEqual(['invalid-syntax']);
+  });
+});
+
