+import { parse } from '@messageformat/parser';
+import { describe, expect, test } from 'vitest';
+import { mf1ToMessageData } from './mf1-to-message-data.ts';
+
+const recovered = (src: string) =>
+  parse(src, { onError: () => {} }) as Parameters<typeof mf1ToMessageData>[0];
+
+describe('data model conversion after recovery', () => {
+  test('a skipped placeholder does not throw', () => {
+    expect(() => mf1ToMessageData(recovered('ok {b, } end'))).not.toThrow();
+  });
+
+  test('the surrounding text survives', () => {
+    const msg = mf1ToMessageData(recovered('ok {b, } end')) as any;
+    expect(msg.pattern.join('')).toBe('ok  end');
+  });
+
+  test('a following argument still becomes an expression', () => {
+    const msg = mf1ToMessageData(recovered('{a} {b, } {c}')) as any;
+    const vars = msg.pattern
+      .filter((p: any) => p && p.type === 'expression')
+      .map((p: any) => p.arg.name);
+    expect(vars).toEqual(['a', 'c']);
+  });
+
+  test('a message with only an error yields an empty pattern', () => {
+    const msg = mf1ToMessageData(recovered('{b, }')) as any;
+    expect(msg.pattern.join('')).toBe('');
+  });
+
+  test('a recovered select still converts', () => {
+    const msg = mf1ToMessageData(
+      recovered('{n, plural, one{a} other{b}} {q, }')
+    ) as any;
+    expect(msg.type).toBe('select');
+  });
+
+  test('an invalid plural key is carried through as a variant key', () => {
+    const msg = mf1ToMessageData(
+      recovered('{n, plural, xyzzy{a} other{b}}')
+    ) as any;
+    const keys = msg.variants.map((v: any) =>
+      v.keys[0].type === '*' ? '*' : v.keys[0].value
+    );
+    expect(keys).toContain('xyzzy');
+  });
+});
+
+describe('several skipped spans through conversion', () => {
+  const two = 'A {b, } B {c, } C';
+
+  test('two skipped spans convert without throwing', () => {
+    expect(() => mf1ToMessageData(recovered(two))).not.toThrow();
+  });
+
+  test('the text around both spans survives', () => {
+    const msg = mf1ToMessageData(recovered(two)) as any;
+    expect(msg.pattern.join('')).toBe('A  B  C');
+  });
+
+  test('only the intact arguments become expressions', () => {
+    const msg = mf1ToMessageData(recovered('{a} {b, } {c, } {d}')) as any;
+    const vars = msg.pattern
+      .filter((p: any) => p && p.type === 'expression')
+      .map((p: any) => p.arg.name);
+    expect(vars).toEqual(['a', 'd']);
+  });
+
+  test('adjacent skipped spans leave only the surrounding text', () => {
+    const msg = mf1ToMessageData(recovered('{a, }{b, }x')) as any;
+    expect(msg.pattern.join('')).toBe('x');
+  });
+
+  test('three skipped spans keep the content between them', () => {
+    const msg = mf1ToMessageData(recovered('{a, }x{b, }y{c, }z')) as any;
+    expect(msg.pattern.join('')).toBe('xyz');
+  });
+
+  test('a message of nothing but skipped spans converts to empty text', () => {
+    const msg = mf1ToMessageData(recovered('{a, }{b, }')) as any;
+    expect(msg.pattern.join('')).toBe('');
+  });
+});
+
+describe('semantic recovery through conversion', () => {
+  const reported = (src: string) => {
+    const codes: string[] = [];
+    const tokens = parse(src, {
+      onError: e => codes.push(e.code)
+    }) as Parameters<typeof mf1ToMessageData>[0];
+    return { codes, tokens };
+  };
+
+  const variantKeys = (tokens: Parameters<typeof mf1ToMessageData>[0]) => {
+    const msg = mf1ToMessageData(tokens) as any;
+    return {
+      type: msg.type,
+      keys: (msg.variants ?? []).map((v: any) =>
+        v.keys.map((k: any) => (k.type === '*' ? '*' : k.value)).join(',')
+      )
+    };
+  };
+
+  test('a duplicated case is reported and still converts', () => {
+    const { codes, tokens } = reported('{n, plural, one{a} one{b} other{c}}');
+    expect(codes).toEqual(['duplicate-case']);
+    expect(() => mf1ToMessageData(tokens)).not.toThrow();
+  });
+
+  test('a duplicated key still reaches the converted variants', () => {
+    const { codes, tokens } = reported('{n, plural, one{a} one{b} other{c}}');
+    expect(codes).toEqual(['duplicate-case']);
+    const { type, keys } = variantKeys(tokens);
+    expect(type).toBe('select');
+    expect(keys).toContain('one');
+    expect(keys).toContain('*');
+  });
+
+  test('a select with no other case converts to just its own variants', () => {
+    const { codes, tokens } = reported('{n, plural, one{a}}');
+    expect(codes).toEqual(['missing-other']);
+    const { type, keys } = variantKeys(tokens);
+    expect(type).toBe('select');
+    expect(keys).toEqual(['one']);
+  });
+
+  test('a rejected select offset leaves only the remaining cases', () => {
+    const { codes, tokens } = reported('{n, select, offset:1 other{x}}');
+    expect(codes).toEqual(['unexpected-offset']);
+    const { type, keys } = variantKeys(tokens);
+    expect(type).toBe('select');
+    expect(keys).toEqual(['*']);
+  });
+
+  test('a rejected late offset keeps the surrounding cases', () => {
+    const { codes, tokens } = reported('{n, plural, one{a} offset:1 other{b}}');
+    expect(codes).toEqual(['offset-after-cases']);
+    expect(variantKeys(tokens).keys).toEqual(['one', '*']);
+  });
+
+  test('a retained invalid key converts to its own variant', () => {
+    const { codes, tokens } = reported('{n, plural, xyzzy{a} other{b}}');
+    expect(codes).toEqual(['invalid-plural-key']);
+    expect(variantKeys(tokens).keys).toEqual(['xyzzy', '*']);
+  });
+});
+
+describe('EOF partial nodes through conversion', () => {
+  const withCodes = (src: string) => {
+    const codes: string[] = [];
+    const tokens = parse(src, {
+      onError: e => codes.push(e.code)
+    }) as Parameters<typeof mf1ToMessageData>[0];
+    return { codes, tokens };
+  };
+
+  const expressions = (msg: any) =>
+    msg.pattern
+      .filter((p: any) => p && p.type === 'expression')
+      .map((p: any) => p.arg.name);
+
+  test('a partial argument converts to its expression', () => {
+    const { codes, tokens } = withCodes('Hello {name');
+    expect(codes).toEqual(['missing-end']);
+    const msg = mf1ToMessageData(tokens) as any;
+    expect(msg.pattern.filter((p: any) => typeof p === 'string').join('')).toBe(
+      'Hello '
+    );
+    expect(expressions(msg)).toEqual(['name']);
+  });
+
+  test('a partial formatter keeps its argument', () => {
+    const { codes, tokens } = withCodes('Hello {n, number');
+    expect(codes).toEqual(['missing-end']);
+    expect(expressions(mf1ToMessageData(tokens) as any)).toEqual(['n']);
+  });
+
+  test('a partial select converts to a select message', () => {
+    const { codes, tokens } = withCodes('{n, plural, one{a} other{b}');
+    expect(codes).toEqual(['missing-end']);
+    const msg = mf1ToMessageData(tokens) as any;
+    expect(msg.type).toBe('select');
+    expect(
+      msg.variants.map((v: any) =>
+        v.keys.map((k: any) => (k.type === '*' ? '*' : k.value)).join(',')
+      )
+    ).toEqual(['one', '*']);
+  });
+
+  test('every partial node converts without throwing', () => {
+    for (const src of [
+      'Hello {name',
+      'Hello {n, number',
+      '{n, plural, one{a} other{b}',
+      '{name, '
+    ]) {
+      const { codes, tokens } = withCodes(src);
+      expect(codes).toContain('missing-end');
+      expect(() => mf1ToMessageData(tokens)).not.toThrow();
+    }
+  });
+});
