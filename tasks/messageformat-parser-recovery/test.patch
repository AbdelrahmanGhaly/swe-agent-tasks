+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="${2:-}"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")"
+
+NEW_PARSER_TEST="mf1/packages/parser/src/recovery.a79142.test.ts"
+NEW_BRIDGE_TEST="mf2/icu-messageformat-1/src/mf1-recovery.a79142.test.ts"
+
+REPORT=()
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  REPORT=(--reporter=junit --outputFile="$OUTPUT_PATH")
+fi
+
+LOG="$(mktemp)"
+
+# Both modes complete in seconds. The bound only exists so that a solution which
+# never terminates is reported as a failure carrying its output, instead of hanging
+# the run until the harness gives up.
+RUN_LIMIT=1200
+
+if [ "$MODE" = "new" ]; then
+  timeout "$RUN_LIMIT" npx vitest run --no-color "${REPORT[@]+"${REPORT[@]}"}" \
+    "$NEW_PARSER_TEST" "$NEW_BRIDGE_TEST" > "$LOG" 2>&1
+  EXIT_CODE=$?
+else
+  WG_EXCLUDE=()
+  if [ ! -d "test/messageformat-wg/test/tests" ]; then
+    WG_EXCLUDE=(--exclude '**/spec.test.ts')
+  fi
+  timeout "$RUN_LIMIT" npx vitest run --no-color \
+    --exclude '**/node_modules/**' \
+    --exclude 'mf1/examples/**' \
+    --exclude '**/recovery.a79142.test.ts' \
+    --exclude '**/mf1-recovery.a79142.test.ts' \
+    "${WG_EXCLUDE[@]+"${WG_EXCLUDE[@]}"}" \
+    "${REPORT[@]+"${REPORT[@]}"}" mf1 mf2 > "$LOG" 2>&1
+  EXIT_CODE=$?
+fi
+
+cat "$LOG"
+
+# Vitest writes no report, or one with no cases, when it fails before collection.
+# Record a failure rather than an empty result, and carry the command output through
+# so the real cause (a transform or resolution error) is visible in the report.
+if [ -n "$OUTPUT_PATH" ] && ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  DETAIL="$(tail -c 4000 "$LOG" | sed -e 's/]]>/]]]]><![CDATA[>/g')"
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+    printf '<testsuites name="vitest" tests="1" failures="1" errors="0" time="0">\n'
+    printf '<testsuite name="parser-recovery" tests="1" failures="1" errors="0">\n'
+    printf '<testcase name="suite did not produce results" classname="parser-recovery">\n'
+    printf '<failure message="No test results"><![CDATA[%s]]></failure>\n' "$DETAIL"
+    printf '</testcase>\n</testsuite>\n</testsuites>\n'
+  } > "$OUTPUT_PATH"
+  EXIT_CODE=1
+fi
+
+rm -f "$LOG"
+exit $EXIT_CODE
