+  test('a select closing on its own line anchors there too', () => {
+    const src = '{n, plural,\n  one{a}\n}';
+    const [error] = collect(src).errors;
+    expect(error.code).toBe('missing-other');
+    expect(error.offset).toBe(src.lastIndexOf('}'));
+    expect(error.length).toBe(1);
+    expect(error.line).toBe(3);
+    expect(error.col).toBe(1);
+  });
+
+  test('spaces before the brace are not part of the span', () => {
+    const src = '{c, select, a{x}   }';
+    const [error] = collect(src).errors;
+    expect(error.code).toBe('missing-other');
+    expect(error.offset).toBe(src.lastIndexOf('}'));
+    expect(error.length).toBe(1);
+  });
+});
+
+describe('an unterminated placeholder with more text before the end', () => {
+  test('a select left open after a later brace reports only missing-end', () => {
+    const src = '{n, plural, one {x} {y';
+    const { errors, tokens } = collect(src);
+    expect(errors.map(e => e.code)).toEqual(['missing-end']);
+    expect(tokens.some(t => t.type === 'error')).toBe(false);
+    expect(tokens.map(t => t.type)).toEqual(['plural']);
+  });
+
+  test('an argument left open mid-name reports only missing-end', () => {
+    const { errors, tokens } = collect('{a b');
+    expect(errors.map(e => e.code)).toEqual(['missing-end']);
+    expect(tokens.some(t => t.type === 'error')).toBe(false);
+    expect(tokens[0]).toMatchObject({ type: 'argument', arg: 'a' });
+  });
+
+  test('a formatter left open keeps the key it parsed', () => {
+    const { errors, tokens } = collect('{n, number {x');
+    expect(errors.map(e => e.code)).toEqual(['missing-end']);
+    expect(tokens.some(t => t.type === 'error')).toBe(false);
+    expect(tokens[0]).toMatchObject({
+      type: 'function',
+      arg: 'n',
+      key: 'number'
+    });
+  });
+
+  test('none of them is turned into a recovered span', () => {
+    for (const src of ['{n, plural, one {x} {y', '{a b', '{n, number {x']) {
+      const { errors, tokens } = collect(src);
+      expect(errors.map(e => e.code)).toEqual(['missing-end']);
+      expect(tokens.some(t => t.type === 'error')).toBe(false);
+    }
+  });
+});
+
+describe('an apostrophe only quotes before a brace or octothorpe', () => {
+  const src = "ok {b, x' } tail ' z} end";
+
+  test('a lone apostrophe does not begin a quoted span', () => {
+    const { errors, tokens } = collect(src);
+    expect(errors.map(e => e.code)).toEqual(['invalid-syntax']);
+    expect(tokens.find(t => t.type === 'error').value).toBe("{b, x' }");
+  });
+
+  test('the text after that placeholder is still parsed', () => {
+    const { tokens } = collect(src);
+    expect(tokens.map(t => t.value)).toEqual([
+      'ok ',
+      "{b, x' }",
+      " tail ' z} end"
+    ]);
+  });
+
+  test('an apostrophe that does precede a brace still quotes it', () => {
+    const { tokens } = collect("ok {b, '}' } end");
+    expect(tokens.find(t => t.type === 'error').value).toBe("{b, '}' }");
+  });
+
+  test('an apostrophe before an octothorpe also opens a quoted span', () => {
+    const { errors, tokens } = collect("ok {b, '# }' } end");
+    expect(errors.map(e => e.code)).toEqual(['invalid-syntax']);
+    expect(tokens.find(t => t.type === 'error').value).toBe("{b, '# }' }");
+    expect(tokens.map(t => t.type)).toEqual(['content', 'error', 'content']);
+    expect(tokens[tokens.length - 1].value).toBe(' end');
+  });
+
+  test('a brace inside an octothorpe-quoted span does not deepen it', () => {
+    const { errors, tokens } = collect("ok {b, '#{' } end");
+    expect(errors.map(e => e.code)).toEqual(['invalid-syntax']);
+    expect(tokens.find(t => t.type === 'error').value).toBe("{b, '#{' }");
+    expect(tokens[tokens.length - 1].value).toBe(' end');
+  });
+
+  test('an apostrophe that opens nothing is ordinary content', () => {
+    for (const src of ["the boys'", "a ' b", "don't", "x'"]) {
+      const { errors, tokens } = collect(src);
+      expect(errors).toHaveLength(0);
+      expect(tokens).toMatchObject([{ type: 'content', value: src }]);
+    }
+    const { errors, tokens } = collect("the boys' {b, } tail");
+    expect(errors.map(e => e.code)).toEqual(['invalid-syntax']);
+    expect(tokens.map(t => t.value)).toEqual([
+      "the boys' ",
+      '{b, }',
+      ' tail'
+    ]);
+  });
+
+  test('a trailing apostrophe survives compilation', () => {
+    const mf = new MessageFormat('en', { onError: () => {} });
+    expect(mf.compile("the boys'")({})).toBe("the boys'");
+    expect(mf.compile("the boys' {b, } tail")({})).toBe("the boys'  tail");
+  });
+});
+
+describe('an octothorpe outside a plural is ordinary text', () => {
+  test('a lone octothorpe parses the same with a callback', () => {
+    expect(parse('#')).toMatchObject([{ type: 'content', value: '#' }]);
+    const { errors, tokens } = collect('#');
+    expect(errors).toHaveLength(0);
+    expect(tokens).toMatchObject([{ type: 'content', value: '#' }]);
+    expect(codes('# {b, } #')).toEqual(['invalid-syntax']);
+  });
+
+  test('an octothorpe in surrounding text survives a recovery', () => {
+    const { errors, tokens } = collect('Item #5 {b, } tail');
+    expect(errors.map(e => e.code)).toEqual(['invalid-syntax']);
+    expect(tokens.map(t => t.value)).toEqual(['Item #5 ', '{b, }', ' tail']);
+  });
+
+  test('octothorpes on both sides of a skipped span are kept', () => {
+    const { errors, tokens } = collect('C# {q, } #3');
+    expect(errors.map(e => e.code)).toEqual(['invalid-syntax']);
+    expect(tokens.map(t => t.value)).toEqual(['C# ', '{q, }', ' #3']);
+  });
+
+  test('a compiled message keeps a top-level octothorpe', () => {
+    const mf = new MessageFormat('en', { onError: () => {} });
+    expect(mf.compile('Item #5 {b, } tail')({})).toBe('Item #5  tail');
+    expect(mf.compile('Item #5')({})).toBe('Item #5');
+    expect(mf.compile('#')({})).toBe('#');
+  });
+
+  test('an octothorpe after a plural is still ordinary text', () => {
+    const { errors, tokens } = collect('{n, plural, other{# x}} #y {b, } z');
+    expect(errors.map(e => e.code)).toEqual(['invalid-syntax']);
+    expect(tokens.map(t => t.type)).toEqual([
+      'plural',
+      'content',
+      'error',
+      'content'
+    ]);
+    expect(tokens[tokens.length - 1].value).toBe(' z');
+  });
+});
+
+describe('a duplicate report points at the repeated case', () => {
+  const dup = (src: string) =>
+    collect(src).errors.filter(e => e.code === 'duplicate-case');
+
+  test('the report lies past the first occurrence of the key', () => {
+    const cases: [string, string][] = [
+      ['{n, plural, one{a} one{b} other{c}}', 'one'],
+      ['{n, plural, =1{a} =1{b} other{c}}', '=1'],
+      ['{c, select, a{x} a{y} other{z}}', 'a{']
+    ];
+    for (const [src, key] of cases) {
+      const [error] = dup(src);
+      const first = src.indexOf(key);
+      const second = src.indexOf(key, first + 1);
+      expect(error.offset).toBeGreaterThan(first);
+      expect(error.offset).toBeLessThanOrEqual(second);
+      expect(error.offset + error.length).toBeGreaterThan(second);
+    }
+  });
+
+  test('a key repeated three times reports each occurrence after the first', () => {
+    const src = '{n, plural, one{a} one{b} one{c} other{d}}';
+    const errors = dup(src);
+    expect(errors).toHaveLength(2);
+    const first = src.indexOf('one');
+    const second = src.indexOf('one', first + 1);
+    const third = src.indexOf('one', second + 1);
+    expect(errors[0].offset).toBeGreaterThan(first);
+    expect(errors[0].offset).toBeLessThanOrEqual(second);
+    expect(errors[1].offset).toBeGreaterThan(second);
+    expect(errors[1].offset).toBeLessThanOrEqual(third);
+  });
+});
+
+describe('a parser-level failure inside a placeholder that never closes', () => {
+  test('a strict argument type reports only missing-end', () => {
+    const { errors, tokens } = collect('{n, nope', { strict: true });
+    expect(errors.map(e => e.code)).toEqual(['missing-end']);
+    expect(tokens.some(t => t.type === 'error')).toBe(false);
+    expect(tokens[0]).toMatchObject({ type: 'function', arg: 'n', key: 'nope' });
+  });
+
+  test('a built-in select name used as a formatter reports only missing-end', () => {
+    const { errors, tokens } = collect('{var,Select');
+    expect(errors.map(e => e.code)).toEqual(['missing-end']);
+    expect(tokens.some(t => t.type === 'error')).toBe(false);
+    expect(tokens[0]).toMatchObject({ type: 'function', arg: 'var' });
+  });
+
+  test('an unsupported escape reports only missing-end', () => {
+    const { errors, tokens } = collect("{n, number, '#{'");
+    expect(errors.map(e => e.code)).toEqual(['missing-end']);
+    expect(tokens.some(t => t.type === 'error')).toBe(false);
+  });
+
+  test('a strict argument style reports only missing-end', () => {
+    const { errors, tokens } = collect('{n, number, {m, select, other{x}}', {
+      strict: true
+    });
+    expect(errors.map(e => e.code)).toEqual(['missing-end']);
+    expect(tokens.some(t => t.type === 'error')).toBe(false);
+  });
+
+  test('closing the same placeholders brings syntax recovery back', () => {
+    const closed: [string, object, string][] = [
+      ['{n, nope, x}', { strict: true }, '{n, nope, x}'],
+      ['{var,Select}', {}, '{var,Select}'],
+      ["{n, number, '#{'}", {}, "{n, number, '#{'}"],
+      [
+        '{n, number, {m, select, other{x}}}',
+        { strict: true },
+        '{n, number, {m, select, other{x}}}'
+      ]
+    ];
+    for (const [src, options, value] of closed) {
+      const { errors, tokens } = collect(src, options);
+      expect(errors.map(e => e.code)).toEqual(['invalid-syntax']);
+      expect(tokens.find(t => t.type === 'error')).toMatchObject({ value });
+    }
+  });
+});
