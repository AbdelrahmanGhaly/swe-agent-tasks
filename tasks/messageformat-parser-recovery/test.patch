+import type { MessageFormatOptions } from '../../core/src/messageformat.js';
+import type { ParseError, ParseOptions, Token } from './parser.js';
+
+type ErrorMember = Extract<Token, { type: 'error' }>;
+
+const unionHasErrorMember: [ErrorMember] extends [never] ? never : true = true;
+export const errorMemberIsInTokenUnion = unionHasErrorMember;
+
+export function readErrorToken(token: Token): string {
+  if (token.type === 'error') {
+    const value: string = token.value;
+    const text: string = token.ctx.text;
+    const offset: number = token.ctx.offset;
+    const line: number = token.ctx.line;
+    const col: number = token.ctx.col;
+    return `${value}${text}${offset}${line}${col}`;
+  }
+  return '';
+}
+
+export function readParseError(error: ParseError): number {
+  const code: string = error.code;
+  const spans: number[] = [
+    error.offset,
+    error.line,
+    error.col,
+    error.length
+  ];
+  return code.length + spans.length;
+}
+
+export const options: ParseOptions = {
+  onError(error) {
+    readParseError(error);
+  }
+};
+
+type Code = ParseError['code'];
+
+const everyCode: Code[] = [
+  'missing-end',
+  'invalid-select-key',
+  'invalid-plural-key',
+  'unexpected-offset',
+  'offset-after-cases',
+  'invalid-syntax',
+  'duplicate-case',
+  'missing-other'
+];
+
+export const documentedCodeCount = everyCode.length;
+
+export const compilerOptions: MessageFormatOptions<'string'> = {
+  onError(error) {
+    readParseError(error);
+  }
+};
