+          state = 'arg';
+          i = next;
+          continue;
+        }
+      }
+    } else if (state === 'arg') {
+      next = matchAt(SELECT_HEAD, src, i);
+      if (next >= 0) {
+        state = 'select';
+        i = next;
+        continue;
+      }
+      next = matchAt(FUNC_ARGS, src, i);
+      if (next >= 0) {
+        state = 'body';
+        i = next;
+        continue;
+      }
+    } else {
+      next = matchAt(OFFSET, src, i);
+      if (next >= 0) {
+        i = next;
+        continue;
+      }
+      next = matchAt(CASE, src, i);
+      if (next >= 0) {
+        stack.push(state);
+        state = 'body';
+        i = next;
+        continue;
+      }
+    }
+    i++;
+  }
+  return -1;
+}
