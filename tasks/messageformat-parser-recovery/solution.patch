+import { states } from './lexer.js';
+
+/**
+ * Thrown internally to unwind the parse stack back to the message root after a
+ * syntax error has been reported and the lexer restarted.
+ *
+ * @internal
+ */
+export class RecoverySignal {
+  start: number;
+  end: number;
+
+  constructor(start: number, end: number) {
+    this.start = start;
+    this.end = end;
+  }
+}
+
+/**
+ * Offsets of the first character of each line in `src`.
+ *
+ * @internal
+ */
+export function lineStarts(src: string): number[] {
+  const starts = [0];
+  for (let i = 0; i < src.length; i++) {
+    if (src[i] === '\n') starts.push(i + 1);
+  }
+  return starts;
+}
+
+/**
+ * The 1-based line and column of `offset`, resolved against the original source
+ * so that positions stay absolute after the lexer has been restarted.
+ *
+ * @internal
+ */
+export function positionAt(
+  starts: number[],
+  offset: number
+): { line: number; col: number } {
+  let lo = 0;
+  let hi = starts.length - 1;
+  while (lo < hi) {
+    const mid = (lo + hi + 1) >> 1;
+    if (starts[mid] <= offset) lo = mid;
+    else hi = mid - 1;
+  }
+  return { line: lo + 1, col: offset - starts[lo] + 1 };
+}
+
+/**
+ * The offset just past the apostrophe-quoted span whose body starts at `from`,
+ * or -1 if it is never closed.
+ *
+ * This mirrors the lexer's `quoted` rule: a doubled apostrophe stands for a
+ * literal one and leaves the span open, and the span ends at the first
+ * apostrophe that is not itself doubled. A span with no closing apostrophe does
+ * not match that rule at all, which is what -1 reports.
+ *
+ * @internal
+ */
+function quotedEnd(src: string, from: number): number {
+  let i = from;
+  while (i < src.length) {
+    if (src[i] === "'") {
+      if (src[i + 1] === "'") {
+        i += 2;
+        continue;
+      }
+      return i + 1;
+    }
+    i++;
+  }
+  return -1;
+}
+
+/**
+ * A `RegExp` copy of one of the lexer's own rules, anchored so it can be tested
+ * at an exact offset.
+ */
+function anchored(state: string, name: string): RegExp {
+  const { match } = states[state][name] as { match: RegExp };
+  return new RegExp(match.source, match.flags.replace('g', '') + 'y');
+}
+
+const ARGUMENT = anchored('body', 'argument');
+const SELECT_HEAD = anchored('arg', 'select');
+const FUNC_ARGS = anchored('arg', 'func-args');
+const CASE = anchored('select', 'case');
+const OFFSET = anchored('select', 'offset');
+
+/** The offset just past `re` matched at `at`, or -1 if it does not match there. */
+function matchAt(re: RegExp, src: string, at: number): number {
+  re.lastIndex = at;
+  const found = re.exec(src);
+  return found ? at + found[0].length : -1;
+}
+
+type ScanState = 'body' | 'arg' | 'select';
+
+/**
+ * The offset just past the placeholder opened at `start`, or -1 if it is never
+ * closed.
+ *
+ * The scan follows the same lexer states the parser does, so a brace only opens
+ * something when the lexer's own `argument` or `case` rule matches there. A
+ * brace the lexer would read as content, such as the one in `{a, number, {, }`,
+ * leaves the depth alone. Braces inside an apostrophe-quoted span are skipped
+ * with the parser's ICU quoting rules.
+ *
+ * @internal
+ */
+export function skipPlaceholder(src: string, start: number): number {
+  const stack: ScanState[] = [];
+  let state: ScanState = 'body';
+  let i = start;
+  while (i < src.length) {
+    const ch = src[i];
+    if (ch === "'") {
+      const next = src[i + 1];
+      if (next === "'") {
+        i += 2;
+        continue;
+      }
+      if (next === '{' || next === '}' || next === '#') {
