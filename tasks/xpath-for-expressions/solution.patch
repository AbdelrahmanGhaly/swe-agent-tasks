+// cmpSequence holds when the comparison holds for some pair of items.
+func cmpSequence(t iterator, op string, m, n interface{}) bool {
+	left := sequenceItems(t, m)
+	right := sequenceItems(t, n)
+	for _, a := range left {
+		for _, b := range right {
+			if cmpItems(op, a, b) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func cmpItems(op string, a, b interface{}) bool {
+	if node, ok := a.(NodeNavigator); ok {
+		a = node.Value()
+	}
+	if node, ok := b.(NodeNavigator); ok {
+		b = node.Value()
+	}
+	_, aNum := a.(float64)
+	_, bNum := b.(float64)
+	if aNum || bNum {
+		return cmpNumberNumberF(op, asNumber(nil, a), asNumber(nil, b))
+	}
+	return cmpStringStringF(op, asString(nil, a), asString(nil, b))
+}
