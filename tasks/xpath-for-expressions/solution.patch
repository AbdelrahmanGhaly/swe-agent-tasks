+// isSequence reports whether a comparison operand is a value or node sequence rather than a
+// single value or an axis step's node-set.
+func isSequence(v interface{}) bool {
+	switch v := v.(type) {
+	case []interface{}:
+		return true
+	case query:
+		return sequenceInput(v)
+	}
+	return false
