+#!/usr/bin/env bash
+set -uo pipefail
+
+cd "$(dirname "$0")"
+
+export GOCACHE="${GOCACHE:-/tmp/go-build-$(id -u)}"
+mkdir -p "$GOCACHE" 2>/dev/null || true
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      if [ $# -lt 1 ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+
+if [ "$MODE_COUNT" -eq 0 ]; then
+  echo "missing mode (base or new)" >&2
+  usage
+fi
+if [ "$MODE_COUNT" -gt 1 ]; then
+  echo "only one of base or new may be specified" >&2
+  usage
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+SELECTOR='^TestRangeVariables'
+PACKAGE=github.com/antchfx/xpath
+
+LOG="$(mktemp)"
+STATUS=0
+
+if [ "$MODE" = base ]; then
+  LIST="$(mktemp)"
+  go test -list . . >"$LIST" 2>&1
+  STATUS=$?
+  BASE_TESTS=$(grep -E '^(Test|Example|Fuzz)[A-Za-z0-9_]*$' "$LIST" | grep -vE "$SELECTOR" | paste -sd '|' -)
+  if [ "$STATUS" -eq 0 ] && [ -n "$BASE_TESTS" ]; then
+    go test -v -count=1 -timeout 20m -run "^(${BASE_TESTS})\$" . >>"$LOG" 2>&1
+    STATUS=$?
+  else
+    cat "$LIST" >>"$LOG"
+  fi
+  rm -f "$LIST"
+else
+  go test -v -count=1 -timeout 20m -run "$SELECTOR" . >>"$LOG" 2>&1
+  STATUS=$?
+fi
+
+COLLECTED=$(grep -cE '^ *--- (PASS|FAIL|SKIP):' "$LOG" || true)
+if [ "$COLLECTED" -eq 0 ]; then
+  echo "no tests were collected in mode $MODE" >>"$LOG"
+  if [ "$STATUS" -eq 0 ]; then
+    STATUS=1
+  fi
+fi
+
+cat "$LOG"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  REPORT_ERR="$(mktemp)"
+  if ! go-junit-report < "$LOG" > "$OUTPUT_PATH" 2>"$REPORT_ERR" || ! grep -q '<testsuites' "$OUTPUT_PATH" 2>/dev/null; then
+    echo "go-junit-report did not produce a report: $(cat "$REPORT_ERR")" | tee -a "$LOG" >&2
+    { : > "$OUTPUT_PATH"; } 2>/dev/null
+    STATUS=1
+  fi
+  rm -f "$REPORT_ERR"
+  MISSING=0
+  if [ "$STATUS" -ne 0 ]; then
+    if [ "$MODE" = new ]; then
+      if ! grep -q "<testcase name=\"TestRangeVariables[^\"]*\" classname=\"$PACKAGE\"" "$OUTPUT_PATH" 2>/dev/null; then
+        MISSING=1
+      fi
+    elif ! grep -q '<testcase ' "$OUTPUT_PATH" 2>/dev/null; then
+      MISSING=1
+    fi
+  fi
+  if [ "$MISSING" -eq 1 ]; then
+    DIAG=$(grep -E '^# |\.go:[0-9]+:[0-9]+: |\[(build|setup) failed\]' "$LOG" | head -n 30)
+    if [ -z "$DIAG" ]; then
+      DIAG=$(tail -n 30 "$LOG")
+    fi
+    DIAG=$(printf '%s\n' "$DIAG" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')
+    if [ "$MODE" = base ]; then
+      NAMES=build
+    else
+      NAMES=$(grep -ho '^func TestRangeVariables[A-Za-z0-9_]*' ./*_test.go | sed 's/^func //')
+    fi
+    COUNT=$(printf '%s\n' "$NAMES" | grep -c .)
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      echo "<testsuites tests=\"$COUNT\" failures=\"$COUNT\" errors=\"0\" time=\"0\">"
+      echo "<testsuite name=\"$PACKAGE\" tests=\"$COUNT\" failures=\"$COUNT\" errors=\"0\">"
+      for t in $NAMES; do
+        echo "<testcase name=\"$t\" classname=\"$PACKAGE\">"
+        echo "<failure message=\"the test package failed to build or run\">$DIAG</failure>"
+        echo '</testcase>'
+      done
+      echo '</testsuite>'
+      echo '</testsuites>'
+    } > "$OUTPUT_PATH"
+  fi
+fi
+
+rm -f "$LOG"
+exit "$STATUS"
