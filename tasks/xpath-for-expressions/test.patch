+package xpath
+
+import (
+	"encoding/xml"
+	"reflect"
+	"strconv"
+	"strings"
+	"testing"
+)
+
+const rangeVariablesLibrary = `<library><shelf id="s1" genre="fiction" owner="Ann"><book id="b1" genre="fiction" year="2001"><title>Alpha</title><author>Ann</author><author>Bob</author><price>12.5</price><qty>2</qty></book><book id="b2" genre="poetry" year="1999"><title>Beta</title><author>Cy</author><price>8</price><qty>5</qty></book><book id="b3" genre="fiction" year="2010"><title>Gamma</title><author>Ann</author><price>20</price><qty>1</qty></book></shelf><shelf id="s2" genre="science" owner="Dee"><book id="b4" genre="science" year="2005"><title>Delta</title><author>Dee</author><author>Eve</author><author>Fay</author><price>30</price><qty>3</qty></book><book id="b5" genre="fiction" year="2003"><title>Epsilon</title><author>Bob</author><price>15</price><qty>4</qty></book></shelf><shelf id="s3" genre="empty" owner="Gus"/><misc><for>7</for><return>8</return><to>9</to><in>1</in><some>2</some><every>3</every><satisfies>4</satisfies></misc></library>`
+
+func rangeVariablesDocument(t testing.TB) *TNode {
+	doc := createNode("", RootNode)
+	current := doc
+	decoder := xml.NewDecoder(strings.NewReader(rangeVariablesLibrary))
+	for {
+		token, err := decoder.Token()
+		if err != nil {
+			break
+		}
+		switch token := token.(type) {
+		case xml.StartElement:
+			current = current.createChildNode(token.Name.Local, ElementNode)
+			for _, attr := range token.Attr {
+				current.addAttribute(attr.Name.Local, attr.Value)
+			}
+		case xml.EndElement:
+			current = current.Parent
+		case xml.CharData:
+			current.createChildNode(string(token), TextNode)
+		}
+	}
+	if current != doc {
+		t.Fatalf("unbalanced fixture document")
+	}
+	return doc
+}
+
+func rangeVariablesPath(nav NodeNavigator) string {
+	n := nav.Copy()
+	var steps []string
+	for {
+		switch n.NodeType() {
+		case RootNode:
+			return "/" + strings.Join(steps, "/")
+		case AttributeNode:
+			steps = append([]string{"@" + n.LocalName()}, steps...)
+		case TextNode:
+			index := 1
+			sibling := n.Copy()
+			for sibling.MoveToPrevious() {
+				if sibling.NodeType() == TextNode {
+					index++
+				}
+			}
+			steps = append([]string{"text()[" + strconv.Itoa(index) + "]"}, steps...)
+		default:
+			index := 1
+			sibling := n.Copy()
+			for sibling.MoveToPrevious() {
+				if sibling.NodeType() == ElementNode && sibling.LocalName() == n.LocalName() {
+					index++
+				}
+			}
+			steps = append([]string{n.LocalName() + "[" + strconv.Itoa(index) + "]"}, steps...)
+		}
+		if !n.MoveToParent() {
+			return "/" + strings.Join(steps, "/")
+		}
+	}
+}
+
+func rangeVariablesItem(v interface{}) string {
+	switch v := v.(type) {
+	case float64:
+		return "num:" + strconv.FormatFloat(v, 'f', -1, 64)
+	case string:
+		return "str:" + v
+	case bool:
+		return "bool:" + strconv.FormatBool(v)
+	}
+	return "unexpected:" + reflect.TypeOf(v).String()
+}
+
+type rangeVariablesCase struct {
+	name  string
+	expr  string
+	shape string
+	want  []string
+	valid *rangeVariablesCase
+}
+
+func rangeVariablesCheck(t *testing.T, doc *TNode, tc rangeVariablesCase) {
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("evaluating %q panicked: %v", tc.expr, r)
+		}
+	}()
+	expr, err := Compile(tc.expr)
+	if err != nil {
+		t.Fatalf("Compile(%q) failed: %v", tc.expr, err)
+	}
+	var (
+		shape string
+		got   []string
+	)
+	switch v := expr.Evaluate(createNavigator(doc)).(type) {
+	case *NodeIterator:
+		shape = "nodes"
+		for v.MoveNext() {
+			got = append(got, "n:"+rangeVariablesPath(v.Current()))
+		}
+	case []interface{}:
+		shape = "values"
+		for _, item := range v {
+			got = append(got, rangeVariablesItem(item))
+		}
+	default:
+		shape = "scalar"
+		got = append(got, rangeVariablesItem(v))
+	}
+	if shape != tc.shape {
+		t.Fatalf("Evaluate(%q) returned a %s result %q, want a %s result %q", tc.expr, shape, got, tc.shape, tc.want)
+	}
+	if strings.Join(got, "\n") != strings.Join(tc.want, "\n") {
+		t.Fatalf("Evaluate(%q) = %q, want %q", tc.expr, got, tc.want)
+	}
+	if shape == "nodes" {
+		var selected []string
+		for it := expr.Select(createNavigator(doc)); it.MoveNext(); {
+			selected = append(selected, "n:"+rangeVariablesPath(it.Current()))
+		}
+		if strings.Join(selected, "\n") != strings.Join(tc.want, "\n") {
+			t.Fatalf("Select(%q) = %q, want %q", tc.expr, selected, tc.want)
+		}
+	}
+}
+
+func rangeVariablesRun(t *testing.T, cases []rangeVariablesCase) {
+	doc := rangeVariablesDocument(t)
+	for _, tc := range cases {
+		tc := tc
+		t.Run(tc.name, func(t *testing.T) {
+			if tc.valid != nil {
+				rangeVariablesCheck(t, doc, *tc.valid)
+			}
+			if tc.shape == "error" {
+				if _, err := Compile(tc.expr); err == nil {
+					t.Fatalf("Compile(%q) succeeded, want an error", tc.expr)
+				}
+				return
+			}
+			rangeVariablesCheck(t, doc, tc)
+		})
+	}
+}
