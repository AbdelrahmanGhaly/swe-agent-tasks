+		{name: "variable_path_inside_value_predicate", expr: "for $s in //shelf[1] return (1 to 6)[. = $s/book/qty]", shape: "values", want: []string{"num:1", "num:2", "num:5"}},
+		{name: "last_after_value_filter", expr: "(1 to 6)[. mod 2 = 0][last()]", shape: "values", want: []string{"num:6"}},
+		{name: "position_arithmetic", expr: "(1 to 6)[position() mod 2 = 0]", shape: "values", want: []string{"num:2", "num:4", "num:6"}},
+		{name: "string_of_dot", expr: "(for $b in //book return $b/title)[string(.) = 'Delta']/../@id", shape: "nodes", want: []string{"n:/library[1]/shelf[2]/book[1]/@id"}},
