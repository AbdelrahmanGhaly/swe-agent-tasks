+		{name: "positions_after_value_filter", expr: "count((1 to 10)[. mod 2 = 0][position() > 2])", shape: "scalar", want: []string{"num:3"}},
+		{name: "string_of_current_value", expr: "(1 to 3)[string(.) = '2']", shape: "values", want: []string{"num:2"}},
+		{name: "last_of_string_values", expr: "(for $b in //book return string($b/@genre))[last()]", shape: "values", want: []string{"str:fiction"}},
