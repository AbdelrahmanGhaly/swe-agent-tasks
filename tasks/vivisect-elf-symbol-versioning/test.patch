+    def link(self, app, *libs):
+        vw, fnames = self.load(app, *libs)
+        imports = {
+            isym.split(".", 1)[1].split("@")[0]: va
+            for va, size, itype, isym in vw.getImports()
+            if vw.getFileByVa(va) == fnames[0]
+        }
+        v_linker.analyze(vw)
+        resolved = vw.getVaSet("ResolvedImports")
+        bound = {sym: (resolved[va][2] if va in resolved else None) for sym, va in imports.items()}
+        return vw, fnames, bound
