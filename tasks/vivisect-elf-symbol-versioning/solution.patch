+def symbolName(elf, symidx, name):
+    '''
+    Workspace name for a dynamic symbol: the default version keeps the plain name,
+    a non-default definition keeps its @version so it cannot collide with the default.
+    '''
+    dmglname = demangle(name)
+    vername, isdefault = elf.getSymbolVersion(symidx)
+    if vername is None or isdefault:
+        return dmglname
+    if elf.getDynSymbol(symidx).st_shndx == vdc_elf.SHN_UNDEF:
+        return dmglname
+    return '%s@%s' % (dmglname, vername)
+
+
