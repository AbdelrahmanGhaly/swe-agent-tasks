+    def _syncVersym(self):
+        start = len(self.versymbols)
+        missing = len(self.dynamic_symbols) - start
+        if missing <= 0 or self._versymva is None:
+            return
+        data = self.readAtRva(self._versymva + start * 2, missing * 2)
+        order = 'big' if self.bigend else 'little'
+        self.versymbols.extend(int.from_bytes(data[i:i + 2], order) for i in range(0, len(data) - 1, 2))
+
+    def _walkVersionChain(self, rva, cls, nextfield):
+        '''
+        Yield (rva, record) for each record of a version chain, following the
+        byte offset in nextfield until it is zero.
+        '''
+        seen = set()
+        while rva not in seen:
+            seen.add(rva)
+            rec = cls(bigend=self.bigend)
+            rec.vsParse(self.readAtRva(rva, len(rec)))
+            yield rva, rec
+            nextoff = getattr(rec, nextfield)
+            if nextoff == 0:
+                break
+            rva += nextoff
+
+    def _parseVerdefs(self, rva):
+        for vdrva, vd in self._walkVersionChain(rva, vs_elf.ElfVerdef, 'vd_next'):
+            names = []
