+    def getSymbolVersion(self, index):
+        self._syncVersym()
+        if index < 0 or index >= len(self.versymbols):
+            return (None, True)
+        raw = self.versymbols[index]
+        ndx = raw & VERSYM_VERSION
+        if ndx == VER_NDX_LOCAL or ndx == VER_NDX_GLOBAL:
+            return (None, True)
+        sym = self.dynamic_symbols[index]
+        if sym.st_shndx == SHN_UNDEF:
+            name = self._verneed_names.get(ndx)
+            if name is not None:
+                return (name, False)
+            return (None, True)
+        name = self._verdef_names.get(ndx)
+        if name is None:
+            return (None, True)
+        if sym.st_shndx >= SHN_LORESERVE and sym.name == name:
+            return (None, True)
+        return (name, not bool(raw & VERSYM_HIDDEN))
