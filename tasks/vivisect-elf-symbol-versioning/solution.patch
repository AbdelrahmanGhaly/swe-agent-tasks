+            for auxrva, vda in self._walkVersionChain(vdrva + vd.vd_aux, vs_elf.ElfVerdaux, 'vda_next'):
+                names.append(self.getDynStrtabString(vda.vda_name))
+                auxrvas.append(auxrva)
+            name = names[0] if names else ''
+            vdef = ElfVersionDef(vd.vd_ndx, name, vd.vd_flags, names[1:], vdrva, auxrvas)
+            self.version_defs.append(vdef)
+            if not vdef.isbase:
+                self._verdef_names[vd.vd_ndx & VERSYM_VERSION] = name
+
+    def _parseVerneeds(self, rva):
+        for vnrva, vn in self._walkVersionChain(rva, vs_elf.ElfVerneed, 'vn_next'):
+            auxs = []
+            for auxrva, vna in self._walkVersionChain(vnrva + vn.vn_aux, vs_elf.ElfVernaux, 'vna_next'):
+                other = vna.vna_other & VERSYM_VERSION
+                aux = ElfVersionNeedAux(other, self.getDynStrtabString(vna.vna_name), vna.vna_flags, auxrva)
+                auxs.append(aux)
+                self._verneed_names[other] = aux.name
+            self.version_needs.append(ElfVersionNeed(self.getDynStrtabString(vn.vn_file), auxs, vnrva))
