+def libraryNames(vw, fname):
+    '''
+    The names a needed-version entry may use for a loaded file: its soname and
+    the file name it was loaded from.
+    '''
+    names = set()
+    soname = vw.getFileMeta(fname, 'ELF_SONAME')
+    if soname:
+        names.add(soname.lower())
+    origname = vw.getFileMeta(fname, 'OrigName')
+    if origname:
+        names.add(os.path.basename(origname).lower())
+    return names
+
+
+def exportBaseName(verdefs, esym):
+    '''
+    The name an export answers imports by: a hidden ELF definition exported as
+    sym@version answers to sym, and every other export to its full name.
+    '''
+    if verdefs and esym in verdefs:
+        suffix = '@' + verdefs[esym][0]
+        if esym.endswith(suffix):
+            return esym[:-len(suffix)]
+    return esym
+
+
+def linkTargets(verdefs, libnames, need, impsym, exports):
+    '''
+    Pick the exports of one file that satisfy an import.  verdefs maps each
+    versioned export name to (version, index, hidden) and is None for a file
+    without symbol versions.  A versioned import only binds within the library
+    it was needed from, by version there, or by name if that library has no
+    versions.  An unversioned import links by name to a file without versions;
+    in a versioned file it takes a definition at version index 1 or 2 (even a
+    hidden one), else the only non-hidden one.
+    '''
+    if need is not None and os.path.basename(need[3]).lower() not in libnames:
+        return []
+
+    if verdefs is None:
+        return [eva for eva, esym in exports if esym == impsym]
+
+    if need is not None:
+        return [eva for eva, esym in exports if esym in verdefs and verdefs[esym][0] == need[2]]
+
+    direct = [eva for eva, esym in exports if esym not in verdefs or verdefs[esym][1] <= 2]
+    if direct:
+        return direct[:1]
+
+    later = [eva for eva, esym in exports if not verdefs[esym][2]]
+    return later if len(later) == 1 else []
+
