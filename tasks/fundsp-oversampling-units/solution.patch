+/// Oversampler for an `AudioUnit`. The enclosed unit runs at
+/// 2, 4, 8 or 16 times the sample rate.
+/// Oversampling by 2^k is done like k nested 2x oversamplers.
+#[derive(Clone)]
+pub struct OversampleUnit {
+    unit: Box<dyn AudioUnit>,
+    linear: bool,
+    inputs: usize,
+    outputs: usize,
+    sample_rate: f64,
+    inv: Vec<[f32; 0x80]>,
+    outv: Vec<[f32; 0x80]>,
+    input_index: usize,
+    output_index: usize,
+    tick_input: Vec<f32>,
+    tick_output: Vec<f32>,
+    inner_input: BufferVec,
+    inner_output: BufferVec,
+}
+
+impl OversampleUnit {
+    /// Oversample `unit` by `factor` (2, 4, 8 or 16) using minimum phase filters.
+    pub fn new(factor: usize, unit: Box<dyn AudioUnit>) -> Self {
+        Self::build(factor, false, unit)
+    }
+
+    /// Oversample `unit` by `factor` (2, 4, 8 or 16) using linear phase filters.
+    pub fn linear(factor: usize, unit: Box<dyn AudioUnit>) -> Self {
+        Self::build(factor, true, unit)
+    }
+
+    fn build(factor: usize, linear: bool, unit: Box<dyn AudioUnit>) -> Self {
+        assert!(
+            (2..=16).contains(&factor) && factor.is_power_of_two(),
+            "OversampleUnit: factor must be 2, 4, 8 or 16"
+        );
+        let mut unit: Box<dyn AudioUnit> = if factor > 2 {
+            Box::new(Self::build(factor / 2, linear, unit))
+        } else {
+            unit
+        };
+        unit.set_sample_rate(DEFAULT_SR * 2.0);
+        let id = if linear {
+            LinearPhase::ID
+        } else {
+            MinimumPhase::ID
+        };
+        let hash = unit.ping(true, AttoHash::new(id));
+        unit.ping(false, hash);
+        let inputs = unit.inputs();
+        let outputs = unit.outputs();
+        Self {
+            unit,
+            linear,
+            inputs,
+            outputs,
+            sample_rate: DEFAULT_SR,
+            inv: vec![[0.0; 0x80]; inputs],
+            outv: vec![[0.0; 0x80]; outputs],
+            input_index: 0,
+            output_index: 0,
+            tick_input: vec![0.0; inputs * 2],
+            tick_output: vec![0.0; outputs],
+            inner_input: BufferVec::new(inputs),
+            inner_output: BufferVec::new(outputs),
+        }
+    }
+
+    #[inline]
+    fn interpolate(&self, channel: usize) -> (f32, f32) {
+        if self.linear {
+            LinearPhase::interpolate(&self.inv[channel], self.input_index)
+        } else {
+            MinimumPhase::interpolate(&self.inv[channel], self.input_index)
+        }
+    }
+
+    #[inline]
+    fn decimate(&self, channel: usize, index: usize) -> f32 {
+        if self.linear {
+            LinearPhase::decimate(&self.outv[channel], index)
+        } else {
+            MinimumPhase::decimate(&self.outv[channel], index)
+        }
+    }
+}
+
+impl AudioUnit for OversampleUnit {
+    fn reset(&mut self) {
+        self.unit.reset();
+        self.inv.fill([0.0; 0x80]);
+        self.outv.fill([0.0; 0x80]);
+        self.input_index = 0;
+        self.output_index = 0;
+    }
+
+    fn set_sample_rate(&mut self, sample_rate: f64) {
+        self.sample_rate = sample_rate;
+        self.unit.set_sample_rate(sample_rate * 2.0);
+    }
+
+    fn tick(&mut self, input: &[f32], output: &mut [f32]) {
+        for channel in 0..self.inputs {
+            self.inv[channel][self.input_index] = input[channel];
+            let (even, odd) = self.interpolate(channel);
+            self.tick_input[channel] = even;
+            self.tick_input[self.inputs + channel] = odd;
+        }
+        self.input_index = (self.input_index + 1) & 0x7f;
+
+        let (even, odd) = self.tick_input.split_at(self.inputs);
+        self.unit.tick(even, &mut self.tick_output);
+        for channel in 0..self.outputs {
+            self.outv[channel][self.output_index] = self.tick_output[channel];
+        }
+        self.output_index = (self.output_index + 1) & 0x7f;
+
+        self.unit.tick(odd, &mut self.tick_output);
+        for channel in 0..self.outputs {
+            self.outv[channel][self.output_index] = self.tick_output[channel];
+            output[channel] = self.decimate(channel, self.output_index);
+        }
+        self.output_index = (self.output_index + 1) & 0x7f;
+    }
+
+    fn process(&mut self, size: usize, input: &BufferRef, output: &mut BufferMut) {
+        let mut offset = 0;
+        while offset < size {
+            let length = min(size - offset, MAX_BUFFER_SIZE / 2);
+
+            for i in 0..length {
+                for channel in 0..self.inputs {
+                    self.inv[channel][self.input_index] = input.at_f32(channel, offset + i);
+                    let (even, odd) = self.interpolate(channel);
+                    self.inner_input.set_f32(channel, i * 2, even);
+                    self.inner_input.set_f32(channel, i * 2 + 1, odd);
+                }
+                self.input_index = (self.input_index + 1) & 0x7f;
+            }
+
+            self.unit.process(
+                length * 2,
+                &self.inner_input.buffer_ref(),
+                &mut self.inner_output.buffer_mut(),
+            );
+
+            for i in 0..length {
+                let next_index = (self.output_index + 1) & 0x7f;
+                for channel in 0..self.outputs {
+                    self.outv[channel][self.output_index] =
+                        self.inner_output.at_f32(channel, i * 2);
+                    self.outv[channel][next_index] = self.inner_output.at_f32(channel, i * 2 + 1);
+                    output.set_f32(channel, offset + i, self.decimate(channel, next_index));
+                }
+                self.output_index = (self.output_index + 2) & 0x7f;
+            }
+
+            offset += length;
+        }
+    }
+
+    fn set(&mut self, setting: Setting) {
+        self.unit.set(setting);
+    }
+
+    fn inputs(&self) -> usize {
+        self.inputs
+    }
+
+    fn outputs(&self) -> usize {
+        self.outputs
+    }
+
+    fn route(&mut self, input: &SignalFrame, frequency: f64) -> SignalFrame {
+        let unit = &mut self.unit;
+        if self.linear {
+            route_oversampled::<LinearPhase>(
+                self.sample_rate,
+                input,
+                frequency,
+                self.outputs,
+                |input| unit.route(input, frequency),
+            )
+        } else {
+            route_oversampled::<MinimumPhase>(
+                self.sample_rate,
+                input,
+                frequency,
+                self.outputs,
+                |input| unit.route(input, frequency),
+            )
+        }
+    }
+
+    fn get_id(&self) -> u64 {
+        if self.linear {
+            LinearPhase::ID
+        } else {
+            MinimumPhase::ID
+        }
+    }
+
+    fn ping(&mut self, probe: bool, hash: AttoHash) -> AttoHash {
+        self.unit.ping(probe, hash.hash(self.get_id()))
+    }
+
+    fn footprint(&self) -> usize {
+        core::mem::size_of::<Self>()
+    }
+
+    fn allocate(&mut self) {
+        self.unit.allocate();
+    }
+}
