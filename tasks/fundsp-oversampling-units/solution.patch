+/// Resampling filter design of an oversampler.
+pub trait OversamplingPhase: Clone + Default + Sync + Send {
+    /// Unique ID of an oversampler using this design.
+    const ID: u64;
+    /// Delay of the resampling filters reported as latency, in samples at the outer rate.
+    const LATENCY: f64;
+    /// Interpolate an even and an odd inner sample from input history ending at `index`.
+    fn interpolate(history: &[f32], index: usize) -> (f32, f32);
+    /// Decimate inner output history ending at `index` into an outer sample.
+    fn decimate(history: &[f32], index: usize) -> f32;
+}
+
+/// Minimum phase resampling filters. They add no latency.
