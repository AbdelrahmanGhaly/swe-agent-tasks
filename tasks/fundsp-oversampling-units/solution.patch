+    }
+}
+
+/// Frequency response of the resampling filters of `P` at `frequency` Hz
+/// when the outer sample rate is `sample_rate`. The delay reported as latency is excluded.
+fn resampling_response<P: OversamplingPhase>(sample_rate: f64, frequency: f64) -> Complex64 {
+    let mut input = [0.0f32; 0x80];
+    let mut output = [0.0f32; 0x80];
+    let omega = f64::TAU * frequency / sample_rate;
+    let mut response = Complex64::new(0.0, 0.0);
+    for i in 0..0x80 {
+        input[i] = if i == 0 { 1.0 } else { 0.0 };
+        let (even, odd) = P::interpolate(&input, i);
+        output[(i * 2) & 0x7f] = even;
+        output[(i * 2 + 1) & 0x7f] = odd;
+        let sample = P::decimate(&output, (i * 2 + 1) & 0x7f) as f64;
+        response += Complex64::from_polar(sample, -omega * (i as f64 - P::LATENCY));
+    }
+    if P::LATENCY > 0.0 {
+        Complex64::new(response.re, 0.0)
+    } else {
+        response
+    }
+}
+
+/// Convert latencies of signals by `factor`.
+fn scale_latency(signal: Signal, factor: f64) -> Signal {
+    match signal {
+        Signal::Latency(l) => Signal::Latency(l * factor),
+        Signal::Response(r, l) => Signal::Response(r, l * factor),
+        s => s,
+    }
+}
+
+/// Route signals through an oversampler with phase `P` and outer `sample_rate`.
+/// The enclosed node is routed with `inner`.
+fn route_oversampled<P: OversamplingPhase>(
+    sample_rate: f64,
+    input: &SignalFrame,
+    frequency: f64,
+    outputs: usize,
+    inner: impl FnOnce(&SignalFrame) -> SignalFrame,
+) -> SignalFrame {
+    let mut inner_input = SignalFrame::new(input.len());
+    for i in 0..input.len() {
+        inner_input.set(i, scale_latency(input.at(i), 2.0));
+    }
+    let inner_output = inner(&inner_input);
+    let mut response = None;
+    let mut output = SignalFrame::new(outputs);
+    for i in 0..outputs {
+        let signal = match inner_output.at(i) {
+            Signal::Latency(l) => Signal::Latency(l * 0.5 + P::LATENCY),
+            Signal::Response(r, l) => {
+                let filters = *response
+                    .get_or_insert_with(|| resampling_response::<P>(sample_rate, frequency));
+                Signal::Response(r * filters, l * 0.5 + P::LATENCY)
+            }
+            s => s,
+        };
+        output.set(i, signal);
+    }
+    output
+}
