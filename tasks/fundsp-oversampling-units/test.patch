+        &mut oversample_linear(lowpass_hz(5000.0, 1.0)),
+        0,
+        44100.0,
+        &FREQUENCIES,
+    );
+    check_analysis(
+        &mut oversample_linear(bell_hz(3000.0, 1.0, 2.0)),
+        0,
+        44100.0,
+        &FREQUENCIES,
+    );
+    check_analysis(
+        &mut oversample_linear(pass() & tick()),
+        0,
+        44100.0,
+        &FREQUENCIES,
+    );
+    check_analysis(
+        &mut oversample_linear(delay(0.0005)),
+        0,
+        44100.0,
+        &FREQUENCIES,
+    );
+    let mut unit = oversample_linear(lowpass_hz(6000.0, 0.7));
+    unit.set_sample_rate(48000.0);
+    check_analysis(&mut unit, 0, 48000.0, &FREQUENCIES);
+}
+
+#[test]
+fn linear_zero_phase_holds_at_other_sample_rates() {
+    let mut unit = oversample_linear(pass());
+    unit.set_sample_rate(48000.0);
+    assert_eq!(unit.latency(), Some(filter_latency()));
+    assert_zero_phase(&mut unit, &FREQUENCIES);
+    check_analysis(&mut unit, 0, 48000.0, &FREQUENCIES);
+    unit.set_sample_rate(32000.0);
+    assert_zero_phase(&mut unit, &[100.0, 2000.0, 7000.0, 11000.0]);
+    check_analysis(&mut unit, 0, 32000.0, &[100.0, 2000.0, 7000.0, 11000.0]);
+}
+
+#[test]
+fn linear_latency_adds_to_enclosed_latency() {
