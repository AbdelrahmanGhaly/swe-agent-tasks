+        &expected,
+        1.0e-5,
+    );
+    let mut sink_unit = OversampleUnit::linear(2, Box::new(sink()));
+    assert_eq!(sink_unit.inputs(), 1);
+    assert_eq!(sink_unit.outputs(), 0);
+    let input = input_signal(1, 300);
+    assert!(run_blocks(&mut sink_unit, &input, 300, &[64, 0, 3, 1]).is_empty());
+    run_ticks(&mut sink_unit, &input, 40);
+    check_blocks(
+        &OversampleUnit::linear(4, Box::new(noise() | sink())),
+        600,
+        &[0, 3, 0, 64],
+    );
+}
