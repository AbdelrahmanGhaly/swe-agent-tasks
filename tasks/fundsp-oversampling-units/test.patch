+        oversample_linear(split::<U2>() >> (lowpass_hz(1000.0, 1.0) | highpass_hz(1000.0, 1.0)));
+    check_blocks(&fan_out, 1300, &[17, 4]);
+    let mixed = oversample_linear((pass() + pass()) | bandpass_hz(2000.0, 2.0));
+    check_blocks(&mixed, 1300, &[13, 32, 1, 63]);
+}
+
+#[test]
+fn linear_pass_reports_its_delay_as_latency() {
+    let latency = filter_latency();
+    assert!(latency > 1.0, "latency {latency}");
+    let mut unit = oversample_linear(pass());
+    assert_zero_phase(&mut unit, &FREQUENCIES);
+    check_analysis(&mut unit, 0, 44100.0, &FREQUENCIES);
+}
+
+#[test]
+fn linear_response_matches_measurement() {
