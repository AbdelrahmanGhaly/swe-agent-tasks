+#[test]
+fn stereo_generator_blocks_match_ticks() {
+    let unit = oversample(noise() | (pink() >> lowpass_hz(2000.0, 1.0)));
+    check_blocks(&unit, 1500, &[64]);
+    check_blocks(&unit, 1500, &[5]);
+    check_blocks(&unit, 300, &[1]);
+}
