+
+#[test]
+fn oversampled_generator_renders_like_ticking() {
+    let mut rendered_node = oversample(sine_hz(1000.0));
+    let mut ticked_node = rendered_node.clone();
+    let wave = Wave::render(44100.0, 0.05, &mut rendered_node);
+    ticked_node.set_sample_rate(44100.0);
+    let expected = run_ticks(&mut ticked_node, &[], wave.length());
+    assert!(wave.amplitude() > 0.9);
+    let actual = vec![wave.channel(0).clone()];
+    assert_close(&actual, &expected, 1.0e-5);
+}
+
+#[test]
+fn oversampled_fm_oscillator_renders_like_ticking() {
+    let f: f32 = 440.0;
+    let m: f32 = 1.0;
+    let mut rendered_node = oversample((sine_hz(f) * f * m + f) >> sine());
+    let mut ticked_node = rendered_node.clone();
+    let wave = Wave::render(44100.0, 0.05, &mut rendered_node);
+    ticked_node.set_sample_rate(44100.0);
+    let expected = run_ticks(&mut ticked_node, &[], wave.length());
+    assert!(wave.amplitude() > 0.9);
+    assert_close(&[wave.channel(0).clone()], &expected, 1.0e-4);
+}
