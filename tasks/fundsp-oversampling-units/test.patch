+    check_blocks(&unit, 2000, &[64, 1, 63, 2, 32, 33, 7, 64]);
+}
+
+#[test]
+fn oversampler_in_net_renders_like_ticking() {
+    let mut net = Net::wrap(Box::new(oversample(noise() >> lowpass_hz(1200.0, 1.0))));
+    net = net >> highpass_hz(100.0, 1.0);
+    let mut ticked = net.clone();
+    let wave = Wave::render(44100.0, 0.04, &mut net);
+    ticked.set_sample_rate(44100.0);
+    let expected = run_ticks(&mut ticked, &[], wave.length());
+    assert!(energy(&expected) > 1.0);
+    assert_close(&[wave.channel(0).clone()], &expected, 1.0e-5);
+}
+
+#[test]
+fn settings_reach_the_oversampled_node() {
+    let mut unit = oversample(lowpass_hz(1000.0, 1.0));
+    unit.set(Setting::center(5000.0));
+    let mut expected_unit = oversample(lowpass_hz(5000.0, 1.0));
+    let input = input_signal(1, 800);
+    let actual = run_ticks(&mut unit.clone(), &input, 800);
+    let expected = run_ticks(&mut expected_unit.clone(), &input, 800);
+    assert_close(&actual, &expected, 1.0e-6);
+    let actual = run_blocks(&mut unit, &input, 800, &[64]);
+    let expected = run_blocks(&mut expected_unit, &input, 800, &[64]);
+    assert_close(&actual, &expected, 1.0e-6);
+}
+
+#[test]
+fn addressed_settings_pass_through_unchanged() {
+    let mut unit = oversample(lowpass_hz(1000.0, 1.0) | highpass_hz(1000.0, 1.0));
+    unit.set(Setting::center(3000.0).right());
+    let mut expected_unit = oversample(lowpass_hz(1000.0, 1.0) | highpass_hz(3000.0, 1.0));
+    let input = input_signal(2, 800);
+    let actual = run_ticks(&mut unit, &input, 800);
+    let expected = run_ticks(&mut expected_unit, &input, 800);
+    assert_close(&actual, &expected, 1.0e-6);
+}
+
+#[test]
+fn tick_output_is_unchanged_and_blocks_agree() {
+    let mut unit = oversample(pass());
+    for (i, expected) in PASS_IMPULSE.iter().enumerate() {
+        let actual = unit.filter_mono(if i == 0 { 1.0 } else { 0.0 });
+        assert!(
+            (actual - expected).abs() <= 1.0e-6,
+            "sample {i}: {actual} != {expected}"
+        );
+    }
+    let mut multi = oversample(lowpass_hz(4000.0, 2.0) | (pass() + pass()));
+    for (i, expected) in MULTI_OUTPUT.iter().enumerate() {
+        let x = (i as f32 * 0.37).sin();
+        let mut output = [0.0f32; 2];
+        AudioUnit::tick(&mut multi, &[x, 0.5 * x, -x], &mut output);
+        assert!((output[0] - expected.0).abs() <= 1.0e-6, "sample {i}");
+        assert!((output[1] - expected.1).abs() <= 1.0e-6, "sample {i}");
+    }
+    check_blocks(&oversample(pass()), 600, &[3]);
+}
+
+#[test]
+fn latency_is_counted_at_the_outer_rate() {
+    assert_eq!(oversample(limiter(0.01, 0.1)).latency(), Some(441.0));
