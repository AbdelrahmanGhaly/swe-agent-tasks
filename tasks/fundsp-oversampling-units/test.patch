+#[test]
+fn single_sample_blocks_match_ticks() {
+    check_blocks(&oversample(pass()), 400, &[1]);
+    check_blocks(&oversample(highpass_hz(500.0, 1.0)), 400, &[1]);
+}
+
+#[test]
+fn two_inputs_one_output_blocks_match_ticks() {
