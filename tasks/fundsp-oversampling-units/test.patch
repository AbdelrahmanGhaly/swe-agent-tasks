index 0000000..ef9d3b7
--- /dev/null
+++ b/tests/oversample_unit_5e8f09.rs
@@ -0,0 +1,487 @@
+use fundsp::prelude64::*;
+use num_complex::Complex64;
+
+fn input_signal(channels: usize, length: usize) -> Vec<Vec<f32>> {
+    let mut state = 0x2545f4914f6cdd1du64;
+    (0..channels)
+        .map(|channel| {
+            (0..length)
+                .map(|i| {
+                    state = state
+                        .wrapping_mul(6364136223846793005)
+                        .wrapping_add(1442695040888963407);
+                    let noise = (state >> 40) as f32 / (1u64 << 24) as f32 * 2.0 - 1.0;
+                    let t = i as f32 / 44100.0;
+                    0.4 * (t * 523.0 * (channel as f32 + 1.0) * core::f32::consts::TAU).sin()
+                        + 0.3 * noise
+                })
+                .collect()
+        })
+        .collect()
+}
+
+fn run_ticks(unit: &mut dyn AudioUnit, input: &[Vec<f32>], length: usize) -> Vec<Vec<f32>> {
+    let mut output = vec![vec![0.0; length]; unit.outputs()];
+    let mut frame_in = vec![0.0; unit.inputs()];
+    let mut frame_out = vec![0.0; unit.outputs()];
+    for i in 0..length {
+        for (channel, x) in frame_in.iter_mut().enumerate() {
+            *x = input[channel][i];
+        }
+        unit.tick(&frame_in, &mut frame_out);
+        for (channel, y) in frame_out.iter().enumerate() {
+            output[channel][i] = *y;
+        }
+    }
+    output
+}
+
+fn run_blocks(
+    unit: &mut dyn AudioUnit,
+    input: &[Vec<f32>],
+    length: usize,
+    sizes: &[usize],
+) -> Vec<Vec<f32>> {
+    let mut output = vec![vec![0.0; length]; unit.outputs()];
+    let mut buffer_in = BufferVec::new(unit.inputs());
+    let mut buffer_out = BufferVec::new(unit.outputs());
+    let mut i = 0;
+    let mut k = 0;
+    while i < length {
+        let n = Ord::min(sizes[k % sizes.len()], length - i);
+        k += 1;
+        for (channel, samples) in input.iter().enumerate() {
+            for j in 0..n {
+                buffer_in.set_f32(channel, j, samples[i + j]);
+            }
+        }
+        unit.process(n, &buffer_in.buffer_ref(), &mut buffer_out.buffer_mut());
+        for (channel, samples) in output.iter_mut().enumerate() {
+            for j in 0..n {
+                samples[i + j] = buffer_out.at_f32(channel, j);
+            }
+        }
+        i += n;
+    }
+    output
+}
+
+fn assert_close(actual: &[Vec<f32>], expected: &[Vec<f32>], tolerance: f32) {
+    assert_eq!(actual.len(), expected.len());
+    for (channel, (a, e)) in actual.iter().zip(expected.iter()).enumerate() {
+        for (i, (x, y)) in a.iter().zip(e.iter()).enumerate() {
+            assert!(
+                (x - y).abs() <= tolerance,
+                "channel {channel} sample {i}: {x} != {y}"
+            );
+        }
+    }
+}
+
+fn check_blocks(unit: &dyn AudioUnit, length: usize, sizes: &[usize]) {
+    let input = input_signal(unit.inputs(), length);
+    let mut ticked = dyn_clone::clone_box(unit);
+    let mut blocked = dyn_clone::clone_box(unit);
+    let expected = run_ticks(&mut *ticked, &input, length);
+    let actual = run_blocks(&mut *blocked, &input, length, sizes);
+    assert_close(&actual, &expected, 1.0e-5);
+}
+
+fn energy(signal: &[Vec<f32>]) -> f32 {
+    signal.iter().flatten().map(|x| x * x).sum()
+}
+
+fn measured_response(
+    unit: &dyn AudioUnit,
+    output: usize,
+    frequency: f64,
+    sample_rate: f64,
+) -> Complex64 {
+    let mut unit = dyn_clone::clone_box(unit);
+    unit.reset();
+    let length = 4096;
+    let mut frame_in = vec![0.0; unit.inputs()];
+    let mut frame_out = vec![0.0; unit.outputs()];
+    let mut response = Complex64::new(0.0, 0.0);
+    for i in 0..length {
+        frame_in.fill(if i == 0 { 1.0 } else { 0.0 });
+        unit.tick(&frame_in, &mut frame_out);
+        let phase = -core::f64::consts::TAU * frequency * i as f64 / sample_rate;
+        response += Complex64::from_polar(frame_out[output] as f64, phase);
+    }
+    response
+}
+
+fn check_analysis(unit: &mut dyn AudioUnit, output: usize, sample_rate: f64, frequencies: &[f64]) {
+    let latency = unit.latency().expect("linear network has a latency");
+    for &frequency in frequencies {
+        let reported = unit
+            .response(output, frequency)
+            .expect("linear network has a response");
+        let delayed = reported
+            * Complex64::from_polar(
+                1.0,
+                -core::f64::consts::TAU * frequency * latency / sample_rate,
+            );
+        let measured = measured_response(unit, output, frequency, sample_rate);
+        assert!(
+            (delayed - measured).norm() <= 1.0e-3,
+            "output {output} at {frequency} Hz: reported {delayed} measured {measured}"
+        );
+    }
+}
+
+const FREQUENCIES: [f64; 6] = [100.0, 1000.0, 4000.0, 9000.0, 13000.0, 16000.0];
+
+fn assert_same_stream(dynamic: &dyn AudioUnit, fixed: &dyn AudioUnit, length: usize) {
+    assert_eq!(dynamic.inputs(), fixed.inputs());
+    assert_eq!(dynamic.outputs(), fixed.outputs());
+    let input = input_signal(fixed.inputs(), length);
+    let mut a = dyn_clone::clone_box(dynamic);
+    let mut b = dyn_clone::clone_box(fixed);
+    let expected = run_ticks(&mut *b, &input, length);
+    assert!(energy(&expected) > 0.1);
+    assert_close(&run_ticks(&mut *a, &input, length), &expected, 1.0e-5);
+    let mut a = dyn_clone::clone_box(dynamic);
+    let mut b = dyn_clone::clone_box(fixed);
+    assert_close(
+        &run_blocks(&mut *a, &input, length, &[64, 5, 33]),
+        &run_blocks(&mut *b, &input, length, &[64, 5, 33]),
+        1.0e-5,
+    );
+}
+
+fn assert_same_analysis(
+    dynamic: &mut dyn AudioUnit,
+    fixed: &mut dyn AudioUnit,
+    frequencies: &[f64],
+) {
+    assert_eq!(dynamic.latency(), fixed.latency());
+    for output in 0..fixed.outputs() {
+        for &frequency in frequencies {
+            let a = dynamic.response(output, frequency).expect("response");
+            let b = fixed.response(output, frequency).expect("response");
+            assert!((a - b).norm() <= 1.0e-9, "{frequency} Hz: {a} != {b}");
+        }
+    }
+}
