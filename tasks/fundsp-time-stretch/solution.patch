+//! Time stretching components.
+
+use super::audionode::*;
+use super::math::*;
+use super::signal::*;
+use super::wave::*;
+use super::*;
+use numeric_array::typenum::*;
+extern crate alloc;
+use alloc::sync::Arc;
+use alloc::vec;
+use alloc::vec::Vec;
+
+fn frame_length(sample_rate: f64) -> usize {
+    let samples = max(16.0, sample_rate * 0.04);
+    1 << (round(log2(samples)) as usize)
+}
+
+/// Wave samples with silence outside the wave. A loop repeats past the end,
+/// and also before the loop point once playback is inside the loop.
+/// `limits` holds the source range that frames should stay within, so that they do not
+/// reach into the silence around the wave or read across the seam of a loop.
+struct Source<'a> {
+    wave: &'a Wave,
+    channel: usize,
+    loop_point: Option<usize>,
+    inside: bool,
+    limits: Option<(f64, f64)>,
+}
+
+impl Source<'_> {
+    fn at(&self, channel: usize, index: i64) -> f32 {
+        let length = self.wave.len() as i64;
+        let index = match self.loop_point {
+            Some(point) if self.inside || index >= point as i64 => {
+                let point = point as i64;
+                point + (index - point).rem_euclid(length - point)
+            }
+            _ => index,
+        };
+        if index < 0 || index >= length {
+            0.0
+        } else {
+            self.wave.at(self.channel + channel, index as usize)
+        }
+    }
+
+    fn read(&self, channel: usize, position: f64) -> f32 {
+        let index = floor(position);
+        let x = (position - index) as f32;
+        let index = index as i64;
+        if x == 0.0 {
+            self.at(channel, index)
+        } else {
+            spline(
+                self.at(channel, index - 1),
+                self.at(channel, index),
+                self.at(channel, index + 1),
+                self.at(channel, index + 2),
+                x,
+            )
+        }
+    }
+}
+
+/// Overlap-add time stretcher with Hann windowed frames that overlap by half.
+/// Each frame starts near its ideal source position, at the offset that best
+/// continues the previous frame over all channels together.
+#[derive(Clone)]
+struct Stretcher {
+    frame: usize,
+    tolerance: usize,
+    span: usize,
+    window: Vec<f32>,
+    output: Vec<Vec<f32>>,
+    target: Vec<Vec<f32>>,
+    search: Vec<Vec<f32>>,
+    energy: Vec<f64>,
+    previous: f64,
+    direction: f64,
+    index: usize,
+    primed: bool,
+}
+
+impl Stretcher {
+    fn new(channels: usize, sample_rate: f64, ratio: f64) -> Self {
+        let frame = frame_length(sample_rate);
+        let tolerance = max(1.0, round(ratio * (frame >> 2) as f64)) as usize;
+        let span = max(1.0, round(ratio * (frame >> 1) as f64)) as usize;
+        let window = (0..frame)
+            .map(|i| 0.5 - 0.5 * cos(i as f64 * f64::TAU / frame as f64) as f32)
+            .collect();
+        Self {
+            frame,
+            tolerance,
+            span,
+            window,
+            output: vec![vec![0.0; frame]; channels],
+            target: vec![vec![0.0; span]; channels],
+            search: vec![vec![0.0; span + 2 * tolerance]; channels],
+            energy: vec![0.0; 2 * tolerance + 1],
+            previous: 0.0,
+            direction: 1.0,
+            index: 0,
+            primed: false,
+        }
+    }
+
+    #[inline]
+    fn hop(&self) -> usize {
+        self.frame >> 1
+    }
+
+    fn reset(&mut self) {
+        for channel in self.output.iter_mut() {
+            channel.fill(0.0);
+        }
+        self.previous = 0.0;
+        self.direction = 1.0;
+        self.index = 0;
+        self.primed = false;
+    }
+
+    /// Add a new frame at the start of each hop, given the source `position` and `speed`.
+    /// Frames are read backwards when the speed is negative; holding keeps the last direction.
+    fn prepare(&mut self, source: &Source, position: f64, speed: f64, ratio: f64, period: f64) {
+        if self.index > 0 {
+            return;
+        }
+        let hop = self.hop() as f64 * ratio;
+        let direction = if speed < 0.0 {
+            -1.0
+        } else if speed > 0.0 {
+            1.0
+        } else {
+            self.direction
+        };
+        // The center of the frame is where the position will be halfway through it.
+        let ideal = position + (speed - direction) * hop;
+        if !self.primed {
+            self.primed = true;
+            self.direction = direction;
+            self.previous = position - direction * hop;
+            self.add(source, self.previous, direction * ratio, self.hop());
+        }
+        let mut natural = self.previous + self.direction * hop;
+        if period > 0.0 {
+            natural -= period * round((natural - ideal) / period);
+        }
+        let start = if direction == self.direction && abs(natural - ideal) < 1.0e-9 {
+            natural
+        } else {
+            self.align(source, natural, ideal, direction, ratio)
+        };
+        self.add(source, start, direction * ratio, 0);
+        self.previous = start;
+        self.direction = direction;
+    }
+
+    #[inline]
+    fn value(&self, channel: usize) -> f32 {
+        self.output[channel][self.index]
+    }
+
+    fn advance(&mut self) {
+        self.index += 1;
+        let hop = self.hop();
+        if self.index == hop {
+            self.index = 0;
+            for channel in self.output.iter_mut() {
+                channel.copy_within(hop.., 0);
+                channel[hop..].fill(0.0);
+            }
+        }
+    }
+
+    fn add(&mut self, source: &Source, start: f64, step: f64, skip: usize) {
+        for (channel, output) in self.output.iter_mut().enumerate() {
+            for i in skip..self.frame {
+                output[i - skip] += self.window[i] * source.read(channel, start + i as f64 * step);
+            }
+        }
+    }
+
+    /// Find the frame start within tolerance of `ideal`, read in `direction`,
+    /// that best continues the previous frame from `natural`.
+    fn align(
+        &mut self,
+        source: &Source,
+        natural: f64,
+        ideal: f64,
+        direction: f64,
+        ratio: f64,
+    ) -> f64 {
+        let mut center = ideal;
+        if let Some((low, high)) = source.limits {
+            let reach = (self.frame - 1) as f64 * ratio;
+            let (first, last) = if direction > 0.0 {
+                (low, high - reach)
+            } else {
+                (low + reach, high)
+            };
+            let tolerance = self.tolerance as f64;
+            if last - first >= 2.0 * tolerance {
+                center = clamp(first + tolerance, last - tolerance, center);
+            }
+        }
+        let center = round(center) as i64;
+        let sign = direction as i64;
+        let first = center - sign * self.tolerance as i64;
+        let offsets = 2 * self.tolerance + 1;
+        let previous = self.direction;
+        self.energy.fill(0.0);
+        for channel in 0..self.output.len() {
+            let target = &mut self.target[channel];
+            for (i, x) in target.iter_mut().enumerate() {
+                *x = source.read(channel, natural + previous * i as f64);
+            }
+            let search = &mut self.search[channel];
+            for (i, x) in search.iter_mut().enumerate() {
+                *x = source.at(channel, first + sign * i as i64);
+            }
+            let mut energy = search[..self.span]
+                .iter()
+                .fold(0.0, |acc, &x| acc + (x * x) as f64);
+            self.energy[0] += energy;
+            for offset in 1..offsets {
+                let leaving = search[offset - 1] as f64;
+                let entering = search[offset - 1 + self.span] as f64;
+                energy += entering * entering - leaving * leaving;
+                self.energy[offset] += energy;
+            }
+        }
+        let mut best = 0;
+        let mut best_score = 0.0;
+        for step in 0..offsets {
+            let delta = if step & 1 == 1 {
+                (step as i64 + 1) >> 1
+            } else {
+                -(step as i64 >> 1)
+            };
+            let offset = (self.tolerance as i64 + sign * delta) as usize;
+            let energy = self.energy[offset];
+            if energy <= 1.0e-24 {
+                continue;
+            }
+            let mut product = 0.0;
+            for channel in 0..self.output.len() {
+                let candidate = &self.search[channel][offset..offset + self.span];
+                product += self.target[channel]
+                    .iter()
+                    .zip(candidate)
+                    .fold(0.0, |acc, (&x, &y)| acc + (x * y) as f64);
+            }
+            let score = product / sqrt(energy);
+            if score > best_score {
+                best_score = score;
+                best = delta;
+            }
+        }
+        (center + best) as f64
+    }
+}
+
+impl Wave {
+    /// Stretch the wave in time by `factor` without changing its pitch.
+    /// The result has the same sample rate and number of channels
+    /// and is `factor` times as long, rounded to the nearest sample.
+    /// All channels are stretched with the same timing.
+    ///
+    /// ### Example: Slow Down To Half Speed
+    /// ```
+    /// use fundsp::prelude64::*;
+    /// let wave = Wave::render(44100.0, 1.0, &mut (sine_hz(440.0)));
+    /// let slow = wave.stretch(2.0);
+    /// assert_eq!(slow.len(), 88200);
+    /// ```
+    pub fn stretch(&self, factor: f64) -> Wave {
+        assert!(factor > 0.0 && factor.is_finite());
+        let length = round(self.len() as f64 * factor) as usize;
+        let channels = self.channels();
+        if channels == 0 || length == 0 {
+            return Wave::new(channels, self.sample_rate());
+        }
+        let source = Source {
+            wave: self,
+            channel: 0,
+            loop_point: None,
+            inside: false,
+            limits: None,
+        };
+        let mut stretcher = Stretcher::new(channels, self.sample_rate(), 1.0);
+        let mut output = vec![Vec::with_capacity(length); channels];
+        let speed = 1.0 / factor;
+        for i in 0..length {
+            stretcher.prepare(&source, i as f64 * speed, speed, 1.0, 0.0);
+            for (channel, samples) in output.iter_mut().enumerate() {
+                samples.push(stretcher.value(channel));
+            }
+            stretcher.advance();
+        }
+        let mut wave = Wave::with_capacity(0, self.sample_rate(), length);
+        for samples in output.iter() {
+            wave.push_channel(samples);
+        }
+        wave
+    }
+}
+
+/// Wave player with variable speed that keeps the pitch of the wave.
+/// - Input 0: playback speed (1 = recorded speed, 0 = hold, negative = backwards)
+/// - Output 0: wave
+#[derive(Clone)]
+pub struct WaveStretcher {
+    wave: Arc<Wave>,
+    channel: usize,
+    loop_point: Option<usize>,
+    stretcher: Stretcher,
+    position: f64,
+    inside: bool,
+    sample_rate: f64,
+}
+
+impl WaveStretcher {
+    /// Create a player for `channel` of `wave` with an optional `loop_point`.
+    /// Past the end of the wave, playback continues from the loop point.
+    pub fn new(wave: &Arc<Wave>, channel: usize, loop_point: Option<usize>) -> Self {
+        assert!(channel < wave.channels());
+        let loop_point = loop_point.filter(|&point| point < wave.len());
+        Self {
+            wave: wave.clone(),
+            channel,
+            loop_point,
+            stretcher: Stretcher::new(1, DEFAULT_SR, wave.sample_rate() / DEFAULT_SR),
+            position: 0.0,
+            inside: loop_point == Some(0),
+            sample_rate: DEFAULT_SR,
+        }
+    }
+
+    /// Playback position in samples of the wave.
+    pub fn position(&self) -> f64 {
+        self.position
+    }
+
+    fn period(&self) -> f64 {
+        match self.loop_point {
+            Some(point) if self.inside => (self.wave.len() - point) as f64,
+            _ => 0.0,
+        }
+    }
+
+    fn move_position(&mut self, delta: f64) {
+        self.position += delta;
+        if let Some(point) = self.loop_point {
+            let point = point as f64;
+            if self.position >= point {
+                self.inside = true;
+            }
+            if self.inside {
+                let length = self.wave.len() as f64 - point;
+                self.position = point + (self.position - point).rem_euclid(length);
+            }
+        }
+    }
+}
+
+impl AudioNode for WaveStretcher {
+    const ID: u64 = 101;
+    type Inputs = U1;
+    type Outputs = U1;
+
+    fn reset(&mut self) {
+        self.position = 0.0;
+        self.inside = self.loop_point == Some(0);
+        self.stretcher.reset();
+    }
+
+    fn set_sample_rate(&mut self, sample_rate: f64) {
+        if self.sample_rate != sample_rate {
+            self.sample_rate = sample_rate;
+            self.stretcher = Stretcher::new(1, sample_rate, self.wave.sample_rate() / sample_rate);
+        }
+    }
+
+    #[inline]
+    fn tick(&mut self, input: &Frame<f32, Self::Inputs>) -> Frame<f32, Self::Outputs> {
+        let speed = input[0] as f64;
+        let ratio = self.wave.sample_rate() / self.sample_rate;
+        let length = self.wave.len() as f64;
+        let outside = !self.inside
+            && (self.position < 0.0 || (self.loop_point.is_none() && self.position >= length));
+        if outside {
+            if self.stretcher.primed {
+                self.stretcher.reset();
+            }
+            self.move_position(speed * ratio);
+            return [0.0].into();
+        }
+        let period = self.period();
+        let limits = match self.loop_point {
+            Some(point) if self.inside => (point as f64, length - 1.0),
+            Some(_) => (0.0, f64::INFINITY),
+            None => (0.0, length - 1.0),
+        };
+        let source = Source {
+            wave: &self.wave,
+            channel: self.channel,
+            loop_point: self.loop_point,
+            inside: self.inside,
+            limits: Some(limits),
+        };
+        self.stretcher
+            .prepare(&source, self.position, speed, ratio, period);
+        let value = self.stretcher.value(0);
+        self.stretcher.advance();
+        self.move_position(speed * ratio);
+        [value].into()
+    }
+
+    fn route(&mut self, input: &SignalFrame, _frequency: f64) -> SignalFrame {
+        Routing::Arbitrary(0.0).route(input, self.outputs())
+    }
+}
