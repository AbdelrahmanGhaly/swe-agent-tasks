+    assert!((as_f64(node.position()) - expected).abs() < 1.0e-3);
+    play(&mut node, 0.5, 1000);
+    let expected = 600.0 + (1000.0 * ratio - 600.0) % 400.0;
+    assert!((as_f64(node.position()) - expected).abs() < 1.0e-3);
+    play(&mut node, -0.7, 500);
+    let expected = 600.0 + (expected - 600.0 - 350.0 * ratio).rem_euclid(400.0);
+    assert!((as_f64(node.position()) - expected).abs() < 1.0e-3);
+}
