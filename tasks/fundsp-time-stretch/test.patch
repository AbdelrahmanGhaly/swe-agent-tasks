@@ -0,0 +1,1464 @@
+use fundsp::prelude64::*;
+use std::sync::Arc;
+
+const TAU64: f64 = std::f64::consts::TAU;
+
+fn as_f64<T: Into<f64>>(x: T) -> f64 {
+    x.into()
+}
+
+fn sine_samples(sample_rate: f64, frequency: f64, amplitude: f64, samples: usize) -> Vec<f32> {
+    (0..samples)
+        .map(|i| (amplitude * (TAU64 * frequency * i as f64 / sample_rate).sin()) as f32)
+        .collect()
+}
+
+fn sine(sample_rate: f64, frequency: f64, amplitude: f64, seconds: f64) -> Wave {
+    let samples = (sample_rate * seconds).round() as usize;
+    Wave::from_samples(
+        sample_rate,
+        &sine_samples(sample_rate, frequency, amplitude, samples),
+    )
+}
+
+fn overtone_samples(sample_rate: f64, frequency: f64, amplitude: f64, samples: usize) -> Vec<f32> {
+    (0..samples)
+        .map(|i| {
+            let phase = TAU64 * frequency * i as f64 / sample_rate;
+            (amplitude * (phase.sin() + 0.6 * (2.0 * phase).sin() + 0.35 * (3.0 * phase).sin()))
+                as f32
+        })
+        .collect()
+}
+
+fn sine_amplitude_of(samples: &[f32]) -> f64 {
+    (2.0 * samples.iter().map(|&x| x as f64 * x as f64).sum::<f64>() / samples.len() as f64).sqrt()
+}
+
+fn noise_samples(seed: u64, samples: usize) -> Vec<f32> {
+    let mut state = seed;
+    (0..samples)
+        .map(|i| {
+            state = state
+                .wrapping_mul(6364136223846793005)
+                .wrapping_add(1442695040888963407);
+            let x = (state >> 40) as f32 / (1u64 << 24) as f32 - 0.5;
+            x * (1.2 + (i as f32 * 0.0021).sin())
+        })
+        .collect()
+}
+
+fn swell_samples(sample_rate: f64, samples: usize) -> Vec<f32> {
+    (0..samples)
+        .map(|i| {
+            let amplitude = 0.05 + 0.9 * i as f64 / samples as f64;
+            (amplitude * (TAU64 * 441.0 * i as f64 / sample_rate).sin()) as f32
+        })
+        .collect()
+}
+
+fn frequency_of(samples: &[f32], sample_rate: f64) -> f64 {
+    let mut crossings = Vec::new();
+    for i in 1..samples.len() {
+        let (a, b) = (samples[i - 1] as f64, samples[i] as f64);
+        if a <= 0.0 && b > 0.0 {
+            crossings.push((i - 1) as f64 + -a / (b - a));
+        }
+    }
+    assert!(crossings.len() >= 3, "no steady tone found");
+    (crossings.len() - 1) as f64 * sample_rate / (crossings[crossings.len() - 1] - crossings[0])
+}
+
+fn correlation_at(samples: &[f32], lag: usize) -> f64 {
+    let (mut xy, mut xx, mut yy) = (0.0, 0.0, 0.0);
+    for i in 0..samples.len() - lag {
+        let (a, b) = (samples[i] as f64, samples[i + lag] as f64);
+        xy += a * b;
+        xx += a * a;
+        yy += b * b;
+    }
+    if xx > 0.0 && yy > 0.0 {
+        xy / (xx * yy).sqrt()
+    } else {
+        0.0
+    }
+}
+
+fn repeat_frequency_of(samples: &[f32], sample_rate: f64, frequency: f64) -> f64 {
+    let period = sample_rate / frequency;
+    let first = (0.3 * period).floor() as usize;
+    let last = (1.25 * period).ceil() as usize;
+    let correlations: Vec<f64> = (first..=last + 1)
+        .map(|lag| correlation_at(samples, lag))
+        .collect();
+    let i = (1..correlations.len() - 1)
+        .find(|&i| {
+            correlations[i] > 0.9
+                && correlations[i] >= correlations[i - 1]
+                && correlations[i] >= correlations[i + 1]
+        })
+        .expect("no steady tone found");
+    let (a, b, c) = (correlations[i - 1], correlations[i], correlations[i + 1]);
+    let curve = a - 2.0 * b + c;
+    let shift = if curve < 0.0 {
+        0.5 * (a - c) / curve
+    } else {
+        0.0
+    };
+    sample_rate / ((first + i) as f64 + shift)
+}
+
+fn assert_steady_tone(
+    samples: &[f32],
+    sample_rate: f64,
+    frequency: f64,
+    amplitude: f64,
+    skip: usize,
+    label: &str,
+) {
+    assert_steady(
+        samples,
+        sample_rate,
+        frequency,
+        amplitude,
+        skip,
+        label,
+        |part| frequency_of(part, sample_rate),
+    );
+}
+
+fn assert_steady_tone_with_overtones(
+    samples: &[f32],
+    sample_rate: f64,
+    frequency: f64,
+    amplitude: f64,
+    skip: usize,
+    label: &str,
+) {
+    assert_steady(
+        samples,
+        sample_rate,
+        frequency,
+        amplitude,
+        skip,
+        label,
+        |part| repeat_frequency_of(part, sample_rate, frequency),
+    );
+}
+
+fn assert_steady(
+    samples: &[f32],
+    sample_rate: f64,
+    frequency: f64,
+    amplitude: f64,
+    skip: usize,
+    label: &str,
+    measure: impl Fn(&[f32]) -> f64,
+) {
+    assert!(
+        samples.len() > 2 * skip + (0.1 * sample_rate) as usize,
+        "{label}: too short"
+    );
+    let body = &samples[skip..samples.len() - skip];
+    let measured = measure(body);
+    assert!(
+        (measured / frequency - 1.0).abs() <= 0.02,
+        "{label}: frequency {measured} Hz, expected {frequency} Hz"
+    );
+    let expected = amplitude / 2.0f64.sqrt();
+    let window = (0.05 * sample_rate).round() as usize;
+    let mut start = 0;
+    while start + window <= body.len() {
+        let part = &body[start..start + window];
+        let power = part.iter().map(|&x| x as f64 * x as f64).sum::<f64>() / window as f64;
+        let level = 10.0 * (power / (expected * expected)).log10();
+        assert!(
+            level.abs() <= 1.5,
+            "{label}: level {level} dB in the window at sample {}",
+            skip + start
+        );
+        let local = measure(part);
+        assert!(
+            (local / frequency - 1.0).abs() <= 0.02,
+            "{label}: frequency {local} Hz in the window at sample {}, expected {frequency} Hz",
+            skip + start
+        );
+        start += window / 8;
+    }
+}
+
+fn edge(sample_rate: f64) -> usize {
+    (0.05 * sample_rate).ceil() as usize
+}
+
+fn stretched_edge(sample_rate: f64, factor: f64) -> usize {
+    (0.05 * sample_rate * factor.max(1.0)).ceil() as usize
+}
+
+fn play(
+    node: &mut An<impl AudioNode<Inputs = U1, Outputs = U1>>,
+    speed: f32,
+    samples: usize,
+) -> Vec<f32> {
+    (0..samples).map(|_| node.filter_mono(speed)).collect()
+}
+
+fn click_wave(sample_rate: f64, length: usize, clicks: &[usize]) -> Wave {
+    let mut samples = vec![0.0f32; length];
+    for &i in clicks {
+        samples[i] = 1.0;
+    }
+    Wave::from_samples(sample_rate, &samples)
+}
+
+fn peak_near(samples: &[f32], sample_rate: f64, time: f64) -> f32 {
+    let near = 0.05 * sample_rate;
+    samples
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| (*i as f64 - time).abs() <= near)
+        .fold(0.0f32, |peak, (_, &x)| peak.max(x.abs()))
+}
+
+fn assert_click_survives(output: &Wave, sample_rate: f64, stretched: f64, label: &str) {
+    assert_click_height(output.channel(0), sample_rate, stretched, 1.0, label);
+}
+
+fn assert_click_height(
+    samples: &[f32],
+    sample_rate: f64,
+    stretched: f64,
+    height: f32,
+    label: &str,
+) {
+    let peak = peak_near(samples, sample_rate, stretched);
+    assert!(
+        peak >= 0.5 * height.abs(),
+        "{label}: click of height {height} peaks at {peak} near {stretched}"
+    );
+}
+
+fn assert_quiet_away_from(output: &Wave, sample_rate: f64, stretched: &[f64], label: &str) {
+    assert_quiet_below(output.channel(0), sample_rate, stretched, 0.01, label);
+}
+
+fn assert_quiet_below(
+    samples: &[f32],
+    sample_rate: f64,
+    stretched: &[f64],
+    limit: f32,
+    label: &str,
+) {
+    let far = 0.1 * sample_rate;
+    for (i, &x) in samples.iter().enumerate() {
+        if stretched.iter().all(|&t| (i as f64 - t).abs() >= far) {
+            assert!(x.abs() <= limit, "{label}: {x} at sample {i}");
+        }
+    }
+}
+
+struct Seeded(u64);
+
+impl Seeded {
+    fn next(&mut self) -> f64 {
+        self.0 = self
+            .0
+            .wrapping_mul(6364136223846793005)
+            .wrapping_add(1442695040888963407);
+        (self.0 >> 11) as f64 / (1u64 << 53) as f64
+    }
+
+    fn range(&mut self, low: f64, high: f64) -> f64 {
+        low + (high - low) * self.next()
+    }
+
+    fn pick(&mut self, values: &[f64]) -> f64 {
+        values[std::cmp::min(
+            (self.next() * values.len() as f64) as usize,
+            values.len() - 1,
+        )]
+    }
+}
+
+fn sawtooth_samples(sample_rate: f64, frequency: f64, samples: usize) -> Vec<f32> {
+    (0..samples)
+        .map(|i| {
+            let phase = (frequency * i as f64 / sample_rate).fract();
+            (0.8 * phase - 0.4) as f32
+        })
+        .collect()
+}
+
+fn falling_fraction(samples: &[f32]) -> f64 {
+    let steps: Vec<f32> = samples
+        .windows(2)
+        .map(|w| w[1] - w[0])
+        .filter(|&d| d != 0.0)
+        .collect();
+    steps.iter().filter(|&&d| d < 0.0).count() as f64 / steps.len() as f64
+}
+
+#[test]
+fn stretched_length_rounds_to_nearest_sample() {
+    for &(length, factor, expected) in &[
+        (1001usize, 1.5f64, 1502usize),
+        (10, 0.25, 3),
+        (3, 0.5, 2),
+        (7, 1.3, 9),
+        (44100, 0.37, 16317),
+        (1000, 2.0004, 2000),
+        (999, 2.0006, 1999),
+        (12345, 4.0, 49380),
+        (12345, 0.333, 4111),
+    ] {
+        let wave = Wave::from_samples(44100.0, &noise_samples(length as u64, length));
+        let output = wave.stretch(factor as _);
+        assert_eq!(output.len(), expected, "length {length} factor {factor}");
+        assert_eq!(output.channel(0).len(), expected);
+    }
+}
+
+#[test]
+fn stretch_keeps_sample_rate_and_channels() {
+    let mut wave = Wave::new(0, 32000.0);
+    for channel in 0..3 {
+        wave.push_channel(&noise_samples(channel + 7, 5000));
+    }
+    let output = wave.stretch(1.75);
+    assert_eq!(output.channels(), 3);
+    assert_eq!(output.sample_rate(), 32000.0);
+    assert_eq!(output.len(), 8750);
+    for channel in 0..3 {
+        assert_eq!(output.channel(channel).len(), 8750);
+    }
+}
+
+#[test]
+fn empty_wave_stretches_to_empty_wave() {
+    let wave = Wave::new(2, 48000.0);
+    let output = wave.stretch(3.0);
+    assert_eq!(output.len(), 0);
+    assert_eq!(output.channels(), 2);
+    assert_eq!(output.sample_rate(), 48000.0);
+}
+
+#[test]
+fn factor_one_returns_the_same_samples() {
+    let mut wave = Wave::new(0, 44100.0);
+    wave.push_channel(&noise_samples(1, 30000));
+    wave.push_channel(&sine_samples(44100.0, 333.0, 0.7, 30000));
+    wave.push_channel(&swell_samples(44100.0, 30000));
+    let output = wave.stretch(1.0);
+    assert_eq!(output.len(), 30000);
+    for channel in 0..3 {
+        for i in 0..30000 {
+            let error = (output.at(channel, i) - wave.at(channel, i)).abs();
+            assert!(
+                error <= 1.0e-6,
+                "channel {channel} sample {i}: error {error}"
+            );
+        }
+    }
+}
+
+#[test]
+fn silence_stretches_to_silence() {
+    for &factor in &[0.25, 0.6, 1.0, 2.5, 4.0] {
+        let wave = Wave::zero(2, 44100.0, 1.0);
+        let output = wave.stretch(factor);
+        for channel in 0..2 {
+            assert!(
+                output.channel(channel).iter().all(|&x| x == 0.0),
+                "factor {factor}"
+            );
+        }
+    }
+}
+
+#[test]
+fn silent_channel_stays_silent_beside_sound() {
+    let mut wave = Wave::new(0, 44100.0);
+    wave.push_channel(&noise_samples(3, 44100));
+    wave.push_channel(&vec![0.0; 44100]);
+    for &factor in &[0.5, 1.7, 3.0] {
+        let output = wave.stretch(factor);
+        assert!(
+            output.channel(1).iter().all(|&x| x == 0.0),
+            "factor {factor}"
+        );
+        assert!(
+            output.channel(0).iter().any(|&x| x != 0.0),
+            "factor {factor}"
+        );
+    }
+}
+
+#[test]
+fn channels_that_stop_together_stop_on_the_same_sample() {
+    let sample_rate = 44100.0;
+    for &factor in &[0.5, 0.8, 1.3, 2.0, 3.1] {
+        let mut left = sine_samples(sample_rate, 310.0, 0.5, 66150);
+        let mut right = sine_samples(sample_rate, 1730.0, 0.5, 66150);
+        let mut tail = noise_samples(9, 66150);
+        for i in 44100..66150 {
+            left[i] = 0.0;
+            right[i] = 0.0;
+            tail[i] = 0.0;
+        }
+        let mut wave = Wave::new(0, sample_rate);
+        wave.push_channel(&left);
+        wave.push_channel(&right);
+        wave.push_channel(&tail);
+        let output = wave.stretch(factor);
+        let last = |channel: usize| output.channel(channel).iter().rposition(|&x| x != 0.0);
+        assert!(last(0).is_some());
+        assert_eq!(last(0), last(1), "factor {factor}");
+        assert_eq!(last(0), last(2), "factor {factor}");
+    }
+}
+
+#[test]
+fn slowing_down_keeps_pitch_and_level() {
+    let sample_rate = 44100.0;
+    for &frequency in &[100.0, 440.0, 1000.0, 3150.0, 5000.0] {
+        for &factor in &[1.25, 1.5, 2.0, 3.0, 4.0] {
+            let wave = sine(sample_rate, frequency, 0.5, 0.8);
+            let output = wave.stretch(factor);
+            assert_steady_tone(
+                output.channel(0),
+                sample_rate,
+                frequency,
+                0.5,
+                stretched_edge(sample_rate, factor),
+                &format!("{frequency} Hz factor {factor}"),
+            );
+        }
+    }
+}
+
+#[test]
+fn speeding_up_keeps_pitch_and_level() {
+    let sample_rate = 44100.0;
+    for &frequency in &[100.0, 523.0, 1200.0, 2711.0, 5000.0] {
+        for &factor in &[0.25, 0.4, 0.5, 0.8] {
+            let wave = sine(sample_rate, frequency, 0.5, 2.5);
+            let output = wave.stretch(factor);
+            assert_steady_tone(
+                output.channel(0),
+                sample_rate,
+                frequency,
+                0.5,
+                stretched_edge(sample_rate, factor),
+                &format!("{frequency} Hz factor {factor}"),
+            );
+        }
+    }
+}
+
+#[test]
+fn stretching_keeps_pitch_at_other_sample_rates() {
+    for &sample_rate in &[22050.0, 32000.0, 48000.0, 96000.0] {
+        for &(frequency, factor) in &[(150.0, 2.0), (880.0, 0.5), (3600.0, 3.0), (2100.0, 0.3)] {
+            let wave = sine(sample_rate, frequency, 0.4, 1.0);
+            let output = wave.stretch(factor);
+            assert_steady_tone(
+                output.channel(0),
+                sample_rate,
+                frequency,
+                0.4,
+                stretched_edge(sample_rate, factor),
+                &format!("{sample_rate} Hz rate, {frequency} Hz factor {factor}"),
+            );
+        }
+    }
+}
+
+#[test]
+fn stretching_keeps_pitch_of_a_tone_with_overtones() {
+    for &sample_rate in &[44100.0, 32000.0] {
+        let samples = overtone_samples(sample_rate, 330.0, 0.3, sample_rate as usize);
+        let amplitude = sine_amplitude_of(&samples);
+        let wave = Wave::from_samples(sample_rate, &samples);
+        for &factor in &[0.5, 1.7, 3.0] {
+            let output = wave.stretch(factor);
+            assert_steady_tone_with_overtones(
+                output.channel(0),
+                sample_rate,
+                330.0,
+                amplitude,
+                stretched_edge(sample_rate, factor),
+                &format!("{sample_rate} Hz rate, factor {factor}"),
+            );
+        }
+    }
+}
+
+#[test]
+fn stretching_keeps_overtones_close_to_a_sixth_of_the_rate() {
+    for &(sample_rate, frequency) in &[(44100.0, 2400.0), (32000.0, 1700.0), (22050.0, 1200.0)] {
+        let samples = overtone_samples(sample_rate, frequency, 0.3, sample_rate as usize);
+        let amplitude = sine_amplitude_of(&samples);
+        let wave = Wave::from_samples(sample_rate, &samples);
+        for &factor in &[0.5, 3.0] {
+            let output = wave.stretch(factor);
+            assert_steady_tone_with_overtones(
+                output.channel(0),
+                sample_rate,
+                frequency,
+                amplitude,
+                stretched_edge(sample_rate, factor),
+                &format!("{sample_rate} Hz rate, {frequency} Hz factor {factor}"),
+            );
+        }
+    }
+}
+
+#[test]
+fn stretching_keeps_quiet_and_loud_levels() {
