+#[test]
+fn clicks_of_any_height_and_sign_stay_sharp() {
+    let sample_rate = 44100.0;
+    let clicks = [
+        (3000usize, -1.0f32),
+        (20000, 0.35),
+        (37000, -0.08),
+        (54000, 0.6),
+    ];
+    let mut samples = vec![0.0f32; 60000];
+    for &(i, height) in clicks.iter() {
+        samples[i] = height;
+    }
+    let wave = Wave::from_samples(sample_rate, &samples);
+    for &factor in &[1.3, 2.4, 4.0] {
+        let output = wave.stretch(factor);
+        for &(i, height) in clicks.iter() {
+            assert_click_height(
+                output.channel(0),
+                sample_rate,
+                i as f64 * factor,
+                height,
+                &format!("factor {factor} click {i}"),
+            );
+        }
+        let stretched: Vec<f64> = clicks.iter().map(|&(i, _)| i as f64 * factor).collect();
+        assert_quiet_below(
+            output.channel(0),
+            sample_rate,
+            &stretched,
+            0.0008,
+            &format!("factor {factor}"),
+        );
+    }
+}
