+#[test]
+fn clicks_stay_sharp_across_seeded_settings() {
+    let mut random = Seeded(777);
+    for case in 0..24 {
+        let sample_rate = random.pick(&[44100.0, 48000.0]);
+        let length = (sample_rate * random.range(0.3, 1.5)) as usize;
+        let position = match case % 6 {
+            0 => 0,
+            1 => length - 1,
+            _ => std::cmp::min((random.next() * length as f64) as usize, length - 1),
+        };
+        let sign = if random.next() < 0.5 { -1.0 } else { 1.0 };
+        let height = (sign * random.range(0.05, 1.0)) as f32;
+        let factor = random.range(1.05, 4.0);
+        let mut samples = vec![0.0f32; length];
+        samples[position] = height;
+        let output = Wave::from_samples(sample_rate, &samples).stretch(factor);
+        let stretched = position as f64 * factor;
+        let label = format!(
+            "case {case}: length {length} click {position} height {height} factor {factor}"
+        );
+        assert_click_height(output.channel(0), sample_rate, stretched, height, &label);
+        assert_quiet_below(
+            output.channel(0),
+            sample_rate,
+            &[stretched],
+            0.01 * height.abs(),
+            &label,
+        );
+    }
+}
