@@ -0,0 +1,420 @@
+from __future__ import annotations
+
+import pytest
+
+import rdflib.plugins.sparql
+from rdflib import Dataset, Graph, Literal, Namespace, URIRef
+from rdflib.plugins.stores.memory import Memory
+from rdflib.query import UpdateProcessor
+
+EX = Namespace("http://example.org/")
+PREFIX = "PREFIX ex: <http://example.org/>\n"
+G = URIRef("http://example.org/g")
+
+
+def build_graph(triples, identifier=G):
+    graph = Graph(identifier=identifier)
+    for triple in triples:
+        graph.add(triple)
+    return graph
+
+
+def knows_graph():
+    return build_graph(
+        [
+            (EX.alice, EX.knows, EX.bob),
+            (EX.alice, EX.knows, EX.carol),
+            (EX.bob, EX.age, Literal(30)),
+            (EX.carol, EX.age, Literal(40)),
+        ]
+    )
+
+
+def chain_graph():
+    return build_graph(
+        [
+            (EX.a, EX.step, EX.b),
+            (EX.b, EX.step, EX.c),
+            (EX.c, EX.step, EX.d),
+            (EX.c, EX.step, EX.a),
+            (EX.a, EX.hop, EX.e),
+            (EX.e, EX.step, EX.d),
+            (EX.x, EX.step, EX.y),
+        ]
+    )
+
+
+def build_dataset(default_union=False):
+    dataset = Dataset(default_union=default_union)
+    left = dataset.graph(EX.left)
+    left.add((EX.alice, EX.knows, EX.bob))
+    right = dataset.graph(EX.right)
+    right.add((EX.alice, EX.knows, EX.bob))
+    right.add((EX.bob, EX.knows, EX.carol))
+    return dataset
+
+
+def run(graph, query):
+    return graph.query(PREFIX + query)
+
+
+def bindings(result):
+    return [tuple(row) for row in result]
+
+
+def test_basic_pattern_binds_every_match():
+    graph = knows_graph()
+    assert sorted(bindings(run(graph, "SELECT ?f WHERE { ex:alice ex:knows ?f }"))) == [
+        (EX.bob,),
+        (EX.carol,),
+    ]
+
+
+def test_join_of_two_groups():
+    graph = knows_graph()
+    assert sorted(
+        bindings(
+            run(graph, "SELECT ?n WHERE { { ex:alice ex:knows ?f } { ?f ex:age ?n } }")
+        )
+    ) == [(Literal(30),), (Literal(40),)]
+
+
+def test_optional_leaves_the_variable_unbound():
+    graph = build_graph([(EX.alice, EX.knows, EX.bob), (EX.carol, EX.age, Literal(40))])
+    assert bindings(
+        run(
+            graph,
+            "SELECT ?f ?n WHERE { ex:alice ex:knows ?f OPTIONAL { ?f ex:age ?n } }",
+        )
+    ) == [(EX.bob, None)]
+
+
+def test_minus_removes_the_matching_solutions():
+    graph = knows_graph()
+    assert bindings(
+        run(graph, "SELECT ?f WHERE { ex:alice ex:knows ?f MINUS { ?f ex:age 40 } }")
+    ) == [(EX.bob,)]
+
+
+def test_union_keeps_both_branches():
+    graph = knows_graph()
+    assert sorted(
+        bindings(
+            run(
+                graph,
+                "SELECT ?x WHERE { { ex:alice ex:knows ?x } UNION { ?x ex:age 40 } }",
+            )
+        )
+    ) == [(EX.bob,), (EX.carol,), (EX.carol,)]
+
+
+def test_filter_keeps_only_what_matches():
+    graph = knows_graph()
+    assert bindings(run(graph, "SELECT ?n WHERE { ?p ex:age ?n FILTER(?n > 35) }")) == [
+        (Literal(40),)
+    ]
+
+
+def test_exists_and_not_exists_split_the_solutions():
+    graph = build_graph(
+        [
+            (EX.alice, EX.knows, EX.bob),
+            (EX.alice, EX.knows, EX.carol),
+            (EX.carol, EX.age, Literal(40)),
+        ]
+    )
+    assert bindings(
+        run(
+            graph,
+            "SELECT ?f WHERE { ex:alice ex:knows ?f FILTER EXISTS { ?f ex:age ?n } }",
+        )
+    ) == [(EX.carol,)]
+    assert bindings(
+        run(
+            graph,
+            "SELECT ?f WHERE { ex:alice ex:knows ?f FILTER NOT EXISTS { ?f ex:age ?n } }",
+        )
+    ) == [(EX.bob,)]
+
+
+def test_values_supplies_the_binding():
+    graph = knows_graph()
+    assert bindings(run(graph, "SELECT ?s WHERE { VALUES ?s { ex:alice } }")) == [
+        (EX.alice,)
+    ]
+
+
+def test_bind_computes_a_new_variable():
+    graph = knows_graph()
+    rows = bindings(
+        run(graph, "SELECT ?d WHERE { ex:bob ex:age ?n BIND(?n * 2 AS ?d) }")
+    )
+    assert len(rows) == 1
+    assert int(rows[0][0]) == 60
+
+
+def test_distinct_collapses_repeated_rows():
+    graph = knows_graph()
+    assert bindings(run(graph, "SELECT DISTINCT ?s WHERE { ?s ex:knows ?f }")) == [
+        (EX.alice,)
+    ]
+
+
+def test_reduced_collapses_adjacent_rows():
+    graph = knows_graph()
+    assert bindings(run(graph, "SELECT REDUCED ?s WHERE { ?s ex:knows ?f }")) == [
+        (EX.alice,)
+    ]
+
+
+def test_order_by_and_limit():
+    graph = knows_graph()
+    assert bindings(
+        run(graph, "SELECT ?f WHERE { ex:alice ex:knows ?f } ORDER BY DESC(?f) LIMIT 1")
+    ) == [(EX.carol,)]
+
+
+def test_group_by_counts_each_group():
+    graph = build_graph(
+        [
+            (EX.alice, EX.knows, EX.bob),
+            (EX.carol, EX.knows, EX.dan),
+            (EX.carol, EX.knows, EX.erin),
+        ]
+    )
+    assert bindings(
+        run(
+            graph,
+            "SELECT ?s (COUNT(?f) AS ?c) WHERE { ?s ex:knows ?f } GROUP BY ?s ORDER BY ?s",
+        )
+    ) == [(EX.alice, Literal(1)), (EX.carol, Literal(2))]
+
+
+def test_aggregate_over_an_empty_pattern():
+    graph = knows_graph()
+    assert bindings(
+        run(graph, "SELECT (COUNT(?f) AS ?c) WHERE { ?s ex:likes ?f }")
+    ) == [(Literal(0),)]
+
+
+def test_subquery_feeds_the_outer_pattern():
+    graph = knows_graph()
+    assert sorted(
+        bindings(
+            run(
+                graph,
+                "SELECT ?n WHERE { { SELECT ?f WHERE { ex:alice ex:knows ?f } } ?f ex:age ?n }",
+            )
+        )
+    ) == [(Literal(30),), (Literal(40),)]
+
+
+def test_ask_answers_both_ways():
+    graph = knows_graph()
+    assert bool(run(graph, "ASK { ex:alice ex:knows ?f }")) is True
+    assert bool(run(graph, "ASK { ex:alice ex:likes ?f }")) is False
+
+
+def test_construct_builds_the_template():
+    graph = knows_graph()
+    result = run(
+        graph, "CONSTRUCT { ?f ex:knownBy ex:alice } WHERE { ex:alice ex:knows ?f }"
+    )
+    assert set(result.graph) == {
+        (EX.bob, EX.knownBy, EX.alice),
+        (EX.carol, EX.knownBy, EX.alice),
+    }
+
+
+def test_describe_returns_the_statements_of_a_resource():
+    graph = knows_graph()
+    result = run(graph, "DESCRIBE ex:bob")
+    assert set(result.graph) == {(EX.bob, EX.age, Literal(30))}
+
+
+def test_named_graph_pattern_binds_the_graph():
+    dataset = build_dataset()
+    assert bindings(
+        run(dataset, "SELECT ?g WHERE { GRAPH ?g { ex:bob ex:knows ex:carol } }")
+    ) == [(EX.right,)]
+
+
+def test_union_dataset_sees_every_graph():
+    dataset = build_dataset(default_union=True)
+    assert bindings(run(dataset, "SELECT ?p WHERE { ex:bob ex:knows ?p }")) == [
+        (EX.carol,)
+    ]
+
+
+PATH_CASES = [
+    ("SELECT ?o WHERE { ex:a ex:step/ex:step ?o }", [(EX.c,)]),
+    ("SELECT ?s WHERE { ?s ^ex:step ex:a }", [(EX.b,)]),
+    ("SELECT ?o WHERE { ex:a !(ex:step) ?o }", [(EX.e,)]),
+]
+
+
+@pytest.mark.parametrize("query,expected", PATH_CASES)
+def test_property_paths_bind_their_ends(query, expected):
+    graph = chain_graph()
+    assert sorted(bindings(run(graph, query))) == sorted(expected)
+
+
+def test_repeated_path_reaches_the_whole_chain():
+    graph = chain_graph()
+    reached = {
+        row[0] for row in run(graph, PREFIX + "SELECT ?o WHERE { ex:a ex:step+ ?o }")
+    }
+    assert reached == {EX.a, EX.b, EX.c, EX.d}
+
+
+def test_zero_or_more_path_includes_the_start():
+    graph = chain_graph()
+    reached = {
+        row[0] for row in run(graph, PREFIX + "SELECT ?o WHERE { ex:x ex:step* ?o }")
+    }
+    assert reached == {EX.x, EX.y}
+
+
+def test_insert_data_and_delete_data():
+    dataset = build_dataset()
+    dataset.update(PREFIX + "INSERT DATA { GRAPH ex:left { ex:dan ex:knows ex:erin } }")
+    assert (EX.dan, EX.knows, EX.erin) in dataset.graph(EX.left)
+    dataset.update(PREFIX + "DELETE DATA { GRAPH ex:left { ex:dan ex:knows ex:erin } }")
+    assert (EX.dan, EX.knows, EX.erin) not in dataset.graph(EX.left)
+
+
+def test_delete_where_removes_the_matches():
+    dataset = build_dataset()
+    dataset.update(PREFIX + "DELETE WHERE { GRAPH ex:right { ex:bob ex:knows ?p } }")
+    assert len(dataset.graph(EX.right)) == 1
+
+
+def test_delete_insert_rewrites_the_statements():
+    dataset = build_dataset()
+    dataset.update(
+        PREFIX
+        + "DELETE { GRAPH ex:right { ex:bob ex:knows ?p } }"
+        + " INSERT { GRAPH ex:right { ex:bob ex:knew ?p } }"
+        + " WHERE { GRAPH ex:right { ex:bob ex:knows ?p } }"
+    )
+    assert (EX.bob, EX.knew, EX.carol) in dataset.graph(EX.right)
+    assert (EX.bob, EX.knows, EX.carol) not in dataset.graph(EX.right)
+
+
+def test_copy_replaces_the_target_graph():
+    dataset = build_dataset()
+    dataset.update(PREFIX + "COPY ex:left TO ex:right")
+    assert set(dataset.graph(EX.right)) == {(EX.alice, EX.knows, EX.bob)}
+
+
+def test_move_empties_the_source_graph():
+    dataset = build_dataset()
+    dataset.update(PREFIX + "MOVE ex:left TO ex:target")
+    assert set(dataset.graph(EX.target)) == {(EX.alice, EX.knows, EX.bob)}
+    assert len(dataset.graph(EX.left)) == 0
+
+
+def test_add_keeps_the_source_graph():
+    dataset = build_dataset()
+    dataset.update(PREFIX + "ADD ex:left TO ex:right")
+    assert len(dataset.graph(EX.left)) == 1
+    assert len(dataset.graph(EX.right)) == 2
+
+
+def test_clear_empties_a_graph():
+    dataset = build_dataset()
+    dataset.update(PREFIX + "CLEAR GRAPH ex:right")
+    assert len(dataset.graph(EX.right)) == 0
+
+
+def test_drop_removes_a_graph():
+    dataset = build_dataset()
+    dataset.update(PREFIX + "DROP GRAPH ex:right")
+    assert EX.right not in {graph.identifier for graph in dataset.graphs()}
+
+
+def test_update_returns_nothing():
+    dataset = build_dataset()
+    assert (
+        dataset.update(PREFIX + "INSERT DATA { GRAPH ex:left { ex:p ex:q ex:r } }")
+        is None
+    )
+
+
+def test_update_over_a_plain_graph():
+    graph = knows_graph()
+    graph.update(PREFIX + "DELETE WHERE { ?s ex:age ?n }")
+    assert set(graph) == {
+        (EX.alice, EX.knows, EX.bob),
+        (EX.alice, EX.knows, EX.carol),
+    }
+
+
+def test_init_bindings_are_applied():
+    graph = knows_graph()
+    result = graph.query(
+        PREFIX + "SELECT ?f WHERE { ?s ex:knows ?f }", initBindings={"f": EX.carol}
+    )
+    assert bindings(result) == [(EX.carol,)]
+
+
+class StoreWithUpdateReturningSomething(Memory):
+    def update(self, update, initNs, initBindings, queryGraph):  # noqa: N803
+        return EX.answered
+
+
+def test_a_request_without_the_keyword_keeps_what_the_store_returned():
+    graph = Graph(store=StoreWithUpdateReturningSomething())
+    graph.add((EX.alice, EX.knows, EX.bob))
+    assert graph.update(PREFIX + "INSERT DATA { ex:s ex:p ex:o }") == EX.answered
+
+
+class ProcessorReturningSomething(UpdateProcessor):
+    def __init__(self, graph):
+        self.graph = graph
+
+    def update(
+        self, strOrQuery, initBindings=None, initNs=None, **kwargs  # noqa: N803
+    ):
+        return EX.answered
+
+
+def test_a_request_without_the_keyword_keeps_what_a_supplied_processor_returned():
+    graph = Graph()
+    answer = graph.update(
+        PREFIX + "INSERT DATA { ex:s ex:p ex:o }",
+        processor=ProcessorReturningSomething(graph),
+    )
+    assert answer == EX.answered
+
+
+class ProcessorAnswering(UpdateProcessor):
+    def __init__(self, graph):
+        self.graph = graph
+        self.called = False
+
+    def update(
+        self, strOrQuery, initBindings=None, initNs=None, **kwargs  # noqa: N803
+    ):
+        self.called = True
+        return EX.answered
+
+
+def test_asking_for_no_report_leaves_a_supplied_processor_in_charge():
+    graph = Graph()
+    processor = ProcessorAnswering(graph)
+    answer = graph.update(
+        PREFIX + "INSERT DATA { ex:s ex:p ex:o }",
+        processor=processor,
+        provenance=False,
+    )
+    assert processor.called is True
+    assert answer == EX.answered
+    assert (EX.s, EX.p, EX.o) not in graph
+
+
+def test_a_query_over_an_empty_from_graph_still_answers(monkeypatch):
+    monkeypatch.setattr(rdflib.plugins.sparql, "SPARQL_LOAD_GRAPHS", False)
+    dataset = Dataset()
+    answer = list(dataset.query("SELECT * FROM <urn:missing> WHERE { ?s ?p ?o }"))
+    assert answer == []
