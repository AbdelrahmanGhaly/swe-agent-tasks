+from __future__ import annotations
+
+import random
+
+import pytest
+
+from rdflib import Dataset, Graph, Literal, Namespace, URIRef
+from rdflib.graph import DATASET_DEFAULT_GRAPH_ID
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.stores.memory import Memory
+from rdflib.query import UpdateProcessor
+
+EX = Namespace("http://example.org/")
+PREFIX = "PREFIX ex: <http://example.org/>\n"
+G = URIRef("http://example.org/g")
+
+
+def build_dataset(triples=(), default_union=False):
+    dataset = Dataset(default_union=default_union)
+    graph = dataset.graph(G)
+    for triple in triples or [
+        (EX.alice, EX.knows, EX.bob),
+        (EX.alice, EX.knows, EX.carol),
+        (EX.bob, EX.age, Literal(30)),
+        (EX.carol, EX.age, Literal(40)),
+    ]:
+        graph.add(triple)
+    return dataset
+
+
+def build_graph(triples=(), identifier=G):
+    graph = Graph(identifier=identifier)
+    for triple in triples:
+        graph.add(triple)
+    return graph
+
+
+def split_dataset():
+    dataset = Dataset(default_union=True)
+    left = dataset.graph(EX.left)
+    left.add((EX.alice, EX.knows, EX.bob))
+    right = dataset.graph(EX.right)
+    right.add((EX.alice, EX.knows, EX.bob))
+    right.add((EX.bob, EX.knows, EX.carol))
+    return dataset
+
+
+def quad(subject, predicate, obj, graph=G):
+    return (subject, predicate, obj, graph)
+
+
+def run(store, request, **kwargs):
+    return store.update(PREFIX + request, **kwargs)
+
+
+def mark(where, graph=EX.out, template="ex:alice ex:marked true"):
+    return "INSERT { GRAPH <%s> { %s } } WHERE { %s }" % (str(graph), template, where)
+
+
+def marked(graph=EX.out):
+    return quad(EX.alice, EX.marked, Literal(True), graph)
+
+
+def state(dataset):
+    return set(dataset.quads())
+
+
+def test_dropping_a_graph_with_a_report_takes_the_graph_away():
+    dataset = split_dataset()
+    run(dataset, "DROP GRAPH ex:left", provenance=True)
+    assert EX.left not in {graph.identifier for graph in dataset.graphs()}
+
+
+@pytest.mark.parametrize("transfer", ["COPY", "MOVE"])
+def test_a_transfer_from_an_empty_graph_still_clears_the_target(transfer):
+    dataset = Dataset()
+    dataset.graph(EX.target).add((EX.alice, EX.p, EX.old))
+    report = run(dataset, "%s ex:source TO ex:target" % transfer, provenance=True)
+    assert report == {
+        "added": {},
+        "removed": {quad(EX.alice, EX.p, EX.old, EX.target): frozenset()},
+    }
+    assert state(dataset) == set()
+
+
+@pytest.mark.parametrize("transfer", ["COPY", "MOVE"])
+def test_a_transfer_onto_itself_changes_nothing(transfer):
+    dataset = Dataset()
+    dataset.graph(EX.same).add((EX.alice, EX.p, EX.o))
+    report = run(dataset, "%s ex:same TO ex:same" % transfer, provenance=True)
+    assert report == {"added": {}, "removed": {}}
+    assert state(dataset) == {quad(EX.alice, EX.p, EX.o, EX.same)}
+
+
+def test_moving_onto_a_graph_reports_what_it_replaced():
+    dataset = Dataset()
+    dataset.graph(EX.source).add((EX.alice, EX.p, EX.new))
+    dataset.graph(EX.target).add((EX.alice, EX.p, EX.old))
+    report = run(dataset, "MOVE ex:source TO ex:target", provenance=True)
+    assert report["removed"] == {
+        quad(EX.alice, EX.p, EX.new, EX.source): frozenset(),
+        quad(EX.alice, EX.p, EX.old, EX.target): frozenset(),
+    }
+    assert report["added"] == {
+        quad(EX.alice, EX.p, EX.new, EX.target): frozenset(
+            {quad(EX.alice, EX.p, EX.new, EX.source)}
+        )
+    }
+
+
+@pytest.mark.parametrize("request_text", ["CLEAR ALL", "DROP ALL"])
+def test_emptying_everything_reports_the_default_graph_too(request_text):
+    dataset = Dataset()
+    dataset.add((EX.dflt, EX.p, EX.o))
+    dataset.graph(EX.side).add((EX.named, EX.p, EX.o))
+    report = run(dataset, request_text, provenance=True)
+    assert report["removed"] == {
+        quad(EX.dflt, EX.p, EX.o, DATASET_DEFAULT_GRAPH_ID): frozenset(),
+        quad(EX.named, EX.p, EX.o, EX.side): frozenset(),
+    }
+    assert state(dataset) == set()
+
+
+class StoreAnswering(Memory):
+    def update(self, update, initNs, initBindings, queryGraph):  # noqa: N803
+        return EX.answered
+
+
+def test_asking_for_no_report_leaves_a_store_update_in_charge():
+    graph = Graph(store=StoreAnswering())
+    answer = graph.update(PREFIX + "INSERT DATA { ex:s ex:p ex:o }", provenance=False)
+    assert answer == EX.answered
+    assert (EX.s, EX.p, EX.o) not in graph
+
+
+def test_moving_a_graph_with_a_report_takes_the_source_away():
+    dataset = split_dataset()
+    run(dataset, "MOVE ex:left TO ex:target", provenance=True)
+    assert EX.left not in {graph.identifier for graph in dataset.graphs()}
+
+
+def test_a_report_does_not_change_what_a_graph_can_be_asked():
+    plain = Graph(identifier=G)
+    with pytest.raises(Exception):
+        plain.update(PREFIX + "DROP GRAPH ex:other")
+    tracked = Graph(identifier=G)
+    with pytest.raises(Exception):
+        tracked.update(PREFIX + "DROP GRAPH ex:other", provenance=True)
+    asked = Graph(identifier=G)
+    assert run(asked, "INSERT DATA { ex:s ex:p ex:o }", provenance=True) == {
