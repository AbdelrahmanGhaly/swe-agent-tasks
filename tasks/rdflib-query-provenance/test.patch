+class StoreBufferingItsWrites(Memory):
+    def __init__(self, *args, **keywords):
+        super().__init__(*args, **keywords)
+        self.queued = []
+
+    def add(self, triple, context, quoted=False):
+        self.queued.append(("add", triple, context))
+
+    def remove(self, triple, context=None):
+        self.queued.append(("remove", triple, context))
+
+    def commit(self):
+        for what, triple, context in self.queued:
+            if what == "add":
+                Memory.add(self, triple, context)
+            else:
+                Memory.remove(self, triple, context)
+        self.queued = []
+
