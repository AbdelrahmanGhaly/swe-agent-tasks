+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd /app || exit 1
+
+NEW_TESTS="test/test_sparql_provenance_062612.py"
+
+ARGS=(-p no:cacheprovider -o addopts=)
+# the marked cases and the graphdb/rdf4j suites need a live server or a container,
+# and test_plugins.py needs the test-only plugin packages to be installed first
+ARGS+=(-m "not webtest and not testcontainer")
+ARGS+=(--ignore=test/test_graphdb --ignore=test/test_rdf4j)
+ARGS+=(--ignore=test/test_misc/test_plugins.py)
+# the swap_n3 cases flip between pass and xfail from run to run, and the three
+# tests below build their ids from fresh blank nodes, so their ids differ every run
+ARGS+=(--ignore=test/test_parsers/test_swap_n3.py)
+ARGS+=(-k "not test_skolemization and not test_expand_curie and not test_xsv_serialize")
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  ARGS+=(--junitxml="$OUTPUT_PATH")
+fi
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "${ARGS[@]}" "$NEW_TESTS"
+else
+  python -m pytest "${ARGS[@]}" --ignore="$NEW_TESTS" test
+fi
+EXIT_CODE=$?
+
+if [ -n "$OUTPUT_PATH" ] && [ ! -s "$OUTPUT_PATH" ]; then
+  cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="pytest" tests="1" failures="1" errors="0" time="0">
+    <testcase name="collection" classname="pytest"><failure message="pytest produced no report">the test run ended before any test was recorded</failure></testcase>
+  </testsuite>
+</testsuites>
+XMLEOF
+fi
+
+exit $EXIT_CODE
