+# Copyright (c) Meta Platforms, Inc. and affiliates.
+#
+# This source code is licensed under the MIT license found in the
+# LICENSE file in the root directory of this source tree.
+#
+from typing import List, Sequence, Union
+
+import libcst as cst
+from libcst.codemod._visitor import ContextAwareTransformer
+from libcst.metadata import ControlFlowProvider
+
+
+def _pass_line() -> cst.SimpleStatementLine:
+    return cst.SimpleStatementLine(body=[cst.Pass()])
+
+
+def _without_trailing_semicolon(
+    body: Sequence[cst.BaseSmallStatement],
+) -> List[cst.BaseSmallStatement]:
+    kept = list(body)
+    kept[-1] = kept[-1].with_changes(semicolon=cst.MaybeSentinel.DEFAULT)
+    return kept
+
+
+class RemoveUnreachableCodeVisitor(ContextAwareTransformer):
+    """
+    Removes statements that :class:`~libcst.metadata.ControlFlowProvider` reports as
+    unreachable, keeping every block syntactically valid.
+    """
+
+    METADATA_DEPENDENCIES = (ControlFlowProvider,)
+
+    def _is_unreachable(self, node: cst.CSTNode) -> bool:
+        info = self.get_metadata(ControlFlowProvider, node, None)
+        return info is not None and not info.reachable
+
+    def on_leave(
+        self, original_node: cst.CSTNodeT, updated_node: cst.CSTNodeT
+    ) -> Union[cst.CSTNodeT, cst.RemovalSentinel]:
+        result = super().on_leave(original_node, updated_node)
+        if isinstance(result, cst.RemovalSentinel):
+            return result
+        if not isinstance(original_node, (cst.BaseStatement, cst.BaseSmallStatement)):
+            return result
+        if self._is_unreachable(original_node):
+            return cst.RemoveFromParent()
+        return result
+
+    def leave_SimpleStatementLine(
+        self,
+        original_node: cst.SimpleStatementLine,
+        updated_node: cst.SimpleStatementLine,
+    ) -> Union[cst.SimpleStatementLine, cst.RemovalSentinel]:
+        if not updated_node.body:
+            return cst.RemoveFromParent()
+        if len(updated_node.body) == len(original_node.body):
+            return updated_node
+        return updated_node.with_changes(
+            body=_without_trailing_semicolon(updated_node.body)
+        )
+
+    def leave_SimpleStatementSuite(
+        self,
+        original_node: cst.SimpleStatementSuite,
+        updated_node: cst.SimpleStatementSuite,
+    ) -> cst.SimpleStatementSuite:
+        if not updated_node.body:
+            return updated_node.with_changes(body=[cst.Pass()])
+        if len(updated_node.body) == len(original_node.body):
+            return updated_node
+        return updated_node.with_changes(
+            body=_without_trailing_semicolon(updated_node.body)
+        )
+
+    def leave_IndentedBlock(
+        self, original_node: cst.IndentedBlock, updated_node: cst.IndentedBlock
+    ) -> cst.IndentedBlock:
+        if updated_node.body:
+            return updated_node
+        return updated_node.with_changes(body=[_pass_line()])
