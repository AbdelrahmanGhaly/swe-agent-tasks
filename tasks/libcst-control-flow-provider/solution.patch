index 0000000..e9fd672
--- /dev/null
+++ b/libcst/metadata/control_flow_provider.py
@@ -0,0 +1,297 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+#
+# This source code is licensed under the MIT license found in the
+# LICENSE file in the root directory of this source tree.
+
+
+from ast import literal_eval
+from dataclasses import dataclass
+from enum import auto, Enum
+from typing import FrozenSet, List, Optional, Sequence, Union
+
+import libcst as cst
+from libcst.metadata.base_provider import VisitorMetadataProvider
+
+
+class ExitKind(Enum):
+    """
+    A way in which control can leave a statement.
+    """
+
+    #: Control reaches the end of the statement and continues with the next one.
+    FALL_THROUGH = auto()
+
+    #: Control leaves the enclosing function through a ``return``.
+    RETURN = auto()
+
+    #: Control leaves through a raised exception.
+    RAISE = auto()
+
+    #: Control leaves the enclosing loop through a ``break``.
+    BREAK = auto()
+
+    #: Control returns to the top of the enclosing loop through a ``continue``.
+    CONTINUE = auto()
+
+
+@dataclass(frozen=True)
+class ControlFlowInfo:
+    """
+    Control flow facts about a single statement.
+    """
+
+    #: Whether control can reach this statement from the start of its block.
+    reachable: bool
+
+    #: Every way in which control can leave this statement, whether or not the
+    #: statement itself is reachable.
+    exits: FrozenSet[ExitKind]
+
+
+AnyStatement = Union[cst.BaseStatement, cst.BaseSmallStatement]
+
+_FALL_THROUGH: FrozenSet[ExitKind] = frozenset({ExitKind.FALL_THROUGH})
+_LOOP_ABSORBED: FrozenSet[ExitKind] = frozenset(
+    {ExitKind.BREAK, ExitKind.CONTINUE, ExitKind.FALL_THROUGH}
+)
+_NUMBERS = (cst.Integer, cst.Float, cst.Imaginary)
+_UNPACKED = (cst.StarredElement, cst.StarredDictElement)
+
+
+def _display_truth(
+    elements: Sequence[Union[cst.BaseElement, cst.BaseDictElement]],
+) -> Optional[bool]:
+    if not elements:
+        return False
+    if any(not isinstance(element, _UNPACKED) for element in elements):
+        return True
+    return None
+
+
+def _formatted_string_truth(test: cst.FormattedString) -> Optional[bool]:
+    texts: List[str] = []
+    for part in test.parts:
+        if not isinstance(part, cst.FormattedStringText):
+            return None
+        texts.append(part.value)
+    quote = test.start.lstrip("bBfFrRuU")
+    prefix = test.start[: len(test.start) - len(quote)]
+    plain = prefix.replace("f", "").replace("F", "") + quote
+    literal = plain + "".join(texts) + test.end
+    try:
+        return bool(literal_eval(literal))
+    except (SyntaxError, ValueError):
+        return None
+
+
+def _concatenated_string_truth(test: cst.ConcatenatedString) -> Optional[bool]:
+    left = _constant_truth(test.left)
+    right = _constant_truth(test.right)
+    if left is None or right is None:
+        return None
+    return left or right
+
+
+def _unary_truth(test: cst.UnaryOperation) -> Optional[bool]:
+    inner = _constant_truth(test.expression)
+    if isinstance(test.operator, cst.Not):
+        return None if inner is None else not inner
+    if isinstance(test.operator, (cst.Minus, cst.Plus)) and isinstance(
+        test.expression, _NUMBERS
+    ):
+        return inner
+    return None
+
+
+def _constant_truth(test: cst.BaseExpression) -> Optional[bool]:
+    """
+    The truth value of a test that syntax alone decides, or ``None`` when it
+    depends on something only known at runtime.
+    """
+    if isinstance(test, cst.Name):
+        if test.value == "True":
+            return True
+        if test.value in ("False", "None"):
+            return False
+        return None
+    if isinstance(test, _NUMBERS):
+        return bool(test.evaluated_value)
+    if isinstance(test, cst.SimpleString):
+        value = test.evaluated_value
+        return None if value is None else bool(value)
+    if isinstance(test, cst.ConcatenatedString):
+        return _concatenated_string_truth(test)
+    if isinstance(test, cst.FormattedString):
+        return _formatted_string_truth(test)
+    if isinstance(test, (cst.List, cst.Set, cst.Tuple)):
+        return _display_truth(test.elements)
+    if isinstance(test, cst.Dict):
+        return _display_truth(test.elements)
+    if isinstance(test, cst.UnaryOperation):
+        return _unary_truth(test)
+    return None
+
+
+def _is_irrefutable_pattern(pattern: cst.MatchPattern) -> bool:
+    if isinstance(pattern, cst.MatchAs):
+        inner = pattern.pattern
+        return inner is None or _is_irrefutable_pattern(inner)
+    if isinstance(pattern, cst.MatchOr):
+        return any(_is_irrefutable_pattern(item.pattern) for item in pattern.patterns)
+    return False
+
+
+def _is_irrefutable_case(case: cst.MatchCase) -> bool:
+    return case.guard is None and _is_irrefutable_pattern(case.pattern)
+
+
+def _loop_enters_body(node: Union[cst.While, cst.For]) -> bool:
+    return not isinstance(node, cst.While) or _constant_truth(node.test) is not False
+
+
+def _loop_repeats_forever(node: Union[cst.While, cst.For]) -> bool:
+    return isinstance(node, cst.While) and _constant_truth(node.test) is True
+
+
+def _exits_of_small_statement(node: cst.BaseSmallStatement) -> FrozenSet[ExitKind]:
+    if isinstance(node, cst.Return):
+        return frozenset({ExitKind.RETURN})
+    if isinstance(node, cst.Raise):
+        return frozenset({ExitKind.RAISE})
+    if isinstance(node, cst.Break):
+        return frozenset({ExitKind.BREAK})
+    if isinstance(node, cst.Continue):
+        return frozenset({ExitKind.CONTINUE})
+    return _FALL_THROUGH
+
+
+def _sequence_exits(
+    exits_per_item: Sequence[FrozenSet[ExitKind]],
+) -> FrozenSet[ExitKind]:
+    reached: FrozenSet[ExitKind] = _FALL_THROUGH
+    for item in exits_per_item:
+        if ExitKind.FALL_THROUGH not in reached:
+            break
+        reached = (reached - _FALL_THROUGH) | item
+    return reached
+
+
+class ControlFlowProvider(VisitorMetadataProvider[ControlFlowInfo]):
+    """
+    Provides :class:`ControlFlowInfo` for every statement and small statement,
+    describing whether the statement is reachable and how control can leave it.
+    """
+
+    def _gen_impl(self, module: cst.Module) -> None:
+        self._visit_block(module.body, True)
+
+    def _record(
+        self, node: AnyStatement, reachable: bool, exits: FrozenSet[ExitKind]
+    ) -> FrozenSet[ExitKind]:
+        self.set_metadata(node, ControlFlowInfo(reachable, exits))
+        return exits
+
+    def _visit_block(
+        self, statements: Sequence[AnyStatement], reachable: bool
+    ) -> FrozenSet[ExitKind]:
+        collected: List[FrozenSet[ExitKind]] = []
+        running = reachable
+        for statement in statements:
+            exits = self._visit(statement, running)
+            collected.append(exits)
+            running = running and ExitKind.FALL_THROUGH in exits
+        return _sequence_exits(collected)
+
+    def _visit_suite(
+        self, suite: cst.BaseSuite, reachable: bool
+    ) -> FrozenSet[ExitKind]:
+        return self._visit_block(suite.body, reachable)
+
+    def _visit(self, node: AnyStatement, reachable: bool) -> FrozenSet[ExitKind]:
+        return self._record(node, reachable, self._exits_of(node, reachable))
+
+    def _exits_of(self, node: AnyStatement, reachable: bool) -> FrozenSet[ExitKind]:
+        if isinstance(node, cst.BaseSmallStatement):
+            return _exits_of_small_statement(node)
+        if isinstance(node, cst.SimpleStatementLine):
+            return self._visit_block(node.body, reachable)
+        if isinstance(node, cst.If):
+            return self._exits_of_if(node, reachable)
+        if isinstance(node, (cst.While, cst.For)):
+            return self._exits_of_loop(node, reachable)
+        if isinstance(node, (cst.Try, cst.TryStar)):
+            return self._exits_of_try(node, reachable)
+        if isinstance(node, cst.With):
+            return self._visit_suite(node.body, reachable)
+        if isinstance(node, cst.Match):
+            return self._exits_of_match(node, reachable)
+        if isinstance(node, (cst.FunctionDef, cst.ClassDef)):
+            self._visit_suite(node.body, True)
+        return _FALL_THROUGH
+
+    def _exits_of_if(self, node: cst.If, reachable: bool) -> FrozenSet[ExitKind]:
+        taken = _constant_truth(node.test)
+        body_exits = self._visit_suite(node.body, reachable and taken is not False)
+        orelse = node.orelse
+        tail_reachable = reachable and taken is not True
+        if orelse is None:
+            tail_exits = _FALL_THROUGH
+        elif isinstance(orelse, cst.If):
+            tail_exits = self._visit(orelse, tail_reachable)
+        else:
+            tail_exits = self._visit_suite(orelse.body, tail_reachable)
+        if taken is True:
+            return body_exits
+        if taken is False:
+            return tail_exits
+        return body_exits | tail_exits
+
+    def _exits_of_loop(
+        self, node: Union[cst.While, cst.For], reachable: bool
+    ) -> FrozenSet[ExitKind]:
+        enters = _loop_enters_body(node)
+        completes = not _loop_repeats_forever(node)
+        body_exits = self._visit_suite(node.body, reachable and enters)
+        orelse = node.orelse
+        after = (
+            _FALL_THROUGH
+            if orelse is None
+            else self._visit_suite(orelse.body, reachable and completes)
+        )
+        if not enters:
+            return after
+        exits = body_exits - _LOOP_ABSORBED
+        if ExitKind.BREAK in body_exits:
+            exits = exits | _FALL_THROUGH
+        if completes:
+            exits = exits | after
+        return exits
+
+    def _exits_of_try(
+        self, node: Union[cst.Try, cst.TryStar], reachable: bool
+    ) -> FrozenSet[ExitKind]:
+        protected = self._visit_suite(node.body, reachable)
+        orelse = node.orelse
+        if orelse is not None:
+            body_falls = ExitKind.FALL_THROUGH in protected
+            protected = _sequence_exits(
+                [protected, self._visit_suite(orelse.body, reachable and body_falls)]
+            )
+        guarded = protected
+        for handler in node.handlers:
+            guarded = guarded | self._visit_suite(handler.body, reachable)
+        finalbody = node.finalbody
+        if finalbody is None:
+            return guarded
+        final_exits = self._visit_suite(finalbody.body, reachable)
+        if ExitKind.FALL_THROUGH not in final_exits:
+            return final_exits
+        return guarded | (final_exits - _FALL_THROUGH)
+
+    def _exits_of_match(self, node: cst.Match, reachable: bool) -> FrozenSet[ExitKind]:
+        exits: FrozenSet[ExitKind] = frozenset()
+        for case in node.cases:
+            exits = exits | self._visit_suite(case.body, reachable)
+        if not any(_is_irrefutable_case(case) for case in node.cases):
+            exits = exits | _FALL_THROUGH
+        return exits
