+class _Collector(cst.CSTVisitor):
+    def __init__(self) -> None:
+        super().__init__()
+        self.found: List[Statement] = []
+
+    def on_visit(self, node: cst.CSTNode) -> bool:
+        if isinstance(node, (cst.BaseStatement, cst.BaseSmallStatement)):
+            self.found.append(node)
+        return True
+
+
+def _render(node: Statement) -> str:
+    if isinstance(node, cst.BaseSmallStatement):
+        line = cst.SimpleStatementLine(
+            body=[node.with_changes(semicolon=cst.MaybeSentinel.DEFAULT)]
+        )
+        return cst.Module(body=[line]).code.strip()
+    return cst.Module(body=[node]).code.strip().splitlines()[0].strip()
+
