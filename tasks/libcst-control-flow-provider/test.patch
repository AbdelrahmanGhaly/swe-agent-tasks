+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/results.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd /app
+
+NEW_PROVIDER_TESTS="libcst/metadata/tests/test_control_flow_provider_6d6cdd.py"
+NEW_CODEMOD_TESTS="libcst/codemod/visitors/tests/test_remove_unreachable_code_6d6cdd.py"
+PYTEST_LOG="$(mktemp)"
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_PROVIDER_TESTS" "$NEW_CODEMOD_TESTS" \
+    -p no:randomly --junitxml="$OUTPUT_PATH" -q 2>&1 | tee "$PYTEST_LOG"
+  EXIT_CODE=$?
+else
+  # test_gen_cache_0 shells out to `pyre query`, which needs a running Pyre
+  # type-checker server. That server starts as root but not as an unprivileged
+  # user, so the test is environment-dependent and unrelated to this change.
+  PYRE_SERVER_TEST="libcst/metadata/tests/test_type_inference_provider.py::TypeInferenceProviderTest::test_gen_cache_0"
+  python -m pytest libcst \
+    --ignore="$NEW_PROVIDER_TESTS" \
+    --ignore="$NEW_CODEMOD_TESTS" \
+    --deselect "$PYRE_SERVER_TEST" \
+    -p no:randomly --junitxml="$OUTPUT_PATH" -q 2>&1 | tee "$PYTEST_LOG"
+  EXIT_CODE=$?
+fi
+
+if [ ! -f "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  DETAIL="$(tail -n 80 "$PYTEST_LOG" 2>/dev/null \
+    | tr -d '\000-\010\013\014\016-\037' \
+    | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+  if [ -z "$DETAIL" ]; then
+    DETAIL="pytest produced no test cases and no output."
+  fi
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo '<testsuites>'
+    echo '  <testsuite name="pytest" tests="1" failures="1" errors="0" time="0">'
+    echo '    <testcase name="collection" classname="pytest">'
+    echo "      <failure message=\"pytest produced no test cases (exit $EXIT_CODE)\">"
+    echo "$DETAIL"
+    echo '      </failure>'
+    echo '    </testcase>'
+    echo '  </testsuite>'
+    echo '</testsuites>'
+  } > "$OUTPUT_PATH"
+fi
+
+rm -f "$PYTEST_LOG"
+exit $EXIT_CODE
