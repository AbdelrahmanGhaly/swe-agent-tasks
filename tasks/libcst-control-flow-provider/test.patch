+        return module, wrapper.resolve(_provider())
+
+    def facts(self, code: str) -> List[Tuple[str, object]]:
+        module, info = self.resolved(code)
+        collector = _Collector()
+        module.visit(collector)
+        return [(_render(n), info[n]) for n in collector.found if n in info]
