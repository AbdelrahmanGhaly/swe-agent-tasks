+from textwrap import dedent
+
+import libcst as cst
+from libcst.codemod import CodemodContext
+from libcst.testing.utils import UnitTest
+
+
+class TestRemoveUnreachableCodeCodemod(UnitTest):
+    def run_codemod(self, before: str) -> str:
+        from libcst.codemod.visitors import RemoveUnreachableCodeVisitor
+
+        transform = RemoveUnreachableCodeVisitor(CodemodContext())
+        source = dedent(before).strip() + "\n"
+        result = transform.transform_module(cst.parse_module(source)).code
+        cst.parse_module(result)
+        return result
+
+    def assertCodemod(self, before: str, after: str) -> None:
+        self.assertEqual(self.run_codemod(before), dedent(after).strip() + "\n")
+
+    def test_noop_when_everything_is_reachable(self) -> None:
+        before = """
+            def foo() -> None:
+                x = 1
+                return x
+        """
+        after = """
+            def foo() -> None:
+                x = 1
+                return x
+        """
+        self.assertCodemod(before, after)
+
+    def test_removes_statement_after_return(self) -> None:
+        before = """
