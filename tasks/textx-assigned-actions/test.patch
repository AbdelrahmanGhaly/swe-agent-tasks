+def test_grammar_without_any_action_keeps_its_behavior():
+    grammar = r"""
+    Model: 'model' items*=Item uses*=Use;
+    Item: Group | Entry;
+    Group: 'group' name=ID '{' entries+=Entry[','] '}';
+    Entry: 'entry' name=ID ('=' value=Value)? tags*=Tag;
+    Value: INT | STRING;
+    Tag: '#' label=ID;
+    Use: 'use' ref=[Entry];
+    """
+    text = 'model group g { entry a = 1 #x #y, entry b } entry c = "s" use b use c'
+    order = []
+
+    class Group:
+        def __init__(self, parent, name, entries):
+            self.parent = parent
+            self.name = name
+            self.entries = entries
+            order.append(name)
+
+    class Entry:
+        def __init__(self, parent, name, value, tags):
+            self.parent = parent
+            self.name = name
+            self.value = value
+            self.tags = tags
+            order.append(name)
+
+    mm = metamodel_from_str(grammar)
+    assert mm["Item"]._tx_type == "abstract"
+    assert mm["Group"]._tx_type == "common"
+    assert mm["Entry"]._tx_type == "common"
+    assert mm["Value"]._tx_type == "match"
+
+    model = mm.model_from_str(text)
+    group, c = model.items
+    a, b = group.entries
+    assert (type(group).__name__, type(c).__name__) == ("Group", "Entry")
+    assert group.parent is model
+    assert a.parent is group
+    assert (a.value, b.value, c.value) == (1, None, "s")
+    assert [t.label for t in a.tags] == ["x", "y"]
+    assert b.tags == []
+    assert a.tags[0].parent is a
+    assert span(text, group) == "group g { entry a = 1 #x #y, entry b }"
+    assert span(text, a) == "entry a = 1 #x #y"
+    assert model.uses[0].ref is b
+    assert model.uses[1].ref is c
+    assert [e.name for e in get_children_of_type("Entry", model)] == ["a", "b", "c"]
+
+    user_model = metamodel_from_str(grammar, classes=[Group, Entry]).model_from_str(text)
+    assert order == ["a", "b", "g", "c"]
+    assert user_model.uses[0].ref is user_model.items[0].entries[1]
+
+    processed_mm = metamodel_from_str(grammar)
+    processed_mm.register_obj_processors({"Tag": lambda t: t.label.upper()})
+    processed = processed_mm.model_from_str(text)
+    assert processed.items[0].entries[0].tags == ["X", "Y"]
+
+    config_mm = metamodel_from_str(
+        r"""
+        Config: 'config' name=ID settings*=Setting flags=Flags;
+        Setting: Toggle | Choice;
+        Toggle: 'toggle' name=ID enabled?='on';
+        Choice: 'choice' name=ID '=' options+=Option[','] ('default' default=[Toggle])?;
+        Option: /[a-z]+/;
+        Flags: (fast?='fast' safe?='safe' level=INT)#;
+        """
+    )
+    config_text = (
+        "config app toggle t1 on toggle t2 choice c = x, y, zz default t2 3 safe fast"
+    )
+    config = config_mm.model_from_str(config_text)
+    t1, t2, choice = config.settings
+    assert [type(s).__name__ for s in config.settings] == ["Toggle", "Toggle", "Choice"]
+    assert (t1.enabled, t2.enabled) == (True, False)
+    assert choice.options == ["x", "y", "zz"]
+    assert choice.default is t2
+    assert choice.parent is config
+    assert (config.flags.fast, config.flags.safe, config.flags.level) == (True, True, 3)
+    assert span(config_text, choice) == "choice c = x, y, zz default t2"
+    assert [t.name for t in get_children_of_type("Toggle", config)] == ["t1", "t2"]
+    other = config_mm.model_from_str("config b choice d = q 0 fast safe")
+    assert other.settings[0].default is None
+    assert other.flags.level == 0
+
+    for invalid in (
+        "Model: a=ID a?='x';",
+        "Model: a='y' a?='x';",
+        "Model: a+=ID a?='x';",
+        "Model: a?='x' a?='y';",
+    ):
+        with pytest.raises(TextXSemanticError):
+            metamodel_from_str(invalid)
+
+    grammar_model = metamodel_for_language("textx").grammar_model_from_str(grammar)
+    expressions = get_children_of_type("Expression", grammar_model)
+    assert expressions
+    assert all(expression.action is None for expression in expressions)
+
