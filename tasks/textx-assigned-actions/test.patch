+def test_optional_action_inside_repetition_keeps_repeated_attribute_a_list():
+    grammar = r"""
+    Text: sentences+=Sentence;
+    Sentence: (words=ID ({Clause.previous=current} ',')?)+ '.';
+    """
+    model = metamodel_from_str(grammar).model_from_str("a b, c d, e. f g.")
+    first, second = model.sentences
+    assert first.__class__.__name__ == "Clause"
+    assert first.words == ["e"]
+    assert first.previous.words == ["c", "d"]
+    assert first.previous.__class__.__name__ == "Clause"
+    assert first.previous.previous.__class__.__name__ == "Sentence"
+    assert first.previous.previous.words == ["a", "b"]
+    assert second.__class__.__name__ == "Sentence"
+    assert second.words == ["f", "g"]
+
