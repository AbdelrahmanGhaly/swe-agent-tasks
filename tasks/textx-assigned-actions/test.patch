+def test_action_classes_get_exactly_the_attributes_their_objects_receive():
+    def attributes(cls):
+        return {
+            name: (attr.mult in (MULT_ZEROORMORE, MULT_ONEORMORE), attr.cont)
+            for name, attr in cls._tx_attrs.items()
+        }
+
+    single = (False, True)
+    many = (True, True)
+
+    calc = calc_mm()
+    assert attributes(calc["Sum"]) == {}
+    assert attributes(calc["Product"]) == {}
+    assert attributes(calc["Add"]) == {"left": single, "right": single}
+    assert attributes(calc["Sub"]) == {"left": single, "right": single}
+    assert attributes(calc["Binary"]) == {"left": single, "op": single, "right": single}
+
+    path = metamodel_from_str(PATH_GRAMMAR)
+    assert attributes(path["Path"]) == {"name": single, "prefix": single}
+
+    call = metamodel_from_str(CALL_GRAMMAR)
+    assert attributes(call["Call"]) == {}
+    assert attributes(call["Invocation"]) == {"callee": single, "args": many}
+
+    tuple_mm = metamodel_from_str(TUPLE_GRAMMAR)
+    assert attributes(tuple_mm["Expr"]) == {}
+    assert attributes(tuple_mm["Tuple"]) == {"items": many}
+
+    decl = metamodel_from_str(DECL_GRAMMAR)
+    assert attributes(decl["Declaration"]) == {}
+    assert attributes(decl["VarDecl"]) == {"name": single}
+    assert attributes(decl["ConstDecl"]) == {"name": single, "value": single}
