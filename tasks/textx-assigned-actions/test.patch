+def test_action_naming_another_existing_rule_uses_that_class():
+    grammar = r"""
+    Model: chains+=Chain[','];
+    Chain: Item ({Item.previous=current} '->' label=ID)*;
+    Item: label=ID;
+    """
+    mm = metamodel_from_str(grammar)
+    model = mm.model_from_str("a -> b -> c, d")
+    c, d = model.chains
+    assert type(c) is mm["Item"]
+    assert c.label == "c"
+    assert c.previous.label == "b"
+    assert type(c.previous.previous) is mm["Item"]
+    assert c.previous.previous.label == "a"
+    assert c.previous.previous.previous is None
+    assert d.label == "d"
+    assert d.previous is None
+
