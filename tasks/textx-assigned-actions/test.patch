+def test_rule_object_does_not_get_attributes_only_action_objects_receive():
+    class Bound:
+        def __init__(self, parent, value, unit):
+            self.parent = parent
+            self.value = value
+            self.unit = unit
+
+    grammar = r"""
+    Model: bounds+=Bound[','];
+    Bound: value=INT ({Range.low=current} '..' high=INT)? unit=ID;
+    """
+    mm = metamodel_from_str(grammar, classes=[Bound])
+    model = mm.model_from_str("5 m, 1..3 s")
+    single, rng = model.bounds
+    assert isinstance(single, Bound)
+    assert (single.value, single.unit) == (5, "m")
+    assert rng.__class__.__name__ == "Range"
+    assert isinstance(rng.low, Bound)
+    assert (rng.low.value, rng.high, rng.unit) == (1, 3, "s")
+    assert not hasattr(rng, "value")
+    assert textx_isinstance(rng, mm["Bound"])
