+        def builds(rule):
+            if isinstance(rule, RuleCrossRef):
+                return self._rule_builds_object(metamodel, rule.rule_name, visited)
+            if isinstance(rule, Action) or rule.rule_name.startswith("__asgn"):
+                return True
+            return any(builds(n) for n in rule.nodes)
