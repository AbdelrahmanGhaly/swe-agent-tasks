+    def _handover_cls(self, rule_cls, handed_over, has_own_attrs, self_target):
+        """
+        Returns the type of an action attribute from the objects that may be
+        current when the action is reached. `None` stands for the rule's own
+        object, a class for an object created by an earlier action and a rule
+        name for the result of that called rule, which is the rule's own object
+        when the rule has assignments of its own. Several types give the rule
+        when all of them are the rule or inherit from it, as called rules and
+        classes created by the rule's actions do, and OBJECT otherwise.
+        """
+        types = {}
+        for current in handed_over:
+            if current is None or (has_own_attrs and isinstance(current, str)):
+                current = rule_cls
+            types[current if isinstance(current, str) else current.__name__] = current
+        if len(types) == 1:
+            current = next(iter(types.values()))
+            if isinstance(current, str):
+                return ClassCrossRef(current, rule_cls._tx_position)
+            return current
+        values = {
+            name
+            for name, current in types.items()
+            if isinstance(current, str)
+            and not self._rule_builds_object(self.metamodel, name, set())
