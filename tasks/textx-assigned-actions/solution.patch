+    def _resolve_actions(self, metamodel):
+        """
+        Creates or finds the classes of grammar actions and moves assigned
+        attributes to the classes whose objects receive them.
+        """
+        # The attributes a rule assigns to its own object decide its rule
+        # type, so attributes added by actions must not change it.
+        for cls in metamodel:
+            if cls._tx_parse_attrs is None:
+                cls._tx_parse_attrs = set(cls._tx_attrs)
+
+        for actions in self._rule_actions.values():
+            for action in actions:
+                action.cls = self._action_class(metamodel, action)
+                action.cls._tx_created_by_actions = True
