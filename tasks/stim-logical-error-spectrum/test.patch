+        model += "error(0.1) D" + std::to_string(a) + " D" + std::to_string(a + 1) + "\n";
+        model += "error(0.1) D" + std::to_string(a + 1) + " D" + std::to_string(a + 3) + "\n";
+        model += "error(0.1) D" + std::to_string(a) + " D" + std::to_string(a + 2) + "\n";
+        model += "error(0.1) D" + std::to_string(a + 2) + " D" + std::to_string(a + 3) + "\n";
+    }
+    model += "error(0.1) D192\n";
+    ASSERT_EQ(
+        trim(run_captured_stim_main({"shortest_errors"}, model)),
+        trim(R"output(
+distance 130
+multiplicity 18446744073709551616
+L0 130 18446744073709551616
+)output"));
+}
+
+TEST(shortest_errors, reports_a_model_with_many_observables) {
+    std::string model;
+    std::string expected = "distance 2\nmultiplicity 435\n";
+    for (int k = 0; k < 30; k++) {
+        model += "error(0.1) D0 D1 L" + std::to_string(k) + "\n";
+        expected += "L" + std::to_string(k) + " 2 29\n";
+    }
+    ASSERT_EQ(trim(run_captured_stim_main({"shortest_errors"}, model)), trim(expected));
+}
+
+TEST(shortest_errors, reports_an_observable_past_a_thirty_two_bit_mask) {
+    std::string expected = "distance 3\nmultiplicity 1\nL0 3 1\n";
+    for (int k = 1; k < 32; k++) {
+        expected += "L" + std::to_string(k) + " none 0\n";
+    }
+    expected += "L32 3 1\n";
+    ASSERT_EQ(
+        trim(run_captured_stim_main({"shortest_errors"}, R"input(
+            error(0.1) D0 L0
+            error(0.1) D1 L32
+            error(0.1) D0 D1
+        )input")),
+        trim(expected));
+}
+
+TEST(shortest_errors, reports_an_observable_past_a_sixty_four_bit_mask) {
+    std::string expected = "distance 2\nmultiplicity 1\n";
+    for (int k = 0; k < 64; k++) {
+        expected += "L" + std::to_string(k) + " none 0\n";
+    }
+    expected += "L64 2 1\n";
+    ASSERT_EQ(
+        trim(run_captured_stim_main({"shortest_errors"}, R"input(
+            error(0.1) D0 L64
+            error(0.1) D0
+        )input")),
+        trim(expected));
+}
+
+TEST(shortest_errors, list_orders_a_shorter_detector_list_first) {
+    ASSERT_EQ(
+        trim(run_captured_stim_main({"shortest_errors", "--list"}, R"input(
+            error(0.1) D0 D1
+            error(0.1) D0 L0
+            error(0.1) D1
+        )input")),
+        trim(R"output(
+distance 3
+multiplicity 1
+L0 3 1
+
+error(1) D0 L0
+error(1) D0 D1
+error(1) D1
+)output"));
+}
+
+TEST(shortest_errors, observable_target_order_does_not_change_identity) {
+    ASSERT_EQ(
+        trim(run_captured_stim_main({"shortest_errors", "--list"}, R"input(
+            error(0.1) D0 L1 L0
+            error(0.1) D0 L0 L1
+            error(0.1) D0
+        )input")),
+        trim(R"output(
+distance 2
+multiplicity 1
+L0 2 1
+L1 2 1
+
+error(1) D0
+error(1) D0 L0 L1
+)output"));
+}
+
+TEST(shortest_errors, instruction_tags_do_not_change_identity) {
+    ASSERT_EQ(
+        trim(run_captured_stim_main({"shortest_errors", "--list"}, R"input(
+            error[first](0.1) D0 L0
+            error[second](0.1) D0 L0
+            error(0.1) D0
+        )input")),
+        trim(R"output(
+distance 2
+multiplicity 1
+L0 2 1
+
+error(1) D0
+error(1) D0 L0
+)output"));
+}
+
+TEST(shortest_errors, three_repeats_of_a_target_leave_it_in_place) {
+    ASSERT_EQ(
+        trim(run_captured_stim_main({"shortest_errors", "--list"}, R"input(
+            error(0.1) D0 D0 D0 D1 L0
+            error(0.1) D0 D1
+        )input")),
+        trim(R"output(
+distance 2
+multiplicity 1
+L0 2 1
+
+error(1) D0 D1
+error(1) D0 D1 L0
+)output"));
+}
+
+TEST(shortest_errors, three_repeats_of_an_observable_leave_it_in_place) {
+    ASSERT_EQ(
+        trim(run_captured_stim_main({"shortest_errors", "--list"}, R"input(
+            error(0.1) D0 L0 L0 L0
+            error(0.1) D0
+        )input")),
+        trim(R"output(
+distance 2
+multiplicity 1
+L0 2 1
+
+error(1) D0
+error(1) D0 L0
+)output"));
+}
+
+TEST(shortest_errors, in_and_out_and_list_work_together) {
+    RaiiTempNamedFile model_file("error(0.1) D0 L0\nerror(0.1) D0\n");
+    RaiiTempNamedFile out_file;
+    ASSERT_EQ(
+        run_captured_stim_main(
+            {"shortest_errors", "--list", "--in", model_file.path.c_str(), "--out",
+             out_file.path.c_str()}),
+        "");
+    ASSERT_EQ(
+        trim(out_file.read_contents()),
+        trim(R"output(
+distance 2
+multiplicity 1
+L0 2 1
+
+error(1) D0
+error(1) D0 L0
+)output"));
+}
+
+TEST(shortest_errors, out_file_does_not_also_write_to_stdout) {
+    RaiiTempNamedFile out_file;
+    ASSERT_EQ(
+        run_captured_stim_main({"shortest_errors", "--out", out_file.path.c_str()}, "error(0.1) L0"), "");
+    ASSERT_EQ(
+        trim(out_file.read_contents()),
+        trim(R"output(
+distance 1
+multiplicity 1
+L0 1 1
+)output"));
+}
+
+static int run_shortest_errors_flag(const char *flag, const char *model_path, std::string &said) {
+    std::vector<const char *> args{"[program]", "shortest_errors", flag, "--in", model_path};
+    testing::internal::CaptureStdout();
+    testing::internal::CaptureStderr();
+    int result;
+    try {
+        result = stim::main((int)args.size(), args.data());
+    } catch (const std::exception &) {
+        result = EXIT_FAILURE;
+    }
+    said = testing::internal::GetCapturedStdout() + testing::internal::GetCapturedStderr();
+    return result;
+}
+
+TEST(shortest_errors, rejects_unknown_flags) {
+    RaiiTempNamedFile model_file("error(0.1) L0\n");
+    std::vector<const char *> rejected{
+        "--not_a_flag", "--lists", "--observable", "--nope=1", "--in_file=x", "-l"};
+    for (const char *flag : rejected) {
+        std::string said;
+        int result = run_shortest_errors_flag(flag, model_file.path.c_str(), said);
+        ASSERT_NE(result, EXIT_SUCCESS) << "flag=" << flag;
+        ASSERT_NE(said.find(flag), std::string::npos) << "flag=" << flag;
+        ASSERT_EQ(said.find("distance"), std::string::npos) << "flag=" << flag;
+    }
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..1ef998c
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,328 @@
+#!/bin/sh
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+cd "$(dirname "$0")" || exit 1
+
+JOBS="$(nproc 2>/dev/null || echo 4)"
+if [ "$JOBS" -gt 4 ]; then JOBS=4; fi
+
+# Build from scratch, outside the source tree, every run. Reusing a build tree makes
+# the result depend on file timestamps, and a checkout whose sources are not newer
+# than the objects would silently run a stale binary. ccache keys on content instead,
+# so discarding the tree costs cache lookups rather than compiles. The directory is
+# per mode so a base run and a new run cannot delete each other's tree mid-build.
+BUILD_DIR="${STIM_BUILD_DIR:-/tmp/stim_build_$MODE}"
+rm -rf "$BUILD_DIR"
+cmake -S . -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Release -DSIMD_WIDTH=128 -DCMAKE_CXX_COMPILER_LAUNCHER=ccache >/tmp/stim_cmake.log 2>&1
+cmake --build "$BUILD_DIR" --target stim_test_o3 -j "$JOBS" >/tmp/stim_build.log 2>&1
+BUILD_STATUS=$?
+
+BIN="$BUILD_DIR/out/stim_test_o3"
+
+if [ $BUILD_STATUS -ne 0 ] || [ ! -x "$BIN" ]; then
+  echo "build failed"
+  tail -n 40 /tmp/stim_cmake.log
+  tail -n 60 /tmp/stim_build.log
+  if [ -n "$OUTPUT_PATH" ]; then
+    python3 - "$OUTPUT_PATH" /tmp/stim_cmake.log /tmp/stim_build.log <<'PYEOF'
+import sys, xml.etree.ElementTree as ET
+
+out_path, cmake_log, build_log = sys.argv[1:4]
+
+
+def tail(path, lines=40):
+    try:
+        with open(path, errors="replace") as f:
+            return "".join(f.readlines()[-lines:])
+    except OSError:
+        return ""
+
+
+detail = "The stim_test_o3 binary did not build.\n\n"
+detail += "--- configure ---\n" + tail(cmake_log)
+detail += "\n--- compile ---\n" + tail(build_log)
+
+root = ET.Element("testsuites", {"name": "AllTests"})
+suite = ET.SubElement(root, "testsuite", {"name": "shortest_errors"})
+case = ET.SubElement(
+    suite, "testcase", {"name": "build_test_binary", "classname": "shortest_errors", "status": "run", "time": "0"})
+failure = ET.SubElement(case, "failure", {"message": "Build failed"})
+failure.text = detail
+for node in (root, suite):
+    node.set("tests", "1")
+    node.set("failures", "1")
+    node.set("errors", "0")
+    node.set("time", "0")
+ET.ElementTree(root).write(out_path, encoding="UTF-8", xml_declaration=True)
+PYEOF
+    if [ ! -s "$OUTPUT_PATH" ]; then
+      cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites name="AllTests" tests="1" failures="1" errors="0" time="0">
+<testsuite name="shortest_errors" tests="1" failures="1" errors="0" time="0">
+<testcase name="build_test_binary" classname="shortest_errors" time="0">
+<failure message="Build failed">The stim_test_o3 binary did not build.</failure>
+</testcase>
+</testsuite>
+</testsuites>
+XMLEOF
+    fi
+  fi
+  exit 1
+fi
+
+if [ "$MODE" != "new" ]; then
+  if [ -n "$OUTPUT_PATH" ]; then
+    "$BIN" --gtest_filter="-shortest_errors.*" --gtest_output="xml:$OUTPUT_PATH"
+  else
+    "$BIN" --gtest_filter="-shortest_errors.*"
+  fi
+  exit $?
+fi
+
+# Two cases use models an implementation can answer only by counting rather than by
+# building: one whose exact answer needs more than 64 bits, one carrying many
+# observables. An implementation that expands either one runs away, so each runs in
+# its own process under a cap on the memory it may hold, the processor time it may
+# spend and the time it may take. That costs it that one case instead of taking the
+# rest of the run down with it. Counting answers both in milliseconds, so the caps
+# are far above anything a working implementation needs.
+HEAVY_LIST="shortest_errors.multiplicity_exceeds_a_sixty_four_bit_counter shortest_errors.reports_a_model_with_many_observables"
+HEAVY_FILTER="shortest_errors.multiplicity_exceeds_a_sixty_four_bit_counter:shortest_errors.reports_a_model_with_many_observables"
+HEAVY_CPU_SECONDS=90
+HEAVY_CPU_CEILING=120
+HEAVY_WALL_SECONDS=150
+
+# The rest of the cases use models small enough to answer in milliseconds, so they get
+# a clock too, set far enough above that to never reach it. It is here so that a run
+# which somehow does not come back costs its own report rather than the whole
+# invocation, which is what takes the existing suite's results down with it.
+MAIN_WALL_SECONDS=480
+if command -v timeout >/dev/null 2>&1; then
+  HEAVY_CLOCK="timeout -k 5 $HEAVY_WALL_SECONDS"
+  MAIN_CLOCK="timeout -k 5 $MAIN_WALL_SECONDS"
+else
+  HEAVY_CLOCK=""
+  MAIN_CLOCK=""
+fi
+
+MAIN_XML=/tmp/stim_new_main.xml
+MAIN_LOG=/tmp/stim_new_main.log
+MERGE_PY=/tmp/stim_new_merge.py
+rm -f "$MAIN_XML" "$MAIN_LOG"
+for H in $HEAVY_LIST; do
+  SAFE=$(echo "$H" | tr '.' '_')
+  rm -f "/tmp/stim_new_$SAFE.xml" "/tmp/stim_new_$SAFE.log" "/tmp/stim_new_$SAFE.status"
+done
+
+cat > "$MERGE_PY" <<'PYEOF'
+import sys, xml.etree.ElementTree as ET
+
+out_path, main_path, main_log = sys.argv[1:4]
+main_status = int(sys.argv[4])
+heavy_names = sys.argv[5:]
+
+
+def load(path):
+    try:
+        return ET.parse(path).getroot()
+    except Exception:
+        return None
+
+
+def read(path, lines=30):
+    try:
+        with open(path, errors="replace") as f:
+            return "".join(f.readlines()[-lines:])
+    except OSError:
+        return ""
+
+
+def failing_case(suite_name, name, message, detail):
+    case = ET.Element(
+        "testcase", {"name": name, "classname": suite_name, "status": "run", "time": "0"})
+    failure = ET.SubElement(case, "failure", {"message": message})
+    failure.text = detail
+    return case
+
+
+def tally(node):
+    tests = failures = 0
+    for suite in node.iter("testsuite"):
+        for case in suite.iter("testcase"):
+            tests += 1
+            failures += len(case.findall("failure")) + len(case.findall("error"))
+    return tests, failures
+
+
+def status_of(safe):
+    try:
+        with open("/tmp/stim_new_" + safe + ".status") as f:
+            return int(f.read().strip())
+    except (OSError, ValueError):
+        return None
+
+
+# Every run here is held to a clock, a processor-time budget and a memory cap, and each
+# guard leaves its own status behind. Reporting which budget ran out is more use than
+# reporting only that nothing came back.
+def ran_out_of(status):
+    if status is None:
+        return "It had not finished when this report was written."
+    if status == 124:
+        return "It took longer than the time it was allowed and was stopped (status 124)."
+    if status == 152:
+        return "It spent more processor time than it was allowed and was stopped (status 152)."
+    if status == 137:
+        return "It was killed outright (status 137), which is what running past the " \
+            "processor-time ceiling or the memory cap looks like."
+    return "That process exited with status " + str(status) + "."
+
+
+suite_name = heavy_names[0].split(".", 1)[0] if heavy_names else "shortest_errors"
+
+# An exit status is evidence in its own right. A process that died before writing a
+# report, or that failed while its report claims otherwise, has to surface as a
+# failure rather than as an absence.
+root = load(main_path)
+extra = []
+if root is None:
+    root = ET.Element("testsuites", {"name": "AllTests"})
+    extra.append(
+        failing_case(
+            suite_name,
+            "main_test_process",
+            "the rest of the suite produced no readable report",
+            "That process wrote no report that could be read. "
+            + ran_out_of(main_status) + "\n\n" + read(main_log)))
+else:
+    seen, failed = tally(root)
+    if seen == 0:
+        extra.append(
+            failing_case(
+                suite_name,
+                "main_test_process",
+                "the rest of the suite reported no tests",
+                "That process exited with status " + str(main_status)
+                + " and its report listed no test at all.\n\n" + read(main_log)))
+    elif main_status != 0 and failed == 0:
+        extra.append(
+            failing_case(
+                suite_name,
+                "main_test_process",
+                "the rest of the suite failed without recording a failure",
+                "That process exited with status " + str(main_status)
+                + " while its report listed no failure.\n\n" + read(main_log)))
+
+for name in heavy_names:
+    short = name.split(".", 1)[1]
+    safe = name.replace(".", "_")
+    result = load("/tmp/stim_new_" + safe + ".xml")
+    cases = []
+    if result is not None:
+        cases = [c for s in result.iter("testsuite") for c in s.iter("testcase")]
+    log = read("/tmp/stim_new_" + safe + ".log")
+    status = status_of(safe)
+    if not cases:
+        extra.append(
+            failing_case(
+                suite_name,
+                short,
+                "test did not complete",
+                "The isolated run of " + name + " produced no result. " + ran_out_of(status)
+                + " That is what happens when the answer is built instead of counted.\n\n" + log))
+        continue
+    extra.extend(cases)
+    if status is None:
+        status = 0
+    marked = sum(len(c.findall("failure")) + len(c.findall("error")) for c in cases)
+    if status != 0 and marked == 0:
+        extra.append(
+            failing_case(
+                suite_name,
+                short + "_process",
+                "the isolated test failed without recording a failure",
+                "That process exited with status " + str(status)
+                + " while its report listed no failure.\n\n" + log))
+
+target = None
+for suite in root.iter("testsuite"):
+    if suite.get("name") == suite_name:
+        target = suite
+        break
+if target is None:
+    target = ET.SubElement(root, "testsuite", {"name": suite_name})
+
+for case in extra:
+    target.append(case)
+
+total_tests = total_failures = total_errors = 0
+for suite in root.iter("testsuite"):
+    tests = failures = errors = 0
+    for case in suite.iter("testcase"):
+        tests += 1
+        failures += len(case.findall("failure"))
+        errors += len(case.findall("error"))
+    suite.set("tests", str(tests))
+    suite.set("failures", str(failures))
+    suite.set("errors", str(errors))
+    total_tests += tests
+    total_failures += failures
+    total_errors += errors
+
+root.set("tests", str(total_tests))
+root.set("failures", str(total_failures))
+root.set("errors", str(total_errors))
+
+ET.ElementTree(root).write(out_path, encoding="UTF-8", xml_declaration=True)
+sys.exit(1 if total_failures or total_errors else 0)
+PYEOF
+
+$MAIN_CLOCK "$BIN" --gtest_filter="shortest_errors.*:-$HEAVY_FILTER" --gtest_output="xml:$MAIN_XML" >"$MAIN_LOG" 2>&1
+MAIN_STATUS=$?
+cat "$MAIN_LOG"
+
+# Publish what the ordinary run produced before the capped runs start. If anything
+# stops this script during those, the report already holds the real per-test results
+# and marks only the unfinished cases as failed.
+if [ -n "$OUTPUT_PATH" ]; then
+  python3 "$MERGE_PY" "$OUTPUT_PATH" "$MAIN_XML" "$MAIN_LOG" "$MAIN_STATUS" $HEAVY_LIST
+fi
+
+HEAVY_FAILED=0
+for H in $HEAVY_LIST; do
+  SAFE=$(echo "$H" | tr '.' '_')
+  (
+    ulimit -v 4194304 2>/dev/null
+    ulimit -H -t "$HEAVY_CPU_CEILING" 2>/dev/null
+    ulimit -S -t "$HEAVY_CPU_SECONDS" 2>/dev/null
+    exec $HEAVY_CLOCK "$BIN" --gtest_filter="$H" --gtest_output="xml:/tmp/stim_new_$SAFE.xml"
+  ) >"/tmp/stim_new_$SAFE.log" 2>&1
+  STATUS=$?
+  echo "$STATUS" > "/tmp/stim_new_$SAFE.status"
+  if [ $STATUS -ne 0 ]; then
+    HEAVY_FAILED=1
+  fi
+  cat "/tmp/stim_new_$SAFE.log"
+done
+
+if [ -z "$OUTPUT_PATH" ]; then
+  [ $MAIN_STATUS -eq 0 ] && [ $HEAVY_FAILED -eq 0 ]
+  exit $?
+fi
+
+python3 "$MERGE_PY" "$OUTPUT_PATH" "$MAIN_XML" "$MAIN_LOG" "$MAIN_STATUS" $HEAVY_LIST
+exit $?
