diff --git a/src/stim/search/graphlike/spectrum.cc b/src/stim/search/graphlike/spectrum.cc
new file mode 100644
index 0000000..ef5d8bc
--- /dev/null
+++ b/src/stim/search/graphlike/spectrum.cc
@@ -0,0 +1,496 @@
+/*
+ * Copyright 2021 Google LLC
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "stim/search/graphlike/spectrum.h"
+
+#include <algorithm>
+#include <iomanip>
+#include <iterator>
+#include <map>
+#include <queue>
+#include <set>
+#include <sstream>
+
+using namespace stim;
+
+namespace {
+
+/// A sorted list of observable indices, used as a parity set.
+using ObsSet = std::vector<uint64_t>;
+
+constexpr uint32_t COUNT_BASE = 1000000000;
+
+/// One graphlike error mechanism: the detectors it flips and the observables it flips.
+struct Mechanism {
+    std::vector<uint64_t> detectors;
+    ObsSet observables;
+
+    bool operator<(const Mechanism &other) const {
+        if (detectors != other.detectors) {
+            return detectors < other.detectors;
+        }
+        return observables < other.observables;
+    }
+    bool operator==(const Mechanism &other) const {
+        return detectors == other.detectors && observables == other.observables;
+    }
+};
+
+/// A mechanism seen from one of its endpoints.
+struct Arc {
+    size_t to;
+    size_t mechanism;
+};
+
+/// The mechanisms viewed as a multigraph whose vertices are the detectors plus one
+/// extra boundary vertex standing in for "no detector".
+struct Incidence {
+    size_t boundary;
+    std::vector<std::vector<Arc>> arcs;
+};
+
+/// How far a partially built error has got, while tracking a single observable.
+struct Progress {
+    std::vector<uint64_t> excitations;
+    bool flipped;
+
+    bool operator<(const Progress &other) const {
+        if (excitations != other.excitations) {
+            return excitations < other.excitations;
+        }
+        return flipped < other.flipped;
+    }
+};
+
+/// Sorts, then drops every value mentioned an even number of times.
+void cancel_repeats(std::vector<uint64_t> &values) {
+    std::sort(values.begin(), values.end());
+    std::vector<uint64_t> kept;
+    size_t k = 0;
+    while (k < values.size()) {
+        size_t run = 1;
+        while (k + run < values.size() && values[k + run] == values[k]) {
+            run++;
+        }
+        if (run % 2 == 1) {
+            kept.push_back(values[k]);
+        }
+        k += run;
+    }
+    values = std::move(kept);
+}
+
+std::vector<uint64_t> symmetric_difference(const std::vector<uint64_t> &a, const std::vector<uint64_t> &b) {
+    std::vector<uint64_t> out;
+    std::set_symmetric_difference(a.begin(), a.end(), b.begin(), b.end(), std::back_inserter(out));
+    return out;
+}
+
+/// Splits every non-zero-probability error instruction on its separators, drops
+/// parts touching more than two detectors, and merges identical parts. Probabilities
+/// take no further part, so the same targets at different probabilities merge too.
+std::vector<Mechanism> collect_mechanisms(const DetectorErrorModel &model) {
+    std::vector<Mechanism> found;
+    model.iter_flatten_error_instructions([&](const DemInstruction &instruction) {
+        if (instruction.arg_data[0] == 0) {
+            return;
+        }
+        Mechanism part;
+        auto flush = [&]() {
+            cancel_repeats(part.detectors);
+            cancel_repeats(part.observables);
+            if (part.detectors.size() <= 2 && !(part.detectors.empty() && part.observables.empty())) {
+                found.push_back(part);
+            }
+            part.detectors.clear();
+            part.observables.clear();
+        };
+        for (const auto &target : instruction.target_data) {
+            if (target.is_separator()) {
+                flush();
+            } else if (target.is_relative_detector_id()) {
+                part.detectors.push_back(target.raw_id());
+            } else if (target.is_observable_id()) {
+                part.observables.push_back(target.raw_id());
+            }
+        }
+        flush();
+    });
+    std::sort(found.begin(), found.end());
+    found.erase(std::unique(found.begin(), found.end()), found.end());
+    return found;
+}
+
+/// The two vertices a mechanism joins. A mechanism naming one detector joins it to
+/// the boundary, and a mechanism naming none is a loop at the boundary.
+std::pair<size_t, size_t> endpoints_of(const Mechanism &mechanism, size_t boundary) {
+    if (mechanism.detectors.size() == 2) {
+        return {(size_t)mechanism.detectors[0], (size_t)mechanism.detectors[1]};
+    }
+    if (mechanism.detectors.size() == 1) {
+        return {(size_t)mechanism.detectors[0], boundary};
+    }
+    return {boundary, boundary};
+}
+
+Incidence build_incidence(const std::vector<Mechanism> &mechanisms, size_t detector_count) {
+    Incidence result;
+    result.boundary = detector_count;
+    result.arcs.resize(detector_count + 1);
+    for (size_t index = 0; index < mechanisms.size(); index++) {
+        auto ends = endpoints_of(mechanisms[index], result.boundary);
+        result.arcs[ends.first].push_back(Arc{ends.second, index});
+        if (ends.first != ends.second) {
+            result.arcs[ends.second].push_back(Arc{ends.first, index});
+        }
+    }
+    return result;
+}
+
+bool flips(const Mechanism &mechanism, uint64_t observable) {
+    return std::binary_search(mechanism.observables.begin(), mechanism.observables.end(), observable);
+}
+
+/// Fewest mechanisms in an undetectable logical error that flips `observable`.
+///
+/// Only the parity of that one observable is tracked, so the states stay proportional
+/// to the detectors instead of growing with two to the power of the observable count,
+/// and the search stops at the first error it reaches instead of closing over
+/// everything reachable.
+size_t weight_flipping_observable(const std::vector<Mechanism> &mechanisms, uint64_t observable) {
+    Progress start;
+    start.flipped = false;
+    std::set<Progress> seen{start};
+    std::vector<Progress> frontier{start};
+
+    for (size_t weight = 1; weight <= mechanisms.size() && !frontier.empty(); weight++) {
+        std::vector<Progress> next_frontier;
+        for (const auto &current : frontier) {
+            for (const auto &mechanism : mechanisms) {
+                Progress next;
+                next.excitations = symmetric_difference(current.excitations, mechanism.detectors);
+                if (next.excitations.size() > 2) {
+                    continue;
+                }
+                next.flipped = current.flipped != flips(mechanism, observable);
+                if (!seen.insert(next).second) {
+                    continue;
+                }
+                if (next.excitations.empty() && next.flipped) {
+                    return weight;
+                }
+                next_frontier.push_back(next);
+            }
+        }
+        frontier = std::move(next_frontier);
+    }
+    return NO_LOGICAL_ERROR;
+}
+
+/// Fewest arcs needed to get from each vertex to `target`, using only mechanisms
+/// after `skip_up_to`. Used to prune the search that builds the errors.
+std::vector<size_t> steps_to_target(const Incidence &incidence, size_t target, size_t skip_up_to) {
+    std::vector<size_t> best(incidence.arcs.size(), NO_LOGICAL_ERROR);
+    best[target] = 0;
+    std::queue<size_t> queue;
+    queue.push(target);
+    while (!queue.empty()) {
+        size_t vertex = queue.front();
+        queue.pop();
+        for (const auto &arc : incidence.arcs[vertex]) {
+            if (arc.mechanism <= skip_up_to || best[arc.to] != NO_LOGICAL_ERROR) {
+                continue;
+            }
+            best[arc.to] = best[vertex] + 1;
+            queue.push(arc.to);
+        }
+    }
+    return best;
+}
+
+/// Counts the walks of exactly `steps` arcs from `from` to `to` that avoid every
+/// mechanism up to `skip_up_to`, grouped by which observables they flip.
+///
+/// A minimum weight undetectable logical error is a simple cycle, so counting these
+/// walks counts those errors without ever building one.
+std::map<ObsSet, LogicalErrorCount> count_walks(
+    const Incidence &incidence,
+    const std::vector<Mechanism> &mechanisms,
+    size_t from,
+    size_t to,
+    size_t steps,
+    size_t skip_up_to) {
+    std::vector<size_t> lower_bound = steps_to_target(incidence, to, skip_up_to);
+    std::map<std::pair<size_t, ObsSet>, LogicalErrorCount> layer;
+    layer[{from, ObsSet{}}] = LogicalErrorCount::one();
+    for (size_t step = 0; step < steps; step++) {
+        std::map<std::pair<size_t, ObsSet>, LogicalErrorCount> next;
+        for (const auto &entry : layer) {
+            for (const auto &arc : incidence.arcs[entry.first.first]) {
+                if (arc.mechanism <= skip_up_to) {
+                    continue;
+                }
+                if (lower_bound[arc.to] == NO_LOGICAL_ERROR || lower_bound[arc.to] > steps - step - 1) {
+                    continue;
+                }
+                ObsSet flipped = symmetric_difference(entry.first.second, mechanisms[arc.mechanism].observables);
+                next[{arc.to, flipped}] += entry.second;
+            }
+        }
+        layer = std::move(next);
+    }
+    std::map<ObsSet, LogicalErrorCount> reached;
+    for (const auto &entry : layer) {
+        if (entry.first.first == to) {
+            reached[entry.first.second] += entry.second;
+        }
+    }
+    return reached;
+}
+
+/// Walks the same space as count_walks, but records each mechanism set it completes.
+/// Only used when the caller asked for the errors themselves.
+void gather_walks(
+    const Incidence &incidence,
+    const std::vector<Mechanism> &mechanisms,
+    size_t current,
+    size_t target,
+    size_t steps_left,
+    size_t skip_up_to,
+    const std::vector<size_t> &lower_bound,
+    ObsSet flipped,
+    const ObsSet &seed_observables,
+    std::vector<size_t> &partial,
+    std::set<std::vector<size_t>> &out) {
+    if (steps_left == 0) {
+        if (current == target && !symmetric_difference(seed_observables, flipped).empty()) {
+            std::vector<size_t> complete = partial;
+            std::sort(complete.begin(), complete.end());
+            out.insert(complete);
+        }
+        return;
+    }
+    if (lower_bound[current] == NO_LOGICAL_ERROR || lower_bound[current] > steps_left) {
+        return;
+    }
+    for (const auto &arc : incidence.arcs[current]) {
+        if (arc.mechanism <= skip_up_to) {
+            continue;
+        }
+        partial.push_back(arc.mechanism);
+        gather_walks(
+            incidence,
+            mechanisms,
+            arc.to,
+            target,
+            steps_left - 1,
+            skip_up_to,
+            lower_bound,
+            symmetric_difference(flipped, mechanisms[arc.mechanism].observables),
+            seed_observables,
+            partial,
+            out);
+        partial.pop_back();
+    }
+}
+
+/// Whether a combined observable set counts, either as "flips anything" or as
+/// "flips this particular observable".
+bool qualifies(const ObsSet &flipped, uint64_t observable, bool restrict_to_observable) {
+    if (restrict_to_observable) {
+        return std::binary_search(flipped.begin(), flipped.end(), observable);
+    }
+    return !flipped.empty();
+}
+
+/// Counts the distinct undetectable logical errors of exactly `weight`, either all of
+/// them or only those flipping `observable`. Counting, never building.
+LogicalErrorCount count_errors(
+    const Incidence &incidence,
+    const std::vector<Mechanism> &mechanisms,
+    size_t weight,
+    uint64_t observable,
+    bool restrict_to_observable) {
+    LogicalErrorCount total;
+    for (size_t index = 0; index < mechanisms.size(); index++) {
+        const Mechanism &seed = mechanisms[index];
+        auto ends = endpoints_of(seed, incidence.boundary);
+        if (ends.first == ends.second) {
+            if (weight == 1 && qualifies(seed.observables, observable, restrict_to_observable)) {
+                total += LogicalErrorCount::one();
+            }
+            continue;
+        }
+        for (const auto &reached :
+             count_walks(incidence, mechanisms, ends.first, ends.second, weight - 1, index)) {
+            ObsSet combined = symmetric_difference(seed.observables, reached.first);
+            if (qualifies(combined, observable, restrict_to_observable)) {
+                total += reached.second;
+            }
+        }
+    }
+    return total;
+}
+
+DetectorErrorModel render(const std::vector<size_t> &indices, const std::vector<Mechanism> &mechanisms) {
+    DetectorErrorModel out;
+    for (size_t index : indices) {
+        const auto &mechanism = mechanisms[index];
+        for (uint64_t detector : mechanism.detectors) {
+            out.target_buf.append_tail(DemTarget::relative_detector_id(detector));
+        }
+        for (uint64_t observable : mechanism.observables) {
+            out.target_buf.append_tail(DemTarget::observable_id(observable));
+        }
+        out.arg_buf.append_tail(1);
+        out.instructions.push_back(
+            DemInstruction{
+                .arg_data = out.arg_buf.commit_tail(),
+                .target_data = out.target_buf.commit_tail(),
+                .tag = "",
+                .type = DemInstructionType::DEM_ERROR,
+            });
+    }
+    return out;
+}
+
+}  // namespace
+
+LogicalErrorCount LogicalErrorCount::one() {
+    LogicalErrorCount result;
+    result.digits.push_back(1);
+    return result;
+}
+
+bool LogicalErrorCount::is_zero() const {
+    return digits.empty();
+}
+
+void LogicalErrorCount::operator+=(const LogicalErrorCount &other) {
+    uint32_t carry = 0;
+    for (size_t k = 0; k < other.digits.size() || carry != 0; k++) {
+        if (k == digits.size()) {
+            digits.push_back(0);
+        }
+        uint64_t sum = (uint64_t)digits[k] + carry;
+        if (k < other.digits.size()) {
+            sum += other.digits[k];
+        }
+        digits[k] = (uint32_t)(sum % COUNT_BASE);
+        carry = (uint32_t)(sum / COUNT_BASE);
+    }
+}
+
+bool LogicalErrorCount::operator==(const LogicalErrorCount &other) const {
+    return digits == other.digits;
+}
+
+bool LogicalErrorCount::operator!=(const LogicalErrorCount &other) const {
+    return !(*this == other);
+}
+
+std::string LogicalErrorCount::str() const {
+    if (digits.empty()) {
+        return "0";
+    }
+    std::stringstream result;
+    result << digits.back();
+    for (size_t k = digits.size() - 1; k-- > 0;) {
+        result << std::setw(9) << std::setfill('0') << digits[k];
+    }
+    return result.str();
+}
+
+std::ostream &stim::operator<<(std::ostream &out, const LogicalErrorCount &v) {
+    out << v.str();
+    return out;
+}
+
+bool LogicalErrorSpectrum::operator==(const LogicalErrorSpectrum &other) const {
+    return distance == other.distance && multiplicity == other.multiplicity &&
+           observable_distances == other.observable_distances &&
+           observable_multiplicities == other.observable_multiplicities &&
+           minimum_weight_errors == other.minimum_weight_errors;
+}
+
+bool LogicalErrorSpectrum::operator!=(const LogicalErrorSpectrum &other) const {
+    return !(*this == other);
+}
+
+LogicalErrorSpectrum stim::graphlike_logical_error_spectrum(
+    const DetectorErrorModel &model, bool list_minimum_weight_errors) {
+    std::vector<Mechanism> mechanisms = collect_mechanisms(model);
+
+    LogicalErrorSpectrum result;
+    result.distance = NO_LOGICAL_ERROR;
+    result.observable_distances.assign(model.count_observables(), NO_LOGICAL_ERROR);
+    result.observable_multiplicities.assign(model.count_observables(), LogicalErrorCount());
+
+    for (size_t k = 0; k < result.observable_distances.size(); k++) {
+        result.observable_distances[k] = weight_flipping_observable(mechanisms, k);
+        result.distance = std::min(result.distance, result.observable_distances[k]);
+    }
+    if (result.distance == NO_LOGICAL_ERROR) {
+        return result;
+    }
+
+    Incidence incidence = build_incidence(mechanisms, model.count_detectors());
+
+    result.multiplicity = count_errors(incidence, mechanisms, result.distance, 0, false);
+    for (size_t k = 0; k < result.observable_distances.size(); k++) {
+        if (result.observable_distances[k] != NO_LOGICAL_ERROR) {
+            result.observable_multiplicities[k] =
+                count_errors(incidence, mechanisms, result.observable_distances[k], k, true);
+        }
+    }
+
+    if (!list_minimum_weight_errors) {
+        return result;
+    }
+
+    std::set<std::vector<size_t>> listed;
+    for (size_t index = 0; index < mechanisms.size(); index++) {
+        const Mechanism &seed = mechanisms[index];
+        auto ends = endpoints_of(seed, incidence.boundary);
+
+        if (ends.first == ends.second) {
+            if (result.distance == 1 && !seed.observables.empty()) {
+                listed.insert({index});
+            }
+            continue;
+        }
+
+        std::vector<size_t> lower_bound = steps_to_target(incidence, ends.second, index);
+        std::vector<size_t> partial{index};
+        gather_walks(
+            incidence,
+            mechanisms,
+            ends.first,
+            ends.second,
+            result.distance - 1,
+            index,
+            lower_bound,
+            ObsSet{},
+            seed.observables,
+            partial,
+            listed);
+    }
+
+    for (const auto &indices : listed) {
+        result.minimum_weight_errors.push_back(render(indices, mechanisms));
+    }
+    return result;
+}
