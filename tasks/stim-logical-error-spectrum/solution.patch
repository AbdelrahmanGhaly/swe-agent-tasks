+
+        The output always begins with a `distance` line carrying the smallest
+        weight of any undetectable logical error, a `multiplicity` line
+        carrying how many distinct sets reach that weight, and one line per
+        observable index carrying two numbers: the smallest weight of an
+        undetectable logical error flipping that observable, and how many
+        distinct undetectable logical errors of that weight flip it. That
+        second number is counted at the observable's own weight, which need
+        not be the distance, and over the errors flipping that observable
+        only, so it is not the multiplicity. A weight that does not exist is
+        written as `none 0`, and the multiplicity is then 0.
+    )PARAGRAPH");
+
+    result.examples.push_back(clean_doc_string(R"PARAGRAPH(
+            >>> stim shortest_errors --in example.dem
+            distance 3
+            multiplicity 2
+            L0 3 2
+    )PARAGRAPH"));
+
+    result.flags.push_back(
+        SubCommandHelpFlag{
+            "--list",
+            "bool",
+            "false",
+            {"[none]", "[switch]"},
+            clean_doc_string(R"PARAGRAPH(
+            Also writes out every minimum weight undetectable logical error.
+
+            Each one is written as a block of `error(1)` instructions, and each
+            block is preceded by a blank line. Blocks appear in increasing
+            order, comparing their mechanisms in turn, and comparing two
+            mechanisms by their detector indices and then their observable
+            indices.
+
+            A model can have exponentially many minimum weight undetectable
+            logical errors, so they are only built when this flag is given. The
+            `distance`, `multiplicity` and per observable lines are computed
+            without building any of them.
+        )PARAGRAPH"),
+        });
+
+    result.flags.push_back(
+        SubCommandHelpFlag{
+            "--in",
+            "filepath",
+            "{stdin}",
+            {"[none]", "filepath"},
+            clean_doc_string(R"PARAGRAPH(
+            Chooses the detector error model to read.
+
+            By default the model is read from stdin.
+        )PARAGRAPH"),
