+#ifndef _STIM_SEARCH_GRAPHLIKE_SPECTRUM_H
+#define _STIM_SEARCH_GRAPHLIKE_SPECTRUM_H
+
+#include <cstddef>
+#include <cstdint>
+#include <ostream>
+#include <string>
+#include <vector>
+
+#include "stim/dem/detector_error_model.h"
+
+namespace stim {
+
+/// Reported instead of a weight when no undetectable logical error qualifies.
+constexpr size_t NO_LOGICAL_ERROR = SIZE_MAX;
+
+/// A count with no upper bound.
+///
+/// A compact model can hold more minimum weight undetectable logical errors than fit
+/// in a fixed width integer, so counting them in one would silently report the count
+/// modulo 2**64 instead of the count.
+struct LogicalErrorCount {
+    /// Base 1000000000 digits, least significant first. Empty means zero.
+    std::vector<uint32_t> digits;
+
+    static LogicalErrorCount one();
+    bool is_zero() const;
+    std::string str() const;
+
+    void operator+=(const LogicalErrorCount &other);
+    bool operator==(const LogicalErrorCount &other) const;
+    bool operator!=(const LogicalErrorCount &other) const;
+};
+std::ostream &operator<<(std::ostream &out, const LogicalErrorCount &v);
+
+/// Summarizes the undetectable logical errors formed by graphlike error mechanisms.
+struct LogicalErrorSpectrum {
+    /// Weight of the smallest undetectable logical error, or NO_LOGICAL_ERROR.
+    size_t distance;
+    /// How many distinct undetectable logical errors reach that weight. Counted
+    /// without building them, so this stays cheap when there are exponentially many.
+    LogicalErrorCount multiplicity;
+    /// Per observable index, the smallest weight of an undetectable logical error
+    /// flipping that observable, or NO_LOGICAL_ERROR.
+    std::vector<size_t> observable_distances;
+    /// Per observable index, how many distinct undetectable logical errors of that
+    /// observable's own weight flip it. Counted at `observable_distances[k]`, which
+    /// need not be `distance`, and over the errors flipping that observable only, so
+    /// this is not `multiplicity`.
+    std::vector<LogicalErrorCount> observable_multiplicities;
+    /// Every minimum weight undetectable logical error, in canonical order. Only
+    /// populated when they were asked for, because there can be exponentially many.
+    std::vector<DetectorErrorModel> minimum_weight_errors;
+
+    bool operator==(const LogicalErrorSpectrum &other) const;
+    bool operator!=(const LogicalErrorSpectrum &other) const;
+};
+
+/// Computes the graphlike logical error spectrum of a detector error model.
+///
+/// An error mechanism participates when its probability is not zero. Composite
+/// mechanisms are split on their separators and each part is considered on its
+/// own. Parts mentioning more than two detectors are skipped, and parts that
+/// mention the same detectors and flip the same observables are merged.
+///
+/// A set of mechanisms is an undetectable logical error when every detector is
+/// mentioned an even number of times across the set and at least one observable
+/// is flipped an odd number of times. Its weight is the size of the set.
+///
+/// Args:
+///     model: The detector error model to summarize.
+///     list_minimum_weight_errors: Whether to also build every minimum weight
+///         undetectable logical error. Building them costs time and memory
+///         proportional to how many there are, which can be exponential, so the
+///         distance, the multiplicity and the per observable weights are all
+///         computed without building any of them.
+LogicalErrorSpectrum graphlike_logical_error_spectrum(
+    const DetectorErrorModel &model, bool list_minimum_weight_errors);
+
+}  // namespace stim
+
+#endif
