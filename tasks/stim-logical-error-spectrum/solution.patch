+static void write_weight(std::ostream &out, size_t weight) {
+    if (weight == NO_LOGICAL_ERROR) {
+        out << "none";
+    } else {
+        out << weight;
+    }
+}
+
+int stim::command_shortest_errors(int argc, const char **argv) {
+    check_for_unknown_arguments({"--list", "--out", "--in"}, {}, "shortest_errors", argc, argv);
+
+    FILE *in = find_open_file_argument("--in", stdin, "rb", argc, argv);
+    auto out_stream = find_output_stream_argument("--out", true, argc, argv);
+    bool list = find_bool_argument("--list", argc, argv);
+
+    auto model = DetectorErrorModel::from_file(in);
+    if (in != stdin) {
+        fclose(in);
+    }
+
+    LogicalErrorSpectrum spectrum = graphlike_logical_error_spectrum(model, list);
+    std::ostream &out = out_stream.stream();
+
+    out << "distance ";
+    write_weight(out, spectrum.distance);
+    out << "\n";
+    out << "multiplicity " << spectrum.multiplicity << "\n";
+    for (size_t k = 0; k < spectrum.observable_distances.size(); k++) {
+        out << "L" << k << " ";
+        write_weight(out, spectrum.observable_distances[k]);
+        out << " " << spectrum.observable_multiplicities[k] << "\n";
+    }
+
+    if (list) {
+        for (const auto &error : spectrum.minimum_weight_errors) {
+            out << "\n";
+            for (const auto &instruction : error.instructions) {
+                out << instruction << "\n";
+            }
+        }
+    }
+
+    return EXIT_SUCCESS;
+}
+
