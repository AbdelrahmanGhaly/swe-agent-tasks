+import numpy as np
+
+import wfdb
+
+RECORD = "sample-data/multi-segment/s00001/s00001-2896-10-10-00-31"
+
+
+def write_and_read(tmp_path, record, expanded=False, **read_args):
+    record.wrsamp(expanded=expanded, write_dir=str(tmp_path))
+    return wfdb.rdrecord(
+        str(tmp_path / record.record_name), m2s=False, **read_args
+    )
+
+
+def assert_same_segments(original, copy, expanded=False):
+    assert list(copy.seg_len) == list(original.seg_len)
+    assert len(copy.segments) == len(original.segments)
+    assert copy.segments[0].sig_name == original.segments[0].sig_name
+    for seg_orig, seg_copy in zip(original.segments[1:], copy.segments[1:]):
+        if seg_orig is None:
+            assert seg_copy is None
+            continue
+        assert seg_copy.sig_name == seg_orig.sig_name
+        if expanded:
+            for ch in range(seg_orig.n_sig):
+                np.testing.assert_array_equal(
+                    seg_copy.e_d_signal[ch], seg_orig.e_d_signal[ch]
+                )
+        else:
+            np.testing.assert_array_equal(seg_copy.d_signal, seg_orig.d_signal)
+
+
+def test_write_partial_variable_layout_record(tmp_path):
+    original = wfdb.rdrecord(RECORD, sampto=12000, m2s=False, physical=False)
+    copy = write_and_read(tmp_path, original, physical=False)
+    assert copy.seg_name == original.seg_name
+    assert copy.sig_len == 12000
+    assert_same_segments(original, copy)
+
+
+def test_written_layout_segment_keeps_signal_specifications(tmp_path):
+    original = wfdb.rdrecord(RECORD, sampto=12000, m2s=False, physical=False)
+    copy = write_and_read(tmp_path, original, physical=False)
+    layout = copy.segments[0]
+    assert copy.seg_len[0] == 0
+    assert layout.sig_len == 0
+    assert (tmp_path / "3975656_layout.hea").exists()
+    assert not (tmp_path / "3975656_layout.dat").exists()
+    assert layout.sig_name == ["II", "V", "MCL1", "ABP"]
+    assert layout.units == ["mV", "mV", "mV", "mmHg"]
+    assert layout.adc_gain == [83.0, 55.0, 122.0, 1.0]
+    assert layout.baseline == original.segments[0].baseline
+    for field in (
+        "fmt",
+        "adc_res",
+        "adc_zero",
+        "skew",
+        "byte_offset",
+        "init_value",
+        "checksum",
+        "block_size",
+        "samps_per_frame",
+    ):
+        assert getattr(layout, field) == getattr(original.segments[0], field)
+
+
+def test_write_variable_layout_starting_inside_null_segment(tmp_path):
+    original = wfdb.rdrecord(
+        RECORD, sampfrom=100, sampto=3000, m2s=False, physical=False
+    )
+    copy = write_and_read(tmp_path, original, physical=False)
+    assert copy.seg_name[1] == "~"
+    assert list(copy.seg_len) == [0, 2900]
+    single = wfdb.rdrecord(str(tmp_path / original.record_name))
+    assert single.p_signal.shape == (2900, 4)
+    assert np.isnan(single.p_signal).all()
+
+
+def test_write_variable_layout_starting_mid_segment(tmp_path):
+    original = wfdb.rdrecord(
+        RECORD, sampfrom=5000, sampto=7300, m2s=False, physical=False
+    )
+    copy = write_and_read(tmp_path, original, physical=False)
+    assert copy.seg_name == original.seg_name
+    assert_same_segments(original, copy)
+    expected = wfdb.rdrecord(RECORD, sampfrom=5000, sampto=7300)
+    actual = wfdb.rdrecord(str(tmp_path / original.record_name))
+    assert actual.sig_name == expected.sig_name
+    np.testing.assert_array_equal(actual.p_signal, expected.p_signal)
+
+
+def test_write_variable_layout_with_selected_channels(tmp_path):
+    original = wfdb.rdrecord(
+        RECORD, sampto=12000, channels=[2, 0], m2s=False, physical=False
+    )
+    copy = write_and_read(tmp_path, original, physical=False)
+    assert copy.segments[0].sig_name == ["MCL1", "II"]
+    assert_same_segments(original, copy)
+    expected = wfdb.rdrecord(RECORD, sampto=12000, channels=[2, 0])
+    actual = wfdb.rdrecord(str(tmp_path / original.record_name))
+    np.testing.assert_array_equal(actual.p_signal, expected.p_signal)
+
+
+def test_write_variable_layout_when_segments_lack_selected_signals(tmp_path):
+    original = wfdb.rdrecord(
+        RECORD, sampto=12000, channels=[3], m2s=False, physical=False
+    )
+    copy = write_and_read(tmp_path, original, physical=False)
+    assert list(copy.seg_len) == [0, 3261, 6750, 125, 1354, 510]
+    assert copy.segments[0].sig_name == ["ABP"]
+    assert all(seg is None for seg in copy.segments[1:])
+    actual = wfdb.rdrecord(str(tmp_path / original.record_name))
+    assert actual.sig_name == ["ABP"]
+    assert actual.p_signal.shape == (12000, 1)
+    assert np.isnan(actual.p_signal).all()
+
+
+def test_write_variable_layout_mixing_present_and_absent_signals(tmp_path):
+    original = wfdb.rdrecord(
+        RECORD,
+        sampfrom=3000,
+        sampto=12000,
+        channels=[1, 3],
+        m2s=False,
+        physical=False,
+    )
+    copy = write_and_read(tmp_path, original, physical=False)
+    assert_same_segments(original, copy)
+    expected = wfdb.rdrecord(
+        RECORD, sampfrom=3000, sampto=12000, channels=[1, 3]
+    )
+    actual = wfdb.rdrecord(str(tmp_path / original.record_name))
+    assert actual.sig_name == ["V", "ABP"]
+    np.testing.assert_array_equal(actual.p_signal, expected.p_signal)
+
+
+def test_write_expanded_variable_layout_record(tmp_path):
+    original = wfdb.rdrecord(
+        RECORD, sampto=12000, m2s=False, physical=False, smooth_frames=False
+    )
+    copy = write_and_read(
+        tmp_path, original, expanded=True, physical=False, smooth_frames=False
+    )
+    assert_same_segments(original, copy, expanded=True)
