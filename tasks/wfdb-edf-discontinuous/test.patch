+def test_discontinuous_round_trip_keeps_full_16_bit_range(tmp_path):
+    wide = signal(
+        "EEG", 2, pmin=-500, pmax=500, dmin=-32768, dmax=32767, dim="uV"
+    )
+    resp = signal("RESP", 2, pmin=0, pmax=50, dmin=0, dmax=1000, dim="L")
+    records = [
+        ([-32768, 32767], tal("+0"), [10, 20]),
+        ([0, -32768], tal("+2"), [30, 40]),
+    ]
+    path = write_edf(
+        tmp_path / "wide.edf",
+        [wide, annotations(8), resp],
+        records,
+        kind="EDF+D",
+    )
+    record = read_edf(path)
+    np.testing.assert_array_equal(
+        record.segments[1].d_signal, [[-32768, 10], [32767, 20]]
+    )
+    np.testing.assert_allclose(
+        record.segments[1].p_signal[:, 0],
+        physical([-32768, 32767], wide),
+        rtol=0,
+        atol=step(wide),
+    )
+    out = tmp_path / "out"
+    out.mkdir()
+    record.wrsamp(write_dir=str(out))
+    back = wfdb.rdrecord(str(out / "wide"), m2s=False, physical=False)
+    assert list(back.seg_len) == [0, 2, 2, 2]
+    specifications = (
+        "sig_name",
+        "units",
+        "adc_gain",
+        "baseline",
+        "samps_per_frame",
+        "fmt",
+        "adc_res",
+        "adc_zero",
+        "skew",
+        "byte_offset",
+        "init_value",
+        "block_size",
+    )
+    for field in specifications:
+        assert getattr(back.segments[0], field) == getattr(
+            record.segments[0], field
+        )
+    for original, copy in zip(record.segments[1:], back.segments[1:]):
+        if original is None:
+            assert copy is None
+            continue
+        for field in specifications:
+            assert getattr(copy, field) == getattr(original, field)
+        np.testing.assert_array_equal(copy.d_signal, original.d_signal)
+    single = wfdb.rdrecord(str(out / "wide"), physical=False)
+    expected = record.multi_to_single(physical=False)
+    np.testing.assert_array_equal(single.d_signal, expected.d_signal)
