+def _parse_tals(raw):
+    """
+    Split the bytes of one 'EDF Annotations' signal of one data record into
+    its time-stamped annotation lists.
+
+    Parameters
+    ----------
+    raw : bytes
+        The raw bytes of the annotation signal in the data record.
+
+    Returns
+    -------
+    tals : list
+        A list of `(onset, duration, texts)` tuples, where `duration` is None
+        when the list does not give one.
+
+    """
+    tals = []
+    for tal in raw.split(b"\x00"):
+        if not tal:
+            continue
+        fields = tal.split(b"\x14")
+        onset, _, duration = fields[0].decode("utf-8").partition("\x15")
+        texts = [text.decode("utf-8") for text in fields[1:] if text]
+        tals.append(
+            (
+                fractions.Fraction(onset),
+                fractions.Fraction(duration) if duration else None,
+                texts,
+            )
+        )
+    return tals
+
+
+def _read_edf_annotations(
+    edf_file, header_bytes, samps_per_block, ann_channels, num_blocks
+):
+    """
+    Read the annotations and the data record onsets of an EDF+ file,
+    without loading the samples of the other signals.
+
+    Parameters
+    ----------
+    edf_file : file
+        The open EDF file.
+    header_bytes : int
+        The number of bytes in the header record.
+    samps_per_block : list
+        The number of samples of each signal in a data record.
+    ann_channels : list
+        The indices of the 'EDF Annotations' signals.
+    num_blocks : int
+        The number of data records.
+
+    Returns
+    -------
+    annotations : list
+        The `(onset, duration, text)` of each annotation in file order.
+    block_onsets : list
+        The onset of each data record, in seconds.
+
+    """
+    block_bytes = 2 * sum(samps_per_block)
+    annotations = []
+    block_onsets = []
+    for block in range(num_blocks):
+        for ch in ann_channels:
+            edf_file.seek(
+                header_bytes
+                + block * block_bytes
+                + 2 * sum(samps_per_block[:ch])
+            )
+            tals = _parse_tals(edf_file.read(2 * samps_per_block[ch]))
+            if ch == ann_channels[0]:
+                if not tals:
+                    raise Exception(
+                        f"EDF+ data record {block} has no time-keeping "
+                        "annotation"
+                    )
+                block_onsets.append(tals[0][0])
+                tals = tals[1:]
+            for onset, duration, texts in tals:
+                annotations.extend((onset, duration, text) for text in texts)
+    return annotations, block_onsets
+
+
+def _nearest_frame(seconds, frame_rate):
+    """
+    Convert a time in seconds to the nearest frame number, rounding halves up.
+
+    Parameters
+    ----------
+    seconds : Fraction
+        The exact time, in seconds.
+    frame_rate : Fraction
+        The exact frame frequency.
+
+    Returns
+    -------
+    frame : int
+        The frame number.
+
+    """
+    return math.floor(seconds * frame_rate + fractions.Fraction(1, 2))
+
+
+def _frame_frequency(frame_rate):
+    """
+    Express an exact frame frequency as a record sampling frequency.
+
+    Parameters
+    ----------
+    frame_rate : Fraction
+        The exact frame frequency.
+
+    Returns
+    -------
+    fs : int, float
+        The frequency, as an int when it is a whole number.
+
+    """
+    if frame_rate.denominator == 1:
+        return int(frame_rate)
+    return float(frame_rate)
+
+
+def _contiguous_runs(
+    block_onsets, block_duration, start_frames, frames_per_block
+):
+    """
+    Group consecutive data records that follow each other without a gap.
+
+    Parameters
+    ----------
+    block_onsets : list
+        The exact onset of each data record, in seconds.
+    block_duration : Fraction
+        The duration of each data record, in seconds.
+    start_frames : list
+        The frame at which each data record starts.
+    frames_per_block : int
+        The number of frames in each data record.
+
+    Returns
+    -------
+    runs : list
+        A list of `[first, count]` pairs, one for each run of data records.
+
+    """
+    runs = []
+    for block, start in enumerate(start_frames):
+        if block:
+            if block_onsets[block] < block_onsets[block - 1] + block_duration:
+                raise Exception(
+                    f"EDF+D data record {block} overlaps the previous one"
+                )
+            if start == start_frames[block - 1] + frames_per_block:
+                runs[-1][1] += 1
+                continue
+        runs.append([block, 1])
+    return runs
+
+
+def _edf_signal_record(record_name, block_sigs, conversion, signal_fields):
+    """
+    Build a single segment record from consecutive EDF data records.
+
+    Parameters
+    ----------
+    record_name : str
+        The name of the record.
+    block_sigs : list
+        The raw samples of each signal, one row per data record.
+    conversion : list
+        The `(baseline, adc_gain)` used to convert each signal.
+    signal_fields : dict
+        The record fields shared by every segment.
+
+    Returns
+    -------
+    record : Record
+        The record holding the samples.
+
+    """
+    e_d_signal = [sig.flatten().astype(np.int64) for sig in block_sigs]
+    e_p_signal = [
+        (sig - base) / gain for sig, (base, gain) in zip(e_d_signal, conversion)
+    ]
+    record = Record(
+        record_name=record_name,
+        sig_len=len(e_d_signal[0]) // signal_fields["samps_per_frame"][0],
+        file_name=signal_fields["n_sig"] * [record_name + ".dat"],
+        init_value=[int(sig[0]) for sig in e_d_signal],
+        e_d_signal=e_d_signal,
+        e_p_signal=e_p_signal,
+        **signal_fields,
+    )
+    if all(spf == 1 for spf in signal_fields["samps_per_frame"]):
+        record.d_signal = np.transpose(e_d_signal)
+        record.p_signal = np.transpose(e_p_signal)
+        record.e_d_signal = None
+        record.e_p_signal = None
+        record.checksum = record.calc_checksum()
+    else:
+        record.p_signal = record.smooth_frames("physical")
