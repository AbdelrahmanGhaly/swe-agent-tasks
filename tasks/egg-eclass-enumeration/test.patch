+#[test]
+fn a_saturated_graph_enumerates_its_root() {
+    let rules: &[Rewrite<SymbolLang, ()>] = &[rewrite!("comm"; "(+ ?a ?b)" => "(+ ?b ?a)")];
+    let start: RecExpr<SymbolLang> = "(+ x y)".parse().unwrap();
+    let runner = Runner::default()
+        .with_time_limit(Duration::from_secs(3600))
