+    let outer = node(&mut egraph, "f", vec![inner]);
+    egraph.rebuild();
+    let mut extractor = Extractor::new(&egraph, AstDepth);
+    for (cost, expr) in extractor.exprs(outer) {
+        assert_eq!(cost, AstDepth.cost_rec(&expr));
