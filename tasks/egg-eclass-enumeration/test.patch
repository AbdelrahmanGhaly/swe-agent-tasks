+#[test]
+fn matching_is_a_subset_of_enumeration() {
+    let mut egraph = Graph::default();
+    let f = egraph.add_expr(&"(f x)".parse().unwrap());
+    let g = egraph.add_expr(&"(g x)".parse().unwrap());
+    egraph.union(f, g);
+    egraph.rebuild();
+    let all = strings(&egraph, f);
+    for found in matching(&egraph, f, "(f ?v)") {
+        assert!(all.contains(&found));
+    }
+}
