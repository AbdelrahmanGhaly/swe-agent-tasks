+#[test]
+fn oracle_agrees_after_saturation() {
+    let rules: &[Rewrite<SymbolLang, ()>] = &[
+        rewrite!("comm"; "(+ ?a ?b)" => "(+ ?b ?a)"),
+        rewrite!("zero"; "(+ ?a zero)" => "?a"),
+    ];
+    let start: RecExpr<SymbolLang> = "(+ x zero)".parse().unwrap();
+    let runner = Runner::default()
+        .with_time_limit(Duration::from_secs(3600))
+        .with_expr(&start)
+        .run(rules);
+    let root = runner.roots[0];
+    assert_eq!(strings(&runner.egraph, root), oracle(&runner.egraph, root));
+}
