+#[test]
+fn matching_preserves_the_enumeration_order() {
+    let mut egraph = Graph::default();
+    let big = egraph.add_expr(&"(f (f x))".parse().unwrap());
+    let small = egraph.add_expr(&"(f y)".parse().unwrap());
+    egraph.union(big, small);
+    egraph.rebuild();
+    let pattern: Pattern<SymbolLang> = "(f ?v)".parse().unwrap();
+    let mut extractor = Extractor::new(&egraph, AstSize);
+    let found: Vec<usize> = extractor.exprs_matching(big, &pattern).map(|(c, _)| c).collect();
+    assert!(is_sorted(&found));
+}
