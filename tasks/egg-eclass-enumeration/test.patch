+#!/usr/bin/env bash
+set -uo pipefail
+
+export PATH="$PATH:/opt/cargo/bin:/root/.cargo/bin"
+export CARGO_INCREMENTAL=0
+export RUSTC_BOOTSTRAP=1
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+NEW_TEST=enumerate_e8a662
+
+JSON=$(mktemp)
+ERR=$(mktemp)
+
+if [ "$MODE" = new ]; then
+  cargo test --offline --test "$NEW_TEST" \
+    -- -Z unstable-options --format json --report-time > "$JSON" 2> "$ERR"
+else
+  # The crate's unit tests plus every integration test the repo already ships.
+  # Doc tests are left out on purpose: rustdoc names each one after the file and
+  # the line its example starts on, so adding a method to src/extract.rs renames
+  # the examples below it, and a regression check keyed on test names would read
+  # that rename as a failure whatever the code does. The new test target is also
+  # left out here so that base mode measures the repo's own suite alone.
+  cargo test --offline --lib \
+    --test datalog --test lambda --test math --test prop --test simple \
+    -- -Z unstable-options --format json --report-time > "$JSON" 2> "$ERR"
+fi
+STATUS=$?
+
+cat "$ERR" >&2
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  cargo2junit < "$JSON" > "$OUTPUT_PATH" 2>/dev/null || true
+
+  # A compilation failure produces no test events at all. Report one failing case
+  # per test function so the run still names the tests it could not execute, and
+  # carry the compiler output so the reason is visible.
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    DETAIL=$( { cat "$ERR"; cat "$JSON"; } | tail -c 4000 | sed -e 's/]]>/]]]]><![CDATA[>/g' )
+    {
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n'
+      printf '  <testsuite name="cargo-test" tests="%s" failures="%s" errors="0">\n' 1 1
+      if [ "$MODE" = new ] && [ -f "tests/$NEW_TEST.rs" ]; then
+        NAMES=$(awk '/^#\[test\]/ { want = 1; next } want && /^fn / { sub(/^fn /, ""); sub(/\(.*$/, ""); print; want = 0 }' "tests/$NEW_TEST.rs")
+      else
+        NAMES="compilation"
+      fi
+      for name in $NAMES; do
+        printf '    <testcase name="%s" classname="cargo-test"><failure message="build failed"><![CDATA[%s]]></failure></testcase>\n' "$name" "$DETAIL"
+      done
+      printf '  </testsuite>\n</testsuites>\n'
+    } > "$OUTPUT_PATH"
+    TOTAL=$(grep -c '<testcase' "$OUTPUT_PATH")
+    sed -i "s|<testsuite name=\"cargo-test\" tests=\"1\" failures=\"1\"|<testsuite name=\"cargo-test\" tests=\"$TOTAL\" failures=\"$TOTAL\"|" "$OUTPUT_PATH"
+    STATUS=1
+  fi
+fi
+
+rm -f "$JSON" "$ERR"
+exit $STATUS
