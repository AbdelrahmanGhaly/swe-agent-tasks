+class PreservationTest(unittest.TestCase):
+
+    def test_hand_written_vstruct_stays_packed_while_c_source_is_padded(self):
+        hand = vstruct.VStruct()
+        hand.a = vs_prims.v_uint8(1)
+        hand.b = vs_prims.v_uint32(2)
+        self.assertEqual(len(hand), 5)
+        self.assertEqual(hand.vsEmit().hex(), "0102000000")
+
+        csrc = build(SRC_PACKED)
+        csrc.a = 1
+        csrc.b = 2
+        self.assertEqual((len(csrc), csrc.vsGetOffset("b")), (8, 4))
+        self.assertEqual(csrc.vsEmit().hex(), "0100000002000000")
+
+    def test_vbitfield_keeps_msb_first_order_while_c_bitfields_fill_from_lsb(self):
+        bits = VBitField()
+        bits.vsAddField("a", v_bits(3))
+        bits.vsAddField("b", v_bits(5))
+        bits.a = 5
+        bits.b = 7
+        self.assertEqual(bits.vsEmit().hex(), "a7")
+
+        csrc = build("struct pair { unsigned a:3, b:5; };")
+        csrc.a = 5
+        csrc.b = 7
+        self.assertEqual(csrc.vsEmit().hex(), "3d000000")
