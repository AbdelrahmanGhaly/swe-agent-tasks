+class UnionBytesTest(unittest.TestCase):
+
+    def test_assigning_a_member_changes_what_the_others_read(self):
+        u = build("union mix { unsigned int i; unsigned char b[4]; short s; };")
+        u.i = 0x11223344
+        self.assertEqual([u.b[x].vsGetValue() for x in range(4)], [0x44, 0x33, 0x22, 0x11])
+        self.assertEqual(u.s, 0x3344)
+        u.s = -1
+        self.assertEqual(u.i, 0x1122FFFF)
+        self.assertEqual(u.vsEmit().hex(), "ffff2211")
+
+    def test_changing_a_struct_inside_a_union_updates_the_union(self):
+        vs = build(SRC_STRUCT_INSIDE_UNION_INSIDE_STRUCT)
+        vs.u.pair.b = -5
+        self.assertEqual(vs.u.q, -0x500000000)
+        self.assertEqual(vs.vsEmit().hex(), "0000000000000000" + "00000000fbffffff")
+
+    def test_union_inside_struct_emits_the_last_change(self):
+        vs = build("struct box { char tag; union { char c; long long q; } v; };")
+        vs.v.q = -2
+        self.assertEqual(vs.vsEmit().hex(), "0000000000000000feffffffffffffff")
+        vs.v.c = 1
+        self.assertEqual(vs.v.q, -0xFF)
+        self.assertEqual(vs.vsEmit().hex(), "000000000000000001ffffffffffffff")
+
+    def test_parsed_union_reads_every_member_from_the_same_bytes(self):
+        u = build("union num { int i; float f; unsigned char b[2]; };", psize=4)
+        self.assertEqual(u.vsParse(bytes.fromhex("0000803f")), 4)
+        self.assertEqual(u.i, 0x3F800000)
+        self.assertEqual(u.f, 1.0)
+        self.assertEqual(u.b[1].vsGetValue(), 0)
+
+    def test_register_union_little_endian(self):
+        u = build(SRC_UNION_REG, psize=8)
+        u.raw = 0xABCDE123
+        self.assertEqual((u.f.lo, u.f.mid, u.f.hi), (0x123, 0xDE, 0xABC))
+        self.assertEqual(u.vsEmit().hex(), "23e1cdab")
+
+    def test_register_union_bigend(self):
+        u = build(SRC_UNION_REG, psize=8, bigend=True)
+        u.raw = 0x123DEABC
+        self.assertEqual((u.f.lo, u.f.mid, u.f.hi), (0x123, 0xDE, 0xABC))
+        self.assertEqual(u.vsEmit().hex(), "123deabc")
+
+    def test_earlier_union_tag_member_shares_its_bytes(self):
+        vs = build(SRC_EARLIER_UNION_TAG_USED_AS_MEMBER, psize=4)
+        vs.n.i = 0x3F800000
+        self.assertEqual(vs.n.f, 1.0)
+        self.assertEqual(vs.n.b[3].vsGetValue(), 0x3F)
+        vs.n.f = -2.0
+        self.assertEqual(vs.n.i, -0x40000000)
+
+    def test_register_union_bitfield_change_updates_raw(self):
+        u = build(SRC_UNION_REG, psize=8)
+        u.raw = 0xABCDE123
+        u.f.mid = 0x01
+        self.assertEqual(u.raw, (0xABCDE123 & ~0xFF000) | 0x01000)
+
+    def test_writes_through_retained_primitive_fields_keep_their_order(self):
+        u = build("union mix { struct { unsigned int a; } s; struct { unsigned short b; } t; };")
+        a = u.s.vsGetField("a")
+        b = u.t.vsGetField("b")
+        b.vsSetValue(0xFFFF)
+        a.vsSetValue(0x11223344)
+        self.assertEqual((u.s.a, u.t.b), (0x11223344, 0x3344))
+        b.vsSetValue(0xFFFF)
+        self.assertEqual((u.s.a, u.vsEmit().hex()), (0x1122FFFF, "ffff2211"))
+
+    def test_writes_through_held_members_keep_their_order(self):
+        u = build("union mix { struct { unsigned int a; } s; struct { unsigned char c; } t; };")
+        s = u.s
+        t = u.t
+        t.c = 0x99
+        s.a = 0x11223344
+        self.assertEqual((u.s.a, u.t.c), (0x11223344, 0x44))
+        t.c = 0x55
+        self.assertEqual((u.s.a, u.vsEmit().hex()), (0x11223355, "55332211"))
+
+    def test_later_member_write_wins_over_an_earlier_nested_change(self):
+        u = build("union mix { unsigned char c; struct { unsigned int a; } s; };")
+        u.s.a = 0x11223344
+        u.c = 0x55
+        self.assertEqual((u.c, u.s.a), (0x55, 0x11223355))
+        self.assertEqual(u.vsEmit().hex(), "55332211")
+        u.s.a = 0x01020304
+        self.assertEqual(u.c, 0x04)
