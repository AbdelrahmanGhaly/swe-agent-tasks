+"""
+
+SRC_PACKED = "struct packed { unsigned char a; unsigned int b; };"
+
+SRC_TEXT = "struct msg { char tag[3]; int id; char text[5]; };"
+
+SRC_BITOFFS = "struct r { char tag; unsigned a:3; unsigned :0; unsigned b:5; unsigned c:30; unsigned d:4; };"
+
+SRC_GAPS = """
+    struct gaps {
+        unsigned a:3;
+        unsigned :5;
+        unsigned b:4;
+        char c;
+        int :0;
+        short d:7;
+        long long e:33;
+    };
+"""
+
+
+def build(src, psize=8, bigend=False):
+    return vs_cparse.vsFromCSource(src, psize=psize, bigend=bigend)
+
+
+def walk(vs, parts):
+    obj = vs
+    for part in parts:
+        obj = obj[int(part)] if part.isdigit() else getattr(obj, part)
+    return obj
+
+
+def getpath(vs, path):
+    obj = walk(vs, path.split("."))
+    if isinstance(obj, vs_prims.v_prim):
+        return obj.vsGetValue()
+    return obj
+
+
+def setpath(vs, path, value):
+    parts = path.split(".")
+    parent = walk(vs, parts[:-1])
+    if parts[-1].isdigit():
+        parent[int(parts[-1])].vsSetValue(value)
+    else:
+        setattr(parent, parts[-1], value)
+
+
+def pattern(size):
+    return bytes((i * 37 + 11) & 0x7F for i in range(size))
+
+
+class CLayoutTest(unittest.TestCase):
+
+    def checkLayout(self, src, psize, bigend, size, offsets, values, image):
+        vs = build(src, psize=psize, bigend=bigend)
+        self.assertEqual(len(vs), size)
+        self.assertEqual({path: vs.vsGetOffset(path) for path in offsets}, offsets)
+        for path, value in values.items():
+            setpath(vs, path, value)
+        self.assertEqual(vs.vsEmit().hex(), image)
+
+        parsed = build(src, psize=psize, bigend=bigend)
+        self.assertEqual(parsed.vsParse(bytes.fromhex(image)), size)
+        self.assertEqual({path: getpath(parsed, path) for path in values}, values)
