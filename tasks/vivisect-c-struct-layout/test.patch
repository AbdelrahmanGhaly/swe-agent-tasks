new file mode 100755
index 00000000..9037bf67
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,65 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() { echo "usage: $0 [--output_path <path>] base|new" >&2; exit 2; }
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new) MODE="$1"; MODE_COUNT=$((MODE_COUNT + 1)); shift ;;
+    --output_path) shift; [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }; OUTPUT_PATH="$1"; shift ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    *) echo "unknown argument: $1" >&2; usage ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+[ -n "$OUTPUT_PATH" ] || OUTPUT_PATH="$(pwd)/test-results-$MODE.xml"
+case "$OUTPUT_PATH" in /*) ;; *) OUTPUT_PATH="$(pwd)/$OUTPUT_PATH" ;; esac
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+cd "$(dirname "$0")" || exit 1
+
+NEW_TESTS=(
+  vstruct/tests/test_clayout_403f6e.py
+  vivisect/tests/test_userstructs_39a869.py
+)
+
+PYTEST=(python3 -m pytest -p no:cacheprovider -o addopts= -o "python_files=test*.py" -v --junitxml="$OUTPUT_PATH")
+
+LOG="$(mktemp 2>/dev/null || echo "$OUTPUT_PATH.log")"
+
+if [ "$MODE" = "new" ]; then
+  timeout 1800 "${PYTEST[@]}" "${NEW_TESTS[@]}" 2>&1 | tee "$LOG"
+  STATUS=${PIPESTATUS[0]}
+else
+  IGNORES=()
+  for t in "${NEW_TESTS[@]}"; do
+    IGNORES+=("--ignore=$t")
+  done
+  # vtrace and vdb tests start child processes and attach to them with ptrace.
+  # cobra and testremote start localhost TCP servers on fixed ports from worker threads, so a socket
+  # that is still closing can make a later bind fail with "Address already in use" from run to run.
+  # testcconvs.py holds no tests and its TestCase subclass overrides __init__ without arguments, so it cannot be collected.
+  timeout 3000 "${PYTEST[@]}" "${IGNORES[@]}" \
+    --ignore=vtrace --ignore=vdb --ignore=cobra --ignore=vivisect/tests/testremote.py \
+    --ignore=vivisect/tests/testcconvs.py . 2>&1 | tee "$LOG"
+  STATUS=${PIPESTATUS[0]}
+fi
+
+if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  DETAIL="$(tail -n 200 "$LOG" 2>/dev/null | LC_ALL=C tr -cd '\11\12\15\40-\176' | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+  cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="utf-8"?>
+<testsuites><testsuite name="pytest" tests="1" failures="1" errors="0" time="0">
+<testcase classname="test.sh" name="${MODE}_suite"><failure message="no test results">pytest exited with status ${STATUS} before reporting any test.
+${DETAIL}</failure></testcase>
+</testsuite></testsuites>
+XMLEOF
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+rm -f "$LOG"
+exit "$STATUS"
diff --git a/vivisect/tests/test_userstructs_39a869.py b/vivisect/tests/test_userstructs_39a869.py
new file mode 100644
index 00000000..9ae4eac2
--- /dev/null
+++ b/vivisect/tests/test_userstructs_39a869.py
@@ -0,0 +1,182 @@
+import io
+import os
+import struct
+import tempfile
+import unittest
+
+import vivisect
+import vivisect.const as v_const
+
+BASE = 0x41410000
+
+SRC_REC = "struct rec { char tag; void *next; int count; };"
+
+SRC_NODE = """
+struct node {
+    char kind;
+    void *data;
+    union { void *ptr; long num; } u;
+    struct { short id; void *ref; } items[2];
+    void *tail;
+};
+"""
+
+SRC_BE = "struct be { short s; int i; void *p; long long q; };"
+
+SRC_SMALL = "struct small { char c; void *p; short h; };"
+
+SRC_PLAIN = "typedef struct { int a; char b; } plain_t;"
+
+SRC_ARMPAD = "struct armpad { char c; int i; short s; };"
+
+
+def workspace(arch, data, bigend=False):
+    vw = vivisect.VivWorkspace()
+    vw.setMeta("Architecture", arch)
+    vw.setMeta("Platform", "linux")
+    if bigend:
+        vw.setMeta("bigend", True)
+    vw.addMemoryMap(BASE, 7, "test", data)
+    vw.addSegment(BASE, len(data), "test", "test")
+    return vw
+
+
+def node_bytes(psize, offsets, targets):
+    fmt = "<Q" if psize == 8 else "<I"
+    data = bytearray(0x200)
+    data[0] = 3
+    for off, ptr in zip(offsets, targets):
+        struct.pack_into(fmt, data, off, ptr)
+    return bytes(data)
+
+
+class UserStructWorkspaceTest(unittest.TestCase):
+
+    def test_amd64_workspace_builds_user_structures_with_eight_byte_pointers(self):
+        data = struct.pack("<B7xQi4x", 1, BASE + 0x40, 7) + bytes(0x80)
+        vw = workspace("amd64", data)
+        self.assertEqual(vw.setUserStructSource(SRC_REC), "rec")
+        vs = vw.getStructure(BASE, "rec")
+        self.assertEqual(len(vs), 24)
+        self.assertEqual((vs.tag, vs.next, vs.count), (1, BASE + 0x40, 7))
+
+    def test_i386_workspace_pads_user_structures(self):
+        data = struct.pack("<B3xIi", 2, BASE + 0x20, -3) + bytes(0x40)
+        vw = workspace("i386", data)
+        vw.setUserStructSource(SRC_REC)
+        vs = vw.getStructure(BASE, "rec")
+        self.assertEqual(len(vs), 12)
+        self.assertEqual((vs.tag, vs.next, vs.count), (2, BASE + 0x20, -3))
+
+    def test_make_structure_xrefs_follow_true_pointer_offsets_amd64(self):
+        offsets = (8, 16, 32, 48, 56)
+        targets = [BASE + 0x100 + 8 * i for i in range(5)]
+        vw = workspace("amd64", node_bytes(8, offsets, targets))
+        vw.setUserStructSource(SRC_NODE)
+        vs = vw.makeStructure(BASE, "node")
+
+        loc = vw.getLocation(BASE)
+        self.assertEqual((loc[v_const.L_VA], loc[v_const.L_SIZE], loc[v_const.L_LTYPE]), (BASE, 64, v_const.LOC_STRUCT))
+        xrefs = sorted(
+            (x[v_const.XR_FROM] - BASE, x[v_const.XR_TO])
+            for x in vw.getXrefs(rtype=v_const.REF_PTR)
+            if BASE <= x[v_const.XR_FROM] < BASE + 64
+        )
+        self.assertEqual(xrefs, list(zip(offsets, targets)))
+        self.assertEqual(vs.items[1].ref, targets[3])
+        self.assertEqual(vs.u.num, targets[1])
+
+    def test_make_structure_xrefs_follow_true_pointer_offsets_i386(self):
+        offsets = (4, 8, 16, 24, 28)
+        targets = [BASE + 0x100 + 4 * i for i in range(5)]
+        vw = workspace("i386", node_bytes(4, offsets, targets))
+        vw.setUserStructSource(SRC_NODE)
+        vw.makeStructure(BASE, "node")
+
+        self.assertEqual(vw.getLocation(BASE)[v_const.L_SIZE], 32)
+        xrefs = sorted(
+            (x[v_const.XR_FROM] - BASE, x[v_const.XR_TO])
+            for x in vw.getXrefs(rtype=v_const.REF_PTR)
+            if BASE <= x[v_const.XR_FROM] < BASE + 32
+        )
+        self.assertEqual(xrefs, list(zip(offsets, targets)))
+
+    def test_bigend_workspace_builds_big_endian_user_structures(self):
+        data = struct.pack(">h2xiIq", -2, -70000, BASE + 0x30, -5) + bytes(0x40)
+        vw = workspace("arm", data, bigend=True)
+        vw.setUserStructSource(SRC_BE)
+        vs = vw.getStructure(BASE, "be")
+        self.assertEqual(len(vs), 20)
+        self.assertEqual((vs.s, vs.i, vs.p, vs.q), (-2, -70000, BASE + 0x30, -5))
+        self.assertEqual(vs.vsEmit(), data[:20])
+
+    def test_loaded_bigend_workspace_rebuilds_big_endian_user_structures(self):
+        data = struct.pack(">h2xiIq", -2, -70000, BASE + 0x30, -5) + bytes(0x40)
+        vw = vivisect.VivWorkspace()
+        vw.config.viv.parsers.blob.arch = "arm"
+        vw.config.viv.parsers.blob.bigend = True
+        vw.config.viv.parsers.blob.baseaddr = BASE
+        vw.loadFromFd(io.BytesIO(data), fmtname="blob")
+        vw.setUserStructSource(SRC_BE)
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "bigend.viv")
+            vw.setMeta("StorageName", path)
+            vw.saveWorkspace()
+            loaded = vivisect.VivWorkspace()
+            loaded.loadWorkspace(path)
+
+        vs = loaded.getStructure(BASE, "be")
+        self.assertEqual(len(vs), 20)
+        self.assertEqual((vs.s, vs.i, vs.p, vs.q), (-2, -70000, BASE + 0x30, -5))
+        self.assertEqual(vs.vsEmit(), data[:20])
+
+    def test_loaded_workspace_rebuilds_user_structures_with_its_pointer_size(self):
+        data = struct.pack("<B7xQi4x", 9, BASE + 0x48, 11) + bytes(0x80)
+        vw = vivisect.VivWorkspace()
+        vw.config.viv.parsers.blob.arch = "amd64"
+        vw.config.viv.parsers.blob.bigend = False
+        vw.config.viv.parsers.blob.baseaddr = BASE
+        vw.loadFromFd(io.BytesIO(data), fmtname="blob")
+        vw.setUserStructSource(SRC_REC)
+        with tempfile.TemporaryDirectory() as tmp:
+            path = os.path.join(tmp, "userstructs.viv")
+            vw.setMeta("StorageName", path)
+            vw.saveWorkspace()
+            loaded = vivisect.VivWorkspace()
+            loaded.loadWorkspace(path)
+
+        self.assertEqual(loaded.getUserStructNames(), ["rec"])
+        vs = loaded.getStructure(BASE, "rec")
+        self.assertEqual(len(vs), 24)
+        self.assertEqual((vs.tag, vs.next, vs.count), (9, BASE + 0x48, 11))
+
+    def test_workspace_without_architecture_uses_four_byte_pointers(self):
+        vw = vivisect.VivWorkspace()
+        vw.addMemoryMap(BASE, 7, "test", struct.pack("<B3xIh2x", 4, 0x1234, -6))
+        self.assertEqual(vw.setUserStructSource(SRC_SMALL), "small")
+        vs = vw.getStructure(BASE, "small")
+        self.assertEqual((len(vs), vs.vsGetOffset("p"), vs.vsGetOffset("h")), (12, 4, 8))
+        self.assertEqual((vs.c, vs.p, vs.h), (4, 0x1234, -6))
+
+    def test_user_structure_without_a_tag_is_named_by_its_typedef(self):
+        vw = workspace("amd64", struct.pack("<ib3x", -9, 5))
+        self.assertEqual(vw.setUserStructSource(SRC_PLAIN), "plain_t")
+        self.assertEqual(vw.getUserStructNames(), ["plain_t"])
+        vs = vw.getStructure(BASE, "plain_t")
+        self.assertEqual((len(vs), vs.a, vs.b), (8, -9, 5))
+
+    def test_arm_blob_keeps_existing_structures_and_pads_new_ones(self):
+        fd = io.BytesIO(b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\xfc\xfd\xfe\xff")
+        vw = vivisect.VivWorkspace()
+        vw.config.viv.parsers.blob.arch = "arm"
+        vw.config.viv.parsers.blob.bigend = False
+        vw.config.viv.parsers.blob.baseaddr = 0x22220000
+        vw.loadFromFd(fd, fmtname="blob")
+
+        vw.setUserStructSource("struct allint {int foo; int bar; int baz; int biz;};")
+        allint = vw.makeStructure(0x22220000, "allint")
+        self.assertEqual((allint.foo, allint.biz), (0x03020100, -0x010204))
+
+        vw.setUserStructSource(SRC_ARMPAD)
+        pad = vw.getStructure(0x22220000, "armpad")
+        self.assertEqual((len(pad), pad.c, pad.i, pad.s), (12, 0, 0x07060504, 0x0908))
