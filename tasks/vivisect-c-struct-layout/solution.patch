+
+    def vsParse(self, fbytes, offset=0):
+        end = offset + self._vs_length
+        self._vs_raw = bytes(fbytes[offset:end])
+        self._vs_value = struct.unpack(self._vs_cfmt, self._vs_raw)[0]
+        return end
