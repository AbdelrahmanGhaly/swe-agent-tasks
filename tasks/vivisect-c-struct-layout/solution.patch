+class v_cbits(vs_prim.v_bytes):
+    '''
+    The storage bytes of one run of C bit-fields.  Bit 0 is the least
+    significant bit of the first byte, or its most significant bit when
+    big endian.
+    '''
+    def __init__(self, size=0, bigend=False):
+        vs_prim.v_bytes.__init__(self, size=size)
+        self._vs_bigend = bigend
+
+    def _vsBitShift(self, bitoff, width):
+        if self._vs_bigend:
+            return self._vs_length * 8 - bitoff - width
+        return bitoff
+
+    def vsGetBits(self, bitoff, width):
+        order = 'big' if self._vs_bigend else 'little'
+        bits = int.from_bytes(self._vs_value, order)
+        return (bits >> self._vsBitShift(bitoff, width)) & ((1 << width) - 1)
+
+    def vsSetBits(self, bitoff, width, value):
+        order = 'big' if self._vs_bigend else 'little'
+        bits = int.from_bytes(self._vs_value, order)
+        shift = self._vsBitShift(bitoff, width)
+        mask = ((1 << width) - 1) << shift
+        bits = (bits & ~mask) | ((value << shift) & mask)
+        self._vs_value = bits.to_bytes(self._vs_length, order)
+
+
+class v_cbitfield(vs_prim.v_prim):
+    '''
+    A named C bit-field.  It takes no bytes of its own and reads and writes
+    its bits in the v_cbits storage it was created with.
+    '''
+    def __init__(self, store, bitoff, width, signed=False):
+        vs_prim.v_prim.__init__(self)
+        self._vs_store = store
+        self._vs_bitoff = bitoff
+        self._vs_bitwidth = width
+        self._vs_signed = signed
+        self._vs_length = 0
+
+    def vsParse(self, fbytes, offset=0):
+        return offset
+
+    def vsEmit(self):
+        return b''
+
+    def vsGetValue(self):
+        value = self._vs_store.vsGetBits(self._vs_bitoff, self._vs_bitwidth)
+        if self._vs_signed and value >> (self._vs_bitwidth - 1):
+            value -= 1 << self._vs_bitwidth
+        return value
+
+    def vsSetValue(self, value):
+        self._vs_store.vsSetBits(self._vs_bitoff, self._vs_bitwidth, value)
+
+
+class v_cboolfield(v_cbitfield):
+    '''
+    A named C _Bool bit-field.  Assigning any nonzero value stores 1.
+    '''
+    def vsSetValue(self, value):
+        v_cbitfield.vsSetValue(self, 1 if value else 0)
