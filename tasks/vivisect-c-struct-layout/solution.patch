+        self.align = align
+        self.ctor = ctor
+        self.signed = signed
+        self.ischar = ischar
+        self.tclass = tclass
+        self.target = target
+        self.isbool = isbool
+
+    def build(self, bigend):
+        if self.ctor is None:
+            raise Exception('C type has no storage layout')
+        return self.ctor(bigend)
+
+
+class CArray(CType):
+
+    def __init__(self, elem, count):
+        CType.__init__(self, elem.size * count, elem.align, None, tclass='array')
+        self.elem = elem
+        self.count = count
+
+    def build(self, bigend):
+        if self.elem.ischar:
+            return _cprim(v_cstr)(size=self.count)
+        return vstruct.VArray([self.elem.build(bigend) for i in range(self.count)])
+
+
+class CRecord(CType):
+
+    def __init__(self, kind, name):
+        CType.__init__(self, 0, 1, None, tclass='record')
+        self.kind = kind
+        self.name = name
+        self.items = None
