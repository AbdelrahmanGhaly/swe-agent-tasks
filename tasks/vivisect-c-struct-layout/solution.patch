+    Mixed into the primitives C structures are built from.  Inside a union a
+    write made through any of them, even one kept from vsGetField, is
+    committed to the union at once.
+    '''
+    def vsSetValue(self, value):
+        ret = super().vsSetValue(value)
+        _commit(self)
+        return ret
+
+    def vsParse(self, fbytes, offset=0):
+        ret = super().vsParse(fbytes, offset=offset)
