+class CStruct(vstruct.VStruct):
+    '''
+    A structure built from C source.  Inside a union its writes are committed
+    to the union at once.
+    '''
+    def vsSetField(self, name, value):
+        old = self._vs_values.get(name)
+        ret = vstruct.VStruct.vsSetField(self, name, value)
+        union = self.__dict__.get('_vs_cunion')
+        if union is not None and self._vs_values[name] is not old:
+            _adopt(self._vs_values[name], union, self.__dict__['_vs_cmember'])
+            _commit(self)
+        return ret
+
+
+class CUnion(vstruct.VUnion):
+    '''
+    A union built from C source.  Its members are views of one byte string:
+    a write through any of them is copied into it at once, and every member
+    is then read back from it.
+    '''
+    def __init__(self, bigend=False):
+        vstruct.VUnion.__init__(self, bigend=bigend)
+        self._vs_fmt = None
+        self._vs_ubytes = b''
+
+    def vsGetFastParseFields(self):
+        return [self]
+
+    def vsGetOffset(self, name, offset=0):
+        fname, _, rest = name.partition('.')
+        field = self._vs_values.get(fname)
+        if field is None:
+            raise Exception('Invalid Field Specified!')
+        if rest:
+            return field.vsGetOffset(rest, offset=offset)
+        return offset
+
+    def vsEmit(self, fast=False):
+        return self._vs_ubytes.ljust(len(self), b'\x00')[:len(self)]
+
+    def vsParse(self, sbytes, offset=0, fast=False):
+        end = offset + len(self)
+        self._vsShare(bytes(sbytes[offset:end]))
+        return end
+
+    def vsSetField(self, name, value):
+        old = self._vs_values.get(name)
+        ret = vstruct.VStruct.vsSetField(self, name, value)
+        field = self._vs_values[name]
+        if field is not old:
+            _adopt(field, self, field)
+            self._vsCommit(field)
+        return ret
+
+    def _vsCommit(self, member):
+        mbytes = member.vsEmit()
+        self._vsShare(mbytes + self.vsEmit()[len(mbytes):])
+
+    def _vsShare(self, ubytes):
+        busy = self.__dict__.get('_vs_cbusy')
+        self.__dict__['_vs_cbusy'] = True
+        try:
+            self._vs_ubytes = ubytes
+            for fname, fobj in self.vsGetFields():
+                fobj.vsParse(ubytes)
+        finally:
+            self.__dict__['_vs_cbusy'] = busy
+        _commit(self)
