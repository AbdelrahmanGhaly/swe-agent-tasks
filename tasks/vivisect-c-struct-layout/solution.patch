+def _intval(text):
+    text = text.rstrip('uUlL')
+    if text[:2] in ('0x', '0X'):
+        return int(text[2:], 16)
+    if text[:2] in ('0b', '0B'):
+        return int(text[2:], 2)
+    if len(text) > 1 and text[0] == '0':
+        return int(text[1:], 8)
+    return int(text)
+
+
+def _charval(text):
+    quote = text.index("'")
+    chars = text[quote + 1:-1].encode('latin-1').decode('unicode_escape')
+    if quote:
+        return ord(chars[-1])
+    value = 0
+    for char in chars:
+        value = ((value << 8) | (ord(char) & 0xff)) & 0xffffffff
+    if len(chars) == 1 and value & 0x80:
+        return value - 0x100
+    if value & 0x80000000:
+        return value - (1 << 32)
+    return value
