+class v_cfloat(vs_prim.v_float):
+    '''
+    A C float.  It emits the bytes it parsed until it is assigned, so NaN
+    payloads survive, and it skips the struct.pack fast path.
+    '''
+    def __init__(self, bigend=False):
+        vs_prim.v_float.__init__(self, bigend=bigend)
+        self._vs_cfmt = self._vs_fmt
+        self._vs_fmt = None
+        self._vs_raw = None
+
+    def vsSetValue(self, value):
+        vs_prim.v_float.vsSetValue(self, value)
