+            raise Exception('Incomplete type: %s %s' % (self.kind, self.name))
+
+        if self.kind == 'union':
+            vs = CUnion(bigend=bigend)
+        else:
+            vs = CStruct(bigend=bigend)
+        vs._vs_name = self.name
+
+        for item in self.items:
+            if item[0] == 'pad':
+                vs.vsAddField(item[1], _cprim(vs_prim.v_bytes)(size=item[2]))
+            elif item[0] == 'field':
