+# -----------------------------------------------------------------------------
+# AVDTP signalling fragmentation
+# -----------------------------------------------------------------------------
+def test_avdtp_message_filling_a_single_packet_is_not_fragmented():
+    sent = send_avdtp(48, bytes(46))
+
+    assert len(sent) == 1
+    assert avdtp_packet_type(sent[0]) == avdtp.Protocol.PacketType.SINGLE_PACKET
+    assert sent[0][2:] == bytes(46)
+
+
+def test_avdtp_fragmentation_carries_every_byte_in_the_fewest_packets():
+    payload = bytes(range(256)) * 3
+    sent = send_avdtp(48, payload)
+    expected = 1 + -(-(len(payload) - (48 - 3)) // (48 - 1))
+
+    carried = sent[0][3:] + b''.join(pdu[1:] for pdu in sent[1:])
+    types = [avdtp_packet_type(pdu) for pdu in sent]
+
+    assert carried == payload
+    assert len(sent) == expected
+    assert types[0] == avdtp.Protocol.PacketType.START_PACKET
+    assert types[-1] == avdtp.Protocol.PacketType.END_PACKET
+    assert all(
+        packet_type == avdtp.Protocol.PacketType.CONTINUE_PACKET
+        for packet_type in types[1:-1]
+    )
+
+
+def test_avdtp_fragmentation_declares_the_packet_count():
+    payload = bytes(range(256)) * 3
+    sent = send_avdtp(48, payload)
+    expected = 1 + -(-(len(payload) - (48 - 3)) // (48 - 1))
+
+    assert sent[0][2] == expected
+    assert sent[0][2] == len(sent)
+
+
+def test_avdtp_continuation_packets_use_the_full_mtu():
+    sent = send_avdtp(48, bytes(range(256)) * 3)
+
+    assert all(len(pdu) == 48 for pdu in sent[1:-1])
+
+
