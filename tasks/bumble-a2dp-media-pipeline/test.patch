+def test_avdtp_single_packet_message_reassembles():
+    collected: list[tuple[int, avdtp.Message]] = []
+    assembler = avdtp.MessageAssembler(
+        lambda label, message: collected.append((label, message))
+    )
+    payload = bytes(range(46))
+
+    for pdu in send_avdtp(48, payload, transaction_label=5):
+        assembler.on_pdu(pdu)
+
+    assert len(collected) == 1
+    assert collected[0][1].payload == payload
+
