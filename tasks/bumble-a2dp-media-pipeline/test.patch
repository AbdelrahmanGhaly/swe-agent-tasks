+#!/bin/sh
+set -u
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")"
+
+JUNIT=""
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  JUNIT="--junitxml=$OUTPUT_PATH"
+fi
+
+NEW_TESTS="tests/media_packetization_ee3b3d_test.py"
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_TESTS" -p no:cacheprovider $JUNIT
+  exit $?
+fi
+
+# Base mode runs the media path: tests/a2dp_test.py, tests/avdtp_test.py,
+# tests/avrcp_test.py and tests/codecs_test.py are the modules that import
+# bumble/a2dp.py, bumble/avdtp.py and bumble/rtp.py.
+#
+# The rest of the suite is left out because it depends on the environment rather
+# than on this area: the android-netsim transport cases need the gRPC extra, the
+# usb cases need a working libusb, and several host cases use millisecond
+# timeouts.
+python -m pytest \
+  tests/a2dp_test.py \
+  tests/avdtp_test.py \
+  tests/avrcp_test.py \
+  tests/codecs_test.py \
+  -p no:cacheprovider $JUNIT
+exit $?
