+async def test_aac_packet_source_timestamps_count_samples():
+    header = b'\xff\xf0\x10\x00\x01\xa0\x00'
+    payload = b'\x00' * 6
+    source = a2dp.AacPacketSource(Reader((header + payload) * 3).read, 672)
+
+    packets = [packet async for packet in source.packets]
+
+    assert packets[0].timestamp == 0
+    assert packets[1].timestamp == 1024
+    assert packets[2].timestamp == 2048
