+# -----------------------------------------------------------------------------
+def sbc_frame_length(
+    subbands: int, channels: int, blocks: int, bitpool: int, channel_mode: int
+) -> int:
+    """Length in bytes of an SBC frame with the given parameters."""
+    length = 4 + (4 * subbands * channels) // 8
+
+    if channel_mode in (SBC_MONO_CHANNEL_MODE, SBC_DUAL_CHANNEL_MODE):
+        return length + math.ceil(blocks * channels * bitpool / 8)
+
+    join = 1 if channel_mode == SBC_JOINT_STEREO_CHANNEL_MODE else 0
+    return length + math.ceil((join * subbands + blocks * bitpool) / 8)
+
+
