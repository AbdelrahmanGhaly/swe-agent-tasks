+def sbc_frame_parameters(header: bytes) -> tuple[int, int, int, int, int, int, int]:
+    """Decode an SBC frame header into its parameters and the frame length."""
+    if len(header) < 4 or header[0] != SBC_SYNC_WORD:
+        raise InvalidPacketError('invalid SBC frame header')
