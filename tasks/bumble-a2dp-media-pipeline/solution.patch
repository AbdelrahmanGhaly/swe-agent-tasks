+def sbc_media_payload_header(
+    frame_count: int,
+    fragmented: bool = False,
+    start: bool = False,
+    last: bool = False,
+) -> bytes:
+    """Single-octet media payload header that precedes SBC frames in an RTP payload."""
+    if not 0 <= frame_count <= SBC_MAX_FRAMES_IN_RTP_PAYLOAD:
+        raise InvalidArgumentError(
+            f'{frame_count} does not fit the four bit frame counter'
+        )
+    return bytes(
+        [
+            (0x80 if fragmented else 0)
+            | (0x40 if fragmented and start else 0)
+            | (0x20 if fragmented and last else 0)
+            | frame_count
+        ]
+    )
