+def _moon(radii=None):
+    pc = PlanetaryConstants()
+    pc.read_text(load('moon_080317.tf'))
+    pc.read_text(load('pck00008.tpc'))
+    pc.read_binary(load('moon_pa_de421_1900-2050.bpc'))
+    if radii is not None:
+        pc.variables['BODY301_RADII'] = list(radii)
+    return pc, pc.build_frame_named('MOON_ME_DE421')
+
+
+def _jupiter():
+    pc = PlanetaryConstants()
+    pc.read_text(load('pck00008.tpc'))
+    pc.read_binary(open(_path('jupiter-iau-2021.bpc'), 'rb'))
+    pc.variables.update({
+        'FRAME_IAU_JUPITER': 10015,
+        'FRAME_10015_NAME': 'IAU_JUPITER',
+        'FRAME_10015_CLASS': 2,
+        'FRAME_10015_CLASS_ID': 599,
+        'FRAME_10015_CENTER': 599,
+    })
+    return pc, pc.build_frame_named('IAU_JUPITER')
+
