+def _assert_jupiter_changes(f, rows, values):
+    jd0, jd1 = SUN_JUPITER[:2]
+    t, y = find_discrete(ts.tdb_jd(jd0), ts.tdb_jd(jd1), f)
+    _assert_times(t, [row[0] for row in rows])
+    assert list(y) == values
+
+
+def _assert_changes_between(f, rows, values):
+    jd0 = T0 + (rows[0][0] - 300.0) / DAY_S
+    jd1 = T0 + (rows[-1][0] + 300.0) / DAY_S
+    t, y = find_discrete(ts.tdb_jd(jd0), ts.tdb_jd(jd1), f)
+    _assert_times(t, [row[0] for row in rows])
+    assert list(y) == values
+
+
+def _frames():
+    pc, frame = _moon()
+    pc.read_text(BytesIO(FRAME_KERNEL))
+    return pc
+
+
+def _position(frame, t, xyz_km):
+    R = frame.rotation_at(t)
+    return ICRF(mxv(T(R), np.array(xyz_km) / AU_KM), t=t, center=301)
+
+
+def _enu(lat, lon):
+    lat, lon = np.radians(lat), np.radians(lon)
+    north = np.array([-np.sin(lat) * np.cos(lon), -np.sin(lat) * np.sin(lon),
+                      np.cos(lat)])
+    east = np.array([-np.sin(lon), np.cos(lon), 0.0])
+    up = np.array([np.cos(lat) * np.cos(lon), np.cos(lat) * np.sin(lon),
+                   np.sin(lat)])
+    return north, east, up
+
+
+def _degrees_apart(a, b):
+    return abs((np.asarray(a) - b + 180.0) % 360.0 - 180.0)
+
+
+def _assert_latlon(lat, lon, want_lat, want_lon):
+    assert abs(lat.degrees - want_lat) < 1e-8
+    assert -180.0 <= lon.degrees < 180.0
+    if abs(want_lat) < 89.9999:
+        assert _degrees_apart(lon.degrees, want_lon) < 1e-8
+
+
+def _seconds(t):
+    return (t.whole - T0) * DAY_S + t.tdb_fraction * DAY_S
+
+
+def _assert_times(t, seconds):
+    got = _seconds(t)
+    assert got.shape == (len(seconds),)
+    if len(seconds):
+        assert abs(got - seconds).max() < 1.0
+
+
+def _assert_sites(key):
+    pc, frame = _moon(RADII[key])
+    t = ts.tdb_jd(2458849.5)
+    for name, lat, lon, elevation_m, x, y, z in FORWARD:
+        if name != key:
+            continue
+        site = pc.build_latlon_degrees(frame, lat, lon, elevation_m)
+        xyz = site.at(t).frame_xyz(frame).km
+        assert abs(xyz - [x, y, z]).max() < 1e-6
+
+
+def _unique(categories):
+    return [row for row in UNIQUE if row[1] in categories]
+
+
+def _assert_inverse(rows):
+    t = ts.tdb_jd(2458849.5)
+    for row in rows:
+        pc, frame = _moon(RADII[row[0]])
+        position = _position(frame, t, row[2:5])
+        lat, lon = pc.latlon_of(frame, position)
+        _assert_latlon(lat, lon, row[5], row[6])
+        assert abs(pc.height_of(frame, position).km - row[7]) < 1e-6
+
+
+def _assert_events(observer, target, t0, t1, rises, sets, transits):
+    t, flags = almanac.find_risings(observer, target, t0, t1)
+    _assert_times(t, rises)
+    assert list(flags) == [True] * len(rises)
+    t, flags = almanac.find_settings(observer, target, t0, t1)
+    _assert_times(t, sets)
+    assert list(flags) == [True] * len(sets)
+    _assert_times(almanac.find_transits(observer, target, t0, t1), transits)
+
+
+def _assert_rotations(pc, names):
+    for row in FRAMES:
+        if row[0] not in names:
+            continue
+        frame = pc.build_frame_named(row[0])
+        R = frame.rotation_at(ts.tdb_jd(row[1]))
+        assert abs(R - np.reshape(row[2:], (3, 3))).max() < 1e-10
+
