+def test_sites_keep_latitude_longitude_and_elevation():
+    pc, frame = _moon(RADII['tri'])
+    site = pc.build_latlon_degrees(frame, -62.5, 135.0, 1250.0)
+    assert site.center == 301
+    assert abs(site.latitude.degrees - -62.5) < 1e-8
+    assert abs(site.longitude.degrees - 135.0) < 1e-8
+    assert abs(site.elevation.m - 1250.0) < 1e-3
+
+
+def test_spherical_sites_are_unchanged():
+    pc, frame = _moon()
+    t = ts.tdb_jd(2458849.5)
+    for lat, lon, elevation_m in ((26.3, -46.8, 0.0), (-10.0, 120.0, 3000.0),
+                                  (60.0, 10.0, -1736400.0)):
+        site = pc.build_latlon_degrees(frame, lat, lon, elevation_m)
+        up = _enu(lat, lon)[2]
+        want = (1737.4 + elevation_m / 1e3) * up
+        assert abs(site.at(t).frame_xyz(frame).km - want).max() < 1e-6
+        assert abs(site.elevation.m - elevation_m) < 1e-3
+
+
+def test_latlon_of_inverts_build_latlon_degrees():
+    t = ts.tdb_jd(2458849.5)
+    for key, lat, lon, elevation_m, x, y, z in FORWARD:
+        pc, frame = _moon(RADII[key])
+        position = pc.build_latlon_degrees(frame, lat, lon, elevation_m).at(t)
+        latitude, longitude = pc.latlon_of(frame, position)
+        assert abs(latitude.degrees - lat) < 1e-8
+        assert _degrees_apart(longitude.degrees, lon) < 1e-8
+        assert abs(pc.height_of(frame, position).m - elevation_m) < 1e-3
+
