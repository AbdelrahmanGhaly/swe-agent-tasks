+def test_sub_earth_point_on_a_spherical_moon_is_the_libration():
+    pc, frame = _moon()
+    eph = _ephemeris('de421.bsp')
+    t = ts.utc(2019, 12, 20, 11, 5)
+    position = (eph['earth'] - eph['moon']).at(t)
+    lat, lon = pc.latlon_of(frame, position)
+    want_lat, want_lon, distance = position.frame_latlon(frame)
+    assert abs(lat.degrees - want_lat.degrees) < 1e-8
+    assert _degrees_apart(lon.degrees, want_lon.degrees) < 1e-8
+    assert -180.0 <= lon.degrees < 180.0
+    assert round(lat.degrees, 3) == -6.749
+    assert round(lon.degrees, 3) == 1.520
