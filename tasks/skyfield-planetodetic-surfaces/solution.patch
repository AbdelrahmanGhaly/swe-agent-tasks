 """Routines solving basic geometric problems in astronomy."""
 
+from numpy import argmin, copysign, errstate, maximum, sqrt
 from .functions import dots, length_of, nan, sqrt_nan, where
 
 def intersect_line_and_sphere(endpoint, center, radius):
@@ -59,5 +60,54 @@ def line_and_ellipsoid_intersection(line_start, line_direction, radii):
     intersection = closest_point + sign * half_chord_length * unit_direction
     return where(startmag == 1.0, line_start, intersection * radii)
 
+def nearest_point_on_ellipsoid(position, radii):
+    """Return the point on an ellipsoid's surface nearest a position.
+
+    The ellipsoid is centered at the origin and is specified by its
+    three ``radii`` that point along the three coordinate axes.  The
+    |xyz| ``position`` can lie inside or outside of the ellipsoid.
+
+    Returns the |xyz| surface point, and the distance to it from the
+    ``position``, which is negative for positions inside the ellipsoid.
+    Where several surface points are equally near, one is returned.
+
+    """
+    shape = (3,) + (1,) * (len(position.shape) - 1)
+    radii = radii.reshape(shape)
+    r2 = radii * radii
+    m = r2.min()
+    is_smallest = r2 == m
+    y = abs(position)
+    ry = radii * y
+
+    # Bisect for the u > 0 where sum((ry / (r2 - m + u))**2) == 1.
+    shift = r2 - m
+    lo = where(is_smallest, ry, 0.0).max(axis=0)
+    hi = maximum(length_of(ry), m)
+    with errstate(all='ignore'):
+        for i in range(2000):
+            u = (lo + hi) / 2.0
+            if ((u == lo) | (u == hi)).all():
+                break
+            q = ry / (shift + u)
+            is_outside = dots(q, q) > 1.0
+            lo = where(is_outside, u, lo)
+            hi = where(is_outside, hi, u)
+        point = r2 * y / (shift + u)
+
+    # With zeros along the smallest axis there may be no root, and the
+    # nearest point lies off the coordinate plane instead.
+    q = where(is_smallest, 0.0, ry / where(is_smallest, 1.0, r2 - m))
+    qq = dots(q, q)
+    is_flat = where(is_smallest, y, 0.0).max(axis=0) == 0.0
+    off_plane = radii * q
+    off_plane[argmin(r2)] = radii[argmin(r2)] * sqrt(maximum(1.0 - qq, 0.0))
+    point = where(is_flat & (qq <= 1.0), off_plane, point)
+
+    point = copysign(point, position)
+    height = length_of(position - point)
+    is_inside = dots(position / radii, position / radii) < 1.0
+    return point, where(is_inside, -height, height)
+
 def _vector_projection(a, b):
     return dots(a,b) / dots(b,b) * b
