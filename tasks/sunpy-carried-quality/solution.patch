+"""
+Helpers for carrying the mask and the uncertainty of a map through the operations that
+build a new map from it.
+"""
+import numpy as np
+
+import astropy.units as u
+from astropy.nddata import InverseVariance, VarianceUncertainty
+
+__all__ = []
+
+# Interpolating a field of ones and zeros does not land exactly on zero where none of it
+# was there. A rotation leaves a residue a few multiples of the machine epsilon wide, and a
+# projection out to world coordinates and back leaves one of up to a few parts in ten
+# billion. The square root of the machine epsilon, about one part in seventy million, is
+# far above either, so a support under it is read as nothing rather than as a pixel worth
+# rescaling by.
+_NO_SUPPORT = np.sqrt(np.finfo(float).eps)
+
+# The values a reduction is read on are squares rather than a run of whole numbers, so
+# that a block's median is not its mean and the two cannot be confused.
+def _reduction_probe(block_shape):
+    rows, columns = int(block_shape[0]), int(block_shape[1])
+    count = 2 * rows * 2 * columns
+    return (np.arange(1.0, count + 1.0) ** 2).reshape(2, rows, 2, columns)
+
+
+def variance_of(uncertainty):
+    """
+    Return the variance held by an uncertainty, whatever kind of uncertainty it is.
+
+    Parameters
+    ----------
+    uncertainty : `~astropy.nddata.NDUncertainty`
+        The uncertainty to read.
+
+    Returns
+    -------
+    `numpy.ndarray`
+        The variance, as a float array.
+    """
+    array = np.asarray(uncertainty.array, dtype=float)
+    if isinstance(uncertainty, VarianceUncertainty):
+        return array
+    if isinstance(uncertainty, InverseVariance):
+        with np.errstate(divide='ignore'):
+            return 1 / array
+    return array ** 2
+
+
+def uncertainty_like(uncertainty, variance, unit=None):
+    """
+    Return an uncertainty of the same kind as ``uncertainty`` that holds ``variance``.
+
+    Parameters
+    ----------
+    uncertainty : `~astropy.nddata.NDUncertainty`
+        The uncertainty whose kind and unit are to be reused.
+    variance : `numpy.ndarray`
+        The variance the new uncertainty is to hold.
+    unit : `~astropy.units.Unit`, optional
+        The unit for the new uncertainty, when it differs from the old one.
+
+    Returns
+    -------
+    `~astropy.nddata.NDUncertainty`
+        An uncertainty of the same class as ``uncertainty``.
+    """
+    variance = np.asarray(variance, dtype=float)
+    if isinstance(uncertainty, VarianceUncertainty):
+        array = variance
+    elif isinstance(uncertainty, InverseVariance):
+        with np.errstate(divide='ignore'):
+            array = 1 / variance
+    else:
+        array = np.sqrt(variance)
+    return type(uncertainty)(array, unit=uncertainty.unit if unit is None else unit)
+
+
+def scaled_unit(uncertainty, value):
+    """
+    Return the unit an uncertainty takes once its data has been multiplied by ``value``.
+
+    An uncertainty that carries no unit of its own is read in the unit of the data it
+    belongs to, so it needs no adjusting and `None` comes back. One that carries its own
+    unit has to be moved along with the data.
+
+    Parameters
+    ----------
+    uncertainty : `~astropy.nddata.NDUncertainty`
+        The uncertainty whose unit is in question.
+    value : number, array-like or `~astropy.units.Quantity`
+        The other side of the multiplication.
+
+    Returns
+    -------
+    `~astropy.units.Unit` or `None`
+    """
+    if uncertainty.unit is None or not isinstance(value, u.Quantity):
+        return None
+    return uncertainty.unit * unit_in_kind_of(uncertainty, value.unit)
+
+
+def unit_in_kind_of(uncertainty, unit):
+    """
+    Return ``unit`` raised to the power the kind of ``uncertainty`` reports in.
+
+    A standard deviation is reported in the unit of the data it belongs to, a variance
+    in the square of that unit and an inverse variance in its inverse square.
+
+    Parameters
+    ----------
+    uncertainty : `~astropy.nddata.NDUncertainty`
+        The uncertainty whose kind sets the power.
+    unit : `~astropy.units.Unit`
+        The unit of the data.
+
+    Returns
+    -------
+    `~astropy.units.Unit`
+    """
+    if isinstance(uncertainty, VarianceUncertainty):
+        return unit ** 2
+    if isinstance(uncertainty, InverseVariance):
+        return unit ** -2
+    return unit
+
+
+def scaled_uncertainty(uncertainty, factor):
+    """
+    Return the uncertainty of a quantity that has been scaled by ``factor``.
+
+    The stored values are scaled in the form they are already held in: a standard
+    deviation by the size of the factor, a variance by its square and an inverse variance
+    by its inverse square. The uncertainty keeps its kind, a factor of one leaves the
+    values exactly as they were, and no value passes through a square it does not need,
+    so a large but representable standard deviation stays representable.
+
+    Parameters
+    ----------
+    uncertainty : `~astropy.nddata.NDUncertainty` or `None`
+        The uncertainty to scale. `None` is returned unchanged.
+    factor : float or array-like
+        The factor the quantity was scaled by.
+
+    Returns
+    -------
+    `~astropy.nddata.NDUncertainty` or `None`
+    """
+    if uncertainty is None:
+        return None
+    unit = scaled_unit(uncertainty, factor)
+    size = scale_factor_of(factor)
+    array = np.asarray(uncertainty.array, dtype=float)
+    if isinstance(uncertainty, VarianceUncertainty):
+        scaled = array * size ** 2
+    elif isinstance(uncertainty, InverseVariance):
+        with np.errstate(divide='ignore'):
+            scaled = array / size ** 2
+    else:
+        scaled = array * size
+    return type(uncertainty)(leading_2d(scaled), unit=uncertainty.unit if unit is None else unit)
+
+
+def leading_2d(array):
+    """
+    Return an array cut down to two dimensions the way a map cuts its data down.
+
+    Arithmetic with an operand that broadcasts wider than the map leaves a result of that
+    wider shape, and a map keeps the last two dimensions of it and drops the rest. An
+    uncertainty has to be cut down the same way round or it stops matching the data it
+    belongs to.
+
+    Parameters
+    ----------
+    array : `numpy.ndarray`
+        The array to cut down.
+
+    Returns
+    -------
+    `numpy.ndarray`
+    """
+    array = np.asarray(array)
+    if array.ndim <= 2:
+        return array
+    return array[(0,) * (array.ndim - 2)]
+
+
+def matched_2d(array, data):
+    """
+    Return an array spread over the two dimensions a map's data came out as.
+
+    An operand can widen a dimension the map holds a single pixel of, which leaves a
+    result that is still two dimensional but wider than the mask and the uncertainty that
+    went in, so those have to be spread over it to go on matching the data pixel for
+    pixel.
+
+    Parameters
+    ----------
+    array : array-like or `None`
+        The array to spread. `None` is returned unchanged.
+    data : array-like
+        The data the array has to match, before a map cuts it down to two dimensions.
+
+    Returns
+    -------
+    `numpy.ndarray` or `None`
+    """
+    if array is None:
+        return None
+    return np.broadcast_to(leading_2d(array), leading_2d(data).shape).copy()
+
+
+def matched_uncertainty(uncertainty, data):
+    """
+    Return an uncertainty spread over the two dimensions a map's data came out as.
+
+    Scaling by an array widens the values along with the data, but adding one leaves them
+    as they were, so an uncertainty can come out of arithmetic narrower than the result it
+    belongs to and has to be spread over it the way the mask is.
+
+    Parameters
+    ----------
+    uncertainty : `~astropy.nddata.NDUncertainty` or `None`
+        The uncertainty to spread. `None` is returned unchanged.
+    data : array-like
+        The data the uncertainty has to match, before a map cuts it down to two
+        dimensions.
+
+    Returns
+    -------
+    `~astropy.nddata.NDUncertainty` or `None`
+    """
+    if uncertainty is None:
+        return None
+    return type(uncertainty)(matched_2d(uncertainty.array, data), unit=uncertainty.unit)
+
+
+def scale_factor_of(value):
+    """
+    Return the size of the number a map's data was scaled by, dropping any unit it carried.
+
+    The uncertainty follows the size of the factor rather than its sign or its phase, so a
+    negative or a complex factor scales it by its magnitude.
+
+    Parameters
+    ----------
+    value : number, array-like or `~astropy.units.Quantity`
+        The other side of the multiplication.
+
+    Returns
+    -------
+    `numpy.ndarray`
+    """
+    return np.abs(np.asarray(getattr(value, 'value', value)))
+
+
+def sliced_uncertainty(uncertainty, item):
+    """
+    Return the part of an uncertainty that covers a slice of the data.
+
+    Parameters
+    ----------
+    uncertainty : `~astropy.nddata.NDUncertainty` or `None`
+        The uncertainty to cut down. `None` is returned unchanged.
+    item : tuple
+        The slice applied to the data.
+
+    Returns
+    -------
+    `~astropy.nddata.NDUncertainty` or `None`
+    """
+    if uncertainty is None:
+        return None
+    return type(uncertainty)(np.asarray(uncertainty.array)[item].copy(),
+                             unit=uncertainty.unit)
+
+
+def carried_uncertainty(uncertainty, interpolate, source_mask=None, mask=None,
+                        prepare=None):
+    """
+    Return an uncertainty carried onto a new grid by the same machinery as the data.
+
+    The variance is what travels, since that is what an interpolation of independent
+    pixels combines, and a variance that interpolation has pushed below zero is read as
+    zero rather than as a number no uncertainty can hold.
+
+    Parameters
+    ----------
+    uncertainty : `~astropy.nddata.NDUncertainty` or `None`
+        The uncertainty to carry over. `None` is returned unchanged.
+    interpolate : callable
+        Takes one float array and returns it on the new grid.
+    source_mask : `numpy.ndarray` or `None`
+        The pixels going in that are masked, and so take no part in the interpolation.
+    mask : `numpy.ndarray` or `None`
+        The pixels of the result that are masked, and so have no uncertainty.
+    prepare : callable, optional
+        Applied to the variance before it is interpolated, so that it reaches the
+        interpolation shaped exactly as the data did.
+
+    Returns
+    -------
+    `~astropy.nddata.NDUncertainty` or `None`
+    """
+    if uncertainty is None:
+        return None
+    variance = variance_of(uncertainty)
+    if prepare is not None:
+        variance = prepare(variance)
+    if source_mask is None:
+        carried = interpolate(variance)
+    else:
+        carried, _ = interpolate_around_mask(interpolate, variance, source_mask, np.nan)
+    carried = np.clip(carried, 0, None)
+    if mask is not None:
+        carried = np.where(mask, np.nan, carried)
+    return uncertainty_like(uncertainty, carried)
+
+
+def reduction_kind(func, block_shape):
+    """
+    Return whether a reduction sums the pixels of a block, averages them, or neither.
+
+    A superpixel takes any callable that reads an array and an ``axis``, so which of
+    them a reduction is has to be read from what it does rather than from which function
+    object it happens to be: `numpy.ma.sum` sums exactly as `numpy.sum` does. The
+    callable is applied to blocks of the size the caller asked for, along one axis and
+    then the other, exactly as `~sunpy.map.GenericMap.superpixel` applies it, and the
+    pair of passes together is compared with summing and with averaging the same blocks
+    the same way round. Both the block size and both passes matter. A callable that
+    behaves one way on an even axis and another way on an odd one turns a three by three
+    block into its mean while turning a two by four block into its sum, and a callable
+    that sums along one axis and takes the largest along the other is neither, so asking
+    about one shape or one axis alone would call both of them sums. The comparison is
+    exact rather than approximate, so a reduction that merely lands near a sum keeps no
+    uncertainty, which is what anything that is not a sum or a mean does.
+
+    Parameters
+    ----------
+    func : callable
+        The reduction applied to the data.
+    block_shape : tuple
+        The number of pixels making up a block, ordered as the data array is.
+
+    Returns
+    -------
+    str or `None`
+        ``'sum'``, ``'mean'``, or `None` for anything else.
+    """
+    probe = _reduction_probe(block_shape)
+    try:
+        reduced = np.asarray(func(func(probe, axis=3), axis=1), dtype=float)
+    except Exception:
+        return None
+    if reduced.shape != (probe.shape[0], probe.shape[2]):
+        return None
+    if np.array_equal(reduced, np.sum(np.sum(probe, axis=3), axis=1)):
+        return 'sum'
+    if np.array_equal(reduced, np.mean(np.mean(probe, axis=3), axis=1)):
+        return 'mean'
+    return None
+
+
+def shape_from_buffers(reproject_args):
+    """
+    Return the output shape a caller's own output buffers imply.
+
+    A reprojection may be told how large its output is by the target WCS, by an explicit
+    ``shape_out``, or by nothing more than a buffer handed in for it to fill. The passes
+    made for the support field and the variance cannot be given that buffer, so where it
+    is the only thing carrying the shape, the shape has to travel in its place.
+
+    Parameters
+    ----------
+    reproject_args : dict
+        The keyword arguments the caller passed for the reprojection.
+
+    Returns
+    -------
+    tuple or `None`
+        The shape of the first buffer that was passed, or `None` if none was.
+    """
+    for key in ('output_array', 'output_footprint'):
+        buffer = reproject_args.get(key)
+        if buffer is not None:
+            return np.shape(buffer)
+    return None
+
+
+def aggregated_variance(variance, counts, block_shape, offset, func):
+    """
+    Return the variance of blocks of pixels that have been reduced by ``func``.
+
+    Only summing and averaging have a variance that follows from the variance of the
+    pixels going in, so anything else returns `None`.
+
+    Parameters
+    ----------
+    variance : `numpy.ndarray`
+        The variance of each pixel, zero wherever the pixel is masked.
+    counts : `numpy.ndarray`
+        How many unmasked pixels each block holds.
+    block_shape : tuple
+        The number of pixels making up a block, ordered as the data array is.
+    offset : tuple
+        The pixel the first block starts at, ordered as the data array is.
+    func : callable
+        The reduction applied to the data.
+
+    Returns
+    -------
+    `numpy.ndarray` or `None`
+    """
+    kind = reduction_kind(func, block_shape)
+    if kind is None:
+        return None
+    total = np.sum(reshape_to_blocks(variance, block_shape, offset), axis=(3, 1))
+    if kind == 'sum':
+        return total
+    # The mean of N pixels divides their sum by N, so its variance divides by N squared,
+    # and N counts only the pixels that were actually averaged.
+    with np.errstate(divide='ignore', invalid='ignore'):
+        return total / np.asarray(counts, dtype=float) ** 2
+
+
+def reshape_to_blocks(array, block_shape, offset):
+    """
+    Cut an array into a four dimensional view of whole blocks of pixels.
+
+    Parameters
+    ----------
+    array : `numpy.ndarray`
+        The array to cut up.
+    block_shape : tuple
+        The number of pixels making up a block, ordered as the data array is.
+    offset : tuple
+        The pixel the first block starts at, ordered as the data array is.
+
+    Returns
+    -------
+    `numpy.ndarray`
+    """
+    from sunpy.map.mapbase import reshape_image_to_4d_superpixel
+    return reshape_image_to_4d_superpixel(array, [block_shape[0], block_shape[1]],
+                                          [offset[0], offset[1]])
+
+
+def support_of(interpolate, mask):
+    """
+    Return what fraction of each output pixel's support was really there.
+
+    An interpolation of a field that is one at the unmasked pixels and zero at the masked
+    ones says, for every output pixel, how much of what it was built from was a pixel
+    that counts. That is measured against the same interpolation of a field that is one
+    everywhere, so what comes back is a fraction rather than a weight. The difference
+    matters when the interpolation scales its output: a flux conserving reprojection
+    multiplies both passes by the same area factor, and dividing one by the other is what
+    keeps that factor in the result instead of cancelling it. It is what an interpolated
+    value has to be divided by, and where it is nothing, no unmasked pixel reached that
+    output pixel at all.
+
+    Parameters
+    ----------
+    interpolate : callable
+        The interpolation the data goes through.
+    mask : array-like
+        The mask of the data going in.
+
+    Returns
+    -------
+    `numpy.ndarray`
+    """
+    present = ~np.asarray(mask, dtype=bool)
+    support = interpolate(np.where(present, 1.0, 0.0))
+    whole = interpolate(np.ones(present.shape, dtype=float))
+    with np.errstate(divide='ignore', invalid='ignore'):
+        return support / whole
+
+
+def unsupported(support):
+    """
+    Return where an interpolation had no unmasked pixel behind it.
+
+    Interpolating a field of ones and zeros does not land exactly on zero, and outside
+    the region an interpolation covers it lands on nothing at all, so both are read as
+    no support rather than as a pixel worth rescaling by.
+
+    Parameters
+    ----------
+    support : `numpy.ndarray`
+        The support field.
+
+    Returns
+    -------
+    `numpy.ndarray`
+    """
+    return ~(support > _NO_SUPPORT)
+
+
+def interpolate_around_mask(interpolate, data, mask, missing):
+    """
+    Interpolate data so that the masked pixels contribute nothing to the result.
+
+    The unmasked pixels are interpolated as they would have been, and alongside them a
+    field of ones is interpolated the same way. Dividing one by the other rescales every
+    output pixel by however much of its support was actually there, so a masked pixel
+    neither adds a value nor dilutes its neighbours. A pixel whose support was masked
+    all the way through has nothing to rescale and comes out missing.
+
+    Parameters
+    ----------
+    interpolate : callable
+        Takes one float array and returns the interpolated array.
+    data : `numpy.ndarray`
+        The pixel values.
+    mask : `numpy.ndarray`
+        The pixels to leave out, as booleans.
+    missing : float
+        The value given to an output pixel with no unmasked support.
+
+    Returns
+    -------
+    tuple
+        The interpolated data and the mask that goes with it.
+    """
+    present = ~np.asarray(mask, dtype=bool)
+    interpolated = interpolate(np.where(present, np.asarray(data, dtype=float), 0.0))
+    support = support_of(interpolate, mask)
+    empty = unsupported(support)
+    with np.errstate(divide='ignore', invalid='ignore'):
+        rescaled = interpolated / support
+    return np.where(empty, missing, rescaled), empty
+
+
+def masked_variance_of(uncertainty, mask):
+    """
+    Return the variance of an uncertainty with the masked pixels taken out.
+
+    Parameters
+    ----------
+    uncertainty : `~astropy.nddata.NDUncertainty`
+        The uncertainty to read.
+    mask : `numpy.ndarray` or `None`
+        The pixels to leave out, as booleans.
+
+    Returns
+    -------
+    `numpy.ndarray`
+        The variance, zero wherever the pixel is masked.
+    """
+    variance = variance_of(uncertainty)
+    if mask is None:
+        return variance
+    return np.where(np.asarray(mask, dtype=bool), 0.0, variance)
+
+
+def counted_blocks(mask, block_shape, offset):
+    """
+    Return how many unmasked pixels each block of pixels holds.
+
+    Parameters
+    ----------
+    mask : `numpy.ndarray` or `None`
+        The pixels to leave out, as booleans.
+    block_shape : tuple
+        The number of pixels making up a block, ordered as the data array is.
+    offset : tuple
+        The pixel the first block starts at, ordered as the data array is.
+
+    Returns
+    -------
+    `numpy.ndarray`
+        The count for each block, as floats.
+    """
+    if mask is None:
+        counts = np.full(1, float(block_shape[0] * block_shape[1]))
+        return counts
+    present = np.where(np.asarray(mask, dtype=bool), 0.0, 1.0)
+    return np.sum(reshape_to_blocks(present, block_shape, offset), axis=(3, 1))
+
+
+def in_unit_of(uncertainty, header):
+    """
+    Return an uncertainty reporting the unit that the map built from ``header`` reports.
+
+    A map reads its unit from the header it is built with, so an uncertainty travelling
+    onto a header that names no unit must stop naming one too, or the pair disagree. One
+    travelling onto a header that does name a unit reports it in the power its kind
+    implies.
+
+    Parameters
+    ----------
+    uncertainty : `~astropy.nddata.NDUncertainty` or `None`
+        The uncertainty about to travel. `None` is returned unchanged.
+    header : dict-like
+        The header the new map is built from.
+
+    Returns
+    -------
+    `~astropy.nddata.NDUncertainty` or `None`
+    """
+    if uncertainty is None or uncertainty.unit is None:
+        return uncertainty
+    unit = header.get('bunit') or header.get('BUNIT')
+    if unit is not None:
+        unit = unit_in_kind_of(uncertainty, u.Unit(unit))
+    return type(uncertainty)(uncertainty.array, unit=unit)
