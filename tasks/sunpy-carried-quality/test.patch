+#!/bin/sh
+set -u
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+else
+  OUTPUT_PATH="results.xml"
+fi
+
+NEW_TESTS="sunpy/map/tests/test_carried_quality_c962d5.py"
+LOG="$(mktemp 2>/dev/null || echo /tmp/test-sh-output.log)"
+
+export MPLBACKEND=Agg
+export PYTHONHASHSEED=0
+export SUNPY_DOWNLOADDIR=/tmp/sunpy-downloads
+export SETUPTOOLS_SCM_PRETEND_VERSION="${SETUPTOOLS_SCM_PRETEND_VERSION:-8.1.dev96+gb9fb3034f}"
+
+cd "$(dirname "$0")" || exit 1
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_TESTS" -v -p no:cacheprovider --junitxml="$OUTPUT_PATH" > "$LOG" 2>&1
+  EXIT_CODE=$?
+else
+  # test_resample_rotated_map_pc and test_resample_rotated_map_cd are hypothesis
+  # property tests carrying a wall clock deadline of one second, so they report
+  # DeadlineExceeded on a loaded machine no matter what the code under them does.
+  python -m pytest \
+    sunpy/map/tests \
+    sunpy/image/tests \
+    --ignore="$NEW_TESTS" \
+    --deselect sunpy/map/tests/test_mapbase.py::test_resample_rotated_map_pc \
+    --deselect sunpy/map/tests/test_mapbase.py::test_resample_rotated_map_cd \
+    -v -p no:cacheprovider --junitxml="$OUTPUT_PATH" > "$LOG" 2>&1
+  EXIT_CODE=$?
+fi
+
+cat "$LOG"
+
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  DETAIL=$(tail -c 6000 "$LOG" 2>/dev/null | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
+  if [ -z "$DETAIL" ]; then
+    DETAIL="pytest wrote no output before it stopped."
+  fi
+  cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+<testsuite name="pytest" tests="1" failures="1" errors="0" time="0">
+<testcase name="collection" classname="sunpy.map.tests.test_carried_quality_c962d5">
+<failure message="pytest wrote no test case, so it stopped before or during collection">
+$DETAIL
+</failure>
+</testcase>
+</testsuite>
+</testsuites>
+XMLEOF
+  if [ "$EXIT_CODE" -eq 0 ]; then
+    EXIT_CODE=1
+  fi
+fi
+
+rm -f "$LOG"
+exit $EXIT_CODE
