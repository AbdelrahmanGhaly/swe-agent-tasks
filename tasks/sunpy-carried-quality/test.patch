+    quality = sunpy.map.Map(variance.copy(), header_for(variance),
+                            uncertainty=VarianceUncertainty(variance.copy()))
+    out = travelled(quality, operation, setting)
+    carried = out.uncertainty.array
+    together = np.isfinite(out.data) & np.isfinite(carried) & (out.data > 0)
+    assert together.sum() >= 4
+    assert np.allclose(carried[together], out.data[together])
