+def test_every_route_keeps_a_masked_outlier_out_of_both(operation, setting):
+    out = travelled(spoiled_in_both(), operation, setting)
+    live = np.isfinite(out.data) & ~out.mask
+    carried = out.uncertainty.array
+    kept = np.isfinite(carried) & ~out.mask
+    assert live.sum() >= 4
+    assert kept.sum() >= 4
+    assert out.data[live].max() < 2.0
+    assert carried[kept].max() < 1.0
