+"""
+Test that a map's mask and uncertainty are carried through the operations that build a
+new map from it.
+"""
+import numpy as np
+import pytest
+
+import astropy.units as u
+import reproject
+from astropy.coordinates import SkyCoord
+from astropy.nddata import InverseVariance, StdDevUncertainty, VarianceUncertainty
+from astropy.wcs import WCS
+
+import sunpy.map
+from sunpy.coordinates import frames
+from sunpy.image.resample import resample as sunpy_image_resample
+
+
+def header_for(data, scale=2):
+    reference = SkyCoord(0 * u.arcsec, 0 * u.arcsec, obstime='2013-10-28',
+                         observer='earth', frame=frames.Helioprojective)
+    return sunpy.map.make_fitswcs_header(
+        data, reference,
+        reference_pixel=[(data.shape[1] - 1) / 2, (data.shape[0] - 1) / 2] * u.pixel,
+        scale=[scale, scale] * u.arcsec / u.pixel)
+
+
+def make_map(size=8, mask_at=((0, 0), (3, 4)), sigma=0.5, unit=None):
+    data = np.arange(size * size, dtype=float).reshape(size, size) + 1.0
+    header = header_for(data)
+    if unit is not None:
+        header['bunit'] = unit
+    mask = None
+    if mask_at is not None:
+        mask = np.zeros((size, size), dtype=bool)
+        for row, column in mask_at:
+            mask[row, column] = True
+    uncertainty = None
+    if sigma is not None:
+        uncertainty = StdDevUncertainty(np.full((size, size), sigma))
+    return sunpy.map.Map(data, header, mask=mask, uncertainty=uncertainty)
+
+
+def target_wcs(size=6, scale=3):
+    return WCS(header_for(np.zeros((size, size)), scale=scale))
+
+
+@pytest.fixture
+def quality_map():
+    return make_map()
+
+
+@pytest.fixture
+def plain_map():
+    return make_map(mask_at=None, sigma=None)
+
+
+def test_submap_carries_both(quality_map):
+    cut = quality_map.submap([1, 1] * u.pixel, top_right=[5, 5] * u.pixel)
+    assert cut.uncertainty.array.shape == cut.data.shape
+    assert np.allclose(cut.uncertainty.array, 0.5)
+    assert cut.mask.shape == cut.data.shape
+    assert bool(cut.mask[2, 3])
+    assert int(cut.mask.sum()) == 1
+
+
+def test_resample_carries_both(quality_map):
+    smaller = quality_map.resample([4, 4] * u.pixel)
+    assert smaller.mask is not None
+    assert smaller.mask.dtype == bool
+    assert smaller.mask.shape == smaller.data.shape
+    assert smaller.uncertainty.array.shape == smaller.data.shape
+
+
+def test_rotate_carries_both(quality_map):
+    turned = quality_map.rotate(90 * u.deg, order=1, missing=0.0)
+    assert turned.mask.dtype == bool
+    assert turned.mask.shape == turned.data.shape
+    assert turned.uncertainty.array.shape == turned.data.shape
+
+
+def test_rotate_keeps_the_masked_pixels(quality_map):
+    turned = quality_map.rotate(90 * u.deg, order=1, missing=0.0)
+    assert int(turned.mask.sum()) == 2
+
+
+def test_rotate_masks_what_comes_in_from_outside(quality_map):
+    turned = quality_map.rotate(30 * u.deg, order=1, missing=0.0)
+    assert int(turned.mask.sum()) > 2
+    assert bool(turned.mask[0, 0])
+
+
+def test_shift_reference_coord_carries_both(quality_map):
+    shifted = quality_map.shift_reference_coord(1 * u.arcsec, 1 * u.arcsec)
+    assert np.array_equal(shifted.mask, quality_map.mask)
+    assert np.allclose(shifted.uncertainty.array, quality_map.uncertainty.array)
+
+
+def test_reproject_carries_both(quality_map):
+    reprojected = quality_map.reproject_to(target_wcs())
+    assert reprojected.mask is not None
+    assert reprojected.mask.shape == reprojected.data.shape
+    assert reprojected.uncertainty.array.shape == reprojected.data.shape
+
+
+def test_reproject_masks_what_no_pixel_reached(quality_map):
+    reprojected = quality_map.reproject_to(target_wcs(size=12, scale=3))
+    assert bool(reprojected.mask[0, 0])
+
+
+def test_masked_pixels_do_not_reach_the_interpolation():
+    data = np.ones((6, 6))
+    data[2, 2] = 1000.0
+    mask = np.zeros((6, 6), dtype=bool)
+    mask[2, 2] = True
+    spoiled = sunpy.map.Map(data, header_for(data), mask=mask)
+    turned = spoiled.rotate(15 * u.deg, order=1, missing=np.nan)
+    around = turned.data[~turned.mask & np.isfinite(turned.data)]
+    assert np.nanmax(around) < 2.0
+
+
+def test_a_pixel_with_no_unmasked_support_is_masked():
+    data = np.ones((6, 6))
+    mask = np.ones((6, 6), dtype=bool)
+    mask[4:, 4:] = False
+    blanked = sunpy.map.Map(data, header_for(data), mask=mask)
+    turned = blanked.rotate(0 * u.deg, order=1, missing=-1.0)
+    assert bool(turned.mask[0, 0])
+    assert turned.data[0, 0] == -1.0
+
+
+def test_uncertainty_is_not_a_number_where_the_result_is_masked(quality_map):
+    turned = quality_map.rotate(30 * u.deg, order=1, missing=0.0)
+    assert np.all(np.isnan(turned.uncertainty.array[turned.mask]))
+
+
+def test_uncertainty_never_goes_below_zero(quality_map):
+    turned = quality_map.rotate(20 * u.deg, order=3, missing=0.0)
+    finite = turned.uncertainty.array[np.isfinite(turned.uncertainty.array)]
+    assert np.all(finite >= 0)
+
+
+def test_superpixel_adds_variances_when_summing(quality_map):
+    blocks = quality_map.superpixel([2, 2] * u.pixel, func=np.sum)
+    assert np.allclose(blocks.uncertainty.array[0, 1], np.sqrt(4 * 0.25))
+
+
+def test_superpixel_counts_only_unmasked_pixels(quality_map):
+    blocks = quality_map.superpixel([2, 2] * u.pixel, func=np.sum)
+    assert np.allclose(blocks.uncertainty.array[0, 0], np.sqrt(3 * 0.25))
+
+
+def test_superpixel_mean_divides_by_the_squared_count(quality_map):
+    blocks = quality_map.superpixel([2, 2] * u.pixel, func=np.mean)
+    assert np.allclose(blocks.uncertainty.array[0, 0], np.sqrt(3 * 0.25) / 3)
+    assert np.allclose(blocks.uncertainty.array[0, 1], np.sqrt(4 * 0.25) / 4)
+
+
+def test_superpixel_leaves_no_uncertainty_for_other_reductions(quality_map):
+    assert quality_map.superpixel([2, 2] * u.pixel, func=np.sum).uncertainty is not None
+    for reduction in (np.min, np.max, np.std):
+        assert quality_map.superpixel([2, 2] * u.pixel, func=reduction).uncertainty is None
+
+
+def test_superpixel_conservative_mask_rule_stands(quality_map):
+    conservative = quality_map.superpixel([2, 2] * u.pixel, func=np.sum,
+                                          conservative_mask=True)
+    assert bool(conservative.mask[0, 0])
+    assert not bool(conservative.mask[0, 1])
+    assert np.isnan(conservative.uncertainty.array[0, 0])
+    assert np.allclose(conservative.uncertainty.array[0, 1], np.sqrt(4 * 0.25))
+
+
+@pytest.mark.parametrize('kind', [StdDevUncertainty, VarianceUncertainty, InverseVariance])
+def test_uncertainty_keeps_its_kind(kind):
+    values = {StdDevUncertainty: 0.5, VarianceUncertainty: 0.25, InverseVariance: 4.0}[kind]
+    data = np.ones((6, 6))
+    quality = sunpy.map.Map(data, header_for(data),
+                            uncertainty=kind(np.full((6, 6), values)))
+    assert isinstance((quality * 2).uncertainty, kind)
+    assert isinstance(quality.submap([1, 1] * u.pixel,
+                                     top_right=[4, 4] * u.pixel).uncertainty, kind)
+
+
+@pytest.mark.parametrize(('kind', 'before', 'after'), [
+    (StdDevUncertainty, 0.5, 1.0),
+    (VarianceUncertainty, 0.25, 1.0),
+    (InverseVariance, 4.0, 1.0),
+])
+def test_scaling_follows_the_kind(kind, before, after):
+    data = np.ones((6, 6))
+    quality = sunpy.map.Map(data, header_for(data),
+                            uncertainty=kind(np.full((6, 6), before)))
+    assert np.allclose((quality * 2).uncertainty.array, after)
+
+
+def test_adding_leaves_the_uncertainty(quality_map):
+    assert np.allclose((quality_map + 2).uncertainty.array, 0.5)
+
+
+def test_subtracting_leaves_the_uncertainty(quality_map):
+    assert np.allclose((quality_map - 2).uncertainty.array, 0.5)
+
+
+def test_negating_leaves_the_uncertainty(quality_map):
+    assert np.allclose((-quality_map).uncertainty.array, 0.5)
+
+
+def test_dividing_scales_the_uncertainty(quality_map):
+    assert np.allclose((quality_map / 2).uncertainty.array, 0.25)
+
+
+def test_arithmetic_carries_the_mask(quality_map):
+    assert np.array_equal((quality_map * 3).mask, quality_map.mask)
+
+
+def test_power_leaves_no_uncertainty(quality_map):
+    assert np.allclose((quality_map * 2).uncertainty.array, 1.0)
+    assert (quality_map ** 2).uncertainty is None
+
+
+def test_dividing_into_a_number_leaves_no_uncertainty(quality_map):
+    assert np.allclose((quality_map / 2).uncertainty.array, 0.25)
+    assert (2 / quality_map).uncertainty is None
+
+
+def test_the_unit_follows_the_data():
+    quality = make_map(size=6, mask_at=None, unit='ct')
+    quality = sunpy.map.Map(quality.data, quality.meta,
+                            uncertainty=StdDevUncertainty(np.full((6, 6), 0.5), unit=u.ct))
+    scaled = quality * (2 * u.s)
+    assert scaled.unit == u.ct * u.s
+    assert scaled.uncertainty.unit == u.ct * u.s
+
+
+def test_sequence_reports_a_stacked_uncertainty(quality_map):
+    sequence = sunpy.map.Map([quality_map, quality_map], sequence=True)
+    assert sequence.uncertainty.array.shape == sequence.data.shape
+
+
+def test_sequence_reports_nothing_when_no_map_has_one(plain_map):
+    sequence = sunpy.map.Map([plain_map, plain_map], sequence=True)
+    assert sequence.uncertainty is None
+
+
+def test_nothing_is_invented(plain_map, quality_map):
+    assert plain_map.submap([1, 1] * u.pixel, top_right=[4, 4] * u.pixel).mask is None
+    assert plain_map.resample([4, 4] * u.pixel).uncertainty is None
+    assert plain_map.rotate(30 * u.deg, order=1).mask is None
+    assert plain_map.superpixel([2, 2] * u.pixel).uncertainty is None
+    assert (plain_map * 2).uncertainty is None
+    assert quality_map.resample([4, 4] * u.pixel).uncertainty is not None
+
+
+def test_an_unmasked_map_is_resampled_exactly_as_before(plain_map, quality_map):
+    expected = np.array([[10.0, 12.0, 15.0], [26.0, 28.0, 31.0], [50.0, 52.0, 55.0]])
+    assert np.allclose(plain_map.resample([3, 3] * u.pixel, method='nearest').data,
+                       expected)
+    assert quality_map.resample([3, 3] * u.pixel, method='nearest').mask is not None
+
+
+def test_an_unmasked_map_keeps_its_rotated_data(plain_map, quality_map):
+    turned = plain_map.rotate(90 * u.deg, order=1, missing=0.0)
+    assert np.allclose(np.sort(turned.data.ravel()), np.sort(plain_map.data.ravel()))
+    assert quality_map.rotate(90 * u.deg, order=1, missing=0.0).mask is not None
+
+
+def spoiled_map(size=8, outlier=1000.0):
+    data = np.ones((size, size))
+    sigma = np.full((size, size), 0.5)
+    sigma[3, 3] = outlier
+    mask = np.zeros((size, size), dtype=bool)
+    mask[3, 3] = True
+    return sunpy.map.Map(data, header_for(data), mask=mask,
+                         uncertainty=StdDevUncertainty(sigma))
+
+
+def unmasked_uncertainty(quality):
+    values = quality.uncertainty.array
+    return values[np.isfinite(values) & ~quality.mask]
+
+
+def test_resample_keeps_a_masked_outlier_out_of_the_uncertainty():
+    smaller = spoiled_map().resample([5, 5] * u.pixel)
+    assert unmasked_uncertainty(smaller).max() < 1.0
+
+
+def test_rotate_keeps_a_masked_outlier_out_of_the_uncertainty():
+    turned = spoiled_map().rotate(17 * u.deg, order=1, missing=np.nan)
+    assert unmasked_uncertainty(turned).max() < 1.0
+
+
+def test_reproject_keeps_a_masked_outlier_out_of_the_uncertainty():
+    reprojected = spoiled_map().reproject_to(target_wcs())
+    assert unmasked_uncertainty(reprojected).max() < 1.0
+
+
+def test_resample_keeps_a_masked_outlier_out_of_the_data():
+    data = np.ones((8, 8))
+    data[3, 3] = 1000.0
+    mask = np.zeros((8, 8), dtype=bool)
+    mask[3, 3] = True
+    spoiled = sunpy.map.Map(data, header_for(data), mask=mask)
+    smaller = spoiled.resample([5, 5] * u.pixel)
+    around = smaller.data[~smaller.mask & np.isfinite(smaller.data)]
+    assert np.nanmax(around) < 2.0
+
+
+def test_an_uninterpolated_uncertainty_keeps_its_exact_value():
+    quality = make_map(size=8, mask_at=None)
+    turned = quality.rotate(90 * u.deg, order=1, missing=0.0)
+    assert np.allclose(turned.uncertainty.array, 0.5)
+
+
+def test_a_zero_variance_stays_exactly_zero_through_a_spline():
+    data = np.ones((8, 8))
+    quality = sunpy.map.Map(data, header_for(data),
+                            uncertainty=VarianceUncertainty(np.zeros((8, 8))))
+    turned = quality.rotate(23 * u.deg, order=3, missing=0.0)
+    carried = turned.uncertainty.array
+    assert np.all(carried[np.isfinite(carried)] == 0.0)
+
+
+@pytest.mark.parametrize('operation', ['resample', 'rotate', 'reproject'])
+def test_uncertainty_is_not_a_number_wherever_the_mask_lands(operation, quality_map):
+    if operation == 'resample':
+        out = quality_map.resample([5, 5] * u.pixel)
+    elif operation == 'rotate':
+        out = quality_map.rotate(30 * u.deg, order=1, missing=0.0)
+    else:
+        out = quality_map.reproject_to(target_wcs(size=12, scale=3))
+    assert np.all(np.isnan(out.uncertainty.array[out.mask]))
+
+
+def test_a_fully_masked_superpixel_has_no_uncertainty_left():
+    data = np.ones((4, 4))
+    mask = np.zeros((4, 4), dtype=bool)
+    mask[0:2, 0:2] = True
+    quality = sunpy.map.Map(data, header_for(data), mask=mask,
+                            uncertainty=StdDevUncertainty(np.full((4, 4), 0.5)))
+    blocks = quality.superpixel([2, 2] * u.pixel, func=np.sum)
+    assert bool(blocks.mask[0, 0])
+    assert np.isnan(blocks.uncertainty.array[0, 0])
+    assert np.allclose(blocks.uncertainty.array[0, 1], np.sqrt(4 * 0.25))
+
+
+@pytest.mark.parametrize('kind', [StdDevUncertainty, VarianceUncertainty, InverseVariance])
+@pytest.mark.parametrize('operation',
+                         ['resample', 'rotate', 'superpixel', 'shift', 'reproject'])
+def test_the_kind_survives_every_operation(kind, operation):
+    values = {StdDevUncertainty: 0.5, VarianceUncertainty: 0.25, InverseVariance: 4.0}[kind]
+    data = np.ones((8, 8))
+    quality = sunpy.map.Map(data, header_for(data),
+                            uncertainty=kind(np.full((8, 8), values)))
+    outputs = {
+        'resample': lambda: quality.resample([4, 4] * u.pixel),
+        'rotate': lambda: quality.rotate(10 * u.deg, order=1, missing=0.0),
+        'superpixel': lambda: quality.superpixel([2, 2] * u.pixel, func=np.sum),
+        'shift': lambda: quality.shift_reference_coord(1 * u.arcsec, 1 * u.arcsec),
+        'reproject': lambda: quality.reproject_to(target_wcs()),
+    }
+    assert isinstance(outputs[operation]().uncertainty, kind)
+
+
+@pytest.mark.parametrize(('kind', 'before', 'after'), [
+    (StdDevUncertainty, u.ct, u.ct * u.s),
+    (VarianceUncertainty, u.ct ** 2, u.ct ** 2 * u.s ** 2),
+    (InverseVariance, u.ct ** -2, u.ct ** -2 / u.s ** 2),
+])
+def test_the_unit_follows_the_data_for_every_kind(kind, before, after):
+    header = header_for(np.ones((6, 6)))
+    header['bunit'] = 'ct'
+    quality = sunpy.map.Map(np.ones((6, 6)), header,
+                            uncertainty=kind(np.full((6, 6), 1.0), unit=before))
+    scaled = quality * (2 * u.s)
+    assert scaled.unit == u.ct * u.s
+    assert scaled.uncertainty.unit == after
+
+
+def test_a_plain_map_gains_nothing_from_shift_or_reprojection(plain_map, quality_map):
+    shifted = plain_map.shift_reference_coord(1 * u.arcsec, 1 * u.arcsec)
+    assert shifted.mask is None
+    assert shifted.uncertainty is None
+    reprojected = plain_map.reproject_to(target_wcs(size=12, scale=3))
+    assert reprojected.mask is None
+    assert reprojected.uncertainty is None
+    assert quality_map.reproject_to(target_wcs()).uncertainty is not None
+
+
+def test_reprojection_still_reports_coverage_through_the_footprint(plain_map, quality_map):
+    reprojected, footprint = plain_map.reproject_to(target_wcs(size=12, scale=3),
+                                                    return_footprint=True)
+    assert reprojected.mask is None
+    assert (footprint == 0).any()
+    masked = quality_map.reproject_to(target_wcs(size=12, scale=3))
+    assert bool(masked.mask[0, 0])
+
+
+def test_a_sequence_stacks_the_values_it_was_given(quality_map):
+    other = make_map(sigma=0.25)
+    sequence = sunpy.map.Map([quality_map, other], sequence=True)
+    stacked = sequence.uncertainty.array
+    assert stacked.shape == sequence.data.shape
+    assert np.allclose(stacked[..., 0], 0.5)
+    assert np.allclose(stacked[..., 1], 0.25)
+
+
+def test_a_sequence_with_only_one_uncertainty_reports_the_rest_as_not_a_number(quality_map,
+                                                                               plain_map):
+    sequence = sunpy.map.Map([quality_map, plain_map], sequence=True)
+    stacked = sequence.uncertainty.array
+    assert np.allclose(stacked[..., 0], 0.5)
+    assert np.all(np.isnan(stacked[..., 1]))
+
+
+def constant_map(size=8, value=7.0, mask_at=((3, 3),)):
+    data = np.full((size, size), value)
+    mask = np.zeros((size, size), dtype=bool)
+    for row, column in mask_at:
+        mask[row, column] = True
+    return sunpy.map.Map(data, header_for(data), mask=mask,
+                         uncertainty=StdDevUncertainty(np.full((size, size), 0.5)))
+
+
+@pytest.mark.parametrize('operation', ['resample', 'rotate', 'reproject'])
+def test_partial_support_is_renormalised_not_diluted(operation):
+    quality = constant_map()
+    if operation == 'resample':
+        out = quality.resample([5, 5] * u.pixel)
+    elif operation == 'rotate':
+        out = quality.rotate(17 * u.deg, order=1, missing=np.nan)
+    else:
+        out = quality.reproject_to(target_wcs())
+    around = out.data[~out.mask & np.isfinite(out.data)]
+    assert np.allclose(around, 7.0)
+
+
+def test_reprojection_keeps_a_masked_outlier_out_of_the_data():
+    data = np.ones((8, 8))
+    data[3, 3] = 1000.0
+    mask = np.zeros((8, 8), dtype=bool)
+    mask[3, 3] = True
+    spoiled = sunpy.map.Map(data, header_for(data), mask=mask)
+    reprojected = spoiled.reproject_to(target_wcs())
+    around = reprojected.data[~reprojected.mask & np.isfinite(reprojected.data)]
+    assert np.nanmax(around) < 2.0
+
+
+def test_a_varying_variance_is_never_carried_below_zero():
+    data = np.ones((10, 10))
+    variance = np.zeros((10, 10))
+    variance[4:6, 4:6] = 9.0
+    quality = sunpy.map.Map(data, header_for(data),
+                            uncertainty=VarianceUncertainty(variance))
+    turned = quality.rotate(23 * u.deg, order=3, missing=0.0)
+    carried = turned.uncertainty.array
+    finite = carried[np.isfinite(carried)]
+    assert np.all(finite >= 0)
+    assert np.any(finite == 0.0)
+
+
+@pytest.mark.parametrize('kind', [VarianceUncertainty, InverseVariance])
+def test_the_kind_survives_arithmetic_that_does_not_scale(kind):
+    values = {VarianceUncertainty: 0.25, InverseVariance: 4.0}[kind]
+    data = np.ones((6, 6))
+    quality = sunpy.map.Map(data, header_for(data),
+                            uncertainty=kind(np.full((6, 6), values)))
+    for result in (quality + 2, quality - 2, -quality, quality / 2):
+        assert isinstance(result.uncertainty, kind)
+    assert np.allclose((quality + 2).uncertainty.array, values)
+
+
+@pytest.mark.parametrize('operation',
+                         ['submap', 'resample', 'rotate', 'superpixel', 'shift', 'reproject'])
+def test_a_plain_map_gains_neither_attribute(plain_map, quality_map, operation):
+    def run(source):
+        return {
+            'submap': lambda: source.submap([1, 1] * u.pixel, top_right=[4, 4] * u.pixel),
+            'resample': lambda: source.resample([4, 4] * u.pixel),
+            'rotate': lambda: source.rotate(30 * u.deg, order=1, missing=0.0),
+            'superpixel': lambda: source.superpixel([2, 2] * u.pixel, func=np.sum),
+            'shift': lambda: source.shift_reference_coord(1 * u.arcsec, 1 * u.arcsec),
+            'reproject': lambda: source.reproject_to(target_wcs(size=12, scale=3)),
+        }[operation]()
+
+    plain = run(plain_map)
+    assert plain.mask is None
+    assert plain.uncertainty is None
+    carried = run(quality_map)
+    assert carried.mask is not None
+    assert carried.uncertainty is not None
+
+
+@pytest.mark.parametrize('operation',
