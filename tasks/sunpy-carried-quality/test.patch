+def travelled(quality, operation, setting):
+    if operation == 'resample':
+        return quality.resample([5, 5] * u.pixel, method=setting)
+    if operation == 'rotate':
+        return quality.rotate(23 * u.deg, order=setting, missing=np.nan, clip=False)
+    return quality.reproject_to(target_wcs(), algorithm=setting)
