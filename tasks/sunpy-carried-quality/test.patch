+def stored_variance(kind, variance):
+    if kind is VarianceUncertainty:
+        return variance
+    if kind is InverseVariance:
+        return 1.0 / variance
+    return np.sqrt(variance)
+
+
+def variance_held_by(kind, array):
+    if kind is VarianceUncertainty:
+        return array
+    if kind is InverseVariance:
+        return 1.0 / array
+    return array ** 2
+
+
+def unit_of_kind(kind, unit=u.ct):
+    return {StdDevUncertainty: unit, VarianceUncertainty: unit ** 2,
+            InverseVariance: unit ** -2}[kind]
