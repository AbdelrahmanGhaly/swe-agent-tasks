+  if (header.version !== 1) {
+    return layer2Allocations[4];
+  }
+  const channelBitrate = header.bitrate / 1000 / header.numberOfChannels;
+  const rate = header.samplingRate;
+  if ((rate === 48000 && channelBitrate >= 56) || (channelBitrate >= 56 && channelBitrate <= 80)) {
+    return layer2Allocations[0];
+  }
+  if (rate !== 48000 && channelBitrate >= 96) {
+    return layer2Allocations[1];
+  }
+  return rate !== 32000 && channelBitrate <= 48 ? layer2Allocations[2] : layer2Allocations[3];
+}
+
+/**
+ * Number of bits after the CRC field protected by the frame CRC.
+ * @returns undefined if the frame is too short to determine the protected bits
+ */
+function protectedBitLength(frame: Uint8Array, header: MpegFrameHeader): number | undefined {
+  if (header.layer === 3) {
+    return 8 * header.sideInfoLength;
+  }
+  const allocations = header.layer === 1 ? layer1Allocations : selectLayer2Allocations(header);
+  const channels = header.numberOfChannels;
+  const bound =
+    header.channelMode === 1 ? Math.min(4 * (header.modeExtension + 1), allocations.length) : allocations.length;
+  let bitPosition = 8 * crcFieldEnd;
+  const readBits = (length: number): number | undefined => {
+    let value = 0;
+    for (let n = 0; n < length; ++n, ++bitPosition) {
+      const byte = frame[bitPosition >> 3];
+      if (byte === undefined) {
+        return undefined;
+      }
+      value = (value << 1) | ((byte >> (7 - (bitPosition & 7))) & 1);
+    }
+    return value;
+  };
+  let allocatedSubbands = 0;
+  for (let subband = 0; subband < allocations.length; ++subband) {
+    const subbandChannels = subband < bound ? channels : 1;
+    for (let channel = 0; channel < subbandChannels; ++channel) {
+      const allocation = readBits(allocations[subband]);
+      if (allocation === undefined) {
+        return undefined;
+      }
+      if (allocation !== 0) {
+        allocatedSubbands += subband < bound ? 1 : channels;
+      }
+    }
+  }
+  // Layer II also protects the 2-bit scale factor selection of every allocated sub-band
+  const scfsiBits = header.layer === 2 ? 2 * allocatedSubbands : 0;
+  return bitPosition - 8 * crcFieldEnd + scfsiBits;
+}
+
+/**
+ * Frame length in bytes, a Layer I frame consists of 4-byte slots: (12 * bitrate / sampling rate + padding) * 4
+ */
+function frameLength(header: MpegFrameHeader): number {
+  return header.layer === 1
+    ? (Math.floor((12 * header.bitrate) / header.samplingRate) + (header.padding ? 1 : 0)) * 4
+    : header.frameSize;
+}
+
+interface IMusicRange {
+  next: number;
+  end: number;
+  crc: number;
+  stored: number;
+}
+
+/**
+ * The bits covered by a frame CRC and the CRCs of the LAME tag lie within the first 192 bytes of a frame
+ */
+const frameHeadLength = 192;
+
+/**
+ * An ID3v1 tag takes the last 128 bytes of a file
+ */
+const id3v1Length = 128;
+
+/**
+ * The MPEG parser peeks 1024 bytes ahead to find a frame, so a tokenizer it reads allows at least this lookahead
+ */
+const maxLookahead = 1024;
+
+/**
+ * Verifies MPEG audio frame CRCs and the CRCs of the LAME Info tag.
+ * Starting at the audio, the frames are found by their length and peeked, independent of the frames the parser reads.
+ * The parser skips bytes with skip(), which first verifies what a stream is about to pass,
+ * so the metadata parsing is left as it is. Peeks never go further ahead than the parser's own frame search.
+ */
+export class MpegChecksumVerifier {
+  private audioStart = 0;
+  private audioEnd = Number.POSITIVE_INFINITY;
+  private nextFrame = 0;
+  private frameNumber = 0;
+  private music?: IMusicRange;
+  private consumed: Uint8Array = new Uint8Array(0);
+  private readonly head = new Uint8Array(frameHeadLength);
+  private readonly tag = new Uint8Array(3);
+  private readonly chunk: Uint8Array;
+
+  /**
+   * @param collector Receives the verified checksums
+   * @param maxReadSize Maximum number of bytes to read at once, `IOptions.maxMemoryAllocation`
+   */
+  public constructor(
+    private readonly collector: IChecksumCollector,
+    maxReadSize: number
+  ) {
+    this.chunk = new Uint8Array(Math.min(4096, maxReadSize));
+  }
+
+  /**
+   * Start at the audio, which follows the ID3v2 tags
+   * @param tokenizer Tokenizer positioned after the ID3v2 tags
+   * @param consumed Bytes of the audio the tag parser has already read, up to the tokenizer position
+   */
+  public start(tokenizer: ITokenizer, consumed: Uint8Array): void {
+    this.audioStart = tokenizer.position - consumed.length;
+    this.nextFrame = this.audioStart;
+    this.consumed = consumed;
+  }
+
+  /**
+   * Skip bytes like tokenizer.ignore(), after verifying what the skipped bytes contain
+   * @param tokenizer Tokenizer
+   * @param length Number of bytes to skip
+   */
+  public async skip(tokenizer: ITokenizer, length: number): Promise<void> {
+    const end = tokenizer.position + length;
+    while (true) {
+      await this.verifyAhead(tokenizer);
+      const target = Math.min(end, this.pending());
+      await tokenizer.ignore(target - tokenizer.position);
+      if (target === end || tokenizer.position < target) {
+        return;
+      }
+    }
+  }
+
+  /**
+   * Verify what is left after the parser is done.
+   * A stream is read as far as needed, but not into the last 128 bytes, which the ID3v1 parser reads next.
+   * @param tokenizer Tokenizer
+   */
+  public async finish(tokenizer: ITokenizer): Promise<void> {
+    const size = tokenizer.fileInfo.size;
+    const readEnd = size ? size - id3v1Length : Number.POSITIVE_INFINITY;
+    try {
+      while (true) {
+        await this.verifyAhead(tokenizer);
+        const pending = this.pending();
+        const target = Math.min(pending, readEnd);
+        if (pending === Number.POSITIVE_INFINITY || target <= tokenizer.position) {
+          return;
+        }
+        await tokenizer.ignore(target - tokenizer.position);
+      }
+    } catch (error) {
+      if (!(error instanceof EndOfStreamError)) {
+        throw error;
+      }
+    }
+  }
+
+  /**
+   * Verify the frames, and add the music bytes to the music CRC, as far as they can be peeked
+   */
+  private async verifyAhead(tokenizer: ITokenizer): Promise<void> {
+    await this.walkFrames(tokenizer);
+    await this.hashMusic(tokenizer);
+  }
+
+  /**
+   * Position of the first byte which is still to be verified
+   */
+  private pending(): number {
+    const frame = this.nextFrame + MpegFrameHeader.len <= this.audioEnd ? this.nextFrame : Number.POSITIVE_INFINITY;
+    return this.music ? Math.min(frame, this.music.next) : frame;
+  }
+
+  /**
+   * Verify the frames as far as their heads can be peeked, bytes which are not a frame are skipped up to the next sync
+   */
+  private async walkFrames(tokenizer: ITokenizer): Promise<void> {
+    const head = this.head;
+    while (this.nextFrame + MpegFrameHeader.len <= this.audioEnd) {
+      const peekLength = Math.min(head.length, this.reach(tokenizer) - this.nextFrame);
+      if (peekLength < MpegFrameHeader.len + id3v1Length) {
+        return; // Wait until the parser moves on, as the header could be part of an ID3v1 tag
+      }
+      const length = await this.peek(tokenizer, head.subarray(0, peekLength), this.nextFrame);
+      if (length < peekLength) {
+        this.audioEnd = Math.min(this.audioEnd, await this.findAudioEnd(tokenizer, this.nextFrame + length));
+        if (this.nextFrame + MpegFrameHeader.len > this.audioEnd) {
+          return;
+        }
+      }
+      const sync = head[0] === 0xff && (head[1] & 0xe0) === 0xe0;
+      if (sync && AdtsFrameHeader.matches(head)) {
+        this.audioEnd = this.nextFrame; // ADTS is not verified
+        return;
+      }
+      const header = sync ? parseFrameHeader(head) : undefined;
+      if (!header) {
+        const next = head.subarray(1, length).indexOf(0xff);
+        this.nextFrame += next === -1 ? length : next + 1;
+        continue;
+      }
+      const headLength = Math.min(frameLength(header), head.length);
+      if (length === peekLength && length < headLength) {
+        return; // Wait until the head of the frame can be peeked
+      }
+      this.verifyFrame(head.subarray(0, Math.min(headLength, length)), header, this.nextFrame);
+      this.nextFrame += frameLength(header);
+    }
+  }
+
+  /**
+   * Verify the CRC of a frame, and the LAME tag in the first frame
+   * @param frame The first bytes of the frame
+   * @param header Parsed frame header
+   * @param frameStart Position of the frame
+   */
+  private verifyFrame(frame: Uint8Array, header: MpegFrameHeader, frameStart: number): void {
+    if (header.isProtectedByCRC) {
+      const bitLength = protectedBitLength(frame, header);
+      if (bitLength !== undefined && 8 * crcFieldEnd + bitLength <= 8 * frame.length) {
+        let crc = crc16Mpeg(frame.subarray(2, MpegFrameHeader.len));
+        crc = crc16Mpeg(frame.subarray(crcFieldEnd), bitLength, crc);
+        this.collector.addChecksum('mpegFrame', crc === ((frame[4] << 8) | frame[5]));
+      }
+    }
+    if (++this.frameNumber === 1) {
+      this.verifyLameTag(frame, header, frameStart);
+    }
+  }
+
+  private verifyLameTag(frame: Uint8Array, header: MpegFrameHeader, frameStart: number): void {
+    if (header.layer !== 3) {
+      return;
+    }
+    const tagOffset = MpegFrameHeader.len + header.sideInfoLength;
+    const id = String.fromCharCode(...frame.subarray(tagOffset, tagOffset + 4));
+    if (id !== 'Info' && id !== 'Xing') {
+      return;
+    }
+    const flags = frame[tagOffset + 7] ?? 0;
+    const lameOffset =
+      tagOffset + 8 + (flags & 1 ? 4 : 0) + (flags & 2 ? 4 : 0) + (flags & 4 ? 100 : 0) + (flags & 8 ? 4 : 0);
+    if (String.fromCharCode(...frame.subarray(lameOffset, lameOffset + 4)) !== 'LAME') {
+      return;
+    }
+    const version = String.fromCharCode(...frame.subarray(lameOffset + 4, lameOffset + 9)).match(/^(\d+)\.(\d+)/);
+    const [major, minor] = version ? [Number.parseInt(version[1], 10), Number.parseInt(version[2], 10)] : [0, 0];
+    if (major < 3 || (major === 3 && minor < 90)) {
+      return;
+    }
+    // LAME tag: 9 bytes version, then music length at 19, music CRC at 23 and the tag CRC at 25
+    const extension = lameOffset + 9;
+    const tagCrcOffset = extension + 25;
+    if (frame.length < tagCrcOffset + 2) {
+      return;
+    }
+    const tagCrc = (frame[tagCrcOffset] << 8) | frame[tagCrcOffset + 1];
+    this.collector.addChecksum('lameTag', crc16Lame(frame.subarray(0, tagCrcOffset)) === tagCrc);
+
+    const musicLength =
+      (frame[extension + 19] << 24) |
+      (frame[extension + 20] << 16) |
+      (frame[extension + 21] << 8) |
+      frame[extension + 22];
+    const musicStart = frameStart + frameLength(header);
+    const musicEnd = frameStart + (musicLength >>> 0);
+    if (musicEnd > musicStart) {
+      this.music = {
+        next: musicStart,
+        end: musicEnd,
+        crc: 0,
+        stored: (frame[extension + 23] << 8) | frame[extension + 24]
+      };
+    }
+  }
+
+  /**
+   * Add the music bytes to the music CRC as far as they can be peeked
+   */
+  private async hashMusic(tokenizer: ITokenizer): Promise<void> {
+    const music = this.music;
+    if (!music) {
+      return;
+    }
+    while (music.next < music.end) {
+      const available = this.reach(tokenizer) - music.next;
+      if (available <= 0) {
+        return;
+      }
+      const part = this.chunk.subarray(0, Math.min(this.chunk.length, music.end - music.next, available));
+      const length = await this.peek(tokenizer, part, music.next);
+      music.crc = crc16Lame(part.subarray(0, length), music.crc);
+      music.next += length;
+      if (length < part.length) {
+        this.music = undefined; // The file ends before the music does
+        return;
+      }
+    }
+    this.collector.addChecksum('lameMusic', music.crc === music.stored);
+    this.music = undefined;
+  }
+
+  /**
+   * The audio ends at an ID3v1 tag, or else at the end of the file
+   * @param tokenizer Tokenizer
+   * @param fileEnd End of the file
+   */
+  private async findAudioEnd(tokenizer: ITokenizer, fileEnd: number): Promise<number> {
+    const tagStart = fileEnd - id3v1Length;
+    if (tagStart >= this.audioStart && (await this.peek(tokenizer, this.tag, tagStart)) === this.tag.length) {
+      return isID3v1(this.tag) ? tagStart : fileEnd;
+    }
+    return fileEnd;
+  }
+
+  /**
+   * End of the bytes which can be peeked, a stream allows peeking maxLookahead bytes ahead of its position
+   */
+  private reach(tokenizer: ITokenizer): number {
+    return tokenizer.supportsRandomAccess() ? Number.POSITIVE_INFINITY : tokenizer.position + maxLookahead;
+  }
+
+  /**
+   * Peek bytes at a position. Bytes of the audio the ID3v2 parser has already read are taken from what it read.
+   * @returns Number of bytes peeked, fewer at the end of the file or when the bytes have been read already
+   */
+  private async peek(tokenizer: ITokenizer, buffer: Uint8Array, position: number): Promise<number> {
+    let length = 0;
+    if (position < tokenizer.position) {
+      const offset = position - this.audioStart;
+      if (offset < 0 || offset >= this.consumed.length) {
+        return 0;
+      }
+      length = Math.min(buffer.length, this.consumed.length - offset);
+      buffer.set(this.consumed.subarray(offset, offset + length));
+      if (length === buffer.length || position + length < tokenizer.position) {
+        return length;
+      }
+    }
+    const peeked = await tokenizer
+      .peekBuffer(buffer.subarray(length), { position: position + length, mayBeLess: true })
+      .catch(error => {
+        if (error instanceof EndOfStreamError) {
+          return 0;
+        }
+        throw error;
+      });
+    return length + peeked;
+  }
+}
+
+function isID3v1(tail: Uint8Array): boolean {
+  return tail[0] === 0x54 && tail[1] === 0x41 && tail[2] === 0x47;
+}
+
+function parseFrameHeader(bytes: Uint8Array): MpegFrameHeader | undefined {
+  try {
+    return new MpegFrameHeader(bytes);
+  } catch {
+    return undefined;
+  }
+}
