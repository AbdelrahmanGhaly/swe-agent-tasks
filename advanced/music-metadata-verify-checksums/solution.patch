+function makeTable(polynomial: number, width: 16 | 32, reflected: boolean): Uint32Array {
+  const table = new Uint32Array(256);
+  const topBit = 2 ** (width - 1);
+  const mask = 2 ** width - 1;
+  for (let n = 0; n < 256; ++n) {
+    let crc = reflected ? n : n * 2 ** (width - 8);
+    for (let bit = 0; bit < 8; ++bit) {
+      if (reflected) {
+        crc = crc & 1 ? (crc >>> 1) ^ polynomial : crc >>> 1;
+      } else {
+        crc = crc >= topBit ? (((crc - topBit) * 2) ^ polynomial) >>> 0 : crc * 2;
+      }
+    }
+    table[n] = (crc & mask) >>> 0;
+  }
+  return table;
+}
+
+const crc16AnsiTable = makeTable(0x8005, 16, false);
+const crc16ArcTable = makeTable(0xa001, 16, true);
+const crc32IeeeTable = makeTable(0xedb88320, 32, true);
+
+/**
+ * CRC-16 of MPEG audio frames (ISO/IEC 11172-3), polynomial 0x8005, computed over the first `bitLength` bits
+ * @param data Data covered by the CRC
+ * @param bitLength Number of bits to include, may end within a byte
+ * @param crc Running CRC value, initially 0xffff
+ */
+export function crc16Mpeg(data: Uint8Array, bitLength: number = data.length * 8, crc = 0xffff): number {
+  const bytes = bitLength >> 3;
+  for (let i = 0; i < bytes; ++i) {
+    crc = ((crc << 8) & 0xffff) ^ crc16AnsiTable[((crc >> 8) ^ data[i]) & 0xff];
+  }
+  for (let bit = 0; bit < (bitLength & 7); ++bit) {
+    const input = (data[bytes] >> (7 - bit)) & 1;
+    const top = (crc >> 15) & 1;
+    crc = (crc << 1) & 0xffff;
+    if (top ^ input) {
+      crc ^= 0x8005;
+    }
+  }
+  return crc;
+}
+
+/**
+ * CRC-16 used by the LAME Info tag (CRC-16/ARC)
+ * @param data Data covered by the CRC
+ * @param crc Running CRC value, initially 0
+ */
+export function crc16Lame(data: Uint8Array, crc = 0): number {
+  for (const byte of data) {
+    crc = (crc >>> 8) ^ crc16ArcTable[(crc ^ byte) & 0xff];
+  }
+  return crc;
+}
+
+/**
+ * IEEE CRC-32 (ISO 3309), as used by EBML
+ * @param data Data covered by the CRC
+ * @param crc CRC of the preceding data, initially 0
+ */
+export function crc32(data: Uint8Array, crc = 0): number {
+  let value = ~crc >>> 0;
+  for (const byte of data) {
+    value = (value >>> 8) ^ crc32IeeeTable[(value ^ byte) & 0xff];
+  }
+  return ~value >>> 0;
+}
