@@ -0,0 +1,295 @@
+import { crc32 } from 'node:zlib';
+import { concatUint8Arrays } from 'uint8array-extras';
+
+function latin1(text: string): Uint8Array {
+  return Uint8Array.from(text, char => char.charCodeAt(0));
+}
+
+function uint32BE(value: number): Uint8Array {
+  const bytes = new Uint8Array(4);
+  new DataView(bytes.buffer).setUint32(0, value);
+  return bytes;
+}
+
+function uint32LE(value: number): Uint8Array {
+  const bytes = new Uint8Array(4);
+  new DataView(bytes.buffer).setUint32(0, value, true);
+  return bytes;
+}
+
+function synchsafe(value: number, length = 4): Uint8Array {
+  const bytes = new Uint8Array(length);
+  for (let index = length - 1; index >= 0; --index) {
+    bytes[index] = value % 128;
+    value = Math.floor(value / 128);
+  }
+  return bytes;
+}
+
+function crc16Arc(data: Uint8Array): number {
+  let crc = 0;
+  for (const byte of data) {
+    crc ^= byte;
+    for (let bit = 0; bit < 8; ++bit) {
+      crc = crc & 1 ? (crc >>> 1) ^ 0xa001 : crc >>> 1;
+    }
+  }
+  return crc;
+}
+
+export function flipBits(data: Uint8Array, offset: number, mask = 0x01): Uint8Array {
+  const copy = Uint8Array.from(data);
+  copy[offset] ^= mask;
+  return copy;
+}
+
+export function truncate(data: Uint8Array, length: number): Uint8Array {
+  return data.slice(0, length);
+}
+
+export function withID3v1(data: Uint8Array, title: string): Uint8Array {
+  const tag = new Uint8Array(128);
+  tag.set(latin1('TAG'));
+  tag.set(latin1(title.slice(0, 30)), 3);
+  tag[127] = 255;
+  return concatUint8Arrays([data, tag]);
+}
+
+export function withLameVersion(data: Uint8Array, version: string): Uint8Array {
+  const copy = Uint8Array.from(data);
+  const lame = copy.findIndex((_, index) => String.fromCharCode(...copy.subarray(index, index + 4)) === 'LAME');
+  copy.set(latin1(version.padEnd(5).slice(0, 5)), lame + 4);
+  const tagCrc = lame + 9 + 25;
+  new DataView(copy.buffer).setUint16(tagCrc, crc16Arc(copy.subarray(0, tagCrc)));
+  return copy;
+}
+
+export function textFrame(version: 3 | 4, id: string, text: string): Uint8Array {
+  const payload = concatUint8Arrays([new Uint8Array([0]), latin1(text)]);
+  const size = version === 4 ? synchsafe(payload.length) : uint32BE(payload.length);
+  return concatUint8Arrays([latin1(id), size, new Uint8Array(2), payload]);
+}
+
+function unsynchronise(data: Uint8Array): Uint8Array {
+  const bytes: number[] = [];
+  data.forEach((byte, index) => {
+    bytes.push(byte);
+    const next = data[index + 1];
+    if (byte === 0xff && (next === undefined || next === 0 || (next & 0xe0) === 0xe0)) {
+      bytes.push(0);
+    }
+  });
+  return Uint8Array.from(bytes);
+}
+
+export interface ITagOptions {
+  padding?: number;
+  crc?: boolean;
+}
+
+export function id3v23Tag(frames: Uint8Array[], options: ITagOptions & { unsynchronise?: boolean } = {}): Uint8Array {
+  const padding = options.padding ?? 0;
+  const frameData = concatUint8Arrays(frames);
+  const extendedHeader = options.crc
+    ? concatUint8Arrays([uint32BE(10), new Uint8Array([0x80, 0]), uint32BE(padding), uint32BE(crc32(frameData))])
+    : concatUint8Arrays([uint32BE(6), new Uint8Array(2), uint32BE(padding)]);
+  let body: Uint8Array = concatUint8Arrays([extendedHeader, frameData, new Uint8Array(padding)]);
+  let flags = 0x40;
+  if (options.unsynchronise) {
+    body = unsynchronise(body);
+    flags |= 0x80;
+  }
+  return concatUint8Arrays([latin1('ID3'), new Uint8Array([3, 0, flags]), synchsafe(body.length), body]);
+}
+
+export function id3v24Tag(
+  frames: Uint8Array[],
+  options: ITagOptions & { update?: boolean; restrictions?: boolean; footer?: boolean; extended?: boolean } = {}
+): Uint8Array {
+  const covered = concatUint8Arrays([...frames, new Uint8Array(options.padding ?? 0)]);
+  const flagData: Uint8Array[] = [];
+  let flags = 0;
+  if (options.update) {
+    flags |= 0x40;
+    flagData.push(new Uint8Array([0]));
+  }
+  if (options.crc) {
+    flags |= 0x20;
+    flagData.push(new Uint8Array([5]), synchsafe(crc32(covered), 5));
+  }
+  if (options.restrictions) {
+    flags |= 0x10;
+    flagData.push(new Uint8Array([1, 0]));
+  }
+  const flagBytes = concatUint8Arrays(flagData);
+  const extended = options.extended ?? true;
+  const extendedHeader = extended
+    ? concatUint8Arrays([synchsafe(6 + flagBytes.length), new Uint8Array([1, flags]), flagBytes])
+    : new Uint8Array(0);
+  const body = concatUint8Arrays([extendedHeader, covered]);
+  const headerFlags = (extended ? 0x40 : 0) | (options.footer ? 0x10 : 0);
+  const header = concatUint8Arrays([new Uint8Array([4, 0, headerFlags]), synchsafe(body.length)]);
+  return concatUint8Arrays([
+    latin1('ID3'),
+    header,
+    body,
+    options.footer ? concatUint8Arrays([latin1('3DI'), header]) : new Uint8Array(0)
+  ]);
+}
+
+interface IEbmlElement {
+  id: number;
+  header: Uint8Array;
+  data: Uint8Array;
+}
+
+function vintLength(firstByte: number): number {
+  let length = 1;
+  while (length < 8 && (firstByte & (0x80 >> (length - 1))) === 0) {
+    ++length;
+  }
+  return length;
+}
+
+function readElements(data: Uint8Array): IEbmlElement[] {
+  const elements: IEbmlElement[] = [];
+  for (let offset = 0; offset < data.length; ) {
+    const idLength = vintLength(data[offset]);
+    const sizeLength = vintLength(data[offset + idLength]);
+    let id = 0;
+    for (const byte of data.subarray(offset, offset + idLength)) {
+      id = id * 256 + byte;
+    }
+    let size = data[offset + idLength] & (0xff >> sizeLength);
+    for (const byte of data.subarray(offset + idLength + 1, offset + idLength + sizeLength)) {
+      size = size * 256 + byte;
+    }
+    const dataStart = offset + idLength + sizeLength;
+    elements.push({
+      id,
+      header: data.subarray(offset, offset + idLength),
+      data: data.subarray(dataStart, dataStart + size)
+    });
+    offset = dataStart + size;
+  }
+  return elements;
+}
+
+function element(idBytes: Uint8Array, data: Uint8Array): Uint8Array {
+  const size = new Uint8Array(8);
+  size[0] = 0x01;
+  let value = data.length;
+  for (let index = 7; index > 0; --index) {
+    size[index] = value % 256;
+    value = Math.floor(value / 256);
+  }
+  return concatUint8Arrays([idBytes, size, data]);
+}
+
+function crc32Element(data: Uint8Array, valid: boolean, sizeLength = 1): Uint8Array {
+  const size = new Uint8Array(sizeLength);
+  size[0] = 0x80 >> (sizeLength - 1);
+  size[sizeLength - 1] |= 4;
+  return concatUint8Arrays([new Uint8Array([0xbf]), size, uint32LE((crc32(data) ^ (valid ? 0 : 1)) >>> 0)]);
+}
+
+function shortElement(id: number[], data: Uint8Array): Uint8Array {
+  return concatUint8Arrays([new Uint8Array(id), new Uint8Array([0x80 | data.length]), data]);
+}
+
+export function minimalWebm(valid = true): Uint8Array {
+  const ebmlHeader = shortElement(
+    [0x1a, 0x45, 0xdf, 0xa3],
+    concatUint8Arrays([
+      shortElement([0x42, 0x86], new Uint8Array([1])),
+      shortElement([0x42, 0xf7], new Uint8Array([1])),
+      shortElement([0x42, 0xf2], new Uint8Array([4])),
+      shortElement([0x42, 0xf3], new Uint8Array([8])),
+      shortElement([0x42, 0x82], latin1('webm')),
+      shortElement([0x42, 0x87], new Uint8Array([4])),
+      shortElement([0x42, 0x85], new Uint8Array([2]))
+    ])
+  );
+  const info = concatUint8Arrays([
+    shortElement([0x2a, 0xd7, 0xb1], new Uint8Array([0x0f, 0x42, 0x40])),
+    shortElement([0x44, 0x89], new Uint8Array([0x44, 0x7a, 0, 0]))
+  ]);
+  const audio = concatUint8Arrays([
+    shortElement([0xb5], new Uint8Array([0x47, 0x3b, 0x80, 0])),
+    shortElement([0x9f], new Uint8Array([2]))
+  ]);
+  const tracks = shortElement(
+    [0xae],
+    concatUint8Arrays([
+      shortElement([0xd7], new Uint8Array([1])),
+      shortElement([0x83], new Uint8Array([2])),
+      shortElement([0x86], latin1('A_OPUS')),
+      shortElement([0xe1], audio)
+    ])
+  );
+  const segment = concatUint8Arrays([
+    shortElement([0x15, 0x49, 0xa9, 0x66], concatUint8Arrays([crc32Element(info, true), info])),
+    shortElement([0x16, 0x54, 0xae, 0x6b], concatUint8Arrays([crc32Element(tracks, valid), tracks]))
+  ]);
+  return concatUint8Arrays([ebmlHeader, shortElement([0x18, 0x53, 0x80, 0x67], segment)]);
+}
+
+export interface ICrc32Placement {
+  ebmlHeader?: boolean;
+  segment?: boolean;
+  topLevel?: number[];
+  invalid?: number[];
+  misplaced?: number[];
+  nested?: boolean;
+  sizeLength?: number;
+  extension?: 'valid' | 'invalid' | 'none';
+}
+
+const segmentId = 0x18538067;
+const ebmlHeaderId = 0x1a45dfa3;
+const tracksId = 0x1654ae6b;
+const infoId = 0x1549a966;
+const extensionId = new Uint8Array([0x10, 0xab, 0xcd, 0xef]);
+
+function withCrc32(data: Uint8Array, valid: boolean, sizeLength = 1): Uint8Array {
+  return concatUint8Arrays([crc32Element(data, valid, sizeLength), data]);
+}
+
+function extensionElement(crc: 'valid' | 'invalid' | 'none'): Uint8Array {
+  const data = concatUint8Arrays([
+    element(new Uint8Array([0x4d, 0x80]), latin1('extension')),
+    element(new Uint8Array([0x7b, 0xa9]), latin1('Not in the Matroska specification'))
+  ]);
+  return element(extensionId, crc === 'none' ? data : withCrc32(data, crc === 'valid'));
+}
+
+export function withCrc32Elements(file: Uint8Array, placement: ICrc32Placement): Uint8Array {
+  return concatUint8Arrays(
+    readElements(file).map(root => {
+      if (root.id === ebmlHeaderId) {
+        return element(root.header, placement.ebmlHeader ? withCrc32(root.data, true) : root.data);
+      }
+      if (root.id !== segmentId) {
+        return concatUint8Arrays([root.header, root.data]);
+      }
+      const children = readElements(root.data).map(child => {
+        let data = child.data;
+        if (placement.nested && child.id === tracksId) {
+          data = concatUint8Arrays(readElements(data).map(entry => element(entry.header, withCrc32(entry.data, true))));
+        }
+        if (placement.misplaced?.includes(child.id)) {
+          const [first, ...rest] = readElements(data).map(item => element(item.header, item.data));
+          data = concatUint8Arrays([first, crc32Element(concatUint8Arrays(rest), true), ...rest]);
+        } else if (placement.topLevel?.includes(child.id) || placement.invalid?.includes(child.id)) {
+          data = withCrc32(data, !placement.invalid?.includes(child.id), placement.sizeLength);
+        }
+        const rebuilt = element(child.header, data);
+        return placement.extension && child.id === infoId
+          ? concatUint8Arrays([rebuilt, extensionElement(placement.extension)])
+          : rebuilt;
+      });
+      const segmentData = concatUint8Arrays(children);
+      return element(root.header, placement.segment ? withCrc32(segmentData, true) : segmentData);
+    })
+  );
+}
