+
+  it('declares verifyChecksums in IOptions and quality.checksums in IAudioMetadata', () => {
+    const repoPath = path.join(samplePath, '..', '..');
+    const file = path.join(generatedDir, 'options.mts');
+    fs.writeFileSync(
+      file,
+      `import type { IAudioMetadata, IOptions } from ${JSON.stringify(path.join(repoPath, 'lib', 'index.js'))};\n\n` +
+        'export const options: IOptions = { verifyChecksums: true };\n\n' +
+        'export function counts(metadata: IAudioMetadata): number[] {\n' +
+        '  const checksums = metadata.quality.checksums;\n' +
+        '  return [checksums?.mpegFrame, checksums?.lameTag, checksums?.lameMusic, checksums?.ebml].flatMap(count =>\n' +
+        '    count ? [count.checked, count.failed] : []\n' +
+        '  );\n' +
+        '}\n'
+    );
+    const result = spawnSync(
+      process.execPath,
+      [
+        path.join(repoPath, 'node_modules', 'typescript', 'bin', 'tsc'),
+        '--noEmit',
+        '--ignoreConfig',
+        '--strict',
+        '--module',
+        'node16',
+        '--moduleResolution',
+        'node16',
+        '--target',
