+function runCases(cases: IChecksumCase[], caseParsers = parsers) {
+  for (const checksumCase of cases) {
+    describe(checksumCase.title, () => {
+      caseParsers.forEach(parser => {
+        it(parser.description, async function () {
+          const options = checksumCase.options ?? {};
+          const skip = () => this.skip();
+          const verified = await parser.parse(
+            skip,
+            checksumCase.file,
+            checksumCase.mimeType,
+            Object.assign({}, options, { verifyChecksums: true })
+          );
