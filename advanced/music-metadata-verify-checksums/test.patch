--- /dev/null
+++ b/test.sh
@@ -0,0 +1,145 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      if [ $# -lt 1 ] || [ -z "$1" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      if [ -z "$OUTPUT_PATH" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")"
+
+NEW_TESTS=(test/test-verify-checksums-aff479.js)
+EXCLUDED_TESTS=(
+  test/test-verify-checksums-aff479.js
+  test/test-radio-streams.js
+)
+
+LOG="$(mktemp)"
+BUILD_LOG="$(mktemp)"
+(
+  status=0
+  node_modules/.bin/del-cli 'lib/**/*.js' 'lib/**/*.js.map' 'lib/**/*.d.ts' 'test/**/*.js' 'test/**/*.js.map' 'test/**/*.d.ts' || status=1
+  node_modules/.bin/tsc -p test || status=1
+  node_modules/.bin/tsc -p lib/tsconfig.json || status=1
+  exit "$status"
+) 2>&1 | tee "$BUILD_LOG"
+BUILD_STATUS=${PIPESTATUS[0]}
+cat "$BUILD_LOG" >> "$LOG"
+
+if [ "$MODE" = "new" ]; then
+  SPECS=("${NEW_TESTS[@]}")
+else
+  SPECS=()
+  for spec in test/*.js; do
+    skip=0
+    for excluded in "${EXCLUDED_TESTS[@]}"; do
+      [ "$spec" = "$excluded" ] && skip=1
+    done
+    [ "$skip" -eq 0 ] && SPECS+=("$spec")
+  done
+fi
+
+ARGS=(--no-config --no-package --timeout 40000)
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  rm -f "$OUTPUT_PATH"
+  ARGS+=(--reporter xunit --reporter-option "output=$OUTPUT_PATH")
+fi
+
+node_modules/.bin/mocha "${ARGS[@]}" "${SPECS[@]}" 2>&1 | tee -a "$LOG"
+STATUS=${PIPESTATUS[0]}
+
+if [ -n "$OUTPUT_PATH" ] && [ -f "$OUTPUT_PATH" ]; then
+  node --input-type=commonjs - "$OUTPUT_PATH" "$BUILD_STATUS" "$BUILD_LOG" "$MODE" <<'JSEOF'
+const fs = require('node:fs');
+const [outputPath, buildStatus, buildLogPath, mode] = process.argv.slice(2);
+const escape = text => text.replace(/[<>&"]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[c]);
+const seen = new Map();
+let report = fs
+  .readFileSync(outputPath, 'utf8')
+  .replace(/<testcase classname="([^"]*)" name="([^"]*)"/g, (testcase, classname, name) => {
+    const key = `${classname}\n${name}`;
+    const count = (seen.get(key) ?? 0) + 1;
+    seen.set(key, count);
+    return count === 1 ? testcase : `<testcase classname="${classname}" name="${name} (${count})"`;
+  });
+if (buildStatus !== '0' && report.includes('</testsuite>')) {
+  const detail = fs.readFileSync(buildLogPath, 'utf8').split('\n').slice(-200).join('\n') || 'the build printed nothing';
+  report = report
+    .replace(/<testsuite\b[^>]*>/, tag =>
+      tag
+        .replace(/\btests="(\d+)"/, (_, count) => `tests="${Number(count) + 1}"`)
+        .replace(/\berrors="(\d+)"/, (_, count) => `errors="${Number(count) + 1}"`)
+    )
+    .replace(
+      '</testsuite>',
+      `<testcase classname="mocha.${mode}" name="TypeScript build" time="0">` +
+        `<error message="${escape(`the TypeScript build exited with status ${buildStatus}`)}">${escape(detail)}</error>` +
+        '</testcase>\n</testsuite>'
+    );
+}
+fs.writeFileSync(outputPath, report);
+JSEOF
+fi
+
+if [ -n "$OUTPUT_PATH" ] && ! grep -q "<testcase" "$OUTPUT_PATH" 2>/dev/null; then
+  node --input-type=commonjs - "$OUTPUT_PATH" "$LOG" "$STATUS" "$MODE" <<'JSEOF'
+const fs = require('node:fs');
+const [outputPath, logPath, status, mode] = process.argv.slice(2);
+const escape = text => text.replace(/[<>&"]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[c]);
+const lines = fs.readFileSync(logPath, 'utf8').split('\n');
+const detail = lines.slice(-200).join('\n') || 'mocha printed nothing';
+fs.writeFileSync(
+  outputPath,
+  '<?xml version="1.0" encoding="UTF-8"?>\n' +
+    `<testsuite name="Mocha Tests" tests="1" failures="0" errors="1" skipped="0">\n` +
+    `<testcase classname="mocha.${mode}" name="build and collection" time="0">` +
+    `<error message="${escape(`tests exited with status ${status} without results`)}">${escape(detail)}</error>` +
+    '</testcase>\n</testsuite>\n'
+);
+JSEOF
+  if [ "$STATUS" -eq 0 ]; then
+    STATUS=1
+  fi
+fi
+if [ "$BUILD_STATUS" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+  STATUS=1
+fi
+rm -f "$LOG" "$BUILD_LOG"
+
+exit "$STATUS"
