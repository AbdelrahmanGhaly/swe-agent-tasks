+          assert.isUndefined(checksumsOf(plain), 'quality.checksums without verifyChecksums');
+          assert.deepEqual(verified.format, plain.format, 'format');
+          assert.deepEqual(verified.common, plain.common, 'common');
+          assert.deepEqual(verified.native, plain.native, 'native');
+        });
+      });
+    });
+  }
