+def rows_where(session: Session, table: Any, column: str, ids: set[str]) -> list[tuple]:
+    query = table.__table__.select().where(table.__table__.c[column].in_(sorted(ids)))
+    return sorted(tuple(repr(value) for value in row) for row in session.execute(query))
+
+
+def rows_used_by(backend: RedunBackendDb, session: Session, execution_id: str) -> dict:
+    records = records_of(backend, execution_id)
+    call_hashes = {id for id, record in records.items() if record["_type"] == "CallNode"}
+    value_hashes = {id for id, record in records.items() if record["_type"] == "Value"}
+    calls = session.query(CallNode).filter(CallNode.call_hash.in_(sorted(call_hashes))).all()
+    task_hashes = {call.task_hash for call in calls}
+    keys = {(call.task_hash, call.args_hash) for call in calls}
+    arg_hashes = {
+        arg_hash
+        for (arg_hash,) in session.query(Argument.arg_hash).filter(
+            Argument.call_hash.in_(sorted(call_hashes))
+        )
+    }
+    evaluations = Evaluation.__table__.select().where(
+        Evaluation.__table__.c.task_hash.in_(sorted(task_hashes))
+    )
+    return {
+        "argument": rows_where(session, Argument, "call_hash", call_hashes),
+        "argument_result": rows_where(session, ArgumentResult, "arg_hash", arg_hashes),
+        "call_edge": rows_where(session, CallEdge, "parent_id", call_hashes),
+        "call_subtree_task": rows_where(session, CallSubtreeTask, "call_hash", call_hashes),
+        "evaluation": sorted(
+            tuple(repr(value) for value in row)
+            for row in session.execute(evaluations)
+            if (row.task_hash, row.args_hash) in keys
+        ),
+        "subvalue": rows_where(session, Subvalue, "parent_value_hash", value_hashes),
+        "task": rows_where(session, TaskRow, "hash", task_hashes),
+        "file": rows_where(session, FileRow, "value_hash", value_hashes),
+    }
+
