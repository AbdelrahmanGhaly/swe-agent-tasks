+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      if [ $# -lt 1 ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")" || exit 1
+
+NEW_TESTS="redun/tests/test_db_prune_0e57d3.py"
+WORK_DIR="$(mktemp -d -p /var/tmp 2>/dev/null || mktemp -d)"
+LOG="$WORK_DIR/pytest.log"
+
+# Temporary files go to a directory of this run only. pytest's default base, /tmp/pytest-of-<user>,
+# is shared by every uid that sets the same user name and is refused when another uid created it.
+# redun looks for a .redun directory in every parent of the working directory, so a repository
+# left in /tmp would also be picked up by tests that run in a temporary directory.
+mkdir -p "$WORK_DIR/tmp"
+export TMPDIR="$WORK_DIR/tmp"
+if [ -z "$OUTPUT_PATH" ]; then
+  OUTPUT_PATH="$WORK_DIR/junit.xml"
+fi
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+PYTEST=(python -m pytest -p no:cacheprovider -o addopts= -v --basetemp="$WORK_DIR/pytest" --junitxml="$OUTPUT_PATH")
+
+# Base mode runs the whole suite of the repository except redun/experimental, which the
+# repository's own tox command ignores as well, and the tests named below.
+# - Three tests only work when the uid running them has an account entry, which the uid in this
+#   environment may not have: test_explicit_config_dir_env_var_still_auto_creates clears the
+#   environment and then asks for the user name, and the two Spark tests start a JVM whose login
+#   looks the uid up (they also need a Java runtime, which the image does not carry).
+# - test_readonly_file_error is skipped when it runs as root and runs otherwise, so its outcome
+#   depends on the uid the tests run as.
+# - The rest depend on how fast the machine is. test_cse_scopes and test_common_expression assert
+#   whether a duplicate call is served by a job that is still pending or by the backend, which
+#   depends on which of two threads gets there first. The others wait for a background thread
+#   through redun.tests.utils.wait_until, which gives up after two seconds. They pass on an idle
+#   machine and fail now and then on a loaded one. test_code_packaging and
+#   test_inflight_join_only_on_first_submission submit a second job while the executor's job
+#   arrayer thread scans its pending jobs without taking its lock, and the repository's pytest
+#   settings turn an exception in a background thread into a test error.
+# - test_docstrings generates one case per function in the package, so its cases change with the
+#   code under test: a change that adds functions adds cases that have no counterpart before it.
+BASE_SKIPS=(
+  redun/tests/test_static_analysis.py::test_docstrings
+  redun/tests/test_cli.py::test_explicit_config_dir_env_var_still_auto_creates
+  redun/tests/test_glue_helpers.py::test_sql_query
+  redun/tests/test_glue_helpers.py::test_udf_with_spark
+  redun/tests/test_file.py::test_readonly_file_error
+  redun/tests/test_scheduler.py::test_cse_scopes
+  redun/tests/test_scheduler.py::test_common_expression
+  redun/tests/test_scheduler.py::test_thread
+  redun/tests/test_scheduler.py::test_thread_join_multiple
+  redun/tests/test_scheduler.py::test_thread_catch
+  redun/tests/test_scheduler.py::test_thread_cache
+  redun/tests/test_context.py::test_context_cse2
+  redun/tests/test_context.py::test_context_check_valid
+  redun/tests/test_federated_tasks.py::test_lambda_federated_task
+  redun/tests/test_federated_tasks.py::test_rest_federated_task
+  redun/tests/test_aws_glue.py::test_glue_submission_retry
+  redun/tests/test_aws_batch.py::test_executor
+  redun/tests/test_aws_batch.py::test_executor_multinode
+  redun/tests/test_aws_batch.py::test_executor_docker
+  redun/tests/test_aws_batch.py::test_executor_job_debug
+  redun/tests/test_aws_batch.py::test_executor_error_override
+  redun/tests/test_aws_batch.py::test_interactive
+  redun/tests/test_aws_batch.py::test_job_staleness
+  redun/tests/test_aws_batch.py::test_jobs_are_arrayed
+  redun/tests/test_aws_batch.py::test_code_packaging
+  redun/tests/test_aws_batch.py::test_inflight_join_only_on_first_submission
+  redun/tests/test_gcp_batch.py::test_executor
+  redun/tests/test_gcp_batch.py::test_executor_array
+  redun/tests/test_gcp_batch.py::test_executor_script
+  redun/tests/test_k8s.py::test_executor
+  redun/tests/test_k8s.py::test_jobs_are_arrayed
+  redun/tests/test_k8s.py::test_executor_with_config_timeout
+  redun/tests/test_k8s.py::test_executor_with_node_affinity
+  redun/tests/test_k8s.py::test_executor_node_affinity_override
+  redun/tests/test_k8s.py::test_executor_with_env
+  redun/tests/test_k8s.py::test_executor_env_merge
+  redun/tests/test_k8s.py::test_executor_with_volumes
+  redun/tests/test_k8s.py::test_code_packaging
+  redun/tests/test_k8s.py::test_inflight_join_only_on_first_submission
+)
+
+if [ "$MODE" = "base" ]; then
+  # pytest's own --deselect matches by prefix and would also drop tests such as
+  # test_executor_config, so the names above are matched exactly.
+  cat > "$WORK_DIR/base_skips.py" <<'PYEOF'
+import os
+
+SKIPS = set(os.environ["REDUN_BASE_SKIPS"].split())
+
+
+def pytest_collection_modifyitems(config, items):
+    skipped = [item for item in items if item.nodeid.split("[")[0] in SKIPS]
+    config.hook.pytest_deselected(items=skipped)
+    items[:] = [item for item in items if item.nodeid.split("[")[0] not in SKIPS]
+PYEOF
+  REDUN_BASE_SKIPS="${BASE_SKIPS[*]}" PYTHONPATH="$WORK_DIR${PYTHONPATH:+:$PYTHONPATH}" \
+    timeout 1700 "${PYTEST[@]}" -p base_skips \
+    --ignore=redun/experimental --ignore="$NEW_TESTS" redun 2>&1 | tee "$LOG"
+  STATUS=${PIPESTATUS[0]}
+else
+  timeout 1700 "${PYTEST[@]}" "$NEW_TESTS" 2>&1 | tee "$LOG"
+  STATUS=${PIPESTATUS[0]}
+fi
+
+if [ "$STATUS" -ne 0 ] && ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  python - "$OUTPUT_PATH" "$LOG" "$MODE" "$STATUS" <<'PYEOF'
+import sys
+from xml.sax.saxutils import escape, quoteattr
+
+output_path, log_path, mode, status = sys.argv[1:5]
+with open(log_path, errors="replace") as infile:
+    log = infile.read()[-20000:]
+log = "".join(char for char in log if char in "\t\n\r" or ord(char) >= 32)
+message = f"pytest exited with status {status} before reporting any test"
+with open(output_path, "w") as out:
+    out.write('<?xml version="1.0" encoding="utf-8"?>\n')
+    out.write('<testsuites><testsuite name="pytest" tests="1" failures="1" errors="0">\n')
+    out.write(f'<testcase classname="test.sh" name={quoteattr(mode + " run")}>\n')
+    out.write(f"<failure message={quoteattr(message)}>{escape(log)}</failure>\n")
+    out.write("</testcase>\n</testsuite></testsuites>\n")
+PYEOF
+fi
+
+exit "$STATUS"
