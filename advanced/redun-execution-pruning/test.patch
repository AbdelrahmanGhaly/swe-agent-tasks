+def test_prune_named_execution_removes_it_and_its_jobs(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    assert scheduler.run(pipeline(1), execution_id=EXEC_A) == 4
+    assert scheduler.run(pipeline(10), execution_id=EXEC_B) == 31
+    jobs_a = job_count(session, EXEC_A)
+    jobs_b = job_count(session, EXEC_B)
+    assert jobs_a == 4
+
+    backend.prune([EXEC_A])
+
+    assert execution_ids(session) == {EXEC_B}
+    assert job_count(session, EXEC_A) == 0
+    assert job_count(session, EXEC_B) == jobs_b
+
+
+def test_prune_removes_records_only_the_execution_used(
+    scheduler: Scheduler, backend: RedunBackendDb
+) -> None:
+    scheduler.run(pipeline(1), execution_id=EXEC_A)
+    scheduler.run(pipeline(10), execution_id=EXEC_B)
+    ids_a = record_ids(backend, EXEC_A)
+    ids_b = record_ids(backend, EXEC_B)
+    assert ids_a - ids_b
+    assert ids_a & ids_b
+
+    backend.prune([EXEC_A])
+
+    assert backend.has_records(sorted(ids_a - ids_b)) == []
+    assert set(backend.has_records(sorted(ids_b))) == ids_b
+
+
+def test_prune_leaves_remaining_execution_records_unchanged(
+    scheduler: Scheduler, backend: RedunBackendDb
+) -> None:
