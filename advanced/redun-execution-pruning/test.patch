+def test_execution_repeated_later_loses_only_its_own_records(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    scheduler.run(pipeline(1), execution_id=EXEC_A)
+    scheduler.run(pipeline(1), execution_id=EXEC_B)
+    jobs_a = job_count(session, EXEC_A)
+    records_b = records_of(backend, EXEC_B)
+    before = record_counts(session)
+
+    backend.prune([EXEC_A])
+    CALLS.clear()
+
+    removed = removed_counts(before, record_counts(session))
+    assert removed["Execution"] == 1
+    assert removed["Job"] == jobs_a
+    assert removed["CallNode"] == 0
+    assert removed["Value"] == 0
+    assert records_of(backend, EXEC_B) == records_b
+    assert scheduler.run(pipeline(1)) == 4
+    assert CALLS == []
