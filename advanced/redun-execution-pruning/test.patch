+def make_store_scheduler(root: str) -> Scheduler:
+    config = Config(
+        {
+            "scheduler": {"ignore_warnings": "namespace"},
+            "backend": {
+                "db_uri": "sqlite:///:memory:",
+                "value_store_path": root,
+                "value_store_min_size": "0",
+            },
+        }
+    )
+    scheduler = Scheduler(config=config)
+    scheduler.load()
+    return scheduler
