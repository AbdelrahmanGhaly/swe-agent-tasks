+def record_ids(backend: RedunBackendDb, *execution_ids: str) -> set[str]:
+    return set(backend.iter_record_ids(list(execution_ids)))
+
+
+def records_of(backend: RedunBackendDb, *execution_ids: str) -> dict[str, dict]:
+    ids = sorted(record_ids(backend, *execution_ids))
+    return {record[RECORD_KEYS[record["_type"]]]: record for record in backend.get_records(ids)}
