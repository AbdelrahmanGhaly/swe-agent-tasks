+    assert records_of(backend, EXEC_B) == records_b
+    assert scheduler.run(apply_task(inc, 3)) == 4
+    assert CALLS == []
+
+
+def test_prune_empties_repository_with_task_arguments(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    scheduler.run(apply_task(double, 3), execution_id=EXEC_A)
+    scheduler.run(apply_task(inc, 3), execution_id=EXEC_B)
+
+    backend.prune([EXEC_A, EXEC_B])
+
+    assert table_sizes(session) == empty_sizes()
+
+
+def test_prune_empties_repository_with_failed_execution(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    with pytest.raises(ValueError):
+        scheduler.run(failing(1), execution_id=EXEC_A)
+    assert session.get(Execution, EXEC_A).status == "FAILED"
+    assert table_sizes(session)["call_node"] > 0
+
+    backend.prune([EXEC_A])
+
+    assert table_sizes(session) == empty_sizes()
+
+
+def test_remaining_failed_execution_is_unchanged(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    with pytest.raises(ValueError):
+        scheduler.run(failing(1), execution_id=EXEC_A)
+    scheduler.run(pipeline(1), execution_id=EXEC_B)
+    records_a = records_of(backend, EXEC_A)
+    unpruned = Scheduler(config=Config({"scheduler": {"ignore_warnings": "namespace"}}))
+    unpruned.load()
+    with pytest.raises(ValueError):
+        unpruned.run(failing(1), execution_id=EXEC_A)
+    unpruned.run(pipeline(1), execution_id=EXEC_B)
+    CALLS.clear()
+    with pytest.raises(ValueError):
+        unpruned.run(failing(1))
+    calls_without_prune = sorted(CALLS)
+
+    backend.prune([EXEC_B])
+    CALLS.clear()
+
+    assert records_of(backend, EXEC_A) == records_a
+    with pytest.raises(ValueError):
+        scheduler.run(failing(1))
+    assert sorted(CALLS) == calls_without_prune
+
+
+def test_pruned_call_is_computed_again_when_a_remaining_execution_left_its_task_unfinished(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    run_failing_serially(backend, fail_beside(1), EXEC_A)
+    assert unfinished_tasks(session, EXEC_A) == ["inc"]
+    assert scheduler.run(inc(5), execution_id=EXEC_B) == 6
+    jobs_a = rows_where(session, Job, "execution_id", {EXEC_A})
+
+    backend.prune([EXEC_B])
+    CALLS.clear()
+
+    assert rows_where(session, Job, "execution_id", {EXEC_A}) == jobs_a
+    assert scheduler.run(inc(5)) == 6
+    assert CALLS == ["inc"]
+
+
+def test_prune_empties_repository_with_context(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    assert scheduler.run(with_context(1), execution_id=EXEC_A, context={"offset": 10}) == 11
+    assert session.query(Tag).filter(Tag.key == "redun.context").count() > 0
+
+    backend.prune([EXEC_A])
+
+    assert table_sizes(session) == empty_sizes()
+
+
+def test_remaining_context_execution_stays_cached(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    assert scheduler.run(with_context(1), execution_id=EXEC_A, context={"offset": 10}) == 11
+    assert scheduler.run(with_context(2), execution_id=EXEC_B, context={"offset": 10}) == 12
+    records_b = records_of(backend, EXEC_B)
+
+    backend.prune([EXEC_A])
+    CALLS.clear()
+
+    assert records_of(backend, EXEC_B) == records_b
+    assert scheduler.run(with_context(2), context={"offset": 10}) == 12
+    assert CALLS == []
+    assert scheduler.run(with_context(1), context={"offset": 10}) == 11
+    assert CALLS == ["with_context"]
+
+
+def test_prune_leaves_catch_cache_entry_alone(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    assert scheduler.run(catch(fail(1), ValueError, recover), execution_id=EXEC_A) == 0
+    entries = (
+        session.query(Evaluation.eval_hash, Evaluation.value_hash)
+        .join(TaskRow, TaskRow.hash == Evaluation.task_hash)
+        .filter(TaskRow.name == "catch")
+    )
+    cached = sorted(entries.all())
+    assert cached
+
+    backend.prune([EXEC_A])
+    CALLS.clear()
+
+    assert execution_ids(session) == set()
+    assert sorted(entries.all()) == cached
+    assert scheduler.run(catch(fail(1), ValueError, recover)) == 0
+    assert CALLS == ["recover"]
+
+
+def test_prune_leaves_cache_entry_recorded_outside_executions_alone(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    scheduler.run(pipeline(1), execution_id=EXEC_A)
+    run_failing_serially(backend, fail_beside(2), EXEC_B)
+    assert unfinished_tasks(session, EXEC_B) == ["inc"]
+    eval_hash, args_hash = hash_eval(scheduler.type_registry, inc.hash, (7,), {})
+    backend.set_eval_cache(eval_hash, inc.hash, args_hash, 8)
+
+    backend.prune([EXEC_A, EXEC_B])
+    CALLS.clear()
+
+    assert execution_ids(session) == set()
+    assert scheduler.run(inc(7)) == 8
+    assert CALLS == []
+
+
+def test_pruned_execution_can_be_run_again(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    scheduler.run(both(1, 7), execution_id=EXEC_A)
+    scheduler.run(pipeline(1), execution_id=EXEC_B)
+    records_a = records_of(backend, EXEC_A)
+    hashes = {id for id, record in records_a.items() if record["_type"] in ("CallNode", "Value")}
+    sizes = table_sizes(session)
+
+    backend.prune([EXEC_A])
+    CALLS.clear()
+
+    assert scheduler.run(both(1, 7), execution_id=EXEC_A) == 16
+    assert sorted(CALLS) == ["add", "both", "double"]
+    assert job_count(session, EXEC_A) == 4
+    assert {
+        id
+        for id, record in records_of(backend, EXEC_A).items()
+        if record["_type"] in ("CallNode", "Value")
+    } == hashes
+    assert table_sizes(session) == sizes
+
+
+def test_pruned_file_workflow_can_be_run_again(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session, tmp_path
+) -> None:
+    scheduler.run(file_flow(str(tmp_path), ["a", "b"]), execution_id=EXEC_A)
+    backend.prune([EXEC_A])
+    CALLS.clear()
+
+    assert scheduler.run(file_flow(str(tmp_path), ["a", "b"]), execution_id=EXEC_A) == "ab"
+    assert sorted(CALLS) == ["file_flow", "read_files", "write_file", "write_file"]
+    assert job_count(session, EXEC_A) == 4
+    assert session.query(FileRow).count() == 2
+
+
+def test_prune_leaves_values_outside_executions_alone(
+    scheduler: Scheduler, backend: RedunBackendDb, session: Session
+) -> None:
+    kept_hash = backend.record_value("recorded directly")
+    backend.record_tags(TagEntity.Value, kept_hash, [("note", "mine")])
+    scheduler.run(pipeline(1), execution_id=EXEC_A)
+
+    backend.prune([EXEC_A])
+
+    assert backend.get_value(kept_hash) == ("recorded directly", True)
+    assert backend.get_tags([kept_hash]) == {kept_hash: {"note": ["mine"]}}
+    assert session.query(Value).count() == 1
+    assert session.query(CallNode).count() == 0
