+def execution_ids(session: Session) -> set[str]:
+    return {id for (id,) in session.query(Execution.id)}
+
+
+def table_sizes(session: Session) -> dict[str, int]:
+    return {table.__tablename__: session.query(table).count() for table in TABLES}
+
+
+def record_counts(session: Session) -> dict[str, int]:
+    return {name: session.query(table).count() for name, table in RECORD_TABLES.items()}
+
+
+def removed_counts(before: dict[str, int], after: dict[str, int]) -> dict[str, int]:
+    return {name: before[name] - after[name] for name in before}
+
+
+def empty_sizes() -> dict[str, int]:
+    return {table.__tablename__: 0 for table in TABLES}
+
+
+def table_rows(session: Session) -> dict[str, list[tuple]]:
+    return {
+        table.__tablename__: sorted(
+            tuple(repr(value) for value in row)
+            for row in session.execute(table.__table__.select())
+        )
+        for table in TABLES
+    }
