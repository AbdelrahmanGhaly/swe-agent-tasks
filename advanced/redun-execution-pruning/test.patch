+    scheduler.run(both(1, 7), execution_id=EXEC_B, tags=[("project", "two")])
+    scheduler.run(pipeline(10), execution_id=EXEC_C)
+    records_b = records_of(backend, EXEC_B)
+    records_c = records_of(backend, EXEC_C)
+
+    backend.prune([EXEC_A])
+
+    assert records_of(backend, EXEC_B) == records_b
+    assert records_of(backend, EXEC_C) == records_c
+
