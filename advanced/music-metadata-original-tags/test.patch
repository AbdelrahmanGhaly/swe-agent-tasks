+
+function withoutTagTypes(format: IFormat): Omit<IFormat, 'tagTypes'> {
+  const { tagTypes: _tagTypes, ...rest } = format;
+  return rest;
+}
+
+function isUnset(value: unknown): boolean {
+  return (
+    value === undefined ||
+    (typeof value === 'object' &&
+      value !== null &&
+      !Array.isArray(value) &&
+      Object.values(value).every(field => field === null))
+  );
+}
+
+function commonKeys(...commons: ICommonTagsResult[]): (keyof ICommonTagsResult)[] {
+  return [...new Set(commons.flatMap(common => Object.keys(common) as (keyof ICommonTagsResult)[]))];
+}
+
+function tagsOf(metadata: IAudioMetadata) {
+  return { tagTypes: metadata.format.tagTypes, native: metadata.native, common: metadata.common };
+}
+
+async function mapCommon(options: IOptions, ...natives: IAudioMetadata['native'][]): Promise<ICommonTagsResult> {
+  const collector = new MetadataCollector(options);
+  for (const native of natives) {
+    for (const [tagType, tags] of Object.entries(native)) {
+      for (const tag of tags) {
+        await collector.addTag(tagType as TagType, tag.id, tag.value);
+      }
+    }
+  }
+  return collector.toCommonMetadata().common;
+}
+
+function runCases(cases: IOriginalTagsCase[]) {
+  for (const originalCase of cases) {
+    describe(originalCase.title, () => {
+      parsers.forEach(parser => {
+        it(parser.description, async function () {
+          const options = originalCase.options ?? {};
+          const skip = () => this.skip();
+          const included: IAudioMetadata = await parser.parse(
+            skip,
+            originalCase.file,
+            originalCase.mimeType,
+            Object.assign({}, options, { includeOriginalTags: true })
+          );
+          const plain = await parser.parse(skip, originalCase.file, originalCase.mimeType, options);
+          const disabled = await parser.parse(
+            skip,
+            originalCase.file,
+            originalCase.mimeType,
+            Object.assign({}, options, { includeOriginalTags: false })
+          );
+          assert.deepEqual(disabled, plain, 'includeOriginalTags set to false');
+          assert.notProperty(plain, 'original', 'original without includeOriginalTags');
+          if (originalCase.withoutOriginal) {
+            const withoutOriginal = tagsOf(
+              await parser.parse(skip, originalCase.withoutOriginal, originalCase.mimeType, options)
+            );
+            assert.deepEqual(tagsOf(plain), withoutOriginal, 'tags without includeOriginalTags');
+            assert.deepEqual(tagsOf(disabled), withoutOriginal, 'tags with includeOriginalTags set to false');
+          }
+          const original = await mm.parseFile(originalCase.original, options);
+          const tagTypes = [
+            ...plain.format.tagTypes,
+            ...original.format.tagTypes.filter(tagType => !plain.format.tagTypes.includes(tagType))
+          ];
+          assert.deepEqual(withoutTagTypes(included.format), withoutTagTypes(plain.format), 'format');
+          assert.deepEqual(included.format.tagTypes, tagTypes, 'format.tagTypes');
+          assert.deepEqual(Object.keys(included.native).sort(), [...tagTypes].sort(), 'native tag types');
+          for (const tagType of tagTypes) {
+            assert.deepEqual(
+              included.native[tagType],
+              [...(plain.native[tagType] ?? []), ...(original.native[tagType] ?? [])],
+              `native.${tagType}`
+            );
+          }
+          const mapped = await mapCommon(options, plain.native, original.native);
+          for (const key of commonKeys(plain.common, original.common, included.common)) {
+            const fromFile = plain.common[key];
+            const fromOriginal = original.common[key];
+            if (isUnset(fromFile) || isUnset(fromOriginal) || isDeepStrictEqual(fromFile, fromOriginal)) {
+              assert.deepEqual(included.common[key], isUnset(fromOriginal) ? fromFile : fromOriginal, `common.${key}`);
+            } else {
+              assert.deepEqual(
+                included.common[key],
+                mapped[key],
+                `common.${key} set by both the file and the original`
+              );
+            }
+          }
+          assert.deepPropertyVal(included, 'original', original, 'original');
+        });
+      });
+    });
+  }
+}
+
+function runNoTagsAddedCases(
+  untaggedCases: IUntaggedOriginalCase[],
+  nothingAddedCases: INothingAddedCase[],
+  rejectedCases: IRejectedCase[]
+) {
+  parsers.forEach(parser => {
+    it(parser.description, async function () {
+      const skip = () => this.skip();
+      for (const untaggedCase of untaggedCases) {
+        const { title, file, mimeType, original } = untaggedCase;
+        const options = untaggedCase.options ?? {};
+        const plain = await parser.parse(skip, file, mimeType, options);
+        assert.deepEqual(
+          await parser.parse(skip, file, mimeType, Object.assign({}, options, { includeOriginalTags: false })),
+          plain,
+          `${title} with includeOriginalTags set to false`
+        );
+        const included = await parser.parse(
+          skip,
+          file,
+          mimeType,
+          Object.assign({}, options, { includeOriginalTags: true })
+        );
+        assert.deepEqual(tagsOf(included), tagsOf(plain), title);
+        assert.deepEqual(included.format, plain.format, `format of ${title}`);
+        assert.deepPropertyVal(included, 'original', await mm.parseFile(original, options), `original of ${title}`);
+      }
+      for (const nothingAddedCase of nothingAddedCases) {
+        const { title, file, mimeType, readableOriginal, unreadableOriginal } = nothingAddedCase;
+        const options = nothingAddedCase.options ?? {};
+        if (readableOriginal) {
+          await expect(mm.parseFile(readableOriginal, options), `extracted original of ${title}`).to.be.fulfilled;
+        }
+        if (unreadableOriginal) {
+          await expect(mm.parseFile(unreadableOriginal, options), `extracted original of ${title}`).to.be.rejected;
+        }
+        const plain = await parser.parse(skip, file, mimeType, options);
+        assert.deepEqual(
+          await parser.parse(skip, file, mimeType, Object.assign({}, options, { includeOriginalTags: false })),
+          plain,
+          `${title} with includeOriginalTags set to false`
+        );
+        const included = await parser.parse(
+          skip,
+          file,
+          mimeType,
+          Object.assign({}, options, { includeOriginalTags: true })
+        );
+        assert.deepEqual(tagsOf(included), tagsOf(plain), title);
+        assert.deepEqual(included.format, plain.format, `format of ${title}`);
+        assert.notProperty(included, 'original', `original of ${title}`);
+      }
+      for (const rejectedCase of rejectedCases) {
+        const { title, file, mimeType, options } = rejectedCase;
+        await expect(parser.parse(skip, file, mimeType, options), title).to.be.rejectedWith(
+          UnexpectedFileContentError,
+          'allocation limit'
+        );
+        await expect(
+          parser.parse(skip, file, mimeType, Object.assign({}, options, { includeOriginalTags: false })),
+          `${title} with includeOriginalTags set to false`
+        ).to.be.rejectedWith(UnexpectedFileContentError, 'allocation limit');
+      }
+    });
+  });
+}
+
+describe('Include the tags of the original file', () => {
