+          'export const disabled: IOptions = { includeOriginalTags: false };\n' +
+          'declare const metadata: IAudioMetadata;\n' +
+          'export const original: IAudioMetadata | undefined = metadata.original;\n'
+      );
+      const result = spawnSync(
+        process.execPath,
+        [
+          path.join(repoPath, 'node_modules', 'typescript', 'bin', 'tsc'),
+          '--noEmit',
+          '--ignoreConfig',
