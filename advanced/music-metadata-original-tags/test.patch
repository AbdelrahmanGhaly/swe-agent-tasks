index 00000000..c097d84f
--- /dev/null
+++ b/test/test-original-tags-9ce65d.ts
@@ -0,0 +1,620 @@
+import { spawnSync } from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { isDeepStrictEqual } from 'node:util';
+import { assert, expect, use } from 'chai';
+import chaiAsPromised from 'chai-as-promised';
+import { fromBuffer } from 'strtok3';
+import type { TagType } from '../lib/common/GenericTagTypes.js';
+import { MetadataCollector } from '../lib/common/MetadataCollector.js';
+import type { IAudioMetadata, ICommonTagsResult, IFormat, IOptions } from '../lib/index.js';
+import * as mm from '../lib/index.js';
+import { UnexpectedFileContentError } from '../lib/ParseError.js';
+import { Parsers } from './metadata-parsers.js';
+import { samplePath } from './util.js';
+
+use(chaiAsPromised);
+
+interface IOriginalTagsCase {
+  title: string;
+  file: string;
+  mimeType: string;
+  original: string;
+  options?: IOptions;
+  withoutOriginal?: string;
+}
+
+interface IUntaggedOriginalCase {
+  title: string;
+  file: string;
+  mimeType: string;
+  original: string;
+  options?: IOptions;
+}
+
+interface INothingAddedCase {
+  title: string;
+  file: string;
+  mimeType: string;
+  options?: IOptions;
+  readableOriginal?: string;
+  unreadableOriginal?: string;
+}
+
+interface IRejectedCase {
+  title: string;
+  file: string;
+  mimeType: string;
+  options: IOptions;
+}
+
+const fixture = (name: string) => path.join(samplePath, 'original-tags', name);
+const wavpackSample = (name: string) => path.join(samplePath, 'wavpack', name);
+
+const parsers = [
+  ...Parsers,
