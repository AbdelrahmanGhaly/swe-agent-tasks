--- /dev/null
+++ b/lib/common/OriginalFile.ts
@@ -0,0 +1,412 @@
+import { textDecode } from '@borewit/text-codec';
+import initDebug from 'debug';
+import {
+  AbstractTokenizer,
+  EndOfStreamError,
+  type IRandomAccessFileInfo,
+  type IReadChunkOptions,
+  type ITokenizerOptions
+} from 'strtok3';
+import { concatUint8Arrays } from 'uint8array-extras';
+
+import { scanAppendingHeaders } from '../core.js';
+import { ParserFactory } from '../ParserFactory.js';
+import type { AnyTagValue, IAudioMetadata, IFormat, IPrivateOptions, ITrackInfo } from '../type.js';
+import { getMaxMemoryAllocation, getTokenizerOptions, validateAllocation } from './Allocation.js';
+import type { IGenericTag, TagType } from './GenericTagTypes.js';
+import { type INativeMetadataCollector, MetadataCollector } from './MetadataCollector.js';
+import { finalizeFormat } from './TrackInfo.js';
+
+const debug = initDebug('music-metadata:original-file');
+
+/**
+ * Layout of the chunks of a container, up to the chunk holding the audio
+ */
+interface IChunkLayout {
+  mimeType: string;
+  /**
+   * Offset of the first chunk
+   */
+  start: number;
+  /**
+   * Byte length of the chunk size
+   */
+  sizeLength: 4 | 8;
+  littleEndian: boolean;
+  /**
+   * The chunk size includes the chunk ID and size
+   */
+  sizeIncludesHeader: boolean;
+  /**
+   * Chunks are padded to an even length
+   */
+  padded: boolean;
+  audioChunks: string[];
+  /**
+   * Chunk giving the byte length of an audio frame
+   */
+  frameChunk?: { id: string; length: number; getFrameSize: (view: DataView, offset: number) => number };
+}
+
+/**
+ * Chunk layouts of every original WavPack or `flac --keep-foreign-metadata` keeps, by container ID:
+ * WAV, AIFF, CAF, DSDIFF and DSF, as W64 and RF64 originals are not parsed
+ */
+const chunkLayouts: { [id: string]: IChunkLayout } = {
+  RIFF: {
+    mimeType: 'audio/wav',
+    start: 12,
+    sizeLength: 4,
+    littleEndian: true,
+    sizeIncludesHeader: false,
+    padded: true,
+    audioChunks: ['data'],
+    frameChunk: { id: 'fmt ', length: 14, getFrameSize: (view, offset) => view.getUint16(offset + 12, true) }
+  },
+  FORM: {
+    mimeType: 'audio/aiff',
+    start: 12,
+    sizeLength: 4,
+    littleEndian: false,
+    sizeIncludesHeader: false,
+    padded: true,
+    audioChunks: ['SSND'],
+    frameChunk: {
+      id: 'COMM',
+      length: 8,
+      getFrameSize: (view, offset) => view.getInt16(offset) * Math.ceil(view.getInt16(offset + 6) / 8)
+    }
+  },
+  caff: {
+    mimeType: 'audio/caf',
+    start: 8,
+    sizeLength: 8,
+    littleEndian: false,
+    sizeIncludesHeader: false,
+    padded: false,
+    audioChunks: ['data'],
+    frameChunk: {
+      id: 'desc',
+      length: 24,
+      getFrameSize: (view, offset) => view.getUint32(offset + 16) / view.getUint32(offset + 20)
+    }
+  },
+  FRM8: {
+    mimeType: 'audio/dff',
+    start: 16,
+    sizeLength: 8,
+    littleEndian: false,
+    sizeIncludesHeader: false,
+    padded: true,
+    audioChunks: ['DSD ', 'DST ']
+  },
+  'DSD ': {
+    mimeType: 'audio/dsf',
+    start: 0,
+    sizeLength: 8,
+    littleEndian: true,
+    sizeIncludesHeader: true,
+    padded: false,
+    audioChunks: ['data']
+  }
+};
+
+/**
+ * Length of the audio between the header and the trailer of the original file: the rest of the chunk the header ends in,
+ * or, given the number of samples, the whole audio frames, as the encoder keeps any bytes left in the chunk in the trailer
+ * @param header Original file up to its audio
+ * @param layout Chunk layout of the original file
+ * @param numberOfSamples Number of samples of the file holding the original
+ * @returns Audio length, 0 if it cannot be told, undefined if the audio chunk is not found
+ */
+function getAudioLength(header: Uint8Array, layout: IChunkLayout, numberOfSamples?: number): number | undefined {
+  const view = new DataView(header.buffer, header.byteOffset, header.byteLength);
+  const chunkHeaderLength = 4 + layout.sizeLength;
+  let frameSize: number | undefined;
+  for (let offset = layout.start; offset + chunkHeaderLength <= header.length; ) {
+    const id = textDecode(header.subarray(offset, offset + 4), 'latin1');
+    const size =
+      layout.sizeLength === 4
+        ? view.getUint32(offset + 4, layout.littleEndian)
+        : Number(view.getBigInt64(offset + 4, layout.littleEndian));
+    const dataSize = layout.sizeIncludesHeader ? size - chunkHeaderLength : size;
+    const dataOffset = offset + chunkHeaderLength;
+    if (layout.audioChunks.includes(id)) {
+      const unknownSize = dataSize < 0 || (layout.sizeLength === 4 && size === 0xffffffff);
+      if (numberOfSamples !== undefined && frameSize !== undefined) {
+        const audioLength = numberOfSamples * frameSize;
+        const chunkSize = unknownSize ? header.length - dataOffset + audioLength : dataSize;
+        const padding = layout.padded && chunkSize === header.length - dataOffset + audioLength ? chunkSize % 2 : 0;
+        return Number.isSafeInteger(audioLength) ? audioLength + padding : undefined;
+      }
+      if (unknownSize) {
+        return 0;
+      }
+      const end = dataOffset + dataSize + (layout.padded ? dataSize % 2 : 0);
+      return end < header.length ? undefined : end - header.length;
+    }
+    if (dataSize < 0) {
+      return;
+    }
+    const { frameChunk } = layout;
+    if (id === frameChunk?.id && dataOffset + frameChunk.length <= header.length) {
+      frameSize = frameChunk.getFrameSize(view, dataOffset);
+    }
+    offset = dataOffset + dataSize + (layout.padded ? dataSize % 2 : 0);
+  }
+}
+
+/**
+ * Random access tokenizer over the original file, reading its audio, which was not kept, as zeros
+ */
+class OriginalFileTokenizer extends AbstractTokenizer {
+  public fileInfo: IRandomAccessFileInfo;
+
+  private readonly trailerOffset: number;
+
+  public constructor(
+    private readonly header: Uint8Array,
+    audioLength: number,
+    private readonly trailer: Uint8Array,
+    options: ITokenizerOptions
+  ) {
+    super(options);
+    this.trailerOffset = header.length + audioLength;
+    this.fileInfo = { ...options.fileInfo, size: this.trailerOffset + trailer.length };
+  }
+
+  public async readBuffer(uint8Array: Uint8Array, options?: IReadChunkOptions): Promise<number> {
+    const normOptions = this.normalizeOptions(uint8Array, options);
+    const bytesRead = await this.peekBuffer(uint8Array, normOptions);
+    this.position = normOptions.position + bytesRead;
+    return bytesRead;
+  }
+
+  public async peekBuffer(uint8Array: Uint8Array, options?: IReadChunkOptions): Promise<number> {
+    const normOptions = this.normalizeOptions(uint8Array, options);
+    const bytes2read = Math.max(0, Math.min(this.fileInfo.size - normOptions.position, normOptions.length));
+    if (!normOptions.mayBeLess && bytes2read < normOptions.length) {
+      throw new EndOfStreamError();
+    }
+    const start = normOptions.position;
+    const end = start + bytes2read;
+    uint8Array.fill(0, 0, bytes2read);
+    if (start < this.header.length) {
+      uint8Array.set(this.header.subarray(start, Math.min(end, this.header.length)));
+    }
+    if (end > this.trailerOffset) {
+      const from = Math.max(start, this.trailerOffset);
+      uint8Array.set(this.trailer.subarray(from - this.trailerOffset, end - this.trailerOffset), from - start);
+    }
+    return bytes2read;
+  }
+
+  public supportsRandomAccess(): boolean {
+    return true;
+  }
+
+  public setPosition(position: number): void {
+    this.position = position;
+  }
+}
+
+type TagOperation = (metadata: INativeMetadataCollector) => Promise<void> | void;
+
+/**
+ * Keeps the metadata of the original file apart, while recording its tags for the file holding the original
+ */
+class OriginalFileMetadata implements INativeMetadataCollector {
+  private readonly original: MetadataCollector;
+
+  private readonly tagOperations: TagOperation[] = [];
+
+  public constructor(options: IPrivateOptions) {
+    this.original = new MetadataCollector(options);
+  }
+
+  public get format(): IFormat {
+    return this.original.format;
+  }
+
+  public get native() {
+    return this.original.native;
+  }
+
+  public get quality() {
+    return this.original.quality;
+  }
+
+  public hasAny(): boolean {
+    return this.original.hasAny();
+  }
+
+  public setFormat<K extends keyof IFormat>(key: K, value: IFormat[K]): void {
+    this.original.setFormat(key, value);
+  }
+
+  public registerTagType(tagType: TagType): void {
+    this.original.registerTagType(tagType);
+    this.tagOperations.push(metadata => metadata.registerTagType(tagType));
+  }
+
+  public async addTag(tagType: TagType, tagId: string, value: AnyTagValue): Promise<void> {
+    await this.original.addTag(tagType, tagId, value);
+    this.tagOperations.push(metadata => metadata.addTag(tagType, tagId, value));
+  }
+
+  public async postMap(tagType: TagType, tag: IGenericTag): Promise<void> {
+    const recorded = { ...tag };
+    this.tagOperations.push(metadata => metadata.postMap(tagType, recorded));
+    await this.original.postMap(tagType, tag);
+  }
+
+  /**
+   * Add the recorded tags to the file holding the original, in the order the original gave them
+   * @param metadata Metadata of the file holding the original
+   */
+  public async addTagsTo(metadata: INativeMetadataCollector): Promise<void> {
+    for (const operation of this.tagOperations) {
+      await operation(metadata);
+    }
+  }
+
+  public addStreamInfo(streamInfo: ITrackInfo): void {
+    this.original.addStreamInfo(streamInfo);
+  }
+
+  public setAudioOnly(): void {
+    this.original.setAudioOnly();
+  }
+
+  public addWarning(warning: string): void {
+    this.original.addWarning(warning);
+  }
+
+  public setOriginal(original: IAudioMetadata): void {
+    this.original.setOriginal(original);
+  }
+
+  /**
+   * Metadata of the original file, as parsing the restored original gives it
+   */
+  public toCommonMetadata(): IAudioMetadata {
+    return this.original.toCommonMetadata();
+  }
+}
+
+/**
+ * Parts of the original file a lossless encoder kept, buffered within the allocation limit
+ */
+export class OriginalFile {
+  private readonly header: Uint8Array[] = [];
+
+  private readonly trailer: Uint8Array[] = [];
+
+  /**
+   * Byte length of the parts found, including the parts dropped once over the allocation limit
+   */
+  private length = 0;
+
+  public constructor(private readonly options: IPrivateOptions) {}
+
+  /**
+   * Whether nothing of the original file was found
+   */
+  public isEmpty(): boolean {
+    return this.length === 0;
+  }
+
+  /**
+   * Keep the next part of the original file up to its audio
+   */
+  public addHeader(part: Uint8Array): void {
+    this.keep(this.header, part);
+  }
+
+  /**
+   * Keep the next part of the original file after its audio
+   */
+  public addTrailer(part: Uint8Array): void {
+    this.keep(this.trailer, part);
+  }
+
+  /**
+   * Whether a part of this length fits the allocation limit, together with the parts found before it
+   */
+  public fits(length: number): boolean {
+    return this.length + length <= getMaxMemoryAllocation(this.options);
+  }
+
+  /**
+   * Count a part of the original file left unread, past the allocation limit none of the parts are kept
+   */
+  public skip(length: number): void {
+    this.length += length;
+    this.header.length = 0;
+    this.trailer.length = 0;
+  }
+
+  /**
+   * Replace the parts kept up to the audio by the parts the decoder of the file holding the original writes in their place
+   * @param restore Gives those parts from the parts kept up to the audio and the byte length of the parts after it,
+   * undefined if the decoder does not restore the original
+   */
+  public restoreHeader(restore: (header: Uint8Array[], trailerLength: number) => Uint8Array[] | undefined): void {
+    const trailerLength = this.trailer.reduce((length, part) => length + part.length, 0);
+    this.header.splice(0, this.header.length, ...(restore(this.header, trailerLength) ?? []));
+  }
+
+  /**
+   * Add the tags and the metadata of the original file, as parsing the restored original gives them
+   * @param metadata Metadata of the file holding the original
+   * @param numberOfSamples Number of samples of the file holding the original
+   */
+  public async addTagsTo(metadata: INativeMetadataCollector, numberOfSamples?: number): Promise<void> {
+    const originalOptions: IPrivateOptions = { ...this.options, observer: undefined };
+    const originalMetadata = new OriginalFileMetadata(originalOptions);
+    let size: number;
+    try {
+      validateAllocation(this.length, this.options);
+      const header = concatUint8Arrays(this.header);
+      const trailer = concatUint8Arrays(this.trailer);
+      const layout = chunkLayouts[textDecode(header.subarray(0, 4), 'latin1')];
+      const audioLength = layout ? getAudioLength(header, layout, numberOfSamples) : undefined;
+      const loader = layout && new ParserFactory().findLoaderForContentType(layout.mimeType);
+      if (!layout || audioLength === undefined || !loader) {
+        debug('Original file not supported');
+        return;
+      }
+      const tokenizer = new OriginalFileTokenizer(
+        header,
+        audioLength,
+        trailer,
+        getTokenizerOptions(originalOptions, { mimeType: layout.mimeType })
+      );
+      await scanAppendingHeaders(tokenizer, originalOptions);
+      const ParserImpl = await loader.load();
+      await new ParserImpl(originalMetadata, tokenizer, originalOptions).parse();
+      size = tokenizer.fileInfo.size;
+    } catch (error) {
+      if (!(error instanceof Error)) {
+        throw error;
+      }
+      debug(`Failed to read the original file: ${error.message}`);
+      return;
+    }
+    finalizeFormat(originalMetadata, size);
+    metadata.setOriginal(originalMetadata.toCommonMetadata());
+    await originalMetadata.addTagsTo(metadata);
+  }
+
+  /**
+   * Keep a part while all the parts found fit the allocation limit, past it none of them are kept
+   */
+  private keep(parts: Uint8Array[], part: Uint8Array): void {
+    if (this.fits(part.length)) {
+      this.length += part.length;
+      parts.push(part);
+    } else {
+      this.skip(part.length);
+    }
+  }
+}
