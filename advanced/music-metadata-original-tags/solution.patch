@@ -0,0 +1,134 @@
+import { textDecode } from '@borewit/text-codec';
+import { UINT16_BE, UINT16_LE, UINT32_BE, UINT32_LE } from 'token-types';
+import { FourCcToken } from '../common/FourCC.js';
+import type { IBlockStreamInfo } from './FlacToken.js';
+
+/**
+ * Channel mask the FLAC decoder writes for a number of channels, when the FLAC file gives none
+ */
+const defaultChannelMasks = [0, 0x4, 0x3, 0x7, 0x33, 0x607, 0x60f, 0x70f, 0x63f];
+
+/**
+ * WAVE_FORMAT_EXTENSIBLE sub format KSDATAFORMAT_SUBTYPE_PCM
+ */
+const pcmSubFormat = Uint8Array.of(0x01, 0, 0, 0, 0, 0, 0x10, 0, 0x80, 0, 0, 0xaa, 0, 0x38, 0x9b, 0x71);
+
+function getChunkId(chunk: Uint8Array): string {
+  return textDecode(chunk.subarray(0, 4), 'latin1');
+}
+
+function makeChunk(id: string, size: number, littleEndian: boolean, length: number): Uint8Array {
+  const chunk = new Uint8Array(length);
+  FourCcToken.put(chunk, 0, id);
+  (littleEndian ? UINT32_LE : UINT32_BE).put(chunk, 4, size);
+  return chunk;
+}
+
+/**
+ * fmt chunk the FLAC decoder writes: WAVE_FORMAT_PCM for 8 or 16-bit mono or stereo with the usual channel mask,
+ * WAVE_FORMAT_EXTENSIBLE otherwise
+ */
+function makeWaveFormatChunk(streamInfo: IBlockStreamInfo, channelMask: number): Uint8Array {
+  const { channels, sampleRate, bitsPerSample } = streamInfo;
+  const sampleLength = Math.ceil(bitsPerSample / 8);
+  const extensible =
+    (channelMask !== 0 && channelMask !== 0x4 && channelMask !== 0x3) ||
+    (bitsPerSample !== 8 && bitsPerSample !== 16) ||
+    channels > 2;
+  const size = extensible ? 40 : 16;
+  const chunk = makeChunk('fmt ', size, true, 8 + size);
+  UINT16_LE.put(chunk, 8, extensible ? 0xfffe : 1);
+  UINT16_LE.put(chunk, 10, channels);
+  UINT32_LE.put(chunk, 12, sampleRate);
+  UINT32_LE.put(chunk, 16, sampleRate * channels * sampleLength);
+  UINT16_LE.put(chunk, 20, channels * sampleLength);
+  UINT16_LE.put(chunk, 22, 8 * sampleLength);
+  if (extensible) {
+    UINT16_LE.put(chunk, 24, 22);
+    UINT16_LE.put(chunk, 26, bitsPerSample);
+    UINT32_LE.put(chunk, 28, channelMask);
+    chunk.set(pcmSubFormat, 32);
+  }
+  return chunk;
+}
+
+/**
+ * COMM chunk the FLAC decoder writes, with the sample rate as an 80-bit extended precision number
+ */
+function makeAiffCommonChunk(streamInfo: IBlockStreamInfo, numberOfFrames: number): Uint8Array {
+  const chunk = makeChunk('COMM', 18, false, 26);
+  UINT16_BE.put(chunk, 8, streamInfo.channels);
+  UINT32_BE.put(chunk, 10, numberOfFrames);
+  UINT16_BE.put(chunk, 14, streamInfo.bitsPerSample);
+  const shift = Math.clz32(streamInfo.sampleRate);
+  UINT16_BE.put(chunk, 16, 0x3fff + 31 - shift);
