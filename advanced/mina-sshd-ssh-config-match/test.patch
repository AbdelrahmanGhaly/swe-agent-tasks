+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      [ -n "$OUTPUT_PATH" ] || { echo "missing value for --output_path" >&2; usage; }
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+[ -n "$OUTPUT_PATH" ] || OUTPUT_PATH="$PWD/test-results-$MODE.xml"
+case "$OUTPUT_PATH" in
+  /*) ;;
+  *) OUTPUT_PATH="$PWD/$OUTPUT_PATH" ;;
+esac
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")" || exit 2
+
+BASE_COMMIT="c4287faf844a0250e4a097640a0442270b756d9f"
+NEW_TEST="HostConfigMatchInclude5a32d4Test"
+# Two base cases depend on the runner, with or without a change: HostConfigEntryTest#resolveIdentityFilePath
+# expands %l through InetAddress.getLocalHost(), which needs the container's own host name to resolve offline,
+# and ModifiableFileWatcherTest#validateStrictConfigFilePermissions compares a file's owner with the current
+# user name, which a runner uid without a passwd entry does not have.
+BASE_TESTS="!$NEW_TEST,!HostConfigEntryTest#resolveIdentityFilePath"
+BASE_TESTS="$BASE_TESTS,!ModifiableFileWatcherTest#validateStrictConfigFilePermissions"
+REPORTS="sshd-common/target/surefire-reports-common"
+SKIPS=(-Dformatter.skip=true -Dimpsort.skip=true -Dcheckstyle.skip=true -Dpmd.skip=true -Drat.skip=true
+  -Danimal.sniffer.skip=true -Denforcer.skip=true -Dmaven.javadoc.skip=true)
+
+# The runner may use another uid and HOME; keep Maven offline on the repository the image filled.
+export MAVEN_OPTS="${MAVEN_OPTS:-} -Dmaven.repo.local=/opt/m2repo"
+export PATH="${PATH:-}:/usr/local/bin:/usr/bin:/bin"
+if [ -n "${TMPDIR:-}" ] && ! { [ -d "$TMPDIR" ] && [ -w "$TMPDIR" ]; }; then
+  export TMPDIR=/tmp
+fi
+
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+LOG="$WORK/maven.log"
+: >"$LOG"
+
+if [ "$MODE" = "base" ]; then
+  if git -c safe.directory='*' cat-file -e "$BASE_COMMIT^{commit}" 2>/dev/null; then
+    git -c safe.directory='*' checkout -q "$BASE_COMMIT" -- sshd-common/src/test >>"$LOG" 2>&1
+  fi
+  SELECTED="$BASE_TESTS"
+else
+  SELECTED="$NEW_TEST"
+fi
+
+rm -rf sshd-common/target
+mvn -o -B -ntp -pl sshd-common test -Dtest="$SELECTED" -Dsurefire.failIfNoSpecifiedTests=false \
+  -Dmaven.test.failure.ignore=true "${SKIPS[@]}" >>"$LOG" 2>&1
+MVN_STATUS=$?
+
+python3 - "$REPORTS" "$OUTPUT_PATH" "$LOG" "$MODE" "$MVN_STATUS" <<'PY'
+import glob, os, sys
+import xml.etree.ElementTree as ET
+
+reports, output, log, mode, mvn_status = sys.argv[1:6]
+with open(log, errors='replace') as f:
+    log_tail = f.read()[-20000:]
+root = ET.Element('testsuites')
+
+
+def add_failure(name, message):
+    suite = ET.SubElement(root, 'testsuite', name='sshd-common', tests='1', failures='1', errors='0')
+    case = ET.SubElement(suite, 'testcase', name=name, classname='sshd-common.' + mode)
+    failure = ET.SubElement(case, 'failure', message=message)
+    failure.text = log_tail
+
+
+for path in sorted(glob.glob(os.path.join(reports, 'TEST-*.xml'))):
+    try:
+        root.append(ET.parse(path).getroot())
+    except ET.ParseError as e:
+        add_failure(os.path.basename(path), 'Unreadable test report: %s' % e)
+if len(root) == 0:
+    add_failure('build', 'No test results; the build or test run failed')
+elif mvn_status != '0':
+    add_failure('build', 'Maven exited with status %s' % mvn_status)
+ET.ElementTree(root).write(output, encoding='UTF-8', xml_declaration=True)
+
+failed = 0
+for case in root.iter('testcase'):
+    if any(child.tag in ('failure', 'error') for child in case):
+        failed += 1
+sys.exit(1 if failed else 0)
+PY
+STATUS=$?
+
+grep -E "Tests run:|BUILD|ERROR\]" "$LOG" | tail -40
+if [ "$STATUS" -eq 0 ] && [ "$MVN_STATUS" -ne 0 ]; then
+  STATUS=$MVN_STATUS
+fi
+exit "$STATUS"
