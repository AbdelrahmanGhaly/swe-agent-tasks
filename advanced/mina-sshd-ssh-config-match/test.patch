+
+    @TempDir
+    Path dir;
+
+    @BeforeEach
+    void setUp() throws IOException {
+        Files.createDirectories(dir.resolve("home").resolve(".ssh"));
+        OsUtils.setCurrentUser("tester");
+        PathUtils.setUserHomeFolderResolver(() -> dir.resolve("home"));
+    }
+
+    @AfterEach
+    void tearDown() {
+        PathUtils.setUserHomeFolderResolver(null);
+        OsUtils.setCurrentUser(null);
+    }
+
+    private Path write(String name, String... lines) throws IOException {
+        Path file = dir.resolve(name);
+        Files.createDirectories(file.getParent());
+        String text = String.join("\n", lines).replace("${dir}", dir.toString()) + "\n";
+        Files.write(file, text.getBytes(StandardCharsets.UTF_8));
+        return file;
+    }
+
+    private HostConfigEntry resolve(String host) throws IOException {
+        return resolve(host, 0, null);
+    }
+
+    private HostConfigEntry resolve(String host, int port, String user) throws IOException {
+        return effective(new ConfigFileHostEntryResolver(dir.resolve("config")), host, port, user);
+    }
+
+    private HostConfigEntry resolveEntries(String host) throws IOException {
+        return resolveEntries(host, 0, null);
+    }
+
+    private HostConfigEntry resolveEntries(String host, int port, String user) throws IOException {
+        HostConfigEntryResolver resolver
+                = HostConfigEntry.toHostConfigEntryResolver(HostConfigEntry.readHostConfigEntries(dir.resolve("config")));
+        return effective(resolver, host, port, user);
+    }
+
+    private static HostConfigEntry effective(HostConfigEntryResolver resolver, String host, int port, String user)
+            throws IOException {
+        HostConfigEntry entry = resolver.resolveEffectiveHost(host, port, null, user, null, null);
+        if (entry != null) {
+            return entry;
+        }
+        return new HostConfigEntry(host, host, (port > 0) ? port : 22,
+                GenericUtils.isEmpty(user) ? OsUtils.getCurrentUser() : user);
+    }
+
+    private static void expect(HostConfigEntry entry, String hostName, int port, String user) {
+        assertEquals(hostName, entry.getHostName(), "HostName");
+        assertEquals(port, entry.getPort(), "Port");
+        assertEquals(user, entry.getUsername(), "User");
+    }
+
+    private static void expectIdentities(HostConfigEntry entry, String... paths) {
+        assertEquals(Arrays.asList(paths), new ArrayList<>(entry.getIdentities()), "IdentityFile");
+    }
+
+    private static void expectCertificates(HostConfigEntry entry, String... paths) {
+        String expected = (paths.length == 0) ? null : String.join(",", paths);
+        assertEquals(expected, entry.getProperty(HostConfigEntry.CERTIFICATE_FILE_CONFIG_PROP), "CertificateFile");
+    }
+
+    @Test
+    void firstValueWinsInsideOneBlock() throws IOException {
+        write("config",
+                "Host foo",
+                "  Port 1001",
+                "  Port 1002",
+                "  User alice",
+                "  User bob",
+                "  HostName one.example",
+                "  HostName two.example",
+                "  ServerAliveInterval 11",
+                "  ServerAliveInterval 12");
+        HostConfigEntry foo = resolve("foo");
+        expect(foo, "one.example", 1001, "alice");
+        assertEquals("11", foo.getProperty("ServerAliveInterval"));
+    }
+
+    @Test
+    void firstValueWinsAcrossHostAndMatchBlocks() throws IOException {
+        write("config",
+                "Match host foo",
+                "  Port 1101",
+                "Host foo",
+                "  Port 1102",
+                "  User early",
+                "Match all",
+                "  User late",
+                "  ConnectTimeout 11");
+        HostConfigEntry foo = resolve("foo");
+        expect(foo, "foo", 1101, "early");
+        assertEquals("11", foo.getProperty("ConnectTimeout"));
+        HostConfigEntry bar = resolve("bar");
+        expect(bar, "bar", 22, "late");
+        assertEquals("11", bar.getProperty("ConnectTimeout"));
+    }
+
+    @Test
+    void linesBeforeTheFirstBlockComeFirst() throws IOException {
+        write("config",
+                "ServerAliveInterval 10",
+                "Match host foo",
+                "  ServerAliveInterval 20",
+                "  ConnectTimeout 5");
+        HostConfigEntry foo = resolveEntries("foo");
+        expect(foo, "foo", 22, "tester");
+        assertEquals("10", foo.getProperty("ServerAliveInterval"));
+        assertEquals("5", foo.getProperty("ConnectTimeout"));
+        HostConfigEntry bar = resolveEntries("bar");
+        expect(bar, "bar", 22, "tester");
+        assertEquals("10", bar.getProperty("ServerAliveInterval"));
+        assertNull(bar.getProperty("ConnectTimeout"));
+    }
+
+    @Test
+    void resolverUserAndPortWinOverTheConfig() throws IOException {
