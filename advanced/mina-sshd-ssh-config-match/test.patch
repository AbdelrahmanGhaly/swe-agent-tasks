+                "Match user given",
+                "  ServerAliveInterval 42");
+        HostConfigEntry fooPort2222AsGiven = resolve("foo", 2222, "given");
+        expect(fooPort2222AsGiven, "foo", 2222, "given");
+        assertEquals("42", fooPort2222AsGiven.getProperty("ServerAliveInterval"));
+        HostConfigEntry foo = resolve("foo");
+        expect(foo, "foo", 1201, "cfg");
+        assertNull(foo.getProperty("ServerAliveInterval"));
+    }
