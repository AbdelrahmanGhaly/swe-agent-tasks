+        HostConfigEntry foo = resolve("foo");
+        expect(foo, "foo", 2971, "tester");
+
+        write("config",
+                "Match host \"foo\"bar",
+                "  Port 2972");
+        assertThrows(IOException.class, () -> resolve("foobar"));
+        assertThrows(IOException.class, () -> resolveEntries("foobar"));
+    }
+
+    @Test
+    void hostNameTokensOtherThanHostAndPercentFail() throws IOException {
+        write("config",
+                "Match host gw",
+                "  HostName %h-relay.example");
+        for (HostConfigEntry entry : Arrays.asList(resolve("gw"), resolveEntries("gw"))) {
+            expect(entry, "gw-relay.example", 22, "tester");
+        }
+
+        for (String token : Arrays.asList("%r", "%p", "%u")) {
+            write("config",
+                    "Match host gw",
+                    "  HostName relay-" + token + ".example");
+            assertThrows(Exception.class, () -> resolve("gw"), token);
+            assertThrows(Exception.class, () -> resolveEntries("gw"), token);
+        }
+    }
+}
