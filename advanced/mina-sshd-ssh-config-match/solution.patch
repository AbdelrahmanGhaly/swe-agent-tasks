+    /**
+     * Checks a value against a comma-separated pattern list, as given to the criteria of an ssh config {@code Match}
+     * line: {@link #WILDCARD_PATTERN} and {@link #SINGLE_CHAR_PATTERN} are wildcards, and a pattern starting with
+     * {@link #NEGATION_CHAR_PATTERN} rejects the value if it matches.
+     *
+     * @param  value      The value to check
+     * @param  patterns   The comma-separated patterns
+     * @param  ignoreCase Whether to compare without regard to case
+     * @return            {@code true} if a pattern matches and no negated one does
+     */
+    public static boolean isPatternListMatch(String value, String patterns, boolean ignoreCase) {
+        String s = ignoreCase ? value.toLowerCase(Locale.ROOT) : value;
+        boolean matchFound = false;
+        for (String p : GenericUtils.split(patterns, ',')) {
+            boolean negated = (p.length() > 0) && (p.charAt(0) == NEGATION_CHAR_PATTERN);
+            String pattern = negated ? p.substring(1) : p;
+            if (ignoreCase) {
+                pattern = pattern.toLowerCase(Locale.ROOT);
+            }
+            if (isWildcardMatch(s, pattern)) {
+                if (negated) {
+                    return false;
+                }
+                matchFound = true;
+            }
+        }
+        return matchFound;
+    }
+
+    // Without recursion: on a mismatch only the most recent '*' takes one more character, so the time stays bounded
+    private static boolean isWildcardMatch(String s, String pattern) {
+        int i = 0;
+        int p = 0;
+        int star = -1;
+        int starMatch = 0;
+        while (i < s.length()) {
+            char ch = (p < pattern.length()) ? pattern.charAt(p) : 0;
+            if ((p < pattern.length()) && (ch != WILDCARD_PATTERN) && ((ch == SINGLE_CHAR_PATTERN) || (ch == s.charAt(i)))) {
+                i++;
+                p++;
+            } else if ((p < pattern.length()) && (ch == WILDCARD_PATTERN)) {
+                star = p;
+                starMatch = i;
+                p++;
+            } else if (star >= 0) {
+                starMatch++;
+                i = starMatch;
+                p = star + 1;
+            } else {
+                return false;
+            }
+        }
+        while ((p < pattern.length()) && (pattern.charAt(p) == WILDCARD_PATTERN)) {
+            p++;
+        }
+        return p == pattern.length();
+    }
+
     public static List<HostPatternValue> parsePatterns(CharSequence... patterns) {
         return parsePatterns(GenericUtils.isEmpty(patterns) ? Collections.emptyList() : Arrays.asList(patterns));
