+
+/**
+ * Evaluates the entries read from an ssh config file for one connection the way OpenSSH does: {@code Host} and
+ * {@code Match} blocks apply in file order, the first value obtained for a keyword wins, {@code Include} files are read
+ * in place, and a {@code Match} using {@code final} makes the entries be evaluated a second time with the resolved host
+ * name.
+ *
+ * @author <a href="mailto:dev@mina.apache.org">Apache MINA SSHD Project</a>
+ * @see    <A HREF="https://man.openbsd.org/ssh_config">ssh_config(5)</A>
+ */
+public class HostConfigEntryEvaluator {
+    /**
+     * Maximum nesting of {@code Include} directives, as in OpenSSH
+     */
+    public static final int MAX_INCLUDE_DEPTH = 16;
+
+    public static final String MATCH_ALL = "all";
+    public static final String MATCH_FINAL = "final";
+    public static final String MATCH_HOST = "host";
+    public static final String MATCH_ORIGINAL_HOST = "originalhost";
+    public static final String MATCH_USER = "user";
+
+    private static final int QUOTED_GLOB_CHAR = 0x10000;
+    private static final Map<String, String> CHARACTER_CLASSES = Collections.unmodifiableMap(
+            Stream.of("Alnum", "Alpha", "Blank", "Cntrl", "Digit", "Graph", "Lower", "Print", "Punct", "Space", "Upper",
+                    "XDigit").collect(Collectors.toMap(name -> name.toLowerCase(Locale.ROOT), name -> "\\p{" + name + "}")));
+
+    private final String host;
+    private final HostConfigEntry entry;
+    private final List<String> certificateFiles = new ArrayList<>();
+    private String passHost;
+    private String resolvedHostName;
+    private boolean finalPass;
+    private boolean finalPassRequested;
+    private boolean matched;
+
+    /**
+     * @param host     The requested host
+     * @param port     The requested port - if positive it takes precedence over the configuration
+     * @param username The requested user - if not {@code null}/empty it takes precedence over the configuration
+     */
+    public HostConfigEntryEvaluator(String host, int port, String username) {
+        this.host = host;
+        this.passHost = host;
+        this.entry = new HostConfigEntry(host, null, port, username);
+    }
+
+    /**
+     * @param  entries     The entries in file order
+     * @return             The effective entry, or {@code null} if no block applied
+     * @throws IOException If an included file cannot be read or is invalid
+     */
+    public HostConfigEntry resolve(Collection<? extends HostConfigEntry> entries) throws IOException {
+        evaluate(entries, true, 0);
+        if (finalPassRequested) {
+            String name = entry.getHostName();
+            String resolved = (GenericUtils.isEmpty(name) ? host : HostConfigEntry.substituteHostName(name, host))
+                    .toLowerCase(Locale.ROOT);
+            // Like OpenSSH: the resolved name is fixed now, so HostName lines of the final pass have no effect.
+            resolvedHostName = resolved;
+            entry.setHostName(resolved);
+            passHost = resolved;
+            finalPass = true;
+            evaluate(entries, true, 0);
+        }
+
+        if (!matched) {
+            return null;
+        }
+
+        applyDefaults();
+        return entry;
+    }
+
+    protected void evaluate(Collection<? extends HostConfigEntry> entries, boolean enabled, int depth) throws IOException {
+        for (HostConfigEntry e : entries) {
+            List<String> criteria = e.getMatchCriteria();
+            boolean active;
+            if (GenericUtils.isEmpty(criteria)) {
+                active = enabled && e.isHostMatch(passHost, 0);
+            } else {
+                // A Match line is always evaluated, so that a "final" in a block that does not apply is still seen.
+                active = isMatch(criteria) && enabled;
+            }
+            matched |= active;
+
+            if (GenericUtils.isEmpty(criteria) && GenericUtils.isEmpty(e.getConfigLines())) {
+                if (active) {
+                    String certificates = e.getProperty(HostConfigEntry.CERTIFICATE_FILE_CONFIG_PROP);
+                    if (GenericUtils.isNotEmpty(certificates)) {
+                        certificateFiles.addAll(Arrays.asList(GenericUtils.split(certificates, ',')));
+                    }
+                    entry.collate(e);
+                }
+                continue;
+            }
+
+            if (active && GenericUtils.isNotEmpty(e.getHost())) {
+                entry.getProperties().putIfAbsent(HostConfigEntry.HOST_CONFIG_PROP, e.getHost());
+            }
+
+            for (Map.Entry<String, List<String>> line : getCurrentLines(e)) {
+                String keyword = line.getKey();
+                if (HostConfigEntry.INCLUDE_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+                    includeFiles(line.getValue(), active, depth + 1);
+                } else if (active) {
+                    apply(keyword, line.getValue());
+                }
+            }
+        }
+    }
+
+    /**
+     * Gives the lines of an entry read from a file with the values the entry holds now, so that a value changed through
+     * its setters after it was read is the one evaluated. Every keyword takes its current value in the place of its
+     * first line, and {@code Include} lines keep their place. Identity and certificate files keep the values of each of
+     * their lines while they are unchanged, since every such line adds values in its own place. Keywords that only the
+     * setters gave come after the lines.
+     *
+     * @param  e The entry
+     * @return   The lines to evaluate, in order
+     */
+    protected static List<Map.Entry<String, List<String>>> getCurrentLines(HostConfigEntry e) {
+        List<Map.Entry<String, List<String>>> recorded = e.getConfigLines();
+        Set<String> keywords = new TreeSet<>(String.CASE_INSENSITIVE_ORDER);
+        List<String> identities = new ArrayList<>();
+        List<String> certificates = new ArrayList<>();
+        for (Map.Entry<String, List<String>> line : recorded) {
+            String keyword = line.getKey();
+            keywords.add(keyword);
+            if (HostConfigEntry.IDENTITY_FILE_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+                identities.addAll(line.getValue());
+            } else if (HostConfigEntry.CERTIFICATE_FILE_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+                certificates.addAll(line.getValue());
+            }
+        }
+        boolean identitiesUnchanged = identities.equals(new ArrayList<>(e.getIdentities()));
+        boolean certificatesUnchanged = GenericUtils.join(certificates, ',')
+                .equals(e.getProperty(HostConfigEntry.CERTIFICATE_FILE_CONFIG_PROP, ""));
+
+        List<Map.Entry<String, List<String>>> lines = new ArrayList<>(recorded.size());
+        Set<String> placed = new TreeSet<>(String.CASE_INSENSITIVE_ORDER);
+        for (Map.Entry<String, List<String>> line : recorded) {
+            String keyword = line.getKey();
+            if (HostConfigEntry.INCLUDE_CONFIG_PROP.equalsIgnoreCase(keyword)
+                    || (identitiesUnchanged && HostConfigEntry.IDENTITY_FILE_CONFIG_PROP.equalsIgnoreCase(keyword))
+                    || (certificatesUnchanged && HostConfigEntry.CERTIFICATE_FILE_CONFIG_PROP.equalsIgnoreCase(keyword))) {
+                lines.add(line);
+            } else if (placed.add(keyword)) {
+                addCurrentLine(lines, e, keyword);
+            }
+        }
+
+        for (String keyword : e.getProperties().keySet()) {
+            if (!keywords.contains(keyword) && !HostConfigEntry.HOST_CONFIG_PROP.equalsIgnoreCase(keyword)
+                    && !HostConfigEntry.INCLUDE_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+                addCurrentLine(lines, e, keyword);
+            }
+        }
+        return lines;
+    }
+
+    /**
+     * Reads the files that the paths of an {@code Include} line name, in order, each in place.
+     *
+     * @param  paths       The paths given on the line
+     * @param  enabled     Whether the {@code Include} line applies
+     * @param  depth       The nesting depth of the files
+     * @throws IOException If a file cannot be read, is invalid or nested too deep
+     * @see                #expandIncludePath(String)
+     */
+    protected void includeFiles(List<String> paths, boolean enabled, int depth) throws IOException {
+        for (String path : paths) {
+            for (Path file : expandIncludePath(path)) {
+                include(file, enabled, depth);
+            }
+        }
+    }
+
+    /**
+     * Reads an included file in place. Its lines take effect only if {@code enabled}, but it is read in any case, as
+     * OpenSSH does, so that errors and a {@code Match final} in it are seen.
+     *
+     * @param  file        The included file
+     * @param  enabled     Whether the {@code Include} line applies
+     * @param  depth       The nesting depth of the file
+     * @throws IOException If the file cannot be read, is invalid or nested too deep
+     */
+    protected void include(Path file, boolean enabled, int depth) throws IOException {
+        if (depth > MAX_INCLUDE_DEPTH) {
+            throw new StreamCorruptedException("Too many recursive configuration includes at " + file);
+        }
+        if (!Files.isRegularFile(file)) {
+            return;
+        }
+
+        evaluate(HostConfigEntry.readHostConfigEntries(file), enabled, depth);
+    }
+
+    protected void apply(String keyword, List<String> values) {
+        // Each certificate file is kept as given, since a quoted path may contain a comma
+        if (HostConfigEntry.CERTIFICATE_FILE_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+            certificateFiles.addAll(values);
+            return;
+        }
+
+        boolean set;
+        if (HostConfigEntry.HOST_NAME_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+            set = GenericUtils.isEmpty(entry.getHostName());
+        } else if (HostConfigEntry.PORT_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+            set = entry.getPort() <= 0;
+        } else if (HostConfigEntry.USER_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+            set = GenericUtils.isEmpty(entry.getUsername());
+        } else if (HostConfigEntry.PROXY_JUMP_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+            set = GenericUtils.isEmpty(entry.getProxyJump());
+        } else if (HostConfigEntry.EXCLUSIVE_IDENTITIES_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+            set = entry.exclusiveIdentites == null;
+        } else if (HostConfigEntry.isAdditiveProperty(keyword)) {
+            set = true;
+        } else {
+            set = !entry.getProperties().containsKey(keyword);
+        }
+
+        if (set) {
+            entry.processProperty(keyword, values);
+        }
+    }
+
+    protected boolean isMatch(List<String> criteria) {
+        boolean result = true;
+        for (int index = 0; index < criteria.size(); index++) {
+            String attribute = criteria.get(index);
+            boolean negated = attribute.startsWith(String.valueOf(HostPatternsHolder.NEGATION_CHAR_PATTERN));
+            String name = getCriterionName(attribute);
+            if (MATCH_ALL.equals(name)) {
+                return result && !negated;
+            }
+
+            boolean value;
+            if (MATCH_FINAL.equals(name)) {
+                finalPassRequested = true;
+                value = finalPass;
+            } else {
+                index++;
+                String patterns = criteria.get(index);
+                switch (name) {
+                    case MATCH_HOST:
+                        value = HostPatternsHolder.isPatternListMatch(getMatchHost(), patterns, true);
+                        break;
+                    case MATCH_ORIGINAL_HOST:
+                        value = HostPatternsHolder.isPatternListMatch(host, patterns, true);
+                        break;
+                    case MATCH_USER:
+                        value = HostPatternsHolder.isPatternListMatch(getMatchUser(), patterns, false);
+                        break;
+                    default:
+                        throw new IllegalStateException("Unsupported Match attribute " + attribute);
+                }
+            }
+
+            if (value == negated) {
+                result = false;
+            }
+        }
+        return result;
+    }
+
+    /**
+     * @return The host name a {@code Match host} checks: the host name obtained so far with {@code %h} substituted, or
+     *         the requested host, and the resolved host name during the final pass
+     */
+    protected String getMatchHost() {
+        if (finalPass) {
+            return passHost;
+        }
+
+        String name = entry.getHostName();
+        return GenericUtils.isEmpty(name) ? host : HostConfigEntry.substituteHostName(name, host);
+    }
+
+    /**
+     * @return The user a {@code Match user} checks: the user obtained so far, or the local user
+     */
+    protected String getMatchUser() {
+        String user = entry.getUsername();
+        return GenericUtils.isEmpty(user) ? OsUtils.getCurrentUser() : user;
+    }
+
+    protected void applyDefaults() throws IOException {
+        if (resolvedHostName == null) {
+            // Host names are only compared without regard to case, so without a final pass the HostName keeps its case
+            String name = entry.getHostName();
+            entry.setHostName(GenericUtils.isEmpty(name) ? host : HostConfigEntry.substituteHostName(name, host));
+        }
+        if (GenericUtils.isEmpty(entry.getUsername())) {
+            entry.setUsername(OsUtils.getCurrentUser());
+        }
+        if (entry.getPort() < 1) {
+            entry.setPort(SshConstants.DEFAULT_PORT);
+        }
+
+        Collection<String> identities = entry.getIdentities();
+        if (!GenericUtils.isEmpty(identities)) {
+            Set<String> resolved = new LinkedHashSet<>();
+            for (String id : identities) {
+                resolved.add(HostConfigEntry.resolveIdentityFilePath(id, entry.getHostName(), entry.getPort(),
+                        entry.getUsername()));
+            }
+            entry.setIdentities(resolved);
+        }
+
+        entry.removeProperty(HostConfigEntry.CERTIFICATE_FILE_CONFIG_PROP);
+        if (!certificateFiles.isEmpty()) {
+            Set<String> resolved = new LinkedHashSet<>();
+            for (String raw : certificateFiles) {
+                resolved.add(HostConfigEntry.resolveIdentityFilePath(raw, entry.getHostName(), entry.getPort(),
+                        entry.getUsername()));
+            }
+            entry.processProperty(HostConfigEntry.CERTIFICATE_FILE_CONFIG_PROP, resolved);
+        }
+    }
+
+    /**
+     * Checks the criteria of a {@code Match} line as ssh_config(5) describes them: every criterion except {@code all}
+     * and {@code final} takes patterns, and {@code all} must appear alone or right after {@code final}. As in OpenSSH,
+     * the criteria end at an empty argument, which must be the last one. A comment was cut off before, so a quoted
+     * {@code '#'} here is plain text.
+     *
+     * @param  criteria                 The arguments following the {@code Match} keyword
+     * @param  lineNumber               The line number, for error messages
+     * @return                          The criteria, without what closes them
+     * @throws StreamCorruptedException If OpenSSH would refuse the line, or it uses an unsupported criterion
+     */
+    public static List<String> validateMatchCriteria(List<String> criteria, int lineNumber)
+            throws StreamCorruptedException {
+        int count = criteria.size();
+        List<String> result = new ArrayList<>(count);
+        for (int index = 0; index < count; index++) {
+            String attribute = criteria.get(index);
+            if (attribute.isEmpty()) {
+                if (index < count - 1) {
+                    throw new StreamCorruptedException("Extra arguments for Match at line " + lineNumber);
+                }
+                break;
+            }
+
+            String name = getCriterionName(attribute);
+            result.add(attribute);
+            if (MATCH_ALL.equals(name)) {
+                boolean afterFinal = (index == 1) && MATCH_FINAL.equals(getCriterionName(criteria.get(0)));
+                boolean last = (index == count - 1) || ((index == count - 2) && criteria.get(index + 1).isEmpty());
+                if (!last || ((index > 0) && !afterFinal)) {
+                    throw new StreamCorruptedException(
+                            "'" + attribute + "' cannot be combined with other Match attributes at line " + lineNumber);
+                }
+                break;
+            }
+
+            if (MATCH_FINAL.equals(name)) {
+                continue;
+            }
+            if (!MATCH_HOST.equals(name) && !MATCH_ORIGINAL_HOST.equals(name) && !MATCH_USER.equals(name)) {
+                throw new StreamCorruptedException("Unsupported Match attribute " + attribute + " at line " + lineNumber);
+            }
+
+            index++;
+            if ((index >= count) || criteria.get(index).isEmpty()) {
+                throw new StreamCorruptedException("Missing Match criteria for " + name + " at line " + lineNumber);
+            }
+            result.add(criteria.get(index));
+        }
+
+        if (result.isEmpty()) {
+            throw new StreamCorruptedException("One or more attributes required for Match at line " + lineNumber);
+        }
+        return result;
+    }
+
+    /**
+     * Expands an {@code Include} argument to the existing files it names, in lexical order. A relative path is taken
+     * relative to the {@code .ssh} folder of the user's home, and a leading {@code ~/} stands for the user's home.
+     * Wildcards follow {@code glob(7)}, where a leading dot is matched only when given explicitly.
+     *
+     * @param  path        The {@code Include} argument
+     * @return             The matching paths, sorted
+     * @throws IOException If a folder cannot be listed
+     * @see                PathUtils#getUserHomeFolder()
+     */
+    public static List<Path> expandIncludePath(String path) throws IOException {
+        if (GenericUtils.isEmpty(path)) {
+            return Collections.emptyList();
+        }
+
+        Path home = PathUtils.getUserHomeFolder();
+        String root = getRoot(path);
+        String rest;
+        List<Path> current = new ArrayList<>();
+        if (path.charAt(0) == PathUtils.HOME_TILDE_CHAR) {
+            if ((path.length() > 1) && !isSeparator(path.charAt(1))) {
+                throw new StreamCorruptedException("Unsupported include path " + path);
+            }
+            current.add(home);
+            rest = path.substring(1);
+        } else if (root != null) {
+            current.add(Paths.get(root));
+            rest = path.substring(root.length());
+        } else {
+            current.add(home.resolve(PublicKeyEntry.STD_KEYFILE_FOLDER_NAME));
+            rest = path;
+        }
+
+        for (String name : rest.split((File.separatorChar == '/') ? "/" : "[/\\\\]")) {
+            if (name.isEmpty()) {
+                continue;
+            }
+
+            boolean wildcard = (name.indexOf('*') >= 0) || (name.indexOf('?') >= 0) || (name.indexOf('[') >= 0)
+                    || (name.indexOf('\\') >= 0);
+            Pattern glob = wildcard ? toGlobPattern(name) : null;
+            boolean hidden = name.startsWith(".") || name.startsWith("\\.");
+            List<Path> next = new ArrayList<>();
+            for (Path parent : current) {
+                if (!wildcard) {
+                    next.add(parent.resolve(name));
+                } else if ((glob != null) && Files.isDirectory(parent)) {
+                    next.addAll(listMatching(parent, glob, hidden));
+                }
+            }
+            current = next;
+        }
+
+        List<Path> result = new ArrayList<>(current.size());
+        for (Path p : current) {
+            if (Files.exists(p)) {
+                result.add(p);
+            }
+        }
+        result.sort(Comparator.comparing(Path::toString));
+        return result;
+    }
+
+    /**
+     * @param  folder      The folder to list
+     * @param  glob        The expression the names must match
+     * @param  hidden      Whether names starting with a dot may match
+     * @return             The entries of the folder whose names match
+     * @throws IOException If the folder cannot be listed
+     */
+    protected static List<Path> listMatching(Path folder, Pattern glob, boolean hidden) throws IOException {
+        List<Path> matches = new ArrayList<>();
+        try (DirectoryStream<Path> children = Files.newDirectoryStream(folder)) {
+            for (Path child : children) {
+                String childName = child.getFileName().toString();
+                if ((hidden || !childName.startsWith(".")) && glob.matcher(childName).matches()) {
+                    matches.add(child);
+                }
+            }
+        }
+        return matches;
+    }
+
+    /**
+     * Converts one element of an {@code Include} path to a regular expression the way the glob(3) of OpenSSH reads it:
+     * {@code *}, {@code ?}, and bracket expressions with ranges, a leading {@code !} and classes such as
+     * {@code [:digit:]}, where a {@code ]} right after the opening bracket is a member. A backslash quotes the next
+     * character, and braces are not special.
+     *
+     * @param  glob The path element
+     * @return      The expression, or {@code null} if it names an unknown class and so matches nothing
+     */
+    protected static Pattern toGlobPattern(String glob) {
+        int len = glob.length();
+        int[] chars = new int[len + 2];
+        int count = 0;
+        for (int index = 0; index < len; index++) {
+            char ch = glob.charAt(index);
+            if ((ch == '\\') && (index + 1 < len)) {
+                index++;
+                chars[count] = glob.charAt(index) | QUOTED_GLOB_CHAR;
+            } else {
+                chars[count] = ch;
+            }
+            count++;
+        }
+        Arrays.fill(chars, count, chars.length, -1);
+
+        StringBuilder regex = new StringBuilder(len + Long.SIZE);
+        for (int index = 0; index < count; index++) {
+            int ch = chars[index];
+            if (ch == '*') {
+                regex.append(".*");
+            } else if (ch == '?') {
+                regex.append('.');
+            } else if (ch != '[') {
+                regex.append(Pattern.quote(String.valueOf((char) ch)));
+            } else {
+                int end = appendBracketExpression(chars, index, count, regex);
+                if (end >= count) {
+                    return null;
+                }
+                if (end < 0) {
+                    regex.append("\\[");
+                } else {
+                    index = end;
+                }
+            }
+        }
+        return Pattern.compile(regex.toString(), Pattern.DOTALL);
+    }
+
+    /**
+     * Appends a glob(3) bracket expression as a character class: its members, ranges and classes such as
+     * {@code [:digit:]}, negated by a leading {@code !}, where a {@code ]} right after the opening bracket or after the
+     * {@code !} is a member. As in glob(3), the bracket is a plain character unless a later {@code ]} closes the
+     * expression.
+     *
+     * @param  chars The pattern characters, a quoted one with an extra high bit so it is never special, followed by -1
+     * @param  start The index of the opening bracket
+     * @param  count The number of pattern characters
+     * @param  regex The expression to append to
+     * @return       The index of the closing bracket, -1 if the opening bracket is a plain character, or {@code count}
+     *               if nothing can match because the expression names an unknown class or a class takes its closing
+     *               bracket
+     */
+    protected static int appendBracketExpression(int[] chars, int start, int count, StringBuilder regex) {
+        int c = start + 1;
+        boolean negated = chars[c] == '!';
+        if (negated) {
+            c++;
+        }
+        int end = c + 1;
+        while ((end < count) && (chars[end] != ']')) {
+            end++;
+        }
+        if ((chars[c] < 0) || (end >= count)) {
+            return -1;
+        }
+
+        StringBuilder set = new StringBuilder();
+        boolean afterClass = false;
+        while (true) {
+            int colon = ((chars[c] == '[') && (chars[c + 1] == ':')) ? findClassNameEnd(chars, c + 2) : -1;
+            if (colon >= 0) {
+                StringBuilder name = new StringBuilder(colon - c);
+                for (int k = c + 2; k < colon; k++) {
+                    name.append((char) chars[k]);
+                }
+                String cls = CHARACTER_CLASSES.get(name.toString());
+                if (cls == null) {
+                    return count;
+                }
+                set.append(cls);
+                afterClass = true;
+                c = colon + 2;
+                continue;
+            }
+            if ((chars[c] < 0) || (afterClass && (chars[c] == ']'))) {
+                break;
+            }
+
+            afterClass = false;
+            int q = c + 1;
+            char lo = (char) chars[c];
+            if ((chars[q] == '-') && (chars[q + 1] >= 0) && (chars[q + 1] != ']')) {
+                char hi = (char) chars[q + 1];
+                if (lo <= hi) {
+                    set.append(Character.isLetterOrDigit(lo) ? "" : "\\").append(lo).append('-');
+                    set.append(Character.isLetterOrDigit(hi) ? "" : "\\").append(hi);
+                }
+                q += 2;
+            } else {
+                set.append(Character.isLetterOrDigit(lo) ? "" : "\\").append(lo);
+            }
+            c = q;
+            if ((chars[c] < 0) || (chars[c] == ']')) {
+                break;
+            }
+        }
+        if (chars[c] < 0) {
+            return count;
+        }
+
+        if (set.length() == 0) {
+            regex.append(negated ? "." : "(?!)");
+        } else {
+            regex.append('[').append(negated ? "^" : "").append(set).append(']');
+        }
+        return c;
+    }
+
+    private static void addCurrentLine(List<Map.Entry<String, List<String>>> lines, HostConfigEntry e, String keyword) {
+        List<String> values;
+        if (HostConfigEntry.IDENTITY_FILE_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+            values = new ArrayList<>(e.getIdentities());
+        } else {
+            String value = e.getProperty(keyword);
+            if (GenericUtils.isEmpty(value)) {
+                values = Collections.emptyList();
+            } else if (HostConfigEntry.CERTIFICATE_FILE_CONFIG_PROP.equalsIgnoreCase(keyword)) {
+                values = Arrays.asList(GenericUtils.split(value, ','));
+            } else {
+                values = Collections.singletonList(value);
+            }
+        }
+
+        if (!values.isEmpty()) {
+            lines.add(new SimpleImmutableEntry<>(keyword, values));
+        }
+    }
+
+    /**
+     * @param  chars The pattern characters, followed by -1
+     * @param  from  Where the name of a character class starts, after its {@code [:}
+     * @return       The index of the {@code :} that ends the name if a {@code ]} follows it, -1 otherwise
+     */
+    private static int findClassNameEnd(int[] chars, int from) {
+        int colon = from;
+        while ((chars[colon] >= 0) && (chars[colon] != ':')) {
+            colon++;
+        }
+        return ((chars[colon] >= 0) && (chars[colon + 1] == ']')) ? colon : -1;
+    }
+
+    private static String getRoot(String path) {
+        if (isSeparator(path.charAt(0))) {
+            return path.substring(0, 1);
+        }
+        if (OsUtils.isWin32() && (path.length() > 2) && (path.charAt(1) == ':') && isSeparator(path.charAt(2))) {
+            return path.substring(0, 3);
+        }
+        return null;
+    }
+
+    private static boolean isSeparator(char ch) {
+        return (ch == '/') || (ch == File.separatorChar);
+    }
+
+    private static String getCriterionName(String attribute) {
+        String name = attribute.startsWith(String.valueOf(HostPatternsHolder.NEGATION_CHAR_PATTERN))
+                ? attribute.substring(1) : attribute;
+        return name.toLowerCase(Locale.ROOT);
+    }
+}
