+func TestSnapshotDiffChangesFollowDpkgVersionOrder(t *testing.T) {
+	e := newAptlyEnv(t)
+	downOld := entry("down", "1.5-1", "  * Fix a crash on startup.") + entry("down", "1.0-1", "  * Initial release.")
+	downNew := entry("down", "2.0-1", "  * New upstream release.") + downOld
+	epochOld := entry("epo", "2.3-1", "  * New snapshot.") + entry("epo", "2.2-1", "  * Initial release.")
+	epochNew := entry("epo", "1:0.9-1", "  * Follow the new upstream version scheme, which needs an epoch.") + epochOld
+	preOld := entry("pre", "3.0~rc1-1", "  * Package the first release candidate.") + entry("pre", "2.9-1", "  * Initial release.")
+	preNew := entry("pre", "3.0-1", "  * Package the final release.") + preOld
+	toolA := entry("tool", "4.3.5a-1", "  * Package the 4.3.5a tarball.") + entry("tool", "4.3.4-1", "  * Initial release.")
+	toolB := entry("tool", "4.3.5-rc3-1", "  * Package the 4.3.5-rc3 tarball.") + toolA
+	ciA := entry("ci", "2.1+ci20251020103015000000001-1", "  * Rebuild from CI run 1.") + entry("ci", "2.0-1", "  * Initial release.")
+	ciB := entry("ci", "2.1+ci20251020103015000000002-1", "  * Rebuild from CI run 2.") + ciA
+	e.snapshot("a",
+		e.deb(debPackage{name: "down", version: "2.0-1", arch: "amd64", files: []debFile{doc("down", "changelog.Debian.gz", downNew)}}),
+		e.deb(debPackage{name: "epo", version: "1:0.9-1", arch: "all", files: []debFile{doc("epo", "changelog.Debian.gz", epochNew)}}),
+		e.deb(debPackage{name: "pre", version: "3.0~rc1-1", arch: "amd64", files: []debFile{doc("pre", "changelog.Debian.gz", preOld)}}),
+		e.deb(debPackage{name: "tool", version: "4.3.5a-1", arch: "amd64", files: []debFile{doc("tool", "changelog.Debian.gz", toolA)}}),
+		e.deb(debPackage{name: "ci", version: "2.1+ci20251020103015000000001-1", arch: "amd64", files: []debFile{doc("ci", "changelog.Debian.gz", ciA)}}),
+	)
