+type sourcePackage struct {
+	name, upstream, format, compression string
+	native, gitArchive                  bool
+	changelog, origChangelog            string
+}
+
+func (e *aptlyEnv) gitArchive(prefix string, files map[string]string, out string) {
+	e.t.Helper()
+	repo := e.workDir("git")
+	for name, content := range files {
+		writeFile(e.t, filepath.Join(repo, name), []byte(content))
+	}
+	environ := []string{"GIT_CONFIG_NOSYSTEM=1", "GIT_CONFIG_GLOBAL=/dev/null", "GIT_AUTHOR_DATE=2025-10-20T10:00:00Z", "GIT_COMMITTER_DATE=2025-10-20T10:00:00Z"}
+	for _, variable := range os.Environ() {
+		if !strings.HasPrefix(variable, "GIT_") {
+			environ = append(environ, variable)
+		}
+	}
+	for _, args := range [][]string{{"init", "-q"}, {"add", "."}, {"commit", "-q", "-m", "Release " + prefix}, {"archive", "--format=tar.gz", "--prefix=" + prefix + "/", "-o", out, "HEAD"}} {
+		cmd := exec.Command("git", append([]string{"-c", "user.name=Ann Example", "-c", "user.email=ann@example.org", "-c", "init.defaultBranch=main"}, args...)...)
+		cmd.Dir = repo
+		cmd.Env = environ
+		if output, err := cmd.CombinedOutput(); err != nil {
+			e.t.Fatalf("git %s: %v\n%s", strings.Join(args, " "), err, output)
+		}
+	}
+}
+
+func (e *aptlyEnv) source(p sourcePackage) string {
+	e.t.Helper()
+	dir := e.workDir("sources")
+	if !p.native {
+		orig := map[string]string{"README": "upstream sources\n"}
+		if p.origChangelog != "" {
+			orig["debian/changelog"] = p.origChangelog
+		}
+		origPath := filepath.Join(dir, p.name+"_"+p.upstream+".orig.tar.gz")
+		if p.gitArchive {
+			e.gitArchive(p.name+"-"+p.upstream, orig, origPath)
+		} else {
+			prefixed := map[string]string{}
+			for name, content := range orig {
+				prefixed[p.name+"-"+p.upstream+".orig/"+name] = content
+			}
+			writeFile(e.t, origPath, tarGz(e.t, prefixed))
+		}
+	}
+	tree := filepath.Join(dir, p.name+"-"+p.upstream)
+	control := fmt.Sprintf("Source: %s\nMaintainer: Ann Example <ann@example.org>\n\nPackage: %s\nArchitecture: any\nDescription: test package\n test package\n",
+		p.name, p.name)
+	writeFile(e.t, filepath.Join(tree, "README"), []byte("upstream sources\n"))
+	writeFile(e.t, filepath.Join(tree, "debian", "changelog"), []byte(p.changelog))
+	writeFile(e.t, filepath.Join(tree, "debian", "control"), []byte(control))
+	writeFile(e.t, filepath.Join(tree, "debian", "source", "format"), []byte(p.format+"\n"))
+	args := []string{"-b"}
+	if p.compression != "" {
+		args = append(args, "-Z"+p.compression)
+	}
+	cmd := exec.Command("dpkg-source", append(args, filepath.Base(tree))...)
+	cmd.Dir = dir
+	if output, err := cmd.CombinedOutput(); err != nil {
+		e.t.Fatalf("dpkg-source -b %s: %v\n%s", p.name, err, output)
+	}
+	dscs, err := filepath.Glob(filepath.Join(dir, "*.dsc"))
+	if err != nil || len(dscs) != 1 {
+		e.t.Fatalf("dpkg-source -b %s built %v (%v)", p.name, dscs, err)
+	}
+	return dscs[0]
+}
