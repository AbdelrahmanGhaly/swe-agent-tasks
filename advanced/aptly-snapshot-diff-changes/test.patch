+type debFile struct {
+	path, content, link string
+}
+
+func doc(pkg, name, content string) debFile {
+	return debFile{path: "usr/share/doc/" + pkg + "/" + name, content: content}
+}
+
+func symlink(path, target string) debFile {
+	return debFile{path: path, link: target}
+}
+
+type debPackage struct {
+	name, version, arch, compression string
+	files                            []debFile
+}
+
+func (e *aptlyEnv) deb(p debPackage) string {
+	e.t.Helper()
+	dir := e.workDir("debs")
+	root := filepath.Join(dir, "root")
+	control := fmt.Sprintf("Package: %s\nVersion: %s\nArchitecture: %s\nMaintainer: Ann Example <ann@example.org>\nDescription: test package\n",
+		p.name, p.version, p.arch)
+	writeFile(e.t, filepath.Join(root, "DEBIAN", "control"), []byte(control))
+	if err := os.Chmod(filepath.Join(root, "DEBIAN"), 0755); err != nil {
+		e.t.Fatal(err)
+	}
+	for _, f := range p.files {
+		path := filepath.Join(root, f.path)
+		if f.link != "" {
+			if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+				e.t.Fatal(err)
+			}
+			if err := os.Symlink(f.link, path); err != nil {
+				e.t.Fatal(err)
+			}
+		} else if strings.HasSuffix(f.path, ".gz") {
+			writeFile(e.t, path, gzipped(e.t, f.content))
+		} else {
+			writeFile(e.t, path, []byte(f.content))
+		}
+	}
+	compression := p.compression
+	if compression == "" {
+		compression = "xz"
+	}
+	out := filepath.Join(dir, strings.ReplaceAll(p.name+"_"+p.version+"_"+p.arch, ":", "%3a")+".deb")
+	if output, err := exec.Command("dpkg-deb", "--root-owner-group", "-Z"+compression, "--build", root, out).CombinedOutput(); err != nil {
+		e.t.Fatalf("dpkg-deb --build %s %s: %v\n%s", p.name, p.version, err, output)
+	}
+	return out
+}
