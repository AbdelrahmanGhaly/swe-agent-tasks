+
+func TestMain(m *testing.M) {
+	dir, err := os.MkdirTemp("", "aptly-diff-changes")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	aptlyBinary = filepath.Join(dir, "aptly")
+	if out, err := exec.Command("go", "build", "-o", aptlyBinary, "..").CombinedOutput(); err != nil {
+		aptlySetupError = fmt.Errorf("unable to build aptly: %v\n%s", err, out)
+	} else if aptlyEnviron, err = environWithoutDpkg(filepath.Join(dir, "no-dpkg")); err != nil {
+		aptlySetupError = fmt.Errorf("unable to hide the dpkg tools from aptly: %v", err)
+	}
+	code := m.Run()
+	_ = os.RemoveAll(dir)
+	os.Exit(code)
+}
+
+func environWithoutDpkg(dir string) ([]string, error) {
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return nil, err
+	}
+	tools := map[string]bool{"dpkg": true, "dpkg-deb": true, "dpkg-parsechangelog": true, "dpkg-source": true}
+	for _, pathDir := range filepath.SplitList(os.Getenv("PATH")) {
+		found, _ := filepath.Glob(filepath.Join(pathDir, "dpkg*"))
+		for _, tool := range found {
+			tools[filepath.Base(tool)] = true
+		}
+	}
+	for tool := range tools {
+		stub := "#!/bin/sh\necho \"" + tool + " is not available to aptly\" >&2\nexit 127\n"
+		if err := os.WriteFile(filepath.Join(dir, tool), []byte(stub), 0755); err != nil {
+			return nil, err
+		}
+	}
+	environ := []string{"PATH=" + dir + string(os.PathListSeparator) + os.Getenv("PATH")}
+	for _, variable := range os.Environ() {
+		if !strings.HasPrefix(variable, "PATH=") {
+			environ = append(environ, variable)
+		}
+	}
+	return environ, nil
+}
+
+type aptlyEnv struct {
+	t      *testing.T
+	dir    string
+	config string
+	builds int
+}
+
+func newAptlyEnv(t *testing.T) *aptlyEnv {
+	t.Helper()
+	if aptlySetupError != nil {
+		t.Fatal(aptlySetupError)
+	}
+	dir := t.TempDir()
+	config := filepath.Join(dir, "aptly.conf")
+	content := fmt.Sprintf("{\"rootDir\": %q, \"architectures\": []}\n", filepath.Join(dir, "root"))
+	if err := os.WriteFile(config, []byte(content), 0644); err != nil {
+		t.Fatal(err)
+	}
+	return &aptlyEnv{t: t, dir: dir, config: config}
+}
+
+func (e *aptlyEnv) exec(args ...string) (string, string, error) {
+	cmd := exec.Command(aptlyBinary, append([]string{"-config=" + e.config}, args...)...)
+	cmd.Env = aptlyEnviron
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	err := cmd.Run()
+	return stdout.String(), stderr.String(), err
+}
+
+func (e *aptlyEnv) run(args ...string) string {
+	e.t.Helper()
+	stdout, stderr, err := e.exec(args...)
+	if err != nil {
+		e.t.Fatalf("aptly %s: %v\nstdout:\n%s\nstderr:\n%s", strings.Join(args, " "), err, stdout, stderr)
+	}
+	return stdout
+}
+
+func (e *aptlyEnv) workDir(kind string) string {
+	e.t.Helper()
+	e.builds++
+	dir := filepath.Join(e.dir, kind, strconv.Itoa(e.builds))
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		e.t.Fatal(err)
+	}
+	return dir
+}
+
+func writeFile(t *testing.T, path string, content []byte) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, content, 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func gzipped(t *testing.T, content string) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	gz := gzip.NewWriter(&buf)
+	if _, err := gz.Write([]byte(content)); err != nil {
+		t.Fatal(err)
+	}
+	if err := gz.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
+
+func tarGz(t *testing.T, files map[string]string) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	gz := gzip.NewWriter(&buf)
+	tw := tar.NewWriter(gz)
+	names := make([]string, 0, len(files))
+	for name := range files {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		if err := tw.WriteHeader(&tar.Header{Name: name, Mode: 0644, Size: int64(len(files[name]))}); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := tw.Write([]byte(files[name])); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := tw.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := gz.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
