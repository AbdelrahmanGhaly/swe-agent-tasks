+const trailer = " -- Ann Example <ann@example.org>  Mon, 20 Oct 2025 10:00:00 +0000"
+
+func entry(source, version string, changes ...string) string {
+	return source + " (" + version + ") unstable; urgency=medium\n\n" + strings.Join(changes, "\n") + "\n\n" + trailer + "\n\n"
