+	"Non-maintainer upload.",
+	"Refresh patches; one now needs a 3-line offset.",
+	"Mark libfoo-dev Multi-Arch: same.",
+}
+
+func randomBlankLines(r *changelogRand, b *strings.Builder) {
+	count := 1
+	if r.chance(15) {
+		count = 0
+	} else if r.chance(15) {
+		count = 2
+	}
+	for i := 0; i < count; i++ {
+		if r.chance(20) {
+			b.WriteString(r.pick(" ", "\t", "   "))
+		}
+		b.WriteString("\n")
+	}
+}
+
+func randomTrailingSpace(r *changelogRand) string {
+	return r.pick("", "", "", "", " ", "  ", "\t", " \t")
+}
+
+func randomChangelog(r *changelogRand, source string, versions []string) string {
+	var b strings.Builder
+	for i, version := range versions {
+		distribution := r.pick("unstable", "unstable", "experimental", "trixie unstable")
+		if strings.Contains(version, "+deb") {
+			distribution = "trixie-security"
+		}
+		b.WriteString(source + " (" + version + ") " + distribution + "; urgency=" +
+			r.pick("low", "medium", "high", "critical") + randomTrailingSpace(r) + "\n")
+		randomBlankLines(r, &b)
+		items := 1 + r.intn(4)
+		for k := 0; k < items; k++ {
+			if r.chance(10) {
+				b.WriteString("  [ " + r.pick("Ann Example", "Bob Builder", "Zoë Tester") + " ]\n")
+			}
+			b.WriteString(r.pick("  * ", "  * ", "  * ", "    - ", "    + ") + changePhrases[r.intn(len(changePhrases))] + randomTrailingSpace(r) + "\n")
+			if k+1 < items && r.chance(20) {
+				randomBlankLines(r, &b)
+			}
+		}
+		randomBlankLines(r, &b)
+		b.WriteString(" -- " + r.pick("Ann Example <ann@example.org>", "Bob Builder <bob@example.net>") +
+			"  " + r.pick("Mon, 20 Oct 2025 10:00:00 +0000", "Tue, 02 Sep 2025 23:15:42 +0200", "Sun, 05 Jan 2025 08:01:09 -0500") +
+			randomTrailingSpace(r) + "\n")
+		if i+1 < len(versions) {
+			randomBlankLines(r, &b)
+		}
+	}
+	return b.String()
+}
+
+func checkRandomChangelogs(t *testing.T, seed uint64) {
+	e := newAptlyEnv(t)
+	r := &changelogRand{state: seed}
+	var a, b []string
+	want := map[string]string{}
+	for i := 0; i < 10; i++ {
+		name := fmt.Sprintf("rand%d-%d", seed, i)
+		arch := r.pick("amd64", "amd64", "i386", "arm64", "all")
+		history := randomHistory(r)
+		versions := make([]string, 0, len(history)+1)
+		for j := len(history) - 1; j >= 0; j-- {
+			versions = append(versions, history[j])
+		}
+		if len(versions) >= 3 && r.chance(35) {
+			at := 1 + r.intn(len(versions)-2)
+			security := versions[at+1] + "+deb13u1"
+			versions = append(versions[:at], append([]string{security}, versions[at:]...)...)
+		}
+		var older string
+		switch k := r.intn(10); {
+		case k < 5:
+			older = versions[1+r.intn(len(versions)-1)]
+		case k < 8:
+			older = versions[1+r.intn(len(versions)-1)] + "+x1"
+		default:
+			older = "0.0.1-1"
+		}
+		changelog := randomChangelog(r, name, versions)
+		compression := r.pick("gzip", "xz", "zstd", "none")
+		newerDeb := e.deb(debPackage{name: name, version: versions[0], arch: arch, compression: compression, files: []debFile{
+			doc(name, "changelog.Debian.gz", changelog)}})
+		olderDeb := e.deb(debPackage{name: name, version: older, arch: arch, compression: compression, files: []debFile{
+			doc(name, "changelog.Debian.gz", entry(name, older, "  * Older upload."))}})
+		if r.chance(30) {
+			a, b = append(a, newerDeb), append(b, olderDeb)
+		} else {
+			a, b = append(a, olderDeb), append(b, newerDeb)
+		}
+		want[name+"_"+arch] = parsedChanges(t, changelog, older)
+	}
+	e.snapshot("a", a...)
+	e.snapshot("b", b...)
+	e.assertChanges("a", "b", want)
+}
