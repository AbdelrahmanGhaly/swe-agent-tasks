+func TestSnapshotDiffChangesBinaryPackages(t *testing.T) {
+	e := newAptlyEnv(t)
+	fooBase := entry("foo", "1.0-1", "  * Initial release. (Closes: #1000)") + entry("foo", "0.9-1", "  * Preview upload.")
+	fooNew := entry("foo", "1.2-1", "  * New upstream release.", "    - Drops the legacy API.") +
+		entry("foo", "1.1-1", "  * Fix the build on arm64.") + fooBase
+	upstream := "2025-09-30  Ann Example <ann@example.org>\n\n\t* src/main.c: Rework option parsing.\n"
+	barNew := entry("bar", "2.1", "  * New upstream release.") + entry("bar", "2.0", "  * Initial release.")
+	rebuilt := entry("rebuilt", "1.0-1", "  * Initial release.") + entry("rebuilt", "0.9-1", "  * Preview upload.")
+	e.snapshot("a",
+		e.deb(debPackage{name: "foo", version: "1.0-1", arch: "amd64", files: []debFile{
+			doc("foo", "changelog.Debian.gz", fooBase), doc("foo", "changelog.gz", upstream)}}),
+		e.deb(debPackage{name: "bar", version: "2.0", arch: "amd64", files: []debFile{
+			doc("bar", "changelog.gz", entry("bar", "2.0", "  * Initial release."))}}),
+		e.deb(debPackage{name: "nochangelog", version: "1.0-1", arch: "amd64", files: []debFile{
+			doc("nochangelog", "copyright", "Files: *\n")}}),
+		e.deb(debPackage{name: "gone", version: "1.0-1", arch: "amd64", files: []debFile{
+			doc("gone", "changelog.Debian.gz", entry("gone", "1.0-1", "  * Initial release."))}}),
+		e.deb(debPackage{name: "rebuilt", version: "1.0-1", arch: "amd64", files: []debFile{
+			doc("rebuilt", "changelog.Debian.gz", rebuilt)}}),
+	)
+	e.snapshot("b",
+		e.deb(debPackage{name: "foo", version: "1.2-1", arch: "amd64", files: []debFile{
+			doc("foo", "changelog.Debian.gz", fooNew), doc("foo", "changelog.gz", upstream)}}),
+		e.deb(debPackage{name: "bar", version: "2.1", arch: "amd64", files: []debFile{
+			doc("bar", "changelog.gz", barNew)}}),
+		e.deb(debPackage{name: "nochangelog", version: "1.0-2", arch: "amd64", files: []debFile{
+			doc("nochangelog", "copyright", "Files: *\n")}}),
+		e.deb(debPackage{name: "added", version: "1.0-1", arch: "amd64", files: []debFile{
+			doc("added", "changelog.Debian.gz", entry("added", "1.0-1", "  * Initial release."))}}),
+		e.deb(debPackage{name: "rebuilt", version: "1.0-1", arch: "amd64", files: []debFile{
+			doc("rebuilt", "changelog.Debian.gz", rebuilt), doc("rebuilt", "README.Debian", "Rebuilt against the new toolchain.\n")}}),
+	)
+	e.assertChanges("a", "b", map[string]string{
+		"foo_amd64": "\nfoo (1.2-1) unstable; urgency=medium\n.\n  * New upstream release.\n    - Drops the legacy API.\n" +
+			".\nfoo (1.1-1) unstable; urgency=medium\n.\n  * Fix the build on arm64.\n",
+		"bar_amd64":         "\nbar (2.1) unstable; urgency=medium\n.\n  * New upstream release.\n",
+		"nochangelog_amd64": "",
+		"rebuilt_amd64":     "",
+	})
+}
