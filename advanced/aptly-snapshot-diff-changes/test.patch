+func (e *aptlyEnv) snapshot(name string, files ...string) {
+	e.t.Helper()
+	e.run("repo", "create", name)
+	if len(files) > 0 {
+		e.run(append([]string{"repo", "add", name}, files...)...)
+	}
+	e.run("snapshot", "create", name, "from", "repo", name)
+}
+
+func diffKey(line string) string {
+	fields := strings.Split(line, "|")
+	if len(fields) < 2 {
+		return ""
+	}
+	return strings.TrimSpace(fields[1]) + "_" + strings.TrimSpace(strings.TrimPrefix(fields[0], "!"))
+}
+
+func (e *aptlyEnv) assertChanges(a, b string, want map[string]string, flags ...string) {
+	e.t.Helper()
+	plain := e.run(append(append([]string{"snapshot", "diff"}, flags...), a, b)...)
+	listed := map[string]bool{}
+	for _, line := range strings.SplitAfter(plain, "\n") {
+		if !strings.HasPrefix(line, "!") {
+			continue
+		}
+		key := diffKey(line)
+		if _, ok := want[key]; !ok {
+			e.t.Fatalf("aptly snapshot diff %s %s lists %s as changed, the test expects no such package:\n%s", a, b, key, plain)
+		}
+		listed[key] = true
+	}
+	for key := range want {
+		if !listed[key] {
+			e.t.Fatalf("aptly snapshot diff %s %s does not list %s as changed:\n%s", a, b, key, plain)
+		}
+	}
+	args := append(append([]string{"snapshot", "diff", "-changes"}, flags...), a, b)
+	e.assertTextUnderRows(strings.Join(args, " "), plain, e.run(args...), want)
+}
+
+func (e *aptlyEnv) assertTextUnderRows(command, plain, got string, want map[string]string) {
+	e.t.Helper()
+	rows := strings.SplitAfter(plain, "\n")
+	under := map[int]string{}
+	next := 0
+	for _, line := range strings.SplitAfter(got, "\n") {
+		if line != "" && next < len(rows) && line == rows[next] {
+			next++
+		} else {
+			under[next-1] += line
+		}
+	}
+	if strings.Join(rows[next:], "") != "" {
+		e.t.Fatalf("aptly %s does not keep the lines of the plain diff in order:\n%s\nplain diff:\n%s", command, got, plain)
+	}
+	for i := -1; i < next; i++ {
+		row, text := "the start of the output", ""
+		if i >= 0 {
+			row = strings.TrimSpace(rows[i])
+			if strings.HasPrefix(rows[i], "!") {
+				text = want[diffKey(rows[i])]
+			}
+		}
+		if sameChanges(under[i], text) {
+			continue
+		}
+		if text == "" {
+			e.t.Errorf("aptly %s printed under %q:\n%s\nwant nothing there", command, row, under[i])
+		} else {
+			e.t.Errorf("aptly %s printed under %q:\n%s\nwant these lines (blank lines around them, a common indentation and one label line above them are fine):\n%s",
+				command, row, under[i], text)
+		}
+	}
+}
+
+func changesLines(text string) []string {
+	var lines []string
+	for _, line := range strings.Split(text, "\n") {
+		if len(lines) > 0 || strings.TrimSpace(line) != "" {
+			lines = append(lines, line)
+		}
+	}
+	for len(lines) > 0 && strings.TrimSpace(lines[len(lines)-1]) == "" {
+		lines = lines[:len(lines)-1]
+	}
+	indent, first := "", true
+	for _, line := range lines {
+		trimmed := strings.TrimLeft(line, " \t")
+		if trimmed == "" {
+			continue
+		}
+		lead := line[:len(line)-len(trimmed)]
+		if first {
+			indent, first = lead, false
+		}
+		for !strings.HasPrefix(lead, indent) {
+			indent = indent[:len(indent)-1]
+		}
+	}
+	for i, line := range lines {
+		lines[i] = strings.TrimPrefix(line, indent)
+	}
+	return lines
+}
+
+func sameChanges(got, want string) bool {
+	gotLines, wantLines := changesLines(got), changesLines(want)
+	if slices.Equal(gotLines, wantLines) {
+		return true
+	}
+	return len(wantLines) > 0 && len(gotLines) == len(wantLines)+1 &&
+		slices.Equal(changesLines(strings.Join(gotLines[1:], "\n")), wantLines)
+}
+
+func parsedChanges(t *testing.T, changelog, since string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "changelog")
+	writeFile(t, path, []byte(changelog))
+	out, err := exec.Command("dpkg-parsechangelog", "-l", path, "--since", since, "-S", "Changes").Output()
+	if err != nil {
+		t.Fatalf("dpkg-parsechangelog --since %s: %v", since, err)
+	}
+	return string(out)
+}
