+		e.deb(debPackage{name: "foo", version: "1.1-1", arch: "amd64", files: []debFile{doc("foo", "changelog.Debian.gz", fooNew)}}),
+		e.deb(debPackage{name: "bare", version: "1.1-1", arch: "all"}),
+		e.deb(debPackage{name: "added", version: "1.0-1", arch: "amd64", files: []debFile{doc("added", "changelog.Debian.gz", entry("added", "1.0-1", "  * Initial release."))}}),
+		e.source(sourcePackage{name: "srcpkg", upstream: "0.2", format: "3.0 (quilt)", changelog: srcNew}),
+	)
+	want := map[string]string{
+		"foo_amd64":     "\nfoo (1.1-1) unstable; urgency=medium\n.\n  * New upstream release.\n",
+		"bare_all":      "",
+		"srcpkg_source": "\nsrcpkg (0.2-1) unstable; urgency=medium\n.\n  * New upstream release.\n",
+	}
+	client := e.serveAPI()
+	for _, path := range []string{"/api/snapshots/a/diff/b?changes=1", "/api/snapshots/a/diff/b?onlyMatching=1&changes=1", "/api/snapshots/b/diff/a?changes=1"} {
+		onlyMatching := strings.Contains(path, "onlyMatching=1")
+		entries := e.apiDiff(client, path)
+		count := 0
+		for _, entry := range entries {
+			name := apiEntryName(entry)
+			if entry["Left"] == nil || entry["Right"] == nil {
+				if onlyMatching {
+					t.Errorf("GET %s returned %s, which is missing from one of the snapshots", path, name)
+				}
+				continue
+			}
+			count++
+			changes := entry["Changes"]
+			if changes == nil {
+				t.Errorf("GET %s: %s has no Changes", path, name)
+			} else if *changes != want[name] {
+				t.Errorf("GET %s: Changes of %s = %q, want %q", path, name, *changes, want[name])
+			}
+		}
+		if count != len(want) {
+			t.Errorf("GET %s returned %d packages present in both snapshots, want %d", path, count, len(want))
+		}
+		if !onlyMatching && len(entries) != len(want)+2 {
+			t.Errorf("GET %s returned %d entries, want %d", path, len(entries), len(want)+2)
+		}
+	}
+	plain := e.apiDiff(client, "/api/snapshots/a/diff/b")
+	if len(plain) != len(want)+2 {
+		t.Errorf("GET without changes returned %d entries, want %d", len(plain), len(want)+2)
+	}
+	for _, entry := range plain {
+		if changes := entry["Changes"]; changes != nil {
+			t.Errorf("GET without changes=1 gives %s Changes %q", apiEntryName(entry), *changes)
+		}
+	}
+}
