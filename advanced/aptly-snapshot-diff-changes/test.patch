+		args := append([]string{"snapshot", "diff"}, c.args...)
+		if got := e.run(args...); got != c.want {
+			t.Errorf("aptly %s printed:\n%s\nwant:\n%s", strings.Join(args, " "), got, c.want)
+		}
+	}
+	for _, c := range []struct {
+		args  []string
+		plain string
+	}{
+		{[]string{"-changes", "a", "b"}, header + added + foo + gone},
+		{[]string{"-changes", "-only-matching", "a", "b"}, header + foo},
+	} {
+		args := append([]string{"snapshot", "diff"}, c.args...)
+		e.assertTextUnderRows(strings.Join(args, " "), c.plain, e.run(args...), changes)
+	}
+}
+
+func TestSnapshotDiffChangesOnIdenticalSnapshots(t *testing.T) {
+	e := newAptlyEnv(t)
+	e.snapshot("a", e.deb(debPackage{name: "foo", version: "1.0-1", arch: "amd64", files: []debFile{
+		doc("foo", "changelog.Debian.gz", entry("foo", "1.0-1", "  * Initial release."))}}))
+	if got := e.run("snapshot", "diff", "-changes", "a", "a"); got != "Snapshots are identical.\n" {
+		t.Errorf("aptly snapshot diff -changes a a printed %q", got)
+	}
+}
