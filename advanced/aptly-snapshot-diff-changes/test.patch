+type changelogRand struct{ state uint64 }
+
+func (r *changelogRand) next() uint64 {
+	r.state += 0x9E3779B97F4A7C15
+	z := r.state
+	z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
+	z = (z ^ (z >> 27)) * 0x94D049BB133111EB
+	return z ^ (z >> 31)
+}
+
+func (r *changelogRand) intn(n int) int { return int(r.next() % uint64(n)) }
+
+func (r *changelogRand) chance(percent int) bool { return r.intn(100) < percent }
+
+func (r *changelogRand) pick(choices ...string) string { return choices[r.intn(len(choices))] }
+
+func randomHistory(r *changelogRand) []string {
+	epoch, major, minor, pre, rev, nmu := "", r.intn(3), 1+r.intn(5), 0, 1, false
+	format := func() string {
+		version := epoch + strconv.Itoa(major) + "." + strconv.Itoa(minor)
+		if pre > 0 {
+			version += "~rc" + strconv.Itoa(pre)
+		}
+		version += "-" + strconv.Itoa(rev)
+		if nmu {
+			version += ".1"
+		}
+		return version
+	}
+	history := []string{format()}
+	for n := 3 + r.intn(5); len(history) < n; {
+		switch {
+		case pre > 0 && r.chance(40):
+			pre++
+		case pre > 0:
+			pre = 0
+		case !nmu && r.chance(15):
+			nmu = true
+		case epoch == "" && r.chance(5):
+			epoch, major, minor, rev, nmu = "1:", 0, 1+r.intn(3), 1, false
+		case r.chance(35):
+			rev, nmu = rev+1, false
+		case r.chance(20):
+			major, minor, rev, nmu = major+1, 0, 1, false
+		default:
+			minor, rev, nmu = minor+1, 1, false
+			if r.chance(30) {
+				pre = 1
+			}
+		}
+		history = append(history, format())
+	}
+	return history
+}
