+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+mode=""
+modes_given=0
+output_path=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      mode="$1"
+      modes_given=$((modes_given + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      if [ $# -lt 1 ] || [ -z "$1" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      output_path="$1"
+      shift
+      ;;
+    --output_path=*)
+      output_path="${1#--output_path=}"
+      if [ -z "$output_path" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$modes_given" -eq 1 ] || usage
+case "$output_path" in
+  ""|/*) ;;
+  *) output_path="$PWD/$output_path" ;;
+esac
+
+cd "$(dirname "$0")" || exit 2
+
+# The script may run as another uid, offline, with HOME, PATH, CARGO_HOME,
+# RUSTUP_HOME, GOPATH or other build settings unset or pointing where this uid
+# cannot build, and in a checkout it cannot write. git and cargo read their
+# configuration from HOME, so the run gets a private HOME; it prefers the
+# image's tools, and falls back to the image's toolchains when the given ones
+# cannot build offline.
+export PATH="/opt/cargo/bin:/usr/local/bin:${PATH:-}:/usr/bin:/bin"
+export GOFLAGS=-buildvcs=false
+export GOTOOLCHAIN=local
+export GOPROXY=off
+export CARGO_NET_OFFLINE=true
+export RUSTC_BOOTSTRAP=1
+unset CARGO_BUILD_TARGET
+if [ -n "${TMPDIR:-}" ] && ! { [ -d "$TMPDIR" ] && [ -w "$TMPDIR" ]; }; then
+  export TMPDIR=/tmp
+fi
+work="$(mktemp -d)"
+trap 'rm -rf "$work"' EXIT
+mkdir -p "$work/home"
+export HOME="$work/home"
+unset XDG_CONFIG_HOME XDG_CACHE_HOME
+notes=""
+
+# The engines, their unit tests, the repo's test runner and base mode's
+# restored files are all written inside the checkout. When this uid cannot
+# write every part of it, the run works on a copy.
+if [ -n "$(find . -path ./.git/objects -prune -o ! -writable -print -quit 2>/dev/null)" ]; then
+  notes="uid $(id -u) cannot write all of the checkout; running on a copy"
+  cp -a . "$work/repo" 2>/dev/null || notes="$notes (some files could not be copied)"
+  chmod -R u+w "$work/repo" 2>/dev/null
+  cd "$work/repo" || exit 2
+fi
+export CARGO_TARGET_DIR="$PWD/target"
+
+# Leaves the image's Rust toolchain and registry, and no other Rust settings
+# but job and thread limits.
+use_image_rust() {
+  local var
+  for var in $(compgen -e); do
+    case "$var" in
+      CARGO_BUILD_JOBS|RUST_TEST_THREADS|RUST_MIN_STACK) ;;
+      CARGO_*|RUST*) unset "$var" ;;
+    esac
+  done
+  export CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup CARGO_NET_OFFLINE=true RUSTC_BOOTSTRAP=1
+  export CARGO_TARGET_DIR="$PWD/target"
+}
+if ! cargo fetch --offline >/dev/null 2>&1; then
+  notes="${notes}${notes:+; }cargo could not build offline with CARGO_HOME=${CARGO_HOME:-} RUSTUP_HOME=${RUSTUP_HOME:-}; using /opt/cargo and /opt/rustup"
+  use_image_rust
+fi
+gocache="$(go env GOCACHE 2>/dev/null)"
+case "$gocache" in
+  /*) ;;
+  *) gocache="" ;;
+esac
+if [ -z "$gocache" ] || ! mkdir -p "$gocache" 2>/dev/null || [ ! -w "$gocache" ] ||
+  [ -n "$(find "$gocache" -mindepth 1 -maxdepth 1 -type d ! -writable -print -quit 2>/dev/null)" ]; then
+  export GOCACHE="${TMPDIR:-/tmp}/go-build-$(id -u)"
+fi
+if ! go list -m all >/dev/null 2>&1; then
+  notes="${notes}${notes:+; }go could not list modules offline with GOPATH=${GOPATH:-}; using /opt/go"
+  export GOPATH=/opt/go
+  unset GOMODCACHE
+fi
+
+base_commit=55ea1e26f4da6d52a4ddca8f36a130dc26120525
+build_log="$work/build.log"
+go_log="$work/go.log"
+cargo_json="$work/cargo.json"
