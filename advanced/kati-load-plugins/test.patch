+type rewrite struct {
+	re   *regexp.Regexp
+	with string
+}
+
+var quoteRewrite = rewrite{regexp.MustCompile("([`'\"]|\xe2\x80\x98|\xe2\x80\x99)"), `"`}
+
+var makeRewrites = []rewrite{
+	quoteRewrite,
+	{regexp.MustCompile(`make(?:\[\d+\])?: (Entering|Leaving) directory[^\n]*\n`), ""},
+	{regexp.MustCompile(`make(?:\[\d+\])?: `), ""},
+	{regexp.MustCompile(`\s+Stop\.`), ""},
+	{regexp.MustCompile(`\[\S+:\d+: `), "["},
+}
+
+var katiRewrites = []rewrite{
+	quoteRewrite,
+	{regexp.MustCompile(`\*kati\*[^\n]*`), ""},
+	{regexp.MustCompile(`c?kati: `), ""},
+}
+
+func normalize(out []byte, rewrites []rewrite) []byte {
+	for _, r := range rewrites {
+		out = r.re.ReplaceAll(out, []byte(r.with))
+	}
+	return out
+}
+
+var objectDir string
+var objectErr error
+
+func buildObjects() error {
+	dir, err := os.MkdirTemp("", "loadobjects")
+	if err != nil {
+		return err
+	}
+	for name, src := range pluginSources {
+		c := filepath.Join(dir, name+".c")
+		if err := os.WriteFile(c, []byte(src), 0644); err != nil {
+			return err
+		}
+		out, err := exec.Command("cc", "-shared", "-fPIC", "-o", filepath.Join(dir, name+".so"), c).CombinedOutput()
+		if err != nil {
+			return fmt.Errorf("compiling %s: %v\n%s", name, err, out)
+		}
+	}
+	objectDir = dir
+	return nil
+}
+
+func TestMain(m *testing.M) {
+	os.Unsetenv("MAKEFLAGS")
+	os.Unsetenv("MAKELEVEL")
+	os.Unsetenv("LD_LIBRARY_PATH")
+	objectErr = buildObjects()
+	code := m.Run()
+	os.RemoveAll(objectDir)
+	os.Exit(code)
+}
+
+func copyFile(t *testing.T, from, to string) {
+	data, err := os.ReadFile(from)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Dir(to), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(to, data, 0755); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func setUp(t *testing.T, sc scenario) string {
+	dir := t.TempDir()
+	for path, content := range sc.files {
+		full := filepath.Join(dir, path)
+		if err := os.MkdirAll(filepath.Dir(full), 0755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(full, []byte(content), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for path, plugin := range sc.objects {
+		copyFile(t, filepath.Join(objectDir, plugin+".so"), filepath.Join(dir, path))
+	}
+	return dir
+}
+
+var generatedByKati = regexp.MustCompile(`^(\..*|kati.*)$`)
+
+func outputFiles(t *testing.T, dir string) string {
+	var files []string
+	err := filepath.Walk(dir, func(path string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		if !info.Mode().IsRegular() {
+			return nil
+		}
+		rel, err := filepath.Rel(dir, path)
+		if err != nil {
+			return err
+		}
+		if !strings.Contains(rel, "/") && generatedByKati.MatchString(rel) {
+			return nil
+		}
+		files = append(files, rel)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sort.Strings(files)
+	return strings.Join(files, "\n")
+}
+
+type result struct {
+	output string
+	ok     bool
+	files  string
+}
+
+func execute(dir string, env []string, name string, args ...string) ([]byte, bool) {
+	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, name, args...)
+	cmd.Dir = dir
+	cmd.Env = append(os.Environ(), env...)
+	out, err := cmd.CombinedOutput()
+	if ctx.Err() != nil {
+		out = append(out, []byte("\n(timed out)")...)
+	}
+	return out, err == nil
+}
+
+func runMake(t *testing.T, sc scenario) result {
+	dir := setUp(t, sc)
+	out, ok := execute(dir, sc.env, "make", sc.args...)
+	return result{string(normalize(out, makeRewrites)), ok, outputFiles(t, dir)}
+}
+
+func runKati(t *testing.T, sc scenario, kati string) result {
+	dir := setUp(t, sc)
+	args := append([]string{"--use_find_emulator"}, sc.args...)
+	out, ok := execute(dir, sc.env, kati, args...)
+	return result{string(normalize(out, katiRewrites)), ok, outputFiles(t, dir)}
+}
+
+func TestLoadedObjects(t *testing.T) {
+	version, err := exec.Command("make", "--version").Output()
+	if err != nil || !bytes.HasPrefix(version, []byte("GNU Make 4.2.1\n")) {
+		t.Fatalf("GNU make 4.2.1 must be installed as make: %q %v", version, err)
+	}
+	root, err := filepath.Abs("..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	engines := []struct{ name, path string }{
+		{"ckati", filepath.Join(root, "ckati")},
+		{"rkati", filepath.Join(root, "target", "debug", "rkati")},
+	}
+	for _, sc := range scenarios {
+		sc := sc
+		t.Run(sc.name, func(t *testing.T) {
+			t.Parallel()
+			var want result
+			if objectErr == nil {
+				want = runMake(t, sc)
+			}
+			for _, e := range engines {
+				t.Run(e.name, func(t *testing.T) {
+					if objectErr != nil {
+						t.Fatal(objectErr)
+					}
+					if _, err := os.Stat(e.path); err != nil {
+						t.Fatalf("%s is not built: %v", e.name, err)
+					}
+					got := runKati(t, sc, e.path)
+					if got.output != want.output {
+						t.Errorf("output differs from make\nmake:\n%s\n%s:\n%s", want.output, e.name, got.output)
+					}
+					if got.ok != want.ok {
+						t.Errorf("make succeeded: %v, %s succeeded: %v", want.ok, e.name, got.ok)
+					}
+					if want.ok && got.files != want.files {
+						t.Errorf("files differ from make\nmake:\n%s\n%s:\n%s", want.files, e.name, got.files)
+					}
+				})
+			}
+		})
+	}
+}
