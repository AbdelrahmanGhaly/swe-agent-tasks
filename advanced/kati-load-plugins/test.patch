+  fi
+  [ -n "$cases" ] || cases="$(ls testcase)"
+  sed -i 's/t\.Errorf("Expected failure, but output is the same")/t.Logf("Expected failure, but output is the same")/' run_test.go
+  pattern="$(printf '%s\n' "$cases" | grep -E '\.(mk|sh)$' | sed 's/\./\\./g' | paste -sd '|' -)"
+  build_engines ckati_tests
+  go_test TestKati -run "^TestKati\$/^($pattern)\$" .
+  go_test TestKati_ninja -run "^TestKati\$/^($pattern)\$" . --ninja
+  go_test TestKati_rkati -run "^TestKati\$/^($pattern)\$" . --rkati
+  go_test TestKati_rkati_ninja -run "^TestKati\$/^($pattern)\$" . --rkati --ninja
+
+  unit_status=0
+  for t in find_test ninja_test strutil_test; do
+    echo "=== RUN   TestCkatiUnit/$t"
+    if [ -x "./$t" ] && "./$t" >"$work/unit.log" 2>&1; then
+      echo "--- PASS: TestCkatiUnit/$t (0.00s)"
+    else
+      [ -x "./$t" ] || echo "$t was not built" >"$work/unit.log"
+      sed 's/^/    /' "$work/unit.log"
+      echo "--- FAIL: TestCkatiUnit/$t (0.00s)"
+      unit_status=1
+    fi
+  done >>"$go_log"
+  if [ "$unit_status" -eq 0 ]; then
+    printf 'ok  \tgithub.com/google/kati/ckati_unit\t0.000s\n' >>"$go_log"
+  else
+    printf 'FAIL\tgithub.com/google/kati/ckati_unit\t0.000s\n' >>"$go_log"
+    go_status=1
+    status=1
+  fi
+
+  cargo test --offline -- -Z unstable-options --format json --report-time >"$cargo_json" 2>"$work/cargo.err"
+  cargo_status=$?
+  cat "$work/cargo.err" >>"$build_log"
+  [ "$cargo_status" -eq 0 ] || status=1
+else
+  build_engines
+  go_test TestLoadedObjects ./loadobjects_085bf1/
+fi
+
+[ "$build_status" -eq 0 ] || status=1
+if ! grep -qE '^ *--- (PASS|FAIL|SKIP):' "$go_log"; then
+  echo "no test results were produced in $mode mode" >>"$go_log"
+  status=1
+fi
+
+cat "$build_log" "$go_log"
+
+if [ -n "$output_path" ]; then
+  mkdir -p "$(dirname "$output_path")"
+  : >"$work/convert.err"
+  go-junit-report <"$go_log" >"$work/go.xml" 2>>"$work/convert.err"
+  go_convert=$?
+  cargo_convert=0
+  if [ -s "$cargo_json" ]; then
+    grep '^{' "$cargo_json" | cargo2junit >"$work/cargo.xml" 2>>"$work/convert.err"
+    cargo_convert=$?
+  fi
+  if ! python3 - "$output_path" "$work" "$build_status" "$go_status" "$go_convert" \
+      "$cargo_status" "$cargo_convert" <<'PY'
+import os
+import re
+import sys
+import xml.etree.ElementTree as ET
+
+out, work = sys.argv[1], sys.argv[2]
+build_status, go_status, go_convert, cargo_status, cargo_convert = (int(a) for a in sys.argv[3:8])
+bad_chars = re.compile("\x1b\\[[0-9;]*[A-Za-z]|[\x00-\x08\x0b\x0c\x0e-\x1f]")
+
+
+def read(name, lines=150):
+    try:
+        with open(os.path.join(work, name), errors="replace") as f:
+            return bad_chars.sub("", "".join(f.readlines()[-lines:]))
+    except OSError:
+        return ""
+
+
+def suites(name):
+    try:
+        top = ET.parse(os.path.join(work, name)).getroot()
+    except (OSError, ET.ParseError):
+        return []
+    return [top] if top.tag == "testsuite" else list(top.iter("testsuite"))
+
+
+def failing_case(suite_name, case_name, message, text):
+    suite = ET.Element("testsuite", name=suite_name)
+    case = ET.SubElement(suite, "testcase", classname=suite_name, name=case_name)
+    ET.SubElement(case, "failure", message=message).text = text
+    return suite
+
+
+def has_failure(found):
+    return any(c.find("failure") is not None or c.find("error") is not None
+               for s in found for c in s.iter("testcase"))
+
+
+root = ET.Element("testsuites")
+if build_status:
+    root.append(failing_case("kati_build", "build", "ckati or rkati did not build", read("build.log")))
+
+go_suites = suites("go.xml")
+if go_convert:
+    root.append(failing_case("go_test", "junit_conversion", "go-junit-report failed",
+                             read("convert.err") + read("go.log")))
+if not any(True for s in go_suites for _ in s.iter("testcase")):
+    root.append(failing_case("go_test", "results", "no go test results could be read",
+                             read("convert.err") + read("go.log")))
+else:
+    if go_status and not has_failure(go_suites):
+        root.append(failing_case("go_test", "exit_status", "go test failed without a failing test",
+                                 read("go.log")))
+    root.extend(go_suites)
+
+if os.path.getsize(os.path.join(work, "cargo.json")) or cargo_status:
+    if cargo_convert:
+        root.append(failing_case("rkati_unit", "junit_conversion", "cargo2junit failed",
+                                 read("convert.err") + read("cargo.json")))
+    cargo_suites = suites("cargo.xml")
+    if not any(True for s in cargo_suites for _ in s.iter("testcase")):
+        root.append(failing_case("rkati_unit", "results", "no cargo test results could be read",
+                                 read("convert.err") + read("cargo.err") + read("cargo.json")))
+    else:
+        if cargo_status and not has_failure(cargo_suites):
+            root.append(failing_case("rkati_unit", "exit_status",
+                                     "cargo test failed without a failing test", read("cargo.err")))
+        root.extend(cargo_suites)
+
+for element in root.iter():
+    for key, value in list(element.attrib.items()):
+        element.set(key, bad_chars.sub("", value))
+    if element.text:
+        element.text = bad_chars.sub("", element.text)
+for suite in root.iter("testsuite"):
+    cases = suite.findall("testcase")
+    suite.set("tests", str(len(cases)))
+    suite.set("failures", str(sum(c.find("failure") is not None for c in cases)))
+    suite.set("errors", str(sum(c.find("error") is not None for c in cases)))
+ET.ElementTree(root).write(out, encoding="UTF-8", xml_declaration=True)
+PY
+  then
+    echo "could not write $output_path" >&2
+    status=1
+  fi
+  if [ "$go_convert" -ne 0 ] || [ "$cargo_convert" -ne 0 ]; then
+    echo "a JUnit converter failed" >&2
+    status=1
+  fi
+fi
+
+exit "$status"
