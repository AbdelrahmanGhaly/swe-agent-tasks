+const pluginHeader = `#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <gnumake.h>
+
+static char *copy_out(const char *s) {
+  char *r = gmk_alloc(strlen(s) + 1);
+  strcpy(r, s);
+  return r;
+}
+`
+
+var pluginSources = map[string]string{
+	"textfns": pluginHeader + `
+int plugin_is_GPL_compatible;
+
+static char *show_args(const char *nm, unsigned int argc, char **argv) {
+  size_t len = 16;
+  for (unsigned int i = 0; i < argc; i++)
+    len += strlen(argv[i]) + 2;
+  char *r = gmk_alloc(len);
+  sprintf(r, "%u", argc);
+  for (unsigned int i = 0; i < argc; i++) {
+    strcat(r, "[");
+    strcat(r, argv[i]);
+    strcat(r, "]");
+  }
+  return r;
+}
+
+static char *upper(const char *nm, unsigned int argc, char **argv) {
+  char *r = copy_out(argv[0]);
+  for (char *p = r; *p; p++)
+    if (*p >= 'a' && *p <= 'z')
+      *p -= 'a' - 'A';
+  return r;
+}
+
+static char *nothing(const char *nm, unsigned int argc, char **argv) {
+  return NULL;
+}
+
+static char *dollar_text(const char *nm, unsigned int argc, char **argv) {
+  return copy_out("$(ZZ)");
+}
+
+int textfns_gmk_setup(const gmk_floc *floc) {
+  gmk_add_function("show", show_args, 0, 0, GMK_FUNC_DEFAULT);
+  gmk_add_function("show2", show_args, 0, 2, GMK_FUNC_DEFAULT);
+  gmk_add_function("show-raw", show_args, 0, 3, GMK_FUNC_NOEXPAND);
+  gmk_add_function("pair", show_args, 2, 2, GMK_FUNC_DEFAULT);
+  gmk_add_function("upper", upper, 1, 1, GMK_FUNC_DEFAULT);
+  gmk_add_function("nothing", nothing, 0, 0, GMK_FUNC_DEFAULT);
+  gmk_add_function("dollar.text", dollar_text, 0, 0, GMK_FUNC_DEFAULT);
+  return 1;
+}
+`,
+	"callback": pluginHeader + `
+int plugin_is_GPL_compatible;
+
+static char *expand(const char *nm, unsigned int argc, char **argv) {
+  char *e = gmk_expand(argv[0]);
+  char *r = copy_out(e);
+  gmk_free(e);
+  return r;
+}
+
+static char *loud_expand(const char *nm, unsigned int argc, char **argv) {
+  printf("expanding %s\n", argv[0]);
+  char *e = gmk_expand(argv[0]);
+  printf("expanded to %s\n", e);
+  gmk_free(e);
+  return NULL;
+}
+
+static char *run(const char *nm, unsigned int argc, char **argv) {
+  gmk_eval(argv[0], NULL);
+  return NULL;
+}
+
+static char *run_at(const char *nm, unsigned int argc, char **argv) {
+  gmk_floc floc = {argv[1], strtoul(argv[2], NULL, 10)};
+  gmk_eval(argv[0], &floc);
+  return NULL;
+}
+
+static char *run_expanded_at(const char *nm, unsigned int argc, char **argv) {
+  gmk_floc floc = {argv[1], strtoul(argv[2], NULL, 10)};
+  char *text = gmk_expand(argv[0]);
+  gmk_eval(text, &floc);
+  gmk_free(text);
+  return NULL;
+}
+
+int callback_gmk_setup(const gmk_floc *floc) {
+  gmk_add_function("expand", expand, 1, 1, GMK_FUNC_NOEXPAND);
+  gmk_add_function("loud-expand", loud_expand, 1, 1, GMK_FUNC_NOEXPAND);
+  gmk_add_function("run", run, 1, 1, GMK_FUNC_NOEXPAND);
+  gmk_add_function("run-at", run_at, 3, 3, GMK_FUNC_NOEXPAND);
+  gmk_add_function("run-expanded-at", run_expanded_at, 3, 3, GMK_FUNC_NOEXPAND);
+  return 1;
+}
+`,
+	"talk": pluginHeader + `
+int plugin_is_GPL_compatible;
+
+static char *say(const char *nm, unsigned int argc, char **argv) {
+  printf("say: %s\n", argv[0]);
+  return NULL;
+}
+
+int talk_gmk_setup(const gmk_floc *floc) {
+  printf("talk loaded at %s:%lu\n", floc->filenm, floc->lineno);
+  gmk_add_function("say", say, 1, 1, GMK_FUNC_DEFAULT);
+  return 1;
+}
+`,
+	"partial": pluginHeader + `
+int plugin_is_GPL_compatible;
+
+static char *part(const char *nm, unsigned int argc, char **argv) {
+  printf("<%s>", argv[0]);
+  return NULL;
+}
+
+int partial_gmk_setup(const gmk_floc *floc) {
+  printf("partial loaded ");
+  gmk_add_function("part", part, 1, 1, GMK_FUNC_DEFAULT);
+  return 1;
+}
+`,
+	"named": pluginHeader + `
+int plugin_is_GPL_compatible;
+
+int named_init(const gmk_floc *floc) {
+  printf("named_init from %s:%lu\n", floc->filenm, floc->lineno);
+  return 1;
+}
+`,
+	"my-ext": pluginHeader + `
+int plugin_is_GPL_compatible;
+
+int my_gmk_setup(const gmk_floc *floc) {
+  printf("my_gmk_setup ran\n");
+  return 1;
+}
+`,
+	"nogpl": pluginHeader + `
+int nogpl_gmk_setup(const gmk_floc *floc) {
+  printf("nogpl setup ran\n");
+  return 1;
+}
+`,
+	"refuse": pluginHeader + `
+int plugin_is_GPL_compatible;
+
+static char *refused(const char *nm, unsigned int argc, char **argv) {
+  return copy_out("still callable");
+}
+
+int refuse_gmk_setup(const gmk_floc *floc) {
+  printf("refuse setup ran\n");
+  gmk_add_function("refused-fn", refused, 0, 0, GMK_FUNC_DEFAULT);
+  return 0;
+}
+`,
+	"negative": pluginHeader + `
+int plugin_is_GPL_compatible;
+
+static char *negative_fn(const char *nm, unsigned int argc, char **argv) {
+  return copy_out("from negative");
+}
+
+int negative_gmk_setup(const gmk_floc *floc) {
+  printf("negative setup ran at %s:%lu\n", floc->filenm, floc->lineno);
+  gmk_add_function("negative-fn", negative_fn, 0, 0, GMK_FUNC_DEFAULT);
+  return -1;
+}
+`,
+	"register": pluginHeader + `
+int plugin_is_GPL_compatible;
+
+static char *registered(const char *nm, unsigned int argc, char **argv) {
+  return copy_out(nm);
+}
+
+int register_gmk_setup(const gmk_floc *floc) {
+  printf("registering [%s]\n", getenv("FUNC_NAME"));
+  gmk_add_function(getenv("FUNC_NAME"), registered,
+                   strtoul(getenv("FUNC_MIN"), NULL, 10),
+                   strtoul(getenv("FUNC_MAX"), NULL, 10), GMK_FUNC_DEFAULT);
+  return 1;
+}
+`,
+	"config": pluginHeader + `
+int plugin_is_GPL_compatible;
+
+static char *config_name(const char *nm, unsigned int argc, char **argv) {
+  char *r = gmk_alloc(strlen(nm) + strlen(argv[0]) + 2);
+  sprintf(r, "%s:%s", nm, argv[0]);
+  return r;
+}
+
+int config_gmk_setup(const gmk_floc *floc) {
+  char *prefix = gmk_expand("$(CONFIG_PREFIX)");
+  static char name[256];
+  snprintf(name, sizeof(name), "%s-name", prefix);
+  gmk_free(prefix);
+  gmk_add_function(name, config_name, 1, 1, GMK_FUNC_DEFAULT);
+  gmk_eval("CONFIG_READY := yes", NULL);
+  gmk_eval("config-rule: ; @echo from config rule", NULL);
+  return 1;
+}
+`,
+}
