+// Whether the "eval" at |i| in |text| calls eval: right after $( or ${, or as
+// the function $(call) is given.
+static bool CallsEvalAt(std::string_view text, size_t i) {
+  if (i + 4 < text.size() &&
+      std::string_view(" \t,)}").find(text[i + 4]) == std::string_view::npos) {
+    return false;
+  }
+  auto opens = [&](size_t b) {
+    return b >= 2 && (text[b - 1] == '(' || text[b - 1] == '{') &&
+           text[b - 2] == '$';
+  };
+  if (opens(i))
+    return true;
+  size_t b = i;
+  while (b > 0 && (text[b - 1] == ' ' || text[b - 1] == '\t'))
+    b--;
+  return b < i && b >= 4 && text.substr(b - 4, 4) == "call" && opens(b - 4);
+}
+
+bool CallsEval(std::string_view text) {
+  for (size_t i = text.find("eval"); i != std::string_view::npos;
+       i = text.find("eval", i + 1)) {
+    if (CallsEvalAt(text, i))
+      return true;
+  }
+  return false;
+}
