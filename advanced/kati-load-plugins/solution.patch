+
+// Reports an error in the text being read. While the text is read again, and
+// when objects can be loaded once the expression it belongs to has a call read
+// as a variable reference or an expression read earlier left its error, the
+// error waits for the expression's expansion, as make reads text only when it
+// expands it.
+static void ParseError(const Loc& loc, const std::string& msg) {
+  if (g_expr_calls &&
+      (g_reading_again ||
+       (g_objects_can_load && (g_expr_calls->has_unread ||
+                               (g_text_errors && g_text_errors->left()))))) {
+    LeaveParseError(loc, msg);
+    return;
+  }
+  ERROR_LOC(loc, "%s", msg.c_str());
+}
