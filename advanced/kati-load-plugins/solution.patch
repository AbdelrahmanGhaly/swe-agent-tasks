+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use anyhow::Result;
+use bytes::{BufMut, Bytes, BytesMut};
+use parking_lot::Mutex;
+
+use crate::eval::Evaluator;
+use crate::expr::{Evaluable, ParseExprOpt, parse_expr};
+use crate::file_cache::add_extra_file_dep;
+use crate::fileutil::glob;
+use crate::loc::Loc;
+use crate::parser::parse_buf;
+use crate::symtab::{Symbol, intern};
+use crate::var::{VarOrigin, Variable};
+use crate::{error_loc, warn_loc};
+
+const NO_EXPAND: c_uint = 1;
+const MAX_FUNC_NAME_LEN: usize = 255;
+const MAX_ARG_COUNT: c_uint = 255;
+
+#[repr(C)]
+struct GmkFloc {
+    filenm: *const c_char,
+    lineno: c_ulong,
+}
+
+type GmkFunc = unsafe extern "C" fn(*const c_char, c_uint, *mut *mut c_char) -> *mut c_char;
+type SetupFunc = unsafe extern "C" fn(*const GmkFloc) -> c_int;
+
+#[derive(Clone, Copy)]
+pub struct LoadedFunc {
+    func: Option<GmkFunc>,
+    min_args: c_uint,
+    pub max_args: c_uint,
+    pub expand_args: bool,
+}
+
+static LOADED_FUNCS: LazyLock<Mutex<HashMap<Symbol, LoadedFunc>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+// How many times loaded objects have registered a function, counting a name
+// registered again. Makefiles that load nothing never take the lock.
+static REGISTRATIONS: AtomicUsize = AtomicUsize::new(0);
+
+// Names handed to setup functions, which may keep them.
+static FILENAMES: LazyLock<Mutex<HashMap<Symbol, CString>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+thread_local! {
+    // The evaluator a loaded object is calling back into, and where the text of
+    // the call to the function it runs was read, if it runs one.
+    static CALLBACK_EV: Cell<*mut Evaluator> = const { Cell::new(std::ptr::null_mut()) };
+    static CALLBACK_CALL_LOC: RefCell<Option<Loc>> = const { RefCell::new(None) };
+}
+
+pub fn find_loaded_func(name: Symbol) -> Option<LoadedFunc> {
+    if REGISTRATIONS.load(Ordering::Relaxed) == 0 {
+        return None;
+    }
+    LOADED_FUNCS.lock().get(&name).copied()
+}
+
+/// How many times loaded objects have registered a function, counting a name
+/// registered again.
+pub fn loaded_func_registrations() -> usize {
+    REGISTRATIONS.load(Ordering::Relaxed)
+}
+
+fn is_func_name_char(c: u8) -> bool {
+    c.is_ascii_alphanumeric() || c == b'.' || c == b'-' || c == b'_'
+}
+
+/// Whether a loaded object could register a function with this name.
+pub fn is_loadable_func_name(name: &[u8]) -> bool {
+    !name.is_empty()
+        && name[0] != b'.'
+        && name.len() <= MAX_FUNC_NAME_LEN
+        && name.iter().all(|&c| is_func_name_char(c))
+}
+
+unsafe extern "C" {
+    // C's standard output, which loaded objects print to.
+    #[cfg_attr(target_os = "macos", link_name = "__stdoutp")]
+    static mut stdout: *mut libc::FILE;
+}
+
+// Whether an object may have written to C's stdout.
+static C_STDOUT_USED: AtomicBool = AtomicBool::new(false);
+
+// Like make, which line-buffers its output, so that what an object prints
+// comes out a line at a time among rkati's own messages.
+fn line_buffer_c_stdout() {
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    ONCE.call_once(|| {
+        // Given a buffer of its own, glibc line-buffers a stream that was
+        // already written to.
+        let buffer: &'static mut [c_char] = Box::leak(vec![0; 8192].into_boxed_slice());
+        // SAFETY: stdout is C's open standard output, and the buffer lives as
+        // long as the process.
+        unsafe {
+            libc::fflush(stdout);
+            libc::setvbuf(stdout, buffer.as_mut_ptr(), libc::_IOLBF, buffer.len());
+        }
+        C_STDOUT_USED.store(true, Ordering::Relaxed);
+    });
+}
+
+/// Writes out a line an object has started on C's stdout, which make's single
+/// stream would show before whatever rkati prints next.
+pub fn flush_c_stdout() {
+    if !C_STDOUT_USED.load(Ordering::Relaxed) {
+        return;
+    }
+    // SAFETY: fflush(NULL) flushes every C output stream and takes no pointer
+    // from us.
+    unsafe {
+        libc::fflush(std::ptr::null_mut());
+    }
+}
+
+// Runs a call into a loaded object, which may call back into |ev|, for the
+// call read at |call_loc| if it runs a function.
+fn with_callback<R>(ev: &mut Evaluator, call_loc: Option<&Loc>, f: impl FnOnce() -> R) -> R {
+    // What rkati has printed comes first, as in make's single stream.
+    let _ = std::io::stdout().flush();
+    let saved_loc = ev.loc.clone();
+    let ptr: *mut Evaluator = ev;
+    let saved = CALLBACK_EV.with(|c| c.replace(ptr));
+    let saved_call_loc = CALLBACK_CALL_LOC.replace(call_loc.cloned());
+    let r = f();
+    CALLBACK_CALL_LOC.set(saved_call_loc);
+    CALLBACK_EV.with(|c| c.set(saved));
+    ev.loc = saved_loc;
+    r
+}
+
+// Like make, an error inside a call back stops at once: the object never sees
+// the call return.
+fn fatal(err: anyhow::Error) -> ! {
+    let _ = std::io::stdout().flush();
+    for cause in err.chain() {
+        eprintln!("{cause}");
+    }
+    std::process::exit(1)
+}
+
+fn enter_callback<T>(f: impl FnOnce(&mut Evaluator) -> Result<T>) -> Option<T> {
+    let ptr = CALLBACK_EV.with(|c| c.get());
+    if ptr.is_null() {
+        return None;
+    }
+    // SAFETY: the pointer was set by with_callback from a live &mut
+    // Evaluator that is not used until the loaded object returns.
+    let ev = unsafe { &mut *ptr };
+    match f(ev) {
+        Ok(v) => Some(v),
+        Err(err) => fatal(err),
+    }
+}
+
+fn c_string(s: &[u8]) -> CString {
+    let end = s.iter().position(|&c| c == 0).unwrap_or(s.len());
+    CString::new(&s[..end]).unwrap_or_default()
+}
+
+// Like make, which exits when it runs out of memory.
+fn allocate(len: usize) -> *mut c_char {
+    // SAFETY: malloc has no preconditions.
+    let p = unsafe { libc::malloc(len) } as *mut c_char;
+    if p.is_null() {
+        fatal(anyhow::anyhow!("*** virtual memory exhausted."));
+    }
+    p
+}
+
+fn malloc_string(s: &[u8]) -> *mut c_char {
+    let end = s.iter().position(|&c| c == 0).unwrap_or(s.len());
+    let p = allocate(end + 1).cast::<u8>();
+    // SAFETY: the buffer was allocated with room for the bytes and the NUL
+    // that are written into it.
+    unsafe {
+        std::ptr::copy_nonoverlapping(s.as_ptr(), p, end);
+        *p.add(end) = 0;
+    }
+    p.cast::<c_char>()
+}
+
+fn dlerror_string() -> String {
+    // SAFETY: dlerror returns NULL or a NUL-terminated message.
+    unsafe {
+        let err = libc::dlerror();
+        if err.is_null() {
+            String::new()
+        } else {
+            CStr::from_ptr(err).to_string_lossy().into_owned()
+        }
+    }
+}
+
+fn dlsym(handle: *mut c_void, symbol: &CStr) -> *mut c_void {
+    // SAFETY: handle came from dlopen or is RTLD_DEFAULT, and symbol is
+    // NUL-terminated.
+    unsafe { libc::dlsym(handle, symbol.as_ptr()) }
+}
+
+// Opens the object the way make does: a name without a slash is looked up
+// in the current directory first, then where the dynamic loader searches.
+fn open_object(file: &[u8]) -> *mut c_void {
+    let mut handle = std::ptr::null_mut();
+    if !file.contains(&b'/') {
+        let mut local = b"./".to_vec();
+        local.extend_from_slice(file);
+        let local = c_string(&local);
+        // SAFETY: local is NUL-terminated.
+        handle = unsafe { libc::dlopen(local.as_ptr(), libc::RTLD_LAZY | libc::RTLD_GLOBAL) };
+    }
+    if handle.is_null() {
+        let file = c_string(file);
+        // SAFETY: file is NUL-terminated.
+        handle = unsafe { libc::dlopen(file.as_ptr(), libc::RTLD_LAZY | libc::RTLD_GLOBAL) };
+    }
+    handle
+}
+
+fn setup_symbol(file: &[u8]) -> Vec<u8> {
+    let base = match file.iter().rposition(|&c| c == b'/') {
+        Some(i) => &file[i + 1..],
+        None => file,
+    };
+    let mut symbol: Vec<u8> = base
+        .iter()
+        .take_while(|c| c.is_ascii_alphanumeric() || **c == b'_')
+        .copied()
+        .collect();
+    symbol.extend_from_slice(b"_gmk_setup");
+    symbol
+}
+
+fn loaded_sym() -> Symbol {
+    intern(".LOADED")
+}
+
+// Like make, only the first place the name appears in .LOADED is checked.
+fn is_already_loaded(loaded: &[u8], file: &[u8]) -> bool {
+    let Some(found) = memchr::memmem::find(loaded, file) else {
+        return false;
+    };
+    let end = found + file.len();
+    (found == 0 || loaded[found - 1] == b' ') && (end == loaded.len() || loaded[end] == b' ')
+}
+
+// The value a load last gave .LOADED.
+static LAST_LOADED: Mutex<Vec<u8>> = Mutex::new(Vec::new());
+
+// Like make, which defines .LOADED with a default origin, a value the
+// makefile, the environment or the command line gave it is kept: one with
+// another origin, or one changed since a load set it, as rkati's += keeps the
+// origin a variable had. The name is added to the value .LOADED had before
+// the object was set up.
+fn add_loaded(loc: &Option<Loc>, loaded: &[u8], file: &[u8]) -> Result<()> {
+    let mut last_set = LAST_LOADED.lock();
+    if let Some(var) = loaded_sym().get_global_var() {
+        let var = var.read();
+        if var.origin() != VarOrigin::Default || var.string()?[..] != last_set[..] {
+            return Ok(());
+        }
+    }
+    let mut value = BytesMut::from(loaded);
+    if !value.is_empty() {
+        value.put_u8(b' ');
+    }
+    value.put_slice(file);
+    *last_set = value.to_vec();
+    loaded_sym().set_global_var(
+        Variable::with_simple_string(value.freeze(), VarOrigin::Default, None, loc.clone()),
+        false,
+        None,
+    )
+}
+
+fn floc_filename(name: Symbol) -> *const c_char {
+    FILENAMES
+        .lock()
+        .entry(name)
+        .or_insert_with(|| c_string(&name.as_bytes()))
+        .as_ptr()
+}
+
+// The home directory the password entry of |user| gives, if there is one.
+fn password_home(user: &CStr) -> Vec<u8> {
+    // SAFETY: user is a NUL-terminated name.
+    let pw = unsafe { libc::getpwnam(user.as_ptr()) };
+    if pw.is_null() {
+        return Vec::new();
+    }
+    // SAFETY: an entry getpwnam returned holds a NUL-terminated directory.
+    unsafe { CStr::from_ptr((*pw).pw_dir) }.to_bytes().to_vec()
+}
+
+// Like make, a leading "~" or "~user" names a home directory. For "~" that is
+// the value of HOME, or when it is empty, the one the environment or the
+// login's password entry gives.
+fn tilde_expand(ev: &mut Evaluator, name: &Bytes) -> Result<Bytes> {
+    let slash = name.iter().position(|&c| c == b'/').unwrap_or(name.len());
+    let user = &name[1..slash];
+    let mut home = if user.is_empty() {
+        let mut home = ev.eval_var(intern("HOME"))?.to_vec();
+        if home.is_empty() {
+            home = std::env::var_os("HOME").map_or_else(Vec::new, |h| h.as_bytes().to_vec());
+        }
+        if home.is_empty() {
+            // SAFETY: getlogin has no preconditions.
+            let login = unsafe { libc::getlogin() };
+            if !login.is_null() {
+                // SAFETY: getlogin gave a NUL-terminated name.
+                home = password_home(unsafe { CStr::from_ptr(login) });
+            }
+        }
+        home
+    } else {
+        password_home(&c_string(user))
+    };
+    if home.is_empty() {
+        return Ok(name.clone());
+    }
+    home.extend_from_slice(&name[slash..]);
+    Ok(Bytes::from(home))
+}
+
+// The names a word of a load line stands for. As make does, "./" and the
+// slashes after it are dropped, a name left empty becomes "./", and then a
+// leading "~" is expanded. A pattern is replaced by the files it matches, or
+// kept when it matches none, the way kati globs include names.
+fn load_names(ev: &mut Evaluator, word: &Bytes) -> Result<Vec<Bytes>> {
+    let mut name = word.clone();
+    while name.len() > 2 && name.starts_with(b"./") {
+        name = name.slice(2..);
+        while name.first() == Some(&b'/') {
+            name = name.slice(1..);
+        }
+    }
+    if name.is_empty() {
+        name = Bytes::from_static(b"./");
+    }
+    if name.first() == Some(&b'~') {
+        name = tilde_expand(ev, &name)?;
+    }
+    Ok(match &*glob(name.clone()) {
+        Ok(files) if !files.is_empty() => files.clone(),
+        _ => vec![name],
+    })
+}
+
+fn load_one(ev: &mut Evaluator, spec: &Bytes, noerror: bool) -> Result<()> {
+    let loc = ev.loc.clone();
+    let mut file = spec.clone();
+    let mut symbol = None;
+    if let Some(open) = spec.iter().position(|&c| c == b'(')
+        && let Some(close) = spec[open + 1..].iter().position(|&c| c == b')')
+        && open + 1 + close == spec.len() - 1
+    {
+        if close == 0 {
+            error_loc!(
+                loc.as_ref(),
+                "*** Empty symbol name for load: {}.",
+                String::from_utf8_lossy(spec)
+            );
+        }
+        file = spec.slice(..open);
+        symbol = Some(spec[open + 1..spec.len() - 1].to_vec());
+    }
+
+    // Like make, .LOADED is read once, before the object is set up.
+    let loaded = ev.eval_var(loaded_sym())?;
+    if is_already_loaded(&loaded, &file) {
+        return Ok(());
+    }
+    let symbol = c_string(&symbol.unwrap_or_else(|| setup_symbol(&file)));
+    let file_name = String::from_utf8_lossy(&file).into_owned();
+    let floc = loc.clone().unwrap_or_default();
+    let floc = GmkFloc {
+        filenm: if floc.has_file() {
+            floc_filename(floc.filename)
+        } else {
+            std::ptr::null()
+        },
+        lineno: (floc.line - ev.loc_offset) as c_ulong,
+    };
+
+    line_buffer_c_stdout();
+    let r = with_callback(ev, None, || -> Result<Option<c_int>> {
+        // Like GNU make 4.2.1, the setup function is looked up in rkati and the
+        // objects already loaded first, and the file is opened only when none
+        // defines it.
+        let mut setup = dlsym(libc::RTLD_DEFAULT, &symbol);
+        if setup.is_null() {
+            let handle = open_object(&file);
+            if handle.is_null() {
+                if noerror {
+                    return Ok(None);
+                }
+                warn_loc!(loc.as_ref(), "{}", dlerror_string());
+                error_loc!(loc.as_ref(), "*** {file_name}: failed to load.");
+            }
+            if dlsym(handle, c"plugin_is_GPL_compatible").is_null() {
+                error_loc!(
+                    loc.as_ref(),
+                    "*** Loaded object {file_name} is not declared to be GPL compatible."
+                );
+            }
+            setup = dlsym(handle, &symbol);
+            if setup.is_null() {
+                error_loc!(
+                    loc.as_ref(),
+                    "*** Failed to load symbol {} from {file_name}: {}.",
+                    symbol.to_string_lossy(),
+                    dlerror_string()
+                );
+            }
+        }
+        // Like the makefiles rkati reads, the object is checked by --regen.
+        // SAFETY: an all-zero Dl_info is valid, and dladdr only fills it in.
+        let mut info: libc::Dl_info = unsafe { std::mem::zeroed() };
+        // SAFETY: setup is the address of a symbol, and info outlives the
+        // call.
+        if unsafe { libc::dladdr(setup, &mut info) } != 0 && !info.dli_fname.is_null() {
+            // SAFETY: dladdr gave a NUL-terminated file name.
+            let fname = unsafe { CStr::from_ptr(info.dli_fname) };
+            add_extra_file_dep(OsStr::from_bytes(fname.to_bytes()).to_os_string());
+        }
+        // SAFETY: make calls the setup symbol as a function taking a
+        // location, so a loaded object defines it that way.
+        let setup: SetupFunc = unsafe { std::mem::transmute(setup) };
+        // SAFETY: floc points at a live location whose name is NUL-terminated
+        // or null.
+        Ok(Some(unsafe { setup(&floc) }))
+    })?;
+
+    // Like make 4.2.1, which records only a positive result in .LOADED. A
+    // negative one succeeds too, so loading the object again sets it up again.
+    match r {
+        Some(r) if r > 0 => add_loaded(&loc, &loaded, &file)?,
+        Some(0) if !noerror => {
+            error_loc!(loc.as_ref(), "*** {file_name}: failed to load.");
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+pub fn load_object(ev: &mut Evaluator, word: &Bytes, noerror: bool) -> Result<()> {
+    for name in load_names(ev, word)? {
+        load_one(ev, &name, noerror)?;
+    }
+    Ok(())
+}
+
+pub fn call_loaded_func(
+    ev: &mut Evaluator,
+    loc: &Loc,
+    name: Symbol,
+    func: LoadedFunc,
+    args: Vec<Bytes>,
+    out: &mut dyn BufMut,
+) -> Result<()> {
+    if args.len() < func.min_args as usize {
+        error_loc!(
+            Some(loc),
+            "*** insufficient number of arguments ({}) to function '{name}'.",
+            args.len()
+        );
+    }
+    let Some(fptr) = func.func else {
+        error_loc!(
+            Some(loc),
+            "*** unimplemented on this platform: function '{name}'."
+        );
+    };
+    let name = c_string(&name.as_bytes());
+    let mut argv: Vec<*mut c_char> = args.iter().map(|a| malloc_string(a)).collect();
+    argv.push(std::ptr::null_mut());
+    let argc = args.len() as c_uint;
+
+    // SAFETY: the function was registered for this name, and every argument
+    // is a NUL-terminated buffer it may write into.
+    let result = with_callback(ev, Some(loc), || unsafe {
+        fptr(name.as_ptr(), argc, argv.as_mut_ptr())
+    });
+
+    for p in argv {
+        // SAFETY: each argument was allocated with malloc above.
+        unsafe { libc::free(p as *mut c_void) };
+    }
+    if !result.is_null() {
+        // SAFETY: a loaded function returns NULL or a NUL-terminated string
+        // from gmk_alloc, which we now own.
+        unsafe {
+            out.put_slice(CStr::from_ptr(result).to_bytes());
+            libc::free(result as *mut c_void);
+        }
+    }
+    Ok(())
+}
+
+fn register_function(
+    loc: Option<Loc>,
+    name: &[u8],
+    func: Option<GmkFunc>,
+    min_args: c_uint,
+    max_args: c_uint,
+    flags: c_uint,
+) -> Result<()> {
+    let shown = String::from_utf8_lossy(name);
+    let len = name.iter().take_while(|&&c| is_func_name_char(c)).count();
+    if len == 0 {
+        error_loc!(loc.as_ref(), "*** Empty function name.");
+    }
+    if name[0] == b'.' || len != name.len() {
+        error_loc!(loc.as_ref(), "*** Invalid function name: {shown}.");
+    }
+    if len > MAX_FUNC_NAME_LEN {
+        error_loc!(loc.as_ref(), "*** Function name too long: {shown}.");
+    }
+    if min_args > MAX_ARG_COUNT {
+        error_loc!(
+            loc.as_ref(),
+            "*** Invalid minimum argument count ({min_args}) for function {shown}."
+        );
+    }
+    if max_args > MAX_ARG_COUNT || (max_args != 0 && max_args < min_args) {
+        error_loc!(
+            loc.as_ref(),
+            "*** Invalid maximum argument count ({max_args}) for function {shown}."
+        );
+    }
+    LOADED_FUNCS.lock().insert(
+        intern(name.to_vec()),
+        LoadedFunc {
+            func,
+            min_args,
+            max_args,
+            expand_args: flags & NO_EXPAND == 0,
+        },
+    );
+    REGISTRATIONS.fetch_add(1, Ordering::Relaxed);
+    Ok(())
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn gmk_free(s: *mut c_char) {
+    // SAFETY: the object frees a buffer kati allocated with malloc.
+    unsafe { libc::free(s as *mut c_void) };
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn gmk_alloc(len: c_uint) -> *mut c_char {
+    allocate((len as usize).max(1))
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn gmk_eval(buffer: *const c_char, floc: *const GmkFloc) {
+    // SAFETY: the object passes a NUL-terminated buffer and NULL or a valid
+    // location.
+    let (text, floc) = unsafe { (CStr::from_ptr(buffer).to_bytes(), floc.as_ref()) };
+    let text = Bytes::copy_from_slice(text);
+    // Like make, a location without a file name is shown without one.
+    let loc = floc.map(|f| {
+        if f.filenm.is_null() {
+            Loc::without_file(f.lineno as i32)
+        } else {
+            Loc {
+                // SAFETY: a location's name is NUL-terminated.
+                filename: intern(unsafe { CStr::from_ptr(f.filenm) }.to_bytes().to_vec()),
+                line: f.lineno as i32,
+            }
+        }
+    });
+    enter_callback(|ev| {
+        let caller_loc = ev.loc.clone();
+        let caller_offset = ev.loc_offset;
+        if loc.is_some() {
+            // Like make, a location given here has no recipe offset.
+            ev.loc_offset = 0;
+        }
+        let loc = loc.or_else(|| ev.loc.clone()).unwrap_or_default();
+        let stmts = parse_buf(&text, loc)?;
+        let stmts = stmts.lock();
+        for stmt in stmts.iter() {
+            stmt.eval(ev)?;
+        }
+        // Like make, later errors in the same call point at the caller again.
+        ev.loc = caller_loc;
+        ev.loc_offset = caller_offset;
+        Ok(())
+    });
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn gmk_expand(s: *const c_char) -> *mut c_char {
+    // SAFETY: the object passes a NUL-terminated string.
+    let text = Bytes::copy_from_slice(unsafe { CStr::from_ptr(s) }.to_bytes());
+    let result = enter_callback(|ev| {
+        // Like make, which reports what it meets reading the text at the
+        // variable being expanded or at the line being read, the text is read
+        // where the call was read.
+        let mut loc = CALLBACK_CALL_LOC
+            .with_borrow(|loc| loc.clone())
+            .or_else(|| ev.loc.clone())
+            .unwrap_or_default();
+        parse_expr(&mut loc, text, ParseExprOpt::Expand)?.eval_to_buf(ev)
+    });
+    malloc_string(&result.unwrap_or_default())
+}
+
+#[unsafe(no_mangle)]
+extern "C" fn gmk_add_function(
+    name: *const c_char,
+    func: Option<GmkFunc>,
+    min_args: c_uint,
+    max_args: c_uint,
+    flags: c_uint,
+) {
+    // SAFETY: the object passes a NUL-terminated name.
+    let name = unsafe { CStr::from_ptr(name) }.to_bytes().to_vec();
+    let loc = CALLBACK_EV.with(|c| c.get());
+    // SAFETY: the pointer is NULL or was set by with_callback from a live
+    // evaluator that is not used until the loaded object returns.
+    let loc = unsafe { loc.as_ref() }.and_then(|ev| ev.loc.clone());
+    if let Err(err) = register_function(loc, &name, func, min_args, max_args, flags) {
+        fatal(err);
+    }
+}
