+void GiveWaitingWarnings() {
+  if (!g_waiting_warnings)
+    return;
+  std::vector<const LazyCalls*> waiting;
+  waiting.swap(*g_waiting_warnings);
+  for (const LazyCalls* lazy : waiting)
+    lazy->GiveWarnings();
+}
+
+bool ResplitIfEqLater(const Loc& loc,
+                      std::string_view cond,
+                      Value** lhs,
+                      Value** rhs) {
+  if (!ObjectsCanLoad() || !(*lhs)->DependsOnLoadedFuncs())
+    return *rhs != nullptr;
+  const size_t comma = IfEqComma(cond);
+  // When neither kati nor make finds a comma, the condition fails when it is
+  // evaluated, so later errors in the text wait for it.
+  if (!*rhs && comma == std::string_view::npos && g_text_errors)
+    g_text_errors->set_left();
+  auto lazy = std::make_shared<LazyCondition>(loc, cond, comma, *lhs, *rhs);
+  *lhs = new ConditionSide(loc, lazy, 0);
+  *rhs = new ConditionSide(loc, lazy, 1);
+  return true;
+}
