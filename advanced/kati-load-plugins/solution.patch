+// A call to a function a loaded object registered.
+#[derive(Debug, PartialEq)]
+pub struct LoadedFuncCall {
+    loc: Loc,
+    name: Symbol,
+    expand_args: bool,
+    args: Vec<Arc<Value>>,
+    raw_args: Vec<Bytes>,
+}
+
+impl LoadedFuncCall {
+    fn eval(&self, ev: &mut Evaluator, out: &mut dyn BufMut) -> Result<()> {
+        // A function stays registered once it is.
+        let func = find_loaded_func(self.name).unwrap();
+        let _frame = ev.enter(FrameType::FunCall, self.name.as_bytes(), self.loc.clone());
+        ev.eval_depth += 1;
+        let argv = if self.expand_args {
+            let mut argv = Vec::with_capacity(self.args.len());
+            for arg in &self.args {
+                argv.push(arg.eval_to_buf(ev)?);
+            }
+            argv
+        } else {
+            self.raw_args.clone()
+        };
+        call_loaded_func(ev, &self.loc, self.name, func, argv, out)?;
+        ev.eval_depth -= 1;
+        Ok(())
+    }
+}
+
+// An expression with ${name ...} references that a loaded object may register
+// a function under, or with an error left for its expansion. Like make, which
+// reads text when it expands it, it is read again whenever a function has been
+// registered since it was read, and an error its reading left is raised where
+// its expansion reaches the part holding it. The --warn warnings waiting for
+// its expansion are given when it is first expanded, or when the condition it
+// was read for is split again.
+#[derive(Debug, PartialEq)]
+pub struct LazyCalls {
+    loc: Loc,
+    text: Bytes,
+    terms: Option<Vec<u8>>,
+    opt: ParseExprOpt,
+    trim_right_sp: bool,
+    end_paren: bool,
+    value: Arc<Value>,
+    names: Vec<Symbol>,
+    error: Option<(Loc, String)>,
+    registrations: usize,
+    reread: Reread,
+    warnings: PendingWarnings,
+}
+
+impl LazyCalls {
+    fn eval(&self, ev: &mut Evaluator, out: &mut dyn BufMut) -> Result<()> {
+        self.give_warnings();
+        if loaded_func_registrations() == self.registrations {
+            return self.value.eval(ev, out);
+        }
+        self.reread
+            .read(
+                &self.loc,
+                &self.text,
+                self.terms.as_deref(),
+                self.opt,
+                self.trim_right_sp,
+                self.end_paren,
+            )?
+            .eval(ev, out)
+    }
+
+    fn is_func(&self) -> bool {
+        self.value.is_func()
+            || self
+                .names
+                .iter()
+                .any(|name| find_loaded_func(*name).is_some())
+    }
+
+    // Gives the warnings waiting for its expansion, the first time it is
+    // called, leaving out those about calls whose names are functions by then.
+    fn give_warnings(&self) {
+        for w in std::mem::take(&mut *self.warnings.0.lock()) {
+            if w.name.is_none_or(|name| find_loaded_func(name).is_none()) {
+                kati_warn_loc!(Some(&w.loc), "{}", w.msg);
+            }
+        }
+    }
+}
+
+// Where make splits a parenthesized ifeq condition: at its first comma outside
+// parentheses, counting no other brackets.
+fn ifeq_comma(cond: &[u8]) -> Option<usize> {
+    let mut depth = 0;
+    for (i, &c) in cond.iter().enumerate() {
+        if c == b'(' {
+            depth += 1;
+        } else if c == b')' {
+            depth -= 1;
+        } else if c == b',' && depth <= 0 {
+            return Some(i);
+        }
+    }
+    None
+}
+
+// Both sides of a parenthesized ifeq whose first side depends on loaded
+// functions. A call there may hold the comma kati split at, so like make,
+// which splits the condition at that comma before expanding it, the condition
+// is split there and its sides are read again whenever a function has been
+// registered since kati read them.
+#[derive(Debug)]
+pub struct LazyCondition {
+    loc: Loc,
+    cond: Bytes,
+    comma: Option<usize>,
+    lhs: Arc<Value>,
+    // None when kati found no comma.
+    rhs: Option<Arc<Value>>,
+    registrations: usize,
+    split: Mutex<Option<Split>>,
+}
+
+// The latest split of a LazyCondition, with the number of registrations then.
+#[derive(Debug)]
+struct Split {
+    registrations: usize,
+    lhs: Arc<Value>,
+    rhs: Arc<Value>,
+}
+
+impl PartialEq for LazyCondition {
+    fn eq(&self, other: &Self) -> bool {
+        self.cond == other.cond && self.lhs == other.lhs && self.rhs == other.rhs
+    }
+}
+
+impl LazyCondition {
+    fn first_reading(&self, side: usize) -> Option<&Arc<Value>> {
+        if side == 0 {
+            Some(&self.lhs)
+        } else {
+            self.rhs.as_ref()
+        }
+    }
+
+    fn current(&self, side: usize) -> Result<Arc<Value>> {
+        let registrations = loaded_func_registrations();
+        if let Some(rhs) = &self.rhs
+            && registrations == self.registrations
+        {
+            return Ok(if side == 0 { &self.lhs } else { rhs }.clone());
+        }
+        // The sides as kati first read them are not expanded, so the warnings
+        // they keep for their expansion are given here. Reading the condition
+        // again gives none.
+        for reading in [Some(&self.lhs), self.rhs.as_ref()].into_iter().flatten() {
+            if let Value::LazyCalls(lazy) = &**reading {
+                lazy.give_warnings();
+            }
+        }
+        let Some(comma) = self.comma.filter(|_| registrations != self.registrations) else {
+            // Kati found no comma, and make finds none either or no function
+            // has been registered since kati read the condition, which then
+            // fails as it does in a makefile that loads nothing: with an error
+            // kati met reading the first side, if it met one.
+            if registrations == self.registrations
+                && let Value::LazyCalls(lazy) = &*self.lhs
+            {
+                raise_left_error(&lazy.error)?;
+            }
+            error_loc!(Some(&self.loc), "*** invalid syntax in conditional.");
+        };
+        let mut split = self.split.lock();
+        if !matches!(&*split, Some(split) if split.registrations == registrations) {
+            let (lhs, rhs) = read_again(|| -> Result<_> {
+                let mut loc = self.loc.clone();
+                let lhs = self.cond.slice_ref(trim_right_space(&self.cond[..comma]));
+                let (_, lhs) = parse_expr_impl(&mut loc, lhs, None, ParseExprOpt::Normal, false)?;
+                let rhs = self
+                    .cond
+                    .slice_ref(trim_left_space(&self.cond[comma + 1..]));
+                let (_, rhs) =
+                    parse_expr_impl_ext(&mut loc, rhs, None, ParseExprOpt::Normal, false, true)?;
+                Ok((lhs, rhs))
+            })?;
+            *split = Some(Split {
+                registrations,
+                lhs,
+                rhs,
+            });
+        }
+        let split = split.as_ref().unwrap();
+        Ok(if side == 0 {
+            split.lhs.clone()
+        } else {
+            split.rhs.clone()
+        })
+    }
+}
+
+/// |cond| is a parenthesized ifeq condition kati split into |lhs| and |rhs|,
+/// or into |lhs| alone, with |rhs| None, when it found no comma. If reading
+/// |lhs| depends on the functions loaded objects register, the sides become
+/// ones that split |cond| again the way make splits it. Returns whether the
+/// condition can be used.
+pub fn resplit_ifeq_later(
+    loc: &Loc,
+    cond: &Bytes,
+    lhs: &mut Arc<Value>,
+    rhs: &mut Option<Arc<Value>>,
+) -> bool {
+    if !objects_can_load() || !matches!(&**lhs, Value::LazyCalls(_)) {
+        return rhs.is_some();
+    }
+    let comma = ifeq_comma(cond);
+    // When neither kati nor make finds a comma, the condition fails when it is
+    // evaluated, so later errors in the text wait for it.
+    if rhs.is_none() && comma.is_none() {
+        TextErrors::set_left();
+    }
+    let lazy = Arc::new(LazyCondition {
+        loc: loc.clone(),
+        cond: cond.clone(),
+        comma,
+        lhs: lhs.clone(),
+        rhs: rhs.clone(),
+        registrations: loaded_func_registrations(),
+        split: Mutex::new(None),
+    });
+    *lhs = Arc::new(Value::ConditionSide {
+        cond: lazy.clone(),
+        side: 0,
+    });
