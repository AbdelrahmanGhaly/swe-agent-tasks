+static std::vector<const LazyCalls*>* g_waiting_warnings;
+
+// An expression with ${name ...} references that a loaded object may register
+// a function under, or with an error left for its expansion. Like make, which
+// reads text when it expands it, it is read again whenever a function has been
+// registered since it was read, and an error its reading left is raised where
+// its expansion reaches the part holding it. The --warn warnings waiting for
+// its expansion are given when it is first expanded, or when the condition it
+// was read for is split again.
+class LazyCalls : public Value {
+ public:
+  LazyCalls(const Loc& loc,
+            std::string_view text,
+            const char* terms,
+            ParseExprOpt opt,
+            bool trim_right_space,
+            Value* value,
+            ExprCalls calls)
+      : Value(loc),
+        text_(text),
+        has_terms_(terms != nullptr),
+        terms_(terms ? terms : ""),
+        opt_(opt),
+        trim_right_space_(trim_right_space),
+        value_(value),
+        calls_(std::move(calls)),
+        registrations_(LoadedFuncRegistrations()) {
+    if (!calls_.warnings.empty()) {
+      if (!g_waiting_warnings)
+        g_waiting_warnings = new std::vector<const LazyCalls*>();
+      g_waiting_warnings->push_back(this);
+    }
+  }
+
+  ~LazyCalls() {
+    delete value_;
+    if (g_waiting_warnings) {
+      auto found = std::find(g_waiting_warnings->begin(),
+                             g_waiting_warnings->end(), this);
+      if (found != g_waiting_warnings->end())
+        g_waiting_warnings->erase(found);
+    }
+  }
+
+  virtual bool IsFunc(Evaluator* ev) const override {
+    if (value_->IsFunc(ev))
+      return true;
+    for (Symbol name : calls_.names) {
+      if (FindLoadedFunc(name))
+        return true;
+    }
+    return false;
+  }
+
+  virtual bool DependsOnLoadedFuncs() const override { return true; }
+
+  virtual void Eval(Evaluator* ev, std::string* s) const override {
+    GiveWarnings();
+    const size_t registrations = LoadedFuncRegistrations();
+    if (registrations == registrations_) {
+      value_->Eval(ev, s);
+      return;
+    }
+    if (!reread_ || reread_registrations_ != registrations) {
+      Loc loc = Location();
+      size_t n;
+      g_reading_again = true;
+      reread_.reset(ParseExprImpl(&loc, text_,
+                                  has_terms_ ? terms_.c_str() : nullptr, opt_,
+                                  &n, trim_right_space_));
+      g_reading_again = false;
+      reread_registrations_ = registrations;
+    }
+    // An expansion still using this reading keeps it alive.
+    std::shared_ptr<const Value> reading = reread_;
+    reading->Eval(ev, s);
+  }
+
+  virtual std::string DebugString_() const override {
+    return Value::DebugString(value_);
+  }
+
+  const ExprError& error() const { return calls_.error; }
+
+  // Gives the warnings waiting for its expansion, the first time it is called,
+  // leaving out those about calls whose names are functions by then.
+  void GiveWarnings() const {
+    if (warned_)
+      return;
+    warned_ = true;
+    for (const WaitingWarning& w : calls_.warnings) {
+      if (!w.name.IsValid() || !FindLoadedFunc(w.name))
+        KATI_WARN_LOC(w.loc, "%s", w.msg.c_str());
+    }
+  }
+
+ private:
+  std::string_view text_;
+  bool has_terms_;
+  std::string terms_;
+  ParseExprOpt opt_;
+  bool trim_right_space_;
+  Value* value_;
+  ExprCalls calls_;
+  size_t registrations_;
+  mutable bool warned_ = false;
+  // The latest reading of the text, and the registrations there were then.
+  mutable std::shared_ptr<const Value> reread_;
+  mutable size_t reread_registrations_ = 0;
+};
