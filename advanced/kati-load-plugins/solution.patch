+// Where make splits a parenthesized ifeq condition: at its first comma outside
+// parentheses, counting no other brackets.
+static size_t IfEqComma(std::string_view cond) {
+  int depth = 0;
+  for (size_t i = 0; i < cond.size(); i++) {
+    if (cond[i] == '(')
+      depth++;
+    else if (cond[i] == ')')
+      depth--;
+    else if (cond[i] == ',' && depth <= 0)
+      return i;
+  }
+  return std::string_view::npos;
+}
+
+// Both sides of a parenthesized ifeq whose first side depends on loaded
+// functions. A call there may hold the comma kati split at, so like make,
+// which splits the condition at that comma before expanding it, the condition
+// is split there and its sides are read again whenever a function has been
+// registered since kati read them.
+class LazyCondition {
+ public:
+  LazyCondition(const Loc& loc,
+                std::string_view cond,
+                size_t comma,
+                Value* lhs,
+                Value* rhs)
+      : loc_(loc),
+        cond_(cond),
+        comma_(comma),
+        lhs_(lhs),
+        rhs_(rhs),
+        registrations_(LoadedFuncRegistrations()) {}
+
+  ~LazyCondition() {
+    delete lhs_;
+    delete rhs_;
+  }
+
+  // A side as kati first read it. The second is nullptr when kati found no
+  // comma.
+  const Value* FirstReading(int side) const { return side ? rhs_ : lhs_; }
+
+  void Eval(int side, Evaluator* ev, std::string* s) const {
+    if (rhs_ && LoadedFuncRegistrations() == registrations_) {
+      FirstReading(side)->Eval(ev, s);
+      return;
+    }
+    // The sides as kati first read them are not expanded, so the warnings they
+    // keep for their expansion are given here. Reading the condition again
+    // gives none.
+    for (const Value* v : {lhs_, rhs_}) {
+      if (v && v->DependsOnLoadedFuncs())
+        static_cast<const LazyCalls*>(v)->GiveWarnings();
+    }
+    // An expansion still using this split keeps it alive.
+    std::shared_ptr<const Split> split = Current();
+    (side ? split->rhs : split->lhs)->Eval(ev, s);
+  }
+
+ private:
+  struct Split {
+    size_t registrations;
+    std::unique_ptr<Value> lhs;
+    std::unique_ptr<Value> rhs;
+  };
+
+  std::shared_ptr<const Split> Current() const {
+    const size_t registrations = LoadedFuncRegistrations();
+    if (!split_ || split_->registrations != registrations) {
+      if (comma_ == std::string_view::npos || registrations == registrations_) {
+        // Kati found no comma, and make finds none either or no function has
+        // been registered since kati read the condition, which then fails as it
+        // does in a makefile that loads nothing: with an error kati met
+        // reading the first side, if it met one.
+        if (registrations == registrations_)
+          static_cast<const LazyCalls*>(lhs_)->error().Raise();
+        ERROR_LOC(loc_, "*** invalid syntax in conditional.");
+      }
+      auto split = std::make_shared<Split>();
+      split->registrations = registrations;
+      Loc loc = loc_;
+      size_t n;
+      g_reading_again = true;
+      split->lhs.reset(ParseExprImpl(&loc,
+                                     TrimRightSpace(cond_.substr(0, comma_)),
+                                     nullptr, ParseExprOpt::NORMAL, &n));
+      split->rhs.reset(ParseExprImpl(&loc,
+                                     TrimLeftSpace(cond_.substr(comma_ + 1)),
+                                     nullptr, ParseExprOpt::NORMAL, &n));
+      g_reading_again = false;
+      split_ = std::move(split);
+    }
+    return split_;
+  }
+
+  Loc loc_;
+  std::string_view cond_;
+  size_t comma_;
+  Value* lhs_;
+  Value* rhs_;
+  size_t registrations_;
+  mutable std::shared_ptr<const Split> split_;
 };
 
