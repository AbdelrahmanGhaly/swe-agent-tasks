+  }
+
+  ~ScopedCallback() {
+    ev_->set_loc(saved_loc_);
+    g_callback_ev = saved_ev_;
+    g_callback_call_loc = saved_call_loc_;
+  }
+
+ private:
+  Evaluator* ev_;
+  Evaluator* saved_ev_;
+  const Loc* saved_call_loc_;
+  Loc saved_loc_;
+};
+
+bool IsFuncNameChar(char c) {
+  return isalnum(static_cast<unsigned char>(c)) || c == '.' || c == '-' ||
+         c == '_';
+}
+
+Loc CallbackLoc(Evaluator* ev) {
+  return ev ? ev->loc() : Loc();
+}
+
+// Like make, which exits when it runs out of memory.
+char* Allocate(size_t len) {
+  char* r = static_cast<char*>(malloc(len));
+  if (!r)
+    ERROR("*** virtual memory exhausted.");
+  return r;
+}
+
+char* CopyToMalloc(std::string_view s) {
+  char* r = Allocate(s.size() + 1);
+  memcpy(r, s.data(), s.size());
+  r[s.size()] = '\0';
+  return r;
+}
+
+std::string SetupSymbol(std::string_view file) {
+  size_t slash = file.rfind('/');
+  std::string_view base =
+      slash == std::string::npos ? file : file.substr(slash + 1);
+  size_t len = 0;
+  while (len < base.size() &&
+         (isalnum(static_cast<unsigned char>(base[len])) || base[len] == '_')) {
+    len++;
+  }
+  return std::string(base.substr(0, len)) + "_gmk_setup";
+}
+
+// Like make, only the first place the name appears in .LOADED is checked.
+bool IsAlreadyLoaded(std::string_view loaded, std::string_view file) {
+  size_t found = loaded.find(file);
+  if (found == std::string::npos)
+    return false;
+  size_t end = found + file.size();
+  return (found == 0 || loaded[found - 1] == ' ') &&
+         (end == loaded.size() || loaded[end] == ' ');
+}
+
+// Like make, which defines .LOADED with a default origin, a value the
+// makefile, the environment or the command line gave it is kept: one with
+// another origin, or one changed since a load set it, as kati's += keeps the
+// origin a variable had. The name is added to the value .LOADED had before
+// the object was set up.
+void AddLoaded(const Loc& loc, std::string loaded, std::string_view file) {
+  static std::string* last_set = new std::string();
+  Symbol sym = Intern(".LOADED");
+  Var* var = sym.GetGlobalVar();
+  if (var->IsDefined() &&
+      (var->Origin() != VarOrigin::DEFAULT || var->String() != *last_set)) {
+    return;
+  }
+  if (!loaded.empty())
+    loaded += ' ';
+  loaded.append(file);
+  *last_set = loaded;
+  sym.SetGlobalVar(new SimpleVar(loaded, VarOrigin::DEFAULT, nullptr, loc));
+}
+
+// Like make, a leading "~" or "~user" names a home directory. For "~" that is
+// the value of HOME, or when it is empty, the one the environment or the
+// login's password entry gives.
+std::string TildeExpand(Evaluator* ev, std::string_view name) {
+  const size_t slash = std::min(name.find('/'), name.size());
+  const std::string user(name.substr(1, slash - 1));
+  std::string home;
+  if (user.empty()) {
+    home = ev->EvalVar(Intern("HOME"));
+    if (home.empty()) {
+      const char* env = getenv("HOME");
+      home = env ? env : "";
+    }
+    if (home.empty()) {
+      const char* login = getlogin();
+      const passwd* pw = login ? getpwnam(login) : nullptr;
+      if (pw)
+        home = pw->pw_dir;
+    }
+  } else if (const passwd* pw = getpwnam(user.c_str())) {
+    home = pw->pw_dir;
+  }
+  if (home.empty())
+    return std::string(name);
+  return home + std::string(name.substr(slash));
+}
+
+// The names a word of a load line stands for. As make does, "./" and the
+// slashes after it are dropped, a name left empty becomes "./", and then a
+// leading "~" is expanded. A pattern is replaced by the files it matches, or
+// kept when it matches none, the way kati globs include names.
+std::vector<std::string> LoadNames(Evaluator* ev, std::string_view word) {
+  while (word.size() > 2 && word[0] == '.' && word[1] == '/') {
+    word.remove_prefix(2);
+    while (!word.empty() && word[0] == '/')
+      word.remove_prefix(1);
+  }
+  std::string name = word.empty() ? "./" : std::string(word);
+  if (name[0] == '~')
+    name = TildeExpand(ev, name);
+  const std::vector<std::string>& files = Glob(name.c_str());
+  if (files.empty())
+    return {name};
+  return files;
+}
+
+// Like make, which line-buffers its output, so that what an object prints
+// comes out a line at a time among kati's own messages.
+void LineBufferStdout() {
+  if (g_stdout_buffer)
+    return;
+  // Given a buffer of its own, glibc line-buffers a stream that was already
+  // written to.
+  g_stdout_buffer = new char[BUFSIZ];
+  fflush(stdout);
+  setvbuf(stdout, g_stdout_buffer, _IOLBF, BUFSIZ);
+}
+
+// Opens the object the way make does: a name without a slash is looked up
+// in the current directory first, then where the dynamic loader searches.
+void* OpenObject(const std::string& file) {
+  void* handle = nullptr;
+  if (file.find('/') == std::string::npos)
+    handle = dlopen(("./" + file).c_str(), RTLD_LAZY | RTLD_GLOBAL);
+  if (!handle)
+    handle = dlopen(file.c_str(), RTLD_LAZY | RTLD_GLOBAL);
+  return handle;
+}
+
+}  // namespace
+
+void FlushObjectOutput() {
+  if (g_stdout_buffer)
+    fflush(stdout);
+}
+
+bool IsLoadableFuncName(std::string_view name) {
+  if (name.empty() || name[0] == '.' || name.size() > kMaxFuncNameLen)
+    return false;
+  for (char c : name) {
+    if (!IsFuncNameChar(c))
+      return false;
+  }
+  return true;
+}
+
+const LoadedFunc* FindLoadedFunc(Symbol name) {
+  if (!g_loaded_funcs)
+    return nullptr;
+  auto found = g_loaded_funcs->find(name);
+  if (found == g_loaded_funcs->end())
+    return nullptr;
+  return &found->second;
+}
+
+size_t LoadedFuncRegistrations() {
+  return g_loaded_func_registrations;
+}
+
+void CallLoadedFunc(Evaluator* ev,
+                    const Loc& loc,
+                    const LoadedFunc* func,
+                    std::vector<std::string> args,
+                    std::string* s) {
+  if (args.size() < func->min_args) {
+    ERROR_LOC(loc,
+              "*** insufficient number of arguments (%zu) to function '%s'.",
+              args.size(), func->name.c_str());
+  }
+  if (!func->func) {
+    ERROR_LOC(loc, "*** unimplemented on this platform: function '%s'.",
+              func->name.c_str());
+  }
+  const std::string name = func->name;
+  const gmk_func_ptr fptr = func->func;
+  std::vector<char*> argv;
+  for (std::string& arg : args)
+    argv.push_back(arg.data());
+  argv.push_back(nullptr);
+
+  char* result;
+  {
+    ScopedCallback callback(ev, &loc);
+    result = fptr(name.c_str(), args.size(), argv.data());
+  }
+  if (result) {
+    s->append(result);
+    free(result);
+  }
+}
+
+static void LoadOne(Evaluator* ev, std::string_view spec, bool noerror) {
+  const Loc loc = ev->loc();
+  std::string file(spec);
+  std::string symbol;
+  size_t open = spec.find('(');
+  if (open != std::string::npos) {
+    size_t close = spec.find(')', open + 1);
+    if (close == spec.size() - 1) {
+      if (close == open + 1)
+        ERROR_LOC(loc, "*** Empty symbol name for load: %.*s.", SPF(spec));
+      file = std::string(spec.substr(0, open));
+      symbol = std::string(spec.substr(open + 1, close - open - 1));
+    }
+  }
+
+  // Like make, .LOADED is read once, before the object is set up.
+  const std::string loaded = ev->EvalVar(Intern(".LOADED"));
+  if (IsAlreadyLoaded(loaded, file))
+    return;
+  if (symbol.empty())
+    symbol = SetupSymbol(file);
+
+  LineBufferStdout();
+  ScopedCallback callback(ev);
+  // Like GNU make 4.2.1, the setup function is looked up in kati and the
+  // objects already loaded first, and the file is opened only when none defines
+  // it.
+  static void* global = dlopen(nullptr, RTLD_NOW | RTLD_GLOBAL);
+  SetupFunc setup = reinterpret_cast<SetupFunc>(dlsym(global, symbol.c_str()));
+  if (!setup) {
+    void* handle = OpenObject(file);
+    if (!handle) {
+      if (noerror)
+        return;
+      WARN_LOC(loc, "%s", dlerror());
+      ERROR_LOC(loc, "*** %s: failed to load.", file.c_str());
+    }
+    if (!dlsym(handle, "plugin_is_GPL_compatible")) {
+      ERROR_LOC(loc,
+                "*** Loaded object %s is not declared to be GPL compatible.",
+                file.c_str());
+    }
+    setup = reinterpret_cast<SetupFunc>(dlsym(handle, symbol.c_str()));
+    if (!setup) {
+      const char* err = dlerror();
+      ERROR_LOC(loc, "*** Failed to load symbol %s from %s: %s.",
+                symbol.c_str(), file.c_str(), err);
+    }
+  }
+  // Like the makefiles kati reads, the object is checked by --regen.
+  Dl_info info;
+  if (dladdr(reinterpret_cast<void*>(setup), &info) && info.dli_fname)
+    MakefileCacheManager::Get().AddExtraFileDep(info.dli_fname);
+
+  gmk_floc floc = {loc.filename,
+                   static_cast<unsigned long>(loc.lineno - ev->loc_offset())};
+  int r = setup(&floc);
+  // Like make 4.2.1, which records only a positive result in .LOADED. A
+  // negative one succeeds too, so loading the object again sets it up again.
+  if (r > 0) {
+    AddLoaded(loc, loaded, file);
+  } else if (r == 0 && !noerror) {
+    ERROR_LOC(loc, "*** %s: failed to load.", file.c_str());
+  }
+}
+
+void LoadObject(Evaluator* ev, std::string_view word, bool noerror) {
+  for (const std::string& name : LoadNames(ev, word))
+    LoadOne(ev, name, noerror);
+}
+
+extern "C" {
+
+void gmk_free(char* str) {
+  free(str);
+}
+
+char* gmk_alloc(unsigned int len) {
+  return Allocate(len ? len : 1);
+}
+
+void gmk_eval(const char* buffer, const gmk_floc* floc) {
+  Evaluator* ev = g_callback_ev;
+  if (!ev)
+    return;
+  const Loc caller_loc = ev->loc();
+  const int caller_offset = ev->loc_offset();
+  Loc loc = caller_loc;
+  if (floc) {
+    loc = Loc(floc->filenm ? Intern(floc->filenm).c_str() : nullptr,
+              static_cast<int>(floc->lineno));
+    // Like make, a location given here has no recipe offset.
+    ev->set_loc_offset(0);
+  }
+  // The statements keep pointing into the text, as with $(eval).
+  std::string* text = new std::string(buffer);
+  std::vector<Stmt*> stmts;
+  Parse(*text, loc, &stmts);
+  for (Stmt* stmt : stmts) {
+    stmt->Eval(ev);
+  }
+  // Like make, later errors in the same call point at the caller again.
+  ev->set_loc(caller_loc);
+  ev->set_loc_offset(caller_offset);
+}
+
+char* gmk_expand(const char* str) {
+  std::string result;
+  if (Evaluator* ev = g_callback_ev) {
+    const std::string text(str);
+    // Like make, which reports what it meets reading the text at the variable
+    // being expanded or at the line being read, the text is read where the
+    // call was read.
+    Loc loc = g_callback_call_loc ? *g_callback_call_loc : ev->loc();
+    std::unique_ptr<Value> v(ParseExpr(&loc, text, ParseExprOpt::EXPAND));
+    v->Eval(ev, &result);
+  }
+  return CopyToMalloc(result);
+}
+
+void gmk_add_function(const char* name,
+                      gmk_func_ptr func,
+                      unsigned int min_args,
+                      unsigned int max_args,
+                      unsigned int flags) {
+  const Loc loc = CallbackLoc(g_callback_ev);
+  const std::string_view n(name);
+  size_t len = 0;
+  while (len < n.size() && IsFuncNameChar(n[len]))
+    len++;
+  if (len == 0)
+    ERROR_LOC(loc, "*** Empty function name.");
+  if (n[0] == '.' || len != n.size())
+    ERROR_LOC(loc, "*** Invalid function name: %s.", name);
+  if (len > kMaxFuncNameLen)
+    ERROR_LOC(loc, "*** Function name too long: %s.", name);
+  if (min_args > kMaxArgCount) {
+    ERROR_LOC(loc, "*** Invalid minimum argument count (%u) for function %s.",
+              min_args, name);
+  }
+  if (max_args > kMaxArgCount || (max_args && max_args < min_args)) {
+    ERROR_LOC(loc, "*** Invalid maximum argument count (%u) for function %s.",
+              max_args, name);
+  }
+
+  if (!g_loaded_funcs)
+    g_loaded_funcs = new std::unordered_map<Symbol, LoadedFunc>();
+  (*g_loaded_funcs)[Intern(n)] = LoadedFunc{std::string(n), func, min_args,
+                                            max_args, !(flags & kNoExpand)};
+  g_loaded_func_registrations++;
+}
+
+}  // extern "C"
