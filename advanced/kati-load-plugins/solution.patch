+// Gives a --warn warning met reading the text, the first time it is read and
+// unless the text has left an error, where base kati stops reading. When
+// objects can be loaded, once the expression has a call read as a variable
+// reference, the warning waits for its expansion, where one about such a call,
+// |unread| to |name|, is given only if |name| is still no function: a
+// function that a later load registers is not reported.
+static void ReadWarning(bool unread,
+                        Symbol name,
+                        const Loc& loc,
+                        std::string msg) {
+  if (g_reading_again || (g_text_errors && g_text_errors->left()))
+    return;
+  if (g_expr_calls && !g_expr_calls->error.msg.empty())
+    return;
+  if (g_objects_can_load && g_expr_calls && g_expr_calls->has_unread) {
+    g_expr_calls->warnings.push_back(
+        {unread ? name : Symbol(), loc, std::move(msg)});
+    return;
+  }
+  KATI_WARN_LOC(loc, "%s", msg.c_str());
+}
