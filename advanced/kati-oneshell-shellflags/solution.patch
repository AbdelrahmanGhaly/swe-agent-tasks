+void CommandEvaluator::EvalOneShell(const DepNode& n,
+                                    const std::string& shell,
+                                    std::vector<Command>* result) {
+  std::vector<size_t> starts = {0};
+  starts.insert(starts.end(), n.recipe_breaks.begin(), n.recipe_breaks.end());
+  starts.push_back(n.cmds.size());
+  for (size_t r = 0; r + 1 < starts.size(); r++) {
+    std::string script;
+    for (size_t i = starts[r]; i < starts[r + 1]; i++) {
+      if (i > starts[r])
+        script += '\n';
+      ev_->set_loc(n.loc);
+      n.cmds[i]->Eval(ev_, &script);
+    }
+    script = DropContinuationTabs(script);
+
+    bool echo = !g_flags.is_silent_mode;
+    bool ignore_error = false;
+    size_t start = 0;
+    for (; start < script.size(); start++) {
+      char c = script[start];
+      if (c == '@') {
+        echo = false;
+      } else if (c == '-') {
+        ignore_error = true;
+      } else if (c != '+' && c != ' ' && c != '\t') {
+        break;
+      }
+    }
+    std::string_view body = std::string_view(script).substr(start);
+    if (body.empty())
+      continue;
+
+    Command& command = result->emplace_back(n.output);
+    command.cmd =
+        IsPosixShell(shell) ? StripOneShellPrefixes(body) : std::string(body);
+    command.echo = echo;
+    command.ignore_error = ignore_error;
+    command.one_shell = true;
+  }
+}
