+// Ninja commands are single lines, so text with newlines is rebuilt by
+// printf with one single-quoted argument per line.
+std::string ShellQuote(std::string_view text) {
+  const bool multiline = text.find('\n') != std::string::npos;
+  std::string r = multiline ? "\"$(printf '%s\\n' '" : "'";
+  for (char ch : text) {
+    if (ch == '\n')
+      r += "' '";
+    else if (ch == '\'')
+      r += "'\\''";
+    else
+      r += ch;
+  }
+  r += multiline ? "')\"" : "'";
+  return r;
+}
+
+std::string StripOneShellPrefixes(std::string_view script) {
+  std::string r;
+  size_t i = 0;
+  while (i < script.size()) {
+    while (i < script.size() && IsBlankOrPrefix(script[i]))
+      i++;
+    bool escaped = false;
+    while (i < script.size()) {
+      char c = script[i++];
+      r += c;
+      if (c == '\\') {
+        escaped = !escaped;
+      } else {
