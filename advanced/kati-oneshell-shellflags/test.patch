+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+mode=""
+mode_count=0
+output_path=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      mode="$1"
+      mode_count=$((mode_count + 1))
+      shift
+      ;;
+    --output_path)
+      if [ $# -lt 2 ] || [ -z "$2" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      output_path="$2"
+      shift 2
+      ;;
+    --output_path=*)
+      output_path="${1#--output_path=}"
+      if [ -z "$output_path" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$mode_count" -eq 1 ] || usage
+case "$output_path" in
+  ""|/*) ;;
+  *) output_path="$PWD/$output_path" ;;
+esac
+
+cd "$(dirname "$0")" || exit 2
+
+export GOFLAGS=-buildvcs=false
+export GOTOOLCHAIN=local
+export GOPROXY=off
+export CARGO_NET_OFFLINE=true
+export RUSTC_BOOTSTRAP=1
+gocache="$(go env GOCACHE 2>/dev/null)"
+if [ -z "$gocache" ] || ! mkdir -p "$gocache" 2>/dev/null || [ ! -w "$gocache" ]; then
+  export GOCACHE="/tmp/kati-gocache-$(id -u)"
+fi
+
+base_commit=55ea1e26f4da6d52a4ddca8f36a130dc26120525
+new_package=./oneshell_13cff4/
+work="$(mktemp -d)"
+trap 'rm -rf "$work"' EXIT
+status=0
+runs=0
+
+record() {
+  runs=$((runs + 1))
+  echo "$runs $1 $2 $3" >>"$work/index"
+  cp "$4" "$work/$runs.log"
+  [ "$3" -ne 0 ] && status=1
+  return 0
+}
+
+build_engines() {
+  rm -rf out ckati find_test ninja_test strutil_test target/debug/rkati
+  local s=0
+  make -j"$(nproc)" ckati "$@" >"$work/build.log" 2>&1 || s=1
+  cargo build --offline >>"$work/build.log" 2>&1 || s=1
+  record build build "$s" "$work/build.log"
+}
+
+run_go() {
+  local name="$1"
+  shift
+  go test -v -count=1 -timeout 30m "$@" >"$work/go.log" 2>&1
+  local s=$?
+  if [ "$name" != TestKati ]; then
+    sed -i -E "s/\bTestKati\b/$name/g" "$work/go.log"
+  fi
+  record go "$name" "$s" "$work/go.log"
+}
+
+if [ "$mode" = base ]; then
+  cases=""
+  if git -c safe.directory='*' cat-file -e "$base_commit^{commit}" 2>/dev/null; then
+    git -c safe.directory='*' checkout -q "$base_commit" -- run_test.go testcase/
+    sed -i 's/t\.Errorf("Expected failure, but output is the same")/t.Logf("Expected failure, but output is the same")/' run_test.go
+    cases="$(git -c safe.directory='*' ls-tree --name-only "$base_commit" testcase/ | sed 's#^testcase/##')"
+  fi
+  [ -n "$cases" ] || cases="$(ls testcase)"
+  pattern="$(printf '%s\n' "$cases" | grep -E '\.(mk|sh)$' | sed 's/\./\\./g' | paste -sd '|' -)"
+  build_engines ckati_tests
+  run_go TestKati -run "^TestKati\$/^($pattern)\$" .
+  run_go TestKati_ninja -run "^TestKati\$/^($pattern)\$" . --ninja
+  run_go TestKati_rkati -run "^TestKati\$/^($pattern)\$" . --rkati
+  run_go TestKati_rkati_ninja -run "^TestKati\$/^($pattern)\$" . --rkati --ninja
+  for t in find_test ninja_test strutil_test; do
+    s=1
+    if [ -x "./$t" ]; then
+      "./$t" >"$work/unit.log" 2>&1 && s=0
+    else
+      echo "$t was not built" >"$work/unit.log"
+    fi
+    record unit "ckati_$t" "$s" "$work/unit.log"
+  done
+  cargo test --offline -- -Z unstable-options --format json --report-time >"$work/cargo.json" 2>"$work/cargo.err"
+  s=$?
+  cat "$work/cargo.err" >>"$work/cargo.json"
+  record cargo rkati_unit "$s" "$work/cargo.json"
+else
+  build_engines
+  run_go TestOneShellAndShellFlags "$new_package"
+fi
+
+while read -r i kind name s; do
+  echo "===== $name (exit $s)"
+  cat "$work/$i.log"
+done <"$work/index"
+
+if [ -n "$output_path" ]; then
+  mkdir -p "$(dirname "$output_path")"
+  while read -r i kind name s; do
+    case "$kind" in
+      go) go-junit-report -in "$work/$i.log" -out "$work/$i.xml" 2>"$work/$i.convert" || status=1 ;;
+      cargo) grep '^{' "$work/$i.log" | cargo2junit >"$work/$i.xml" 2>"$work/$i.convert" || status=1 ;;
+    esac
+  done <"$work/index"
+  if ! python3 - "$work" "$output_path" <<'PY'
+import os
+import sys
+import xml.etree.ElementTree as ET
+
+work, output = sys.argv[1], sys.argv[2]
+root = ET.Element("testsuites")
+
+
+def tail(path, lines=100):
+    try:
+        with open(path, errors="replace") as f:
+            return "".join(f.readlines()[-lines:])
+    except OSError:
+        return ""
+
+
+def failure(suite_name, case_name, message, text):
+    suite = ET.SubElement(root, "testsuite", name=suite_name)
+    case = ET.SubElement(suite, "testcase", classname=suite_name, name=case_name)
+    ET.SubElement(case, "failure", message=message).text = text
+
+
+def load(path):
+    try:
+        top = ET.parse(path).getroot()
+    except (OSError, ET.ParseError):
+        return []
+    return [top] if top.tag == "testsuite" else top.findall("testsuite")
+
+
+with open(os.path.join(work, "index")) as f:
+    runs = [line.split() for line in f if line.strip()]
+for i, kind, name, code in runs:
+    log = os.path.join(work, i + ".log")
+    if kind == "build":
+        if code != "0":
+            failure("kati_build", "build", "ckati or rkati failed to build", tail(log))
+        continue
+    if kind == "unit":
+        suite = ET.SubElement(root, "testsuite", name="ckati_unit")
+        case = ET.SubElement(suite, "testcase", classname="ckati_unit", name=name)
+        if code != "0":
+            ET.SubElement(case, "failure", message="exit status " + code).text = tail(log)
+        continue
+    suites = load(os.path.join(work, i + ".xml"))
+    cases = [c for s in suites for c in s.iter("testcase")]
+    if not cases:
+        failure(name, "results", "no test results could be read",
+                tail(os.path.join(work, i + ".convert")) + tail(log))
+        continue
+    for case in cases:
+        for problem in case.findall("failure") + case.findall("error"):
+            if not (problem.text or "").strip():
+                problem.text = tail(log, 60)
+    if code != "0" and not any(c.find("failure") is not None or c.find("error") is not None for c in cases):
+        failure(name, "exit_status", "the run failed without a failing test", tail(log))
+    root.extend(suites)
+
+if not list(root.iter("testcase")):
+    failure("kati", "collect", "no test results were produced", "")
+for suite in root.findall("testsuite"):
+    cases = suite.findall("testcase")
+    suite.set("tests", str(len(cases)))
+    suite.set("failures", str(sum(c.find("failure") is not None for c in cases)))
+    suite.set("errors", str(sum(c.find("error") is not None for c in cases)))
+ET.ElementTree(root).write(output, encoding="UTF-8", xml_declaration=True)
+PY
+  then
+    echo "could not write $output_path" >&2
+    status=1
+  fi
+fi
+
+exit "$status"
