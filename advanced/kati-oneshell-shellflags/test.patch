+
+type rewrite struct {
+	re   *regexp.Regexp
+	with string
+}
+
+var quotes = rewrite{regexp.MustCompile("([`'\"]|\xe2\x80\x98|\xe2\x80\x99)"), `"`}
+
+var makeRewrites = []rewrite{
+	quotes,
+	{regexp.MustCompile(`make(?:\[\d+\])?: (Entering|Leaving) directory[^\n]*\n`), ""},
+	{regexp.MustCompile(`make(?:\[\d+\])?: `), ""},
+	{regexp.MustCompile(`\s+Stop\.`), ""},
+	{regexp.MustCompile(`\[\S+:\d+: `), "["},
+}
+
+var silentMakeRewrites = []rewrite{
+	{regexp.MustCompile(`\*\*\* \[[^\n]*\] Error \d+\n`), ""},
+}
+
+var katiRewrites = []rewrite{
+	quotes,
+	{regexp.MustCompile(`\*kati\*[^\n]*`), ""},
+	{regexp.MustCompile(`c?kati: `), ""},
+}
+
+var ninjaRewrites = []rewrite{
+	{regexp.MustCompile(`NINJACMD: [^\n]*\n`), ""},
+	{regexp.MustCompile(`ninja: no work to do\.\n`), ""},
+	{regexp.MustCompile(`FAILED: [^\n]*\n[^\n]*\n`), ""},
+	{regexp.MustCompile(`ninja: build stopped: [^\n]*\n`), ""},
+}
+
+func apply(out []byte, rewrites []rewrite) []byte {
+	for _, r := range rewrites {
+		out = r.re.ReplaceAll(out, []byte(r.with))
+	}
+	return out
+}
+
+type outcome struct {
+	output string
+	ok     bool
+	files  string
+}
+
+func prepare(t *testing.T, sc scenario) string {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "Makefile"), []byte(sc.makefile), 0666); err != nil {
+		t.Fatal(err)
+	}
+	return dir
+}
+
+func execute(dir string, env []string, name string, args ...string) ([]byte, bool) {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, name, args...)
+	cmd.Dir = dir
+	cmd.Env = append(os.Environ(), env...)
+	out, err := cmd.CombinedOutput()
+	return out, err == nil
+}
+
+func leftovers(t *testing.T, dir string) string {
+	generated := map[string]bool{"Makefile": true, "build.ninja": true, "env.sh": true, "ninja.sh": true}
+	contents := map[string]string{}
+	err := filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(dir, path)
+		if err != nil || rel == "." {
+			return err
+		}
+		if !strings.Contains(rel, "/") && (generated[rel] || strings.HasPrefix(rel, ".") || strings.HasPrefix(rel, "kati")) {
+			if d.IsDir() {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if !d.Type().IsRegular() {
+			return nil
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		contents[rel] = string(data)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for name := range contents {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	var b strings.Builder
+	for _, name := range names {
+		fmt.Fprintf(&b, "%s: %q\n", name, contents[name])
+	}
+	return b.String()
+}
+
+func runMake(t *testing.T, sc scenario, ninja bool) outcome {
+	dir := prepare(t, sc)
+	var args []string
+	if ninja {
+		args = append(args, "-s")
+	}
+	out, ok := execute(dir, sc.env, "make", args...)
+	out = apply(out, makeRewrites)
+	if ninja {
+		out = apply(out, silentMakeRewrites)
+	}
+	return outcome{string(out), ok, leftovers(t, dir)}
+}
+
+func runKati(t *testing.T, sc scenario, kati string, ninja bool) outcome {
+	dir := prepare(t, sc)
+	args := []string{"--use_find_emulator"}
+	if ninja {
+		args = append(args, "--ninja")
+	}
+	out, ok := execute(dir, sc.env, kati, args...)
+	if ok && ninja {
+		var ninjaOut []byte
+		ninjaOut, ok = execute(dir, sc.env, "./ninja.sh", "-j1", "-v")
+		out = append(out, apply(ninjaOut, ninjaRewrites)...)
+	}
+	return outcome{string(apply(out, katiRewrites)), ok, leftovers(t, dir)}
+}
+
+func TestMain(m *testing.M) {
+	os.Unsetenv("MAKEFLAGS")
+	os.Unsetenv("MAKELEVEL")
+	os.Setenv("NINJA_STATUS", "NINJACMD: ")
+	os.Exit(m.Run())
+}
+
+func TestOneShellAndShellFlags(t *testing.T) {
+	version, err := exec.Command("make", "--version").Output()
+	if err != nil || !bytes.HasPrefix(version, []byte("GNU Make 4.2.1\n")) {
+		t.Fatalf("GNU make 4.2.1 is needed as make: %q %v", version, err)
+	}
+	root, err := filepath.Abs("..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	engines := []struct{ name, path string }{
+		{"ckati", filepath.Join(root, "ckati")},
+		{"rkati", filepath.Join(root, "target", "debug", "rkati")},
+	}
+	for _, e := range engines {
+		if _, err := os.Stat(e.path); err != nil {
+			t.Fatalf("%s must be built before testing: %v", e.name, err)
+		}
+	}
+	for _, sc := range scenarios {
+		sc := sc
+		t.Run(sc.name, func(t *testing.T) {
+			t.Parallel()
+			for _, ninja := range []bool{false, true} {
+				want := runMake(t, sc, ninja)
+				for _, e := range engines {
+					cell := e.name
+					if ninja {
+						cell += "_ninja"
+					}
+					t.Run(cell, func(t *testing.T) {
+						got := runKati(t, sc, e.path, ninja)
+						if got.output != want.output {
+							t.Errorf("output differs from make\nmake:\n%s\n%s:\n%s", want.output, cell, got.output)
+						}
+						if got.ok != want.ok {
+							t.Errorf("make succeeded: %v, %s succeeded: %v", want.ok, cell, got.ok)
+						}
+						if got.files != want.files {
+							t.Errorf("files differ from make\nmake:\n%s\n%s:\n%s", want.files, cell, got.files)
+						}
+					})
+				}
+			}
+		})
+	}
+}
