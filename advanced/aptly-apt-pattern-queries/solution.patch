diff --git a/query/pattern.go b/query/pattern.go
new file mode 100644
index 00000000..13819b5a
--- /dev/null
+++ b/query/pattern.go
@@ -0,0 +1,553 @@
+package query
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/aptly-dev/aptly/deb"
+)
+
+// patternNode is a node of apt pattern parse tree: pattern term with optional arguments or a word
+type patternNode struct {
+	start, end int
+	term       string
+	args       []*patternNode
+	haveArgs   bool
+	isWord     bool
+	word       string
+}
+
+// patternError is a syntax error in apt pattern, located like apt reports it
+type patternError struct {
+	start, end int
+	message    string
+}
+
+func (e *patternError) Error() string {
+	return fmt.Sprintf("input:%d-%d: error: %s", e.start, e.end, e.message)
+}
+
+// short forms of patterns, in the order apt tries them
+var shortPatterns = []struct {
+	short, long string
+	takesArg    bool
+}{
+	{"r", "?architecture", true},
+	{"A", "?archive", true},
+	{"M", "?automatic", false},
+	{"b", "?broken", false},
+	{"c", "?config-files", false},
+	{"DDepends:", "?depends", true},
+	{"DPre-Depends:", "?pre-depends", true},
+	{"DSuggests:", "?suggests", true},
+	{"DRecommends:", "?recommends", true},
+	{"DConflicts:", "?conflicts", true},
+	{"DReplaces:", "?replaces", true},
+	{"DObsoletes:", "?obsoletes", true},
+	{"DBreaks:", "?breaks", true},
+	{"DEnhances:", "?enhances", true},
+	{"D", "?depends", true},
+	{"RDepends:", "?reverse-depends", true},
+	{"RPre-Depends:", "?reverse-pre-depends", true},
+	{"RSuggests:", "?reverse-suggests", true},
+	{"RRecommends:", "?reverse-recommends", true},
+	{"RConflicts:", "?reverse-conflicts", true},
+	{"RReplaces:", "?reverse-replaces", true},
+	{"RObsoletes:", "?reverse-obsoletes", true},
+	{"RBreaks:", "?reverse-breaks", true},
+	{"REnhances:", "?reverse-enhances", true},
+	{"R", "?reverse-depends", true},
+	{"E", "?essential", false},
+	{"F", "?false", false},
+	{"g", "?garbage", false},
+	{"i", "?installed", false},
+	{"n", "?name", true},
+	{"o", "?obsolete", false},
+	{"O", "?origin", true},
+	{"p", "?priority", true},
+	{"s", "?section", true},
+	{"e", "?source-package", true},
+	{"T", "?true", false},
+	{"U", "?upgradable", false},
+	{"V", "?version", true},
+	{"v", "?virtual", false},
+}
+
+// relationship patterns: term of forward pattern, term of reverse pattern and relationship field;
+// for Pre-Depends apt 2.6 knows only ?predepends and ?reverse-predepends, so ?pre-depends and
+// ?reverse-pre-depends, which its short forms expand to, are rejected the way apt rejects them
+var relationPatterns = []struct {
+	forward, reverse string
+	kind             int
+}{
+	{"?depends", "?reverse-depends", relationDepends},
+	{"?predepends", "?reverse-predepends", relationPreDepends},
+	{"?suggests", "?reverse-suggests", relationSuggests},
+	{"?recommends", "?reverse-recommends", relationRecommends},
+	{"?conflicts", "?reverse-conflicts", relationConflicts},
+	{"?replaces", "?reverse-replaces", relationReplaces},
+	{"?obsoletes", "?reverse-obsoletes", relationObsoletes},
+	{"?breaks", "?reverse-breaks", relationBreaks},
+	{"?enhances", "?reverse-enhances", relationEnhances},
+}
+
+const (
+	wordDisallowedStart = "!?~|,() \x00"
+	wordDisallowedLong  = "|,()\x00"
+	wordDisallowedShort = "!?~|,() \x00"
+)
+
+type patternParser struct {
+	text string
+	pos  int
+}
+
+func (p *patternParser) at(i int) byte {
+	if i < len(p.text) {
+		return p.text[i]
+	}
+	return 0
+}
+
+func (p *patternParser) current() byte {
+	return p.at(p.pos)
+}
+
+func (p *patternParser) fail(start, end int, format string, args ...interface{}) {
+	panic(&patternError{start: start, end: end, message: fmt.Sprintf(format, args...)})
+}
+
+func (p *patternParser) skipSpace() int {
+	for {
+		switch p.current() {
+		case ' ', '\t', '\r', '\n':
+			p.pos++
+		default:
+			return p.pos
+		}
+	}
+}
+
+// parsePatternTree parses complete apt pattern, nothing but whitespace may surround it
+func parsePatternTree(text string) (node *patternNode, err error) {
+	p := &patternParser{text: text}
+
+	defer func() {
+		if r := recover(); r != nil {
+			e, ok := r.(*patternError)
+			if !ok {
+				panic(r)
+			}
+			node, err = nil, e
+		}
+	}()
+
+	p.skipSpace()
+	node = p.parseOr()
+	p.skipSpace()
+
+	if node == nil {
+		p.fail(0, len(text), "Expected pattern")
+	}
+	// trailing whitespace is fine, so that a pattern read from a file may end with a newline
+	if p.pos != len(text) {
+		p.fail(node.end, len(text), "Expected end of file")
+	}
+
+	return node, nil
+}
+
+func (p *patternParser) parseOr() *patternNode {
+	start := p.pos
+
+	first := p.parseAnd()
+	if first == nil {
+		return nil
+	}
+
+	nodes := []*patternNode{first}
+	for p.skipSpace(); p.current() == '|'; p.skipSpace() {
+		p.pos++
+		p.skipSpace()
+
+		node := p.parseAnd()
+		if node == nil {
+			p.fail(p.pos, len(p.text), "Expected pattern after |")
+		}
+		nodes = append(nodes, node)
+	}
+
+	if len(nodes) == 1 {
+		return nodes[0]
+	}
+
+	return &patternNode{start: start, end: nodes[len(nodes)-1].end, term: "?or", args: nodes, haveArgs: true}
+}
+
+func (p *patternParser) parseAnd() *patternNode {
+	start := p.pos
+
+	var nodes []*patternNode
+	for p.skipSpace(); p.pos < len(p.text); p.skipSpace() {
+		node := p.parseUnary()
+		if node == nil {
+			break
+		}
+		nodes = append(nodes, node)
+	}
+
+	switch len(nodes) {
+	case 0:
+		return nil
+	case 1:
+		return nodes[0]
+	}
+
+	return &patternNode{start: start, end: nodes[len(nodes)-1].end, term: "?and", args: nodes, haveArgs: true}
+}
+
+func (p *patternParser) parseUnary() *patternNode {
+	if p.current() != '!' {
+		return p.parsePrimary()
+	}
+
+	p.pos++
+	start := p.pos
+
+	primary := p.parsePrimary()
+	if primary == nil {
+		p.fail(start, len(p.text), "Expected pattern")
+	}
+
+	return &patternNode{start: start, end: primary.end, term: "?not", args: []*patternNode{primary}, haveArgs: true}
+}
+
+func (p *patternParser) parsePrimary() *patternNode {
+	if node := p.parseShortPattern(); node != nil {
+		return node
+	}
+	if node := p.parsePattern(); node != nil {
+		return node
+	}
+	return p.parseGroup()
+}
+
+func (p *patternParser) parseGroup() *patternNode {
+	if p.current() != '(' {
+		return nil
+	}
+
+	start := p.pos
+	p.pos++
+	p.skipSpace()
+
+	node := p.parseOr()
+	if node == nil {
+		p.fail(p.pos, len(p.text), "Expected pattern after '('")
+	}
+	p.skipSpace()
+
+	if p.current() != ')' {
+		p.fail(p.pos, len(p.text), "Expected closing parenthesis")
+	}
+	p.pos++
+
+	node.start, node.end = start, p.pos
+	return node
+}
+
+func (p *patternParser) parseArgument(short bool) *patternNode {
+	if node := p.parseQuotedWord(); node != nil {
+		return node
+	}
+	if node := p.parseWord(short); node != nil {
+		return node
+	}
+	if node := p.parseOr(); node != nil {
+		return node
+	}
+
+	p.fail(p.pos, len(p.text), "Expected pattern, quoted word, or word")
+	return nil
+}
+
+func (p *patternParser) parseShortPattern() *patternNode {
+	if p.current() != '~' {
+		return nil
+	}
+
+	for _, sp := range shortPatterns {
+		if !strings.HasPrefix(p.text[p.pos+1:], sp.short) {
+			continue
+		}
+
+		node := &patternNode{start: p.pos, term: sp.long}
+		p.pos += len(sp.short) + 1
+		if sp.takesArg {
+			node.args = append(node.args, p.parseArgument(true))
+			node.haveArgs = true
+		}
+		node.end = p.pos
+
+		return node
+	}
+
+	p.fail(p.pos, len(p.text), "Unknown short pattern")
+	return nil
+}
+
+func isPatternTermChar(c byte) bool {
+	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '-'
+}
+
+func (p *patternParser) parsePattern() *patternNode {
+	if p.current() != '?' {
+		return nil
+	}
+
+	node := &patternNode{start: p.pos, end: p.pos}
+	p.pos++
+	for isPatternTermChar(p.current()) {
+		p.pos++
+	}
+
+	node.term = p.text[node.start:p.pos]
+	if len(node.term) <= 1 {
+		p.fail(node.start, node.end, "Pattern must have a term/name")
+	}
+
+	node.end = p.skipSpace()
+	if p.current() != '(' {
+		return node
+	}
+	p.pos++
+	node.end = p.pos
+	p.skipSpace()
+
+	node.haveArgs = true
+
+	if p.current() == ')' {
+		p.pos++
+		node.end = p.pos
+		return node
+	}
+
+	node.args = append(node.args, p.parseArgument(false))
+	p.skipSpace()
+	for p.current() == ',' {
+		p.pos++
+		p.skipSpace()
+		// trailing comma is allowed
+		if p.current() == ')' {
+			break
+		}
+		node.args = append(node.args, p.parseArgument(false))
+		p.skipSpace()
+	}
+
+	node.end = p.pos
+	if p.current() != ')' {
+		last := node
+		if len(node.args) > 0 {
+			last = node.args[len(node.args)-1]
+		}
+		p.fail(last.start, last.end, "Expected closing parenthesis or comma after last argument, received %c", p.current())
+	}
+	p.pos++
+	node.end = p.pos
+
+	return node
+}
+
+func (p *patternParser) parseQuotedWord() *patternNode {
+	if p.current() != '"' {
+		return nil
+	}
+
+	start := p.pos
+	p.pos++
+	for p.current() != '"' && p.current() != 0 {
+		p.pos++
+	}
+
+	if p.current() != '"' {
+		p.fail(start, start, "Could not find end of string")
+	}
+	p.pos++
+
+	return &patternNode{start: start, end: p.pos, isWord: true, word: p.text[start+1 : p.pos-1]}
+}
+
+func (p *patternParser) parseWord(short bool) *patternNode {
+	if strings.IndexByte(wordDisallowedStart, p.current()) != -1 {
+		return nil
+	}
+
+	disallowed := wordDisallowedLong
+	if short {
+		disallowed = wordDisallowedShort
+	}
+
+	start := p.pos
+	for strings.IndexByte(disallowed, p.current()) == -1 {
+		p.pos++
+	}
+
+	return &patternNode{start: start, end: p.pos, isWord: true, word: p.text[start:p.pos]}
+}
+
+// is checks that node is pattern with the given term and validates its arguments the way apt does,
+// max equal to -1 means any number of arguments
+func (n *patternNode) is(term string, min, max int) bool {
+	if n.term != term {
+		return false
+	}
+
+	fail := func(format string, args ...interface{}) {
+		panic(&patternError{start: n.start, end: n.end, message: fmt.Sprintf(format, args...)})
+	}
+
+	if max != 0 && !n.haveArgs {
+		fail("%s expects an argument list", term)
+	}
+	if max == 0 && n.haveArgs {
+		fail("%s does not expect an argument list", term)
+	}
+	if min >= 0 && min == max && len(n.args) != min {
+		fail("%s expects %d arguments, but received %d arguments", term, min, len(n.args))
+	}
+	if min >= 0 && len(n.args) < min {
+		fail("%s expects at least %d arguments, but received %d arguments", term, min, len(n.args))
+	}
+	if max >= 0 && len(n.args) > max {
+		fail("%s expects at most %d arguments, but received %d arguments", term, max, len(n.args))
+	}
+
+	return true
+}
+
+func expectWord(n *patternNode) string {
+	if !n.isWord {
+		panic(&patternError{start: n.start, end: n.end, message: "Expected a word"})
+	}
+	return n.word
+}
+
+func expectRegexp(n *patternNode) *posixRegexp {
+	re, err := compilePosixRegexp(expectWord(n))
+	if err != nil {
+		panic(&patternError{start: n.start, end: n.end, message: fmt.Sprintf("Regex compilation error - %s", err)})
+	}
+	return re
+}
+
+// compilePattern builds matcher out of parse tree, rejecting patterns apt doesn't know
+func compilePattern(n *patternNode) patternMatcher {
+	if n.isWord {
+		panic(&patternError{start: n.start, end: n.end, message: "Expected a pattern"})
+	}
+
+	switch {
+	case n.is("?architecture", 1, 1):
+		spec := expectWord(n.args[0])
+		return packageMatcher(func(p *patternPackage) bool { return architectureMatches(spec, p.arch) })
+	case n.is("?archive", 1, 1), n.is("?codename", 1, 1), n.is("?origin", 1, 1):
+		expectRegexp(n.args[0])
+		// release information isn't available for package lists
+		return versionMatcher(func(*patternVersion) bool { return false })
+	case n.is("?all-versions", 1, 1):
+		return &allVersionsMatcher{compilePattern(n.args[0])}
+	case n.is("?any-version", 1, 1):
+		return &anyVersionMatcher{compilePattern(n.args[0])}
+	case n.is("?automatic", 0, 0), n.is("?broken", 0, 0), n.is("?config-files", 0, 0), n.is("?garbage", 0, 0),
+		n.is("?installed", 0, 0), n.is("?obsolete", 0, 0), n.is("?upgradable", 0, 0):
+		// nothing is installed
+		return packageMatcher(func(*patternPackage) bool { return false })
+	}
+
+	for _, relation := range relationPatterns {
+		if n.is(relation.forward, 1, 1) {
+			return dependsMatcher(relation.kind, compilePattern(n.args[0]))
+		}
+		if n.is(relation.reverse, 1, 1) {
+			return reverseDependsMatcher(relation.kind, compilePattern(n.args[0]))
+		}
+	}
+
+	switch {
+	case n.is("?essential", 0, 0):
+		return packageMatcher(func(p *patternPackage) bool { return p.essential })
+	case n.is("?priority", 1, 1):
+		// apt compares the priority name exactly, it isn't a regular expression
+		priority := expectWord(n.args[0])
+		return versionMatcher(func(v *patternVersion) bool { return v.priority != "" && v.priority == priority })
+	case n.is("?exact-name", 1, 1):
+		// apt compares the name exactly, it isn't a regular expression
+		name := expectWord(n.args[0])
+		return packageMatcher(func(p *patternPackage) bool { return p.name == name })
+	case n.is("?false", 0, 0):
+		return constantMatcher(false)
+	case n.is("?name", 1, 1):
+		re := expectRegexp(n.args[0])
+		return packageMatcher(func(p *patternPackage) bool { return re.MatchString(p.name) })
+	case n.is("?not", 1, 1):
+		return &notMatcher{compilePattern(n.args[0])}
+	case n.is("?section", 1, 1):
+		re := expectRegexp(n.args[0])
+		return versionMatcher(func(v *patternVersion) bool { return v.section != "" && re.MatchString(v.section) })
+	case n.is("?source-package", 1, 1):
+		re := expectRegexp(n.args[0])
+		return versionMatcher(func(v *patternVersion) bool { return re.MatchString(v.sourceName) })
+	case n.is("?source-version", 1, 1):
+		re := expectRegexp(n.args[0])
+		return versionMatcher(func(v *patternVersion) bool { return re.MatchString(v.sourceVersion) })
+	case n.is("?true", 0, 0):
+		return constantMatcher(true)
+	case n.is("?version", 1, 1):
+		re := expectRegexp(n.args[0])
+		return versionMatcher(func(v *patternVersion) bool { return re.MatchString(v.version) })
+	case n.is("?virtual", 0, 0):
+		// as in apt, packages without versions are virtual, so are names only relationships refer to
+		return packageMatcher(func(p *patternPackage) bool { return len(p.versions) == 0 })
+	case n.is("?x-name-fnmatch", 1, 1):
+		glob := expectWord(n.args[0])
+		return packageMatcher(func(p *patternPackage) bool { return fnmatch(glob, p.name, true) })
+	case n.is("?and", 0, -1), n.is("?narrow", 0, -1):
+		matchers := make([]patternMatcher, len(n.args))
+		for i := range n.args {
+			matchers[i] = compilePattern(n.args[i])
+		}
+		if n.term == "?narrow" {
+			return &anyVersionMatcher{&andMatcher{matchers}}
+		}
+		return &andMatcher{matchers}
+	case n.is("?or", 0, -1):
+		matchers := make([]patternMatcher, len(n.args))
+		for i := range n.args {
+			matchers[i] = compilePattern(n.args[i])
+		}
+		return &orMatcher{matchers}
+	}
+
+	panic(&patternError{start: n.start, end: n.end, message: fmt.Sprintf("Unrecognized pattern '%s'", n.term)})
+}
+
+// parsePattern parses apt pattern into package query
+func parsePattern(text string) (q deb.PackageQuery, err error) {
+	node, err := parsePatternTree(text)
+	if err != nil {
+		return nil, fmt.Errorf("parsing failed: %s", err)
+	}
+
+	defer func() {
+		if r := recover(); r != nil {
+			e, ok := r.(*patternError)
+			if !ok {
+				panic(r)
+			}
+			q, err = nil, fmt.Errorf("parsing failed: %s", e)
+		}
+	}()
+
+	return &PatternQuery{Pattern: text, matcher: compilePattern(node)}, nil
+}
