+package query
+
+import (
+	"fmt"
+	"regexp"
+	"slices"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+// posixDupMax is the largest repeat count regcomp accepts
+const posixDupMax = 0x7fff
+
+type posixKind int
+
+const (
+	posixEmpty posixKind = iota
+	posixChar
+	posixSet
+	posixConcat
+	posixAlt
+	posixGroup
+	posixRepeat
+	posixBackref
+	posixBOL
+	posixEOL
+	posixWordBoundary
+	posixNotWordBoundary
+	posixWordStart
+	posixWordEnd
+)
+
+// posixNode is a node of parsed regular expression, repetitions with max equal to -1 have no upper limit
+type posixNode struct {
+	kind     posixKind
+	char     rune
+	set      *posixCharSet
+	children []*posixNode
+	min, max int
+	group    int
+}
+
+type posixError string
+
+func (e posixError) Error() string { return string(e) }
+
+const (
+	errPosixBadPattern = posixError("Invalid regular expression")
+	errPosixCollate    = posixError("Invalid collation character")
+	errPosixClass      = posixError("Invalid character class name")
+	errPosixEscape     = posixError("Trailing backslash")
+	errPosixSubreg     = posixError("Invalid back reference")
+	errPosixBracket    = posixError("Unmatched [, [^, [:, [., or [=")
+	errPosixParen      = posixError("Unmatched ( or \\(")
+	errPosixBrace      = posixError("Unmatched \\{")
+	errPosixBadBrace   = posixError("Invalid content of \\{\\}")
+	errPosixRange      = posixError("Invalid range end")
+	errPosixBadRepeat  = posixError("Invalid preceding regular expression")
+	errPosixSize       = posixError("Regular expression too big")
+)
+
+// posixByteBase marks a byte that isn't valid UTF-8: glibc reads it as a character of its own, here
+// posixByteBase plus the byte, beyond Unicode
+const posixByteBase = unicode.MaxRune + 1
+
+// posixChars splits s into characters the way glibc reads strings in the C.UTF-8 locale of the image
+func posixChars(s string) (chars []rune, sizes []int) {
+	for i := 0; i < len(s); {
+		c, size := utf8.DecodeRuneInString(s[i:])
+		if c == utf8.RuneError && size == 1 {
+			c = posixByteBase + rune(s[i])
+		}
+		chars = append(chars, c)
+		sizes = append(sizes, size)
+		i += size
+	}
+	return chars, sizes
+}
+
+// posixUpper upper-cases a character of the given size in bytes the way REG_ICASE does, leaving alone the bytes
+// that aren't valid UTF-8
+func posixUpper(c rune, size int) rune {
+	if size == 1 && c >= utf8.RuneSelf {
+		return c
+	}
+	return unicode.ToUpper(c)
+}
+
+// posixByteValue is the code of a one-byte character, the byte itself when it isn't valid UTF-8
+func posixByteValue(c rune) rune {
+	if c >= posixByteBase {
+		return c - posixByteBase
+	}
+	return c
+}
+
+func isPosixAlpha(c rune) bool {
+	// glibc counts the digits of other scripts as alphabetic, they can't be digits
+	return unicode.In(c, unicode.L, unicode.Nl, unicode.Other_Alphabetic) || c >= utf8.RuneSelf && unicode.Is(unicode.Nd, c)
+}
+
+func isPosixDigit(c rune) bool { return c >= '0' && c <= '9' }
+
+func isPosixAlnum(c rune) bool { return isPosixAlpha(c) || isPosixDigit(c) }
+
+func isPosixWordChar(c rune) bool { return c == '_' || isPosixAlnum(c) }
+
+// glibc doesn't count no-break spaces as spaces or blanks
+func isPosixBlank(c rune) bool {
+	return c == '\t' || unicode.Is(unicode.Zs, c) && c != '\u00a0' && c != '\u2007' && c != '\u202f'
+}
+
+func isPosixSpace(c rune) bool {
+	return c >= '\t' && c <= '\r' || isPosixBlank(c) || unicode.In(c, unicode.Zl, unicode.Zp)
+}
+
+func isPosixPrint(c rune) bool {
+	return unicode.In(c, unicode.L, unicode.M, unicode.N, unicode.P, unicode.S, unicode.Zs, unicode.Cf, unicode.Co)
+}
+
+func isPosixGraph(c rune) bool { return isPosixPrint(c) && !isPosixSpace(c) }
+
+// posixClasses are the character classes of the C.UTF-8 locale, defined by Unicode properties
+var posixClasses = map[string]func(c rune) bool{
+	"alnum":  isPosixAlnum,
+	"alpha":  isPosixAlpha,
+	"blank":  isPosixBlank,
+	"cntrl":  func(c rune) bool { return unicode.In(c, unicode.Cc, unicode.Zl, unicode.Zp) },
+	"digit":  isPosixDigit,
+	"graph":  isPosixGraph,
+	"lower":  unicode.IsLower,
+	"print":  isPosixPrint,
+	"punct":  func(c rune) bool { return isPosixGraph(c) && !isPosixAlnum(c) },
+	"space":  isPosixSpace,
+	"upper":  unicode.IsUpper,
+	"xdigit": func(c rune) bool { return isPosixDigit(c) || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F' },
+}
+
+// posixRange is a range of characters, both ends included
+type posixRange struct {
+	lo, hi rune
+}
+
+// posixCharSet is what bracket expression, dot or escape like \w matches: the characters in the ranges and the
+// classes, or every other character when negated
+type posixCharSet struct {
+	ranges  []posixRange
+	classes []func(c rune) bool
+	negate  bool
+}
+
+func (s *posixCharSet) has(c rune) bool {
+	// in glibc, only literal characters match a byte that isn't valid UTF-8
+	if c >= posixByteBase {
+		return false
+	}
+	in := slices.ContainsFunc(s.ranges, func(r posixRange) bool { return r.lo <= c && c <= r.hi }) ||
+		slices.ContainsFunc(s.classes, func(class func(rune) bool) bool { return class(c) })
+	return in != s.negate
+}
+
+// goSyntax writes the set as Go's character class, unless it has character classes: those of Go only cover ASCII
+func (s *posixCharSet) goSyntax() (string, bool) {
+	ranges := slices.DeleteFunc(slices.Clone(s.ranges), func(r posixRange) bool { return r.lo >= posixByteBase })
+	if len(s.classes) > 0 || len(ranges) == 0 {
+		return "", false
+	}
+	var b strings.Builder
+	b.WriteByte('[')
+	if s.negate {
+		b.WriteByte('^')
+	}
+	for _, r := range ranges {
+		fmt.Fprintf(&b, `\x{%x}-\x{%x}`, r.lo, r.hi)
+	}
+	b.WriteByte(']')
+	return b.String(), true
+}
+
+// posixParser parses POSIX extended regular expression the way glibc regcomp does with REG_ICASE in the C.UTF-8
+// locale: the expression is read upper-cased, except for the letters of GNU escapes like \w and character class
+// names
+type posixParser struct {
+	raw, upper []rune
+	sizes      []int
+	pos        int
+	nest       int
+	groups     int
+	completed  uint16
+	referenced uint16
+}
+
+func (p *posixParser) eof() bool { return p.pos >= len(p.raw) }
+
+func (p *posixParser) at(i int) rune {
+	if i < len(p.upper) {
+		return p.upper[i]
+	}
+	return 0
+}
+
+// width is the size in bytes of the upper-cased character at i
+func (p *posixParser) width(i int) int {
+	if p.sizes[i] == 1 {
+		return 1
+	}
+	return utf8.RuneLen(p.upper[i])
+}
+
+func (p *posixParser) parseAlternation() (*posixNode, error) {
+	initial := p.completed
+	branch, err := p.parseBranch()
+	if err != nil {
+		return nil, err
+	}
+	branches := []*posixNode{branch}
+	for !p.eof() && p.raw[p.pos] == '|' {
+		p.pos++
+		// groups of one alternative can't be referred to from another one
+		accumulated := p.completed
+		p.completed = initial
+		if branch, err = p.parseBranch(); err != nil {
+			return nil, err
+		}
+		p.completed |= accumulated
+		branches = append(branches, branch)
+	}
+	if len(branches) == 1 {
+		return branches[0], nil
+	}
+	return &posixNode{kind: posixAlt, children: branches}, nil
+}
+
+func (p *posixParser) parseBranch() (*posixNode, error) {
+	var items []*posixNode
+	// ')' closes a group, outside of one it is an ordinary character as in glibc, so apt accepts ?section(")")
+	for !p.eof() && p.raw[p.pos] != '|' && (p.raw[p.pos] != ')' || p.nest == 0) {
+		item, err := p.parseExpression()
+		if err != nil {
+			return nil, err
+		}
+		items = append(items, item)
+	}
+	switch len(items) {
+	case 0:
+		return &posixNode{kind: posixEmpty}, nil
+	case 1:
+		return items[0], nil
+	}
+	return &posixNode{kind: posixConcat, children: items}, nil
+}
+
+func (p *posixParser) parseExpression() (*posixNode, error) {
+	var atom *posixNode
+
+	switch c := p.raw[p.pos]; c {
+	case '*', '+', '?', '{':
+		return nil, errPosixBadRepeat
+	// as in glibc, ^ and $ are anchors wherever they appear (POSIX: "the ERE a^b is valid, but can never match"),
+	// only \^ and \$ match the characters; anchors can't be repeated, an operator after them starts a new expression
+	case '^':
+		p.pos++
+		return &posixNode{kind: posixBOL}, nil
+	case '$':
+		p.pos++
+		return &posixNode{kind: posixEOL}, nil
+	case '(':
+		var err error
+		if atom, err = p.parseGroup(); err != nil {
+			return nil, err
+		}
+	case '[':
+		var err error
+		if atom, err = p.parseBracket(); err != nil {
+			return nil, err
+		}
+	case '.':
+		p.pos++
+		atom = &posixNode{kind: posixSet, set: &posixCharSet{ranges: []posixRange{{1, unicode.MaxRune}}}}
+	case '\\':
+		if p.pos+1 == len(p.raw) {
+			return nil, errPosixEscape
+		}
+		escaped, upper := p.raw[p.pos+1], p.upper[p.pos+1]
+		p.pos += 2
+		switch escaped {
+		case '<':
+			return &posixNode{kind: posixWordStart}, nil
+		case '>':
+			return &posixNode{kind: posixWordEnd}, nil
+		case 'b':
+			return &posixNode{kind: posixWordBoundary}, nil
+		case 'B':
+			return &posixNode{kind: posixNotWordBoundary}, nil
+		case '`':
+			return &posixNode{kind: posixBOL}, nil
+		case '\'':
+			return &posixNode{kind: posixEOL}, nil
+		case 'w', 'W':
+			atom = &posixNode{kind: posixSet, set: &posixCharSet{classes: []func(rune) bool{isPosixWordChar}, negate: escaped == 'W'}}
+		case 's', 'S':
+			atom = &posixNode{kind: posixSet, set: &posixCharSet{classes: []func(rune) bool{isPosixSpace}, negate: escaped == 'S'}}
+		case '1', '2', '3', '4', '5', '6', '7', '8', '9':
+			group := int(escaped - '0')
+			if p.completed&(1<<group) == 0 {
+				return nil, errPosixSubreg
+			}
+			p.referenced |= 1 << group
+			atom = &posixNode{kind: posixBackref, group: group}
+		default:
+			atom = &posixNode{kind: posixChar, char: upper}
+		}
+	default:
+		atom = &posixNode{kind: posixChar, char: p.upper[p.pos]}
+		p.pos++
+	}
+
+	// as in glibc, an operator right after another repeats the repetition, so apt accepts a** as (a*)*
+	for !p.eof() {
+		lo, hi := 0, -1
+		switch p.raw[p.pos] {
+		case '*':
+			p.pos++
+		case '+':
+			p.pos++
+			lo = 1
+		case '?':
+			p.pos++
+			hi = 1
+		case '{':
+			var err error
+			if lo, hi, err = p.parseInterval(); err != nil {
+				return nil, err
+			}
+		default:
+			return atom, nil
+		}
+		atom = &posixNode{kind: posixRepeat, children: []*posixNode{atom}, min: lo, max: hi}
+	}
+	return atom, nil
+}
+
+func (p *posixParser) parseGroup() (*posixNode, error) {
+	p.pos++
+	p.nest++
+	p.groups++
+	group := p.groups
+
+	inner := &posixNode{kind: posixEmpty}
+	if !p.eof() && p.raw[p.pos] != ')' {
+		var err error
+		if inner, err = p.parseAlternation(); err != nil {
+			return nil, err
+		}
+	}
+	if p.eof() {
+		return nil, errPosixParen
+	}
+	p.pos++
+	p.nest--
+	if group <= 9 {
+		p.completed |= 1 << group
+	}
+	return &posixNode{kind: posixGroup, children: []*posixNode{inner}, group: group}, nil
+}
+
+// fetchNumber reads interval bound token by token up to ',' or '}', returning -1 when there are no digits
+// and -2 when there is anything else; escaped character stands for itself, except \1 to \9, which are
+// back references
+func (p *posixParser) fetchNumber() (num int, terminator rune) {
+	num = -1
+	for !p.eof() {
+		c := p.raw[p.pos]
+		p.pos++
+		closing, digit := c == '}', c >= '0' && c <= '9'
+		if c == '\\' && !p.eof() {
+			c = p.raw[p.pos]
+			p.pos++
+			closing, digit = false, c == '0'
+		}
+		switch {
+		case closing || c == ',':
+			return num, c
+		case !digit || num == -2:
+			num = -2
+		case num == -1:
+			num = int(c - '0')
+		default:
+			num = min(num*10+int(c-'0'), posixDupMax+1)
+		}
+	}
+	return -2, 0
+}
+
+func (p *posixParser) parseInterval() (lo, hi int, err error) {
+	p.pos++
+	lo, terminator := p.fetchNumber()
+	// glibc reads {,n} as {0,n}
+	if lo == -1 {
+		if terminator != ',' {
+			return 0, 0, errPosixBadBrace
+		}
+		lo = 0
+	}
+	hi = -2
+	if lo != -2 {
+		switch terminator {
+		case '}':
+			hi = lo
+		case ',':
+			hi, terminator = p.fetchNumber()
+		}
+	}
+	switch {
+	case (lo == -2 || hi == -2) && terminator == 0:
+		return 0, 0, errPosixBrace
+	case lo == -2 || hi == -2 || hi != -1 && lo > hi || terminator != '}':
+		return 0, 0, errPosixBadBrace
+	case max(lo, hi) > posixDupMax:
+		return 0, 0, errPosixSize
+	}
+	return lo, hi, nil
+}
+
+// posixBracketToken is token inside bracket expression: 'c' for character, '-', ']', '^',
+// '.', '=' and ':' for opening of collating symbol, equivalence class and character class, 0 for end
+type posixBracketToken struct {
+	kind   byte
+	char   rune
+	length int
+}
+
+// posixBracketElement is member of bracket expression: character or symbol named by the token kind, with its
+// size in bytes
+type posixBracketElement struct {
+	kind  byte
+	char  rune
+	name  []rune
+	width int
+}
+
+func (p *posixParser) peekBracket() posixBracketToken {
+	if p.eof() {
+		return posixBracketToken{}
+	}
+	c := p.at(p.pos)
+	if c == '[' {
+		switch next := p.at(p.pos + 1); next {
+		case '.', '=', ':':
+			return posixBracketToken{kind: byte(next), length: 2}
+		}
+	}
+	switch c {
+	case '-', ']', '^':
+		return posixBracketToken{kind: byte(c), char: c, length: 1}
+	}
+	return posixBracketToken{kind: 'c', char: c, length: 1}
+}
+
+func (p *posixParser) parseBracketElement(token posixBracketToken, acceptHyphen bool) (posixBracketElement, error) {
+	width := p.width(p.pos)
+	p.pos += token.length
+	switch token.kind {
+	case '.', '=', ':':
+		name, width, err := p.parseBracketSymbol(token.kind)
+		return posixBracketElement{kind: token.kind, name: name, width: width}, err
+	case '-':
+		if !acceptHyphen && p.peekBracket().kind != ']' {
+			return posixBracketElement{}, errPosixRange
+		}
+	}
+	return posixBracketElement{kind: 'c', char: token.char, width: width}, nil
+}
+
+// parseBracketSymbol reads the name of collating symbol, equivalence class or character class, which glibc
+// limits to 31 bytes
+func (p *posixParser) parseBracketSymbol(delim byte) ([]rune, int, error) {
+	if p.eof() {
+		return nil, 0, errPosixBracket
+	}
+	var name []rune
+	width := 0
+	for {
+		if width >= 32 {
+			return nil, 0, errPosixBracket
+		}
+		c, size := p.at(p.pos), p.width(p.pos)
+		if delim == ':' {
+			c, size = p.raw[p.pos], p.sizes[p.pos]
+		}
+		p.pos++
+		if p.eof() {
+			return nil, 0, errPosixBracket
+		}
+		if c == rune(delim) && p.at(p.pos) == ']' {
+			break
+		}
+		name = append(name, c)
+		width += size
+	}
+	p.pos++
+	return name, width, nil
+}
+
+// single is the character the element stands for; glibc only accepts collating symbols and equivalence classes
+// of one byte
+func (e posixBracketElement) single() (rune, bool) {
+	if e.kind == 'c' {
+		return e.char, true
+	}
+	if len(e.name) != 1 || e.width != 1 {
+		return 0, false
+	}
+	return e.name[0], true
+}
+
+func (e posixBracketElement) addTo(set *posixCharSet) error {
+	if e.kind == ':' {
+		name := string(e.name)
+		// with REG_ICASE glibc reads upper and lower as alpha
+		if name == "upper" || name == "lower" {
+			name = "alpha"
+		}
+		class, ok := posixClasses[name]
+		if !ok {
+			return errPosixClass
+		}
+		set.classes = append(set.classes, class)
+		return nil
+	}
+	c, ok := e.single()
+	if !ok {
+		return errPosixCollate
+	}
+	set.ranges = append(set.ranges, posixRange{c, c})
+	return nil
+}
+
+func addPosixRange(set *posixCharSet, start, end posixBracketElement) error {
+	if start.kind == ':' || start.kind == '=' || end.kind == ':' || end.kind == '=' {
+		return errPosixRange
+	}
+	from, fromOK := start.single()
+	to, toOK := end.single()
+	// in the C.UTF-8 locale only one-byte characters have a collation sequence value, the code of the byte
+	if !fromOK || !toOK || start.width != 1 || end.width != 1 {
+		return errPosixCollate
+	}
+	from, to = posixByteValue(from), posixByteValue(to)
+	if from > to {
+		return errPosixRange
+	}
+	set.ranges = append(set.ranges, posixRange{from, to})
+	return nil
+}
+
+func (p *posixParser) parseBracket() (*posixNode, error) {
+	p.pos++
+	set := &posixCharSet{}
+
+	token := p.peekBracket()
+	if token.kind == 0 {
+		return nil, errPosixBadPattern
+	}
+	set.negate = token.kind == '^'
+	if set.negate {
+		p.pos += token.length
+		if token = p.peekBracket(); token.kind == 0 {
+			return nil, errPosixBadPattern
+		}
+	}
+	if token.kind == ']' {
+		token.kind = 'c'
+	}
+
+	for first := true; ; first = false {
+		start, err := p.parseBracketElement(token, first)
+		if err != nil {
+			return nil, err
+		}
+		token = p.peekBracket()
+
+		var end *posixBracketElement
+		if start.kind != ':' && start.kind != '=' {
+			if token.kind == 0 {
+				return nil, errPosixBracket
+			}
+			if token.kind == '-' {
+				p.pos += token.length
+				switch next := p.peekBracket(); next.kind {
+				case 0:
+					return nil, errPosixBracket
+				case ']':
+					p.pos -= token.length
+					token.kind = 'c'
+				default:
+					element, err := p.parseBracketElement(next, true)
+					if err != nil {
+						return nil, err
+					}
+					end = &element
+					token = p.peekBracket()
+				}
+			}
+		}
+
+		if end != nil {
+			err = addPosixRange(set, start, *end)
+		} else {
+			err = start.addTo(set)
+		}
+		if err != nil {
+			return nil, err
+		}
+		if token.kind == 0 {
+			return nil, errPosixBracket
+		}
+		if token.kind == ']' {
+			break
+		}
+	}
+	p.pos += token.length
+
+	return &posixNode{kind: posixSet, set: set}, nil
+}
+
+// posixRegexp is regular expression compiled the way apt compiles them, with
+// regcomp(REG_EXTENDED | REG_ICASE | REG_NOSUB) in the C.UTF-8 locale of the image: POSIX extended syntax with
+// GNU extensions, matching anywhere in the string
+type posixRegexp struct {
+	root       *posixNode
+	referenced uint16
+	fast       *regexp.Regexp
+}
+
+func compilePosixRegexp(expr string) (*posixRegexp, error) {
+	raw, sizes := posixChars(expr)
+	upper := make([]rune, len(raw))
+	for i, c := range raw {
+		upper[i] = posixUpper(c, sizes[i])
+	}
+	p := &posixParser{raw: raw, upper: upper, sizes: sizes}
+	root, err := p.parseAlternation()
+	if err != nil {
+		return nil, err
+	}
+
+	re := &posixRegexp{root: root, referenced: p.referenced}
+	if syntax, ok := root.goSyntax(); ok {
+		re.fast, _ = regexp.Compile(syntax)
+	}
+	return re, nil
+}
+
+// goSyntax writes the expression for Go's regexp, which matches it the same way unless it has back
+// references, word anchors, character classes or huge repeat counts
+func (n *posixNode) goSyntax() (string, bool) {
+	switch n.kind {
+	case posixEmpty:
+		return "", true
+	case posixChar:
+		return regexp.QuoteMeta(string(n.char)), n.char < posixByteBase
+	case posixSet:
+		return n.set.goSyntax()
+	case posixConcat, posixAlt:
+		parts := make([]string, len(n.children))
+		for i, child := range n.children {
+			part, ok := child.goSyntax()
+			if !ok {
+				return "", false
+			}
+			parts[i] = part
+		}
+		if n.kind == posixAlt {
+			return "(?:" + strings.Join(parts, "|") + ")", true
+		}
+		return strings.Join(parts, ""), true
+	case posixGroup:
+		inner, ok := n.children[0].goSyntax()
+		return "(?:" + inner + ")", ok
+	case posixRepeat:
+		inner, ok := n.children[0].goSyntax()
+		if !ok || n.min > 1000 || n.max > 1000 {
+			return "", false
+		}
+		if n.max == -1 {
+			return fmt.Sprintf("(?:%s){%d,}", inner, n.min), true
+		}
+		return fmt.Sprintf("(?:%s){%d,%d}", inner, n.min, n.max), true
+	case posixBOL:
+		return `\A`, true
+	case posixEOL:
+		return `\z`, true
+	}
+	return "", false
+}
+
+// MatchString reports whether the expression matches anywhere in s
+func (re *posixRegexp) MatchString(s string) bool {
+	subject, sizes := posixChars(s)
+	for i, c := range subject {
+		subject[i] = posixUpper(c, sizes[i])
+	}
+
+	if re.fast != nil && !slices.ContainsFunc(subject, func(c rune) bool { return c >= posixByteBase }) {
+		return re.fast.MatchString(string(subject))
+	}
+
+	m := &posixMatcher{subject: subject, referenced: re.referenced, memo: make(map[posixMemoKey][]posixState)}
+	for start := 0; start <= len(subject); start++ {
+		if len(m.ends(re.root, posixState{pos: start})) > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+type posixCapture struct {
+	start, end int
+	set        bool
+}
+
+// posixState is position in the string with the groups matched so far that back references refer to
+type posixState struct {
+	pos    int
+	groups [10]posixCapture
+}
+
+type posixMemoKey struct {
+	node  *posixNode
+	state posixState
+}
+
+// posixMatcher matches expressions Go's regexp can't match, finding all the states each node can end in
+type posixMatcher struct {
+	subject    []rune
+	referenced uint16
+	memo       map[posixMemoKey][]posixState
+}
+
+func (m *posixMatcher) wordAt(i int) bool {
+	return i >= 0 && i < len(m.subject) && isPosixWordChar(posixByteValue(m.subject[i]))
+}
+
+func (m *posixMatcher) holds(kind posixKind, pos int) bool {
+	switch kind {
+	case posixBOL:
+		return pos == 0
+	case posixEOL:
+		return pos == len(m.subject)
+	case posixWordBoundary:
+		return m.wordAt(pos-1) != m.wordAt(pos)
+	case posixNotWordBoundary:
+		return m.wordAt(pos-1) == m.wordAt(pos)
+	case posixWordStart:
+		return !m.wordAt(pos-1) && m.wordAt(pos)
+	case posixWordEnd:
+		return m.wordAt(pos-1) && !m.wordAt(pos)
+	}
+	return false
+}
+
+func uniqueStates(states []posixState) []posixState {
+	var result []posixState
+	seen := make(map[posixState]bool, len(states))
+	for _, state := range states {
+		if !seen[state] {
+			seen[state] = true
+			result = append(result, state)
+		}
+	}
+	return result
+}
+
+func (m *posixMatcher) endsAll(n *posixNode, states []posixState) []posixState {
+	var result []posixState
+	for _, state := range states {
+		result = append(result, m.ends(n, state)...)
+	}
+	return uniqueStates(result)
+}
+
+func (m *posixMatcher) ends(n *posixNode, state posixState) []posixState {
+	key := posixMemoKey{node: n, state: state}
+	if result, ok := m.memo[key]; ok {
+		return result
+	}
+
+	var result []posixState
+	switch n.kind {
+	case posixEmpty:
+		result = []posixState{state}
+	case posixChar, posixSet:
+		if state.pos < len(m.subject) {
+			if c := m.subject[state.pos]; n.kind == posixChar && c == n.char || n.kind == posixSet && n.set.has(c) {
+				state.pos++
+				result = []posixState{state}
+			}
+		}
+	case posixConcat:
+		result = []posixState{state}
+		for _, child := range n.children {
+			result = m.endsAll(child, result)
+		}
+	case posixAlt:
+		for _, child := range n.children {
+			result = append(result, m.ends(child, state)...)
+		}
+		result = uniqueStates(result)
+	case posixGroup:
+		for _, end := range m.ends(n.children[0], state) {
+			if m.referenced&(1<<n.group) != 0 {
+				end.groups[n.group] = posixCapture{start: state.pos, end: end.pos, set: true}
+			}
+			result = append(result, end)
+		}
+	case posixRepeat:
+		level := []posixState{state}
+		seen := make(map[posixState]bool)
+		for count := 0; len(level) > 0; count++ {
+			if count >= n.min {
+				// states reached before can't lead anywhere new
+				var fresh []posixState
+				for _, s := range level {
+					if !seen[s] {
+						seen[s] = true
+						fresh = append(fresh, s)
+					}
+				}
+				result = append(result, fresh...)
+				level = fresh
+			}
+			if count == n.max {
+				break
+			}
+			level = m.endsAll(n.children[0], level)
+		}
+	case posixBackref:
+		group := state.groups[n.group]
+		end := state.pos + group.end - group.start
+		if group.set && end <= len(m.subject) && slices.Equal(m.subject[state.pos:end], m.subject[group.start:group.end]) {
+			state.pos = end
+			result = []posixState{state}
+		}
+	default:
+		if m.holds(n.kind, state.pos) {
+			result = []posixState{state}
+		}
+	}
+
+	m.memo[key] = result
+	return result
+}
