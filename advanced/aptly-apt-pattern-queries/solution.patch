+package query
+
+import (
+	"strings"
+	"sync"
+)
+
+// dpkg tuple table (/usr/share/dpkg/tupletable): <abi>-<libc>-<os>-<cpu> tuple and Debian architecture
+var dpkgTupleTable = [][2]string{
+	{"eabi-uclibc-linux-arm", "uclibc-linux-armel"},
+	{"base-uclibc-linux-<cpu>", "uclibc-linux-<cpu>"},
+	{"eabihf-musl-linux-arm", "musl-linux-armhf"},
+	{"base-musl-linux-<cpu>", "musl-linux-<cpu>"},
+	{"ilp32-gnu-linux-arm64", "arm64ilp32"},
+	{"eabihf-gnu-linux-arm", "armhf"},
+	{"eabi-gnu-linux-arm", "armel"},
+	{"abin32-gnu-linux-mips64r6el", "mipsn32r6el"},
+	{"abin32-gnu-linux-mips64r6", "mipsn32r6"},
+	{"abin32-gnu-linux-mips64el", "mipsn32el"},
+	{"abin32-gnu-linux-mips64", "mipsn32"},
+	{"abi64-gnu-linux-mips64r6el", "mips64r6el"},
+	{"abi64-gnu-linux-mips64r6", "mips64r6"},
+	{"abi64-gnu-linux-mips64el", "mips64el"},
+	{"abi64-gnu-linux-mips64", "mips64"},
+	{"spe-gnu-linux-powerpc", "powerpcspe"},
+	{"x32-gnu-linux-amd64", "x32"},
+	{"base-gnu-linux-<cpu>", "<cpu>"},
+	{"eabihf-gnu-kfreebsd-arm", "kfreebsd-armhf"},
+	{"base-gnu-kfreebsd-<cpu>", "kfreebsd-<cpu>"},
+	{"base-gnu-knetbsd-<cpu>", "knetbsd-<cpu>"},
+	{"base-gnu-kopensolaris-<cpu>", "kopensolaris-<cpu>"},
+	{"base-gnu-hurd-<cpu>", "hurd-<cpu>"},
+	{"base-bsd-dragonflybsd-<cpu>", "dragonflybsd-<cpu>"},
+	{"base-bsd-freebsd-<cpu>", "freebsd-<cpu>"},
+	{"base-bsd-openbsd-<cpu>", "openbsd-<cpu>"},
+	{"base-bsd-netbsd-<cpu>", "netbsd-<cpu>"},
+	{"base-bsd-darwin-<cpu>", "darwin-<cpu>"},
+	{"base-sysv-aix-<cpu>", "aix-<cpu>"},
+	{"base-sysv-solaris-<cpu>", "solaris-<cpu>"},
+	{"eabi-uclibc-uclinux-arm", "uclinux-armel"},
+	{"base-uclibc-uclinux-<cpu>", "uclinux-<cpu>"},
+	{"base-tos-mint-m68k", "mint-m68k"},
+}
+
+// dpkg cpu table (/usr/share/dpkg/cputable)
+var dpkgCPUs = []string{
+	"alpha", "amd64", "arc", "armeb", "arm", "arm64", "avr32", "hppa", "loong64", "i386", "ia64", "m32r", "m68k",
+	"mips", "mipsel", "mipsr6", "mipsr6el", "mips64", "mips64el", "mips64r6", "mips64r6el", "nios2", "or1k",
+	"powerpc", "powerpcel", "ppc64", "ppc64el", "riscv64", "s390", "s390x", "sh3", "sh3eb", "sh4", "sh4eb",
+	"sparc", "sparc64", "tilegx",
+}
+
+var (
+	archTuples     map[string][]string
+	archTuplesOnce sync.Once
+)
+
+func archToTuple(arch string) []string {
+	archTuplesOnce.Do(func() {
+		archTuples = make(map[string][]string)
+		add := func(arch, tuple string) {
+			if _, ok := archTuples[arch]; !ok {
+				archTuples[arch] = strings.Split(tuple, "-")
+			}
+		}
+		for _, row := range dpkgTupleTable {
+			if !strings.Contains(row[0], "<cpu>") && !strings.Contains(row[1], "<cpu>") {
+				add(row[1], row[0])
+				continue
+			}
+			for _, cpu := range dpkgCPUs {
+				add(strings.ReplaceAll(row[1], "<cpu>", cpu), strings.ReplaceAll(row[0], "<cpu>", cpu))
+			}
+		}
+	})
+
+	arch = strings.TrimPrefix(arch, "linux-")
+	return append([]string(nil), archTuples[arch]...)
+}
+
+func patternToTuple(arch string) []string {
+	tuple := strings.Split(arch, "-")
+	hasAny := false
+	for _, part := range tuple {
+		hasAny = hasAny || part == "any"
+	}
+	if hasAny || strings.ContainsRune(arch, '*') {
+		for len(tuple) < 4 {
+			tuple = append([]string{"any"}, tuple...)
+		}
+		return tuple
+	}
+	return archToTuple(arch)
+}
+
+// completeArch expands architecture or architecture wildcard to <abi>-<libc>-<os>-<cpu> form
+func completeArch(arch string, isPattern bool) string {
+	var tuple []string
+	if isPattern {
+		tuple = patternToTuple(arch)
+	} else {
+		tuple = archToTuple(arch)
+	}
+
+	if strings.HasSuffix(arch, "-") || strings.HasPrefix(arch, "-") {
+		return "invalid-invalid-invalid-invalid"
+	}
+
+	if len(tuple) == 0 {
+		// unknown architectures
+		tuple = strings.Split(arch, "-")
+		switch len(tuple) {
+		case 1:
+			tuple = append([]string{"base", "gnu", "linux"}, tuple...)
+		case 2:
+			tuple = append([]string{"base", "gnu"}, tuple...)
+		case 3:
+			tuple = append([]string{"base"}, tuple...)
+		}
+	}
+
+	for i := range tuple {
+		if tuple[i] == "any" {
+			tuple[i] = "*"
+		}
+	}
+	return strings.Join(tuple, "-")
+}
+
+// architectureMatches checks package architecture against architecture specification, which may use wildcards
+// like any, linux-any or any-amd64
+func architectureMatches(spec, arch string) bool {
+	complete := completeArch(spec, true)
+	if spec == arch || complete == arch {
+		return true
+	}
+	return fnmatch(complete, completeArch(arch, false), false)
+}
diff --git a/query/pattern_fnmatch.go b/query/pattern_fnmatch.go
new file mode 100644
index 00000000..d44372c5
--- /dev/null
+++ b/query/pattern_fnmatch.go
@@ -0,0 +1,321 @@
+package query
+
+import (
+	"unicode"
+	"unicode/utf8"
+)
+
+// fnmatchClassNameMax is CHARCLASS_NAME_MAX, the longest class name glibc's fnmatch reads
+const fnmatchClassNameMax = 2048
+
+// fnmatchUnknown is the collation sequence of the characters the C.UTF-8 locale doesn't order, those above U+00FF
+const fnmatchUnknown = ^uint32(0)
+
+// fnmatch matches name against shell pattern the way glibc's fnmatch does in the C.UTF-8 locale of the image,
+// ignoring case like FNM_CASEFOLD when caseFold is set: it compares characters, and when that doesn't match or
+// the strings aren't valid UTF-8, bytes
+func fnmatch(pattern, name string, caseFold bool) bool {
+	if utf8.ValidString(pattern) && utf8.ValidString(name) {
+		wide := fnmatcher{pattern: []rune(pattern), caseFold: caseFold, wide: true}
+		if wide.match([]rune(name)) {
+			return true
+		}
+	}
+	narrow := fnmatcher{pattern: fnmatchBytes(pattern), caseFold: caseFold}
+	return narrow.match(fnmatchBytes(name))
+}
+
+// fnmatchBytes takes every byte of s as a character
+func fnmatchBytes(s string) []rune {
+	chars := make([]rune, len(s))
+	for i := 0; i < len(s); i++ {
+		chars[i] = rune(s[i])
+	}
+	return chars
+}
+
+// fnmatcher is one of the two passes of fnmatch, over characters when wide, otherwise over bytes
+type fnmatcher struct {
+	pattern  []rune
+	caseFold bool
+	wide     bool
+}
+
+func (m *fnmatcher) at(i int) rune {
+	if i < len(m.pattern) {
+		return m.pattern[i]
+	}
+	return 0
+}
+
+func (m *fnmatcher) fold(c rune) rune {
+	if m.caseFold && (m.wide || c < utf8.RuneSelf) {
+		return unicode.ToLower(c)
+	}
+	return c
+}
+
+func (m *fnmatcher) collseq(c rune) uint32 {
+	if m.wide && c > 0xff {
+		return fnmatchUnknown
+	}
+	return uint32(c)
+}
+
+// match matches name, trying every longer stretch for the last '*' when the rest doesn't match
+func (m *fnmatcher) match(name []rune) bool {
+	p, n := 0, 0
+	star, starName := -1, 0
+	for p < len(m.pattern) || n < len(name) {
+		if p < len(m.pattern) && m.pattern[p] == '*' {
+			star, starName = p, n
+			p++
+			continue
+		}
+		if p < len(m.pattern) && n < len(name) {
+			if next, ok := m.element(p, name[n]); ok {
+				p, n = next, n+1
+				continue
+			}
+		}
+		if star < 0 || starName == len(name) {
+			return false
+		}
+		starName++
+		p, n = star+1, starName
+	}
+	return true
+}
+
+// element matches character c of the name against the pattern element at p, returning where the next one starts
+func (m *fnmatcher) element(p int, c rune) (int, bool) {
+	switch pc := m.fold(m.pattern[p]); pc {
+	case '?':
+		return p + 1, true
+	case '\\':
+		if p+1 == len(m.pattern) {
+			return 0, false
+		}
+		return p + 2, m.fold(m.pattern[p+1]) == m.fold(c)
+	case '[':
+		next, ok, unterminated := m.bracket(p+1, c)
+		if unterminated {
+			return p + 1, m.fold(c) == '['
+		}
+		return next, ok
+	default:
+		return p + 1, pc == m.fold(c)
+	}
+}
+
+// bracket matches c against the bracket expression with members from i, following glibc's fnmatch_loop.c; an
+// unterminated expression begins with an ordinary '['
+func (m *fnmatcher) bracket(i int, c rune) (next int, ok, unterminated bool) {
+	fc := m.fold(c)
+	not := m.at(i) == '!' || m.at(i) == '^'
+	if not {
+		i++
+	}
+	pc := m.at(i)
+	i++
+	for {
+		var low rune
+		member, canRange := false, false
+		switch {
+		case pc == '\\':
+			if m.at(i) == 0 {
+				return 0, false, false
+			}
+			pc, member = m.fold(m.at(i)), true
+			i++
+		case pc == '[' && m.at(i) == ':':
+			start := i
+			var name []rune
+			for !member {
+				if len(name) == fnmatchClassNameMax {
+					return 0, false, false
+				}
+				i++
+				pc = m.at(i)
+				if pc == ':' && m.at(i+1) == ']' {
+					i += 2
+					break
+				}
+				if pc < 'a' || pc >= 'z' {
+					// not a class name, the '[' is a member of its own
+					i, pc, member = start, '[', true
+					continue
+				}
+				name = append(name, pc)
+			}
+			if !member {
+				class, valid := posixClasses[string(name)]
+				if !valid {
+					return 0, false, false
+				}
+				if (m.wide || c < utf8.RuneSelf) && class(c) {
+					return m.skip(i, not)
+				}
+				pc = m.at(i)
+				i++
+			}
+		case pc == '[' && m.at(i) == '=':
+			start := i
+			equivalent := m.at(i + 1)
+			if equivalent == 0 || m.at(i+2) != '=' || m.at(i+3) != ']' {
+				i, pc, member = start, '[', true
+				break
+			}
+			i += 4
+			if c == equivalent {
+				return m.skip(i, not)
+			}
+			pc = m.at(i)
+			i++
+		case pc == 0:
+			return 0, false, true
+		case pc == '[' && m.at(i) == '.':
+			symbol, length, end := m.collatingSymbol(i)
+			if end < 0 {
+				return 0, false, false
+			}
+			i = end
+			isRange := m.at(i) == '-' && m.at(i+1) != 0
+			if length != 1 {
+				return 0, false, false
+			}
+			if !isRange && c == symbol {
+				return m.skip(i, not)
+			}
+			low, canRange = symbol, true
+			pc = m.at(i)
+			i++
+		default:
+			pc, member = m.fold(pc), true
+		}
+
+		if member {
+			isRange := m.at(i) == '-' && m.at(i+1) != 0 && m.at(i+1) != ']'
+			if !isRange && pc == fc {
+				return m.skip(i, not)
+			}
+			low, canRange = pc, true
+			pc = m.at(i)
+			i++
+		}
+
+		if canRange && pc == '-' && m.at(i) != ']' {
+			var matched bool
+			if i, matched, ok = m.rangeEnd(i, low, fc); !ok {
+				return 0, false, false
+			}
+			if matched {
+				return m.skip(i, not)
+			}
+			pc = m.at(i)
+			i++
+		}
+
+		if pc == ']' {
+			return i, not, false
+		}
+	}
+}
+
+// collatingSymbol reads [.x.] with i at its '.', returning the first character, the length and where it ends,
+// -1 when it isn't terminated
+func (m *fnmatcher) collatingSymbol(i int) (symbol rune, length, end int) {
+	start := i
+	for {
+		i++
+		if m.at(i) == '.' && m.at(i+1) == ']' {
+			return m.at(start + 1), i - start - 1, i + 2
+		}
+		if m.at(i) == 0 {
+			return 0, 0, -1
+		}
+	}
+}
+
+// rangeEnd reads the end of a range starting at low, with i at the character after '-', and tells whether fc is
+// in it; the C.UTF-8 locale only orders characters up to U+00FF, a range with an end above that matches nothing
+// but its start
+func (m *fnmatcher) rangeEnd(i int, low, fc rune) (next int, matched, ok bool) {
+	high := m.at(i)
+	i++
+	fseq := m.collseq(fc)
+	if fseq == fnmatchUnknown {
+		return i, false, true
+	}
+	lseq := m.collseq(low)
+	if high == '[' && m.at(i) == '.' {
+		symbol, length, end := m.collatingSymbol(i)
+		if end < 0 || length != 1 {
+			return 0, false, false
+		}
+		high, i = symbol, end
+	} else {
+		if high == '\\' {
+			high = m.at(i)
+			i++
+		}
+		if high == 0 {
+			return 0, false, false
+		}
+		high = m.fold(high)
+	}
+	if lseq == fnmatchUnknown || lseq <= fseq {
+		if hseq := m.collseq(high); hseq == fnmatchUnknown {
+			return i, lseq == fseq, true
+		} else if lseq <= hseq && fseq <= hseq {
+			return i, true, true
+		}
+	}
+	return i, false, true
+}
+
+// skip passes over the rest of a bracket expression with a matching member
+func (m *fnmatcher) skip(i int, not bool) (next int, ok, unterminated bool) {
+	for {
+		pc := m.at(i)
+		i++
+		switch {
+		case pc == ']':
+			return i, !not, false
+		case pc == 0:
+			return 0, false, true
+		case pc == '\\':
+			if m.at(i) == 0 {
+				return 0, false, false
+			}
+			i++
+		case pc == '[' && m.at(i) == ':':
+			start := i
+			for length := 1; ; length++ {
+				i++
+				if length == fnmatchClassNameMax {
+					return 0, false, false
+				}
+				if m.at(i) == ':' && m.at(i+1) == ']' {
+					break
+				}
+				if m.at(i) < 'a' || m.at(i) >= 'z' {
+					i = start - 2
+					break
+				}
+			}
+			i += 2
+		case pc == '[' && m.at(i) == '=':
+			if m.at(i+1) == 0 || m.at(i+2) != '=' || m.at(i+3) != ']' {
+				return 0, false, false
+			}
+			i += 4
+		case pc == '[' && m.at(i) == '.':
+			_, _, end := m.collatingSymbol(i)
+			if end < 0 {
+				return 0, false, false
+			}
+			i = end
+		}
+	}
+}
diff --git a/query/pattern_match.go b/query/pattern_match.go
new file mode 100644
index 00000000..501e1d3a
--- /dev/null
+++ b/query/pattern_match.go
@@ -0,0 +1,380 @@
+package query
+
+import (
+	"strings"
+
+	"github.com/aptly-dev/aptly/deb"
+)
+
+// patternNativeArch is the native architecture apt patterns are evaluated for:
+// packages with architecture "all" belong to it
+const patternNativeArch = "amd64"
+
+// relationship fields apt keeps for packages
+const (
+	relationPreDepends = iota
+	relationDepends
+	relationConflicts
+	relationBreaks
+	relationRecommends
+	relationSuggests
+	relationReplaces
+	relationEnhances
+	relationObsoletes
+)
+
+// fields apt reads relationships from in Debian packages: there is no Obsoletes field, so ?obsoletes and
+// ?reverse-obsoletes never match
+var relationFields = []struct {
+	field string
+	kind  int
+}{
+	{"Pre-Depends", relationPreDepends},
+	{"Depends", relationDepends},
+	{"Conflicts", relationConflicts},
+	{"Breaks", relationBreaks},
+	{"Recommends", relationRecommends},
+	{"Suggests", relationSuggests},
+	{"Replaces", relationReplaces},
+	{"Enhances", relationEnhances},
+}
+
+var patternPriorities = map[string]string{
+	"required":  "required",
+	"important": "important",
+	"standard":  "standard",
+	"optional":  "optional",
+	"extra":     "extra",
+}
+
+// patternPackage is a package the way apt sees it: name and architecture with all its versions,
+// packages without versions are virtual
+type patternPackage struct {
+	name, arch string
+	versions   []*patternVersion
+	essential  bool
+	// relationships of other packages pointing to this package
+	reverse []patternRelation
+}
+
+// patternVersion is a version of a package, one package from the list
+type patternVersion struct {
+	pkg                       *patternPackage
+	source                    deb.PackageLike
+	version                   string
+	section, priority         string
+	sourceName, sourceVersion string
+	relations                 []patternRelation
+}
+
+type patternRelation struct {
+	kind   int
+	from   *patternVersion
+	target *patternPackage
+}
+
+// patternUniverse is set of packages patterns are evaluated against
+type patternUniverse struct {
+	packages map[string]*patternPackage
+	real     []*patternPackage
+}
+
+func (u *patternUniverse) lookup(name, arch string) *patternPackage {
+	key := name + " " + arch
+	p, ok := u.packages[key]
+	if !ok {
+		p = &patternPackage{name: name, arch: arch}
+		u.packages[key] = p
+	}
+	return p
+}
+
+// patternArchitecture maps architecture of the package to apt package architecture
+func patternArchitecture(arch string) string {
+	if arch == deb.ArchitectureAll {
+		return patternNativeArch
+	}
+	return arch
+}
+
+// relationTarget finds package relationship atom points to for package of architecture arch: unqualified names
+// point to the same architecture, names with architecture qualifier are separate packages for apt
+func relationTarget(atom, arch string) (name, targetArch string) {
+	atom = strings.TrimSpace(atom)
+	if i := strings.IndexAny(atom, " \t\n([<"); i != -1 {
+		atom = atom[:i]
+	}
+
+	i := strings.LastIndexByte(atom, ':')
+	if i == -1 {
+		return atom, arch
+	}
+	if atom[i+1:] == "native" {
+		return atom[:i] + ":" + patternNativeArch, deb.ArchitectureAny
+	}
+	return atom, deb.ArchitectureAny
+}
+
+// parseSource splits Source field into source package name and version
+func parseSource(field, name, version string) (string, string) {
+	if field == "" {
+		return name, version
+	}
+	if i := strings.IndexByte(field, ' '); i != -1 {
+		if open := strings.IndexByte(field[i:], '('); open != -1 {
+			if end := strings.IndexByte(field[i+open:], ')'); end != -1 {
+				version = field[i+open+1 : i+open+end]
+			}
+		}
+		field = field[:i]
+	}
+	return field, version
+}
+
+func newPatternUniverse(packages []deb.PackageLike) *patternUniverse {
+	u := &patternUniverse{packages: make(map[string]*patternPackage)}
+
+	var versions []*patternVersion
+	for _, source := range packages {
+		if source.GetArchitecture() == deb.ArchitectureSource {
+			continue
+		}
+
+		p := u.lookup(source.GetName(), patternArchitecture(source.GetArchitecture()))
+		if len(p.versions) == 0 {
+			u.real = append(u.real, p)
+		}
+
+		v := &patternVersion{pkg: p, source: source, version: source.GetVersion(), section: source.GetField("Section")}
+		if priority := strings.TrimSpace(source.GetField("Priority")); priority != "" {
+			if v.priority = patternPriorities[strings.ToLower(priority)]; v.priority == "" {
+				// apt treats unknown priorities as extra
+				v.priority = "extra"
+			}
+		}
+		v.sourceName, v.sourceVersion = parseSource(source.GetField("Source"), source.GetName(), v.version)
+
+		switch strings.ToLower(strings.TrimSpace(source.GetField("Essential"))) {
+		case "yes":
+			p.essential = true
+		}
+		// apt always considers apt itself essential
+		if p.name == "apt" {
+			p.essential = true
+		}
+
+		p.versions = append(p.versions, v)
+		versions = append(versions, v)
+	}
+
+	for _, v := range versions {
+		for _, relation := range relationFields {
+			for _, group := range strings.Split(v.source.GetField(relation.field), ",") {
+				for _, atom := range strings.Split(group, "|") {
+					if strings.TrimSpace(atom) == "" {
+						continue
+					}
+					name, arch := relationTarget(atom, v.pkg.arch)
+					r := patternRelation{kind: relation.kind, from: v, target: u.lookup(name, arch)}
+					v.relations = append(v.relations, r)
+					r.target.reverse = append(r.target.reverse, r)
+				}
+			}
+		}
+	}
+
+	return u
+}
+
+// selected returns packages from the list selected by the matcher: all versions of every matching package
+func (u *patternUniverse) selected(m patternMatcher) map[deb.PackageLike]bool {
+	result := make(map[deb.PackageLike]bool)
+	for _, p := range u.real {
+		if m.matchPackage(p) {
+			for _, v := range p.versions {
+				result[v.source] = true
+			}
+		}
+	}
+	return result
+}
+
+// patternMatcher is compiled apt pattern, it could be applied to packages and to versions
+type patternMatcher interface {
+	matchPackage(p *patternPackage) bool
+	matchVersion(v *patternVersion) bool
+}
+
+type constantMatcher bool
+
+func (m constantMatcher) matchPackage(*patternPackage) bool { return bool(m) }
+func (m constantMatcher) matchVersion(*patternVersion) bool { return bool(m) }
+
+// packageMatcher looks at the package, version matches when its package matches
+type packageMatcher func(p *patternPackage) bool
+
+func (m packageMatcher) matchPackage(p *patternPackage) bool { return m(p) }
+func (m packageMatcher) matchVersion(v *patternVersion) bool { return m(v.pkg) }
+
+// versionMatcher looks at the version, package matches when any of its versions match
+type versionMatcher func(v *patternVersion) bool
+
+func (m versionMatcher) matchPackage(p *patternPackage) bool {
+	for _, v := range p.versions {
+		if m(v) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m versionMatcher) matchVersion(v *patternVersion) bool { return m(v) }
+
+type notMatcher struct{ m patternMatcher }
+
+func (m *notMatcher) matchPackage(p *patternPackage) bool { return !m.m.matchPackage(p) }
+func (m *notMatcher) matchVersion(v *patternVersion) bool { return !m.m.matchVersion(v) }
+
+type andMatcher struct{ matchers []patternMatcher }
+
+func (m *andMatcher) matchPackage(p *patternPackage) bool {
+	for _, matcher := range m.matchers {
+		if !matcher.matchPackage(p) {
+			return false
+		}
+	}
+	return true
+}
+
+func (m *andMatcher) matchVersion(v *patternVersion) bool {
+	for _, matcher := range m.matchers {
+		if !matcher.matchVersion(v) {
+			return false
+		}
+	}
+	return true
+}
+
+type orMatcher struct{ matchers []patternMatcher }
+
+func (m *orMatcher) matchPackage(p *patternPackage) bool {
+	for _, matcher := range m.matchers {
+		if matcher.matchPackage(p) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *orMatcher) matchVersion(v *patternVersion) bool {
+	for _, matcher := range m.matchers {
+		if matcher.matchVersion(v) {
+			return true
+		}
+	}
+	return false
+}
+
+// anyVersionMatcher matches package when some of its versions match
+type anyVersionMatcher struct{ m patternMatcher }
+
+func (m *anyVersionMatcher) matchPackage(p *patternPackage) bool {
+	for _, v := range p.versions {
+		if m.m.matchVersion(v) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *anyVersionMatcher) matchVersion(v *patternVersion) bool { return m.m.matchVersion(v) }
+
+// allVersionsMatcher matches package when every version of it matches
+type allVersionsMatcher struct{ m patternMatcher }
+
+func (m *allVersionsMatcher) matchPackage(p *patternPackage) bool {
+	for _, v := range p.versions {
+		if !m.m.matchVersion(v) {
+			return false
+		}
+	}
+	return true
+}
+
+func (m *allVersionsMatcher) matchVersion(v *patternVersion) bool { return m.m.matchVersion(v) }
+
+// dependsMatcher matches versions with relationship of the kind to a package matching m: like apt, it looks at the
+// package the relationship names, whatever its version constraint, and not at the packages providing it
+func dependsMatcher(kind int, m patternMatcher) patternMatcher {
+	return versionMatcher(func(v *patternVersion) bool {
+		for _, r := range v.relations {
+			if r.kind == kind && m.matchPackage(r.target) {
+				return true
+			}
+		}
+		return false
+	})
+}
+
+// reverseDependsMatcher matches packages some version matching m has relationship of the kind with
+func reverseDependsMatcher(kind int, m patternMatcher) patternMatcher {
+	return packageMatcher(func(p *patternPackage) bool {
+		for _, r := range p.reverse {
+			if r.kind == kind && m.matchVersion(r.from) {
+				return true
+			}
+		}
+		return false
+	})
+}
+
+// PatternQuery is package query written as apt pattern
+//
+// Pattern selects the packages `apt list --all-versions` would list for it with the queried packages
+// as the only source: every version of each matching package (name and architecture), never source packages
+type PatternQuery struct {
+	Pattern string
+	matcher patternMatcher
+}
+
+// packageSetQuery matches packages from the set
+type packageSetQuery struct {
+	set map[deb.PackageLike]bool
+}
+
+func (q *packageSetQuery) Matches(pkg deb.PackageLike) bool { return q.set[pkg] }
+
+func (q *packageSetQuery) Fast(_ deb.PackageCatalog) bool { return false }
+
+func (q *packageSetQuery) Query(list deb.PackageCatalog) *deb.PackageList { return list.Scan(q) }
+
+func (q *packageSetQuery) String() string { return "" }
+
+// Matches evaluates pattern for the package alone
+func (q *PatternQuery) Matches(pkg deb.PackageLike) bool {
+	return newPatternUniverse([]deb.PackageLike{pkg}).selected(q.matcher)[pkg]
+}
+
+// Fast is always true: pattern is evaluated against the whole list at once, so that it sees all
+// the versions and relationships
+func (q *PatternQuery) Fast(_ deb.PackageCatalog) bool {
+	return true
+}
+
+// Query evaluates pattern against all the packages of the list
+func (q *PatternQuery) Query(list deb.PackageCatalog) *deb.PackageList {
+	all := list.Scan(&deb.MatchAllQuery{})
+
+	packages := make([]deb.PackageLike, 0, all.Len())
+	_ = all.ForEach(func(p *deb.Package) error {
+		packages = append(packages, p)
+		return nil
+	})
+
+	return all.Scan(&packageSetQuery{set: newPatternUniverse(packages).selected(q.matcher)})
+}
+
+// String interface
+func (q *PatternQuery) String() string {
+	return q.Pattern
+}
