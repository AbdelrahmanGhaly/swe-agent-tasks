+func (e *aptlyEnv) snapshotKeys(name string) []string {
+	e.t.Helper()
+	return packageKeys(e.run("snapshot", "show", "-with-packages", name))
+}
+
+func (e *aptlyEnv) repoKeys(name string) []string {
+	e.t.Helper()
+	return packageKeys(e.run("repo", "show", "-with-packages", name))
+}
