+
+var (
+	aptlyBinary     string
+	aptlyBuildError error
+)
+
+func TestMain(m *testing.M) {
+	dir, err := os.MkdirTemp("", "aptly-pattern-queries")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	aptlyBinary = filepath.Join(dir, "aptly")
+	if out, err := exec.Command("go", "build", "-o", aptlyBinary, "..").CombinedOutput(); err != nil {
+		aptlyBuildError = fmt.Errorf("%v\n%s", err, out)
+	}
+	code := m.Run()
+	_ = os.RemoveAll(dir)
+	os.Exit(code)
+}
+
+type aptlyEnv struct {
+	t      *testing.T
+	dir    string
+	config string
+}
+
+func newAptlyEnv(t *testing.T) *aptlyEnv {
+	t.Helper()
+	if aptlyBuildError != nil {
+		t.Fatalf("unable to build aptly: %s", aptlyBuildError)
+	}
+	dir := t.TempDir()
+	config := filepath.Join(dir, "aptly.conf")
+	content := fmt.Sprintf("{\"rootDir\": %q, \"architectures\": []}\n", filepath.Join(dir, "root"))
+	if err := os.WriteFile(config, []byte(content), 0644); err != nil {
+		t.Fatal(err)
+	}
+	return &aptlyEnv{t: t, dir: dir, config: config}
+}
+
+func (e *aptlyEnv) exec(args ...string) (string, string, error) {
+	cmd := exec.Command(aptlyBinary, append([]string{"-config=" + e.config}, args...)...)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	err := cmd.Run()
+	return stdout.String(), stderr.String(), err
+}
+
+func (e *aptlyEnv) run(args ...string) string {
+	e.t.Helper()
+	stdout, stderr, err := e.exec(args...)
+	if err != nil {
+		e.t.Fatalf("aptly %s: %v\nstdout:\n%s\nstderr:\n%s", strings.Join(args, " "), err, stdout, stderr)
+	}
+	return stdout
+}
+
+func splitStanzas(text string) []string {
+	var stanzas []string
+	for _, block := range strings.Split(strings.TrimSpace(text), "\n\n") {
+		if block = strings.TrimSpace(block); block != "" {
+			stanzas = append(stanzas, block+"\n")
+		}
+	}
+	return stanzas
+}
+
+func stanzaField(stanza, field string) string {
+	for _, line := range strings.Split(stanza, "\n") {
+		if strings.HasPrefix(line, field+": ") {
+			return strings.TrimPrefix(line, field+": ")
+		}
+	}
+	return ""
+}
+
+func tarGz(t *testing.T, files map[string]string) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	gz := gzip.NewWriter(&buf)
+	tw := tar.NewWriter(gz)
+	names := make([]string, 0, len(files))
+	for name := range files {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		if err := tw.WriteHeader(&tar.Header{Name: name, Mode: 0644, Size: int64(len(files[name]))}); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := tw.Write([]byte(files[name])); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := tw.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := gz.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
+
+func writeDeb(t *testing.T, path, control string) {
+	t.Helper()
+	var buf bytes.Buffer
+	buf.WriteString("!<arch>\n")
+	members := []struct {
+		name    string
+		content []byte
+	}{
+		{"debian-binary", []byte("2.0\n")},
+		{"control.tar.gz", tarGz(t, map[string]string{"./control": control})},
+		{"data.tar.gz", tarGz(t, nil)},
+	}
+	for _, member := range members {
+		fmt.Fprintf(&buf, "%-16s%-12d%-6d%-6d%-8s%-10d`\n", member.name, 0, 0, 0, "100644", len(member.content))
+		buf.Write(member.content)
+		if len(member.content)%2 == 1 {
+			buf.WriteByte('\n')
+		}
+	}
+	if err := os.WriteFile(path, buf.Bytes(), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func writeDsc(t *testing.T, dir, name, version string) {
+	t.Helper()
+	tarball := name + "_" + version + ".tar.gz"
+	content := tarGz(t, map[string]string{name + "/README": "source\n"})
+	if err := os.WriteFile(filepath.Join(dir, tarball), content, 0644); err != nil {
+		t.Fatal(err)
+	}
+	dsc := fmt.Sprintf("Format: 3.0 (native)\nSource: %s\nBinary: %s\nArchitecture: any\nVersion: %s\n"+
+		"Maintainer: Test <test@example.com>\nChecksums-Sha256:\n %x %d %s\nFiles:\n %x %d %s\n",
+		name, name, version, sha256.Sum256(content), len(content), tarball, md5.Sum(content), len(content), tarball)
+	if err := os.WriteFile(filepath.Join(dir, name+"_"+version+".dsc"), []byte(dsc), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func (e *aptlyEnv) packages(name, stanzas string, sources ...string) string {
+	e.t.Helper()
+	dir := filepath.Join(e.dir, "packages-"+name)
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		e.t.Fatal(err)
+	}
+	for _, stanza := range splitStanzas(stanzas) {
+		if stanzaField(stanza, "Maintainer") == "" {
+			stanza += "Maintainer: Test <test@example.com>\n"
+		}
+		if stanzaField(stanza, "Description") == "" {
+			stanza += "Description: test package\n"
+		}
+		file := fmt.Sprintf("%s_%s_%s.deb", stanzaField(stanza, "Package"), strings.ReplaceAll(stanzaField(stanza, "Version"), ":", "%3a"), stanzaField(stanza, "Architecture"))
+		writeDeb(e.t, filepath.Join(dir, file), stanza)
+	}
+	for _, source := range sources {
+		parts := strings.SplitN(source, "_", 2)
+		writeDsc(e.t, dir, parts[0], parts[1])
+	}
+	return dir
+}
+
+func (e *aptlyEnv) repo(name, stanzas string, sources ...string) {
+	e.t.Helper()
+	e.run("repo", "create", name)
+	e.run("repo", "add", name, e.packages(name, stanzas, sources...))
+}
+
+func (e *aptlyEnv) snapshot(name, stanzas string, sources ...string) {
+	e.t.Helper()
+	e.repo(name, stanzas, sources...)
+	e.run("snapshot", "create", name, "from", "repo", name)
+}
+
+var packageKeyLine = regexp.MustCompile(`^[a-z0-9][a-z0-9+.:-]*_[^_\s]+_[a-z0-9-]+$`)
+
+func packageKeys(output string) []string {
+	keys := []string{}
+	for _, line := range strings.Split(output, "\n") {
+		if line = strings.TrimSpace(line); packageKeyLine.MatchString(line) {
+			keys = append(keys, line)
+		}
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func (e *aptlyEnv) search(args ...string) []string {
+	e.t.Helper()
+	stdout, stderr, err := e.exec(args...)
+	if err != nil {
+		if strings.Contains(stderr, "no results") {
+			return []string{}
+		}
+		e.t.Fatalf("aptly %s: %v\nstdout:\n%s\nstderr:\n%s", strings.Join(args, " "), err, stdout, stderr)
+	}
+	return packageKeys(stdout)
+}
+
+func assertKeys(t *testing.T, what string, got []string, want ...string) {
+	t.Helper()
+	sorted := append([]string{}, want...)
+	sort.Strings(sorted)
+	if len(sorted) == 0 {
+		sorted = []string{}
+	}
+	if !reflect.DeepEqual(got, sorted) {
+		t.Errorf("%s:\n got %q\nwant %q", what, got, sorted)
+	}
+}
+
+func (e *aptlyEnv) assertFails(args ...string) {
+	e.t.Helper()
+	stdout, stderr, err := e.exec(args...)
+	if err == nil {
+		e.t.Errorf("aptly %s succeeded, expected an error\nstdout:\n%s", strings.Join(args, " "), stdout)
+		return
+	}
+	if !strings.Contains(stderr, "ERROR") {
+		e.t.Errorf("aptly %s: expected an error message\nstdout:\n%s\nstderr:\n%s", strings.Join(args, " "), stdout, stderr)
+	}
+}
+
+type patternCase struct {
+	pattern string
+	want    []string
+}
+
+type patternSuite struct {
+	packages string
+	sources  []string
+	cases    []patternCase
+}
+
+func (s patternSuite) check(t *testing.T) {
+	t.Helper()
+	e := newAptlyEnv(t)
+	e.repo("main", s.packages, s.sources...)
+	for _, c := range s.cases {
+		assertKeys(t, "repo search "+c.pattern, e.search("repo", "search", "main", c.pattern), c.want...)
+	}
+}
