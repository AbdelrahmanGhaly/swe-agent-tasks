+func showKeys(output string) []string {
+	keys := []string{}
+	for _, stanza := range splitStanzas(output) {
+		if name := stanzaField(stanza, "Package"); name != "" {
+			keys = append(keys, name+"_"+stanzaField(stanza, "Version")+"_"+stanzaField(stanza, "Architecture"))
+		}
+	}
+	sort.Strings(keys)
+	return keys
+}
