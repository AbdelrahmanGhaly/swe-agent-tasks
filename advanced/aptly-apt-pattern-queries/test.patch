+type archiveRand struct{ state uint64 }
+
+func (r *archiveRand) next() uint64 {
+	r.state += 0x9E3779B97F4A7C15
+	z := r.state
+	z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
+	z = (z ^ (z >> 27)) * 0x94D049BB133111EB
+	return z ^ (z >> 31)
+}
+
+func (r *archiveRand) intn(n int) int { return int(r.next() % uint64(n)) }
+
+func (r *archiveRand) chance(percent int) bool { return r.intn(100) < percent }
+
+func (r *archiveRand) pick(choices ...string) string { return choices[r.intn(len(choices))] }
+
+var randomVersions = []string{"1.0", "1.0-1", "1.2", "1.2~rc1", "2.0", "2.0+b1", "1:0.5", "0.9", "3"}
+
+type randomArchive struct {
+	stanzas  string
+	names    []string
+	virtuals []string
+}
+
+func generateArchive(seed uint64) randomArchive {
+	r := &archiveRand{state: seed}
+	var archive randomArchive
+	for i := 4 + r.intn(5); i > 0; i-- {
+		archive.names = append(archive.names, fmt.Sprintf("p%d", len(archive.names)))
+	}
+	for i := 1 + r.intn(2); i > 0; i-- {
+		archive.virtuals = append(archive.virtuals, fmt.Sprintf("v%d", len(archive.virtuals)))
+	}
+	type planned struct{ name, version, arch string }
+	var plan []planned
+	present := map[string][]string{}
+	group := func(arch string) string {
+		if arch == "all" {
+			return "amd64"
+		}
+		return arch
+	}
+	for _, name := range archive.names {
+		seen := map[string]bool{}
+		for i := 1 + r.intn(3); i > 0; i-- {
+			version := randomVersions[r.intn(len(randomVersions))]
+			archs := []string{"all"}
+			if !r.chance(20) {
+				archs = nil
+				for _, arch := range []string{"amd64", "i386", "arm64", "armhf"} {
+					if r.chance(40) {
+						archs = append(archs, arch)
+					}
+				}
+				if len(archs) == 0 {
+					archs = []string{r.pick("amd64", "i386")}
+				}
+			}
+			for _, arch := range archs {
+				if seen[version+arch] {
+					continue
+				}
+				seen[version+arch] = true
+				plan = append(plan, planned{name, version, arch})
+				if names := present[group(arch)]; len(names) == 0 || names[len(names)-1] != name {
+					present[group(arch)] = append(names, name)
+				}
+			}
+		}
+	}
+	constraint := func() string {
+		if r.chance(30) {
+			return fmt.Sprintf(" (%s %s)", r.pick("<<", "<=", "=", ">=", ">>"), randomVersions[r.intn(len(randomVersions))])
+		}
+		return ""
+	}
+	target := func() string {
+		switch x := r.intn(100); {
+		case x < 65:
+			return archive.names[r.intn(len(archive.names))]
+		case x < 90:
+			return archive.virtuals[r.intn(len(archive.virtuals))]
+		default:
+			return "missing"
+		}
+	}
+	relation := func(arch string, negative bool) string {
+		var groups []string
+		for i := 1 + r.intn(2); i > 0; i-- {
+			if negative {
+				names := present[group(arch)]
+				groups = append(groups, names[r.intn(len(names))]+constraint())
+				continue
+			}
+			atoms := []string{target() + constraint()}
+			if r.chance(25) {
+				atoms = append(atoms, target()+constraint())
+			}
+			groups = append(groups, strings.Join(atoms, " | "))
+		}
+		return strings.Join(groups, ", ")
+	}
+	var stanzas []string
+	for _, p := range plan {
+		s := fmt.Sprintf("Package: %s\nVersion: %s\nArchitecture: %s\n", p.name, p.version, p.arch)
+		if r.chance(70) {
+			s += "Section: " + r.pick("libs", "utils", "admin", "non-free/net") + "\n"
+		}
+		if r.chance(70) {
+			s += "Priority: " + r.pick("required", "important", "standard", "optional", "extra") + "\n"
+		}
+		if r.chance(8) {
+			s += "Essential: yes\n"
+		}
+		switch r.intn(4) {
+		case 1:
+			s += fmt.Sprintf("Source: s%d\n", r.intn(3))
+		case 2:
+			s += fmt.Sprintf("Source: s%d (%s)\n", r.intn(3), randomVersions[r.intn(len(randomVersions))])
+		}
+		for _, field := range []struct {
+			name     string
+			percent  int
+			negative bool
+		}{{"Pre-Depends", 15, false}, {"Depends", 50, false}, {"Recommends", 25, false}, {"Suggests", 15, false},
+			{"Conflicts", 20, true}, {"Breaks", 15, true}, {"Replaces", 10, true}, {"Enhances", 10, false}} {
+			if r.chance(field.percent) {
+				s += field.name + ": " + relation(p.arch, field.negative) + "\n"
+			}
+		}
+		if r.chance(20) {
+			s += "Provides: " + archive.virtuals[r.intn(len(archive.virtuals))] + "\n"
+		}
+		stanzas = append(stanzas, s)
+	}
+	archive.stanzas = strings.Join(stanzas, "\n")
+	return archive
+}
