+func (e *aptlyEnv) serveAPI() *http.Client {
+	e.t.Helper()
+	socket := filepath.Join(e.dir, "api.sock")
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: socket, Net: "unix"})
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	listener.SetUnlinkOnClose(false)
+	file, err := listener.File()
+	_ = listener.Close()
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	log, err := os.Create(filepath.Join(e.dir, "api.log"))
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	cmd := exec.Command("sh", "-c", `LISTEN_PID=$$ LISTEN_FDS=1 exec "$0" "$@"`, aptlyBinary, "-config="+e.config, "api", "serve")
+	cmd.ExtraFiles = []*os.File{file}
+	cmd.Stdout, cmd.Stderr = log, log
+	err = cmd.Start()
+	_ = file.Close()
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	e.t.Cleanup(func() {
+		_ = cmd.Process.Kill()
+		_ = cmd.Wait()
+		_ = log.Close()
+	})
+	return &http.Client{Transport: &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "unix", socket)
+	}}}
+}
+
+func (e *aptlyEnv) apiSearch(client *http.Client, path, query string) ([]string, int) {
+	e.t.Helper()
+	resp, err := client.Get("http://aptly" + path + "?format=details&q=" + url.QueryEscape(query))
+	if err != nil {
+		output, _ := os.ReadFile(filepath.Join(e.dir, "api.log"))
+		e.t.Fatalf("GET %s: %v\n%s", path, err, output)
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusOK {
+		return nil, resp.StatusCode
+	}
+	var packages []map[string]string
+	if err := json.NewDecoder(resp.Body).Decode(&packages); err != nil {
+		e.t.Fatal(err)
+	}
+	keys := []string{}
+	for _, p := range packages {
+		keys = append(keys, p["Package"]+"_"+p["Version"]+"_"+p["Architecture"])
+	}
+	sort.Strings(keys)
+	return keys, resp.StatusCode
+}
