+func (e *aptlyEnv) serveArchive(stanzas string) string {
+	e.t.Helper()
+	root := filepath.Join(e.dir, "archive")
+	indexes := map[string][]string{}
+	for _, stanza := range splitStanzas(stanzas) {
+		name, version, arch := stanzaField(stanza, "Package"), stanzaField(stanza, "Version"), stanzaField(stanza, "Architecture")
+		file := fmt.Sprintf("pool/main/%s_%s_%s.deb", name, version, arch)
+		if err := os.MkdirAll(filepath.Join(root, "pool", "main"), 0755); err != nil {
+			e.t.Fatal(err)
+		}
+		writeDeb(e.t, filepath.Join(root, file), stanza+"Maintainer: Test <test@example.com>\nDescription: test package\n")
+		content, err := os.ReadFile(filepath.Join(root, file))
+		if err != nil {
+			e.t.Fatal(err)
+		}
+		entry := fmt.Sprintf("%sMaintainer: Test <test@example.com>\nDescription: test package\nFilename: %s\nSize: %d\nMD5sum: %x\nSHA1: %x\nSHA256: %x\n",
+			stanza, file, len(content), md5.Sum(content), sha1.Sum(content), sha256.Sum256(content))
+		for _, index := range []string{"amd64", "i386"} {
+			if arch == index || arch == "all" {
+				indexes[index] = append(indexes[index], entry)
+			}
+		}
+	}
+	release := "Origin: test\nLabel: test\nSuite: test\nCodename: test\nArchitectures: amd64 i386\nComponents: main\n"
+	sums := map[string][]string{}
+	for _, index := range []string{"amd64", "i386"} {
+		path := "main/binary-" + index + "/Packages"
+		content := []byte(strings.Join(indexes[index], "\n"))
+		if err := os.MkdirAll(filepath.Join(root, "dists", "test", "main", "binary-"+index), 0755); err != nil {
+			e.t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(root, "dists", "test", path), content, 0644); err != nil {
+			e.t.Fatal(err)
+		}
+		sums["MD5Sum"] = append(sums["MD5Sum"], fmt.Sprintf(" %x %d %s", md5.Sum(content), len(content), path))
+		sums["SHA1"] = append(sums["SHA1"], fmt.Sprintf(" %x %d %s", sha1.Sum(content), len(content), path))
+		sums["SHA256"] = append(sums["SHA256"], fmt.Sprintf(" %x %d %s", sha256.Sum256(content), len(content), path))
+	}
+	for _, kind := range []string{"MD5Sum", "SHA1", "SHA256"} {
+		release += kind + ":\n" + strings.Join(sums[kind], "\n") + "\n"
+	}
+	if err := os.WriteFile(filepath.Join(root, "dists", "test", "Release"), []byte(release), 0644); err != nil {
+		e.t.Fatal(err)
+	}
+	server := httptest.NewServer(http.FileServer(http.Dir(root)))
+	e.t.Cleanup(server.Close)
+	return server.URL + "/"
+}
