+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      [ -n "$OUTPUT_PATH" ] || { echo "missing value for --output_path" >&2; usage; }
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")" || exit 2
+
+export GOFLAGS=-buildvcs=false
+export GOTOOLCHAIN=local
+if [ -n "${GOCACHE:-}" ] && [ ! -w "$GOCACHE" ]; then
+  export GOCACHE="/tmp/go-build-$(id -u)"
+fi
+
+NEW_DIR="cmds/exp/ed/gnucompat_13639a"
+NEW_PKG="github.com/u-root/u-root/$NEW_DIR"
+LOG="$(mktemp)"
+LISTERR="$(mktemp)"
+trap 'rm -f "$LOG" "$LISTERR"' EXIT
+LIST_STATUS=0
+
+if [ "$MODE" = "base" ]; then
+  # The baseline is the commands under cmds/exp, the tree cmds/exp/ed belongs to.
+  # Nothing else in the module imports cmds/exp/ed or pkg/bre, and building and
+  # running every test package in u-root takes over ten minutes on a slow
+  # machine. cmds/exp/ed itself is checked from outside, by the package
+  # cmds/exp/ed/edits_13639a: TestEditScriptsWriteExpectedFiles builds ed and
+  # runs 33 edit scripts whose results are the same before and after this
+  # change. Tests built inside cmds/exp/ed cannot be in the baseline. The change
+  # replaces that package's tests: address_test.go and filebuffer_test.go test
+  # the FileBuffer type it removes, and TestEdCommandsNonInput expects the old
+  # ed's own output ("exit" after q), which GNU ed parity contradicts. The
+  # replacements exist only after the change, but every baseline test has to
+  # exist and pass on both sides; and because the original test files no longer
+  # compile against the new code, a baseline test built in that package would
+  # pass or fail with the change's test files instead of its code.
+  # cmds/exp/ssh is left out: its tests look up the current user, which fails
+  # when the tests run under a uid that has no entry in /etc/passwd.
+  MOD="github.com/u-root/u-root"
+  ALL_PKGS="$(go list ./cmds/exp/... 2>"$LISTERR")"
+  LIST_STATUS=$?
+  cat "$LISTERR" >>"$LOG"
+  PKGS="$(printf '%s\n' "$ALL_PKGS" | grep -v -x -e "$MOD/cmds/exp/ed" -e "$NEW_PKG" -e "$MOD/cmds/exp/ssh")"
+  go test -v -count=1 -timeout 5m $PKGS >>"$LOG" 2>&1
+  STATUS=$?
+  [ "$STATUS" -eq 0 ] && STATUS=$LIST_STATUS
+else
+  go test -v -count=1 -timeout 8m "./$NEW_DIR/" >>"$LOG" 2>&1
+  STATUS=$?
+fi
+
+if ! grep -qE '^ *--- (PASS|FAIL|SKIP):' "$LOG"; then
+  echo "no tests were collected in mode $MODE" >>"$LOG"
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+cat "$LOG"
+
+expected_tests() {
+  grep -ho '^func Test[A-Za-z0-9_]*(t \*testing\.T)' "$NEW_DIR"/*_test.go | sed -e 's/^func //' -e 's/(.*//'
+}
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  # Some tests print boot configs whose comment lines start with "# ", which
+  # go-junit-report would take for build output; only package headers keep it.
+  sed -E '/^# (github\.com\/|command-line-arguments)/!s/^# /  # /' "$LOG" | go-junit-report >"$OUTPUT_PATH" 2>/dev/null || true
+  # A test that panics is reported as "--- FAIL: TestX" right before the
+  # "panic:" line, and go-junit-report leaves the panic text out of TestX, so it
+  # is copied in. A timeout names the running test under "running tests:"
+  # instead and go-junit-report already fails that test, so nothing is copied.
+  PANICKED="$(awk '
+    /^--- FAIL: / { name = $3; next }
+    /^ +--- FAIL: / { next }
+    /^panic: test timed out/ { exit }
+    /^panic: / { print name; exit }
+    { name = "" }
+  ' "$LOG")"
+  TIMED_OUT="$(awk '
+    /^panic: test timed out/ { t = 1; next }
+    t && /running tests:/ { r = 1; next }
+    r && /^[ \t]+[^ \t]/ { sub(/^[ \t]+/, ""); sub(/ \([^)]*\)$/, ""); last = $0; next }
+    r { exit }
+    END { if (last != "") print last }
+  ' "$LOG")"
+  if [ -n "$PANICKED" ] && grep -q "<testcase name=\"$PANICKED\"" "$OUTPUT_PATH" 2>/dev/null; then
+    PANIC_TEXT="$(mktemp)"
+    PATCHED="$(mktemp)"
+    sed -n '/^panic: /,$p' "$LOG" | head -n 40 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' >"$PANIC_TEXT"
+    awk -v name="$PANICKED" -v text="$PANIC_TEXT" '
+      index($0, "<testcase name=\"" name "\"") { inside = 1 }
+      inside && /<failure message="Failed"><\/failure>/ {
+        sub(/<failure message="Failed"><\/failure>/, "<failure message=\"panic\">")
+        printf "%s", $0
+        while ((getline line < text) > 0) print line
+        print "</failure>"
+        inside = 0
+        next
+      }
+      /<\/testcase>/ { inside = 0 }
+      { print }
+    ' "$OUTPUT_PATH" >"$PATCHED" && cat "$PATCHED" >"$OUTPUT_PATH"
+    rm -f "$PANIC_TEXT" "$PATCHED"
+  fi
+  RAN=0
+  NAMES=""
+  if [ "$MODE" = "new" ]; then
+    SUITE="$NEW_PKG"
+    for name in $(expected_tests); do
+      if grep -q "<testcase name=\"$name\"" "$OUTPUT_PATH" 2>/dev/null; then
+        RAN=1
+      else
+        NAMES="$NAMES $name"
+      fi
+    done
+  else
+    SUITE="github.com/u-root/u-root"
+    if grep -q '<testcase ' "$OUTPUT_PATH" 2>/dev/null; then
+      RAN=1
+    else
+      NAMES="build"
+    fi
+    [ "$LIST_STATUS" -eq 0 ] || NAMES="$NAMES package_discovery"
+  fi
+  if [ -n "$NAMES" ]; then
+    [ "$STATUS" -eq 0 ] && STATUS=1
+    DETAIL="$(grep -E '^# (github\.com/|command-line-arguments)|\.go:[0-9]+:[0-9]+: |\[(build|setup) failed\]|^panic' "$LOG" | head -n 40)"
+    [ -n "$DETAIL" ] || DETAIL="$(tail -n 40 "$LOG")"
+    DETAIL="$(printf '%s\n' "$DETAIL" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+    if [ "$RAN" -eq 1 ] && [ -n "$PANICKED" ]; then
+      MESSAGE="not run: the test binary exited after $PANICKED panicked"
+    elif [ "$RAN" -eq 1 ] && [ -n "$TIMED_OUT" ]; then
+      MESSAGE="not run: the test binary's -timeout expired while $TIMED_OUT was running"
+    elif [ "$RAN" -eq 1 ]; then
+      MESSAGE="not run: the test binary exited before reaching this test"
+    else
+      MESSAGE="the test package failed to build or run"
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n</testsuites>\n' >"$OUTPUT_PATH"
+    fi
+    COUNT="$(printf '%s\n' $NAMES | grep -c .)"
+    EXTRA="$(mktemp)"
+    MERGED="$(mktemp)"
+    {
+      echo "<testsuite name=\"$SUITE\" tests=\"$COUNT\" failures=\"$COUNT\" errors=\"0\">"
+      for name in $NAMES; do
+        if [ "$name" = "package_discovery" ]; then
+          LIST_DETAIL="$(head -n 40 "$LISTERR" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+          echo "<testcase name=\"$name\" classname=\"$SUITE\"><failure message=\"go list ./cmds/exp/... failed\">$LIST_DETAIL</failure></testcase>"
+        else
+          echo "<testcase name=\"$name\" classname=\"$SUITE\"><failure message=\"$MESSAGE\">$DETAIL</failure></testcase>"
+        fi
+      done
+      echo '</testsuite>'
+    } >"$EXTRA"
+    awk -v extra="$EXTRA" '/<\/testsuites>/ { while ((getline line < extra) > 0) print line } { print }' "$OUTPUT_PATH" >"$MERGED"
+    TESTS="$(grep -c '<testcase ' "$MERGED")"
+    FAILURES="$(grep -c '<failure' "$MERGED")"
+    ERRORS="$(grep -c '<error' "$MERGED")"
+    sed -E "1,/<testsuites/ s#<testsuites[^>]*>#<testsuites tests=\"$TESTS\" failures=\"$FAILURES\" errors=\"$ERRORS\">#" "$MERGED" >"$OUTPUT_PATH"
+    rm -f "$EXTRA" "$MERGED"
+  fi
+fi
+
+exit "$STATUS"
