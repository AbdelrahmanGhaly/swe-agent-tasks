+// Copyright 2026 the u-root Authors. All rights reserved
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package gnucompat
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strings"
+	"syscall"
+	"testing"
+)
+
+var (
+	edPath   string
+	buildErr error
+	gnuWatch *gnuEdWatch
+	watchErr error
+)
+
+func TestMain(m *testing.M) {
+	syscall.Umask(0o022)
+	dir, err := os.MkdirTemp("", "ed-gnucompat-")
+	if err != nil {
+		buildErr = err
+	} else if err = os.Chmod(dir, 0o755); err != nil {
+		buildErr = err
+	} else {
+		edPath = filepath.Join(dir, "ed")
+		build := exec.Command("go", "build", "-o", edPath, "github.com/u-root/u-root/cmds/exp/ed")
+		if out, err := build.CombinedOutput(); err != nil {
+			buildErr = fmt.Errorf("building cmds/exp/ed: %v\n%s", err, out)
+		}
+	}
+	gnuWatch, watchErr = watchGNUEd()
+	code := m.Run()
+	if dir != "" {
+		os.RemoveAll(dir)
+	}
+	os.Exit(code)
+}
+
+type gnuEdWatch struct {
+	fd   int
+	path string
+}
+
+func watchGNUEd() (*gnuEdWatch, error) {
+	gnu, err := exec.LookPath("ed")
+	if err != nil {
+		return &gnuEdWatch{fd: -1}, nil
+	}
+	path, err := filepath.EvalSymlinks(gnu)
+	if err != nil {
+		return nil, err
+	}
+	fd, err := syscall.InotifyInit1(syscall.IN_NONBLOCK | syscall.IN_CLOEXEC)
+	if err != nil {
+		return nil, fmt.Errorf("inotify_init1: %v", err)
+	}
+	if _, err := syscall.InotifyAddWatch(fd, path, syscall.IN_OPEN); err != nil {
+		return nil, fmt.Errorf("watching %s: %v", path, err)
+	}
+	return &gnuEdWatch{fd: fd, path: path}, nil
+}
+
+func (w *gnuEdWatch) opened() bool {
+	if w.fd < 0 {
+		return false
+	}
+	buf := make([]byte, 1<<12)
+	seen := false
+	for {
+		n, err := syscall.Read(w.fd, buf)
+		if err != nil || n <= 0 {
+			return seen
+		}
+		seen = true
+	}
+}
+
+func shorten(s string) string {
+	if len(s) <= 200 {
+		return fmt.Sprintf("%q", s)
+	}
+	return fmt.Sprintf("%q...%q (%d bytes)", s[:80], s[len(s)-80:], len(s))
+}
+
+type edCase struct {
+	name     string
+	files    map[string]string
+	perms    map[string]os.FileMode
+	umask    int
+	script   string
+	fromFile bool
+	stdout   string
+	status   int
+	after    map[string]string
+	modes    map[string]os.FileMode
+}
+
+func runCases(t *testing.T, cases []edCase) {
+	t.Helper()
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if buildErr != nil {
+				t.Fatal(buildErr)
+			}
+			if watchErr != nil {
+				t.Fatal(watchErr)
+			}
+			dir := t.TempDir()
+			for name, content := range tc.files {
+				path := filepath.Join(dir, name)
+				if err := os.WriteFile(path, []byte(content), 0o644); err != nil {
+					t.Fatal(err)
+				}
+				if perm, ok := tc.perms[name]; ok {
+					if err := os.Chmod(path, perm); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			cmd := exec.Command(edPath, "-s", "notes.txt")
+			cmd.Dir = dir
+			cmd.Env = []string{"LC_ALL=C", "HOME=" + dir, "PATH=" + os.Getenv("PATH")}
+			if tc.fromFile {
+				script := filepath.Join(t.TempDir(), "script.ed")
+				if err := os.WriteFile(script, []byte(tc.script), 0o644); err != nil {
+					t.Fatal(err)
+				}
+				f, err := os.Open(script)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer f.Close()
+				cmd.Stdin = f
+			} else {
+				cmd.Stdin = strings.NewReader(tc.script)
+			}
+			var stdout bytes.Buffer
+			cmd.Stdout = &stdout
+			umask := 0o022
+			if tc.umask != 0 {
+				umask = tc.umask
+			}
+			gnuWatch.opened()
+			syscall.Umask(umask)
+			err := cmd.Run()
+			syscall.Umask(0o022)
+			usedGNU := gnuWatch.opened()
+			status := 0
+			var exitErr *exec.ExitError
+			if errors.As(err, &exitErr) {
+				status = exitErr.ExitCode()
+			} else if err != nil {
+				t.Fatalf("running ed: %v", err)
+			}
+			if usedGNU {
+				t.Errorf("script %q: ed opened GNU ed (%s) while it ran, but it must not use GNU ed", tc.script, gnuWatch.path)
+			}
+			if got := stdout.String(); got != tc.stdout {
+				t.Errorf("script %q\nstdout = %s\nwant     %s", tc.script, shorten(got), shorten(tc.stdout))
+			}
+			if status != tc.status {
+				t.Errorf("script %q: exit status %d, want %d", tc.script, status, tc.status)
+			}
+			got := map[string]string{}
+			entries, err := os.ReadDir(dir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, e := range entries {
+				info, err := e.Info()
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !info.Mode().IsRegular() {
+					t.Errorf("script %q left %q, which is not a regular file (%v)", tc.script, e.Name(), info.Mode().Type())
+					continue
+				}
+				want := os.FileMode(0o644)
+				if m, ok := tc.modes[e.Name()]; ok {
+					want = m
+				}
+				if perm := info.Mode().Perm(); perm != want {
+					t.Errorf("script %q: file %q has mode %v, want %v", tc.script, e.Name(), perm, want)
+				}
+				b, err := os.ReadFile(filepath.Join(dir, e.Name()))
+				if err != nil {
+					t.Fatal(err)
+				}
+				got[e.Name()] = string(b)
+			}
+			var names []string
+			for name := range got {
+				names = append(names, name)
+			}
+			for name := range tc.after {
+				if _, ok := got[name]; !ok {
+					names = append(names, name)
+				}
+			}
+			sort.Strings(names)
+			for _, name := range names {
+				g, gok := got[name]
+				w, wok := tc.after[name]
+				switch {
+				case !wok:
+					t.Errorf("script %q left an unexpected file %q", tc.script, name)
+				case !gok:
+					t.Errorf("script %q: file %q is missing, want %s", tc.script, name, shorten(w))
+				case g != w:
+					t.Errorf("script %q: file %q = %s, want %s", tc.script, name, shorten(g), shorten(w))
+				}
+			}
+		})
+	}
+}
