+func (e *editor) appendText(c *cmdbuf, addr int, insert, global bool) {
+	var texts []string
+	for {
+		var l string
+		if global {
+			if c.pos >= len(c.s) {
+				break
+			}
+			end := strings.IndexByte(c.s[c.pos:], '\n')
