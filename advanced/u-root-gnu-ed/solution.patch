+// io.go - printing lines, and reading and writing files
+package main
+
+import (
+	"bufio"
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+)
+
+// columns is the width at which l folds long lines.
+const columns = 72
+
+// pathMax is the longest file name accepted.
+const pathMax = 4096
+
+func isShell(name string) bool { return name != "" && name[0] == '!' }
+
+func (e *editor) printLines(from, to, pflags int) error {
+	if from == 0 {
+		return errInvalidAddress
+	}
+	for a := from; a <= to; a++ {
+		e.buf.cur = a
+		e.printLine(e.buf.text(a), pflags)
+	}
+	return nil
+}
+
+// printLine prints s. With pfNumber it is preceded by its address; with
+// pfList it is written unambiguously, folded at columns and ended with $.
+func (e *editor) printLine(s string, pflags int) {
+	col := 0
+	if pflags&pfNumber != 0 {
+		fmt.Fprintf(e.out, "%d\t", e.buf.cur)
+		col = 8
+	}
+	if pflags&pfList == 0 {
+		e.out.WriteString(s)
+		e.out.WriteByte('\n')
+		return
+	}
+	for i := 0; i < len(s); i++ {
+		ch := s[i]
+		// As in GNU ed, the fold is decided one column per byte, before an
+		// escape adds its width, so an escape that starts in the last column
+		// ends past it: 71 a's and a $ print as one row ending in \$$.
+		if col++; col > columns {
+			col = 1
+			e.out.WriteString("\\\n")
+		}
+		if ch >= 32 && ch <= 126 {
+			if ch == '$' || ch == '\\' {
+				col++
+				e.out.WriteByte('\\')
+			}
+			e.out.WriteByte(ch)
+			continue
+		}
+		col++
+		e.out.WriteByte('\\')
+		if j := strings.IndexByte("\a\b\f\n\r\t\v", ch); ch != 0 && j >= 0 {
+			e.out.WriteByte("abfnrtv"[j])
+			continue
+		}
+		col += 2
+		e.out.WriteByte('0' + ch>>6&7)
+		e.out.WriteByte('0' + ch>>3&7)
+		e.out.WriteByte('0' + ch&7)
+	}
+	e.out.WriteString("$\n")
+}
+
+// filename reads the file name argument of e, E, f, r, w and W. An empty
+// name stands for the default file name; a name that starts with ! would be a
+// shell command, which is refused.
+func (e *editor) filename(c *cmdbuf) (string, error) {
+	c.skipBlanks()
+	if c.peek() != '\n' {
+		if err := e.extendLine(c, true); err != nil {
+			return "", err
+		}
+		if c.peek() == '!' {
+			return "", errRestricted
+		}
+		if strings.IndexByte(c.s[c.pos:], '\n') > pathMax {
+			return "", errFilenameTooLong
+		}
+	} else if e.defFile == "" {
+		return "", errNoCurrentFile
+	}
+	start := c.pos
+	for c.pos < len(c.s) && c.s[c.pos] != '\n' {
+		c.pos++
+	}
+	name := c.s[start:c.pos]
+	for c.peek() == '\n' {
+		c.pos++
+	}
+	return name, nil
+}
+
+// showError reports a failed file operation on standard error. GNU ed
+// prints these in script mode too: -s only suppresses byte counts.
+func (e *editor) showError(name string, err error) {
+	var pe *os.PathError
+	if errors.As(err, &pe) {
+		err = pe.Err
+	}
+	msg := err.Error()
+	if msg != "" {
+		msg = strings.ToUpper(msg[:1]) + msg[1:]
+	}
+	fmt.Fprintf(e.errOut, "%s: %s\n", name, msg)
+}
+
+// readFile reads name into the buffer after addr and returns the number of
+// lines read.
+func (e *editor) readFile(name string, addr int) (int, error) {
+	data, err := os.ReadFile(name)
+	if err != nil {
+		e.showError(name, err)
+		var pe *os.PathError
+		if errors.As(err, &pe) && pe.Op == "open" {
+			return -1, errOpenInput
+		}
+		return -1, errReadInput
+	}
+	var texts []string
+	appended := false
+	for s := string(data); s != ""; {
+		i := strings.IndexByte(s, '\n')
+		if i < 0 {
+			texts = append(texts, s)
+			appended = true
+			break
+		}
+		texts = append(texts, s[:i])
+		s = s[i+1:]
+	}
+	e.buf.add(addr, texts)
+	if appended {
+		// GNU ed prints this notice on standard output even with -s.
+		fmt.Fprintln(e.out, "Newline appended")
+	}
+	if !e.scripted {
+		size := len(data)
+		if appended {
+			size++
+		}
+		fmt.Fprintln(e.out, size)
+	}
+	return len(texts), nil
+}
+
+// writeFile writes lines from through to to name, appending with appendTo,
+// and returns the number of lines written.
+func (e *editor) writeFile(name string, appendTo bool, from, to int) (int, error) {
+	var w bytes.Buffer
+	for a := from; a > 0 && a <= to; a++ {
+		w.WriteString(e.buf.text(a))
+		w.WriteByte('\n')
+	}
+	flags := os.O_WRONLY | os.O_CREATE | os.O_TRUNC
+	if appendTo {
+		flags = os.O_WRONLY | os.O_CREATE | os.O_APPEND
+	}
+	f, err := os.OpenFile(name, flags, 0o666)
+	if err != nil {
+		e.showError(name, err)
+		return -1, errOpenOutput
+	}
+	bw := bufio.NewWriter(f)
+	_, err = bw.Write(w.Bytes())
+	if err == nil {
+		err = bw.Flush()
+	}
+	if cerr := f.Close(); err == nil {
+		err = cerr
+	}
+	if err != nil {
+		e.showError(name, err)
+		return -1, errWriteOutput
+	}
+	if !e.scripted {
+		fmt.Fprintln(e.out, w.Len())
+	}
+	if from > 0 && from <= to {
+		return to - from + 1, nil
+	}
+	return 0, nil
+}
diff --git a/cmds/exp/ed/subst.go b/cmds/exp/ed/subst.go
new file mode 100644
index 000000000..fb5b94817
--- /dev/null
+++ b/cmds/exp/ed/subst.go
@@ -0,0 +1,492 @@
+// Copyright 2026 the u-root Authors. All rights reserved
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// subst.go - regular expressions in commands, searches and the s command
+package main
+
+import (
+	"slices"
+	"strings"
+
+	"github.com/u-root/u-root/pkg/bre"
+)
+
+func byteAt(s string, i int) byte {
+	if i < len(s) {
+		return s[i]
+	}
+	return 0
+}
+
+// closeBracket returns the index of the ] that ends the bracket expression
+// whose contents start at i, or -1 if the line ends first.
+func closeBracket(s string, i int) int {
+	if byteAt(s, i) == '^' {
+		i++
+	}
+	if byteAt(s, i) == ']' {
+		i++
+	}
+	for ; byteAt(s, i) != ']'; i++ {
+		ch := byteAt(s, i)
+		if ch == '\n' || ch == 0 {
+			return -1
+		}
+		if d := byteAt(s, i+1); ch == '[' && (d == '.' || d == ':' || d == '=') {
+			i += 2
+			prev := byteAt(s, i)
+			for byteAt(s, i) != ']' || prev != d {
+				prev = byteAt(s, i)
+				if prev == '\n' || prev == 0 {
+					return -1
+				}
+				i++
+			}
+		}
+	}
+	return i
+}
+
+// pattern returns the regular expression in c up to delim or the end of the
+// line, leaving c there.
+func (e *editor) pattern(c *cmdbuf, delim byte) (string, error) {
+	start, i := c.pos, c.pos
+	for i < len(c.s) && c.s[i] != delim && c.s[i] != '\n' {
+		switch c.s[i] {
+		case '[':
+			if i = closeBracket(c.s, i+1); i < 0 {
+				return "", errUnbalanced
+			}
+		case '\\':
+			if i++; byteAt(c.s, i) == '\n' {
+				return "", errTrailingSlash
+			}
+		}
+		i++
+	}
+	c.pos = i
+	return c.s[start:i], nil
+}
+
+func (e *editor) compile(pat string, icase bool) (*bre.Regexp, error) {
+	re, err := bre.Compile(pat, icase)
+	if err != nil {
+		return nil, err
+	}
+	e.lastRE = re
+	return re, nil
+}
+
+// regexp reads a delimited regular expression with an optional I suffix.
+// An empty one stands for the last regular expression used.
+func (e *editor) regexp(c *cmdbuf) (*bre.Regexp, error) {
+	delim := c.peek()
+	if delim == ' ' || delim == '\n' {
+		return nil, errBadDelimiter
+	}
+	c.pos++
+	if p := c.peek(); p == delim || p == '\n' {
+		if e.lastRE == nil {
+			return nil, errNoPrevPattern
+		}
+		if p == delim {
+			if c.pos++; c.peek() == 'I' {
+				return nil, errSuffixI
+			}
+		}
+		return e.lastRE, nil
+	}
+	pat, err := e.pattern(c, delim)
+	if err != nil {
+		return nil, err
+	}
+	icase := false
+	if c.peek() == delim {
+		if c.pos++; c.peek() == 'I' {
+			icase = true
+			c.pos++
+		}
+	}
+	return e.compile(pat, icase)
+}
+
+// search finds the next line, forward for /re/ and backward for ?re?,
+// that matches, wrapping around the buffer.
+func (e *editor) search(c *cmdbuf) (int, error) {
+	forward := c.peek() == '/'
+	re, err := e.regexp(c)
+	if err != nil {
+		return -1, err
+	}
+	b := e.buf
+	addr := b.cur
+	for {
+		if forward {
+			if addr++; addr > b.last() {
+				addr = 0
+			}
+		} else if addr--; addr < 0 {
+			addr = b.last()
+		}
+		if addr != 0 && re.MatchString(b.text(addr)) {
+			return addr, nil
+		}
+		if addr == b.cur {
+			return -1, errNoMatch
+		}
+	}
+}
+
+// Flags of a repeated substitution.
+const (
+	sfGlobal = 1 << iota
+	sfPrint
+	sfLastSearch
+	sfNone
+)
+
+// substitute runs the s command. Without a pattern it repeats the last
+// substitution, adjusted by the suffixes that follow.
+func (e *editor) substitute(c *cmdbuf, pflags *int, n int, global bool) error {
+	b := e.buf
+	if err := e.checkRange(b.cur, b.cur, n); err != nil {
+		return err
+	}
+	// As in GNU ed, a digit 1-9, g, p or r right after s starts the
+	// suffixes of the repeat form, so none of them can open a new pattern:
+	// 1sgagXg is an invalid suffix, while 1sxaxXx or 1s0a0X0 substitutes.
+	sflags := 0
+	for {
+		bad := false
+		switch p := c.peek(); {
+		case p >= '1' && p <= '9':
+			num, err := c.number()
+			if sflags&sfGlobal != 0 || err != nil || num <= 0 {
+				bad = true
+			} else {
+				sflags |= sfGlobal
+				e.sNum = num
+			}
+		case p == '\n':
+			sflags |= sfNone
+		case p == 'g' || p == 'p' || p == 'r':
+			f := sfGlobal
+			switch p {
+			case 'p':
+				f = sfPrint
+			case 'r':
+				f = sfLastSearch
+			}
+			if sflags&f != 0 {
+				bad = true
+				break
+			}
+			sflags |= f
+			if p == 'g' {
+				if e.sNum == 0 {
+					e.sNum = 1
+				} else {
+					e.sNum = 0
+				}
+			}
+			c.pos++
+		default:
+			bad = sflags != 0
+		}
+		if bad {
+			return errBadSuffix
+		}
+		if sflags == 0 || c.peek() == '\n' {
+			break
+		}
+	}
+	if sflags != 0 {
+		if e.substRE == nil {
+			return errNoPrevSubst
+		}
+		if sflags&sfLastSearch != 0 {
+			if e.lastRE == nil {
+				return errNoPrevPattern
+			}
+			e.substRE = e.lastRE
+		}
+		if sflags&sfPrint != 0 {
+			e.sPflags ^= e.sPmask
+		}
+	} else {
+		pat, err := e.substPattern(c)
+		if err != nil {
+			return err
+		}
+		delim := c.peek()
+		if err := e.replacement(c, global); err != nil {
+			return err
+		}
+		e.sPflags, e.sNum = 0, 1
+		icase := false
+		if c.peek() == '\n' {
+			e.sPflags = pfPrint
+		} else {
+			if c.peek() == delim {
+				c.pos++
+			}
+			if err := e.substSuffix(c, &icase); err != nil {
+				return err
+			}
+		}
+		if e.sPmask = e.sPflags & (pfList | pfNumber | pfPrint); e.sPmask == 0 {
+			e.sPmask = pfPrint
+		}
+		if pat == "" && icase {
+			return errSuffixI
+		}
+		re := e.lastRE
+		if pat != "" {
+			if re, err = e.compile(pat, icase); err != nil {
+				return err
+			}
+		}
+		e.substRE = re
+	}
+	*pflags = e.sPflags
+	if !global {
+		b.clearUndo()
+	}
+	return e.replaceLines(e.first, e.second, e.sNum, global)
+}
+
+// substPattern reads the pattern of an s command, leaving c at the
+// delimiter that ends it.
+func (e *editor) substPattern(c *cmdbuf) (string, error) {
+	delim := c.peek()
+	if delim == ' ' || delim == '\n' {
+		return "", errBadDelimiter
+	}
+	if c.pos++; c.peek() == delim {
+		if e.lastRE == nil {
+			return "", errNoPrevPattern
+		}
+		return "", nil
+	}
+	pat, err := e.pattern(c, delim)
+	if err != nil {
+		return "", err
+	}
+	if c.peek() != delim {
+		return "", errMissingDelim
+	}
+	return pat, nil
+}
+
+// replacement reads the replacement of an s command. A lone % stands for
+// the last replacement. Outside a global command, an escaped newline
+// continues the replacement on the next input line. A global command list
+// is already joined, and GNU ed ends a replacement there only at its
+// delimiter or at the end of the list, so g/a/s/a/A\ followed by p
+// replaces a with the two lines A and p, and % before more of the list is
+// a literal %.
+func (e *editor) replacement(c *cmdbuf, global bool) error {
+	delim := c.peek()
+	if delim == '\n' {
+		return errMissingDelim
+	}
+	c.pos++
+	if c.peek() == '%' {
+		if nx := byteAt(c.s, c.pos+1); nx == delim || nx == '\n' && (!global || c.pos+2 >= len(c.s)) {
+			c.pos++
+			if e.repl == nil {
+				return errNoPrevSubst
+			}
+			return nil
+		}
+	}
+	var r []byte
+	for c.pos < len(c.s) && c.peek() != delim {
+		if c.peek() == '\n' && (!global || c.pos+1 >= len(c.s)) {
+			break
+		}
+		ch := c.next()
+		r = append(r, ch)
+		if ch != '\\' {
+			continue
+		}
+		ch = c.next()
+		r = append(r, ch)
+		if ch == '\n' && !global {
+			l, ok := e.readLine()
+			if !ok {
+				return errEOF
+			}
+			c.s, c.pos = l, 0
+		}
+	}
+	s := string(r)
+	e.repl = &s
+	return nil
+}
+
+// substSuffix reads the suffixes after the replacement: a count or g, I,
+// and the print suffixes.
+func (e *editor) substSuffix(c *cmdbuf, icase *bool) error {
+	counted := false
+loop:
+	for {
+		var f int
+		switch ch := c.peek(); {
+		case ch >= '1' && ch <= '9':
+			num, err := c.number()
+			if counted || err != nil || num <= 0 {
+				return errBadSuffix
+			}
+			counted = true
+			e.sNum = num
+			continue
+		case ch == 'g':
+			if counted {
+				break loop
+			}
+			counted = true
+			e.sNum = 0
+		case ch == 'i' || ch == 'I':
+			if *icase {
+				break loop
+			}
+			*icase = true
+		case ch == 'l':
+			f = pfList
+		case ch == 'n':
+			f = pfNumber
+		case ch == 'p':
+			f = pfPrint
+		default:
+			break loop
+		}
+		if f != 0 {
+			if e.sPflags&f != 0 {
+				break loop
+			}
+			e.sPflags |= f
+		}
+		c.pos++
+	}
+	if c.next() != '\n' {
+		return errBadSuffix
+	}
+	return nil
+}
+
+// replaceLines makes the substitution in each line of [from, to]: the
+// snum-th match, or every match when snum is 0. The new lines go into the
+// buffer in one splice, which also keeps the ones replaced before an error;
+// the last line replaced is left in the cut buffer. Marks on a replaced line
+// are lost with it, as GNU ed's manual says of a modified line.
+func (e *editor) replaceLines(from, to, snum int, global bool) error {
+	b := e.buf
+	var out, gone []*line
+	cur := b.cur
+	var err error
+	a := from
+	for ; a <= to; a++ {
+		l := b.lines[a-1]
+		var text string
+		var changed bool
+		if text, changed, err = e.replaceLine(l.text, snum); err != nil {
+			break
+		}
+		if !changed {
+			out = append(out, l)
+			continue
+		}
+		gone = append(gone, l)
+		for _, t := range strings.Split(text, "\n") {
+			out = append(out, &line{text: t})
+		}
+		cur = from - 1 + len(out)
+	}
+	if len(gone) > 0 {
+		if global {
+			b.deactivate(gone)
+		}
+		b.lines = slices.Replace(b.lines, from-1, a-1, out...)
+		b.yanked = []string{gone[len(gone)-1].text}
+		b.cur = cur
+		b.changed()
+	}
+	if err != nil {
+		return err
+	}
+	// Inside a global command GNU ed leaves a line the substitution does not
+	// match alone instead of failing.
+	if len(gone) == 0 && !global {
+		return errNoMatch
+	}
+	return nil
+}
+
+// replaceLine applies the substitution to one line. Each match after the
+// first is searched for in the rest of the line, which does not start a
+// line.
+func (e *editor) replaceLine(text string, snum int) (string, bool, error) {
+	re := e.substRE
+	m := re.FindSubmatchIndex(text, false)
+	if m == nil {
+		return text, false, nil
+	}
+	global := snum <= 0
+	var out []byte
+	pos, matches := 0, 0
+	changed, empty := false, false
+	for {
+		rest := text[pos:]
+		matches++
+		if global || snum == matches {
+			changed = true
+			out = append(out, rest[:m[0]]...)
+			out = e.expand(out, rest, m, re.NumSubexp())
+		} else {
+			out = append(out, rest[:m[1]]...)
+		}
+		pos += m[1]
+		if global && m[1] == 0 {
+			if empty {
+				return "", false, errInfiniteLoop
+			}
+			empty = true
+		}
+		if pos >= len(text) || changed && !global {
+			break
+		}
+		if m = re.FindSubmatchIndex(text[pos:], true); m == nil {
+			break
+		}
+	}
+	out = append(out, text[pos:]...)
+	return string(out), changed, nil
+}
+
+// expand appends the replacement for match m in s: & is the whole match,
+// \1 to \9 the sub-expressions, and a backslash makes any other character
+// literal.
+func (e *editor) expand(out []byte, s string, m []int, nsub int) []byte {
+	r := *e.repl
+	for i := 0; i < len(r); i++ {
+		switch {
+		case r[i] == '&':
+			out = append(out, s[m[0]:m[1]]...)
+		case r[i] == '\\':
+			i++
+			d := byteAt(r, i)
+			if n := int(d - '0'); d >= '1' && d <= '9' && n <= nsub {
+				if m[2*n] >= 0 {
+					out = append(out, s[m[2*n]:m[2*n+1]]...)
+				}
+			} else {
+				out = append(out, d)
+			}
+		default:
+			out = append(out, r[i])
+		}
+	}
+	return out
+}
