+		{name: "back_reference_after_missing_letter", cmd: "/\\(x*\\)z\\1/\nh\nQ\n", wantOut: "?\nNo match\n"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Chdir(t.TempDir())
+			if err := os.WriteFile("testfile", []byte(line), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			var out, errOut bytes.Buffer
+			status := runEd(strings.NewReader(tt.cmd), &out, &errOut, true, "", "testfile")
+			if out.String() != tt.wantOut || status != 1 {
+				t.Errorf("runEd(%q) on a line of 100000 x printed %q and returned %d, want %q and 1", tt.cmd, out.String(), status, tt.wantOut)
 			}
 		})
 	}
