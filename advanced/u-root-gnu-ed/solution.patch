+
+package bre
+
+import (
+	"maps"
+	"slices"
+	"strconv"
+	"strings"
+)
+
+// Regexp is a compiled basic regular expression.
+type Regexp struct {
+	nodes   []node
+	init    int
+	end     int
+	nsub    int
+	icase   bool
+	backref bool
+	plural  bool
+}
+
+type node struct {
+	op         opcode
+	c          byte
+	set        *[256]bool
+	idx        int
+	constraint int
+	optional   bool
+	next       int
+	edests     []int
+}
+
+// NumSubexp returns the number of parenthesized sub-expressions.
+func (re *Regexp) NumSubexp() int { return re.nsub }
+
+// build numbers the nodes in post-order, as the GNU C library does, and links
+// each node to its successors. The numbering decides which of two branches
+// is preferred.
+func (re *Regexp) build(root *tree) {
+	re.number(root)
+	calcNext(root)
+	re.link(root)
+	re.init = root.first.node
+}
+
+func (re *Regexp) number(t *tree) {
+	if t == nil {
+		return
+	}
+	re.number(t.left)
+	re.number(t.right)
+	if t.op == opConcat {
+		t.first, t.node = t.left.first, t.left.node
+		return
+	}
+	t.first, t.node = t, len(re.nodes)
+	re.nodes = append(re.nodes, node{op: t.op, c: t.c, set: t.set, idx: t.idx, constraint: t.constraint, optional: t.optional, next: -1})
+	if t.op == opEnd {
+		re.end = t.node
+	}
+}
+
+func calcNext(t *tree) {
+	if t == nil {
+		return
+	}
+	switch t.op {
+	case opStar:
+		t.left.next = t
+	case opConcat:
+		t.left.next = t.right.first
+		t.right.next = t.next
+	default:
+		if t.left != nil {
+			t.left.next = t.next
+		}
+		if t.right != nil {
+			t.right.next = t.next
+		}
+	}
+	calcNext(t.left)
+	calcNext(t.right)
+}
+
+func (re *Regexp) link(t *tree) {
+	if t == nil {
+		return
+	}
+	re.link(t.left)
+	re.link(t.right)
+	n := &re.nodes[t.node]
+	switch t.op {
+	case opConcat, opEnd:
+	case opStar, opAlt:
+		re.plural = true
+		l, r := t.next, t.next
+		if t.left != nil {
+			l = t.left.first
+		}
+		if t.right != nil {
+			r = t.right.first
+		}
+		n.edests = []int{l.node}
+		if r.node != l.node {
+			n.edests = append(n.edests, r.node)
+		}
+		slices.Sort(n.edests)
+	case opAnchor, opOpen, opClose:
+		n.edests = []int{t.next.node}
+	case opBackref:
+		n.next = t.next.node
+		n.edests = []int{t.next.node}
+	default:
+		n.next = t.next.node
+	}
+}
+
+func isEpsilon(op opcode) bool {
+	switch op {
+	case opOpen, opClose, opAnchor, opAlt, opStar:
+		return true
+	}
+	return false
+}
+
+// Context of a position, as seen by anchors.
+const (
+	ctxWord = 1 << iota
+	ctxNewline
+	ctxBegbuf
+	ctxEndbuf
+)
+
+type matcher struct {
+	re     *Regexp
+	in     string
+	notBOL bool
+	end    int
+	start  int
+	sifted [][]bool
+	reachB map[string]bool
+	seen   map[string]bool
+	stack  []int
+}
+
+func (re *Regexp) matcher(s string, notBOL bool) *matcher {
+	if re.icase {
+		s = upper(s)
+	}
+	return &matcher{re: re, in: s, notBOL: notBOL}
+}
+
+// MatchString reports whether s contains a match.
+func (re *Regexp) MatchString(s string) bool {
+	m := re.matcher(s, false)
+	start, _ := m.search(!re.backref)
+	if start < 0 || !re.backref {
+		return start >= 0
+	}
+	for ; start <= len(m.in); start++ {
+		if m.longest(start) >= 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// FindSubmatchIndex returns the leftmost-longest match in s as pairs of
+// offsets: the whole match, then each sub-expression, with -1 for a
+// sub-expression that took no part. notBOL says that the start of s is not
+// the start of a line, as with REG_NOTBOL. It returns nil if there is no
+// match.
+func (re *Regexp) FindSubmatchIndex(s string, notBOL bool) []int {
+	m := re.matcher(s, notBOL)
+	start, end := m.search(false)
+	if start < 0 {
+		return nil
+	}
+	if !re.backref {
+		return m.registers(start, end)
+	}
+	for ; start <= len(m.in); start++ {
+		if end := m.longest(start); end >= 0 {
+			return m.registers(start, end)
+		}
+	}
+	return nil
+}
+
+// context returns what the anchors see at position i. GNU ed hands the C
+// library one line at a time, so \` and \' match at the start and end of the
+// line being matched.
+func (m *matcher) context(i int) int {
+	switch {
+	case i < 0:
+		if m.notBOL {
+			return ctxBegbuf
+		}
+		return ctxBegbuf | ctxNewline
+	case i == len(m.in):
+		return ctxEndbuf | ctxNewline
+	case isWord(m.in[i]):
+		return ctxWord
+	}
+	return 0
+}
+
+func (m *matcher) satisfies(constraint, pos int) bool {
+	prev, next := m.context(pos-1), m.context(pos)
+	switch {
+	case constraint&prevWord != 0 && prev&ctxWord == 0,
+		constraint&prevNotWord != 0 && prev&ctxWord != 0,
+		constraint&prevNewline != 0 && prev&ctxNewline == 0,
+		constraint&prevBegbuf != 0 && prev&ctxBegbuf == 0,
+		constraint&nextWord != 0 && next&ctxWord == 0,
+		constraint&nextNotWord != 0 && next&ctxWord != 0,
+		constraint&nextNewline != 0 && next&ctxNewline == 0,
+		constraint&nextEndbuf != 0 && next&ctxEndbuf == 0:
+		return false
+	}
+	return true
+}
+
+func (m *matcher) accepts(n *node, pos int) bool {
+	if pos >= len(m.in) {
+		return false
+	}
+	c := m.in[pos]
+	switch n.op {
+	case opChar:
+		return c == n.c
+	case opAny:
+		return c != 0
+	case opSet:
+		return n.set[c]
+	}
+	return false
+}
+
+// visited returns an empty set of explored states. Without a star or an
+// alternation there is only one path from each node, so no state comes back
+// and no set is needed.
+func (m *matcher) visited() map[string]bool {
+	if !m.re.plural {
+		return nil
+	}
+	if m.seen == nil {
+		m.seen = map[string]bool{}
+	}
+	clear(m.seen)
+	return m.seen
+}
+
+// longest returns the end of the longest match starting at start, or -1,
+// for an expression with back-references.
+func (m *matcher) longest(start int) int {
+	best := -1
+	m.explore(m.re.init, start, m.initialRegs(start, -1), nil, m.visited(), &best)
+	return best
+}
+
+type thread struct {
+	node, start int
+}
+
+// search runs the automaton from every start position at once, in one pass
+// over the input, and returns the leftmost match with its longest end, or
+// -1, -1. A state keeps only the earliest start that reached it: what can
+// follow a state does not depend on where the match began. With first set,
+// it returns the first match it finds.
+//
+// A back-reference is taken to match any text, of any length: a thread on
+// it may go past it at once or stay on it while it consumes a byte. So for
+// an expression with back-references the result is only a lower bound for
+// where a real match can start, and the exact search starts from there.
+func (m *matcher) search(first bool) (int, int) {
+	nodes := m.re.nodes
+	seen := make([]int, len(nodes))
+	var cur, next []thread
+	start, end := -1, -1
+	for pos := 0; ; pos++ {
+		if start < 0 {
+			cur = m.closure(cur, seen, m.re.init, pos, pos)
+		}
+		for _, t := range cur {
+			if t.node == m.re.end && (start < 0 || t.start < start || t.start == start && pos > end) {
+				start, end = t.start, pos
+			}
+		}
+		if start >= 0 && first || pos == len(m.in) {
+			return start, end
+		}
+		next = next[:0]
+		for _, t := range cur {
+			if start >= 0 && t.start > start {
+				break
+			}
+			nd := &nodes[t.node]
+			switch {
+			case nd.op == opBackref:
+				next = m.closure(next, seen, t.node, t.start, pos+1)
+			case t.node != m.re.end && !isEpsilon(nd.op) && m.accepts(nd, pos):
+				next = m.closure(next, seen, nd.next, t.start, pos+1)
+			}
+		}
+		cur, next = next, cur
+		if len(cur) == 0 && start >= 0 {
+			return start, end
+		}
+	}
+}
+
+// closure adds n and the nodes reachable from it at pos without consuming
+// input to list, as threads of start. Nodes already in the list stay with
+// the start they have, which is never later, since the threads are added in
+// order of their starts.
+func (m *matcher) closure(list []thread, seen []int, n, start, pos int) []thread {
+	m.stack = append(m.stack[:0], n)
+	for len(m.stack) > 0 {
+		n := m.stack[len(m.stack)-1]
+		m.stack = m.stack[:len(m.stack)-1]
+		if seen[n] == pos+1 {
+			continue
+		}
+		seen[n] = pos + 1
+		nd := &m.re.nodes[n]
+		if nd.op == opAnchor && !m.satisfies(nd.constraint, pos) {
+			continue
+		}
+		list = append(list, thread{n, start})
+		if isEpsilon(nd.op) || nd.op == opBackref {
+			m.stack = append(m.stack, nd.edests...)
+		}
+	}
+	return list
+}
+
+func (m *matcher) initialRegs(start, end int) []int {
+	regs := make([]int, 4*(m.re.nsub+1))
+	for i := range regs {
+		regs[i] = -1
+	}
+	n := 2 * (m.re.nsub + 1)
+	regs[0], regs[1] = start, end
+	regs[n], regs[n+1] = start, end
+	return regs
+}
+
+// updateRegs records the effect of reaching an open or close node, keeping
+// the GNU C library's handling of an empty pass through an optional
+// sub-expression. regs holds the current registers followed by the ones
+// saved at the last non-empty close.
+func (m *matcher) updateRegs(regs []int, n, pos int) {
+	nd := &m.re.nodes[n]
+	half := len(regs) / 2
+	r := 2 * (nd.idx + 1)
+	switch nd.op {
+	case opOpen:
+		regs[r], regs[r+1] = pos, -1
+	case opClose:
+		switch {
+		case regs[r] < pos:
+			regs[r+1] = pos
+			copy(regs[half:], regs[:half])
+		case nd.optional && regs[half+r] != -1:
+			copy(regs[:half], regs[half:])
+		default:
+			regs[r+1] = pos
+		}
+	}
+}
+
+// explore walks every path from n at pos for an expression with
+// back-references. With target unset it records the longest end reached;
+// otherwise it reports whether the end at target can be reached.
+func (m *matcher) explore(n, pos int, regs []int, target *int, seen map[string]bool, best *int) bool {
+	nd := &m.re.nodes[n]
+	if nd.op == opOpen || nd.op == opClose {
+		regs = slices.Clone(regs)
+		m.updateRegs(regs, n, pos)
+	}
+	if seen != nil {
+		key := m.key(n, pos, regs)
+		if seen[key] {
+			return false
+		}
+		seen[key] = true
+	}
+	switch {
+	case n == m.re.end:
+		if target != nil {
+			return pos == *target
+		}
+		if pos > *best {
+			*best = pos
+		}
+		return false
+	case nd.op == opAnchor:
+		if !m.satisfies(nd.constraint, pos) {
+			return false
+		}
+		return m.explore(nd.edests[0], pos, regs, target, seen, best)
+	case isEpsilon(nd.op):
+		found := false
+		for _, d := range nd.edests {
+			if m.explore(d, pos, regs, target, seen, best) {
+				found = true
+				if target != nil {
+					return true
+				}
+			}
+		}
+		return found
+	case nd.op == opBackref:
+		r := 2 * (nd.idx + 1)
+		so, eo := regs[r], regs[r+1]
+		if so < 0 || eo < 0 || pos+eo-so > len(m.in) || m.in[so:eo] != m.in[pos:pos+eo-so] {
+			return false
+		}
+		return m.explore(nd.next, pos+eo-so, regs, target, seen, best)
+	case m.accepts(nd, pos):
+		return m.explore(nd.next, pos+1, regs, target, seen, best)
+	}
+	return false
+}
+
+func (m *matcher) key(n, pos int, regs []int) string {
+	var b strings.Builder
+	b.WriteString(strconv.Itoa(n))
+	b.WriteByte(':')
+	b.WriteString(strconv.Itoa(pos))
+	for _, r := range regs {
+		b.WriteByte(',')
+		b.WriteString(strconv.Itoa(r))
+	}
+	return b.String()
+}
+
+// valid reports whether the end of the match can still be reached from n at
+// pos, which is what keeps n in the GNU C library's sifted states.
+func (m *matcher) valid(n, pos int, regs []int) bool {
+	if m.re.backref {
+		k := m.key(n, pos, regs)
+		if v, ok := m.reachB[k]; ok {
+			return v
+		}
+		end := m.end
+		var seen map[string]bool
+		if m.re.plural {
+			seen = map[string]bool{}
+		}
+		v := m.explore(n, pos, regs, &end, seen, nil)
+		m.reachB[k] = v
+		return v
+	}
+	return pos >= m.start && pos <= m.end && m.sifted[pos-m.start][n]
+}
+
+// sift computes, for each position of the match, the nodes from which the
+// end of the match is reachable.
+func (m *matcher) sift() {
+	nodes := m.re.nodes
+	m.sifted = make([][]bool, m.end-m.start+1)
+	for pos := m.end; pos >= m.start; pos-- {
+		in := make([]bool, len(nodes))
+		if pos == m.end {
+			in[m.re.end] = true
+		}
+		for n := range nodes {
+			nd := &nodes[n]
+			if !isEpsilon(nd.op) && nd.op != opEnd && nd.op != opBackref && pos < m.end &&
+				m.accepts(nd, pos) && m.sifted[pos+1-m.start][nd.next] {
+				in[n] = true
+			}
+		}
+		for changed := true; changed; {
+			changed = false
+			for n := range nodes {
+				nd := &nodes[n]
+				if in[n] || !isEpsilon(nd.op) || nd.op == opAnchor && !m.satisfies(nd.constraint, pos) {
+					continue
+				}
+				for _, d := range nd.edests {
+					if in[d] {
+						in[n], changed = true, true
+						break
+					}
+				}
+			}
+		}
+		m.sifted[pos-m.start] = in
+	}
+}
+
+type failPoint struct {
+	pos, node int
+	regs      []int
+	eps       map[int]bool
+}
+
+// registers walks from start to end the way the GNU C library's set_regs
+// does, so that the sub-expressions come from the same path.
+func (m *matcher) registers(start, end int) []int {
+	m.start, m.end = start, end
+	m.reachB = map[string]bool{}
+	if !m.re.backref {
+		m.sift()
+	}
+	regs := m.initialRegs(start, end)
+	half := len(regs) / 2
+	var stack []failPoint
+	useStack := m.re.backref && m.re.plural
+	eps := map[int]bool{}
+	cur, pos := m.re.init, start
+	skipUpdate := false
+	for {
+		if !skipUpdate {
+			m.updateRegs(regs, cur, pos)
+		}
+		skipUpdate = false
+		if (pos == end && cur == m.re.end) || (useStack && eps[cur]) {
+			open := false
+			for i := 0; useStack && i < half; i += 2 {
+				if regs[i] > -1 && regs[i+1] == -1 {
+					open = true
+					break
+				}
+			}
+			if !open {
+				return regs[:half]
+			}
+			if len(stack) == 0 {
+				return nil
+			}
+			f := stack[len(stack)-1]
+			stack = stack[:len(stack)-1]
+			pos, cur, regs, eps = f.pos, f.node, f.regs, f.eps
+		}
+		next := m.proceed(cur, &pos, regs, eps, &stack, useStack)
+		if next < 0 {
+			if len(stack) == 0 {
+				return nil
+			}
+			f := stack[len(stack)-1]
+			stack = stack[:len(stack)-1]
+			pos, next, regs, eps = f.pos, f.node, f.regs, f.eps
+		}
+		cur = next
+	}
+}
+
+func (m *matcher) proceed(n int, pos *int, regs []int, eps map[int]bool, stack *[]failPoint, useStack bool) int {
+	nd := &m.re.nodes[n]
+	if isEpsilon(nd.op) {
+		eps[n] = true
+		dest := -1
+		for _, cand := range nd.edests {
+			if !m.valid(cand, *pos, regs) {
+				continue
+			}
+			if dest == -1 {
+				dest = cand
+				continue
+			}
+			if eps[dest] {
+				return cand
+			}
+			if useStack {
+				*stack = append(*stack, failPoint{pos: *pos, node: cand, regs: slices.Clone(regs), eps: maps.Clone(eps)})
+			}
+			break
+		}
+		return dest
+	}
+	accepted := 0
+	if nd.op == opBackref {
+		r := 2 * (nd.idx + 1)
+		so, eo := regs[r], regs[r+1]
+		accepted = eo - so
+		if useStack {
+			if so == -1 || eo == -1 {
+				return -1
+			}
+			if accepted > 0 && (*pos+accepted > len(m.in) || m.in[so:eo] != m.in[*pos:*pos+accepted]) {
+				return -1
+			}
+		}
+		if accepted == 0 {
+			eps[n] = true
+			if dest := nd.edests[0]; m.valid(dest, *pos, regs) {
+				return dest
+			}
+		}
+	}
+	if accepted != 0 || m.accepts(nd, *pos) {
+		dest := nd.next
+		if accepted == 0 {
+			*pos++
+		} else {
+			*pos += accepted
+		}
+		if useStack && (*pos > m.end || !m.valid(dest, *pos, regs)) {
+			return -1
+		}
+		clear(eps)
+		return dest
+	}
+	return -1
+}
