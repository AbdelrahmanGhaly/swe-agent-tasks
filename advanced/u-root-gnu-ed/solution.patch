@@ -0,0 +1,731 @@
+// Copyright 2026 the u-root Authors. All rights reserved
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Package bre implements POSIX basic regular expressions the way the GNU C
+// library's regcomp and regexec handle them in the C locale.
+//
+// That includes the GNU operators (\+ \? \| \< \> \b \B \w \W \s \S \` \'),
+// intervals, bracket expressions with classes, back-references, the context
+// rules for *, ^ and $, and the library's choice among equally long matches:
+// the leftmost-longest match, with sub-expressions taken from the first path
+// in the library's preference order that ends there.
+package bre
+
+import "strings"
+
+// Error is a compilation error. Its text is the message the GNU C library
+// reports for the same expression.
+type Error struct {
+	msg string
+}
+
+func (e *Error) Error() string { return e.msg }
+
+// Compilation errors, in the GNU C library's wording.
+var (
+	// ErrCollate reports an invalid collating element (REG_ECOLLATE).
+	ErrCollate = &Error{"Invalid collation character"}
+	// ErrCtype reports an unknown character class name (REG_ECTYPE).
+	ErrCtype = &Error{"Invalid character class name"}
+	// ErrEscape reports a trailing backslash (REG_EESCAPE).
+	ErrEscape = &Error{"Trailing backslash"}
+	// ErrSubreg reports a back-reference to a missing sub-expression (REG_ESUBREG).
+	ErrSubreg = &Error{"Invalid back reference"}
+	// ErrBadPat reports an invalid expression (REG_BADPAT).
+	ErrBadPat = &Error{"Invalid regular expression"}
+	// ErrBrack reports an unmatched bracket expression (REG_EBRACK).
+	ErrBrack = &Error{"Unmatched [, [^, [:, [., or [="}
+	// ErrParen reports an unmatched \( or \) (REG_EPAREN).
+	ErrParen = &Error{"Unmatched ( or \\("}
+	// ErrBrace reports an unmatched \{ (REG_EBRACE).
+	ErrBrace = &Error{"Unmatched \\{"}
+	// ErrBadBR reports invalid interval bounds (REG_BADBR).
+	ErrBadBR = &Error{"Invalid content of \\{\\}"}
+	// ErrRange reports an invalid range end point (REG_ERANGE).
+	ErrRange = &Error{"Invalid range end"}
+	// ErrBadRpt reports a repetition with nothing to repeat (REG_BADRPT).
+	ErrBadRpt = &Error{"Invalid preceding regular expression"}
+	// ErrSize reports an expression too large to compile (REG_ESIZE).
+	ErrSize = &Error{"Regular expression too big"}
+)
+
+const dupMax = 0x7fff
+
+type opcode uint8
+
+const (
+	opChar opcode = iota
+	opAny
+	opSet
+	opBackref
+	opOpen
+	opClose
+	opAnchor
+	opAlt
+	opStar
+	opEnd
+	opConcat
+	opSubexp
+)
+
+// Context constraints carried by anchors.
+const (
+	prevWord = 1 << iota
+	prevNotWord
+	nextWord
+	nextNotWord
+	prevNewline
+	nextNewline
+	prevBegbuf
+	nextEndbuf
+
+	wordFirst    = prevNotWord | nextWord
+	wordLast     = prevWord | nextNotWord
+	insideWord   = prevWord | nextWord
+	insideNoWord = prevNotWord | nextNotWord
+)
+
+// Pseudo-constraints for \b and \B, expanded into alternations when parsed.
+const (
+	wordDelim    = 1 << 16
+	notWordDelim = 1 << 17
+)
+
+type tree struct {
+	op          opcode
+	c           byte
+	set         *[256]bool
+	idx         int
+	constraint  int
+	optional    bool
+	left, right *tree
+	first, next *tree
+	node        int
+}
+
+type tokenKind uint8
+
+const (
+	tChar tokenKind = iota
+	tEnd
+	tBackslash
+	tAny
+	tBracket
+	tStar
+	tPlus
+	tQuestion
+	tOpenDup
+	tCloseDup
+	tOpenGroup
+	tCloseGroup
+	tAlt
+	tBackref
+	tAnchor
+	tWord
+	tNotWord
+	tSpace
+	tNotSpace
+)
+
+type token struct {
+	kind       tokenKind
+	c          byte
+	idx        int
+	constraint int
+}
+
+type parser struct {
+	raw       string // the expression as written
+	pat       string // the expression as matched: upper-cased when ignoring case
+	icase     bool
+	pos       int
+	tok       token
+	nsub      int
+	completed uint
+	backref   bool
+}
+
+// peek reads the token at the current position without consuming it.
+// caretHere makes ^ an anchor, as it is after \( and \|. The byte after a
+// backslash is read as written, as the GNU C library reads it, so \w and \W
+// stay apart when case is ignored; an escaped lower-case letter then matches
+// nothing.
+func (p *parser) peek(at int, caretHere bool) (token, int) {
+	if at >= len(p.pat) {
+		return token{kind: tEnd}, 0
+	}
+	c := p.pat[at]
+	if c == '\\' {
+		if at+1 >= len(p.pat) {
+			return token{kind: tBackslash}, 1
+		}
+		c2 := p.raw[at+1]
+		t := token{kind: tChar, c: c2}
+		switch c2 {
+		case '|':
+			t.kind = tAlt
+		case '1', '2', '3', '4', '5', '6', '7', '8', '9':
+			t.kind, t.idx = tBackref, int(c2-'1')
+		case '<':
+			t.kind, t.constraint = tAnchor, wordFirst
+		case '>':
+			t.kind, t.constraint = tAnchor, wordLast
+		case 'b':
+			t.kind, t.constraint = tAnchor, wordDelim
+		case 'B':
+			t.kind, t.constraint = tAnchor, notWordDelim
+		case 'w':
+			t.kind = tWord
+		case 'W':
+			t.kind = tNotWord
+		case 's':
+			t.kind = tSpace
+		case 'S':
+			t.kind = tNotSpace
+		case '`':
+			t.kind, t.constraint = tAnchor, prevBegbuf
+		case '\'':
+			t.kind, t.constraint = tAnchor, nextEndbuf
+		case '(':
+			t.kind = tOpenGroup
+		case ')':
+			t.kind = tCloseGroup
+		case '+':
+			t.kind = tPlus
+		case '?':
+			t.kind = tQuestion
+		case '{':
+			t.kind = tOpenDup
+		case '}':
+			t.kind = tCloseDup
+		}
+		return t, 2
+	}
+	t := token{kind: tChar, c: c}
+	switch c {
+	case '*':
+		t.kind = tStar
+	case '[':
+		t.kind = tBracket
+	case '.':
+		t.kind = tAny
+	case '^':
+		if caretHere || at == 0 {
+			t.kind, t.constraint = tAnchor, prevNewline
+		}
+	case '$':
+		if at+1 == len(p.pat) {
+			t.kind, t.constraint = tAnchor, nextNewline
+		} else if n, _ := p.peek(at+1, false); n.kind == tAlt || n.kind == tCloseGroup {
+			t.kind, t.constraint = tAnchor, nextNewline
+		}
+	}
+	return t, 1
+}
+
+func (p *parser) fetch(caretHere bool) {
+	var width int
+	p.tok, width = p.peek(p.pos, caretHere)
+	p.pos += width
+}
+
+// Compile parses expr as a basic regular expression. With icase set, letters
+// match without regard to case, as with REG_ICASE.
+func Compile(expr string, icase bool) (*Regexp, error) {
+	p := &parser{raw: expr, pat: expr, icase: icase}
+	if icase {
+		p.pat = upper(expr)
+	}
+	p.fetch(true)
+	t, err := p.regExp(0)
+	if err != nil {
+		return nil, err
+	}
+	root := &tree{op: opEnd}
+	if t != nil {
+		root = &tree{op: opConcat, left: t, right: root}
+	}
+	root = lowerSubexps(root)
+	re := &Regexp{nsub: p.nsub, icase: icase, backref: p.backref}
+	re.build(root)
+	return re, nil
+}
+
+func (p *parser) regExp(nest int) (*tree, error) {
+	initial := p.completed
+	t, err := p.branch(nest)
+	if err != nil {
+		return nil, err
+	}
+	for p.tok.kind == tAlt {
+		p.fetch(true)
+		var b *tree
+		if p.tok.kind != tAlt && p.tok.kind != tEnd && (nest == 0 || p.tok.kind != tCloseGroup) {
+			accumulated := p.completed
+			p.completed = initial
+			if b, err = p.branch(nest); err != nil {
+				return nil, err
+			}
+			p.completed |= accumulated
+		}
+		t = &tree{op: opAlt, left: t, right: b}
+	}
+	return t, nil
+}
+
+func (p *parser) branch(nest int) (*tree, error) {
+	t, err := p.expression(nest)
+	if err != nil {
+		return nil, err
+	}
+	for p.tok.kind != tAlt && p.tok.kind != tEnd && (nest == 0 || p.tok.kind != tCloseGroup) {
+		e, err := p.expression(nest)
+		if err != nil {
+			return nil, err
+		}
+		switch {
+		case t != nil && e != nil:
+			t = &tree{op: opConcat, left: t, right: e}
+		case t == nil:
+			t = e
+		}
+	}
+	return t, nil
+}
+
+func (p *parser) expression(nest int) (*tree, error) {
+	var t *tree
+	switch p.tok.kind {
+	case tChar, tStar, tPlus, tQuestion, tCloseDup:
+		t = &tree{op: opChar, c: p.tok.c}
+	case tOpenGroup:
+		var err error
+		if t, err = p.subExp(nest + 1); err != nil {
+			return nil, err
+		}
+	case tBracket:
+		set, err := p.bracket()
+		if err != nil {
+			return nil, err
+		}
+		t = &tree{op: opSet, set: set}
+	case tBackref:
+		if p.completed&(1<<p.tok.idx) == 0 {
+			return nil, ErrSubreg
+		}
+		p.backref = true
+		t = &tree{op: opBackref, idx: p.tok.idx}
+	case tOpenDup:
+		return nil, ErrBadRpt
+	case tCloseGroup:
+		return nil, ErrParen
+	case tAnchor:
+		switch p.tok.constraint {
+		case wordDelim:
+			t = &tree{op: opAlt, left: &tree{op: opAnchor, constraint: wordFirst}, right: &tree{op: opAnchor, constraint: wordLast}}
+		case notWordDelim:
+			t = &tree{op: opAlt, left: &tree{op: opAnchor, constraint: insideWord}, right: &tree{op: opAnchor, constraint: insideNoWord}}
+		default:
+			t = &tree{op: opAnchor, constraint: p.tok.constraint}
+		}
+		p.fetch(false)
+		return t, nil
+	case tAny:
+		t = &tree{op: opAny}
+	case tWord, tNotWord:
+		t = &tree{op: opSet, set: classSet("alnum", "_", p.tok.kind == tNotWord)}
+	case tSpace, tNotSpace:
+		t = &tree{op: opSet, set: classSet("space", "", p.tok.kind == tNotSpace)}
+	case tAlt, tEnd:
+		return nil, nil
+	case tBackslash:
+		return nil, ErrEscape
+	}
+	p.fetch(false)
+	for p.tok.kind == tStar || p.tok.kind == tPlus || p.tok.kind == tQuestion || p.tok.kind == tOpenDup {
+		var err error
+		if t, err = p.dupOp(t); err != nil {
+			return nil, err
+		}
+		if p.tok.kind == tStar || p.tok.kind == tOpenDup {
+			return nil, ErrBadRpt
+		}
+	}
+	return t, nil
+}
+
+func (p *parser) subExp(nest int) (*tree, error) {
+	cur := p.nsub
+	p.nsub++
+	p.fetch(true)
+	var body *tree
+	if p.tok.kind != tCloseGroup {
+		var err error
+		if body, err = p.regExp(nest); err != nil {
+			return nil, err
+		}
+		if p.tok.kind != tCloseGroup {
+			return nil, ErrParen
+		}
+	}
+	if cur < 9 {
+		p.completed |= 1 << cur
+	}
+	return &tree{op: opSubexp, idx: cur, left: body}, nil
+}
+
+// number reads the digits of an interval bound. It returns -1 when there
+// are none and -2 when the bound is malformed or the expression ends.
+func (p *parser) number() int {
+	num := -1
+	for {
+		p.fetch(false)
+		c := p.tok.c
+		if p.tok.kind == tEnd {
+			return -2
+		}
+		if p.tok.kind == tCloseDup || (p.tok.kind == tChar && c == ',') {
+			return num
+		}
+		switch {
+		case p.tok.kind != tChar || c < '0' || c > '9' || num == -2:
+			num = -2
+		case num == -1:
+			num = int(c - '0')
+		default:
+			num = min(dupMax+1, num*10+int(c-'0'))
+		}
+	}
+}
+
+func (p *parser) dupOp(elem *tree) (*tree, error) {
+	start, end := 0, -1
+	switch p.tok.kind {
+	case tOpenDup:
+		start = p.number()
+		if start == -1 {
+			if p.tok.kind != tChar || p.tok.c != ',' {
+				return nil, ErrBadBR
+			}
+			start = 0
+		}
+		if start != -2 {
+			switch {
+			case p.tok.kind == tCloseDup:
+				end = start
+			case p.tok.kind == tChar && p.tok.c == ',':
+				end = p.number()
+			default:
+				end = -2
+			}
+		}
+		if start == -2 || end == -2 {
+			if p.tok.kind == tEnd {
+				return nil, ErrBrace
+			}
+			return nil, ErrBadBR
+		}
+		if (end != -1 && start > end) || p.tok.kind != tCloseDup {
+			return nil, ErrBadBR
+		}
+		if bound := end; bound == -1 && start > dupMax || bound > dupMax {
+			return nil, ErrSize
+		}
+	case tPlus:
+		start = 1
+	case tQuestion:
+		end = 1
+	}
+	p.fetch(false)
+	if elem == nil || start == 0 && end == 0 {
+		return nil, nil
+	}
+	var old *tree
+	if start > 0 {
+		t := elem
+		for i := 2; i <= start; i++ {
+			elem = duplicate(elem)
+			t = &tree{op: opConcat, left: t, right: elem}
+		}
+		if start == end {
+			return t, nil
+		}
+		elem = duplicate(elem)
+		old = t
+	}
+	if elem.op == opSubexp {
+		elem.optional = true
+	}
+	op := opAlt
+	if end == -1 {
+		op = opStar
+	}
+	t := &tree{op: op, left: elem}
+	for i := start + 2; end != -1 && i <= end; i++ {
+		elem = duplicate(elem)
+		t = &tree{op: opConcat, left: t, right: elem}
+		t = &tree{op: opAlt, left: t}
+	}
+	if old != nil {
+		t = &tree{op: opConcat, left: old, right: t}
+	}
+	return t, nil
+}
+
+func duplicate(t *tree) *tree {
+	if t == nil {
+		return nil
+	}
+	c := *t
+	c.left, c.right = duplicate(t.left), duplicate(t.right)
+	return &c
+}
+
+// bracket parses a bracket expression after its opening [.
+func (p *parser) bracket() (*[256]bool, error) {
+	set := new([256]bool)
+	negate := false
+	if p.pos >= len(p.pat) {
+		return nil, ErrBadPat
+	}
+	if p.pat[p.pos] == '^' {
+		negate = true
+		p.pos++
+		if p.pos >= len(p.pat) {
+			return nil, ErrBadPat
+		}
+	}
+	first := true
+	for {
+		if p.pos >= len(p.pat) {
+			return nil, ErrBrack
+		}
+		start, err := p.bracketElement(first)
+		if err != nil {
+			return nil, err
+		}
+		first = false
+		if p.pos >= len(p.pat) {
+			return nil, ErrBrack
+		}
+		isRange := false
+		if start.kind != elemClass && start.kind != elemEquiv && p.pat[p.pos] == '-' {
+			if p.pos+1 >= len(p.pat) {
+				return nil, ErrBrack
+			}
+			if p.pat[p.pos+1] != ']' {
+				p.pos++
+				isRange = true
+			}
+		}
+		if isRange {
+			end, err := p.bracketElement(true)
+			if err != nil {
+				return nil, err
+			}
+			if err := buildRange(set, start, end); err != nil {
+				return nil, err
+			}
+		} else if err := start.add(set, p.icase); err != nil {
+			return nil, err
+		}
+		if p.pos >= len(p.pat) {
+			return nil, ErrBrack
+		}
+		if p.pat[p.pos] == ']' {
+			p.pos++
+			break
+		}
+	}
+	if negate {
+		for i := range set {
+			set[i] = !set[i]
+		}
+	}
+	return set, nil
+}
+
+type elemKind uint8
+
+const (
+	elemChar elemKind = iota
+	elemColl
+	elemEquiv
+	elemClass
+)
+
+type bracketElem struct {
+	kind elemKind
+	c    byte
+	name string
+}
+
+func (p *parser) bracketElement(acceptHyphen bool) (bracketElem, error) {
+	c := p.pat[p.pos]
+	if c == '[' && p.pos+1 < len(p.pat) {
+		switch d := p.pat[p.pos+1]; d {
+		case '.', '=', ':':
+			p.pos += 2
+			return p.bracketSymbol(d)
+		}
+	}
+	if c == '-' && !acceptHyphen {
+		if p.pos+1 >= len(p.pat) || p.pat[p.pos+1] != ']' {
+			return bracketElem{}, ErrRange
+		}
+	}
+	p.pos++
+	return bracketElem{kind: elemChar, c: c}, nil
+}
+
+func (p *parser) bracketSymbol(delim byte) (bracketElem, error) {
+	if p.pos >= len(p.pat) {
+		return bracketElem{}, ErrBrack
+	}
+	var name []byte
+	for i := 0; ; i++ {
+		if i >= 32 {
+			return bracketElem{}, ErrBrack
+		}
+		ch := p.pat[p.pos]
+		if delim == ':' {
+			ch = p.raw[p.pos]
+		}
+		p.pos++
+		if p.pos >= len(p.pat) {
+			return bracketElem{}, ErrBrack
+		}
+		if ch == delim && p.pat[p.pos] == ']' {
+			break
+		}
+		name = append(name, ch)
+	}
+	p.pos++
+	e := bracketElem{name: string(name)}
+	switch delim {
+	case '.':
+		e.kind = elemColl
+	case '=':
+		e.kind = elemEquiv
+	default:
+		e.kind = elemClass
+	}
+	return e, nil
+}
+
+func (e bracketElem) add(set *[256]bool, icase bool) error {
+	switch e.kind {
+	case elemChar:
+		set[e.c] = true
+	case elemColl, elemEquiv:
+		if len(e.name) != 1 {
+			return ErrCollate
+		}
+		set[e.name[0]] = true
+	case elemClass:
+		name := e.name
+		if icase && (name == "upper" || name == "lower") {
+			name = "alpha"
+		}
+		f, ok := classes[name]
+		if !ok {
+			return ErrCtype
+		}
+		for i := range 256 {
+			if f(byte(i)) {
+				set[i] = true
+			}
+		}
+	}
+	return nil
+}
+
+func buildRange(set *[256]bool, start, end bracketElem) error {
+	if start.kind == elemEquiv || start.kind == elemClass || end.kind == elemEquiv || end.kind == elemClass {
+		return ErrRange
+	}
+	if start.kind == elemColl && len(start.name) != 1 || end.kind == elemColl && len(end.name) != 1 {
+		return ErrCollate
+	}
+	lo, hi := start.c, end.c
+	if start.kind == elemColl {
+		lo = start.name[0]
+	}
+	if end.kind == elemColl {
+		hi = end.name[0]
+	}
+	if lo > hi {
+		return ErrRange
+	}
+	for c := int(lo); c <= int(hi); c++ {
+		set[c] = true
+	}
+	return nil
+}
+
+// classes are the character classes the GNU C library knows in the C locale.
+// Any other name, such as [:word:], is an invalid class name there too.
+var classes = map[string]func(byte) bool{
+	"alnum":  func(c byte) bool { return isAlpha(c) || isDigit(c) },
+	"alpha":  isAlpha,
+	"blank":  func(c byte) bool { return c == ' ' || c == '\t' },
+	"cntrl":  func(c byte) bool { return c < 0x20 || c == 0x7f },
+	"digit":  isDigit,
+	"graph":  func(c byte) bool { return c > 0x20 && c < 0x7f },
+	"lower":  func(c byte) bool { return c >= 'a' && c <= 'z' },
+	"print":  func(c byte) bool { return c >= 0x20 && c < 0x7f },
+	"punct":  func(c byte) bool { return c > 0x20 && c < 0x7f && !isAlpha(c) && !isDigit(c) },
+	"space":  func(c byte) bool { return c == ' ' || c >= '\t' && c <= '\r' },
+	"upper":  func(c byte) bool { return c >= 'A' && c <= 'Z' },
+	"xdigit": func(c byte) bool { return isDigit(c) || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F' },
+}
+
+func isAlpha(c byte) bool { return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' }
+
+func isDigit(c byte) bool { return c >= '0' && c <= '9' }
+
+func isWord(c byte) bool { return isAlpha(c) || isDigit(c) || c == '_' }
+
+func classSet(class, extra string, negate bool) *[256]bool {
+	set := new([256]bool)
+	f := classes[class]
+	for i := range 256 {
+		set[i] = f(byte(i)) || strings.IndexByte(extra, byte(i)) >= 0
+		if negate {
+			set[i] = !set[i]
+		}
+	}
+	return set
+}
+
+// upper folds the ASCII letters of s to upper case and leaves every other
+// byte as it is, so offsets in the result are offsets in s.
+func upper(s string) string {
+	b := []byte(s)
+	for i, c := range b {
+		if c >= 'a' && c <= 'z' {
+			b[i] = c - 'a' + 'A'
+		}
+	}
+	return string(b)
+}
+
+// lowerSubexps replaces each sub-expression node by an open node, its body
+// and a close node.
+func lowerSubexps(t *tree) *tree {
+	if t == nil {
+		return nil
+	}
+	t.left, t.right = lowerSubexps(t.left), lowerSubexps(t.right)
+	if t.op != opSubexp {
+		return t
+	}
+	open := &tree{op: opOpen, idx: t.idx, optional: t.optional}
+	cls := &tree{op: opClose, idx: t.idx, optional: t.optional}
+	rest := cls
+	if t.left != nil {
+		rest = &tree{op: opConcat, left: t.left, right: cls}
+	}
+	return &tree{op: opConcat, left: open, right: rest}
+}
