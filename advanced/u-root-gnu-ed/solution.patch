-// Rewind restores the previous file
-func (f *FileBuffer) Rewind() {
-	if f.Dirty() || f.lastDirty {
-		f.addr = f.lastAddr
-		f.file = f.lastFile
-		f.dirty = f.lastDirty
-		f.mod = true
-	}
-}
-
-// Touch is the correct way (even internally) to set the dirty & modified bits
-func (f *FileBuffer) Touch() {
-	f.dirty = true
-	f.mod = true
-}
