new file mode 100644
index 000000000..40e70f09d
--- /dev/null
+++ b/cmds/exp/ed/buffer.go
@@ -0,0 +1,239 @@
+// Copyright 2019 the u-root Authors. All rights reserved
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// buffer.go - the editor buffer: lines, undo, marks, the cut buffer and the
+// lines a global command still has to visit
+package main
+
+import "slices"
+
+// A line is one line of text. Lines are compared by identity: marks and
+// global commands follow a line wherever it moves, and undo brings the same
+// lines back.
+type line struct {
+	text string
+}
+
+// A buffer holds the lines being edited, addressed from 1.
+type buffer struct {
+	lines    []*line
+	cur      int
+	modified bool
+
+	// The state undo returns to, and whether anything changed since it was
+	// recorded. A negative uCur disables undo until the next change.
+	uLines    []*line
+	uCur      int
+	uModified bool
+	uChanged  bool
+
+	marks  [26]*line
+	yanked []string
+	// The lines a global command selected, in order, and those of them it
+	// still has to visit.
+	active  []*line
+	pending map[*line]bool
+}
+
+func newBuffer() *buffer {
+	b := &buffer{}
+	b.resetUndo()
+	return b
+}
+
+func (b *buffer) last() int { return len(b.lines) }
+
+func (b *buffer) text(addr int) string { return b.lines[addr-1].text }
+
+// addrOf returns the address of l, or -1 if l is not in the buffer.
+func (b *buffer) addrOf(l *line) int {
+	return b.addrNear(l, 0)
+}
+
+// addrNear is addrOf for a line that is probably at or after addr, as the
+// next line a global command visits usually is: it looks there first.
+func (b *buffer) addrNear(l *line, addr int) int {
+	from := min(max(addr-1, 0), len(b.lines))
+	if i := slices.Index(b.lines[from:], l); i >= 0 {
+		return from + i + 1
+	}
+	if i := slices.Index(b.lines[:from], l); i >= 0 {
+		return i + 1
+	}
+	return -1
+}
+
+// clearUndo records the current state as the one undo returns to. Lines
+// that left the buffer since the last record are gone for good, so their
+// marks go with them.
+func (b *buffer) clearUndo() {
+	for i, m := range b.marks {
+		if m != nil && b.addrOf(m) < 0 {
+			b.marks[i] = nil
+		}
+	}
+	b.uLines = slices.Clone(b.lines)
+	b.uCur = b.cur
+	b.uModified = b.modified
+	b.uChanged = false
+}
+
+// resetUndo forgets the undo state entirely, as after reading a new file.
+func (b *buffer) resetUndo() {
+	b.clearUndo()
+	b.uCur = -1
+	b.uModified = false
+}
+
+// undo swaps the buffer with the recorded state, so a second undo redoes.
+func (b *buffer) undo() error {
+	if !b.uChanged || b.uCur < 0 {
+		return errNothingToUndo
+	}
+	b.lines, b.uLines = b.uLines, b.lines
+	b.cur, b.uCur = b.uCur, b.cur
+	b.modified, b.uModified = b.uModified, b.modified
+	b.active, b.pending = nil, nil
+	return nil
+}
+
+func (b *buffer) changed() {
+	b.uChanged = true
+	b.modified = true
+}
+
+// insert adds texts after addr and makes the last of them current.
+func (b *buffer) insert(addr int, texts []string) {
+	if len(texts) > 0 {
+		b.add(addr, texts)
+		b.modified = true
+	}
+}
+
+// add inserts texts after addr without counting it as a modification, as
+// when a file is read.
+func (b *buffer) add(addr int, texts []string) {
+	nl := make([]*line, len(texts))
+	for i, t := range texts {
+		nl[i] = &line{text: t}
+	}
+	b.lines = slices.Insert(b.lines, addr, nl...)
+	b.cur = addr + len(texts)
+	if len(texts) > 0 {
+		b.uChanged = true
+	}
+}
+
+// remove deletes lines from through to, puts them in the cut buffer, and
+// makes the line after them current.
+func (b *buffer) remove(from, to int, global bool) {
+	b.yank(from, to)
+	gone := b.lines[from-1 : to]
+	if global {
+		b.deactivate(gone)
+	}
+	b.lines = slices.Delete(b.lines, from-1, to)
+	b.cur = min(from, b.last())
+	b.changed()
+}
+
+// yank copies lines from through to into the cut buffer. Like GNU ed's y, it
+// leaves the current address unchanged.
+func (b *buffer) yank(from, to int) {
+	b.yanked = b.yanked[:0]
+	for a := from; a <= to; a++ {
+		b.yanked = append(b.yanked, b.text(a))
+	}
+}
+
+// move moves lines from through to after addr. Only the lines between the
+// moved ones and addr shift.
+func (b *buffer) move(from, to, addr int, global bool) {
+	if addr == from-1 || addr == to {
+		b.cur = to
+		b.modified = true
+		if global {
+			b.deactivate(b.lines[from-1 : to])
+		}
+		return
+	}
+	moved := slices.Clone(b.lines[from-1 : to])
+	n := len(moved)
+	dest := addr
+	if addr < from {
+		copy(b.lines[addr+n:to], b.lines[addr:from-1])
+	} else {
+		dest = addr - n
+		copy(b.lines[from-1:dest], b.lines[to:addr])
+	}
+	copy(b.lines[dest:dest+n], moved)
+	b.cur = dest + n
+	if global {
+		b.deactivate(moved)
+	}
+	b.changed()
+}
+
+// copyLines copies lines from through to after addr.
+func (b *buffer) copyLines(from, to, addr int) {
+	var texts []string
+	for a := from; a <= to; a++ {
+		texts = append(texts, b.text(a))
+	}
+	b.insert(addr, texts)
+}
+
+// setMark marks the line at addr. As in GNU ed, the mark is lost when the line
+// is deleted or modified, since a modified line is a new line; undo brings the
+// old line back with its mark.
+func (b *buffer) setMark(c byte, addr int) error {
+	if c < 'a' || c > 'z' {
+		return errInvalidMark
+	}
+	b.marks[c-'a'] = b.lines[addr-1]
+	return nil
+}
+
+// markAddr returns the address of the line marked c. In an empty buffer
+// every mark stands for address 0, whatever line it was set on.
+func (b *buffer) markAddr(c byte) (int, error) {
+	if c < 'a' || c > 'z' {
+		return -1, errInvalidMark
+	}
+	if b.last() == 0 {
+		return 0, nil
+	}
+	if a := b.addrOf(b.marks[c-'a']); a >= 0 {
+		return a, nil
+	}
+	return -1, errInvalidAddress
+}
+
+// activate selects the lines a global command visits.
+func (b *buffer) activate(lines []*line) {
+	b.active = lines
+	b.pending = make(map[*line]bool, len(lines))
+	for _, l := range lines {
+		b.pending[l] = true
+	}
+}
+
+func (b *buffer) deactivate(lines []*line) {
+	for _, l := range lines {
+		delete(b.pending, l)
+	}
+}
+
+// nextActive returns the next line a global command has to visit.
+func (b *buffer) nextActive() *line {
+	for len(b.active) > 0 {
+		l := b.active[0]
+		b.active = b.active[1:]
+		if b.pending[l] {
+			delete(b.pending, l)
+			return l
+		}
+	}
+	return nil
+}
