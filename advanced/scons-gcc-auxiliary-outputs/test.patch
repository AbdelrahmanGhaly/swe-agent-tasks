+            report('b', env.Object('obj/b.o', 'src/b.cpp', CXXFLAGS=['-MMD', '-MFdeps/b.d']))
+            report('e', env.Object('obj/e.o', 'src/e.cc', CCFLAGS=['-MF', 'deps/e.d', '-MMD']))
+            report('g', env.Object('obj/g.o', 'src/g.C', CCFLAGS=['-MD', '-MF', 'deps/${SOURCE.filebase}.dep']))
+        ''')
+        self.assertEqual(
+            declared,
+            {'a': ['deps/a.dep'], 'b': ['deps/b.d'], 'e': ['deps/e.d'], 'g': ['deps/g.dep']},
