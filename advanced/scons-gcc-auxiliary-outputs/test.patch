+class DependencyFileTestCase(SideEffectsTestCase):
+    def test_md_and_mmd_write_beside_the_object(self) -> None:
+        declared = self.declare('''
+            report('a', env.Object('obj/a.o', 'src/a.c', CCFLAGS=['-MD']))
+            report('b', env.StaticObject('obj/b.o', 'src/b.cpp', CXXFLAGS=['-MMD']))
+            report('e', env.Object('e.o', 'src/e.cc', CCFLAGS=['-MMD']))
+        ''')
+        self.assertEqual(declared, {'a': ['obj/a.d'], 'b': ['obj/b.d'], 'e': ['e.d']})
+
+    def test_named_from_the_object_without_its_last_suffix(self) -> None:
+        declared = self.declare('''
+            report('x', env.Object('obj/a.x.o', 'src/a.c', CCFLAGS=['-MD']))
+            report('obj', env.Object('obj/b.obj', 'src/b.cpp', CCFLAGS=['-MD']))
+            report('plain', env.Object('out/plain', 'src/f.cxx', CCFLAGS=['-MMD']))
+        ''')
+        self.assertEqual(declared, {'x': ['obj/a.x.d'], 'obj': ['obj/b.d'], 'plain': ['out/plain.d']})
+
+    def test_mf_names_the_file(self) -> None:
