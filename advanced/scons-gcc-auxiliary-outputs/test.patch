+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import textwrap
+import unittest
+
+REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+SCONS = os.path.join(REPO, 'scripts', 'scons.py')
+
+SOURCES = {
+    'src/a.c': 'int a(int x) { return x + 1; }\n',
+    'src/b.cpp': 'int b(int x) { return x * 2; }\n',
+    'src/c.S': '\t.text\n\t.globl c\nc:\n\tret\n',
+    'src/d.sx': '\t.text\n\t.globl d\nd:\n\tret\n',
+    'src/e.cc': 'int e() { return 3; }\n',
+    'src/f.cxx': 'int f() { return 4; }\n',
+    'src/g.C': 'int g() { return 5; }\n',
+    'src/h.c++': 'int h() { return 6; }\n',
+    'src/main.c': 'int main(void) { return 0; }\n',
+}
+
+TOOLS = "env = Environment(tools=['gcc', 'g++', 'gnulink', 'gas', 'ar'])"
+
+PROLOG = '''\
+import contextlib
+import json
+import os
+import subprocess
+from unittest import mock
+
+_launched = []
+_real_popen = subprocess.Popen
+
+
+class _RecordingPopen(_real_popen):
+    def __init__(self, args, *a, **k):
+        _launched.append(args if isinstance(args, str) else ' '.join(str(x) for x in args))
+        super().__init__(args, *a, **k)
+
+
+subprocess.Popen = _RecordingPopen
+{environment}
+subprocess.Popen = _real_popen
+
+_reports = []
+_started = []
+
+
+def report(name, nodes):
+    _reports.append((name, list(nodes)))
+
+
+def _refuse(*args, **kwargs):
+    _started.append(repr(args)[:200])
+    raise OSError('no program may be started while targets are declared')
+
+
+_launchers = [(subprocess, 'Popen'), (os, 'system'), (os, 'popen')]
+for _name in ('fork', 'forkpty', 'posix_spawn', 'posix_spawnp', 'spawnv', 'spawnve',
+              'spawnvp', 'spawnvpe', 'execv', 'execve', 'execvp', 'execvpe'):
+    if hasattr(os, _name):
+        _launchers.append((os, _name))
+try:
+    import _posixsubprocess
+    _launchers.append((_posixsubprocess, 'fork_exec'))
+except ImportError:
+    pass
+
+Export('env', 'report')
+_guard = contextlib.ExitStack()
+for _module, _name in _launchers:
+    _guard.enter_context(mock.patch.object(_module, _name, _refuse))
+'''
+
+EPILOG = '''
+_guard.close()
+_top = Dir('#').get_abspath()
+_declared = {}
+for _name, _nodes in _reports:
+    _files = set()
+    for _node in _nodes:
+        _files.update(os.path.relpath(s.get_abspath(), _top) for s in _node.side_effects)
+    _declared[_name] = sorted(_files)
+print('SIDE-EFFECTS ' + json.dumps({'declared': _declared, 'started': _started, 'launched': _launched}))
+'''
+
+
+class SideEffectsTestCase(unittest.TestCase):
+    def setUp(self) -> None:
+        self.top = os.path.realpath(tempfile.mkdtemp(prefix='gccse'))
+        self.addCleanup(shutil.rmtree, self.top, True)
+
+    def write(self, files) -> None:
+        for path, text in files.items():
+            full = os.path.join(self.top, path)
+            os.makedirs(os.path.dirname(full), exist_ok=True)
+            with open(full, 'w') as f:
+                f.write(text)
+
+    def scons(self, *args):
+        environ = dict(os.environ)
+        environ.pop('SCONSFLAGS', None)
+        environ['PYTHONDONTWRITEBYTECODE'] = '1'
+        return subprocess.run(
+            [sys.executable, SCONS] + list(args),
+            cwd=self.top,
+            env=environ,
+            capture_output=True,
+            text=True,
+            timeout=600,
+        )
+
+    def project(self, body, files=None, dirs=(), environment=TOOLS) -> None:
+        self.write(SOURCES)
+        self.write(files or {})
+        for d in dirs:
+            os.makedirs(os.path.join(self.top, d), exist_ok=True)
+        sconstruct = PROLOG.format(environment=environment) + textwrap.dedent(body) + EPILOG
+        self.write({'SConstruct': sconstruct})
+
+    def result(self, run):
+        self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+        lines = [l for l in run.stdout.splitlines() if l.startswith('SIDE-EFFECTS ')]
+        self.assertEqual(len(lines), 1, run.stdout + run.stderr)
+        data = json.loads(lines[0][len('SIDE-EFFECTS '):])
+        self.assertEqual(data['started'], [], 'a program was started while targets were declared')
+        return data
+
+    def declare(self, body, files=None, dirs=(), environment=TOOLS):
+        self.project(body, files, dirs, environment)
+        data = self.result(self.scons('-Q', '-n'))
+        if environment == TOOLS:
+            for command in data['launched']:
+                self.assertIn('--version', command, 'only the compiler version checks may run')
+        return data['declared']
+
