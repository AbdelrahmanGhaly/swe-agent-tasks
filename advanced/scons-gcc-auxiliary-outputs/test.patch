+            report('d', env.Object('obj/d.o', 'src/d.sx', CPPFLAGS=['-MMD', '-MF', 'deps/d.d']))
+            report('cs', env.SharedObject('obj/cs', 'src/c.S', ASPPFLAGS=['$CCDEPFLAGS']))
