+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() { echo "usage: $0 [--output_path <path>] base|new" >&2; exit 2; }
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new) MODE="$1"; MODE_COUNT=$((MODE_COUNT + 1)); shift ;;
+    --output_path) shift; [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }; OUTPUT_PATH="$1"; shift ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    *) echo "unknown argument: $1" >&2; usage ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+[ -n "$OUTPUT_PATH" ] || OUTPUT_PATH="test-results-$MODE.xml"
+mkdir -p "$(dirname "$OUTPUT_PATH")" || exit 2
+OUTPUT_PATH="$(cd "$(dirname "$OUTPUT_PATH")" && pwd)/$(basename "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")" || exit 1
+export PYTHONPATH="$PWD/testing/framework:$PWD"
+export PYTHONDONTWRITEBYTECODE=1
+unset SCONSFLAGS
+
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+STATUS=0
+GROUP=0
+
+# Runs one group of unit tests in its own pytest process.  When a group
+# yields no test cases at all (a collection crash or a hang), every test
+# named in its files is recorded as failed, with pytest's exit status and
+# the end of its output.
+run_group() {
+  GROUP=$((GROUP + 1))
+  local xml="$WORK/group$GROUP.xml"
+  local log="$WORK/group$GROUP.log"
+  timeout 1800 python -m pytest -p no:cacheprovider -o addopts= -q \
+    --junitxml="$xml" "$@" 2>&1 | tee "$log"
+  local rc=${PIPESTATUS[0]}
+  if [ "$rc" -ne 0 ]; then
+    STATUS=1
+  fi
+  if [ "$rc" -ne 0 ] && ! grep -q '<testcase' "$xml" 2>/dev/null; then
+    python - "$xml" "$rc" "$log" "$@" <<'PY'
+import re
+import sys
+from xml.sax.saxutils import escape, quoteattr
+
+xml, rc, log, args = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
+reason = 'it timed out after 1800 seconds' if rc == '124' else f'pytest exited with status {rc}'
+with open(log, errors='replace') as f:
+    output = ''.join(f.readlines()[-60:])
+output = escape(re.sub(r'[\x00-\x08\x0b\x0c\x0e-\x1f]', '', output))
+targets = []
+skip = False
+for arg in args:
+    if skip or arg.startswith('-'):
+        skip = arg == '--deselect'
+        continue
+    targets.append(arg)
+cases = []
+for target in targets:
+    path, _, wanted = target.partition('::')
+    module = path[:-3].replace('/', '.')
+    with open(path) as f:
+        source = f.read()
+    for cls, body in re.findall(r'^class (\w+)\(.*?\):\n((?:(?:[ \t]+.*)?\n)*)', source, re.M):
+        if wanted and cls != wanted:
+            continue
+        for name in re.findall(r'^    def (test\w*)\(', body, re.M):
+            cases.append((f'{module}.{cls}', name))
+lines = ['<?xml version="1.0" encoding="utf-8"?>',
+         f'<testsuites><testsuite name="pytest" tests="{len(cases)}" failures="{len(cases)}" errors="0">']
+for classname, name in cases:
+    lines.append(f'<testcase classname={quoteattr(classname)} name={quoteattr(name)}>'
+                 f'<failure message={quoteattr("the test module could not be run: " + reason)}>'
+                 f'{output}</failure></testcase>')
+lines.append('</testsuite></testsuites>')
+with open(xml, 'w') as f:
+    f.write('\n'.join(lines) + '\n')
+PY
+  fi
+}
+
+# Runs SCons end-to-end test scripts the way runtest.py does, a few at a
+# time, and records each one as a test case: exit status 0 passes, any
+# other status (2 is "no result") fails with the script's output.
+run_e2e() {
+  GROUP=$((GROUP + 1))
+  python - "$WORK/group$GROUP.xml" "$@" <<'PY'
+import concurrent.futures
+import os
+import re
+import subprocess
+import sys
+import time
+from xml.sax.saxutils import escape, quoteattr
+
+xml, tests = sys.argv[1], sys.argv[2:]
+root = os.getcwd()
+env = dict(os.environ)
+env.update({
+    'SCONS_RUNTEST_DIR': root,
+    'SCONS_TOOLS_DIR': os.path.join(root, 'bin'),
+    'SCONS_SCRIPT_DIR': os.path.join(root, 'scripts'),
+    'SCONS_CWD': root,
+    'SCONS_LIB_DIR': root,
+    'PYTHONPATH': os.pathsep.join([root, os.path.join(root, 'testing', 'framework')]),
+    'python_executable': sys.executable,
+})
+
+
+def run(test):
+    start = time.time()
+    fixtures = [os.path.dirname(os.path.abspath(test)), os.path.join(root, 'test', 'fixture')]
+    test_env = dict(env, FIXTURE_DIRS=os.pathsep.join(fixtures))
+    try:
+        done = subprocess.run([sys.executable, test], cwd=root, env=test_env, stdin=subprocess.DEVNULL,
+                              capture_output=True, text=True, errors='replace', timeout=900)
+        status, output = done.returncode, done.stdout + done.stderr
+    except subprocess.TimeoutExpired:
+        status, output = 124, 'timed out after 900 seconds'
+    return test, status, output, time.time() - start
+
+
+workers = max(1, min(8, os.cpu_count() or 1))
+with concurrent.futures.ThreadPoolExecutor(workers) as pool:
+    results = list(pool.map(run, tests))
+
+failed = 0
+lines = []
+for test, status, output, seconds in results:
+    directory, name = os.path.split(test)
+    head = f'<testcase classname={quoteattr(directory.replace("/", "."))} name={quoteattr(name)} time="{seconds:.1f}">'
+    print(('PASSED ' if status == 0 else 'FAILED ') + test, flush=True)
+    if status == 0:
+        lines.append(head + '</testcase>')
+        continue
+    failed += 1
+    text = escape(re.sub(r'[\x00-\x08\x0b\x0c\x0e-\x1f]', '', output[-6000:]))
+    message = 'no result' if status == 2 else f'exit status {status}'
+    lines.append(head + f'<failure message={quoteattr(message)}>{text}</failure></testcase>')
+with open(xml, 'w') as f:
+    f.write('<?xml version="1.0" encoding="utf-8"?>\n')
+    f.write(f'<testsuites><testsuite name="e2e" tests="{len(results)}" failures="{failed}" errors="0">\n')
+    f.write('\n'.join(lines) + '\n</testsuite></testsuites>\n')
+sys.exit(1 if failed else 0)
+PY
+  [ $? -eq 0 ] || STATUS=1
+}
+
+if [ "$MODE" = "base" ]; then
+  run_group SCons/BuilderTests.py
+  run_group SCons/DefaultsTests.py
+  # test_tool is a helper that takes an environment, not a test.
+  run_group SCons/EnvironmentTests.py --deselect SCons/EnvironmentTests.py::test_tool
+  # test_remove_fail skips itself when run as root, and a skipped test
+  # does not count as passed.
+  run_group SCons/Node/FSTests.py --deselect SCons/Node/FSTests.py::FSTestCase::test_remove_fail
+  run_group SCons/Tool/ToolTests.py
+  # ml.py and nasm.py need assemblers this image does not have, and
+  # VariantDir/errors.py skips itself when run as root, which does not count
+  # as passed.
+  E2E=$(ls test/CC/*.py test/CXX/*.py test/AS/*.py test/LINK/*.py test/SideEffect/*.py \
+          test/SideEffect/Issues/3013/*.py test/MinGW/mingw_uses_comstr_issue_2799.py \
+          test/LoadableModule.py test/Object.py test/Program.py test/gnutools.py \
+          test/Configure/*.py test/Clean/*.py test/CompilationDatabase/*.py test/VariantDir/*.py \
+          test/Depends/*.py \
+        | grep -v -e '^test/AS/ml\.py$' -e '^test/AS/nasm\.py$' -e '^test/VariantDir/errors\.py$')
+  run_e2e $E2E
+else
+  run_group SCons/Tool/gccSideEffects069e76Tests.py
+fi
+
+# Merges the group reports into the one at --output_path.  A group report
+# that cannot be read becomes a failed test case, and a merge that cannot
+# write the report fails the run.
+python - "$OUTPUT_PATH" "$WORK"/group*.xml <<'PY'
+import os
+import sys
+import xml.etree.ElementTree as ET
+
+out, parts = sys.argv[1], sys.argv[2:]
+root = ET.Element('testsuites')
+unreadable = 0
+for part in parts:
+    try:
+        tree = ET.parse(part).getroot()
+    except (ET.ParseError, OSError) as error:
+        unreadable += 1
+        suite = ET.SubElement(root, 'testsuite', name='harness', tests='1', failures='1', errors='0')
+        case = ET.SubElement(suite, 'testcase', classname='harness', name=os.path.basename(part))
+        failure = ET.SubElement(case, 'failure', message='the group report could not be read')
+        failure.text = str(error)
+        continue
+    suites = [tree] if tree.tag == 'testsuite' else tree.findall('testsuite')
+    root.extend(suites)
+ET.ElementTree(root).write(out, encoding='utf-8', xml_declaration=True)
+sys.exit(1 if unreadable else 0)
+PY
+if [ $? -ne 0 ]; then
+  echo "the JUnit report at $OUTPUT_PATH is incomplete or could not be written" >&2
+  STATUS=1
+fi
+
+exit "$STATUS"
