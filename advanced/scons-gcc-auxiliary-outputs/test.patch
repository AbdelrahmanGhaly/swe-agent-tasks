+
+    def test_ccdepflags_names_the_file_after_the_target(self) -> None:
+        declared = self.declare('''
+            report('a', env.Object('obj/a.o', 'src/a.c', CCFLAGS=['$CCDEPFLAGS']))
+            report('b', env.SharedObject('obj/b', 'src/b.cpp', CXXFLAGS=['$CCDEPFLAGS']))
+        ''')
+        self.assertEqual(declared, {'a': ['obj/a.o.d'], 'b': ['obj/b.os.d']})
+
+    def test_preprocessor_options_override_the_driver(self) -> None:
+        declared = self.declare('''
+            report('a', env.Object('obj/a.o', 'src/a.c', CCFLAGS=['-MD', '-Wp,-MD,deps/a.wp']))
+            report('b', env.Object('obj/b.o', 'src/b.cpp', CXXFLAGS=['-MMD', '-MF', 'deps/b.d', '-Wp,-MMD,deps/b.wp']))
+            report('e', env.Object('obj/e.o', 'src/e.cc', CCFLAGS=['-Wp,-MD,deps/e.wp', '-MF', 'deps/e.d']))
+            report('f', env.Object('obj/f.o', 'src/f.cxx', CCFLAGS=['-MD', '-Wp,-MF,deps/f.wp']))
+            report('g', env.Object('obj/g.o', 'src/g.C', CCFLAGS=['-Wp,-MD,deps/g1.wp,-MF,deps/g2.wp']))
+        ''')
+        self.assertEqual(
+            declared,
+            {
+                'a': ['deps/a.wp'],
+                'b': ['deps/b.wp'],
+                'e': ['deps/e.wp'],
+                'f': ['deps/f.wp'],
+                'g': ['deps/g2.wp'],
+            },
+        )
+
+    def test_preprocessed_assembler_sources(self) -> None:
