+/// Write the Flex-compatible function prototypes of a --yy scanner with prefix NAME and the given LINKAGE
+void Reflex::write_flex_prototypes(const char *linkage)
+{
+  const std::string& prefix = options["prefix"];
+  *out <<
+    linkage << "void " << prefix << "restart(FILE*);\n" <<
+    linkage << "int " << prefix << "lex_destroy(void);\n" <<
+    linkage << "FILE *" << prefix << "get_in(void);\n" <<
+    linkage << "void " << prefix << "set_in(FILE*);\n" <<
+    linkage << "FILE *" << prefix << "get_out(void);\n" <<
+    linkage << "void " << prefix << "set_out(FILE*);\n" <<
+    linkage << "char *" << prefix << "get_text(void);\n" <<
+    linkage << "int " << prefix << "get_leng(void);\n" <<
+    linkage << "int " << prefix << "get_lineno(void);\n" <<
+    linkage << "void " << prefix << "set_lineno(int);\n" <<
+    linkage << "int " << prefix << "get_debug(void);\n" <<
+    linkage << "void " << prefix << "set_debug(int);\n";
+}
+
+/// Write the C-linkage forwarders of the Flex-compatible functions of a --yy scanner, for when section 1 defines YY_EXTERN_C after the functions were declared with C++ linkage
+void Reflex::write_flex_forwarders()
+{
+  const std::string& prefix = options["prefix"];
+  *out <<
+    "#if defined(YY_FLEX_CXX_LINKAGE) && defined(YY_EXTERN_C)\n"
+    "namespace " << prefix << "_extern_c {\n"
+    "YY_EXTERN_C void " << prefix << "restart(FILE *input_file) { ::" << prefix << "restart(input_file); }\n"
+    "YY_EXTERN_C int " << prefix << "lex_destroy(void) { return ::" << prefix << "lex_destroy(); }\n"
+    "YY_EXTERN_C FILE *" << prefix << "get_in(void) { return ::" << prefix << "get_in(); }\n"
+    "YY_EXTERN_C void " << prefix << "set_in(FILE *in_str) { ::" << prefix << "set_in(in_str); }\n"
+    "YY_EXTERN_C FILE *" << prefix << "get_out(void) { return ::" << prefix << "get_out(); }\n"
+    "YY_EXTERN_C void " << prefix << "set_out(FILE *out_str) { ::" << prefix << "set_out(out_str); }\n"
+    "YY_EXTERN_C char *" << prefix << "get_text(void) { return ::" << prefix << "get_text(); }\n"
+    "YY_EXTERN_C int " << prefix << "get_leng(void) { return ::" << prefix << "get_leng(); }\n"
+    "YY_EXTERN_C int " << prefix << "get_lineno(void) { return ::" << prefix << "get_lineno(); }\n"
+    "YY_EXTERN_C void " << prefix << "set_lineno(int line_number) { ::" << prefix << "set_lineno(line_number); }\n"
+    "YY_EXTERN_C int " << prefix << "get_debug(void) { return ::" << prefix << "get_debug(); }\n"
+    "YY_EXTERN_C void " << prefix << "set_debug(int debug_flag) { ::" << prefix << "set_debug(debug_flag); }\n"
+    "}\n"
+    "#endif\n"
+    "\n";
+}
