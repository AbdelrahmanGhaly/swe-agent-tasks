+/// Write Flex-compatible macros to lex.yy.cpp that map the yy names to the prefixed global names, and with option --yy declare the global variables for section 1 like Flex does
+void Reflex::write_flex_names()
+{
+  if (!out->good())
+    return;
+  if (options["flex"].empty() || !options["bison_cc"].empty() || (options["bison"].empty() && options["bison_locations"].empty()) || !options["reentrant"].empty() || !options["bison_bridge"].empty())
+    return;
+  std::string prefix = options["prefix"];
+  if (prefix == "yy" && options["yy"].empty())
+    return;
+  write_banner("FLEX-COMPATIBLE NAMES");
+  if (prefix != "yy")
+  {
+    if (!options["yy"].empty())
+      *out <<
+        "#define yyin " << prefix << "in\n"
+        "#define yyout " << prefix << "out\n";
+    *out <<
+      "#define yytext " << prefix << "text\n"
+      "#define yyleng " << prefix << "leng\n"
+      "#define yylineno " << prefix << "lineno\n"
+      "#define yylex " << prefix << "lex\n";
+    if (!options["yy"].empty())
+      *out <<
+        "#define yywrap " << prefix << "wrap\n"
+        "#define yyrestart " << prefix << "restart\n"
+        "#define yylex_destroy " << prefix << "lex_destroy\n"
+        "#define yyget_in " << prefix << "get_in\n"
+        "#define yyset_in " << prefix << "set_in\n"
+        "#define yyget_out " << prefix << "get_out\n"
+        "#define yyset_out " << prefix << "set_out\n"
+        "#define yyget_text " << prefix << "get_text\n"
+        "#define yyget_leng " << prefix << "get_leng\n"
+        "#define yyget_lineno " << prefix << "get_lineno\n"
+        "#define yyset_lineno " << prefix << "set_lineno\n"
+        "#define yyget_debug " << prefix << "get_debug\n"
+        "#define yyset_debug " << prefix << "set_debug\n";
+  }
+  if (!options["yy"].empty())
+  {
+    if (prefix != "yy")
+      *out << "\n";
+    *out <<
+      "extern FILE *" << prefix << "in;\n"
+      "extern FILE *" << prefix << "out;\n";
+    if (!options["array"].empty() && options["pointer"].empty())
+      *out <<
+        "extern char " << prefix << "text[];\n";
+    else
+      *out <<
+        "extern char *" << prefix << "text;\n";
+    *out <<
+      "extern yy_size_t " << prefix << "leng;\n"
+      "extern int " << prefix << "lineno;\n"
+      "\n"
+      "#ifdef YY_EXTERN_C\n";
+    write_flex_prototypes("YY_EXTERN_C ");
+    *out <<
+      "#else\n"
+      "#define YY_FLEX_CXX_LINKAGE\n";
+    write_flex_prototypes("");
+    *out <<
+      "#endif\n";
+  }
+}
