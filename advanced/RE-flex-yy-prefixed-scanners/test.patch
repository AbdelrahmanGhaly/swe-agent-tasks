+#include <stdio.h>
+
+extern FILE *aain, *bbin;
+extern char *aatext, *bbtext;
+extern int aalineno, bblineno;
+int aalex(void);
+int bblex(void);
+void aarestart(FILE *);
+void bbrestart(FILE *);
+
+int main(void)
+{
+  int t;
+  aain = fopen("a.txt", "r");
+  bbin = fopen("b.txt", "r");
+  t = aalex();
+  printf("a%d %s@%d\n", t, aatext, aalineno);
+  t = bblex();
+  printf("b%d %s@%d\n", t, bbtext, bblineno);
+  t = bblex();
+  printf("b%d %s@%d\n", t, bbtext, bblineno);
+  aarestart(fopen("c.txt", "r"));
+  while ((t = bblex()) != 0)
+    printf("b%d %s@%d\n", t, bbtext, bblineno);
+  bbrestart(fopen("c.txt", "r"));
+  while ((t = bblex()) != 0)
+    printf("b%d %s\n", t, bbtext);
+  while ((t = aalex()) != 0)
+    printf("a%d %s\n", t, aatext);
+  return 0;
+}
