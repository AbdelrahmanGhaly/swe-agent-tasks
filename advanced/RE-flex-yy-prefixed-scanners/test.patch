+
+static void show(const char *name)
+{
+  char line[256];
+  FILE *f = fopen(name, "r");
+  printf("-- %s\n", name);
+  while (fgets(line, sizeof(line), f))
+    fputs(line, stdout);
+  printf("\n");
+  fclose(f);
+}
+
+int main(void)
+{
+  int t;
+  bblog = fopen("bb.log", "w");
