+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  t = cclex();
+  printf("cc %d %s %d\n", t, cctext, ccget_leng());
+  printf("zq destroy %d\n", zqlex_destroy());
+  zqin = fopen("zq1.txt", "r");
+  t = cclex();
+  printf("cc %d %s %d\n", t, cctext, ccget_leng());
+  t = cclex();
+  printf("cc %d %s %d\n", t, cctext, ccget_leng());
+  printf("drain\n");
+  while ((t = bblex()) != 0)
+    printf("bb %d %s\n", t, bbtext);
+  while ((t = zqlex()) != 0)
+    printf("zq %d %s\n", t, zqtext);
+  while ((t = cclex()) != 0)
+    printf("cc %d %s\n", t, cctext);
+  fclose(bblog);
+  fclose(zqlog);
+  fclose(cclog);
+  show("bb.log");
+  show("zq.log");
+  printf("zq wraps %d\n", zqwraps);
+  show("cc.log");
+  printf("cc wraps %d\n", ccwraps);
+  return 0;
+}
