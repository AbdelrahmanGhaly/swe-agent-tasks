+int zqget_leng(void);
+int zqget_lineno(void);
+void zqset_lineno(int);
+static FILE *zqlog;
+static int zqwraps;
+
+int zqwrap(void)
+{
+  ++zqwraps;
+  return 1;
+}
+
+extern FILE *yyin, *yyout;
+extern char *yytext;
+extern int yylineno;
+int yylex(void);
+void yyrestart(FILE *);
+int yylex_destroy(void);
+FILE *yyget_in(void);
+void yyset_in(FILE *);
+FILE *yyget_out(void);
+void yyset_out(FILE *);
+int yyget_leng(void);
+int yyget_lineno(void);
+void yyset_lineno(int);
+static FILE *yylog;
+static int yywraps;
+
+int yywrap(void)
+{
+  ++yywraps;
+  return 1;
+}
+
+static void show(const char *name)
+{
+  char line[256];
+  FILE *f = fopen(name, "r");
+  printf("-- %s\n", name);
+  while (fgets(line, sizeof(line), f))
+    fputs(line, stdout);
+  printf("\n");
+  fclose(f);
+}
+
+int main(void)
+{
+  int t;
+  zqlog = fopen("zq.log", "w");
+  zqset_in(fopen("zq0.txt", "r"));
+  yylog = fopen("yy.log", "w");
+  yyin = fopen("yy0.txt", "r");
+  yyset_lineno(8);
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  zqout = zqlog;
+  t = yylex();
+  printf("yy %d %s %d %d\n", t, yytext, yyget_leng(), yylineno);
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  t = yylex();
+  printf("yy %d %s %d %d\n", t, yytext, yyget_leng(), yylineno);
+  t = yylex();
+  printf("yy %d %s %d %d\n", t, yytext, yyget_leng(), yylineno);
+  t = yylex();
+  printf("yy %d %s %d %d\n", t, yytext, yyget_leng(), yylineno);
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  yyset_lineno(16);
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  yyset_lineno(51);
+  yyset_out(yylog);
+  t = zqlex();
+  printf("zq end %d\n", t);
+  t = yylex();
+  printf("yy %d %s %d %d\n", t, yytext, yyget_leng(), yylineno);
+  yyout = stdout;
+  printf("drain\n");
+  while ((t = yylex()) != 0)
+    printf("yy %d %s\n", t, yytext);
+  fclose(zqlog);
+  fclose(yylog);
+  show("zq.log");
+  printf("zq wraps %d\n", zqwraps);
+  show("yy.log");
+  printf("yy wraps %d\n", yywraps);
+  return 0;
+}
