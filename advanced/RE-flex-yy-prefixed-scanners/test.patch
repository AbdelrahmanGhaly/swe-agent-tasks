+#include <stdio.h>
+
+int yylex(void);
+int aalex(void);
+int bblex(void);
+char *yyget_text(void);
+char *aaget_text(void);
+int yyget_lineno(void);
+int aaget_lineno(void);
+void yyset_in(FILE *);
+void aaset_in(FILE *);
+void bbset_in(FILE *);
+int bbget_leng(void);
+int yylex_destroy(void);
+
+int main(void)
+{
+  int y = 1, a = 1, b = 1;
+  yyset_in(fopen("in.txt", "r"));
+  aaset_in(fopen("in.txt", "r"));
+  bbset_in(fopen("in.txt", "r"));
+  while (y || a || b)
+  {
+    if (y && (y = yylex()) != 0)
+      printf(" y:%s@%d", yyget_text(), yyget_lineno());
+    if (a && (a = aalex()) != 0)
+      printf(" a:%s@%d", aaget_text(), aaget_lineno());
+    if (b && (b = bblex()) != 0)
+      printf(" b:%d", bbget_leng());
+    printf(" [%d %d %d]\n", y, a, b);
+  }
+  printf("%d\n", yylex_destroy());
+  return 0;
+}
