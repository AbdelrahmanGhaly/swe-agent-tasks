+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = bblex();
+  printf("bb %d %s %d\n", t, bbtext, bbget_leng());
+  t = bblex();
+  printf("bb %d %s %d\n", t, bbtext, bbget_leng());
+  zqout = zqlog;
+  zqout = stdout;
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = bblex();
+  printf("bb end %d\n", t);
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = zqlex();
+  printf("zq end %d\n", t);
+  zqrestart(fopen("zq0.txt", "r"));
+  bbrestart(fopen("bb2.txt", "r"));
+  printf("drain\n");
+  while ((t = bblex()) != 0)
+    printf("bb %d %s\n", t, bbtext);
+  while ((t = zqlex()) != 0)
+    printf("zq %d %s\n", t, zqtext);
+  fclose(bblog);
+  fclose(zqlog);
+  show("bb.log");
+  show("zq.log");
+  return 0;
+}
