+#include <stdio.h>
+
+extern FILE *aain, *aaout;
+extern char *aatext;
+extern int aalineno;
+int aalex(void);
+void aarestart(FILE *);
+int aalex_destroy(void);
+FILE *aaget_in(void);
+void aaset_in(FILE *);
+FILE *aaget_out(void);
+void aaset_out(FILE *);
+int aaget_leng(void);
+int aaget_lineno(void);
+void aaset_lineno(int);
+static FILE *aalog;
+
+extern FILE *zqin, *zqout;
+extern char *zqtext;
+extern int zqlineno;
+int zqlex(void);
+void zqrestart(FILE *);
+int zqlex_destroy(void);
+FILE *zqget_in(void);
+void zqset_in(FILE *);
+FILE *zqget_out(void);
+void zqset_out(FILE *);
+int zqget_leng(void);
+int zqget_lineno(void);
+void zqset_lineno(int);
+static FILE *zqlog;
+static int zqwraps;
+
+int zqwrap(void)
+{
+  ++zqwraps;
+  return 1;
+}
+
+static void show(const char *name)
+{
+  char line[256];
+  FILE *f = fopen(name, "r");
+  printf("-- %s\n", name);
+  while (fgets(line, sizeof(line), f))
+    fputs(line, stdout);
+  printf("\n");
+  fclose(f);
+}
+
+int main(void)
+{
+  int t;
+  aalog = fopen("aa.log", "w");
+  aain = fopen("aa0.txt", "r");
+  aaset_lineno(9);
+  zqlog = fopen("zq.log", "w");
+  zqset_in(fopen("zq0.txt", "r"));
+  aaset_lineno(37);
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  printf("aa line %d %d\n", aaget_lineno(), aalineno);
+  printf("aa io %d %d\n", aaget_in() == aain, aaget_out() == stdout);
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  printf("zq io %d %d\n", zqget_in() == zqin, zqget_out() == stdout);
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = zqlex();
+  printf("zq end %d\n", t);
+  zqin = fopen("zq1.txt", "r");
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  printf("drain\n");
+  while ((t = aalex()) != 0)
+    printf("aa %d %s\n", t, aatext);
+  while ((t = zqlex()) != 0)
+    printf("zq %d %s\n", t, zqtext);
+  fclose(aalog);
+  fclose(zqlog);
+  show("aa.log");
+  show("zq.log");
+  printf("zq wraps %d\n", zqwraps);
+  return 0;
+}
