+#include <stdio.h>
+
+extern FILE *yyin, *yyout;
+extern char *yytext;
+extern int yylineno;
+int yylex(void);
+void yyrestart(FILE *);
+int yylex_destroy(void);
+FILE *yyget_in(void);
+void yyset_in(FILE *);
+FILE *yyget_out(void);
+void yyset_out(FILE *);
+int yyget_leng(void);
+int yyget_lineno(void);
+void yyset_lineno(int);
+static FILE *yylog;
+
+extern FILE *bbin, *bbout;
+extern char *bbtext;
+extern int bblineno;
+int bblex(void);
+void bbrestart(FILE *);
+int bblex_destroy(void);
+FILE *bbget_in(void);
+void bbset_in(FILE *);
+FILE *bbget_out(void);
+void bbset_out(FILE *);
+int bbget_leng(void);
+int bbget_lineno(void);
+void bbset_lineno(int);
+static FILE *bblog;
+static int bbwraps;
+
+int bbwrap(void)
+{
+  ++bbwraps;
+  return 1;
+}
+
+extern FILE *zqin, *zqout;
+extern char *zqtext;
+extern int zqlineno;
+int zqlex(void);
+void zqrestart(FILE *);
+int zqlex_destroy(void);
+FILE *zqget_in(void);
+void zqset_in(FILE *);
+FILE *zqget_out(void);
+void zqset_out(FILE *);
+int zqget_leng(void);
+int zqget_lineno(void);
+void zqset_lineno(int);
+static FILE *zqlog;
+
+static void show(const char *name)
+{
+  char line[256];
+  FILE *f = fopen(name, "r");
+  printf("-- %s\n", name);
+  while (fgets(line, sizeof(line), f))
+    fputs(line, stdout);
+  printf("\n");
+  fclose(f);
+}
+
+int main(void)
+{
+  int t;
+  yylog = fopen("yy.log", "w");
+  yyin = fopen("yy0.txt", "r");
+  bblog = fopen("bb.log", "w");
+  bbset_in(fopen("bb0.txt", "r"));
+  zqlog = fopen("zq.log", "w");
+  zqin = fopen("zq0.txt", "r");
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  t = bblex();
+  printf("bb %d %s %d\n", t, bbtext, bbget_leng());
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  printf("yy destroy %d\n", yylex_destroy());
+  yyin = fopen("yy1.txt", "r");
+  printf("zq destroy %d\n", zqlex_destroy());
+  zqin = fopen("zq1.txt", "r");
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  printf("yy io %d %d\n", yyget_in() == yyin, yyget_out() == stdout);
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  bbout = bblog;
+  bbout = stdout;
+  t = zqlex();
+  printf("zq %d %s %d\n", t, zqtext, zqget_leng());
+  bbout = bblog;
+  printf("drain\n");
+  while ((t = yylex()) != 0)
+    printf("yy %d %s\n", t, yytext);
+  while ((t = bblex()) != 0)
+    printf("bb %d %s\n", t, bbtext);
+  while ((t = zqlex()) != 0)
+    printf("zq %d %s\n", t, zqtext);
+  fclose(yylog);
+  fclose(bblog);
+  fclose(zqlog);
+  show("yy.log");
+  show("bb.log");
+  printf("bb wraps %d\n", bbwraps);
+  show("zq.log");
+  return 0;
+}
