+  t = bblex();
+  printf("bb %d %s %d %d\n", t, bbtext, bbget_leng(), bblineno);
+  t = bblex();
+  printf("bb end %d\n", t);
+  printf("bb destroy %d\n", bblex_destroy());
+  bbin = fopen("bb2.txt", "r");
+  printf("bb destroy %d\n", bblex_destroy());
+  bbin = fopen("bb0.txt", "r");
+  t = bblex();
+  printf("bb %d %s %d %d\n", t, bbtext, bbget_leng(), bblineno);
+  t = cclex();
+  printf("cc %d %s %d %d\n", t, cctext, ccget_leng(), cclineno);
+  ccset_lineno(77);
+  printf("bb destroy %d\n", bblex_destroy());
+  bbin = fopen("bb1.txt", "r");
+  t = bblex();
+  printf("bb %d %s %d %d\n", t, bbtext, bbget_leng(), bblineno);
+  t = bblex();
+  printf("bb %d %s %d %d\n", t, bbtext, bbget_leng(), bblineno);
+  t = cclex();
+  printf("cc %d %s %d %d\n", t, cctext, ccget_leng(), cclineno);
+  t = cclex();
+  printf("cc %d %s %d %d\n", t, cctext, ccget_leng(), cclineno);
+  t = bblex();
+  printf("bb end %d\n", t);
+  t = cclex();
+  printf("cc %d %s %d %d\n", t, cctext, ccget_leng(), cclineno);
+  printf("bb destroy %d\n", bblex_destroy());
+  bbin = fopen("bb2.txt", "r");
+  printf("drain\n");
+  while ((t = bblex()) != 0)
+    printf("bb %d %s\n", t, bbtext);
+  while ((t = cclex()) != 0)
+    printf("cc %d %s\n", t, cctext);
+  fclose(bblog);
+  fclose(cclog);
+  show("bb.log");
+  printf("bb wraps %d\n", bbwraps);
+  show("cc.log");
+  return 0;
+}
