+#include <stdio.h>
+
+extern FILE *ccin;
+int cclex(void);
+char *ccget_text(void);
+int ccget_leng(void);
+int ccget_lineno(void);
+void ccset_lineno(int);
+void ccrestart(FILE *);
+int cclex_destroy(void);
+
+int main(void)
+{
+  int t;
+  ccin = fopen("in.txt", "r");
+  while ((t = cclex()) != 0)
+  {
+    printf(" %d:%s/%d@%d", t, ccget_text(), ccget_leng(), ccget_lineno());
+    if (t == 2)
+      ccset_lineno(ccget_lineno() + 10);
+  }
+  printf("\n%d\n", cclex_destroy());
+  ccrestart(fopen("in.txt", "r"));
+  t = cclex();
+  printf("%d:%s@%d\n", t, ccget_text(), ccget_lineno());
+  return 0;
+}
