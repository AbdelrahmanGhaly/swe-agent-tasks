+#include <stdio.h>
+
+int aalex(void);
+FILE *aaget_in(void);
+void aaset_in(FILE *);
+FILE *aaget_out(void);
+void aaset_out(FILE *);
+
+int main(void)
+{
+  char line[256];
+  FILE *in = fopen("a.txt", "r"), *out = fopen("out.txt", "w"), *f;
+  aaset_in(in);
+  printf("{%d %d}", aaget_in() == in, aaget_out() == NULL);
+  aalex();
+  printf("{%d %d}", aaget_in() == in, aaget_out() == stdout);
+  aaset_out(out);
+  aalex();
+  aalex();
+  printf("{%d}", aaget_out() == out);
+  aaset_out(stdout);
+  while (aalex())
+    ;
+  fclose(out);
+  f = fopen("out.txt", "r");
+  printf("\n--\n");
+  while (fgets(line, sizeof(line), f))
+    fputs(line, stdout);
+  printf("\n");
+  return 0;
+}
