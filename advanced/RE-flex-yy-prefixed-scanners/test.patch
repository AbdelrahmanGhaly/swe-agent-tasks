@@ -0,0 +1,53 @@
+#include <stdio.h>
+
+extern FILE *aain, *bbin, *bbout;
+extern char *aatext;
+extern int aalineno;
+int aalex(void);
+int bblex(void);
+void aarestart(FILE *);
+int aalex_destroy(void);
+int bblex_destroy(void);
+char *bbget_text(void);
+int bbget_leng(void);
+void bbset_out(FILE *);
+
+int aawrap(void)
+{
+  printf("<aawrap>");
+  return 1;
+}
+
+int bbwrap(void)
+{
+  printf("<bbwrap>");
+  return 1;
+}
+
+int main(void)
+{
+  FILE *log = fopen("b.log", "w"), *f;
+  char line[256];
+  aain = fopen("in.txt", "r");
+  bbin = fopen("in.txt", "r");
+  int t;
+  t = aalex();
+  printf("%d %s %d\n", t, aatext, aalineno);
+  t = bblex();
+  printf("%d %s %d\n", t, bbget_text(), bbget_leng());
+  bbset_out(log);
+  t = bblex();
+  printf("%d %s\n", t, bbget_text());
+  aarestart(fopen("more.txt", "r"));
+  while (aalex())
+    printf("%s ", aatext);
+  printf("%d\n", aalex_destroy());
+  while (bblex())
+    printf(".");
+  printf("%d\n", bblex_destroy());
+  fclose(log);
+  f = fopen("b.log", "r");
+  while (fgets(line, sizeof(line), f))
+    printf("log: %s\n", line);
+  return 0;
+}
