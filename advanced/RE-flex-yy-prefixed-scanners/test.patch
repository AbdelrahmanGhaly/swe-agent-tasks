+
+static void scan(void)
+{
+  while (aalex())
+    printf("%s@%d ", aatext, aaget_lineno());
+  printf("| %d\n", aalineno);
+}
+
+int main(void)
+{
+  aain = fopen("one.txt", "r");
+  scan();
+  aarestart(fopen("two.txt", "r"));
+  aaset_lineno(4);
+  scan();
+  aaset_in(fopen("three.txt", "r"));
+  aaset_lineno(42);
+  scan();
+  aain = fopen("four.txt", "r");
+  aaset_lineno(7);
+  scan();
+  return 0;
+}
