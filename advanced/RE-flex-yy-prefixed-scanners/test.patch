+FILE *bbget_in(void);
+void bbset_in(FILE *);
+FILE *bbget_out(void);
+void bbset_out(FILE *);
+int bbget_leng(void);
+int bbget_lineno(void);
+void bbset_lineno(int);
+static FILE *bblog;
+static int bbwraps;
+
+int bbwrap(void)
+{
+  ++bbwraps;
+  return 1;
+}
+
+static void show(const char *name)
+{
+  char line[256];
+  FILE *f = fopen(name, "r");
+  printf("-- %s\n", name);
+  while (fgets(line, sizeof(line), f))
+    fputs(line, stdout);
+  printf("\n");
+  fclose(f);
+}
+
+int main(void)
+{
+  int t;
+  yylog = fopen("yy.log", "w");
+  yyin = fopen("yy0.txt", "r");
+  bblog = fopen("bb.log", "w");
+  bbin = fopen("bb0.txt", "r");
+  printf("yy destroy %d\n", yylex_destroy());
+  yyin = fopen("yy1.txt", "r");
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  bbset_out(bblog);
+  t = bblex();
+  printf("bb %d %s %d\n", t, bbtext, bbget_leng());
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  bbout = stdout;
+  t = bblex();
+  printf("bb %d %s %d\n", t, bbtext, bbget_leng());
+  printf("yy destroy %d\n", yylex_destroy());
+  yyin = fopen("yy2.txt", "r");
+  t = bblex();
+  printf("bb %d %s %d\n", t, bbtext, bbget_leng());
+  t = bblex();
+  printf("bb %d %s %d\n", t, bbtext, bbget_leng());
+  bbout = bblog;
+  t = bblex();
+  printf("bb %d %s %d\n", t, bbtext, bbget_leng());
+  t = bblex();
+  printf("bb end %d\n", t);
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  printf("yy io %d %d\n", yyget_in() == yyin, yyget_out() == stdout);
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  bbrestart(fopen("bb1.txt", "r"));
+  t = bblex();
+  printf("bb %d %s %d\n", t, bbtext, bbget_leng());
+  printf("drain\n");
+  while ((t = yylex()) != 0)
+    printf("yy %d %s\n", t, yytext);
+  while ((t = bblex()) != 0)
+    printf("bb %d %s\n", t, bbtext);
+  fclose(yylog);
+  fclose(bblog);
+  show("yy.log");
+  show("bb.log");
+  printf("bb wraps %d\n", bbwraps);
+  return 0;
+}
