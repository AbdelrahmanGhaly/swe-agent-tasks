+int aaget_lineno(void);
+void aaset_lineno(int);
+static FILE *aalog;
+static int aawraps;
+
+int aawrap(void)
+{
+  ++aawraps;
+  return 1;
+}
+
+static void show(const char *name)
+{
+  char line[256];
+  FILE *f = fopen(name, "r");
+  printf("-- %s\n", name);
+  while (fgets(line, sizeof(line), f))
+    fputs(line, stdout);
+  printf("\n");
+  fclose(f);
+}
+
+int main(void)
+{
+  int t;
+  zqlog = fopen("zq.log", "w");
+  zqset_in(fopen("zq0.txt", "r"));
+  zqset_lineno(28);
+  cclog = fopen("cc.log", "w");
+  ccin = fopen("cc0.txt", "r");
+  ccset_lineno(23);
+  aalog = fopen("aa.log", "w");
+  aain = fopen("aa0.txt", "r");
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  zqset_lineno(49);
+  ccset_out(cclog);
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  printf("aa destroy %d\n", aalex_destroy());
+  aain = fopen("aa1.txt", "r");
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  zqset_lineno(9);
+  t = cclex();
+  printf("cc %d %s %d %d\n", t, cctext, ccget_leng(), cclineno);
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  t = cclex();
+  printf("cc %d %s %d %d\n", t, cctext, ccget_leng(), cclineno);
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  t = cclex();
+  printf("cc %d %s %d %d\n", t, cctext, ccget_leng(), cclineno);
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  zqset_out(zqlog);
+  t = cclex();
+  printf("cc %d %s %d %d\n", t, cctext, ccget_leng(), cclineno);
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  t = aalex();
+  printf("aa %d %s %d %d\n", t, aatext, aaget_leng(), aalineno);
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  t = cclex();
+  printf("cc %d %s %d %d\n", t, cctext, ccget_leng(), cclineno);
+  printf("aa line %d %d\n", aaget_lineno(), aalineno);
+  printf("aa io %d %d\n", aaget_in() == aain, aaget_out() == stdout);
+  t = cclex();
+  printf("cc end %d\n", t);
+  printf("drain\n");
+  while ((t = zqlex()) != 0)
+    printf("zq %d %s\n", t, zqtext);
+  while ((t = aalex()) != 0)
+    printf("aa %d %s\n", t, aatext);
+  fclose(zqlog);
+  fclose(cclog);
+  fclose(aalog);
+  show("zq.log");
+  printf("zq wraps %d\n", zqwraps);
+  show("cc.log");
+  printf("cc wraps %d\n", ccwraps);
+  show("aa.log");
+  printf("aa wraps %d\n", aawraps);
+  return 0;
+}
