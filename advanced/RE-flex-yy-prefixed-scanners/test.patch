+FILE *ccget_out(void);
+void ccset_out(FILE *);
+int ccget_leng(void);
+int ccget_lineno(void);
+void ccset_lineno(int);
+static FILE *cclog;
+
+static void show(const char *name)
+{
+  char line[256];
+  FILE *f = fopen(name, "r");
+  printf("-- %s\n", name);
+  while (fgets(line, sizeof(line), f))
+    fputs(line, stdout);
+  printf("\n");
+  fclose(f);
+}
+
+int main(void)
+{
+  int t;
+  zqlog = fopen("zq.log", "w");
+  zqin = fopen("zq0.txt", "r");
+  bblog = fopen("bb.log", "w");
+  bbin = fopen("bb0.txt", "r");
+  bbset_lineno(37);
+  cclog = fopen("cc.log", "w");
+  ccset_in(fopen("cc0.txt", "r"));
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  t = cclex();
+  printf("cc %d %s %d\n", t, cctext, ccget_leng());
+  printf("bb line %d %d\n", bbget_lineno(), bblineno);
+  printf("bb io %d %d\n", bbget_in() == bbin, bbget_out() == stdout);
+  zqset_lineno(41);
+  t = cclex();
+  printf("cc end %d\n", t);
+  printf("bb destroy %d\n", bblex_destroy());
+  bbin = fopen("bb1.txt", "r");
+  printf("zq destroy %d\n", zqlex_destroy());
+  zqin = fopen("zq1.txt", "r");
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  ccin = fopen("cc1.txt", "r");
+  ccset_out(cclog);
+  t = cclex();
+  printf("cc %d %s %d\n", t, cctext, ccget_leng());
+  t = zqlex();
+  printf("zq %d %s %d %d\n", t, zqtext, zqget_leng(), zqlineno);
+  zqset_out(zqlog);
+  t = cclex();
+  printf("cc %d %s %d\n", t, cctext, ccget_leng());
+  t = cclex();
+  printf("cc %d %s %d\n", t, cctext, ccget_leng());
+  t = cclex();
+  printf("cc %d %s %d\n", t, cctext, ccget_leng());
+  zqout = stdout;
+  printf("drain\n");
+  while ((t = zqlex()) != 0)
+    printf("zq %d %s\n", t, zqtext);
+  while ((t = bblex()) != 0)
+    printf("bb %d %s\n", t, bbtext);
+  while ((t = cclex()) != 0)
+    printf("cc %d %s\n", t, cctext);
+  fclose(zqlog);
+  fclose(bblog);
+  fclose(cclog);
+  show("zq.log");
+  printf("zq wraps %d\n", zqwraps);
+  show("bb.log");
+  printf("bb wraps %d\n", bbwraps);
+  show("cc.log");
+  return 0;
+}
