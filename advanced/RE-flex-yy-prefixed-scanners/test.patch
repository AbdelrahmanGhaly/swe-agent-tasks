+};
+
+const int corpus_size = 30;
+
+const char *const keep_cases[] = {
+  "keep_separate_main",
+  "keep_section3_main",
+  "keep_c_main",
+  "keep_prefixed_names",
+  "keep_fprintf",
+};
+
+const char *const today_cases[] = {
+  "unchanged_lineno",
+  "unchanged_yyin",
+  "unchanged_end",
+  "unchanged_yyin_action",
+};
+
+const char *const repo_programs[] = { "rtest", "test_bits", "test_ranges", "streams", "stest", "lazytest" };
+
+struct Param {
+  std::string name;
+};
+
+void PrintTo(const Param& param, std::ostream *os)
+{
+  *os << param.name;
+}
+
+std::map<std::string,Param>& registry()
+{
+  static std::map<std::string,Param> params;
+  return params;
+}
+
+void add(const std::string& name, std::vector<Param>& params)
+{
+  Param param = { name };
+  registry()[name] = param;
+  params.push_back(param);
+}
+
+std::vector<Param> program_params()
+{
+  std::vector<Param> params;
+  for (size_t i = 0; i < sizeof(program_cases)/sizeof(*program_cases); ++i)
+    add(program_cases[i], params);
+  return params;
+}
+
+std::vector<Param> corpus_params()
+{
+  std::vector<Param> params;
+  for (int i = 1; i <= corpus_size; ++i)
+  {
+    char name[16];
+    snprintf(name, sizeof(name), "corpus_%02d", i);
+    add(name, params);
+  }
+  return params;
+}
+
+std::vector<Param> keep_params()
+{
+  std::vector<Param> params;
+  for (size_t i = 0; i < sizeof(keep_cases)/sizeof(*keep_cases); ++i)
+    add(keep_cases[i], params);
+  return params;
+}
+
+std::vector<Param> today_params(const char *suffix)
+{
+  std::vector<Param> params;
+  for (size_t i = 0; i < sizeof(today_cases)/sizeof(*today_cases); ++i)
+    add(std::string(today_cases[i]) + suffix, params);
+  return params;
+}
+
+std::string env(const char *name, const char *fallback)
+{
+  const char *value = getenv(name);
+  return value != NULL && *value != '\0' ? value : fallback;
+}
+
+const std::string root = env("REFLEX_ROOT", "/app");
+const std::string build_dir = env("REFLEX_BUILD", (root + "/build").c_str());
+const std::string work = env("SCANNERS_WORK", "/tmp/scanners_fdf0b9");
+const std::string suite_dir = root + "/tests/scanners_fdf0b9";
+const std::string cases_dir = suite_dir + "/cases";
+const std::string reflex = build_dir + "/reflex";
+const std::string library = build_dir + "/libreflex.a";
+
+std::string quote(const std::string& s)
+{
+  return "'" + s + "'";
+}
+
+struct Outcome {
+  int         status;
+  std::string output;
+};
+
+Outcome run(const std::string& command)
+{
+  Outcome result = { -1, "" };
+  FILE *pipe = popen(command.c_str(), "r");
+  if (pipe == NULL)
+    return result;
+  char buffer[4096];
+  size_t n;
+  while ((n = fread(buffer, 1, sizeof(buffer), pipe)) > 0)
+    result.output.append(buffer, n);
+  int status = pclose(pipe);
+  if (WIFEXITED(status))
+    result.status = WEXITSTATUS(status);
+  return result;
+}
+
+bool read_file(const std::string& path, std::string& text)
+{
+  std::ifstream file(path.c_str(), std::ios::binary);
+  if (!file)
+    return false;
+  std::stringstream buffer;
+  buffer << file.rdbuf();
+  text = buffer.str();
+  return true;
+}
+
+bool exists(const std::string& path)
+{
+  std::ifstream file(path.c_str());
+  return file.good();
+}
+
+std::string head(const std::string& text, size_t lines)
+{
+  size_t pos = 0;
+  while (lines-- > 0 && pos != std::string::npos)
+  {
+    pos = text.find('\n', pos);
+    if (pos != std::string::npos)
+      ++pos;
+  }
+  return pos == std::string::npos ? text : text.substr(0, pos);
+}
+
+std::string visible(const std::string& text)
+{
+  std::string s;
+  for (size_t i = 0; i < text.size(); ++i)
+  {
+    if (text[i] == '\n')
+      s.append("\\n");
+    else if (text[i] == '\t')
+      s.append("\\t");
+    else
+      s.push_back(text[i]);
+  }
+  return s;
+}
+
+::testing::AssertionResult same_output(const char *reference, const std::string& expected, const std::string& actual)
+{
+  if (expected == actual)
+    return ::testing::AssertionSuccess();
+  size_t i = 0;
+  while (i < expected.size() && i < actual.size() && expected[i] == actual[i])
+    ++i;
+  size_t from = i > 60 ? i - 60 : 0;
+  return ::testing::AssertionFailure()
+    << "output differs from the " << reference << " output at byte " << i
+    << " (expected " << expected.size() << " bytes, got " << actual.size() << " bytes)\n"
+    << "expected: ..." << visible(expected.substr(from, 160)) << "\n"
+    << "actual:   ..." << visible(actual.substr(from, 160));
+}
+
+struct Build {
+  bool        done;
+  std::string log;
+  std::string dir;
+};
+
+std::map<std::string,Build>& builds()
+{
+  static std::map<std::string,Build> table;
+  return table;
+}
+
+const char *const build_script =
+  "dir=\"$WORK/$1\"\n"
+  "rm -rf \"$dir\"\n"
+  "mkdir -p \"$dir\"\n"
+  "cp -R \"$CASES/$1/.\" \"$dir/\"\n"
+  "cd \"$dir\" || exit 0\n"
+  "objs=\"\"\n"
+  "for spec in *.l; do\n"
+  "  base=${spec%.l}\n"
+  "  extra=\"\"\n"
+  "  if [ -f flags ]; then extra=$(awk -v s=\"$spec\" '$1 == s { $1 = \"\"; print }' flags); fi\n"
+  "  if ! \"$REFLEX\" --yy $extra -o \"$base.cpp\" \"$spec\" > \"$base.log\" 2>&1; then\n"
+  "    echo \"generate $spec $base.log\" > \"$WORK/$1.fail\"\n"
+  "    exit 0\n"
+  "  fi\n"
+  "  if ! g++ -w -I\"$INCLUDE\" -c -o \"$base.o\" \"$base.cpp\" > \"$base.log\" 2>&1; then\n"
+  "    echo \"compile $spec $base.log\" > \"$WORK/$1.fail\"\n"
+  "    exit 0\n"
+  "  fi\n"
+  "  objs=\"$objs $base.o\"\n"
+  "done\n"
+  "if [ -f main_023ae2.c ]; then\n"
+  "  if grep -qs YY_EXTERN_C *.l *.h; then compile=\"gcc -w -x c\"; else compile=\"g++ -w -x c++\"; fi\n"
+  "  if ! $compile -c -o main.o main_023ae2.c > main.log 2>&1; then\n"
+  "    echo \"main main_023ae2.c main.log\" > \"$WORK/$1.fail\"\n"
+  "    exit 0\n"
+  "  fi\n"
+  "  objs=\"$objs main.o\"\n"
+  "fi\n"
+  "if ! g++ -o prog $objs \"$LIBRARY\" > link.log 2>&1; then\n"
+  "  echo \"link program link.log\" > \"$WORK/$1.fail\"\n"
+  "fi\n";
+
+void check_build(const Param& param, Build& build)
+{
+  build.dir = work + "/" + param.name;
+  std::string failure;
+  if (!read_file(work + "/" + param.name + ".fail", failure))
+  {
+    build.done = true;
+    return;
+  }
+  std::istringstream fields(failure);
+  std::string stage, file, log, output;
+  fields >> stage >> file >> log;
+  read_file(build.dir + "/" + log, output);
+  if (stage == "generate")
+    build.log = "reflex --yy failed on " + param.name + "/" + file + ":\n" + head(output, 20);
+  else if (stage == "compile")
+    build.log = "the scanner generated by reflex --yy from " + param.name + "/" + file + " does not compile:\n" + head(output, 30);
+  else if (stage == "main")
+    build.log = param.name + "/" + file + " does not compile:\n" + head(output, 30);
+  else
+    build.log = "the " + param.name + " program does not link:\n" + head(output, 30);
+}
+
+class Builds : public ::testing::Environment {
+ public:
+  void SetUp() override
+  {
+    run("mkdir -p " + quote(work));
+    std::vector<const Param*> params;
+    const ::testing::UnitTest *unit = ::testing::UnitTest::GetInstance();
+    for (int i = 0; i < unit->total_test_suite_count(); ++i)
+    {
+      const ::testing::TestSuite *suite = unit->GetTestSuite(i);
+      for (int j = 0; j < suite->total_test_count(); ++j)
+      {
+        const ::testing::TestInfo *info = suite->GetTestInfo(j);
+        if (!info->should_run() || info->value_param() == NULL)
+          continue;
+        std::map<std::string,Param>::const_iterator param = registry().find(info->value_param());
+        if (param != registry().end())
+          params.push_back(&param->second);
+      }
+    }
+    if (params.empty())
+      return;
+    std::ofstream script((work + "/build.sh").c_str(), std::ios::binary);
+    script << build_script;
+    script.close();
+    std::ofstream jobs((work + "/jobs.txt").c_str(), std::ios::binary);
+    for (size_t i = 0; i < params.size(); ++i)
+    {
+      run("rm -f " + quote(work + "/" + params[i]->name + ".fail"));
+      jobs << params[i]->name << '\n';
+    }
+    jobs.close();
+    run("cd " + quote(work) +
+        " && LC_ALL=C REFLEX=" + quote(reflex) +
+        " INCLUDE=" + quote(root + "/include") +
+        " LIBRARY=" + quote(library) +
+        " CASES=" + quote(cases_dir) +
+        " WORK=" + quote(work) +
+        " xargs -P " + env("SCANNERS_JOBS", "4") + " -L 1 sh build.sh < jobs.txt 2>&1");
+    for (size_t i = 0; i < params.size(); ++i)
+      check_build(*params[i], builds()[params[i]->name]);
+  }
+};
+
+::testing::Environment *const builds_environment = ::testing::AddGlobalTestEnvironment(new Builds);
+
+void expect_output(const Param& param, const char *reference)
+{
+  const Build& build = builds()[param.name];
+  ASSERT_TRUE(build.done) << build.log;
+  std::string expected;
+  ASSERT_TRUE(read_file(cases_dir + "/" + param.name + ".out", expected)) << "missing " << param.name << ".out";
+  std::string input = build.dir + "/stdin";
+  if (!exists(input))
+    input = "/dev/null";
+  std::string output = work + "/" + param.name + ".txt";
+  std::string errors = work + "/" + param.name + ".err";
+  Outcome scan = run("cd " + quote(build.dir) + " && timeout 60 ./prog < " + quote(input) + " > " + quote(output) + " 2> " + quote(errors));
+  std::string actual, stderr_text;
+  read_file(output, actual);
+  read_file(errors, stderr_text);
+  EXPECT_EQ(0, scan.status) << "the program exited with status " << scan.status << (scan.status == 124 ? " (timed out)" : "") << "\n" << head(stderr_text, 10);
+  EXPECT_TRUE(same_output(reference, expected, actual));
+  std::string expected_stderr;
+  if (read_file(cases_dir + "/" + param.name + ".err", expected_stderr))
+    EXPECT_TRUE(same_output(reference, expected_stderr, stderr_text)) << "in what the program wrote to stderr";
+}
