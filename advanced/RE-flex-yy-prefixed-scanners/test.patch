+  zqout = stdout;
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  printf("yy io %d %d\n", yyget_in() == yyin, yyget_out() == stdout);
+  t = yylex();
+  printf("yy %d %s %d\n", t, yytext, yyget_leng());
+  printf("drain\n");
+  while ((t = zqlex()) != 0)
+    printf("zq %d %s\n", t, zqtext);
+  while ((t = yylex()) != 0)
+    printf("yy %d %s\n", t, yytext);
+  fclose(zqlog);
