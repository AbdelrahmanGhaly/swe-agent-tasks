+      modes_given=$((modes_given + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      if [ $# -lt 1 ] || [ -z "$1" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      output_path="$1"
+      shift
+      ;;
+    --output_path=*)
+      output_path="${1#--output_path=}"
+      if [ -z "$output_path" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
