+type normalization struct {
+	regexp  *regexp.Regexp
+	replace string
+}
+
+var normalizeQuotes = normalization{
+	regexp.MustCompile("([`'\"]|\xe2\x80\x98|\xe2\x80\x99)"), `"`,
+}
+
+var normalizeMakeLog = []normalization{
+	normalizeQuotes,
+	{regexp.MustCompile(`make(?:\[\d+\])?: (Entering|Leaving) directory[^\n]*\n`), ""},
+	{regexp.MustCompile(`make(?:\[\d+\])?: `), ""},
+	{regexp.MustCompile(" recipe for target "), " commands for target "},
+	{regexp.MustCompile(" recipe commences "), " commands commence "},
+	{regexp.MustCompile("missing rule before recipe."), "missing rule before commands."},
+	{regexp.MustCompile(" (did you mean TAB instead of 8 spaces?)"), ""},
+	{regexp.MustCompile("Extraneous text after"), "extraneous text after"},
+	{regexp.MustCompile(`\s+Stop\.`), ""},
+	{regexp.MustCompile(`Makefile:\d+: commands for target ".*?" failed\n`), ""},
+	{regexp.MustCompile(`/bin/(ba)?sh: line 1: `), ""},
+	{regexp.MustCompile(`(: \S+: No such file or directory)\n\*\*\* No rule to make target "[^"]+".`), "$1"},
+	{regexp.MustCompile(`\[\S+:\d+: `), "["},
+	{regexp.MustCompile("ninja: warning: [^\n]+"), ""},
+}
+
+var normalizeKati = []normalization{
+	normalizeQuotes,
+	{regexp.MustCompile(`\*kati\*[^\n]*`), ""},
+	{regexp.MustCompile(`c?kati: `), ""},
+	{regexp.MustCompile(`/bin/(ba)?sh: line 1: `), ""},
+	{regexp.MustCompile(`/bin/sh: `), ""},
+	{regexp.MustCompile(`.*: warning for parse error in an unevaluated line: [^\n]*`), ""},
+	{regexp.MustCompile(`([^\n ]+: )?FindEmulator: `), ""},
+	{regexp.MustCompile(` (\./+)+kati\.\S+`), ""},
+	{regexp.MustCompile(` (\./+)+test\S+.json`), ""},
+	{regexp.MustCompile(`(: )open (\S+): n(o such file or directory)\nNOTE:[^\n]*`), "${1}${2}: N${3}"},
+	{regexp.MustCompile(`Too many symbolic links encountered`), "Too many levels of symbolic links"},
+	{regexp.MustCompile(` \(os error \d+\)`), ""},
+}
+
+var circularRE = regexp.MustCompile(`(Circular .* dropped\.\n)`)
+
+func normalize(log []byte, normalizations []normalization) string {
+	ret := []byte{}
+	for _, circ := range circularRE.FindAllSubmatch(log, -1) {
+		ret = append(ret, circ[1]...)
+	}
+	ret = append(ret, circularRE.ReplaceAll(log, []byte{})...)
+	for _, n := range normalizations {
+		ret = n.regexp.ReplaceAll(ret, []byte(n.replace))
+	}
+	return string(ret)
+}
+
+func TestMain(m *testing.M) {
+	os.Unsetenv("MAKEFLAGS")
+	os.Unsetenv("MAKELEVEL")
+	os.Exit(m.Run())
+}
+
+func setUp(t *testing.T, sc scenario) string {
+	dir := t.TempDir()
+	for path, content := range sc.files {
+		full := filepath.Join(dir, path)
+		if err := os.MkdirAll(filepath.Dir(full), 0755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(full, []byte(content), 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir
+}
+
+var ignoredFiles = map[string]bool{
+	"Makefile": true, "build.ninja": true, "env.sh": true, "ninja.sh": true, "gmon.out": true, "submake": true,
+}
+
+func outputFiles(t *testing.T, dir string) string {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var files []string
+	for _, e := range entries {
+		name := e.Name()
+		if ignoredFiles[name] || strings.HasPrefix(name, ".") || strings.HasSuffix(name, ".json") ||
+			strings.HasPrefix(name, "kati") || strings.HasPrefix(name, "stdout") {
+			continue
+		}
+		files = append(files, name)
+	}
+	sort.Strings(files)
+	return strings.Join(files, "\n")
+}
+
+type result struct {
+	output string
+	ok     bool
+	files  string
+}
+
+func execute(dir string, env []string, name string, args ...string) ([]byte, bool) {
+	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, name, args...)
+	cmd.Dir = dir
+	cmd.Env = append(os.Environ(), env...)
+	out, err := cmd.CombinedOutput()
+	if ctx.Err() != nil {
+		out = append(out, []byte("\n(timed out)")...)
+	}
+	return out, err == nil
+}
+
+func runMake(t *testing.T, sc scenario) result {
+	dir := setUp(t, sc)
+	args := append(append([]string{}, sc.args...), "SHELL=/bin/bash")
+	out, ok := execute(dir, sc.env, "make", args...)
+	return result{normalize(out, normalizeMakeLog), ok, outputFiles(t, dir)}
+}
+
+func runKati(t *testing.T, sc scenario, kati string) result {
+	dir := setUp(t, sc)
+	args := append(append([]string{"--use_find_emulator"}, sc.args...), "SHELL=/bin/bash")
+	out, ok := execute(dir, sc.env, kati, args...)
+	return result{normalize(out, normalizeKati), ok, outputFiles(t, dir)}
+}
+
+func TestRecipePrefix(t *testing.T) {
+	version, err := exec.Command("make", "--version").Output()
+	if err != nil || !bytes.HasPrefix(version, []byte("GNU Make 4.2.1\n")) {
+		t.Fatalf("GNU make 4.2.1 must be installed as make: %q %v", version, err)
+	}
+	root, err := filepath.Abs("..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	engines := []struct{ name, path string }{
+		{"ckati", filepath.Join(root, "ckati")},
+		{"rkati", filepath.Join(root, "target", "debug", "rkati")},
+	}
+	for _, sc := range scenarios {
+		sc := sc
+		t.Run(sc.name, func(t *testing.T) {
+			t.Parallel()
+			want := runMake(t, sc)
+			for _, e := range engines {
+				t.Run(e.name, func(t *testing.T) {
+					if _, err := os.Stat(e.path); err != nil {
+						t.Fatalf("%s is not built: %v", e.name, err)
+					}
+					got := runKati(t, sc, e.path)
+					if got.output != want.output {
+						t.Errorf("output differs from make\nmake:\n%s\n%s:\n%s", want.output, e.name, got.output)
+					}
+					if got.ok != want.ok {
+						t.Errorf("make succeeded: %v, %s succeeded: %v", want.ok, e.name, got.ok)
+					}
+					if want.ok && got.files != want.files {
+						t.Errorf("files differ from make\nmake:\n%s\n%s:\n%s", want.files, e.name, got.files)
+					}
+				})
+			}
+		})
+	}
+}
