+pub type StmtList = Arc<Mutex<Vec<Stmt>>>;
+
+/// The statements of |buf|, a text read from |loc|, read again after |after|
+/// inside the open conditionals |frames|, outermost first, each in the part it
+/// takes or, for the innermost one, in its true part if
+/// |innermost_at_true_part|: those after the last endif, and a conditional
+/// holding what was read inside each frame.
+pub fn parse_rest(
+    buf: &Bytes,
+    mut loc: Loc,
+    fixed_lineno: bool,
+    recipe_prefix: u8,
+    after: StmtEnd,
+    frames: &[ReadFrame],
+    innermost_at_true_part: bool,
+) -> Result<(StmtList, Vec<Arc<IfStmt>>)> {
+    collect_stats!("parse eval time");
+    if !fixed_lineno {
+        loc.line = after.line;
+    }
+    let stmts = Arc::new(Mutex::new(Vec::new()));
+    let mut p = Parser::with_buf(buf, loc, stmts.clone(), fixed_lineno, recipe_prefix);
+    p.start = after.offset;
+    p.after_rule = after.after_rule;
+    let mut frame_stmts = Vec::new();
+    for (i, frame) in frames.iter().enumerate() {
+        let stmt = IfStmt::new(
+            Loc::default(),
+            CondOp::Ifeq,
+            Arc::new(Value::Literal(None, Bytes::new())),
+            None,
+            frame.num_nest,
+        );
+        let in_else = frame.in_else && !(innermost_at_true_part && i + 1 == frames.len());
+        p.out_stmts = if in_else {
+            stmt.false_stmts.clone()
+        } else {
+            stmt.true_stmts.clone()
+        };
+        p.if_stack.push(IfState {
+            stmt: stmt.clone(),
+            is_in_else: in_else,
+            num_nest: frame.num_nest,
+        });
+        frame_stmts.push(stmt);
+    }
+    p.parse()?;
+    Ok((stmts, frame_stmts))
+}
