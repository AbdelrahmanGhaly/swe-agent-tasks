+
+void Evaluator::EvalStmts(const std::vector<Stmt*>& stmts) {
+  ReadContext* ctx = read_contexts_.back();
+  for (size_t i = 0; i < stmts.size(); i++) {
+    Stmt* stmt = stmts[i];
+    LOG("%s", stmt->DebugString().c_str());
+    stmt->Eval(this);
+    if (ctx->read_again_after)
+      return;
+    // The rest of the text is read again from the end of the line, once the
+    // other statements read from that line are evaluated too.
+    if (recipe_prefix_ != ctx->recipe_prefix &&
+        (i + 1 == stmts.size() ||
+         stmts[i + 1]->end_offset() != stmt->end_offset())) {
+      ReadAgainAfter(ctx, stmt, false);
+      return;
+    }
+  }
