+
+// Reads the rest of the text of |ctx| again with the current .RECIPEPREFIX and
+// evaluates it instead: what is left of the part each open conditional takes,
+// innermost first, then the statements after them. When the change came from
+// the innermost conditional itself, its true part is read too.
+void Evaluator::ReadAgain(ReadContext* ctx) {
+  const Stmt* after = ctx->read_again_after;
+  std::vector<ReadFrame> frames;
+  frames.swap(ctx->read_again_frames);
+  ctx->read_again_after = nullptr;
+  SupersedeParseErrors(ctx->buf, after->end_offset());
+
+  Loc loc = ctx->loc;
+  if (!ctx->fixed_lineno)
+    loc.lineno = after->end_lineno();
+  std::vector<Stmt*> stmts;
+  std::vector<const IfStmt*> frame_stmts;
+  ParseRest(ctx->buf, after->end_offset(), loc, ctx->fixed_lineno,
+            recipe_prefix_, after->after_rule(), frames,
+            ctx->read_again_at_true_part, &stmts, &frame_stmts);
+
+  ctx->recipe_prefix = recipe_prefix_;
+  for (size_t i = frame_stmts.size(); i > 0 && !ctx->read_again_after; i--) {
+    ctx->open_ifs.assign(frames.begin(), frames.begin() + i);
+    const IfStmt* frame = frame_stmts[i - 1];
+    EvalStmts(frames[i - 1].in_else ? frame->false_stmts : frame->true_stmts);
+  }
+  ctx->open_ifs.clear();
+  if (!ctx->read_again_after)
+    EvalStmts(stmts);
