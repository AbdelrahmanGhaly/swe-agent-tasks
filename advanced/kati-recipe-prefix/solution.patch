+// Like make, which before it runs each line of a command removes the rule's
+// recipe prefix right after every newline of what is left, whether a
+// backslash continued a line or the expansion brought it.
+static void RemovePrefixAfterNewlines(char prefix,
+                                      size_t start,
+                                      std::string* cmds) {
+  size_t w = start;
+  for (size_t r = start; r < cmds->size(); r++) {
+    (*cmds)[w++] = (*cmds)[r];
+    if ((*cmds)[r] == '\n' && r + 1 < cmds->size() && (*cmds)[r + 1] == prefix)
+      r++;
+  }
+  cmds->resize(w);
+}
