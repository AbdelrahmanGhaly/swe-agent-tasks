+import { describe, expect, it, vi } from 'vitest';
+import { MockClock } from './clock/mock-clock.js';
+import { SYSM_CONTROL, SYSM_MSP, SYSM_PSP } from './cortex-m0-core.js';
+import { GDBServer } from './gdb/gdb-server.js';
+import { RP2040 } from './rp2040.js';
+import {
+  opcodeADDS2,
+  opcodeBL,
+  opcodeBT2,
+  opcodeBX,
+  opcodeLDMIA,
+  opcodeLDRB,
+  opcodeLDRBreg,
+  opcodeLDRH,
+  opcodeLDRHreg,
+  opcodeLDRimm,
+  opcodeLDRlit,
+  opcodeLDRreg,
+  opcodeLDRSB,
+  opcodeLDRSH,
+  opcodeLDRsp,
+  opcodeMOVS,
+  opcodeMSR,
+  opcodeNOP,
+  opcodePOP,
+  opcodePUSH,
+  opcodeSTMIA,
+  opcodeSTR,
+  opcodeSTRB,
+  opcodeSTRBreg,
+  opcodeSTRH,
+  opcodeSTRHreg,
+  opcodeSTRreg,
+  opcodeSTRsp,
+  opcodeSUBS2,
+  opcodeUDF,
+  opcodeUDF2,
+} from './utils/assembler.js';
+
+const r0 = 0;
+const r1 = 1;
+const r2 = 2;
+const r3 = 3;
+const r4 = 4;
+const r5 = 5;
+const r6 = 6;
+const r7 = 7;
+const lr = 14;
+
+const VTOR = 0xe000ed08;
+const ICSR = 0xe000ed04;
+const NVIC_ISER = 0xe000e100;
+const NVIC_ISPR = 0xe000e200;
+const NVIC_IPR6 = 0xe000e418;
+const NMIPENDSET = 1 << 31;
+
+const CODE = 0x20000000;
+const VECTORS = 0x20040000;
+const MSP_TOP = 0x20020000;
+const PSP_TOP = 0x20024000;
+const HARDFAULT_HANDLER = 0x20030000;
+const NMI_HANDLER = 0x20030100;
+const IRQ_HANDLER = 0x20030300;
+const DATA = 0x20008000;
+const SRAM_END = 0x20042000;
+const LOCKUP = 0xfffffffe;
+
+const EXC_NMI = 2;
+const EXC_HARDFAULT = 3;
+const USER_IRQ = 26;
+const EXC_USER_IRQ = 16 + USER_IRQ;
+
+const SELF_LOOP = opcodeBT2(-4);
+const CPSID_I = 0xb672;
+
+const CH0_READ_ADDR = 0x50000000;
+const CH0_WRITE_ADDR = 0x50000004;
+const CH0_TRANS_COUNT = 0x50000008;
+const CH0_CTRL_TRIG = 0x5000000c;
+const DMA_EN = 1 << 0;
+const DMA_WORD = 2 << 2;
+const DMA_TREQ_PERMANENT = 0x3f << 15;
+const DMA_BUSY = 1 << 24;
+
+function bkpt(imm8: number) {
+  return 0xbe00 | (imm8 & 0xff);
+}
+
+function writeCode(rp2040: RP2040, address: number, code: number[]) {
+  for (const opcode of code) {
+    rp2040.writeUint16(address, opcode & 0xffff);
+    address += 2;
+    if (opcode > 0xffff) {
+      rp2040.writeUint16(address, opcode >>> 16);
+      address += 2;
+    }
+  }
+}
+
+interface Handlers {
+  hardFault?: number[];
+  nmi?: number[];
+  irq?: number[];
+}
+
+function createCore(code: number[], handlers: Handlers = {}, clock?: MockClock) {
+  const rp2040 = new RP2040(clock);
+  rp2040.writeUint32(VTOR, VECTORS);
+  rp2040.writeUint32(VECTORS, MSP_TOP);
+  rp2040.writeUint32(VECTORS + 4, CODE | 1);
+  rp2040.writeUint32(VECTORS + EXC_NMI * 4, NMI_HANDLER | 1);
+  rp2040.writeUint32(VECTORS + EXC_HARDFAULT * 4, HARDFAULT_HANDLER | 1);
+  rp2040.writeUint32(VECTORS + EXC_USER_IRQ * 4, IRQ_HANDLER | 1);
+  writeCode(rp2040, HARDFAULT_HANDLER, handlers.hardFault ?? [SELF_LOOP]);
+  writeCode(rp2040, NMI_HANDLER, handlers.nmi ?? [SELF_LOOP]);
+  writeCode(rp2040, IRQ_HANDLER, handlers.irq ?? [SELF_LOOP]);
+  writeCode(rp2040, CODE, code);
+  rp2040.core.SP = MSP_TOP;
+  rp2040.core.PC = CODE;
+  return rp2040;
+}
+
+function run(rp2040: RP2040, steps: number) {
+  for (let i = 0; i < steps; i++) {
+    rp2040.step();
+  }
+}
+
+function pc(rp2040: RP2040) {
+  return (rp2040.core.PC & ~1) >>> 0;
+}
+
+function frameAt(rp2040: RP2040, address: number) {
+  const word = (offset: number) => rp2040.readUint32(address + offset) >>> 0;
+  return {
+    r0: word(0),
+    r1: word(4),
+    r2: word(8),
+    r3: word(12),
+    r12: word(16),
+    lr: word(20),
+    pc: word(24),
+    xpsr: word(28),
+  };
+}
+
+function stackedFrame(rp2040: RP2040) {
+  return frameAt(rp2040, rp2040.core.SP);
+}
+
+function expectHardFault(rp2040: RP2040, returnAddress: number) {
+  expect(rp2040.core.IPSR).toEqual(EXC_HARDFAULT);
+  expect(pc(rp2040)).toEqual(HARDFAULT_HANDLER);
+  expect(stackedFrame(rp2040).pc).toEqual(returnAddress);
+}
+
+function expectNoFault(rp2040: RP2040, expectedPC: number) {
+  expect(rp2040.core.IPSR).toEqual(0);
+  expect(pc(rp2040)).toEqual(expectedPC);
+}
+
+function snapshot(rp2040: RP2040) {
+  const { core } = rp2040;
+  return {
+    registers: Array.from(core.registers),
+    IPSR: core.IPSR,
+    xPSR: core.xPSR >>> 0,
+    frame: stackedFrame(rp2040),
+  };
+}
+
+function expectLockedUp(rp2040: RP2040, ipsr: number) {
+  expect(rp2040.core.PC >>> 0).toEqual(LOCKUP);
+  expect(rp2040.core.IPSR).toEqual(ipsr);
+  const before = snapshot(rp2040);
+  run(rp2040, 6);
+  expect(snapshot(rp2040)).toEqual(before);
+  expect(rp2040.core.PC >>> 0).toEqual(LOCKUP);
+}
+
+function expectStuck(rp2040: RP2040) {
+  expect(rp2040.core.PC >>> 0).toEqual(LOCKUP);
+  const before = snapshot(rp2040);
+  run(rp2040, 6);
+  expect(snapshot(rp2040)).toEqual(before);
+  expect(rp2040.core.PC >>> 0).toEqual(LOCKUP);
+}
+
+function pendNMI(rp2040: RP2040) {
+  rp2040.writeUint32(ICSR, NMIPENDSET);
+}
+
+function raiseUserIRQ(rp2040: RP2040, priority: number) {
+  rp2040.writeUint32(NVIC_IPR6, (priority & 0x3) << (8 * (USER_IRQ % 4) + 6));
+  rp2040.writeUint32(NVIC_ISER, 1 << USER_IRQ);
+  rp2040.writeUint32(NVIC_ISPR, 1 << USER_IRQ);
+}
+
