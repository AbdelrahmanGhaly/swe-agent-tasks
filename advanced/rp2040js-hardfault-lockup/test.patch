+      ['realigned to end exactly at the end of sram', SRAM_END + 4, SRAM_END - 0x20],
+    ])('takes the HardFault normally when its frame is pushed %s', (_name, sp, frame) => {
+      const rp2040 = createCore([opcodeLDRimm(r0, r1, 0), opcodeNOP()]);
+      rp2040.core.SP = sp;
+      rp2040.core.registers[r1] = 0x30000000;
+      run(rp2040, 3);
+      expect(rp2040.core.IPSR).toEqual(EXC_HARDFAULT);
+      expect(pc(rp2040)).toEqual(HARDFAULT_HANDLER);
+      expect(rp2040.core.SP).toEqual(frame);
+    });
+
+    it('locks up on a fault inside the NMI handler', () => {
+      const rp2040 = createCore([opcodeNOP(), SELF_LOOP], {
+        nmi: [opcodeMOVS(r4, 0x24), opcodeSTR(r0, r1, 0), opcodeNOP()],
+      });
+      rp2040.core.registers[r1] = 0x30000000;
+      pendNMI(rp2040);
+      run(rp2040, 5);
+      expectLockedUp(rp2040, EXC_NMI);
+      expect(rp2040.core.registers[r4]).toEqual(0x24);
+    });
+
+    it('locks up on bkpt inside the NMI handler', () => {
+      const rp2040 = createCore([opcodeNOP(), SELF_LOOP], { nmi: [bkpt(9), opcodeNOP()] });
+      pendNMI(rp2040);
+      run(rp2040, 4);
+      expectLockedUp(rp2040, EXC_NMI);
+    });
+
+    it('ignores an NMI after locking up in the NMI handler', () => {
+      const rp2040 = createCore([opcodeNOP(), SELF_LOOP], { nmi: [opcodeUDF(3)] });
+      pendNMI(rp2040);
+      run(rp2040, 4);
+      expectLockedUp(rp2040, EXC_NMI);
+      pendNMI(rp2040);
+      expectLockedUp(rp2040, EXC_NMI);
+    });
+
+    it('does not let a pending interrupt leave a lockup', () => {
+      const rp2040 = createCore([opcodeUDF(1)], { hardFault: [opcodeUDF(2)] });
+      run(rp2040, 4);
+      raiseUserIRQ(rp2040, 0);
+      expectLockedUp(rp2040, EXC_HARDFAULT);
+    });
+  });
+
+  describe('accesses that are not made by the core', () => {
+    it('lets the host read and write addresses that fault when the core uses them', () => {
+      const rp2040 = createCore([opcodeMOVS(r2, 1), opcodeLDRimm(r0, r1, 0)]);
+      expect(rp2040.readUint32(0x30000000) >>> 0).toEqual(0xffffffff);
+      expect(() => rp2040.writeUint32(0x30000000, 0x1234)).not.toThrow();
+      expect(() => rp2040.writeUint16(0x60000000, 0x1234)).not.toThrow();
+      expect(rp2040.core.IPSR).toEqual(0);
+      expect(pc(rp2040)).toEqual(CODE);
+      rp2040.core.registers[r1] = 0x30000000;
+      run(rp2040, 4);
+      expectHardFault(rp2040, CODE + 2);
+      expect(stackedFrame(rp2040).r2).toEqual(1);
+    });
+
+    it('lets DMA read unbacked memory that faults when the core reads it', () => {
+      const clock = new MockClock();
+      const rp2040 = createCore([opcodeMOVS(r2, 1), opcodeLDRimm(r0, r1, 0)], {}, clock);
+      rp2040.writeUint32(DATA, 0x12345678);
+      rp2040.writeUint32(CH0_READ_ADDR, 0x30000000);
+      rp2040.writeUint32(CH0_WRITE_ADDR, DATA);
+      rp2040.writeUint32(CH0_TRANS_COUNT, 1);
+      rp2040.writeUint32(CH0_CTRL_TRIG, DMA_EN | DMA_WORD | DMA_TREQ_PERMANENT);
+      clock.advance(32);
+      expect(rp2040.readUint32(DATA) >>> 0).toEqual(0xffffffff);
+      expect(rp2040.readUint32(CH0_TRANS_COUNT)).toEqual(0);
+      expect(rp2040.readUint32(CH0_CTRL_TRIG) & DMA_BUSY).toEqual(0);
+      expect(rp2040.core.IPSR).toEqual(0);
+      expect(pc(rp2040)).toEqual(CODE);
+      rp2040.core.registers[r1] = 0x30000000;
+      run(rp2040, 4);
+      expectHardFault(rp2040, CODE + 2);
+      expect(stackedFrame(rp2040).r2).toEqual(1);
+    });
+
+    it('lets DMA write unbacked memory that faults when the core writes it', () => {
+      const clock = new MockClock();
+      const rp2040 = createCore([opcodeMOVS(r2, 1), opcodeSTR(r0, r1, 0)], {}, clock);
+      rp2040.writeUint32(DATA, 0x12345678);
+      rp2040.writeUint32(CH0_READ_ADDR, DATA);
+      rp2040.writeUint32(CH0_WRITE_ADDR, 0x60000000);
+      rp2040.writeUint32(CH0_TRANS_COUNT, 1);
