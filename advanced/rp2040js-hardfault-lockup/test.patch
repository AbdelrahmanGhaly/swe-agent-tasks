+
+    it.each([
+      ['below the start of the xip region', 0x10000010],
+      ['across the start of the sram alias', 0x21000010],
+      ['into unbacked memory', 0x30000020],
+    ])('locks up when the HardFault frame would be pushed %s', (_name, sp) => {
+      const rp2040 = createCore([opcodeMOVS(r5, 0x5e), opcodeLDRimm(r0, r1, 0), opcodeNOP()]);
+      rp2040.core.SP = sp;
+      rp2040.core.registers[r1] = 0x30000000;
+      run(rp2040, 4);
+      expectStuck(rp2040);
+      expect(rp2040.core.registers[r5]).toEqual(0x5e);
+    });
+
+    it('locks up when the HardFault frame would be pushed to an unbacked process stack', () => {
+      const rp2040 = createCore([
+        opcodeMSR(SYSM_CONTROL, r6),
+        opcodeMOVS(r5, 0x5e),
+        opcodeLDRimm(r0, r1, 0),
+      ]);
+      rp2040.core.writeSpecialRegister(SYSM_PSP, 0x30000020);
+      rp2040.core.registers[r6] = 2;
+      rp2040.core.registers[r1] = 0x30000000;
+      run(rp2040, 5);
+      expectStuck(rp2040);
+      expect(rp2040.core.registers[r5]).toEqual(0x5e);
+      expect(rp2040.core.readSpecialRegister(SYSM_MSP) >>> 0).toEqual(MSP_TOP);
+    });
+
+    it.each([
+      ['across the xip/sram seam', 0x20000010, 0x1ffffff0],
