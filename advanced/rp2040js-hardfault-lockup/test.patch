+      expect(rp2040.readUint32(CH0_TRANS_COUNT)).toEqual(0);
+      expect(rp2040.readUint32(CH0_CTRL_TRIG) & DMA_BUSY).toEqual(0);
+      expect(rp2040.core.IPSR).toEqual(0);
+      expect(pc(rp2040)).toEqual(CODE);
+      rp2040.core.registers[r1] = 0x60000000;
+      run(rp2040, 4);
+      expectHardFault(rp2040, CODE + 2);
+      expect(stackedFrame(rp2040).r2).toEqual(1);
+    });
+
+    it('lets GDB read and write memory that faults when the core uses it', () => {
+      const rp2040 = createCore([opcodeMOVS(r2, 1), opcodeLDRimm(r0, r1, 0)]);
+      const server = new GDBServer({
