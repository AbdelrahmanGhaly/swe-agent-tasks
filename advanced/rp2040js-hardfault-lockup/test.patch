+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      if [ $# -lt 1 ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")"
+
+if [ -z "$OUTPUT_PATH" ]; then
+  OUTPUT_PATH="$(pwd)/test-results-${MODE}.xml"
+fi
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+NEW_TEST="src/hardfault_a92d3d.spec.ts"
+VITEST="./node_modules/.bin/vitest"
+
+if [ "$MODE" = "new" ]; then
+  timeout 900 "$VITEST" run --reporter=default --reporter=junit --outputFile.junit="$OUTPUT_PATH" "$NEW_TEST"
+  STATUS=$?
+else
+  timeout 900 "$VITEST" run --reporter=default --reporter=junit --outputFile.junit="$OUTPUT_PATH" \
+    --exclude "$NEW_TEST" --exclude "**/node_modules/**" --exclude "**/dist/**"
+  STATUS=$?
+fi
+
+make_test_names_unique() {
+  node -e '
+const fs = require("fs");
+const file = process.argv[1];
+const seen = new Map();
+const xml = fs.readFileSync(file, "utf8").replace(
+  /<testcase classname="([^"]*)" name="([^"]*)"/g,
+  (match, classname, name) => {
+    const key = classname + "\u0000" + name;
+    const count = (seen.get(key) || 0) + 1;
+    seen.set(key, count);
+    return count === 1 ? match : `<testcase classname="${classname}" name="${name} (${count})"`;
+  },
+);
+fs.writeFileSync(file, xml);
+' "$1"
+}
+
+if [ -f "$OUTPUT_PATH" ]; then
+  make_test_names_unique "$OUTPUT_PATH"
+fi
+
+if [ "$STATUS" -ne 0 ] && ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  if [ "$MODE" = "new" ]; then
+    SUITE="$NEW_TEST"
+  else
+    SUITE="base"
+  fi
+  cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites name="vitest tests" tests="1" failures="1" errors="0">
+<testsuite name="${SUITE}" tests="1" failures="1" errors="0">
+<testcase classname="${SUITE}" name="test run">
+<failure message="vitest exited with status ${STATUS} before reporting any test">vitest exited with status ${STATUS} before reporting any test</failure>
+</testcase>
+</testsuite>
+</testsuites>
+XMLEOF
+fi
+
+exit "$STATUS"
