+func TestRelative(t *testing.T) {
+	t.Parallel()
+	h := newHarness(t, "127.0.0.41")
+	build(t, h.root, append(relativeTree(),
+		node{path: "src/g/g.sh", kind: 'f', perm: 0o750 | fs.ModeSetgid, mtime: 1578218400, data: "setgid, group executable"},
+		node{path: "src/g", kind: 'd', perm: 0o755, mtime: 1546300800},
+		node{path: "src/f/node", kind: 'f', perm: 0o644, mtime: 1578304800, data: "a file named node"},
+		node{path: "src/d/node/child.txt", kind: 'f', perm: 0o644, mtime: 1578391200, data: "in the directory named node"},
+		node{path: "src/d/node", kind: 'd', perm: 0o750, mtime: 1546387200},
+		node{path: "src/d", kind: 'd', perm: 0o755, mtime: 1546473600},
+		node{path: "src/f", kind: 'd', perm: 0o755, mtime: 1546560000},
+	))
+	build(t, h.abs("pre/stale-parents"), []node{
+		{path: "src/a/b/c/extra.txt", kind: 'f', perm: 0o644, mtime: 1600000000, data: "extra"},
+		{path: "src/a/b/c", kind: 'd', perm: 0o700, mtime: 1600000000},
+		{path: "src/a/b", kind: 'd', perm: 0o777, mtime: 1600000000},
+		{path: "src/a", kind: 'd', perm: 0o700, mtime: 1600000000},
+		{path: "src", kind: 'd', perm: 0o755, mtime: 1600000000},
+	})
+	build(t, h.abs("pre/empty-dir"), []node{
+		{path: "src/a/b/c/sub", kind: 'd', perm: 0o700, mtime: 1600000000},
+	})
+	build(t, h.abs("pre/owner-changes"), []node{
+		{path: "src/a/b/x.txt", kind: 'f', perm: 0o640 | fs.ModeSetuid, mtime: 1578045600, data: "relative x"},
+	})
+	build(t, h.abs("pre/owner-changes-setgid"), []node{
+		{path: "src/g/g.sh", kind: 'f', perm: 0o750 | fs.ModeSetgid, mtime: 1578218400, data: "setgid, group executable"},
+	})
+	clients := []string{"gokr-client-push-shell", "gokr-client-push-daemon", "gokr-local"}
+	// The owner changes run with -a only: with -c the receiver reads the
+	// destination file first, and under gVisor a process that has had a file
+	// open can go on seeing its setuid and setgid bits after a chown cleared
+	// them, so a receiver that checks the mode after the chown, as rsync
+	// does, would sometimes leave them cleared.
+	archiveOnly := [][]string{{"-a"}}
+	// As root, the destination copies belong to uid 4242, so the receiver
+	// gives them the owner of the source, which clears their setuid and
+	// setgid bits. A receiver that is not root changes no owner, and neither
+	// does rsync: the copies then start without those bits, the way a chown
+	// leaves them. Either way the receiver has to set them again.
+	for _, f := range []struct {
+		path string
+		perm fs.FileMode
+	}{
+		{"pre/owner-changes/src/a/b/x.txt", 0o640 | fs.ModeSetuid},
+		{"pre/owner-changes-setgid/src/g/g.sh", 0o750 | fs.ModeSetgid},
+	} {
+		perm := f.perm.Perm()
+		if os.Getuid() == 0 {
+			if err := os.Lchown(h.abs(f.path), 4242, 4242); err != nil {
+				t.Fatal(err)
+			}
+			perm = f.perm
+		}
+		if err := os.Chmod(h.abs(f.path), perm); err != nil {
+			t.Fatal(err)
+		}
+	}
+	h.runAll(t, []scenario{
+		{name: "nested", opts: []string{"-R"}, args: []string{"src/a/b/c"}},
+		{name: "dot-dir", opts: []string{"-R"}, args: []string{"src/a/./b/c"}},
+		{name: "dot-dir-first", opts: []string{"-R"}, args: []string{"src/./a/b"}},
+		{name: "file", opts: []string{"-R"}, args: []string{"src/a/b/c/sub/f2.txt"}},
+		{name: "two-args", opts: []string{"-R"}, args: []string{"src/a/b/c", "src/a/y.txt"}},
+		{name: "nested-from-cwd", opts: []string{"-R"}, args: []string{"src/a/b/c"}, asGiven: true, onlyRoles: clients},
+		{name: "dot-dir-from-cwd", opts: []string{"-R"}, args: []string{"src/a/./b/c"}, asGiven: true, onlyRoles: clients},
+		{name: "two-args-from-cwd", opts: []string{"-R"}, args: []string{"src/a/b/c", "src/a/y.txt"}, asGiven: true, onlyRoles: clients},
+		{name: "absolute-path", opts: []string{"-R"}, args: []string{"ROOT/src/a/b/c"}, asGiven: true, onlyRoles: append(clients, "gokr-server-send-shell")},
+		{name: "overlap", opts: []string{"-R"}, args: []string{"src/a/b/c", "src/a/b"}},
+		{name: "file-then-dir", opts: []string{"-R"}, args: []string{"src/f/./node", "src/d/./node"}},
+		{name: "file-then-implied-dir", opts: []string{"-R"}, args: []string{"src/f/./node", "src/d/./node/child.txt"}},
+		{name: "stale-parents", opts: []string{"-R"}, args: []string{"src/a/b/c"}, pre: "pre/stale-parents"},
+		{name: "empty-dir", opts: []string{"-R"}, args: []string{"src/a/b/c"}, pre: "pre/empty-dir"},
+		{name: "owner-changes", opts: []string{"-R"}, args: []string{"src/a/b/x.txt"}, pre: "pre/owner-changes", optSets: archiveOnly},
+		{name: "owner-changes-setgid", opts: []string{"-R"}, args: []string{"src/g/g.sh"}, pre: "pre/owner-changes-setgid", optSets: archiveOnly},
+	}, roles)
+}
