+type entry struct {
+	Kind   string
+	Mode   fs.FileMode
+	Size   int64
+	Sum    string
+	Target string
+	MTime  int64
+	Links  uint64
+	Uid    uint32
+	Gid    uint32
+	Rdev   uint64
+}
+
+func snapshot(t *testing.T, dir string, withRoot bool) map[string]entry {
+	t.Helper()
+	m := make(map[string]entry)
+	err := filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(dir, path)
+		if err != nil {
+			return err
+		}
+		if rel == "." && !withRoot {
+			return nil
+		}
+		info, err := os.Lstat(path)
+		if err != nil {
+			return err
+		}
+		st := info.Sys().(*syscall.Stat_t)
+		e := entry{
+			Mode:  info.Mode() & (fs.ModePerm | fs.ModeSetuid | fs.ModeSetgid | fs.ModeSticky),
+			MTime: info.ModTime().Unix(),
+			Links: uint64(st.Nlink),
+			Uid:   st.Uid,
+			Gid:   st.Gid,
+		}
+		switch {
+		case info.IsDir():
+			e.Kind = "dir"
+			e.Links = 0
+		case info.Mode().IsRegular():
+			e.Kind = "file"
+			data, err := os.ReadFile(path)
+			if err != nil {
+				return err
+			}
+			sum := sha256.Sum256(data)
+			e.Size = int64(len(data))
+			e.Sum = hex.EncodeToString(sum[:8])
+		case info.Mode()&fs.ModeSymlink != 0:
+			e.Kind = "symlink"
+			e.Mode = 0
+			target, err := os.Readlink(path)
+			if err != nil {
+				return err
+			}
+			e.Target = target
+		case info.Mode()&fs.ModeNamedPipe != 0:
+			e.Kind = "fifo"
+		case info.Mode()&fs.ModeDevice != 0:
+			e.Kind = info.Mode().Type().String()
+			e.Rdev = uint64(st.Rdev)
+		default:
+			e.Kind = info.Mode().Type().String()
+		}
+		m[filepath.ToSlash(rel)] = e
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+// fileID identifies a file by its device and inode number.
+type fileID struct{ dev, ino uint64 }
+
+// inodes maps every entry below dir, and dir itself, to its device and inode
+// number.
+func inodes(t *testing.T, dir string) map[string]fileID {
+	t.Helper()
+	m := make(map[string]fileID)
+	if _, err := os.Stat(dir); os.IsNotExist(err) {
+		return m
+	}
+	err := filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		info, err := os.Lstat(path)
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(dir, path)
+		if err != nil {
+			return err
+		}
+		st := info.Sys().(*syscall.Stat_t)
+		m[filepath.ToSlash(rel)] = fileID{uint64(st.Dev), st.Ino}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+// linkGroups maps every entry below dir that shares its inode with other
+// entries below dir or below prev (named "prev/..." then) to those entries.
+func linkGroups(t *testing.T, dir, prev string) map[string][]string {
+	t.Helper()
+	byID := make(map[fileID][]string)
+	for name, id := range inodes(t, dir) {
+		byID[id] = append(byID[id], name)
+	}
+	if prev != "" {
+		for name, id := range inodes(t, prev) {
+			byID[id] = append(byID[id], "prev/"+name)
+		}
+	}
+	m := make(map[string][]string)
+	for _, names := range byID {
+		if len(names) < 2 {
+			continue
+		}
+		sort.Strings(names)
+		for _, name := range names {
+			if strings.HasPrefix(name, "prev/") {
+				continue
+			}
+			var others []string
+			for _, other := range names {
+				if other != name {
+					others = append(others, other)
+				}
+			}
+			m[name] = others
+		}
+	}
+	return m
+}
+
+// untouched returns the entries below dir that still have the inode they had
+// before the transfer.
+func untouched(t *testing.T, dir string, before map[string]fileID) []string {
+	t.Helper()
+	var names []string
+	for name, id := range inodes(t, dir) {
+		if prior, ok := before[name]; ok && prior == id {
+			names = append(names, name)
+		}
+	}
+	sort.Strings(names)
+	return names
+}
