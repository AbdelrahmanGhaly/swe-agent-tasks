+func linkDestTree() []node {
+	return []node{
+		{path: "src/same.txt", kind: 'f', perm: 0o644, mtime: 1577872800, data: "same in both"},
+		{path: "src/mode.txt", kind: 'f', perm: 0o644, mtime: 1577872800, data: "other mode in prev"},
+		{path: "src/mtime.txt", kind: 'f', perm: 0o644, mtime: 1577872800, data: "other mtime in prev"},
