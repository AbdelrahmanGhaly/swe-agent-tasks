+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      [ -n "$OUTPUT_PATH" ] || { echo "missing value for --output_path" >&2; usage; }
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")" || exit 2
+
+export GOFLAGS=-buildvcs=false
+export GOTOOLCHAIN=local
+if [ -n "${GOCACHE:-}" ] && [ ! -w "$GOCACHE" ]; then
+  export GOCACHE="/tmp/go-build-$(id -u)"
+fi
+
+NEW_DIR="integration/backup_7235f9"
+NEW_PKG="github.com/gokrazy/rsync/$NEW_DIR"
+LOG="$(mktemp)"
+LIST="$(mktemp)"
+trap 'rm -f "$LOG" "$LIST"' EXIT
+
+# Base mode runs every test of the repository except the new package and these:
+# - TestInteropRemoteDaemonSSH and TestReceiverSSH start the system ssh client. ssh and ssh-keygen
+#   refuse to run for a uid without an account entry, the image only has entries for root and
+#   uid 1000, and the tests may run as another uid. The new tests cover the remote shell path
+#   without ssh.
+# - TestReceiverSparse requires the received file to keep its 8 MiB holes unallocated. That depends
+#   on the file system under the temporary directory: where it allocates holes, the test fails on
+#   the unpatched repository. Sparse files are unrelated to the options the new tests cover.
+# - TestPath unit-tests getStrip, an unexported helper that splits a source path for transfers
+#   without -R. Adding -R and --files-from reworks this part of the sender, and the helper can go
+#   away with it; how source paths map to names stays checked end to end by the repository's sender
+#   and interop tests and by the new tests.
+# - TestSenderNamedSourceParentUnreadable and TestSenderNamedFileParentUnreadable check a source
+#   below a directory the sender cannot read. Root can read every directory, so as root they skip
+#   themselves: whether they pass depends on the user running them, and the set of base tests
+#   must not.
+EXCLUDED="TestInteropRemoteDaemonSSH|TestReceiverSSH|TestReceiverSparse|TestPath|TestSenderNamedSourceParentUnreadable|TestSenderNamedFileParentUnreadable"
+
+# The timeouts end a run in which a test hangs early enough for both runs to still write their reports.
+if [ "$MODE" = "base" ]; then
+  ALL_PKGS="$(go list ./... 2>>"$LOG")"
+  LIST_STATUS=$?
+  PKGS="$(printf '%s\n' "$ALL_PKGS" | grep -v "/$NEW_DIR\$")"
+  go test -list . $PKGS >"$LIST" 2>&1
+  STATUS=$?
+  BASE_TESTS="$(grep -E '^(Test|Example|Fuzz)[A-Za-z0-9_]*$' "$LIST" | grep -vxE "$EXCLUDED" | sort -u | paste -sd '|' -)"
+  if [ "$LIST_STATUS" -eq 0 ] && [ "$STATUS" -eq 0 ] && [ -n "$BASE_TESTS" ]; then
+    go test -v -count=1 -timeout 8m -run "^(${BASE_TESTS})\$" $PKGS >>"$LOG" 2>&1
+    STATUS=$?
+  else
+    cat "$LIST" >>"$LOG"
+  fi
+  if [ "$LIST_STATUS" -ne 0 ]; then
+    echo "go list ./... failed with exit status $LIST_STATUS" >>"$LOG"
+    STATUS=$LIST_STATUS
+  fi
+else
+  go test -v -count=1 -timeout 15m "./$NEW_DIR/" >>"$LOG" 2>&1
+  STATUS=$?
+fi
+
+if ! grep -qE '^ *--- (PASS|FAIL|SKIP):' "$LOG"; then
+  echo "no tests were collected in mode $MODE" >>"$LOG"
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+cat "$LOG"
+
+expected_tests() {
+  grep -ho '^func Test[A-Za-z0-9_]*(t \*testing\.T)' "$NEW_DIR"/*_test.go | sed -e 's/^func //' -e 's/(.*//'
+}
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  go-junit-report <"$LOG" >"$OUTPUT_PATH" 2>/dev/null || true
+  PANICKED="$(awk '/^--- FAIL: /{name=$3} /^panic: /{print name; exit}' "$LOG")"
+  if [ -n "$PANICKED" ] && grep -q "<testcase name=\"$PANICKED\"" "$OUTPUT_PATH" 2>/dev/null; then
+    PANIC_TEXT="$(mktemp)"
+    PATCHED="$(mktemp)"
+    sed -n '/^panic: /,$p' "$LOG" | head -n 40 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' >"$PANIC_TEXT"
+    awk -v name="$PANICKED" -v text="$PANIC_TEXT" '
+      index($0, "<testcase name=\"" name "\"") { inside = 1 }
+      inside && /<failure message="Failed"><\/failure>/ {
+        sub(/<failure message="Failed"><\/failure>/, "<failure message=\"panic\">")
+        printf "%s", $0
+        while ((getline line < text) > 0) print line
+        print "</failure>"
+        inside = 0
+        next
+      }
+      /<\/testcase>/ { inside = 0 }
+      { print }
+    ' "$OUTPUT_PATH" >"$PATCHED" && cat "$PATCHED" >"$OUTPUT_PATH"
+    rm -f "$PANIC_TEXT" "$PATCHED"
+  fi
+  RAN=0
+  NAMES=""
+  if [ "$MODE" = "new" ]; then
+    SUITE="$NEW_PKG"
+    for name in $(expected_tests); do
+      if grep -q "<testcase name=\"$name\"" "$OUTPUT_PATH" 2>/dev/null; then
+        RAN=1
+      else
+        NAMES="$NAMES $name"
+      fi
+    done
+  else
+    SUITE="github.com/gokrazy/rsync"
+    if grep -q '<testcase ' "$OUTPUT_PATH" 2>/dev/null; then
+      RAN=1
+    else
+      NAMES="build"
+    fi
+  fi
+  if [ -n "$NAMES" ]; then
+    [ "$STATUS" -eq 0 ] && STATUS=1
+    DETAIL="$(grep -E '^# |\.go:[0-9]+:[0-9]+: |\[(build|setup) failed\]|^panic' "$LOG" | head -n 40)"
+    [ -n "$DETAIL" ] || DETAIL="$(tail -n 40 "$LOG")"
+    DETAIL="$(printf '%s\n' "$DETAIL" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+    if [ "$RAN" -eq 1 ] && [ -n "$PANICKED" ]; then
+      MESSAGE="not run: the test binary exited after $PANICKED panicked"
+    elif [ "$RAN" -eq 1 ]; then
+      MESSAGE="not run: the test binary exited before reaching this test"
+    else
+      MESSAGE="the test package failed to build or run"
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n</testsuites>\n' >"$OUTPUT_PATH"
+    fi
+    COUNT="$(printf '%s\n' $NAMES | grep -c .)"
+    EXTRA="$(mktemp)"
+    MERGED="$(mktemp)"
+    {
+      echo "<testsuite name=\"$SUITE\" tests=\"$COUNT\" failures=\"$COUNT\" errors=\"0\">"
+      for name in $NAMES; do
+        echo "<testcase name=\"$name\" classname=\"$SUITE\"><failure message=\"$MESSAGE\">$DETAIL</failure></testcase>"
+      done
+      echo '</testsuite>'
+    } >"$EXTRA"
+    awk -v extra="$EXTRA" '/<\/testsuites>/ { while ((getline line < extra) > 0) print line } { print }' "$OUTPUT_PATH" >"$MERGED"
+    TESTS="$(grep -c '<testcase ' "$MERGED")"
+    FAILURES="$(grep -c '<failure' "$MERGED")"
+    ERRORS="$(grep -c '<error' "$MERGED")"
+    sed -E "1,/<testsuites/ s#<testsuites[^>]*>#<testsuites tests=\"$TESTS\" failures=\"$FAILURES\" errors=\"$ERRORS\">#" "$MERGED" >"$OUTPUT_PATH"
+    rm -f "$EXTRA" "$MERGED"
+  fi
+fi
+
+exit "$STATUS"
