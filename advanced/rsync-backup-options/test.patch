+// noBasisTree is linkDestTree without the files that rsync transfers against a
+// basis file in the --link-dest directory, under rel/: rsync 3.2.7 discards
+// such a file ("failed verification") when the directory is given as ../prev
+// and it transfers deltas, as it does between hosts.
+func noBasisTree() []node {
+	var nodes []node
+	for _, n := range linkDestTree() {
+		if n.path == "src/mtime.txt" || n.path == "src/edited.txt" {
+			continue
+		}
+		n.path = "rel" + strings.TrimPrefix(n.path, "src")
+		nodes = append(nodes, n)
+	}
+	return nodes
+}
