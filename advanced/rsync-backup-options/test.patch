+func TestMain(m *testing.M) {
+	if err := rsynctest.CommandMain(m); err != nil {
+		log.Fatal(err)
+	}
+}
+
+type node struct {
+	path  string
+	kind  byte // 'd' directory, 'f' file, 'l' symlink, 'p' FIFO, 'c' or 'b' device, 'h' hard link to data
+	perm  fs.FileMode
+	mtime int64
+	data  string
+	rdev  uint64
+}
+
+func setTime(t *testing.T, path string, mtime int64) {
+	t.Helper()
+	ts := []unix.Timespec{unix.NsecToTimespec(mtime * 1e9), unix.NsecToTimespec(mtime * 1e9)}
+	if err := unix.UtimesNanoAt(unix.AT_FDCWD, path, ts, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func build(t *testing.T, root string, nodes []node) {
+	t.Helper()
+	if err := os.MkdirAll(root, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	var dirs []node
+	for _, n := range nodes {
+		p := filepath.Join(root, n.path)
+		if n.kind == 'd' {
+			if err := os.MkdirAll(p, 0o755); err != nil {
+				t.Fatal(err)
+			}
+			dirs = append(dirs, n)
+			continue
+		}
+		if err := os.MkdirAll(filepath.Dir(p), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		var err error
+		switch n.kind {
+		case 'f':
+			err = os.WriteFile(p, []byte(n.data), 0o600)
+			if err == nil {
+				err = os.Chmod(p, n.perm)
+			}
+		case 'l':
+			err = os.Symlink(n.data, p)
+		case 'p':
+			err = unix.Mkfifo(p, 0o600)
+			if err == nil {
+				err = os.Chmod(p, n.perm)
+			}
+		case 'c', 'b':
+			mode := uint32(unix.S_IFCHR)
+			if n.kind == 'b' {
+				mode = unix.S_IFBLK
+			}
+			err = unix.Mknod(p, mode|0o600, int(n.rdev))
+			if errors.Is(err, unix.EPERM) {
+				// Creating a device needs CAP_MKNOD: without it, the tree
+				// has no devices.
+				continue
+			}
+			if err == nil {
+				err = os.Chmod(p, n.perm)
+			}
+		case 'h':
+			if err := os.Link(filepath.Join(root, n.data), p); err != nil {
+				t.Fatal(err)
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		setTime(t, p, n.mtime)
+	}
+	sort.SliceStable(dirs, func(i, j int) bool {
+		return strings.Count(dirs[i].path, "/") > strings.Count(dirs[j].path, "/")
+	})
+	for _, d := range dirs {
+		p := filepath.Join(root, d.path)
+		if err := os.Chmod(p, d.perm); err != nil {
+			t.Fatal(err)
+		}
+		setTime(t, p, d.mtime)
+	}
+}
