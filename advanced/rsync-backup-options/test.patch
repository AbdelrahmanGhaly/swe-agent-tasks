+func TestFilesFrom(t *testing.T) {
+	t.Parallel()
+	h := newHarness(t, "127.0.0.47")
+	build(t, h.root, append(relativeTree(),
+		node{path: "src/a/b/c/f1-link", kind: 'h', data: "src/a/b/c/f1.txt"},
+		node{path: "src/a/y-link", kind: 'h', data: "src/a/b/c/f1.txt"},
+		node{path: "src/a/dlink", kind: 'l', mtime: 1578045600, data: "b"},
+		node{path: "src/root.txt", kind: 'f', perm: 0o644, mtime: 1578218400, data: "root.txt inside src"},
+		node{path: "src/a/root.txt", kind: 'f', perm: 0o644, mtime: 1578564000, data: "root.txt below a"},
+		node{path: "root.txt", kind: 'f', perm: 0o644, mtime: 1578304800, data: "root.txt outside the source directory"},
+		node{path: "src/#keep", kind: 'f', perm: 0o644, mtime: 1578391200, data: "a name that starts with #"},
+		node{path: "src/;semi", kind: 'f', perm: 0o644, mtime: 1578477600, data: "a name that starts with ;"},
+	))
+	// A long list names a directory of many files first, then many single
+	// files. The list and the file list the sender sends back for it are each
+	// far larger than what the connection buffers hold, so a client that pulls
+	// with it has to send the names while it receives the file list.
+	var long strings.Builder
+	long.WriteString("many\n")
+	manyTree := []node{
+		{path: "src/many", kind: 'd', perm: 0o755, mtime: 1546646400},
+		{path: "src/tail", kind: 'd', perm: 0o755, mtime: 1546732800},
+	}
+	for i := range 4096 {
+		name := fmt.Sprintf("%04d-%s", i, strings.Repeat("n", 145))
+		manyTree = append(manyTree,
+			node{path: "src/many/" + name, kind: 'f', perm: 0o644, mtime: 1578650400},
+			node{path: "src/tail/" + name, kind: 'f', perm: 0o644, mtime: 1578736800})
+		long.WriteString("tail/" + name + "\n")
+	}
+	build(t, h.root, manyTree)
+	lists := map[string]string{
+		"long":     long.String(),
+		"plain":    "a/b/c/f1.txt\na/y.txt\n\na/b\n",
+		"slash":    "a/b/\na/y.txt\n",
+		"link":     "a/dlink\n",
+		"link-dir": "a/dlink/\n",
+		"crlf":     "a/b/c/sub/f2.txt\r\n/a/b/x.txt\r\n",
+		"dot-dir":  "a/b/./c/sub/f2.txt\na/./y.txt\n",
+		"dirs":     "a/b/c\na/y.txt\na/y-link\n",
+		"comments": "# backup list\na/b/c/f1.txt\n; old entry\n\na/y.txt\n",
+		"dot-dot":  "../root.txt\na/b/../y.txt\na/./../root.txt\n",
+		"nul":      "#keep\x00a/b/c/f1.txt\x00;semi\x00a/y.txt\x00",
+	}
+	for name, list := range lists {
+		if err := os.MkdirAll(h.abs("lists"), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(h.abs("lists/"+name), []byte(list), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	// rsync's daemon in the image (Debian, with the 2025 security fixes) follows a
+	// symlink below its module only where the kernel has openat2, so pulling a
+	// symlinked directory from it is left out.
+	notFromDaemon := []string{"gokr-local", "gokr-client-push-shell", "gokr-client-pull-shell", "gokr-client-push-daemon", "gokr-server-receive-shell", "gokr-server-send-shell", "gokr-daemon-receive", "gokr-daemon-send"}
+	h.runAll(t, []scenario{
+		{name: "plain", opts: []string{"--files-from=ROOT/lists/plain"}, args: []string{"src/"}, srcModule: true},
+		{name: "no-relative", opts: []string{"--files-from=ROOT/lists/plain", "--no-R"}, args: []string{"src/"}, srcModule: true},
+		{name: "trailing-slash", opts: []string{"--files-from=ROOT/lists/slash"}, args: []string{"src/"}, srcModule: true},
+		{name: "trailing-slash-no-relative", opts: []string{"--files-from=ROOT/lists/slash", "--no-R"}, args: []string{"src/"}, srcModule: true},
+		{name: "symlink", opts: []string{"--files-from=ROOT/lists/link"}, args: []string{"src/"}, srcModule: true},
+		{name: "symlink-no-relative", opts: []string{"--files-from=ROOT/lists/link", "--no-R"}, args: []string{"src/"}, srcModule: true},
+		{name: "symlink-slash", opts: []string{"--files-from=ROOT/lists/link-dir"}, args: []string{"src/"}, srcModule: true, onlyRoles: notFromDaemon},
+		{name: "symlink-slash-no-relative", opts: []string{"--files-from=ROOT/lists/link-dir", "--no-R"}, args: []string{"src/"}, srcModule: true, onlyRoles: notFromDaemon},
+		{name: "crlf", opts: []string{"--files-from=ROOT/lists/crlf"}, args: []string{"src/"}, srcModule: true},
+		{name: "dot-dir", opts: []string{"--files-from=ROOT/lists/dot-dir"}, args: []string{"src/"}, srcModule: true},
+		{name: "recursive", opts: []string{"--files-from=ROOT/lists/dirs", "-r"}, args: []string{"src/"}, srcModule: true},
+		{name: "hard-links", opts: []string{"--files-from=ROOT/lists/dirs", "-r", "-H"}, args: []string{"src/"}, srcModule: true},
+		{name: "long-list", opts: []string{"--files-from=ROOT/lists/long", "-r"}, args: []string{"src/"}, srcModule: true, onlyRoles: []string{"gokr-client-pull-shell", "gokr-client-pull-daemon"}},
+		{name: "comments", opts: []string{"--files-from=ROOT/lists/comments"}, args: []string{"src/"}, srcModule: true, noListForwarding: true},
+		{name: "dot-dot", opts: []string{"--files-from=ROOT/lists/dot-dot"}, args: []string{"src/"}, srcModule: true, noListForwarding: true},
+		{name: "from0", opts: []string{"-0", "--files-from=ROOT/lists/nul"}, args: []string{"src/"}, srcModule: true, noListForwarding: true},
+	}, roles)
+}
