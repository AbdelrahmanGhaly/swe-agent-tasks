+// TestExcludedImpliedDir pulls from gokr-rsync with a rule that excludes a
+// directory that -R or --files-from implies. rsync's sender does not filter
+// the directories it implies, and the receiving client refuses a file list
+// with a name its rules exclude, so rsync talking to itself leaves the
+// destination as it was. With gokr-rsync as the sender, the destination must
+// come out the same, as it must for the same pull without the rule.
+func TestExcludedImpliedDir(t *testing.T) {
+	t.Parallel()
+	h := newHarness(t, "127.0.0.49")
+	build(t, h.root, []node{
+		{path: "src/a/b/f.txt", kind: 'f', perm: 0o644, mtime: 1577872800, data: "f, below the excluded a"},
+		{path: "src/c/g.txt", kind: 'f', perm: 0o644, mtime: 1577872800, data: "g, not excluded"},
+		{path: "src/a/b", kind: 'd', perm: 0o755, mtime: 1546300800},
+		{path: "src/a", kind: 'd', perm: 0o755, mtime: 1546387200},
+		{path: "src/c", kind: 'd', perm: 0o755, mtime: 1546473600},
+		{path: "src", kind: 'd', perm: 0o755, mtime: 1546560000},
+	})
+	build(t, h.abs("pre/stale"), []node{
+		{path: "a/b/f.txt", kind: 'f', perm: 0o644, mtime: 1500000000, data: "stale f"},
+	})
+	if err := os.MkdirAll(h.abs("lists"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(h.abs("lists/excluded"), []byte("a/b/f.txt\nc/g.txt\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	cases := []struct {
+		name string
+		opts []string
+		args []string
+	}{
+		{"relative", []string{"-aR"}, []string{"src/./a/b/f.txt", "src/./c/g.txt"}},
+		{"files-from", []string{"-a", "--files-from=" + h.abs("lists/excluded")}, []string{"src/"}},
+	}
+	for _, c := range cases {
+		for _, transport := range []string{"shell", "daemon"} {
+			t.Run(c.name+"/"+transport, func(t *testing.T) {
+				t.Parallel()
+				pull := func(gokr bool, opts []string, dst string) {
+					args := append([]string{"--protocol=27"}, opts...)
+					src := prefixed("localhost:", c.args)
+					switch {
+					case transport == "shell":
+						args = append(args, "-e", h.shell(t, transfer{}))
+						if gokr {
+							args = append(args, "--rsync-path="+h.gokrRemote())
+						}
+					case gokr:
+						src = prefixed("rsync://"+h.gokrAddr+"/t/", c.args)
+					case c.name == "files-from":
+						// See srcModule.
+						src = []string{"rsync://" + h.stockAddr + "/src/"}
+					default:
+						src = prefixed("rsync://"+h.stockAddr+"/t/", c.args)
+					}
+					h.runRsyncMayFail(t, append(append(args, src...), h.abs(dst)+"/")...)
+				}
+				for _, rule := range []struct {
+					name string
+					opts []string
+				}{
+					{"without-rule", nil},
+					{"with-rule", []string{"--exclude=a"}},
+				} {
+					base := filepath.Join("out", t.Name(), rule.name)
+					want := filepath.Join(base, "want", "dst")
+					got := filepath.Join(base, "got", "dst")
+					copyTree(t, h.abs("pre/stale"), h.abs(want))
+					copyTree(t, h.abs("pre/stale"), h.abs(got))
+					opts := append(append([]string{}, c.opts...), rule.opts...)
+					pull(false, opts, want)
+					pull(true, opts, got)
+					if diff := cmp.Diff(snapshot(t, h.abs(want), false), snapshot(t, h.abs(got), false)); diff != "" {
+						t.Errorf("%s: destination differs from rsync 3.2.7 talking to itself: diff (-want +got):\n%s", rule.name, diff)
+					}
+				}
+			})
+		}
+	}
+}
+
+// TestRestricted runs gokr-rsync as a command of its own, whose file system
+// access is restricted as in a normal invocation, with a --link-dest directory
+// outside the destination and a --files-from list.
+func TestRestricted(t *testing.T) {
+	t.Parallel()
+	h := newHarness(t, "127.0.0.48")
+	build(t, h.root, append(noBasisTree(), relativeTree()...))
+	build(t, h.abs("prev"), prevTree())
+	if err := os.MkdirAll(h.abs("lists"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(h.abs("lists/plain"), []byte("a/b/c/f1.txt\na/y.txt\n\na/b\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	commands := []string{"gokr-local", "gokr-client-push-shell", "gokr-client-pull-shell", "gokr-client-push-daemon", "gokr-client-pull-daemon", "gokr-server-receive-shell", "gokr-server-send-shell"}
+	// A sending server never sees --link-dest: rsync's client applies it.
+	linkDest := commands[:len(commands)-1]
+	h.runAll(t, []scenario{
+		{name: "link-dest-relative", opts: []string{"--link-dest=../prev"}, args: []string{"rel/"}, prev: "prev", root: true, noDaemonDest: true, onlyRoles: linkDest, restricted: true},
+		{name: "link-dest-absolute", opts: []string{"--link-dest=PREV"}, args: []string{"rel/"}, prev: "prev", root: true, noDaemonDest: true, onlyRoles: linkDest, restricted: true},
+		{name: "files-from", opts: []string{"--files-from=ROOT/lists/plain"}, args: []string{"src/"}, srcModule: true, onlyRoles: commands, restricted: true},
+	}, roles)
+}
