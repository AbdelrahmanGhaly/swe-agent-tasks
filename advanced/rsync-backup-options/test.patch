+type harness struct {
+	root      string
+	rsync     string
+	exe       string
+	stockAddr string
+	gokrAddr  string
+}
+
+// startDaemon serves rsync's daemon on ip until the test ends. Every
+// connection gets its own rsync, started the way inetd starts it, with the
+// connection as standard input.
+func startDaemon(t *testing.T, rsync, conf, ip string) string {
+	t.Helper()
+	ln, err := net.Listen("tcp", ip+":0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var (
+		mu      sync.Mutex
+		running = make(map[*exec.Cmd]bool)
+		wg      sync.WaitGroup
+	)
+	t.Cleanup(func() {
+		ln.Close()
+		mu.Lock()
+		for cmd := range running {
+			cmd.Process.Kill()
+		}
+		mu.Unlock()
+		wg.Wait()
+	})
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			f, err := conn.(*net.TCPConn).File()
+			conn.Close()
+			if err != nil {
+				continue
+			}
+			cmd := exec.Command(rsync, "--daemon", "--config="+conf)
+			cmd.Stdin = f
+			err = cmd.Start()
+			f.Close()
+			if err != nil {
+				continue
+			}
+			mu.Lock()
+			running[cmd] = true
+			mu.Unlock()
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				cmd.Wait()
+				mu.Lock()
+				delete(running, cmd)
+				mu.Unlock()
+			}()
+		}
+	}()
+	return ln.Addr().String()
+}
+
+// newHarness starts an rsync daemon on ip (each test uses its own loopback
+// address) and a gokr-rsync daemon, both serving the module "t" from a new
+// temporary directory. rsync's daemon also serves its src directory as the
+// module "src".
+func newHarness(t *testing.T, ip string) *harness {
+	t.Helper()
+	h := &harness{
+		root:  t.TempDir(),
+		rsync: rsynctest.TridgeOrGTFO(t, "rsync 3.2.7 is the reference implementation"),
+	}
+	if out, err := exec.Command(h.rsync, "--version").Output(); err != nil || !strings.Contains(string(out), " version 3.2.7 ") {
+		t.Fatalf("%s is not rsync 3.2.7, the reference implementation: %v\n%s", h.rsync, err, out)
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.exe = exe
+
+	conf := filepath.Join(t.TempDir(), "rsyncd.conf")
+	stockConfig := "use chroot = false\nmunge symlinks = false\nlog file = " + filepath.Join(filepath.Dir(conf), "rsyncd.log") + "\n" +
+		"[t]\npath = " + h.root + "\nread only = false\n"
+	if os.Getuid() == 0 {
+		stockConfig += "uid = 0\ngid = 0\n"
+	}
+	stockConfig += "[src]\npath = " + h.abs("src") + "\n"
+	if os.Getuid() == 0 {
+		stockConfig += "uid = 0\ngid = 0\n"
+	}
+	if err := os.WriteFile(conf, []byte(stockConfig), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	h.stockAddr = startDaemon(t, h.rsync, conf, ip)
+	h.gokrAddr = "127.0.0.1:" + rsynctest.New(t, []rsyncd.Module{{Name: "t", Path: h.root, Writable: true}}).Port
+	return h
+}
+
+// abs returns rel relative to the harness root, or rel itself if it is
+// absolute.
+func (h *harness) abs(rel string) string {
+	if filepath.IsAbs(rel) {
+		return rel
+	}
+	return filepath.Join(h.root, rel)
+}
+
+// otherFS returns a new directory on another file system than dir if /dev/shm
+// is one, and a new temporary directory otherwise.
+func otherFS(t *testing.T, dir string) string {
+	t.Helper()
+	if other, err := os.MkdirTemp("/dev/shm", "backup"); err == nil {
+		t.Cleanup(func() { os.RemoveAll(other) })
+		var a, b unix.Stat_t
+		if unix.Stat(other, &a) == nil && unix.Stat(dir, &b) == nil && a.Dev != b.Dev {
+			return other
+		}
+	}
+	return t.TempDir()
+}
+
+// local turns a source argument (relative to the harness root) into an
+// absolute path that names the same files, for a sender that does not run in
+// the harness root. With -R, the /./ keeps the names the relative argument has.
+func (h *harness) local(arg string) string {
+	if strings.Contains(arg, "/./") {
+		return h.root + "/" + arg
+	}
+	return h.root + "/./" + arg
+}
+
+// sources returns the source arguments for a gokr-rsync client: as given (a
+// relative one names files below the harness root, the client's working
+// directory) for a transfer with asGiven, and as absolute paths otherwise.
+func (h *harness) sources(x transfer) []string {
+	if x.asGiven {
+		return x.args
+	}
+	var src []string
+	for _, arg := range x.args {
+		src = append(src, h.local(arg))
+	}
+	return src
+}
+
+// shell writes a remote shell that runs the command in the harness root, like
+// ssh would run it in the home directory, and returns the command that starts
+// it. The script is run by sh rather than executed directly: executing a file
+// that was just written fails with ETXTBSY if another test forks at the same
+// time. For a restricted transfer, the command gets a TMPDIR of its own (see
+// runRestricted).
+func (h *harness) shell(t *testing.T, x transfer) string {
+	t.Helper()
+	run := "exec sh -c \"$*\"\n"
+	if x.restricted {
+		run = "TMPDIR='" + t.TempDir() + "'\nexport TMPDIR\n" + run
+	}
+	return h.writeShell(t, run)
+}
+
+// clientShell is like shell, for gokr-rsync clients: it keeps running until
+// the client closes its end, so that the client reads everything the command
+// wrote before the remote shell exits. rsync leaves the connection in
+// non-blocking mode, so cat is retried until it reaches the end.
+func (h *harness) clientShell(t *testing.T) string {
+	t.Helper()
+	return h.writeShell(t, "sh -c \"$*\"\nstatus=$?\nuntil cat >/dev/null 2>&1; do sleep 0.01; done\nexit $status\n")
+}
+
+func (h *harness) writeShell(t *testing.T, run string) string {
+	t.Helper()
+	f, err := os.CreateTemp(t.TempDir(), "shell")
+	if err != nil {
+		t.Fatal(err)
+	}
+	script := "#!/bin/sh\nshift\ncd '" + h.root + "' || exit 1\n" + run
+	if _, err := f.WriteString(script); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return "sh " + f.Name()
+}
+
+// gokrRemote is the rsync-path that starts gokr-rsync on the other end of the
+// remote shell.
+func (h *harness) gokrRemote() string {
+	return h.exe + " localhost gokr-rsync"
+}
+
+// transferTimeout bounds each transfer (they take well under a second), so
+// that a hanging transfer fails its own test instead of the whole test binary.
+const transferTimeout = time.Minute
+
+type nopCloser struct{ io.Writer }
+
+func (nopCloser) Close() error { return nil }
+
+// syncBuffer is a bytes.Buffer that can be written to while another
+// goroutine reads it after a timeout.
+type syncBuffer struct {
+	mu  sync.Mutex
+	buf bytes.Buffer
+}
+
+func (b *syncBuffer) Write(p []byte) (int, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.Write(p)
+}
+
+func (b *syncBuffer) String() string {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.buf.String()
+}
+
+// runGokr runs gokr-rsync in the test process without restricting its file
+// system access, or as a command of its own in the harness root: a restricted
+// transfer, and a relative one, whose source arguments are relative to the
+// working directory.
+func (h *harness) runGokr(t *testing.T, x transfer, args ...string) {
+	t.Helper()
+	if x.restricted {
+		h.runRestricted(t, args...)
+		return
+	}
+	if x.asGiven {
+		// The rule the test hook adds for the temporary directory covers
+		// the harness root, so the command is not restricted in effect.
+		h.runCommand(t, os.Environ(), args...)
+		return
+	}
+	var out syncBuffer
+	cmd := rsynccmd.Command("gokr-rsync", args...)
+	cmd.Stdout = nopCloser{&out}
+	cmd.Stderr = nopCloser{&out}
+	cmd.DontRestrict = true
+	done := make(chan error, 1)
+	go func() {
+		_, err := cmd.Run(context.Background())
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatalf("gokr-rsync %q: %v\n%s", args, err, out.String())
+		}
+	case <-time.After(transferTimeout):
+		t.Fatalf("gokr-rsync %q did not finish within %v\n%s", args, transferTimeout, out.String())
+	}
+}
+
+// runRestricted runs gokr-rsync as a command of its own, which restricts its
+// file system access like a normal invocation does (Landlock on Linux). Its
+// TMPDIR is a new directory, so that the rule the test hook adds for the
+// temporary directory does not cover the transfer.
+func (h *harness) runRestricted(t *testing.T, args ...string) {
+	t.Helper()
+	h.runCommand(t, append(os.Environ(), "TMPDIR="+t.TempDir()), args...)
+}
+
+// runCommand runs gokr-rsync as a command of its own in the harness root, with
+// the environment env.
+func (h *harness) runCommand(t *testing.T, env []string, args ...string) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), transferTimeout)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, h.exe, append([]string{"localhost", "gokr-rsync"}, args...)...)
+	cmd.Dir = h.root
+	cmd.Env = env
+	cmd.WaitDelay = 5 * time.Second
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("gokr-rsync %q: %v\n%s", args, err, out)
+	}
+}
+
+// runRsync runs rsync in the harness root.
+func (h *harness) runRsync(t *testing.T, args ...string) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), transferTimeout)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, h.rsync, args...)
+	cmd.Dir = h.root
+	cmd.WaitDelay = 5 * time.Second
+	out, err := cmd.CombinedOutput()
+	if err != nil {
+		t.Fatalf("rsync %q: %v\n%s", args, err, out)
+	}
+}
+
+// runRsyncMayFail is runRsync for a transfer that may end with an error: only
+// the destination it leaves behind is compared.
+func (h *harness) runRsyncMayFail(t *testing.T, args ...string) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), transferTimeout)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, h.rsync, args...)
+	cmd.Dir = h.root
+	cmd.WaitDelay = 5 * time.Second
+	out, err := cmd.CombinedOutput()
+	var exit *exec.ExitError
+	if err != nil && (!errors.As(err, &exit) || ctx.Err() != nil) {
+		t.Fatalf("rsync %q: %v\n%s", args, err, out)
+	}
+}
+
+// transfer describes one run: source arguments as a local rsync started in the
+// harness root gets them, and the destination, relative to the harness root.
+// With srcModule, rsync's daemon sends the source from its module "src"; with
+// restricted, gokr-rsync restricts its file system access; with asGiven, the
+// gokr-rsync clients get the source arguments as given.
+type transfer struct {
+	opts       []string
+	args       []string
+	dst        string
+	srcModule  bool
+	restricted bool
+	asGiven    bool
+}
+
+type role struct {
+	name string
+	// pullsOneSource is set for roles in which gokr-rsync is the client of a
+	// remote sender, which gokr-rsync only asks for its first source.
+	pullsOneSource bool
+	run            func(t *testing.T, h *harness, x transfer)
+}
+
+func prefixed(prefix string, args []string) []string {
+	var out []string
+	for _, arg := range args {
+		out = append(out, prefix+arg)
+	}
+	return out
+}
+
+var roles = []role{
+	{
+		name: "gokr-client-push-shell",
+		run: func(t *testing.T, h *harness, x transfer) {
+			src := h.sources(x)
+			args := append(append(append([]string{}, x.opts...), "-e", h.clientShell(t)), src...)
+			h.runGokr(t, x, append(args, "localhost:"+h.abs(x.dst)+"/")...)
+		},
+	},
+	{
+		name:           "gokr-client-pull-shell",
+		pullsOneSource: true,
+		run: func(t *testing.T, h *harness, x transfer) {
+			args := append(append([]string{}, x.opts...), "-e", h.clientShell(t), "localhost:"+x.args[0], h.abs(x.dst)+"/")
+			h.runGokr(t, x, args...)
+		},
+	},
+	{
+		name: "gokr-server-receive-shell",
