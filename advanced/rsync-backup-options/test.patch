+func rolesNamed(names ...string) []role {
+	var out []role
+	for _, name := range names {
+		for _, r := range roles {
+			if r.name == name {
+				out = append(out, r)
+			}
+		}
+	}
+	return out
+}
+
+// receivingRoles are the roles in which gokr-rsync builds the destination.
+func receivingRoles() []role {
+	return rolesNamed("gokr-client-pull-shell", "gokr-server-receive-shell", "gokr-client-pull-daemon", "gokr-daemon-receive", "gokr-local")
+}
+
+var optSets = [][]string{{"-a"}, {"-a", "-c"}}
+
+func optsName(opts []string) string {
+	return strings.ReplaceAll(strings.Join(opts, ""), "-", "")
+}
+
+// scenario is one transfer, run once by rsync talking to itself and once in
+// each role, starting from the same destination (and --link-dest directory).
+type scenario struct {
+	name string
+	opts []string // options besides the option set
+	args []string // source arguments (ROOT stands for the harness root)
+	pre  string   // directory holding the initial destination, if any
+	prev string   // directory holding the --link-dest directory, if any
+	root bool     // the destination root is part of the transfer
+	// noDaemonDest skips the roles in which a daemon receives: a daemon
+	// resolves --link-dest inside its module (an absolute path from the
+	// module root), so a path on the host, or one leading out of the
+	// destination, means something else there. TestLinkDestForwarded
+	// compares those roles with rsync's daemon.
+	noDaemonDest bool
+	// srcModule makes rsync's daemon send src/ from its module "src": without
+	// chroot, rsync 3.2.7's daemon does not find --files-from names in a
+	// directory below the module ("file has vanished").
+	srcModule bool
+	// noListForwarding skips the roles in which the client passes the
+	// --files-from list to a remote sender. There rsync passes comment lines
+	// on as names, unlike in a list it reads itself, and rejects the cleaned-up
+	// names a sender returns for .. entries.
+	noListForwarding bool
+	// onlyRoles limits the scenario to the named roles.
+	onlyRoles []string
+	// daemonReference makes the reference rsync talking to rsync's daemon,
+	// for options a daemon interprets in its module (MODPREV is the
+	// --link-dest directory as a path in the module).
+	daemonReference bool
+	// prevOtherFS puts the --link-dest directory on another file system
+	// than the destination, if there is one.
+	prevOtherFS bool
+	// restricted runs gokr-rsync with its file system access restricted.
+	restricted bool
+	// asGiven passes the source arguments to the gokr-rsync clients as
+	// given: a relative one is relative to their working directory (the
+	// harness root).
+	asGiven bool
+	// optSets replaces the option sets (-a and -a -c).
+	optSets [][]string
+}
+
+type side struct {
+	dst, prev string
+	before    map[string]fileID
+}
+
+func (h *harness) prepare(t *testing.T, sc scenario, dir string) side {
+	t.Helper()
+	s := side{dst: filepath.Join(dir, "dst")}
+	if sc.pre != "" {
+		copyTree(t, h.abs(sc.pre), h.abs(s.dst))
+	} else if err := os.MkdirAll(h.abs(s.dst), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if sc.prev != "" {
+		s.prev = filepath.Join(dir, "prev")
+		if sc.prevOtherFS {
+			s.prev = filepath.Join(otherFS(t, h.root), "prev")
+		}
+		copyTree(t, h.abs(sc.prev), h.abs(s.prev))
+	}
+	s.before = inodes(t, h.abs(s.dst))
+	return s
+}
+
+// options returns the options for one side, with PREV standing for the
+// absolute path of its --link-dest directory, MODPREV for that directory as a
+// path in the module, and MODUPPREV for the same with .. elements that would
+// climb above the module root.
+func (h *harness) options(opts []string, sc scenario, s side) []string {
+	out := append(append([]string{}, opts...), sc.opts...)
+	for i, o := range out {
+		o = strings.ReplaceAll(o, "MODUPPREV", "/../../../"+s.prev)
+		o = strings.ReplaceAll(o, "MODPREV", "/"+s.prev)
+		o = strings.ReplaceAll(o, "PREV", h.abs(s.prev))
+		out[i] = strings.ReplaceAll(o, "ROOT", h.root)
+	}
+	return out
+}
+
+// sourceArgs returns the source arguments of a scenario, with ROOT standing
+// for the harness root.
+func (h *harness) sourceArgs(sc scenario) []string {
+	var args []string
+	for _, arg := range sc.args {
+		args = append(args, strings.ReplaceAll(arg, "ROOT", h.root))
+	}
+	return args
+}
+
+// systemTimes leaves out the modification times of the system's temporary
+// directory and the directories leading to it, which -R recreates for an
+// absolute source below it: tests in other processes change them all the time.
+// The directories of the test below it keep their times.
+func systemTimes(m map[string]entry) map[string]entry {
+	tmp := strings.TrimPrefix(filepath.Clean(os.TempDir()), "/") + "/"
+	for name, e := range m {
+		if strings.HasPrefix(tmp, name+"/") {
+			e.MTime = 0
+			m[name] = e
+		}
+	}
+	return m
+}
+
+func (h *harness) check(t *testing.T, sc scenario, r role, opts []string) {
+	t.Helper()
+	base := filepath.Join("out", t.Name())
+
+	want := h.prepare(t, sc, filepath.Join(base, "want"))
+	wantDst := want.dst + "/"
+	if sc.daemonReference {
+		wantDst = "rsync://" + h.stockAddr + "/t/" + wantDst
+	}
+	args := h.sourceArgs(sc)
+	h.runRsync(t, append(append(append([]string{"--protocol=27"}, h.options(opts, sc, want)...), args...), wantDst)...)
+
+	got := h.prepare(t, sc, filepath.Join(base, "got"))
+	r.run(t, h, transfer{opts: h.options(opts, sc, got), args: args, dst: got.dst, srcModule: sc.srcModule, restricted: sc.restricted, asGiven: sc.asGiven})
+
+	if diff := cmp.Diff(systemTimes(snapshot(t, h.abs(want.dst), sc.root)), systemTimes(snapshot(t, h.abs(got.dst), sc.root))); diff != "" {
+		t.Errorf("destination differs from rsync 3.2.7 talking to itself: diff (-want +got):\n%s", diff)
+	}
+	wantPrev, gotPrev := "", ""
+	if sc.prev != "" {
+		wantPrev, gotPrev = h.abs(want.prev), h.abs(got.prev)
+	}
+	if diff := cmp.Diff(linkGroups(t, h.abs(want.dst), wantPrev), linkGroups(t, h.abs(got.dst), gotPrev)); diff != "" {
+		t.Errorf("hard links differ from rsync 3.2.7 talking to itself: diff (-want +got):\n%s", diff)
+	}
+	kept := untouched(t, h.abs(got.dst), got.before)
+	var replaced []string
+	for _, name := range untouched(t, h.abs(want.dst), want.before) {
+		if !slices.Contains(kept, name) {
+			replaced = append(replaced, name)
+		}
+	}
+	if len(replaced) > 0 {
+		t.Errorf("entries that rsync 3.2.7 talking to itself leaves untouched were replaced: %q", replaced)
+	}
+}
+
+func (h *harness) runAll(t *testing.T, scenarios []scenario, rs []role) {
+	for _, sc := range scenarios {
+		t.Run(sc.name, func(t *testing.T) {
+			t.Parallel()
+			for _, r := range rs {
+				if r.pullsOneSource && len(sc.args) > 1 {
+					continue
+				}
+				if sc.noDaemonDest && (r.name == "gokr-client-push-daemon" || r.name == "gokr-daemon-receive") {
+					continue
+				}
+				if sc.noListForwarding && slices.Contains([]string{"gokr-server-send-shell", "gokr-daemon-send", "gokr-client-pull-shell", "gokr-client-pull-daemon"}, r.name) {
+					continue
+				}
+				if sc.onlyRoles != nil && !slices.Contains(sc.onlyRoles, r.name) {
+					continue
+				}
+				sets := optSets
+				if sc.optSets != nil {
+					sets = sc.optSets
+				}
+				t.Run(r.name, func(t *testing.T) {
+					t.Parallel()
+					for _, opts := range sets {
+						t.Run(optsName(opts), func(t *testing.T) {
+							h.check(t, sc, r, opts)
+						})
+					}
+				})
+			}
+		})
+	}
+}
+
