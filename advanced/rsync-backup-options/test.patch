+// TestLinkDestForwarded covers a gokr-rsync client that sends to rsync. Its
+// trees leave out the files rsync would transfer against a basis file in the
+// --link-dest directory: rsync 3.2.7 talking to itself at protocol 27 over a
+// remote shell or socket discards those ("failed verification").
+func TestLinkDestForwarded(t *testing.T) {
+	t.Parallel()
+	h := newHarness(t, "127.0.0.44")
+	build(t, h.root, forwardedTree())
+	build(t, h.abs("prev"), forwardedPrev())
+	existing := []node{
+		{path: "same.txt", kind: 'f', perm: 0o644, mtime: 1577872800, data: "same in both"},
+		{path: "new.txt", kind: 'f', perm: 0o644, mtime: 1577872800, data: "only in src"},
+	}
+	build(t, h.abs("pre/existing"), existing)
+	build(t, h.abs("pre/inside/prev"), forwardedPrev())
+	forwarding := []string{"gokr-client-push-shell", "gokr-client-push-daemon"}
+	daemons := []string{"gokr-client-push-daemon", "gokr-daemon-receive"}
+	h.runAll(t, []scenario{
+		{name: "relative", opts: []string{"--link-dest=../prev"}, args: []string{"src/"}, prev: "prev", root: true, noDaemonDest: true, onlyRoles: forwarding},
+		{name: "existing", opts: []string{"--link-dest=../prev"}, args: []string{"src/"}, prev: "prev", pre: "pre/existing", root: true, noDaemonDest: true, onlyRoles: forwarding},
+		{name: "inside", opts: []string{"--link-dest=prev"}, args: []string{"src/"}, pre: "pre/inside", root: true, onlyRoles: forwarding},
+		{name: "absolute-in-module", opts: []string{"--link-dest=MODPREV"}, args: []string{"src/"}, prev: "prev", root: true, onlyRoles: daemons, daemonReference: true},
+		{name: "absolute-outside-module", opts: []string{"--link-dest=PREV"}, args: []string{"src/"}, prev: "prev", root: true, onlyRoles: daemons, daemonReference: true},
+		{name: "absolute-dotdot-in-module", opts: []string{"--link-dest=MODUPPREV"}, args: []string{"src/"}, prev: "prev", root: true, onlyRoles: daemons, daemonReference: true},
+	}, rolesNamed("gokr-client-push-shell", "gokr-client-push-daemon", "gokr-daemon-receive"))
+}
