+)
+
+// openLinkDest opens the --link-dest directory, unless the caller already
+// did. Like rsync, which changes into the destination before using it, a
+// relative directory is relative to the destination.
+func (rt *Transfer) openLinkDest() {
+	if rt.LinkDestRoot != nil || rt.Opts.LinkDest == "" {
+		return
+	}
+	dir := rt.Opts.LinkDest
+	if !filepath.IsAbs(dir) {
+		dir = filepath.Join(rt.Dest, dir)
+	}
+	root, err := os.OpenRoot(dir)
+	if err != nil {
+		rt.Logger.Printf("--link-dest arg does not exist: %s", rt.Opts.LinkDest)
+		return
+	}
+	rt.LinkDestRoot = root
+}
+
+// replaceWithLink makes name in root a hard link of oldname in oldRoot. Like
+// rsync/generator.c:atomic_create, an existing name is replaced by renaming
+// the new link over it, and a directory in the way is removed first.
+func replaceWithLink(oldRoot *os.Root, oldname string, root *os.Root, name string) error {
+	st, err := root.Lstat(name)
+	if os.IsNotExist(err) {
+		return linkAt(oldRoot, oldname, root, name)
+	}
+	if err == nil && st.IsDir() {
+		if err := root.Remove(name); err != nil {
+			return err
+		}
+		return linkAt(oldRoot, oldname, root, name)
+	}
+	tmp := filepath.Join(filepath.Dir(name), fmt.Sprintf(".%s.%d", filepath.Base(name), rand.Int64()))
+	if err := linkAt(oldRoot, oldname, root, tmp); err != nil {
+		return err
+	}
+	if err := root.Rename(tmp, name); err != nil {
+		root.Remove(tmp)
+		return err
+	}
+	return nil
+}
+
+// quickCheck reports whether the file st in root has the size and the
+// modification time (or with -c, the checksum) that f has, see
+// rsync/generator.c:quick_check_ok.
+func (rt *Transfer) quickCheck(f *File, root *os.Root, st os.FileInfo) (bool, error) {
+	switch {
+	case st.Mode().IsRegular():
+		if st.Size() != f.Length {
+			return false, nil
+		}
+		if rt.Opts.AlwaysChecksum {
+			sum, err := rsyncchecksum.RootChecksum(root, f.Name)
+			if err != nil {
+				return false, err
+			}
+			return bytes.Equal(sum, f.Checksum[:]), nil
+		}
+		if rt.Opts.IgnoreTimes {
+			return false, nil
+		}
+		return modTimeEqual(st.ModTime(), f.ModTime), nil
+	case st.Mode()&fs.ModeSymlink != 0:
+		target, err := root.Readlink(f.Name)
+		if err != nil {
+			return false, nil
+		}
+		return target == f.LinkTarget, nil
+	case st.Mode()&(fs.ModeDevice|fs.ModeCharDevice) != 0:
+		// Only the device number counts, as in rsync: get_file_type makes
+		// character and block devices one type, so a node of the other
+		// kind with the same number matches and is kept.
+		return sameDevice(f, st), nil
+	case st.Mode()&(fs.ModeNamedPipe|fs.ModeSocket) != 0:
+		return st.Mode().Type() == f.FileMode().Type(), nil
+	}
+	return true, nil
+}
+
+// unchangedAttrs reports whether st already has the attributes that f would
+// get, see rsync/generator.c:unchanged_attrs.
+func (rt *Transfer) unchangedAttrs(f *File, st os.FileInfo) bool {
+	if rt.Opts.PreserveTimes && !modTimeEqual(st.ModTime(), f.ModTime) {
+		return false
+	}
+	isLink := f.Mode&rsync.S_IFMT == rsync.S_IFLNK
+	if !isLink && rt.Opts.PreservePerms && st.Mode()&modePermBits != senderPerm(f.Mode) {
+		return false
+	}
+	return !rt.ownershipDiffers(f, st)
+}
+
+// fileType classifies m like rsync/generator.c:get_file_type: character and
+// block devices are one type, and so are FIFOs and sockets.
+func fileType(m fs.FileMode) fs.FileMode {
+	switch {
+	case m&(fs.ModeDevice|fs.ModeCharDevice) != 0:
+		return fs.ModeDevice
+	case m&(fs.ModeNamedPipe|fs.ModeSocket) != 0:
+		return fs.ModeNamedPipe
+	}
+	return m.Type()
+}
+
+// linkDestMatch compares f with the file of the same name in the --link-dest
+// directory: 0 means there is none (of the same type), 1 that it exists, 2 that
+// it passes the quick check, and 3 that its attributes are unchanged, too.
+func (rt *Transfer) linkDestMatch(f *File) (int, os.FileInfo, error) {
+	st, err := rt.LinkDestRoot.Lstat(f.Name)
+	if err != nil || fileType(st.Mode()) != fileType(f.FileMode()) {
+		return 0, nil, nil
+	}
+	ok, err := rt.quickCheck(f, rt.LinkDestRoot, st)
+	if err != nil || !ok {
+		return 1, st, err
+	}
+	if !rt.unchangedAttrs(f, st) {
+		return 2, st, nil
+	}
+	return 3, st, nil
+}
+
+// tryLinkDestReg handles a regular file with --link-dest, like
+// rsync/generator.c:try_dests_reg does with one basis directory. It returns
+// done if f needs nothing more, or basis if the file in the --link-dest
+// directory is to be the basis of the transfer. destSt is the existing
+// destination file, if any: like rsync (find_exact_for_existing), which tries
+// the --link-dest directory before its quick check, it is replaced by a link
+// to an identical file there even when it is up to date, and is otherwise
+// left to the normal checks, which update its attributes in place. If it is a
+// hard link of the file in the --link-dest directory, that file changes with
+// it, as with rsync (rsync(1): "existing files may get their attributes
+// tweaked, and that can affect alternate destination files via hard-links").
+func (rt *Transfer) tryLinkDestReg(f *File, destSt os.FileInfo) (done, basis bool, _ error) {
+	level, st, err := rt.linkDestMatch(f)
+	if err != nil || level == 0 {
+		return false, false, err
+	}
+	if level == 3 {
+		if destSt != nil && os.SameFile(destSt, st) {
+			return false, false, nil
+		}
+		if !rt.Opts.DryRun {
+			if err := replaceWithLink(rt.LinkDestRoot, f.Name, rt.DestRoot, f.Name); err != nil {
+				// Like rsync (try_a_copy), copy the file when it cannot
+				// be linked, e.g. from another file system.
+				if rt.Opts.Verbose {
+					rt.Logger.Printf("%v, copying instead", err)
+				}
+				if err := rt.copyFromLinkDest(f); err != nil {
+					return false, false, err
+				}
+			}
+		}
+		if f.hlink != nil {
+			if err := rt.finishHardLink(f); err != nil {
+				return false, false, err
+			}
+		}
+		return true, false, nil
+	}
+	if destSt != nil {
+		return false, false, nil
+	}
+	if level == 2 {
+		if !rt.Opts.DryRun {
+			if err := rt.copyFromLinkDest(f); err != nil {
+				return false, false, err
+			}
+		}
+		if f.hlink != nil {
+			if err := rt.finishHardLink(f); err != nil {
+				return false, false, err
+			}
+		}
+		return true, false, nil
+	}
+	return false, true, nil
+}
+
+// tryLinkDestNonReg hard-links a symlink, device or special file from the
+// --link-dest directory if it is identical, like rsync/generator.c:try_dests_non.
+func (rt *Transfer) tryLinkDestNonReg(f *File) (bool, error) {
+	if f.FileMode().IsDir() {
+		return false, nil
+	}
+	level, _, err := rt.linkDestMatch(f)
+	if err != nil || level < 3 {
+		return false, err
+	}
+	if !rt.Opts.DryRun {
+		if err := replaceWithLink(rt.LinkDestRoot, f.Name, rt.DestRoot, f.Name); err != nil {
+			// Like rsync (try_dests_non), create the entry instead.
+			if rt.Opts.Verbose {
+				rt.Logger.Printf("%v, creating it instead", err)
+			}
+			return false, nil
+		}
+	}
+	return true, nil
+}
+
+// openLinkDestBasis opens the file name in the --link-dest directory as the
+// basis of a transfer. Only a regular file can be one (the generator requests
+// the whole file otherwise), and opening anything else, such as a FIFO, could
+// block, so anything else counts as missing.
+func (rt *Transfer) openLinkDestBasis(name string) (*os.File, error) {
+	st, err := rt.LinkDestRoot.Lstat(name)
+	if err != nil {
+		return nil, err
+	}
+	if !st.Mode().IsRegular() {
+		return nil, os.ErrNotExist
+	}
+	return rt.LinkDestRoot.Open(name)
+}
+
+// copyFromLinkDest copies the file of the same name from the --link-dest
+// directory instead of transferring it, see
+// rsync/generator.c:copy_altdest_file.
+func (rt *Transfer) copyFromLinkDest(f *File) error {
+	in, err := rt.LinkDestRoot.Open(f.Name)
+	if err != nil {
+		return err
+	}
+	defer in.Close()
+	out, err := newPendingFile(rt.DestRoot, f.Name, rt.Opts.DoFsync, rt.Opts.SparseFiles)
+	if err != nil {
+		return err
+	}
+	defer out.Cleanup()
+	if _, err := io.Copy(out, in); err != nil {
+		return err
+	}
+	if err := out.CloseAtomicallyReplace(); err != nil {
+		return err
+	}
+	return rt.setPerms(f, rt.destPerm(f, nil))
+}
