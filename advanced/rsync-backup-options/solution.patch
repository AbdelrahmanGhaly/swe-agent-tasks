+
+// linkDestDirs returns the --link-dest directory (relative to the
+// destination unless it is absolute), if any.
+func linkDestDirs(dest, linkDest string) []string {
+	if linkDest == "" {
+		return nil
+	}
+	if !filepath.IsAbs(linkDest) {
+		linkDest = filepath.Join(dest, linkDest)
+	}
+	return []string{linkDest}
+}
