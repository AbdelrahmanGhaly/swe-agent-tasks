+			continue
+		}
+		if strings.Contains(name, "/./") {
+			paths = append(paths, dir+"/"+name)
+		} else {
+			paths = append(paths, dir+"/./"+name)
+		}
+	}
+	return paths
+}
+
+// ForwardFilesFrom sends the names of a --files-from list to a sender on the
+// other side of the connection, NUL-terminated and followed by an empty name,
+// like rsync/io.c:forward_filesfrom_data.
+func ForwardFilesFrom(w io.Writer, names []string) error {
+	var buf strings.Builder
+	for _, name := range names {
+		buf.WriteString(name)
+		buf.WriteByte(0)
+	}
+	buf.WriteByte(0)
+	_, err := io.WriteString(w, buf.String())
+	return err
+}
+
+// OpenFilesFrom opens the local --files-from list: stdin for -, the named
+// file otherwise.
+func OpenFilesFrom(name string, stdin io.Reader) (*bufio.Reader, func() error, error) {
+	if name == "-" {
+		return bufio.NewReader(stdin), func() error { return nil }, nil
+	}
+	f, err := os.Open(name)
+	if err != nil {
+		return nil, nil, err
+	}
+	return bufio.NewReader(f), f.Close, nil
+}
