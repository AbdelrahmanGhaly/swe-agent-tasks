@@ -0,0 +1,28 @@
+//go:build windows
+
+package sender
+
+import (
+	"io/fs"
+	"os"
+	"syscall"
+)
+
+// devIno returns the volume serial number and file index of the regular file
+// path, which identify it like a device and inode number do elsewhere.
+func devIno(source FileSource, path string, _ fs.FileInfo) (dev, ino uint64, ok bool) {
+	f, err := source.Open(path)
+	if err != nil {
+		return 0, 0, false
+	}
+	defer f.Close()
+	osf, isOS := f.(*os.File)
+	if !isOS {
+		return 0, 0, false
+	}
+	var d syscall.ByHandleFileInformation
+	if err := syscall.GetFileInformationByHandle(syscall.Handle(osf.Fd()), &d); err != nil {
+		return 0, 0, false
+	}
+	return uint64(d.VolumeSerialNumber), uint64(d.FileIndexHigh)<<32 | uint64(d.FileIndexLow), true
+}
