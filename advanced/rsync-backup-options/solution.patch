+// modePermBits are the bits of a fs.FileMode that rsync's --perms preserves
+// (rsync.h:CHMOD_BITS).
+const modePermBits = fs.ModePerm | fs.ModeSetuid | fs.ModeSetgid | fs.ModeSticky
+
+// senderPerm converts the permission bits of the sender's mode, including the
+// setuid, setgid and sticky bits, to Go's permission bits.
+func senderPerm(mode int32) fs.FileMode {
+	perm := fs.FileMode(mode).Perm()
+	if mode&0o4000 != 0 {
+		perm |= fs.ModeSetuid
+	}
+	if mode&0o2000 != 0 {
+		perm |= fs.ModeSetgid
+	}
+	if mode&0o1000 != 0 {
+		perm |= fs.ModeSticky
+	}
+	return perm
+}
