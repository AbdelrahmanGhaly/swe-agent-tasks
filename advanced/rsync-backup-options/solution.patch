+// contentsName reports whether a source name asks for the contents of a
+// directory, which are sent even without -r: it ends in a slash or is a dot
+// directory (rsync/flist.c:send_file_list, a name that is not a NORMAL_NAME).
+func contentsName(name string) bool {
+	return name == "" || name == "." || strings.HasSuffix(name, "/") || strings.HasSuffix(name, "/.")
+}
+
+// FilesFromPaths turns the names of a --files-from list into the source
+// arguments they stand for (relative paths below dir, the source directory),
+// see rsync/flist.c:send_file_list. With relative (-R), a /./ in a name marks
+// where the path that is recreated starts, so a/b/./c/f is sent as c/f;
+// without it, only the last element of a name is sent.
+func FilesFromPaths(dir string, names []string, relative bool) []string {
+	// The names start below the source directory, so a /./ in the
+	// directory itself must not mark where they start.
+	volume := filepath.VolumeName(dir)
