+// ReadFilesFrom reads the names of a --files-from list, separated by NUL
+// bytes if nulls is set and by line endings otherwise, see
+// rsync/io.c:read_line. A list read from a local file skips empty names and
+// comments (names starting with # or ;); a list read from the connection
+// ends with an empty name.
+func ReadFilesFrom(r io.ByteReader, nulls, local bool) ([]string, error) {
+	names, err := readNames(r, nulls, local)
+	if err != nil {
+		return nil, err
+	}
+	return filterNames(names, local), nil
+}
+
+// ForwardedFilesFrom reads a local --files-from list the way a client passes
+// it on to a remote sender, see rsync/io.c:forward_filesfrom_data: empty
+// names are dropped, but comment lines are kept, and the sender reads them
+// as names.
+func ForwardedFilesFrom(r io.ByteReader, nulls bool) ([]string, error) {
+	names, err := readNames(r, nulls, true)
+	if err != nil {
+		return nil, err
+	}
+	var out []string
+	for _, name := range names {
+		if name != "" {
+			out = append(out, name)
+		}
+	}
+	return out, nil
+}
+
+func readNames(r io.ByteReader, nulls, local bool) ([]string, error) {
+	var names []string
+	var name strings.Builder
+	for {
+		ch, err := r.ReadByte()
+		if err == io.EOF {
+			if name.Len() > 0 {
+				names = append(names, name.String())
+			}
+			return names, nil
+		}
+		if err != nil {
+			return nil, err
+		}
+		end := ch == 0
+		if !nulls {
+			end = ch == '\n' || ch == '\r'
+		}
+		if !end {
+			name.WriteByte(ch)
+			continue
+		}
+		if name.Len() == 0 && !local {
+			return names, nil
+		}
+		names = append(names, name.String())
+		name.Reset()
+	}
+}
+
+func filterNames(names []string, local bool) []string {
+	if !local {
+		return names
+	}
