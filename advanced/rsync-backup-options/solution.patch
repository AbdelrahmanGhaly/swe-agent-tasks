diff --git a/internal/receiver/hlink.go b/internal/receiver/hlink.go
new file mode 100644
index 0000000..1c7e6da
--- /dev/null
+++ b/internal/receiver/hlink.go
@@ -0,0 +1,103 @@
+package receiver
+
+import (
+	"os"
+)
+
+// idev is the sender's device and inode number of a regular file, which
+// protocols before 28 transmit for every regular file with -H.
+type idev struct {
+	dev, ino uint64
+}
+
+const (
+	hlinkPending = iota // no member is done or being transferred
+	hlinkSent           // the leader is being transferred
+	hlinkDone           // the leader is complete
+)
+
+// hlinkGroup tracks the files of the file list that are hard links of each
+// other on the sending side.
+type hlinkGroup struct {
+	state  int
+	leader *File
+	// waiting are members that get linked to the leader once it is
+	// complete: members missing at the destination that were seen before
+	// a leader was found, and members seen while it was transferred.
+	waiting []*File
+}
+
+// rsync/hlink.c:match_hard_links
+func (rt *Transfer) matchHardLinks(fileList []*File) {
+	members := make(map[idev][]*File)
+	var order []idev
+	for _, f := range fileList {
+		if f.duplicate || f.idev == nil {
+			continue
+		}
+		if _, ok := members[*f.idev]; !ok {
+			order = append(order, *f.idev)
+		}
+		members[*f.idev] = append(members[*f.idev], f)
+	}
+	for _, key := range order {
+		group := members[key]
+		if len(group) < 2 {
+			continue
+		}
+		g := &hlinkGroup{state: hlinkPending}
+		for _, f := range group {
+			f.hlink = g
+		}
+		group[len(group)-1].hlinkLast = true
+		rt.hlinkGroups = append(rt.hlinkGroups, g)
+	}
+}
+
+// finishHardLink makes f the leader of its group and links the waiting
+// members to it, see rsync/hlink.c:finish_hard_link.
+func (rt *Transfer) finishHardLink(f *File) error {
+	g := f.hlink
+	g.state = hlinkDone
+	g.leader = f
+	waiting := g.waiting
+	g.waiting = nil
+	for _, w := range waiting {
+		if err := rt.maybeHardLink(w, f); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// finishTransferredHardLinks links the members of each group whose leader
+// was transferred, once all transfers are complete.
+func (rt *Transfer) finishTransferredHardLinks() error {
+	for _, g := range rt.hlinkGroups {
+		if g.state == hlinkSent {
+			if err := rt.finishHardLink(g.leader); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// maybeHardLink makes f a hard link of leader, unless it already is one, see
+// rsync/hlink.c:maybe_hard_link.
+func (rt *Transfer) maybeHardLink(f, leader *File) error {
+	if rt.Opts.DryRun {
+		return nil
+	}
+	leaderSt, err := rt.DestRoot.Lstat(leader.Name)
+	if err != nil {
+		return err
+	}
+	if st, err := rt.DestRoot.Lstat(f.Name); err == nil && os.SameFile(st, leaderSt) {
+		return nil
+	}
+	if rt.Opts.Verbose {
+		rt.Logger.Printf("%s => %s", f.Name, leader.Name)
+	}
+	return replaceWithLink(rt.DestRoot, leader.Name, rt.DestRoot, f.Name)
+}
diff --git a/internal/receiver/link.go b/internal/receiver/link.go
new file mode 100644
index 0000000..315783b
--- /dev/null
+++ b/internal/receiver/link.go
@@ -0,0 +1,33 @@
+//go:build linux || darwin
+
+package receiver
+
+import (
+	"os"
+	"path/filepath"
+
+	"golang.org/x/sys/unix"
+)
+
+// linkAt creates newname in newRoot as a hard link of oldname in oldRoot,
+// without following a symlink. The parent directories are opened through
+// their os.Root, so neither name can escape its root.
+func linkAt(oldRoot *os.Root, oldname string, newRoot *os.Root, newname string) error {
+	if oldRoot == newRoot {
+		return newRoot.Link(oldname, newname)
+	}
+	oldDir, err := oldRoot.Open(filepath.Dir(oldname))
+	if err != nil {
+		return err
+	}
+	defer oldDir.Close()
+	newDir, err := newRoot.Open(filepath.Dir(newname))
+	if err != nil {
+		return err
+	}
+	defer newDir.Close()
+	if err := unix.Linkat(int(oldDir.Fd()), filepath.Base(oldname), int(newDir.Fd()), filepath.Base(newname), 0); err != nil {
+		return &os.LinkError{Op: "link", Old: oldname, New: newname, Err: err}
+	}
+	return nil
+}
diff --git a/internal/receiver/link_windows.go b/internal/receiver/link_windows.go
new file mode 100644
index 0000000..40e23c2
--- /dev/null
+++ b/internal/receiver/link_windows.go
@@ -0,0 +1,117 @@
+//go:build windows
+
+package receiver
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// fileLinkInformation is FILE_LINK_INFORMATION, the argument of
+// NtSetInformationFile with the FileLinkInformation class.
+type fileLinkInformation struct {
+	ReplaceIfExists bool
+	RootDirectory   windows.Handle
+	FileNameLength  uint32
+	FileName        [windows.MAX_PATH]uint16
+}
+
+// fileLinkInformationClass is FileLinkInformation (windows.FileLinkInformation
+// is the value of FileLinkInformationEx).
+const fileLinkInformationClass = 11
+
+// linkAt creates newname in newRoot as a hard link of oldname in oldRoot,
+// without following a symlink. Like os.Root.Link within one root, both parent
+// directories are opened through their roots and the file and its new name
+// are given relative to those directory handles, so neither name can escape
+// its root.
+func linkAt(oldRoot *os.Root, oldname string, newRoot *os.Root, newname string) error {
+	if oldRoot == newRoot {
+		return newRoot.Link(oldname, newname)
+	}
+	oldDir, err := oldRoot.Open(filepath.Dir(oldname))
+	if err != nil {
+		return err
+	}
+	defer oldDir.Close()
+	newDir, err := newRoot.Open(filepath.Dir(newname))
+	if err != nil {
+		return err
+	}
+	defer newDir.Close()
+	if err := linkHandles(windows.Handle(oldDir.Fd()), filepath.Base(oldname), windows.Handle(newDir.Fd()), filepath.Base(newname)); err != nil {
+		return &os.LinkError{Op: "link", Old: oldname, New: newname, Err: err}
+	}
+	return nil
+}
+
+// linkHandles links oldname in the directory olddir as newname in the
+// directory newdir, like Linkat in the Go standard library's
+// internal/syscall/windows, which os.Root.Link uses. FileLinkInformation is
+// set on a handle that has DELETE access besides FILE_WRITE_ATTRIBUTES.
+func linkHandles(olddir windows.Handle, oldname string, newdir windows.Handle, newname string) error {
+	h, err := openNoFollow(olddir, oldname, windows.SYNCHRONIZE|windows.FILE_WRITE_ATTRIBUTES|windows.DELETE)
+	if err != nil {
+		return err
+	}
+	defer windows.CloseHandle(h)
+
+	info := fileLinkInformation{RootDirectory: newdir}
+	p16, err := windows.UTF16FromString(newname)
+	if err != nil {
+		return err
+	}
+	if len(p16) > len(info.FileName) {
+		return syscall.EINVAL
+	}
+	copy(info.FileName[:], p16)
+	info.FileNameLength = uint32((len(p16) - 1) * 2)
+	err = windows.NtSetInformationFile(
+		h,
+		&windows.IO_STATUS_BLOCK{},
+		(*byte)(unsafe.Pointer(&info)),
+		uint32(unsafe.Sizeof(info)),
+		fileLinkInformationClass,
+	)
+	return ntError(err)
+}
+
+// openNoFollow opens name in the directory dir with the given access,
+// without following a symlink.
+func openNoFollow(dir windows.Handle, name string, access uint32) (windows.Handle, error) {
+	objectName, err := windows.NewNTUnicodeString(name)
+	if err != nil {
+		return 0, err
+	}
+	attrs := windows.OBJECT_ATTRIBUTES{RootDirectory: dir, ObjectName: objectName}
+	attrs.Length = uint32(unsafe.Sizeof(attrs))
+	var h windows.Handle
+	err = windows.NtCreateFile(
+		&h,
+		access,
+		&attrs,
+		&windows.IO_STATUS_BLOCK{},
+		nil,
+		0,
+		windows.FILE_SHARE_DELETE|windows.FILE_SHARE_READ|windows.FILE_SHARE_WRITE,
+		windows.FILE_OPEN,
+		windows.FILE_OPEN_REPARSE_POINT|windows.FILE_OPEN_FOR_BACKUP_INTENT|windows.FILE_SYNCHRONOUS_IO_NONALERT,
+		0,
+		0,
+	)
+	if err != nil {
+		return 0, ntError(err)
+	}
+	return h, nil
+}
+
+func ntError(err error) error {
+	if st, ok := err.(windows.NTStatus); ok {
+		return st.Errno()
+	}
+	return err
+}
diff --git a/internal/receiver/linkdest.go b/internal/receiver/linkdest.go
