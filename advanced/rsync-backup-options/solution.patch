+// readLocalFilesFrom reads the --files-from list on the sending side.
+func readLocalFilesFrom(osenv *rsyncos.Env, opts *rsyncopts.Options) ([]string, error) {
+	list, closeList, err := sender.OpenFilesFrom(opts.FilesFrom(), osenv.Stdin)
+	if err != nil {
+		return nil, err
+	}
+	defer closeList()
+	return sender.ReadFilesFrom(list, opts.FromNulls(), true)
+}
+
+// readForwardedFilesFrom reads the --files-from list that the receiving
+// client passes on to a remote sender.
+func readForwardedFilesFrom(osenv *rsyncos.Env, opts *rsyncopts.Options) ([]string, error) {
+	list, closeList, err := sender.OpenFilesFrom(opts.FilesFrom(), osenv.Stdin)
+	if err != nil {
+		return nil, err
+	}
+	defer closeList()
+	return sender.ForwardedFilesFrom(list, opts.FromNulls())
