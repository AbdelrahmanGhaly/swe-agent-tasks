+//go:build !linux && !darwin && !windows
+
+package receiver
+
+import (
+	"errors"
+	"os"
+)
+
+// linkAt creates newname in newRoot as a hard link of oldname in oldRoot.
+// Without linkat(2), a link from one root into another cannot be kept inside
+// both roots, so it is refused and the caller copies or recreates the file
+// instead, as rsync does when a hard link fails.
+func linkAt(oldRoot *os.Root, oldname string, newRoot *os.Root, newname string) error {
+	if oldRoot == newRoot {
+		return newRoot.Link(oldname, newname)
+	}
+	return &os.LinkError{Op: "link", Old: oldname, New: newname, Err: errors.ErrUnsupported}
+}
