+    def _parse_frame_header(self, header: bytes) -> tuple[int, int]:
+        # https://xiph.org/flac/format.html#frame_header
+        # returns the block size and the size of a valid frame header,
+        # otherwise zeros, also for a header that is cut off
+        if (len(header) < 6 or header[1] & 0xFE != 0xF8
+                or header[2] >> 4 == 0 or header[2] & 0x0F == 0x0F
+                or header[3] >> 4 > 10 or (header[3] >> 1) & 0x07 == 3
+                or header[3] & 0x01):
+            return 0, 0
+        # frame or sample number, coded like UTF-8
+        length = 0
+        while length < 8 and header[4] & (0x80 >> length):
+            length += 1
+        if length == 1 or length > 7:
+            return 0, 0
+        position = 4 + max(length, 1)
+        # an uncommon block size and sample rate follow in up to two bytes
+        # each, then the CRC-8
+        block_size_id = header[2] >> 4
+        block_size_length = {6: 1, 7: 2}.get(block_size_id, 0)
+        crc_position = (position + block_size_length
+                        + {12: 1, 13: 2, 14: 2}.get(header[2] & 0x0F, 0))
+        if len(header) <= crc_position:
+            return 0, 0
+        if any(byte & 0xC0 != 0x80 for byte in header[5:position]):
+            return 0, 0
+        if block_size_length:
+            block_size = int.from_bytes(
+                header[position:position + block_size_length], 'big') + 1
+        else:
+            block_size = self._BLOCK_SIZES[block_size_id]
+        crc = 0
+        for byte in header[:crc_position]:
+            crc ^= byte
+            for _ in range(8):
+                crc = ((crc << 1) ^ 0x07 if crc & 0x80 else crc << 1) & 0xFF
+        if crc != header[crc_position]:
+            return 0, 0
+        return block_size, crc_position + 1
