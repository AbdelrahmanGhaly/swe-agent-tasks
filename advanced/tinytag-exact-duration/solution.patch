+        # follow the subframes to find where the frame ends; returns 0 when
+        # the data does not hold all of them and the frame footer
+        block_size, header_size = self._parse_frame_header(frame[:16])
+        channel_assignment = frame[3] >> 4
+        sample_size = (self._SAMPLE_SIZES[(frame[3] >> 1) & 0x07]
+                       or self.bitdepth or 0)
+        bits = format(int.from_bytes(frame, 'big'), f'0{len(frame) * 8}b')
+        position = header_size * 8
+
+        def read(count: int) -> int:
+            nonlocal position
+            if position + count > len(bits):
+                raise IndexError('frame is incomplete')
+            value = int(bits[position:position + count] or '0', 2)
+            position += count
+            return value
+
+        def read_unary() -> int:
+            nonlocal position
+            stop = bits.index('1', position)
+            count = stop - position
+            position = stop + 1
+            return count
+
+        side_channel = {8: 1, 9: 0, 10: 1}.get(channel_assignment)
+        channels = 2 if side_channel is not None else channel_assignment + 1
+        try:
+            for channel in range(channels):
+                size = sample_size + (channel == side_channel)
+                read(1)
+                subframe_type = read(6)
+                if read(1):  # wasted bits per sample
+                    size -= read_unary() + 1
+                if subframe_type == 0:  # constant
+                    read(size)
+                    continue
+                if subframe_type == 1:  # verbatim
+                    read(size * block_size)
+                    continue
+                if 8 <= subframe_type <= 12:  # fixed predictor
+                    order = subframe_type - 8
+                    read(order * size)
+                elif subframe_type >= 32:  # linear predictor
+                    order = subframe_type - 31
+                    read(order * size)
+                    precision = read(4) + 1
+                    read(5)
+                    read(order * precision)
+                else:
+                    return 0
+                coding_method = read(2)
+                if coding_method > 1:
+                    return 0
+                parameter_size = 4 + coding_method
+                partition_order = read(4)
+                for partition in range(1 << partition_order):
+                    count = block_size >> partition_order
+                    if partition == 0:
+                        count -= order
+                    parameter = read(parameter_size)
+                    if parameter == (1 << parameter_size) - 1:  # escape
+                        read(read(5) * count)
+                        continue
+                    for _ in range(count):
+                        read_unary()
+                        read(parameter)
+        except (IndexError, ValueError):
+            return 0
+        size = (position + 7) // 8 + 2
+        return size if size <= len(frame) else 0
