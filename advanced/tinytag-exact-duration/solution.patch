+    def _count_samples(self, data: bytes) -> int:
+        # count the samples of every complete frame. A frame usually ends
+        # where the CRC-16 of its data matches, so sync codes inside audio
+        # data are not mistaken for frames. Otherwise its subframes tell
+        # where it ends, for the last frame or one followed by other data.
+        offset, end = self._audio_data_bounds(data)
+        if not data.startswith(b'fLaC', offset):
+            return 0
+        offset += 4
+        while offset + 4 <= end:
+            is_last_block = data[offset] & 0x80
+            offset += 4 + int.from_bytes(data[offset + 1:offset + 4], 'big')
+            if is_last_block:
+                break
+        frames = list(self._find_frame_headers(data, offset, end))
+        samples = index = 0
+        while index < len(frames):
+            frame_offset, block_size = frames[index]
+            position = frame_offset
+            crc = 0
+            next_index = None
+            for candidate in range(index + 1, len(frames)):
+                next_position = frames[candidate][0]
+                crc = self._crc16(data[position:next_position], crc)
+                position = next_position
+                if crc == 0:
+                    next_index = candidate
+                    break
+            if next_index is None:
+                frame_size = self._frame_size(data[frame_offset:end])
+                if not frame_size:
+                    break
+                next_index = bisect_left(
+                    frames, (frame_offset + frame_size, 0), index + 1)
+            samples += block_size
+            index = next_index
+        return samples
