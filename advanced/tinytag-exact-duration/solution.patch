+                while following < end and not data[following]:
+                    following += 1
+                if following + 4 > len(data):
+                    return end
+                next_frame = self._parse_frame_header(data, following)
+                if next_frame is not None and (
+                        next_frame[2] & self._SAME_RATE
+                        == frame[2] & self._SAME_RATE):
+                    return offset
