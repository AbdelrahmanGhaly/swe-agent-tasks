+    def _parse_frame_header(
+            self, data: bytes, offset: int) -> tuple[int, int, int] | None:
+        # returns the frame length, the samples per frame and the header
+        header = data[offset:offset + 4]
+        if len(header) < 4 or header[0] != 0xFF or header[1] & 0xE0 != 0xE0:
+            return None
+        mpeg_id = (header[1] >> 3) & 0x03
+        layer_id = (header[1] >> 1) & 0x03
+        br_id = header[2] >> 4
+        sr_id = (header[2] >> 2) & 0x03
