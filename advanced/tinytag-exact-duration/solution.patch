+    @classmethod
+    def _crc16(cls, data: bytes, crc: int = 0) -> int:
+        if not cls._CRC16_TABLE:
+            table: list[int] = []
+            for byte in range(256):
+                value = byte << 8
+                for _ in range(8):
+                    value = ((value << 1) ^ 0x8005 if value & 0x8000
+                             else value << 1) & 0xFFFF
+                table.append(value)
+            cls._CRC16_TABLE = tuple(table)
+        for byte in data:
+            crc = ((crc << 8) & 0xFFFF) ^ cls._CRC16_TABLE[(crc >> 8) ^ byte]
+        return crc
