+    def _find_first_frame(self, data: bytes, offset: int, end: int) -> int:
+        # the first frame header that is followed by a header for the same
+        # version and sample rate (zero bytes between them are skipped). A
+        # lone frame at the end of the file is not a stream ffmpeg can read,
+        # so no frame is found then.
