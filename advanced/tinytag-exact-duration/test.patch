+class TestExactDuration(TestCase):
+
+    def assert_samples(self,
+                       tag: TinyTag,
+                       samples: int,
+                       samplerate: int) -> None:
+        self.assertEqual(tag.samplerate, samplerate)
+        assert tag.duration is not None
+        self.assertAlmostEqual(tag.duration, samples / samplerate, places=9)
+
+    def check_samples(self, samples: dict[str, Expected]) -> None:
+        for name, (count, samplerate) in samples.items():
+            with self.subTest(sample=name):
+                tag = TinyTag.get(os.path.join(SAMPLE_FOLDER, name),
+                                  exact_duration=True)
+                self.assert_samples(tag, count, samplerate)
+
+    def check_cases(self, cases: dict[str, Case]) -> None:
+        for name, (build, count, samplerate) in cases.items():
+            with self.subTest(case=name):
+                tag = TinyTag.get(file_obj=BytesIO(build()),
+                                  exact_duration=True)
+                self.assert_samples(tag, count, samplerate)
+
+    def check_unchanged(self, names: list[str], keep_duration: bool) -> None:
+        for name in names:
+            with self.subTest(sample=name):
+                path = os.path.join(SAMPLE_FOLDER, name)
+                expected = TinyTag.get(path, image=True).as_dict()
+                result = TinyTag.get(
+                    path, image=True, exact_duration=True).as_dict()
+                if not keep_duration:
+                    expected.pop('duration', None)
+                    result.pop('duration', None)
+                self.assertEqual(result, expected)
