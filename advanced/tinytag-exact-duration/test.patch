+
+def read_sample(name: str) -> bytes:
+    with open(os.path.join(SAMPLE_FOLDER, name), 'rb') as file:
+        return file.read()
+
+
+def id3v2_size(data: bytes) -> int:
+    if not data.startswith(b'ID3'):
+        return 0
+    size = 0
+    for byte in data[6:10]:
+        size = (size << 7) | byte
+    return size + 10
+
+
+def mpeg_frames(data: bytes) -> list[tuple[int, int]]:
+    frames: list[tuple[int, int]] = []
+    offset = id3v2_size(data)
+    while offset + 4 <= len(data):
+        header = data[offset:offset + 4]
+        if header[0] != 0xFF or header[1] & 0xE0 != 0xE0:
+            break
+        version = (header[1] >> 3) & 3
+        layer = (header[1] >> 1) & 3
+        bitrate = _BITRATES[version == 3][layer][header[2] >> 4]
+        samplerate = _SAMPLE_RATES[version][(header[2] >> 2) & 3]
+        padding = (header[2] >> 1) & 1
+        if layer == 3:
+            length = (12000 * bitrate // samplerate + padding) * 4
+        elif layer == 2 or version == 3:
+            length = 144000 * bitrate // samplerate + padding
+        else:
+            length = 72000 * bitrate // samplerate + padding
+        frames.append((offset, length))
+        offset += length
+    return frames
+
+
+def mpeg_stream(name: str) -> tuple[bytes, list[tuple[int, int]]]:
+    data = read_sample(name)
+    frames = mpeg_frames(data)
+    offset, length = frames[-1]
+    return data[:offset + length], frames
+
+
+def drop_frames(name: str, count: int) -> bytes:
+    data, frames = mpeg_stream(name)
+    return data[:frames[-count][0]]
+
+
+def cut_last_frame(name: str, keep: int) -> bytes:
+    data, frames = mpeg_stream(name)
+    return data[:frames[-1][0] + keep]
+
+
+def lame_tag_crc(data: bytes) -> int:
+    crc = 0
+    for byte in data:
+        crc ^= byte
+        for _ in range(8):
+            crc = (crc >> 1) ^ 0xA001 if crc & 1 else crc >> 1
+    return crc
+
+
+def seal_lame_tag(data: bytes, first: int, version: int) -> bytes:
+    crc = lame_tag_crc(data[first:version + 34])
+    return data[:version + 34] + pack('>H', crc) + data[version + 36:]
+
+
+def replace_encoder(name: str, encoder: bytes) -> bytes:
+    data, frames = mpeg_stream(name)
+    first = frames[0][0]
+    for known in (b'LAME', b'Lavf', b'Lavc'):
+        offset = data.find(known, first, first + frames[0][1])
+        if offset != -1:
+            data = data[:offset] + encoder + data[offset + 4:]
+            return seal_lame_tag(data, first, offset)
+    raise AssertionError('no encoder tag')
+
+
+def set_encoder_delay(name: str, delay: int, audio_frames: int) -> bytes:
+    data, frames = mpeg_stream(name)
+    data = data[:frames[audio_frames + 1][0]]
+    version = data.find(b'LAME', frames[0][0], frames[1][0])
+    offset = version + 21
+    padding = int.from_bytes(data[offset:offset + 3], 'big') & 0xFFF
+    delays = ((delay << 12) | padding).to_bytes(3, 'big')
+    data = data[:offset] + delays + data[offset + 3:]
+    return seal_lame_tag(data, frames[0][0], version)
+
+
+def stream_with_tags(name: str, *tags: bytes) -> bytes:
+    return mpeg_stream(name)[0] + b''.join(tags)
+
+
+def id3v1_tag(title: bytes = b'Track') -> bytes:
+    return (b'TAG' + title.ljust(30, b'\x00') + b'Band'.ljust(30, b'\x00')
+            + b'Record'.ljust(30, b'\x00') + b'1999'
+            + b'Comment'.ljust(28, b'\x00') + b'\x00\x05\x0c')
+
+
+def id3v2_tag(size: int, version: int = 3, footer: bool = False) -> bytes:
+    flags = 0x10 if footer else 0
+    synchsafe = bytes(
+        [(size >> 21) & 0x7F, (size >> 14) & 0x7F, (size >> 7) & 0x7F,
+         size & 0x7F])
+    tag = b'ID3' + bytes([version, 0, flags]) + synchsafe
+    tag += b'TIT2' + pack('>I', size - 10) + b'\x00\x00\x00' + b'x' * (
+        size - 11)
+    if footer:
+        tag += b'3DI' + bytes([version, 0, flags]) + synchsafe
+    return tag
+
+
+def flac_crc8(data: bytes) -> int:
+    crc = 0
+    for byte in data:
+        crc ^= byte
+        for _ in range(8):
+            crc = ((crc << 1) ^ 0x07 if crc & 0x80 else crc << 1) & 0xFF
+    return crc
+
+
+def flac_crc16(data: bytes) -> int:
+    crc = 0
+    for byte in data:
+        crc ^= byte << 8
+        for _ in range(8):
+            crc = ((crc << 1) ^ 0x8005 if crc & 0x8000 else crc << 1) & 0xFFFF
+    return crc
+
+
+def flac_number(value: int) -> bytes:
+    if value < 0x80:
+        return bytes([value])
+    length = 2
+    while value >= 1 << (5 * length + 1):
+        length += 1
+    tail: list[int] = []
+    for _ in range(length - 1):
+        tail.append(0x80 | (value & 0x3F))
+        value >>= 6
+    first = ((0xFF << (8 - length)) & 0xFF) | value
+    return bytes([first] + tail[::-1])
+
+
+def flac_frame(number: int,
+               channels: list[list[int]],
+               variable: bool = False) -> bytes:
+    block_size = len(channels[0])
+    codes = {192: 1, 576: 2, 1152: 3, 2304: 4, 4608: 5, 256: 8, 512: 9,
+             1024: 10, 2048: 11, 4096: 12, 8192: 13}
+    code = codes.get(block_size, 6 if block_size <= 256 else 7)
+    header = bytes([0xFF, 0xF9 if variable else 0xF8, code << 4,
+                    ((len(channels) - 1) << 4) | 0x08])
+    header += flac_number(number)
+    if code == 6:
+        header += bytes([block_size - 1])
+    elif code == 7:
+        header += pack('>H', block_size - 1)
+    header += bytes([flac_crc8(header)])
+    body = b''.join(
+        b'\x02' + b''.join(pack('>h', sample) for sample in channel)
+        for channel in channels)
+    frame = header + body
+    return frame + pack('>H', flac_crc16(frame))
+
+
+def flac_stream(blocks: list[list[int]],
+                channels: int = 1,
+                total: int | None = None,
+                variable: bool = False,
+                samplerate: int = 44100) -> bytes:
+    frames = b''
+    position = 0
+    for index, block in enumerate(blocks):
+        number = position if variable else index
+        frames += flac_frame(number, [block] * channels, variable)
+        position += len(block)
+    if total is None:
+        total = position
+    sizes = [len(block) for block in blocks]
+    info = pack('>HH', min(sizes[:-1] or sizes), max(sizes)) + b'\x00' * 6
+    info += pack('>Q', (samplerate << 44) | ((channels - 1) << 41)
+                 | (15 << 36) | total) + b'\x00' * 16
+    return b'fLaC\x80' + len(info).to_bytes(3, 'big') + info + frames
+
+
+def tone(index: int, size: int = 4096) -> list[int]:
+    return [((sample * 13 + index * 7) % 3000) - 1500
+            for sample in range(size)]
+
+
+def with_bytes(index: int, embedded: bytes, size: int = 4096) -> list[int]:
+    block = tone(index, size)
+    values = [int.from_bytes(embedded[pos:pos + 2], 'big', signed=True)
+              for pos in range(0, len(embedded), 2)]
+    middle = size // 2
+    block[middle:middle + len(values)] = values
+    return block
+
+
+def fake_flac_header(number: int) -> bytes:
+    header = bytes([0xFF, 0xF8, 0xC0, 0x08]) + flac_number(number)
+    return header + bytes([flac_crc8(header)])
+
+
+def fake_frame(index: int, *numbers: int) -> list[int]:
+    return with_bytes(
+        index, b''.join(fake_flac_header(number) for number in numbers))
+
+
+def tones(count: int, size: int = 4096) -> list[list[int]]:
+    return [tone(index, size) for index in range(count)]
+
+
+def set_streaminfo_total(name: str, total: int) -> bytes:
+    data = read_sample(name)
+    offset = data.find(b'fLaC') + 8
+    value = int.from_bytes(data[offset + 10:offset + 18], 'big')
+    value = (value & ~((1 << 36) - 1)) | total
+    return data[:offset + 10] + value.to_bytes(8, 'big') + data[offset + 18:]
+
+
