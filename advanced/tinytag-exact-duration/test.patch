+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      if [ $# -lt 1 ] || [ -z "$1" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      if [ -z "$OUTPUT_PATH" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")"
+
+BASE_TESTS=(
+  "tinytag/tests/test_all.py"
+  "tinytag/tests/test_cli.py"
+)
+NEW_TESTS=(
+  "tinytag/tests/test_exact_duration_177b41.py"
+)
+
+ARGS=(-p no:cacheprovider -o junit_family=xunit1)
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  rm -f "$OUTPUT_PATH"
+  ARGS+=("--junitxml=$OUTPUT_PATH")
+fi
+
+LOG="$(mktemp)"
+if [ "$MODE" = "new" ]; then
+  python -m pytest "${NEW_TESTS[@]}" "${ARGS[@]}" 2>&1 | tee "$LOG"
+else
+  python -m pytest "${BASE_TESTS[@]}" "${ARGS[@]}" 2>&1 | tee "$LOG"
+fi
+STATUS=${PIPESTATUS[0]}
+
+if [ -n "$OUTPUT_PATH" ] && ! grep -q "<testcase" "$OUTPUT_PATH" 2>/dev/null; then
+  python - "$OUTPUT_PATH" "$LOG" "$STATUS" "$MODE" <<'PYEOF'
+import sys
+from xml.sax.saxutils import escape, quoteattr
+
+output_path, log_path, status, mode = sys.argv[1:5]
+with open(log_path, encoding="utf-8", errors="replace") as log:
+    lines = log.read().splitlines()
+detail = "\n".join(lines[-200:]) or "pytest printed nothing"
+message = quoteattr(f"pytest exited with status {status} without test results")
+with open(output_path, "w", encoding="utf-8") as report:
+    report.write(
+        '<?xml version="1.0" encoding="utf-8"?>\n'
+        '<testsuites><testsuite name="pytest" errors="1" failures="0" '
+        'tests="1" time="0">\n'
+        f'<testcase classname="pytest.{mode}" name="collection" time="0">\n'
+        f"<error message={message}>{escape(detail)}</error>\n"
+        "</testcase>\n"
+        "</testsuite></testsuites>\n"
+    )
+PYEOF
+  if [ "$STATUS" -eq 0 ]; then
+    STATUS=1
+  fi
+fi
+rm -f "$LOG"
+
+exit "$STATUS"
