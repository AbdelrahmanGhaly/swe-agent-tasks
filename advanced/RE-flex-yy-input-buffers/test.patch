+%option noyywrap
+%x incl
+%{
+#include <stdio.h>
+#include <string.h>
+static void show(const char *kind, const char *text, int len)
+{
+  int i;
+  printf(" %s(", kind);
+  for (i = 0; i < len; ++i)
+    putchar(text[i] == '\n' ? '^' : text[i]);
+  printf(")");
+}
+#define MAX_INCLUDE_DEPTH 10
+YY_BUFFER_STATE include_stack[MAX_INCLUDE_DEPTH];
+int include_stack_ptr = 0;
+%}
+%%
+include             BEGIN(incl);
+[a-z0-9]+           { show("W", yytext, yyleng); }
+\n                  { show("L", yytext, yyleng); }
+.                   ;
+<incl>[ \t]*        ;
+<incl>[^ \t\n]+     {
+                      if (include_stack_ptr >= MAX_INCLUDE_DEPTH)
+                        yyterminate();
+                      include_stack[include_stack_ptr++] = YY_CURRENT_BUFFER;
+                      yyin = fopen(yytext, "r");
+                      if (yyin == NULL)
+                        yyterminate();
+                      yy_switch_to_buffer(yy_create_buffer(yyin, YY_BUF_SIZE));
+                      BEGIN(INITIAL);
+                    }
+<<EOF>>             {
+                      if (--include_stack_ptr < 0)
+                      {
+                        yyterminate();
+                      }
+                      else
+                      {
+                        fclose(yyin);
+                        yy_delete_buffer(YY_CURRENT_BUFFER);
+                        yy_switch_to_buffer(include_stack[include_stack_ptr]);
+                        printf(" <back %d>", yyin == stdin);
+                      }
+                    }
+%%
+int main()
+{
+  yylex();
+  printf("\n");
+  return 0;
+}
