+%option noyywrap
+%{
+#include <stdio.h>
+#include <string.h>
+static void show(const char *kind, const char *text, int len)
+{
+  int i;
+  printf(" %s(", kind);
+  for (i = 0; i < len; ++i)
+    putchar(text[i] == '\n' ? '^' : text[i]);
+  printf(")");
+}
+%}
+%%
+<<EOF>>             {
+                      printf(" <pop>");
+                      yypop_buffer_state();
+                      if (!YY_CURRENT_BUFFER)
+                        yyterminate();
+                    }
+^[a-z]+         { show("B", yytext, yyleng); }
+[a-z]+          { show("W", yytext, yyleng); }
+[0-9]+          { show("N", yytext, yyleng); }
+\n              { show("L", yytext, yyleng); }
+.               { }
+%%
+int main()
+{
+  FILE *first = fopen("f1.txt", "r");
+  FILE *second = fopen("f3.txt", "r");
+  FILE *third = fopen("f4.txt", "r");
+  yypush_buffer_state(yy_create_buffer(first, YY_BUF_SIZE));
+  yypush_buffer_state(yy_create_buffer(second, YY_BUF_SIZE));
+  yypush_buffer_state(yy_create_buffer(third, YY_BUF_SIZE));
+  yylex();
+  printf(" [%d]\n", YY_CURRENT_BUFFER == NULL);
+  fclose(first);
+  fclose(second);
+  fclose(third);
+  return 0;
+}
