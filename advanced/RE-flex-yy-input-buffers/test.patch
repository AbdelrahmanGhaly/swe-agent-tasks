+%option noyywrap
+%{
+#include <stdio.h>
+#include <string.h>
+static void show(const char *kind, const char *text, int len)
+{
+  int i;
+  printf(" %s(", kind);
+  for (i = 0; i < len; ++i)
+    putchar(text[i] == '\n' ? '^' : text[i]);
+  printf(")");
+}
+%}
+%%
+^[a-z]+         { show("B", yytext, yyleng); return 1; }
+[a-z]+          { show("W", yytext, yyleng); return 2; }
+[0-9]+          { show("N", yytext, yyleng); return 3; }
+\n              { show("L", yytext, yyleng); }
+.               { }
+%%
+int main()
+{
+  YY_BUFFER_STATE buffers[3];
+  int i, done = 0, active[3] = { 1, 1, 1 };
+  buffers[0] = yy_scan_string("one two\nthree four");
+  buffers[1] = yy_create_buffer(fopen("f4.txt", "r"), YY_BUF_SIZE);
+  buffers[2] = yy_scan_string("five\n6 seven eight");
+  while (done < 3)
+  {
+    for (i = 0; i < 3; ++i)
+    {
+      if (!active[i])
+        continue;
+      yy_switch_to_buffer(buffers[i]);
+      if (yylex() == 0)
+      {
+        active[i] = 0;
+        ++done;
+        printf(" <end %d>", i);
+      }
+    }
+  }
+  printf("\n");
+  return 0;
+}
