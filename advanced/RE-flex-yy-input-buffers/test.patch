+%option noyywrap
+%x incl
+%{
+#include <stdio.h>
+#include <string.h>
+static void show(const char *kind, const char *text, int len)
+{
+  int i;
+  printf(" %s(", kind);
+  for (i = 0; i < len; ++i)
+    putchar(text[i] == '\n' ? '^' : text[i]);
+  printf(")");
+}
+%}
+%%
+include             BEGIN(incl);
+[a-z]+              { show("W", yytext, yyleng); return 1; }
+[0-9]+              { show("N", yytext, yyleng); return 2; }
+\n                  ;
+.                   ;
+<incl>[ \t]*        ;
+<incl>[^ \t\n]+     {
+                      yyin = fopen(yytext, "r");
+                      if (yyin == NULL)
+                        yyterminate();
+                      yypush_buffer_state(yy_create_buffer(yyin, YY_BUF_SIZE));
+                      BEGIN(INITIAL);
+                    }
+<<EOF>>             {
+                      if (yyin != stdin)
+                        fclose(yyin);
+                      yypop_buffer_state();
+                      if (!YY_CURRENT_BUFFER)
+                        yyterminate();
+                    }
+%%
+int main()
+{
+  int token, words = 0, numbers = 0;
+  while ((token = yylex()) != 0)
+  {
