+%option noyywrap
+%x STR
+%{
+#include <stdio.h>
+#include <string.h>
+#define YY_USER_INIT printf("{init}");
+static void show(const char *kind, const char *text, int len)
+{
+  int i;
+  printf(" %s(", kind);
+  for (i = 0; i < len; ++i)
+    putchar(text[i] == '\n' ? '^' : text[i]);
+  printf(")");
+}
+static int k = 0;
+static YY_BUFFER_STATE bufs[6];
+%}
+%%
+^[a-c]+	{ show("B", yytext, yyleng); }
+[a-c]+	{ show("W", yytext, yyleng); }
+\"	{ show("Q", yytext, yyleng); BEGIN STR; }
+<STR>[^"\n]+	{ show("S", yytext, yyleng); }
+<STR>\"	{ show("E", yytext, yyleng); BEGIN INITIAL; }
+<STR>\n	{ show("n", yytext, yyleng); }
+\n	{ show("N", yytext, yyleng); }
+<*>.	{ }
+%%
+int main() {
+  bufs[0] = yy_scan_bytes("caa  abcc", 7);
+  yy_switch_to_buffer(bufs[0]);
+  for (k = 0; k < 6; ++k) { int t = yylex(); printf("<%d>", t); if (t == 0) break; }
+  printf(" |");
+  printf("\n");
+  return 0;
+}
