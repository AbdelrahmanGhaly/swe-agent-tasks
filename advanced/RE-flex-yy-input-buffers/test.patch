+%%
+^[a-z]+         { show("B", yytext, yyleng); }
+[a-z]+          { show("W", yytext, yyleng); }
+[0-9]+          { show("N", yytext, yyleng); }
+\n              { show("L", yytext, yyleng); }
+.               { }
+%%
+int main()
+{
+  const char *text = "abc def\nghi 99 jkl";
+  int n;
