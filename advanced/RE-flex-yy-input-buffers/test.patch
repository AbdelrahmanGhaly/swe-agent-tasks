+\n              { show("L", yytext, yyleng); }
+.               { }
+%%
+int main()
+{
+  static char text[256];
+  size_t n = fread(text, 1, sizeof(text) - 1, stdin);
+  char *part = text, *bar;
+  int count = 0;
+  text[n] = '\0';
+  while (part != NULL)
+  {
+    YY_BUFFER_STATE buffer;
+    bar = strchr(part, '|');
+    if (bar != NULL)
+      *bar = '\0';
+    buffer = yy_scan_string(part);
+    while (yylex() != 0)
+      ++count;
+    yy_delete_buffer(buffer);
+    printf(" |");
+    part = bar != NULL ? bar + 1 : NULL;
+  }
+  printf(" %d\n", count);
+  return 0;
+}
