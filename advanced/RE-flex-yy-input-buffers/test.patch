+%option yywrap
+%x STR
+%{
+#include <stdio.h>
+#include <string.h>
+#define YY_USER_INIT printf("{init}");
+static void show(const char *kind, const char *text, int len)
+{
+  int i;
+  printf(" %s(", kind);
+  for (i = 0; i < len; ++i)
+    putchar(text[i] == '\n' ? '^' : text[i]);
+  printf(")");
+}
+static int wraps = 0;
+static int k = 0;
+static int eofs = 0;
+%}
+%%
+^[a-c]+	{ show("B", yytext, yyleng); }
+[a-c]+	{ show("W", yytext, yyleng); }
+\"	{ show("Q", yytext, yyleng); BEGIN STR; }
+<STR>[^"\n]+	{ show("S", yytext, yyleng); }
+<STR>\"	{ show("E", yytext, yyleng); BEGIN INITIAL; }
+<STR>\n	{ show("n", yytext, yyleng); }
+\n	{ show("N", yytext, yyleng); }
+<*>.	{ }
+<<EOF>>	{ printf(" <eof%d>", eofs); if (eofs >= 2) yyterminate(); yyin = fopen(eofs ? "d1.txt" : "d4.txt", "r"); ++eofs; }
+%%
+int yywrap(void) { printf(" {w%d}", wraps); switch (wraps++) { case 0: yyrestart(fopen("d3.txt", "r")); break; case 1: yyin = fopen("d1.txt", "r"); break; default: return 1; } return 0; }
+int main() {
+  for (k = 0; k < 5; ++k) { int t = yylex(); printf("<%d>", t); if (t == 0) break; }
+  printf(" |");
+  if (YY_CURRENT_BUFFER == NULL || k < 5) yyrestart(fopen("d2.txt", "r"));
+  for (k = 0; k < 6; ++k) { int t = yylex(); printf("<%d>", t); if (t == 0) break; }
+  printf(" |");
+  yyrestart(fopen("d3.txt", "r"));
+  for (k = 0; k < 4; ++k) { int t = yylex(); printf("<%d>", t); if (t == 0) break; }
+  printf(" |");
+  yyrestart(fopen("d1.txt", "r"));
+  for (k = 0; k < 6; ++k) { int t = yylex(); printf("<%d>", t); if (t == 0) break; }
+  printf(" |");
+  printf("\n");
+  return 0;
+}
