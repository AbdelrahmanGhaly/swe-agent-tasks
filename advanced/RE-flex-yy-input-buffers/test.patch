+#include <gtest/gtest.h>
+
+#include <sys/wait.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace {
+
+const char *const buffer_cases[] = {
+  "scan_first",
+  "scan_parts",
+  "scan_bytes",
+  "scan_copy",
+  "scan_handles",
+  "scan_inplace",
+  "scan_docs",
+  "switch_saved",
+  "switch_bol",
+  "switch_states",
+  "switch_action",
+  "switch_include_files",
+  "push_include",
+  "push_include_tokens",
+  "push_first",
+  "files_loop",
+  "files_tokens",
+  "restart_between",
+  "yyin_follows",
+  "file_first",
+  "wrap_files",
+  "wrap_strings",
+  "wrap_restart",
+  "wrap_switch",
+  "wrap_push",
+  "wrap_tokens",
+  "wrap_eof",
+  "flush_current",
+  "flush_action",
+  "init_once",
+  "delete_rescan",
+  "eof_files",
+  "eof_new_file",
+  "eof_strings",
+  "string_then_yyin",
+  "flush_bol",
+  "scan_buffer_check",
+  "init_yyin",
+  "init_buffer",
+  "init_string",
+  "restart_first",
+  "yyin_switch",
+  "yyin_action",
+};
+
+const int corpus_size = 36;
+
+const char *const line_cases[] = {
+  "lineno_per_buffer",
+  "lineno_mixed",
+};
+
+const char *const keep_cases[] = {
+  "keep_stdin",
+  "keep_files",
+  "restart_action",
+  "lineno_eof",
+};
+
+const char *const modes[] = { "default", "fast" };
+
+const char *const repo_programs[] = { "rtest", "test_bits", "test_ranges", "streams", "stest", "lazytest" };
+
+struct Param {
+  std::string name;
+  std::string mode;
+};
+
+std::string key(const Param& param)
+{
+  return param.name + "_" + param.mode;
+}
+
+void PrintTo(const Param& param, std::ostream *os)
+{
+  *os << key(param);
+}
+
+std::map<std::string,Param>& registry()
+{
+  static std::map<std::string,Param> params;
+  return params;
+}
+
+void add(const std::string& name, const std::string& mode, std::vector<Param>& params)
+{
+  Param param = { name, mode };
+  registry()[key(param)] = param;
+  params.push_back(param);
+}
+
+std::vector<Param> buffer_params()
+{
+  std::vector<Param> params;
+  for (size_t i = 0; i < sizeof(buffer_cases)/sizeof(*buffer_cases); ++i)
+    for (size_t j = 0; j < sizeof(modes)/sizeof(*modes); ++j)
+      add(buffer_cases[i], modes[j], params);
+  for (int i = 1; i <= corpus_size; ++i)
+  {
+    char name[16];
+    snprintf(name, sizeof(name), "corpus_%02d", i);
+    add(name, "default", params);
+  }
+  return params;
+}
+
+std::vector<Param> line_params()
+{
+  std::vector<Param> params;
+  for (size_t i = 0; i < sizeof(line_cases)/sizeof(*line_cases); ++i)
+    for (size_t j = 0; j < sizeof(modes)/sizeof(*modes); ++j)
+      add(line_cases[i], modes[j], params);
+  return params;
+}
+
+std::vector<Param> keep_params()
+{
+  std::vector<Param> params;
+  for (size_t i = 0; i < sizeof(keep_cases)/sizeof(*keep_cases); ++i)
+    for (size_t j = 0; j < sizeof(modes)/sizeof(*modes); ++j)
+      add(keep_cases[i], modes[j], params);
+  return params;
+}
+
+std::string env(const char *name, const char *fallback)
+{
+  const char *value = getenv(name);
+  return value != NULL && *value != '\0' ? value : fallback;
+}
+
+const std::string root = env("REFLEX_ROOT", "/app");
+const std::string build_dir = env("REFLEX_BUILD", (root + "/build").c_str());
+const std::string work = env("BUFFERS_WORK", "/tmp/buffers_8e9584");
+const std::string suite_dir = root + "/tests/buffers_8e9584";
+const std::string cases_dir = suite_dir + "/cases";
+const std::string reflex = build_dir + "/reflex";
+const std::string library = build_dir + "/libreflex.a";
+
+std::string quote(const std::string& s)
+{
+  return "'" + s + "'";
+}
+
+struct Outcome {
+  int         status;
+  std::string output;
+};
+
+Outcome run(const std::string& command)
+{
+  Outcome result = { -1, "" };
+  FILE *pipe = popen(command.c_str(), "r");
+  if (pipe == NULL)
+    return result;
+  char buffer[4096];
+  size_t n;
+  while ((n = fread(buffer, 1, sizeof(buffer), pipe)) > 0)
+    result.output.append(buffer, n);
+  int status = pclose(pipe);
+  if (WIFEXITED(status))
+    result.status = WEXITSTATUS(status);
+  return result;
+}
+
+bool read_file(const std::string& path, std::string& text)
+{
+  std::ifstream file(path.c_str(), std::ios::binary);
+  if (!file)
+    return false;
+  std::stringstream buffer;
+  buffer << file.rdbuf();
+  text = buffer.str();
+  return true;
+}
+
+bool exists(const std::string& path)
+{
+  std::ifstream file(path.c_str());
+  return file.good();
+}
+
+std::string head(const std::string& text, size_t lines)
+{
+  size_t pos = 0;
+  while (lines-- > 0 && pos != std::string::npos)
+  {
+    pos = text.find('\n', pos);
+    if (pos != std::string::npos)
+      ++pos;
+  }
+  return pos == std::string::npos ? text : text.substr(0, pos);
+}
+
+std::string visible(const std::string& text)
+{
+  std::string s;
+  for (size_t i = 0; i < text.size(); ++i)
+  {
+    if (text[i] == '\n')
+      s.append("\\n");
+    else if (text[i] == '\t')
+      s.append("\\t");
+    else
+      s.push_back(text[i]);
+  }
+  return s;
+}
+
+::testing::AssertionResult same_output(const char *reference, const std::string& expected, const std::string& actual)
+{
+  if (expected == actual)
+    return ::testing::AssertionSuccess();
+  size_t i = 0;
+  while (i < expected.size() && i < actual.size() && expected[i] == actual[i])
+    ++i;
+  size_t from = i > 60 ? i - 60 : 0;
+  return ::testing::AssertionFailure()
+    << "output differs from the " << reference << " output at byte " << i
+    << " (expected " << expected.size() << " bytes, got " << actual.size() << " bytes)\n"
+    << "expected: ..." << visible(expected.substr(from, 160)) << "\n"
+    << "actual:   ..." << visible(actual.substr(from, 160));
+}
+
+struct Build {
+  bool        done;
+  std::string log;
+  std::string exe;
+};
+
+std::map<std::string,Build>& builds()
+{
+  static std::map<std::string,Build> table;
+  return table;
+}
+
+std::string mode_flags(const std::string& mode)
+{
+  return mode == "default" ? "" : "--" + mode + " ";
+}
+
+const char *const build_script =
+  "flags=--yy\n"
+  "if [ \"$3\" != default ]; then flags=\"--yy --$3\"; fi\n"
+  "if ! \"$REFLEX\" $flags -o \"$WORK/$1.cpp\" \"$CASES/$2.l\" > \"$WORK/$1.gen\" 2>&1; then\n"
+  "  echo generate > \"$WORK/$1.fail\"\n"
+  "elif ! g++ -w -I\"$INCLUDE\" -o \"$WORK/$1\" \"$WORK/$1.cpp\" \"$LIBRARY\" > \"$WORK/$1.cc\" 2>&1; then\n"
+  "  echo compile > \"$WORK/$1.fail\"\n"
+  "fi\n";
+
+void check_build(const Param& param, Build& build)
+{
+  std::string base = work + "/" + key(param);
+  build.exe = base;
+  std::string failure, output;
+  if (!read_file(base + ".fail", failure))
+  {
+    build.done = true;
+    return;
+  }
+  if (failure.compare(0, 8, "generate") == 0)
+  {
+    read_file(base + ".gen", output);
+    build.log = "reflex --yy " + mode_flags(param.mode) + param.name + ".l failed:\n" + head(output, 20);
+  }
+  else
+  {
+    read_file(base + ".cc", output);
+    build.log = "the scanner generated by reflex --yy " + mode_flags(param.mode) + param.name + ".l does not compile:\n" + head(output, 30);
+  }
+}
+
+class Builds : public ::testing::Environment {
+ public:
+  void SetUp() override
+  {
+    run("mkdir -p " + quote(work));
+    std::vector<const Param*> params;
+    const ::testing::UnitTest *unit = ::testing::UnitTest::GetInstance();
+    for (int i = 0; i < unit->total_test_suite_count(); ++i)
+    {
+      const ::testing::TestSuite *suite = unit->GetTestSuite(i);
+      for (int j = 0; j < suite->total_test_count(); ++j)
+      {
+        const ::testing::TestInfo *info = suite->GetTestInfo(j);
+        if (!info->should_run() || info->value_param() == NULL)
+          continue;
+        std::map<std::string,Param>::const_iterator param = registry().find(info->value_param());
+        if (param != registry().end())
+          params.push_back(&param->second);
+      }
+    }
+    if (params.empty())
+      return;
+    std::ofstream script((work + "/build.sh").c_str(), std::ios::binary);
+    script << build_script;
+    script.close();
+    std::ofstream jobs((work + "/jobs.txt").c_str(), std::ios::binary);
+    for (size_t i = 0; i < params.size(); ++i)
+      jobs << key(*params[i]) << ' ' << params[i]->name << ' ' << params[i]->mode << '\n';
+    jobs.close();
+    run("cd " + quote(work) +
+        " && REFLEX=" + quote(reflex) +
+        " INCLUDE=" + quote(root + "/include") +
+        " LIBRARY=" + quote(library) +
+        " CASES=" + quote(cases_dir) +
+        " WORK=" + quote(work) +
+        " xargs -P " + env("BUFFERS_JOBS", "4") + " -L 1 sh build.sh < jobs.txt 2>&1");
+    for (size_t i = 0; i < params.size(); ++i)
+      check_build(*params[i], builds()[key(*params[i])]);
+  }
+};
+
+::testing::Environment *const builds_environment = ::testing::AddGlobalTestEnvironment(new Builds);
+
+void expect_output(const Param& param, const char *reference)
+{
+  const Build& build = builds()[key(param)];
+  ASSERT_TRUE(build.done) << build.log;
+  std::string expected;
+  ASSERT_TRUE(read_file(cases_dir + "/" + param.name + ".out", expected)) << "missing " << param.name << ".out";
+  std::string input = cases_dir + "/" + param.name + ".in";
+  if (!exists(input))
+    input = "/dev/null";
+  std::string output = work + "/" + key(param) + ".txt";
+  std::string errors = work + "/" + key(param) + ".err";
+  Outcome scan = run("cd " + quote(cases_dir) + " && timeout 60 " + quote(build.exe) + " < " + quote(input) + " > " + quote(output) + " 2> " + quote(errors));
+  std::string actual, stderr_text;
+  read_file(output, actual);
+  read_file(errors, stderr_text);
+  EXPECT_EQ(0, scan.status) << "the program exited with status " << scan.status << (scan.status == 124 ? " (timed out)" : "") << "\n" << head(stderr_text, 10);
+  EXPECT_TRUE(same_output(reference, expected, actual));
+}
+
+std::string param_name(const ::testing::TestParamInfo<Param>& info)
+{
+  return key(info.param);
+}
+
+class BufferScanner : public ::testing::TestWithParam<Param> { };
+
+TEST_P(BufferScanner, MatchesFlex)
+{
+  expect_output(GetParam(), "flex 2.6.4");
+}
+
+INSTANTIATE_TEST_SUITE_P(Buffers, BufferScanner, ::testing::ValuesIn(buffer_params()), param_name);
+
+class LineScanner : public ::testing::TestWithParam<Param> { };
+
+TEST_P(LineScanner, CountsPerBuffer)
+{
+  expect_output(GetParam(), "per-buffer yylineno");
+}
+
+INSTANTIATE_TEST_SUITE_P(Lines, LineScanner, ::testing::ValuesIn(line_params()), param_name);
+
+class KeepScanner : public ::testing::TestWithParam<Param> { };
+
+TEST_P(KeepScanner, MatchesFlex)
+{
+  expect_output(GetParam(), "flex 2.6.4");
+}
+
+INSTANTIATE_TEST_SUITE_P(Keep, KeepScanner, ::testing::ValuesIn(keep_params()), param_name);
+
+class RepoProgram : public ::testing::TestWithParam<const char*> { };
+
+TEST_P(RepoProgram, Passes)
+{
+  std::string program = build_dir + "/" + GetParam();
+  Outcome test = run("cd " + quote(root + "/tests") + " && timeout 600 " + quote(program) + " 2>&1");
+  EXPECT_EQ(0, test.status) << GetParam() << " exited with status " << test.status << ":\n" << head(test.output, 40);
+}
+
+std::string program_name(const ::testing::TestParamInfo<const char*>& info)
+{
+  return info.param;
+}
+
+INSTANTIATE_TEST_SUITE_P(Repo, RepoProgram, ::testing::ValuesIn(repo_programs), program_name);
+
+}
