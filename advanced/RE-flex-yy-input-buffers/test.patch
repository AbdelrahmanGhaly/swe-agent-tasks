+%option noyywrap
+%x incl
+%{
+#include <stdio.h>
+#include <string.h>
+static void show(const char *kind, const char *text, int len)
+{
+  int i;
+  printf(" %s(", kind);
+  for (i = 0; i < len; ++i)
+    putchar(text[i] == '\n' ? '^' : text[i]);
+  printf(")");
+}
+%}
+%%
+include             BEGIN(incl);
+[a-z0-9]+           { show("W", yytext, yyleng); }
+\n                  { show("L", yytext, yyleng); }
+.                   ;
+<incl>[ \t]*        ;
+<incl>[^ \t\n]+     {
+                      printf(" <in %s>", yytext);
+                      yyin = fopen(yytext, "r");
+                      if (yyin == NULL)
+                        yyterminate();
+                      yypush_buffer_state(yy_create_buffer(yyin, YY_BUF_SIZE));
+                      BEGIN(INITIAL);
+                    }
+<<EOF>>             {
+                      printf(" <out %d>", yyin == stdin);
+                      if (yyin != stdin)
+                        fclose(yyin);
+                      yypop_buffer_state();
+                      if (!YY_CURRENT_BUFFER)
+                        yyterminate();
+                    }
+%%
+int main()
+{
+  yylex();
+  printf(" [%d]\n", YY_CURRENT_BUFFER == NULL);
+  return 0;
+}
