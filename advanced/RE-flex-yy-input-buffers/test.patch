--- /dev/null
+++ b/test.sh
@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() { echo "usage: $0 [--output_path <path>] base|new" >&2; exit 2; }
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new) MODE="$1"; MODE_COUNT=$((MODE_COUNT + 1)); shift ;;
+    --output_path) shift; [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }; OUTPUT_PATH="$1"; shift ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    *) echo "unknown argument: $1" >&2; usage ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+WORK="$(mktemp -d)"
+BUILD="$WORK/build"
+if [ -n "$OUTPUT_PATH" ]; then mkdir -p "$(dirname "$OUTPUT_PATH")"; fi
+JOBS="$(nproc 2>/dev/null || echo 4)"
+[ "$JOBS" -gt 8 ] && JOBS=8
+
+write_failure() {
+  [ -n "$OUTPUT_PATH" ] || return 0
+  cat > "$OUTPUT_PATH" <<EOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="1" errors="0" name="AllTests">
+  <testsuite name="TestHarness" tests="1" failures="1" errors="0">
+    <testcase name="$1" classname="TestHarness">
+      <failure message="$2"><![CDATA[$(tail -n 60 "$3" 2>/dev/null | sed 's/]]>/]] >/g')]]></failure>
+    </testcase>
+  </testsuite>
+</testsuites>
+EOF
+}
+
+cmake -S "$ROOT" -B "$BUILD" -DCMAKE_BUILD_TYPE=Release > "$WORK/build.log" 2>&1 \
+  && cmake --build "$BUILD" -j"$JOBS" >> "$WORK/build.log" 2>&1
+BUILD_STATUS=$?
+if [ "$BUILD_STATUS" -ne 0 ]; then
+  echo "cmake build failed with status $BUILD_STATUS" >&2
+  tail -n 40 "$WORK/build.log" >&2
+fi
+
+if [ "$MODE" = "base" ]; then
+  FILTER='Keep/*:Repo/*'
+  for program in test_bits test_ranges streams stest lazytest; do
+    g++ -std=gnu++11 -O2 -I"$ROOT/include" -o "$BUILD/$program" "$ROOT/tests/$program.cpp" "$BUILD/libreflex.a" >> "$WORK/programs.log" 2>&1 &
+  done
+  wait
+else
+  FILTER='Buffers/*:Lines/*'
+fi
+
+HARNESS="$WORK/buffers_8e9584_test"
+if ! g++ -std=c++17 -O1 -pthread -o "$HARNESS" "$ROOT/tests/buffers_8e9584/buffers_8e9584_test.cpp" -lgtest -lgtest_main > "$WORK/harness.log" 2>&1; then
+  write_failure "harness_build" "the test harness does not compile" "$WORK/harness.log"
+  rm -rf "$WORK"
+  exit 1
+fi
+
+XML_FLAG=()
+if [ -n "$OUTPUT_PATH" ]; then
+  rm -f "$OUTPUT_PATH"
+  XML_FLAG=(--gtest_output="xml:$OUTPUT_PATH")
+fi
+REFLEX_ROOT="$ROOT" REFLEX_BUILD="$BUILD" BUFFERS_WORK="$WORK/scanners" BUFFERS_JOBS="$JOBS" \
+  "$HARNESS" --gtest_filter="$FILTER" ${XML_FLAG[@]+"${XML_FLAG[@]}"} 2>&1 | tee "$WORK/run.log"
+STATUS=${PIPESTATUS[0]}
+
+if [ -n "$OUTPUT_PATH" ] && [ ! -s "$OUTPUT_PATH" ]; then
+  write_failure "harness_run" "the test harness exited with status $STATUS without results" "$WORK/run.log"
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+rm -rf "$WORK"
+exit "$STATUS"
diff --git a/tests/buffers_8e9584/buffers_8e9584_test.cpp b/tests/buffers_8e9584/buffers_8e9584_test.cpp
