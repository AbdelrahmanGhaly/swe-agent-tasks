+%option noyywrap
+%{
+#include <stdio.h>
+#include <string.h>
+static void show(const char *kind, const char *text, int len)
+{
+  int i;
+  printf(" %s(", kind);
+  for (i = 0; i < len; ++i)
+    putchar(text[i] == '\n' ? '^' : text[i]);
+  printf(")");
+}
+%}
+%%
+^[a-z]+         { show("B", yytext, yyleng); return 1; }
+[a-z]+          { show("W", yytext, yyleng); return 2; }
+[0-9]+          { show("N", yytext, yyleng); return 3; }
+\n              { show("L", yytext, yyleng); }
+.               { }
+%%
+static FILE *files[2];
+static void which(void)
+{
+  if (yyin == NULL)
+    printf(" {none}");
+  else if (yyin == stdin)
+    printf(" {stdin}");
+  else if (yyin == files[0])
+    printf(" {f2}");
+  else if (yyin == files[1])
+    printf(" {f4}");
+  else
+    printf(" {other}");
+}
+int main()
+{
+  YY_BUFFER_STATE text, f2, f4;
+  files[0] = fopen("f2.txt", "r");
+  files[1] = fopen("f4.txt", "r");
+  f2 = yy_create_buffer(files[0], YY_BUF_SIZE);
+  yy_switch_to_buffer(f2);
+  which();
+  yylex();
+  which();
+  text = yy_scan_string("from memory");
+  which();
+  yylex();
+  which();
+  f4 = yy_create_buffer(files[1], YY_BUF_SIZE);
+  yypush_buffer_state(f4);
+  which();
+  yylex();
+  which();
+  yypop_buffer_state();
+  which();
+  yy_switch_to_buffer(f2);
+  which();
+  yylex();
+  yyrestart(stdin);
+  which();
+  yylex();
+  which();
+  printf("\n");
+  return 0;
+}
