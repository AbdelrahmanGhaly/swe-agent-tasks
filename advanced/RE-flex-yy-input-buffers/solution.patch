+  /// Returns the current buffer, creating a buffer for the given input, or for stdin when the input is not assigned, when there is no buffer yet, like Flex.
+  template<typename I>
+  typename AbstractBaseLexer::Matcher& current_buffer(const I& input) ///< input of the buffer to create, the Flex yyin
+    /// @returns reference to the current reflex::FlexLexer::Matcher
+  {
+    if (!this->has_matcher())
+    {
+      Input source(input);
+      this->matcher(new_buffer(source.assigned() ? source : this->stdinit(), NULL));
+      yy_load_buffer_state();
+    }
+    return this->matcher();
+  }
