+  virtual void yy_load_buffer_state()
+  { }
+  /// Returns the file that a file buffer reads when it needs more input, overridden by a reflex-generated --yy scanner to return the global yyin, like Flex YY_INPUT, or NULL to read the buffer's own input.
+  virtual FILE *yy_refill_file()
+    /// @returns FILE* or NULL
+  {
+    return NULL;
+  }
+  bool init_; ///< true when YY_USER_INIT was executed by the first call of the lexer
 };
 
