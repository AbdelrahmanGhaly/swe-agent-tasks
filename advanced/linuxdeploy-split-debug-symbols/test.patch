+        // a copy of linuxdeploy with the given script as the strip next to it
+        void useStrip(const std::string& script) {
+            const auto tools = root / "tools";
+            fs::create_directories(tools);
+            fs::copy_file(LINUXDEPLOY_PATH, tools / "linuxdeploy", fs::copy_options::overwrite_existing);
+            writeFile(tools / "strip", script);
+
+            const auto executablePermissions = fs::perms::owner_all | fs::perms::group_read | fs::perms::group_exec |
+                                               fs::perms::others_read | fs::perms::others_exec;
+            fs::permissions(tools / "linuxdeploy", executablePermissions);
+            fs::permissions(tools / "strip", executablePermissions);
+
+            linuxdeployBinary = tools / "linuxdeploy";
+        }
+
+        // a strip next to a copy of linuxdeploy that refuses the libraries with the given sonames, under whatever path it is
+        // given them, with the error linuxdeploy tolerates
+        void useStripThatRefuses(const std::vector<std::string>& sonames) {
+            std::ostringstream script;
+            script << "#!/bin/sh\n"
+                   << "for file in \"$@\"; do\n"
+                   << "    [ -f \"$file\" ] || continue\n"
+                   << "    case \"$(readelf -d \"$file\" 2>/dev/null | sed -n 's/.*Library soname: \\[\\(.*\\)\\].*/\\1/p')\" in\n";
+            for (const auto& soname : sonames)
+                script << "        " << soname << ") echo \"strip: $file: Not enough room for program headers, try linking with -N\" >&2; exit 1 ;;\n";
+            script << "    esac\n"
+                   << "done\n"
+                   << "exec /usr/bin/strip \"$@\"\n";
+            useStrip(script.str());
+        }
+
+        // a strip next to a copy of linuxdeploy that notes what it is given and, after each call, every deployed file that
+        // has lost its DWARF while its debug file is not in the tree
+        fs::path useStripThatNotesUnsavedFiles(const std::vector<std::pair<fs::path, fs::path>>& files) {
+            const auto notes = root / "strip-notes";
+
+            std::ostringstream script;
+            script << "#!/bin/sh\n"
+                   << "for file in \"$@\"; do echo \"stripped $file\" >> '" << notes.string() << "'; done\n"
+                   << "/usr/bin/strip \"$@\"\n"
+                   << "status=$?\n";
+            for (const auto& file : files) {
+                script << "if [ -f '" << file.first.string() << "' ] && ! readelf -S -W '" << file.first.string()
+                       << "' | grep -q ' \\.debug_info ' && ! readelf -S -W '" << file.second.string()
+                       << "' 2>/dev/null | grep -q ' \\.debug_info '; then\n"
+                       << "    echo \"unsaved " << file.first.string() << "\" >> '" << notes.string() << "'\n"
+                       << "fi\n";
+            }
+            script << "exit $status\n";
+            useStrip(script.str());
+
+            return notes;
+        }
