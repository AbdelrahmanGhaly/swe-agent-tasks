+        static void expectLineInformation(const Probe& probe) {
+            ASSERT_FALSE(probe.expected.empty());
+            ASSERT_TRUE(startsWith(probe.expected[0], "Line ")) << "fixture without line information: " << probe.original
+                                                                << "\n" << probe.expected[0];
