+        fs::path savedDwzFile(const std::string& buildIdHex) const {
+            const auto expected = buildIdHex + ".debug";
+
+            if (fs::is_directory(tree / ".dwz")) {
+                for (const auto& entry : fs::directory_iterator(tree / ".dwz")) {
+                    auto name = entry.path().filename().string();
+                    std::transform(name.begin(), name.end(), name.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+
+                    if (name == expected)
+                        return entry.path();
+                }
+            }
+
+            return tree / ".dwz" / expected;
+        }
