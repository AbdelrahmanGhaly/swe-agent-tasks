+        // nothing may point back to the fixtures or to where linuxdeploy wrote the AppDir and the tree
+        void freezeOutputs() {
+            if (fs::exists(fixtures))
+                fs::rename(fixtures, root / "fx.hidden");
+
+            const auto frozen = root / "frozen";
+
+            if (!fs::exists(frozen)) {
+                fs::create_directories(frozen);
+                fs::rename(appDir, frozen / "AppDir");
+
+                if (fs::exists(tree))
+                    fs::rename(tree, frozen / "debug-tree");
+            }
+        }
