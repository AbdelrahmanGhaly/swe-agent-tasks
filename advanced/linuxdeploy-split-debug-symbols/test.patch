index 0000000..97132df
--- /dev/null
+++ b/tests/debug_symbols_93009f/test_debug_symbols_93009f.cpp
@@ -0,0 +1,2018 @@
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <elf.h>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <map>
+#include <optional>
+#include <poll.h>
+#include <set>
+#include <signal.h>
+#include <sstream>
+#include <string>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <vector>
+
+#include "gtest/gtest.h"
+
+namespace fs = std::filesystem;
+
+namespace {
+    using Environment = std::map<std::string, std::string>;
+
+    struct ProcessResult {
+        int status = -1;
+        bool timedOut = false;
+        std::string out;
+        std::string err;
+
+        bool succeeded() const {
+            return !timedOut && WIFEXITED(status) && WEXITSTATUS(status) == 0;
+        }
+
+        std::string describe() const {
+            std::ostringstream oss;
+            oss << "status " << status << (timedOut ? " (timed out)" : "") << "\nstdout:\n" << out << "\nstderr:\n" << err;
+            return oss.str();
+        }
+    };
+
+    ProcessResult runProcess(const std::vector<std::string>& args, const Environment& changes = {},
+                             const std::vector<std::string>& unset = {}, const fs::path& cwd = {}, int timeoutSeconds = 300) {
+        ProcessResult result;
+
+        int outPipe[2];
+        int errPipe[2];
+
+        if (pipe(outPipe) != 0 || pipe(errPipe) != 0) {
+            result.err = std::string("pipe failed: ") + strerror(errno);
+            return result;
+        }
+
+        const auto pid = fork();
+
+        if (pid < 0) {
+            result.err = std::string("fork failed: ") + strerror(errno);
+            return result;
+        }
+
+        if (pid == 0) {
+            setpgid(0, 0);
+
+            dup2(outPipe[1], STDOUT_FILENO);
+            dup2(errPipe[1], STDERR_FILENO);
+            close(outPipe[0]);
+            close(outPipe[1]);
+            close(errPipe[0]);
+            close(errPipe[1]);
+
+            for (const auto& name : unset)
+                unsetenv(name.c_str());
+
+            for (const auto& change : changes)
+                setenv(change.first.c_str(), change.second.c_str(), 1);
+
+            if (!cwd.empty() && chdir(cwd.c_str()) != 0)
+                _exit(126);
+
+            std::vector<char*> argv;
+            for (const auto& arg : args)
+                argv.push_back(const_cast<char*>(arg.c_str()));
+            argv.push_back(nullptr);
+
+            execvp(argv[0], argv.data());
+            _exit(127);
+        }
+
+        close(outPipe[1]);
+        close(errPipe[1]);
+
+        std::array<pollfd, 2> fds{{{outPipe[0], POLLIN, 0}, {errPipe[0], POLLIN, 0}}};
+        std::array<std::string*, 2> buffers{&result.out, &result.err};
+        int open = 2;
+
+        const auto deadline = time(nullptr) + timeoutSeconds;
+
+        while (open > 0) {
+            const auto remaining = deadline - time(nullptr);
+
+            if (remaining <= 0) {
+                result.timedOut = true;
+                kill(-pid, SIGKILL);
+                break;
+            }
+
+            if (poll(fds.data(), fds.size(), static_cast<int>(std::min<time_t>(remaining, 1)) * 1000) < 0) {
+                if (errno == EINTR)
+                    continue;
+                break;
+            }
+
+            for (size_t i = 0; i < fds.size(); ++i) {
+                if (fds[i].fd < 0 || (fds[i].revents & (POLLIN | POLLHUP | POLLERR)) == 0)
+                    continue;
+
+                char buffer[8192];
+                const auto count = read(fds[i].fd, buffer, sizeof(buffer));
+
+                if (count > 0) {
+                    buffers[i]->append(buffer, static_cast<size_t>(count));
+                } else if (count == 0 || errno != EINTR) {
+                    close(fds[i].fd);
+                    fds[i].fd = -1;
+                    --open;
+                }
+            }
+        }
+
+        for (auto& fd : fds) {
+            if (fd.fd >= 0)
+                close(fd.fd);
+        }
+
+        waitpid(pid, &result.status, 0);
+        return result;
+    }
+
+    fs::path makeTemporaryDirectory() {
+        const auto* tmpdir = getenv("TMPDIR");
+        std::string pattern = std::string(tmpdir != nullptr && *tmpdir != '\0' ? tmpdir : "/tmp") + "/debug-symbols-XXXXXX";
+
+        std::vector<char> buffer(pattern.begin(), pattern.end());
+        buffer.push_back('\0');
+
+        if (mkdtemp(buffer.data()) == nullptr)
+            throw std::runtime_error("mkdtemp failed");
+
+        return fs::canonical(buffer.data());
+    }
+
+    void writeFile(const fs::path& path, const std::string& contents) {
+        fs::create_directories(path.parent_path());
+        std::ofstream ofs(path, std::ios::binary | std::ios::trunc);
+        ofs << contents;
+    }
+
+    std::string readFile(const fs::path& path) {
+        std::ifstream ifs(path, std::ios::binary);
+        return std::string((std::istreambuf_iterator<char>(ifs)), std::istreambuf_iterator<char>());
+    }
+
+    bool startsWith(const std::string& value, const std::string& prefix) {
+        return value.compare(0, prefix.size(), prefix) == 0;
+    }
+
+    struct Section {
+        uint32_t type = 0;
+        std::string contents;
+    };
+
+    std::map<std::string, Section> readSections(const fs::path& path) {
+        std::map<std::string, Section> sections;
+
+        const auto data = readFile(path);
+
+        if (data.size() < sizeof(Elf64_Ehdr) || data.compare(0, SELFMAG, ELFMAG) != 0 || data[EI_CLASS] != ELFCLASS64)
+            return sections;
+
+        Elf64_Ehdr ehdr{};
+        std::memcpy(&ehdr, data.data(), sizeof(ehdr));
+
+        if (ehdr.e_shoff == 0 || ehdr.e_shoff + uint64_t(ehdr.e_shnum) * sizeof(Elf64_Shdr) > data.size())
+            return sections;
+
+        std::vector<Elf64_Shdr> headers(ehdr.e_shnum);
+        std::memcpy(headers.data(), data.data() + ehdr.e_shoff, headers.size() * sizeof(Elf64_Shdr));
+
+        if (ehdr.e_shstrndx >= headers.size())
+            return sections;
+
+        const auto& names = headers[ehdr.e_shstrndx];
+
+        for (const auto& header : headers) {
+            if (names.sh_offset + header.sh_name >= data.size())
+                continue;
+
+            Section section;
+            section.type = header.sh_type;
+
+            if (header.sh_type != SHT_NOBITS && header.sh_offset + header.sh_size <= data.size())
+                section.contents = data.substr(header.sh_offset, header.sh_size);
+
+            sections[std::string(data.c_str() + names.sh_offset + header.sh_name)] = section;
+        }
+
+        return sections;
+    }
+
+    bool hasSectionWithContents(const fs::path& path, const std::string& name) {
+        const auto sections = readSections(path);
+        const auto it = sections.find(name);
+        return it != sections.end() && !it->second.contents.empty();
+    }
+
+    std::string toHex(const std::string& bytes) {
+        std::ostringstream oss;
+        for (const auto byte : bytes)
+            oss << std::hex << std::setw(2) << std::setfill('0') << static_cast<unsigned int>(static_cast<uint8_t>(byte));
+        return oss.str();
+    }
+
+    std::string buildIdOf(const fs::path& path) {
+        const auto sections = readSections(path);
+        const auto it = sections.find(".note.gnu.build-id");
+
+        if (it == sections.end() || it->second.contents.size() < sizeof(Elf64_Nhdr))
+            return {};
+
+        Elf64_Nhdr header{};
+        std::memcpy(&header, it->second.contents.data(), sizeof(header));
+
+        const auto descOffset = sizeof(header) + ((header.n_namesz + 3) / 4 * 4);
+
+        if (descOffset + header.n_descsz > it->second.contents.size())
+            return {};
+
+        return toHex(it->second.contents.substr(descOffset, header.n_descsz));
+    }
+
+    std::set<std::string> symbolNamesOf(const fs::path& path) {
+        std::set<std::string> names;
+
+        const auto sections = readSections(path);
+        const auto symbols = sections.find(".symtab");
+        const auto strings = sections.find(".strtab");
+
+        if (symbols == sections.end() || strings == sections.end())
+            return names;
+
+        const auto& table = symbols->second.contents;
+        const auto& text = strings->second.contents;
+
+        for (size_t offset = 0; offset + sizeof(Elf64_Sym) <= table.size(); offset += sizeof(Elf64_Sym)) {
+            Elf64_Sym symbol{};
+            std::memcpy(&symbol, table.data() + offset, sizeof(symbol));
+
+            if (symbol.st_name != 0 && symbol.st_name < text.size())
+                names.insert(std::string(text.c_str() + symbol.st_name));
+        }
+
+        return names;
+    }
+
+    struct DebugLink {
+        bool present = false;
+        std::string name;
+        uint32_t crc = 0;
+    };
+
+    DebugLink debugLinkOf(const fs::path& path) {
+        DebugLink link;
+
+        const auto sections = readSections(path);
+        const auto it = sections.find(".gnu_debuglink");
+
+        if (it == sections.end())
+            return link;
+
+        const auto& data = it->second.contents;
+        const auto nameLength = data.find('\0');
+
+        if (nameLength == std::string::npos)
+            return link;
+
+        const auto crcOffset = (nameLength + 4) / 4 * 4;
+
+        if (crcOffset + 4 > data.size())
+            return link;
+
+        link.present = true;
+        link.name = data.substr(0, nameLength);
+        std::memcpy(&link.crc, data.data() + crcOffset, 4);
+        return link;
+    }
+
+    struct AltLink {
+        bool present = false;
+        std::string name;
+        std::string buildId;
+    };
+
+    AltLink altLinkOf(const fs::path& path) {
+        AltLink link;
+
+        const auto sections = readSections(path);
+        const auto it = sections.find(".gnu_debugaltlink");
+
+        if (it == sections.end())
+            return link;
+
+        const auto& data = it->second.contents;
+        const auto nameLength = data.find('\0');
+
+        if (nameLength == std::string::npos)
+            return link;
+
+        link.present = true;
+        link.name = data.substr(0, nameLength);
+        link.buildId = toHex(data.substr(nameLength + 1));
+        return link;
+    }
+
+    uint32_t crc32Of(const fs::path& path) {
+        static const auto table = []() {
+            std::array<uint32_t, 256> values{};
+
+            for (uint32_t i = 0; i < values.size(); ++i) {
+                auto value = i;
+                for (int bit = 0; bit < 8; ++bit)
+                    value = (value & 1) ? 0xedb88320u ^ (value >> 1) : value >> 1;
+                values[i] = value;
+            }
+
+            return values;
+        }();
+
+        uint32_t crc = 0xffffffffu;
+
+        for (const auto byte : readFile(path))
+            crc = table[(crc ^ static_cast<uint8_t>(byte)) & 0xffu] ^ (crc >> 8);
+
+        return crc ^ 0xffffffffu;
+    }
+
+    fs::path buildIdLinkIn(const fs::path& directory, const std::string& buildIdHex) {
+        return directory / ".build-id" / buildIdHex.substr(0, 2) / (buildIdHex.substr(2) + ".debug");
+    }
+
+    std::vector<fs::path> regularFilesIn(const fs::path& directory) {
+        std::vector<fs::path> files;
+
+        if (!fs::is_directory(directory))
+            return files;
+
+        for (const auto& entry : fs::recursive_directory_iterator(directory)) {
+            if (entry.is_regular_file() && !entry.is_symlink())
+                files.push_back(entry.path().lexically_relative(directory));
+        }
+
+        std::sort(files.begin(), files.end());
+        return files;
+    }
+
+    std::vector<fs::path> entriesIn(const fs::path& directory) {
+        std::vector<fs::path> entries;
+
+        if (!fs::is_directory(directory))
+            return entries;
+
+        for (const auto& entry : fs::recursive_directory_iterator(directory))
+            entries.push_back(entry.path().lexically_relative(directory));
+
+        std::sort(entries.begin(), entries.end());
+        return entries;
+    }
