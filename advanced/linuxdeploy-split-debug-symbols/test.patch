+++ b/tests/debug_symbols_93009f/CMakeLists.txt
@@ -0,0 +1,51 @@
+cmake_minimum_required(VERSION 3.13)
+
+project(linuxdeploy_debug_symbols_test C CXX)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
+set(USE_CCACHE OFF CACHE BOOL "" FORCE)
+add_subdirectory(${CMAKE_CURRENT_SOURCE_DIR}/../.. linuxdeploy)
+
+find_package(GTest REQUIRED)
+
+# the tests build their fixtures with gcc, binutils and dwz and compare what GDB finds for each original and deployed
+# file; two of them also read the C library's debug symbols under /usr/lib/debug, which libc6-dbg installs on Debian
+foreach(tool gcc objcopy strip readelf dwz gdb)
+    find_program(DEBUG_SYMBOLS_TEST_${tool} ${tool})
+
+    if(NOT DEBUG_SYMBOLS_TEST_${tool})
+        message(FATAL_ERROR "The debug symbols tests need ${tool}")
+    endif()
+endforeach()
+
+# the description asks for what GDB 13 finds, so the GDB the tests compare with has to be that version
+execute_process(COMMAND ${DEBUG_SYMBOLS_TEST_gdb} --version OUTPUT_VARIABLE GDB_VERSION_TEXT)
+
+if(NOT GDB_VERSION_TEXT MATCHES "^GNU gdb [^\n]* 13\\.[0-9]")
+    message(FATAL_ERROR "The debug symbols tests need GDB 13, ${DEBUG_SYMBOLS_TEST_gdb} is another version")
+endif()
+
+execute_process(COMMAND ${DEBUG_SYMBOLS_TEST_gcc} -print-file-name=libm.so.6 OUTPUT_VARIABLE LIBM_PATH OUTPUT_STRIP_TRAILING_WHITESPACE)
+get_filename_component(LIBM_PATH "${LIBM_PATH}" REALPATH)
+execute_process(COMMAND ${DEBUG_SYMBOLS_TEST_readelf} -n "${LIBM_PATH}" OUTPUT_VARIABLE LIBM_NOTES)
+string(REGEX MATCH "Build ID: ([0-9a-f]+)" LIBM_BUILD_ID_NOTE "${LIBM_NOTES}")
+set(LIBM_BUILD_ID "${CMAKE_MATCH_1}")
+
+if(LIBM_BUILD_ID STREQUAL "")
+    message(FATAL_ERROR "The debug symbols tests could not read the build ID of ${LIBM_PATH}")
+endif()
+
+string(SUBSTRING "${LIBM_BUILD_ID}" 0 2 LIBM_BUILD_ID_HEAD)
+string(SUBSTRING "${LIBM_BUILD_ID}" 2 -1 LIBM_BUILD_ID_REST)
+
+if(NOT EXISTS "/usr/lib/debug/.build-id/${LIBM_BUILD_ID_HEAD}/${LIBM_BUILD_ID_REST}.debug")
+    message(FATAL_ERROR "The debug symbols tests need the debug symbols of ${LIBM_PATH} under /usr/lib/debug (libc6-dbg)")
+endif()
+
+add_executable(test_debug_symbols_93009f test_debug_symbols_93009f.cpp)
+target_link_libraries(test_debug_symbols_93009f PRIVATE GTest::gtest GTest::gtest_main)
+target_compile_definitions(test_debug_symbols_93009f PRIVATE LINUXDEPLOY_PATH="$<TARGET_FILE:linuxdeploy>")
+add_dependencies(test_debug_symbols_93009f linuxdeploy)
diff --git a/tests/debug_symbols_93009f/test_debug_symbols_93009f.cpp b/tests/debug_symbols_93009f/test_debug_symbols_93009f.cpp
