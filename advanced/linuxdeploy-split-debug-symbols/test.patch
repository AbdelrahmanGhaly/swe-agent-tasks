+
+        ProcessResult deploy(const std::vector<std::string>& args, Environment environment = {}, std::vector<std::string> unset = {},
+                             const fs::path& cwd = {}) {
+            std::vector<std::string> command{linuxdeployBinary.string()};
+            command.insert(command.end(), args.begin(), args.end());
+
+            environment.emplace("DISABLE_COPYRIGHT_FILES_DEPLOYMENT", "1");
+            environment.emplace("LINUXDEPLOY_DEBUG_FILE_DIRECTORY", globalDirectories());
+
+            for (const auto& name : unset)
+                environment.erase(name);
+
+            unset.insert(unset.end(), {"NO_STRIP", "LD_LIBRARY_PATH", "LINUXDEPLOY_PLUGIN_MODE"});
+
+            for (const auto& name : environment)
+                unset.erase(std::remove(unset.begin(), unset.end(), name.first), unset.end());
+
+            return runProcess(command, environment, unset, cwd.empty() ? root : cwd, 600);
+        }
+
+        void mustDeploy(const std::vector<std::string>& args, const Environment& environment = {}, const std::vector<std::string>& unset = {}) {
+            std::vector<std::string> fullArgs{"--appdir", appDir.string(), "--debug-symbols-dir", tree.string()};
+            fullArgs.insert(fullArgs.end(), args.begin(), args.end());
+
+            const auto result = deploy(fullArgs, environment, unset);
+            ASSERT_TRUE(result.succeeded()) << result.describe();
