+
+        static std::string librarySource(const std::string& name, int padding = 0) {
+            std::ostringstream oss;
+            for (int i = 0; i < padding; ++i)
+                oss << "\n";
+            oss << "struct " << name << "_point { int x; int y; };\n"
+                << "static int " << name << "_helper(int v) { return v * 3; }\n"
+                << "int " << name << "_func(int v) {\n"
+                << "    struct " << name << "_point p = { v, v + 1 };\n"
+                << "    return " << name << "_helper(p.x) + p.y;\n"
+                << "}\n";
+            return oss.str();
+        }
+
+        static std::string dwzLibrarySource(const std::string& name, const std::string& header = "shared.h") {
+            std::ostringstream oss;
+            oss << "#include \"" << header << "\"\n"
+                << "struct " << name << "_local { struct shared_point p; char name[8]; };\n"
+                << "static int " << name << "_helper(struct shared_point* p) { return p->x + p->y; }\n"
+                << "int " << name << "_func(int v) {\n"
+                << "    struct " << name << "_local l = { { v, v + 1, 7 }, \"x\" };\n"
+                << "    return " << name << "_helper(&l.p);\n"
+                << "}\n";
+            return oss.str();
+        }
+
+        static std::string executableSource(const std::string& name, const std::vector<std::string>& libraries, int padding = 0) {
+            std::ostringstream oss;
+            for (int i = 0; i < padding; ++i)
+                oss << "\n";
+            oss << "#include <stdio.h>\n";
+            for (const auto& library : libraries)
+                oss << "int " << library << "_func(int);\n";
+            oss << "static int " << name << "_helper(int v) { return v - 1; }\n"
+                << "int main(void) {\n"
+                << "    int total = 0;\n";
+            for (const auto& library : libraries)
+                oss << "    total += " << library << "_func(" << library.size() << ");\n";
+            oss << "    printf(\"%d\\n\", " << name << "_helper(total));\n"
+                << "    return 0;\n"
+                << "}\n";
+            return oss.str();
+        }
+
+        fs::path buildLibrary(const std::string& name, const fs::path& directory, const std::vector<std::string>& flags = {"-g"},
+                              int padding = 0, const std::string& source = "") {
+            const auto sourcePath = fixtures / "src" / (name + std::to_string(padding) + ".c");
+            writeFile(sourcePath, source.empty() ? librarySource(name, padding) : source);
+
+            fs::create_directories(directory);
+            const auto output = directory / ("lib" + name + ".so.1");
+
+            std::vector<std::string> args{"gcc", "-O0", "-fPIC", "-shared", "-Wl,-soname,lib" + name + ".so.1"};
+            args.insert(args.end(), flags.begin(), flags.end());
+            args.insert(args.end(), {"-o", output.string(), fs::relative(sourcePath, fixtures).string()});
+
+            const auto result = run(args);
+            EXPECT_TRUE(result.succeeded()) << result.describe();
+            return output;
+        }
+
+        fs::path buildExecutable(const std::string& name, const std::vector<std::pair<std::string, fs::path>>& libraries,
+                                 const std::vector<std::string>& flags = {"-g"}, const std::string& rpath = "", int padding = 0) {
+            std::vector<std::string> names;
+            for (const auto& library : libraries)
+                names.push_back(library.first);
+
+            const auto sourcePath = fixtures / "src" / (name + (padding == 0 ? "" : std::to_string(padding)) + ".c");
+            writeFile(sourcePath, executableSource(name, names, padding));
+
+            const auto output = fixtures / "bin" / name;
+
+            std::vector<std::string> args{"gcc", "-O0"};
+            args.insert(args.end(), flags.begin(), flags.end());
+            args.insert(args.end(), {"-o", output.string(), fs::relative(sourcePath, fixtures).string()});
+
+            std::set<fs::path> directories;
+            for (const auto& library : libraries) {
+                args.push_back(library.second.string());
+                directories.insert(library.second.parent_path());
+            }
+
+            if (!rpath.empty()) {
+                args.push_back("-Wl,-rpath," + rpath);
+            } else {
+                for (const auto& directory : directories)
+                    args.push_back("-Wl,-rpath," + directory.string());
+            }
+
+            const auto result = run(args);
+            EXPECT_TRUE(result.succeeded()) << result.describe();
+            return output;
+        }
+
+        // the layout Debian uses: the debug file under <global>/.build-id, the library stripped and linked to it
+        fs::path splitLikeDebian(const fs::path& library, const fs::path& global, bool compress = true) {
+            const auto buildId = buildIdOf(library);
+            EXPECT_FALSE(buildId.empty()) << library;
+
+            const auto debugFile = buildIdLinkIn(global, buildId);
+            fs::create_directories(debugFile.parent_path());
+
+            std::vector<std::string> extract{"objcopy", "--only-keep-debug"};
+            if (compress)
+                extract.push_back("--compress-debug-sections");
+            extract.insert(extract.end(), {library.string(), debugFile.string()});
+
+            mustRun(extract);
+            mustRun({"strip", "--remove-section=.comment", "--remove-section=.note", "--strip-unneeded", library.string()});
+            mustRun({"objcopy", "--add-gnu-debuglink=" + debugFile.string(), library.string()});
+            return debugFile;
+        }
+
+        // the debug file is created as <name>.debug, the library stripped and linked to it, then the debug file moves
+        fs::path splitWithDebugLink(const fs::path& library, const fs::path& debugFileDirectory) {
+            const auto debugFile = library.parent_path() / (library.filename().string() + ".debug");
+
+            mustRun({"objcopy", "--only-keep-debug", library.string(), debugFile.string()});
+            mustRun({"strip", "--strip-unneeded", library.string()});
+            mustRun({"objcopy", "--add-gnu-debuglink=" + debugFile.string(), library.string()});
+
+            const auto target = debugFileDirectory / debugFile.filename();
+
+            if (target != debugFile) {
+                fs::create_directories(debugFileDirectory);
+                fs::rename(debugFile, target);
+            }
+
+            return target;
+        }
+
+        std::vector<std::string> gdb(const fs::path& file, const std::string& debugFileDirectory, const std::vector<std::string>& commands) {
+            std::vector<std::string> args{
+                "gdb", "-nx", "-batch",
+                "-iex", "set debuginfod enabled off",
+                "-iex", "set auto-load no",
+                "-iex", "set pagination off",
+                "-iex", "set width 0",
+                "-iex", "set debug-file-directory " + debugFileDirectory,
+            };
+
+            for (size_t i = 0; i < commands.size(); ++i) {
+                args.push_back("-ex");
+                args.push_back("echo @@probe " + std::to_string(i) + "@@\\n");
+                args.push_back("-ex");
+                args.push_back(commands[i]);
+            }
+
+            args.push_back(file.string());
+
+            const auto result = runProcess(args, {{"HOME", root.string()}}, {"DEBUGINFOD_URLS"}, root, 300);
+            EXPECT_FALSE(result.timedOut) << result.describe();
+
+            std::vector<std::string> outputs(commands.size());
+            long current = -1;
+
+            std::istringstream lines(result.out);
+            std::string line;
+
+            while (std::getline(lines, line)) {
+                if (startsWith(line, "@@probe ")) {
+                    current = std::stol(line.substr(8));
+                    continue;
+                }
+
+                while (!line.empty() && (line.back() == ' ' || line.back() == '\r'))
+                    line.pop_back();
+
+                if (current >= 0 && current < static_cast<long>(outputs.size()) && !line.empty())
+                    outputs[current] += line + "\n";
+            }
+
+            return outputs;
+        }
+
+        std::string globalDirectories() const {
+            return globalDebugDir.string();
+        }
+
+        Probe probe(const fs::path& original, const fs::path& inAppDir, const std::vector<std::string>& commands,
+                    const std::string& debugDirectories = "") {
+            Probe result{original, inAppDir, commands, {}};
+            result.expected = gdb(original, debugDirectories.empty() ? globalDirectories() : debugDirectories, commands);
+            return result;
+        }
