+        // two libraries from one package, processed with dwz the way Debian does, with the multifile named by its
+        // absolute path in the global directory
+        std::pair<fs::path, fs::path> buildDebianDwzPair(const std::string& first, const std::string& second, std::string& altBuildId) {
+            writeFile(fixtures / "src" / "shared.h", "struct shared_point { int x; int y; long tag; };\n");
+
+            const auto firstLibrary = buildLibrary(first, fixtures / "lib", {"-g"}, 0, dwzLibrarySource(first));
+            const auto secondLibrary = buildLibrary(second, fixtures / "lib", {"-g"}, 0, dwzLibrarySource(second));
+
+            const auto multifile = globalDebugDir / ".dwz" / triplet / "libfixture1.debug";
+            fs::create_directories(multifile.parent_path());
+
+            mustRun({"dwz", "-m", multifile.string(), "-M", multifile.string(), firstLibrary.string(), secondLibrary.string()});
+
+            altBuildId = buildIdOf(multifile);
+            EXPECT_FALSE(altBuildId.empty());
+
+            splitLikeDebian(firstLibrary, globalDebugDir);
+            splitLikeDebian(secondLibrary, globalDebugDir);
+
+            return {firstLibrary, secondLibrary};
+        }
