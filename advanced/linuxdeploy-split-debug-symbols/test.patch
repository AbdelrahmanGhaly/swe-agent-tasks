+        // the tree unpacked over a copy of the AppDir, with a debug-file-directory GDB cannot use
+        void expectSameWhenUnpacked(const std::vector<Probe>& probes) {
+            freezeOutputs();
+
+            const auto unpacked = root / "unpacked" / "squashfs-root";
+            fs::remove_all(unpacked);
+            fs::create_directories(unpacked);
+            fs::copy(root / "frozen" / "AppDir", unpacked, fs::copy_options::recursive | fs::copy_options::copy_symlinks);
+
+            if (fs::exists(root / "frozen" / "debug-tree"))
+                fs::copy(root / "frozen" / "debug-tree", unpacked,
+                         fs::copy_options::recursive | fs::copy_options::copy_symlinks | fs::copy_options::overwrite_existing);
+
+            for (const auto& probe : probes) {
+                const auto actual = gdb(unpacked / probe.inAppDir, (root / "no-such-debug-dir").string(), probe.commands);
+
+                for (size_t i = 0; i < probe.commands.size(); ++i) {
+                    EXPECT_EQ(probe.expected[i], actual[i]) << "tree unpacked over the AppDir, " << probe.inAppDir.string() << ": " << probe.commands[i];
+                }
+            }
+        }
+
+        // the AppDir and the tree moved elsewhere, GDB's debug-file-directory set to the tree
+        void expectSameThroughDebugFileDirectory(const std::vector<Probe>& probes) {
+            freezeOutputs();
+
+            const auto mountedAppDir = root / "mnt" / ".mount_app" / "AppDir";
+            const auto movedTree = root / "downloads" / "app-debug";
+
+            fs::remove_all(root / "mnt");
+            fs::remove_all(root / "downloads");
+            fs::create_directories(mountedAppDir.parent_path());
+            fs::create_directories(movedTree.parent_path());
+            fs::copy(root / "frozen" / "AppDir", mountedAppDir, fs::copy_options::recursive | fs::copy_options::copy_symlinks);
+
+            if (fs::exists(root / "frozen" / "debug-tree"))
+                fs::copy(root / "frozen" / "debug-tree", movedTree, fs::copy_options::recursive | fs::copy_options::copy_symlinks);
+
+            for (const auto& probe : probes) {
+                const auto actual = gdb(mountedAppDir / probe.inAppDir, movedTree.string(), probe.commands);
+
+                for (size_t i = 0; i < probe.commands.size(); ++i) {
+                    EXPECT_EQ(probe.expected[i], actual[i]) << "debug-file-directory set to the tree, " << probe.inAppDir.string() << ": " << probe.commands[i];
+                }
