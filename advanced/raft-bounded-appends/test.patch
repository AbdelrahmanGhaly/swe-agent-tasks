+func proposeSizes(c *cluster, id uint64, sizes []int) [][]byte {
+	var want [][]byte
+	for i, size := range sizes {
+		data := payload(size, byte('a'+i))
+		want = append(want, data)
+		c.propose(id, data)
+	}
+	return want
+}
+
+func requirePages(t *testing.T, pages [][]*pb.Entry, want [][]byte, limit uint64) {
+	t.Helper()
+	var ents []*pb.Entry
+	for _, page := range pages {
+		ents = append(ents, page...)
+	}
+	var got [][]byte
+	for _, e := range ents {
+		got = append(got, e.GetData())
+	}
+	if !slices.EqualFunc(got, want, bytes.Equal) {
+		t.Fatalf("entries handed out in %d batches do not match the %d proposals in order", len(pages), len(want))
+	}
+	if g, w := pageIndexes(pages), greedyPages(ents, limit); !slices.EqualFunc(g, w, slices.Equal) {
+		t.Fatalf("batches %v, want %v for limit %d", g, w, limit)
+	}
+}
