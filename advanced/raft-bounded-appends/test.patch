+func testVoteResponseDoesNotWaitForTheBacklog(t *testing.T, async, prevote bool) {
+	run(t, func() {
+		c := newCluster(t, async, map[uint64]uint64{2: 250}, 1, 2, 3)
+		if prevote {
+			c.enablePreVote()
+		}
+		c.campaign(1)
+		c.paused[2] = true
+		c.drop = func(m *pb.Message) bool {
+			if m.GetType() != pb.MsgApp || m.GetTo() != 3 {
+				return false
+			}
+			for _, e := range m.GetEntries() {
+				if e.GetIndex() >= 6 {
+					return true
+				}
+			}
+			return false
+		}
+		proposeSizes(c, 1, []int{100, 100, 100, 100, 100, 100})
+		c.settle()
+		if last := lastIndex(c.nodes[3].storage); last != 5 {
+			t.Fatalf("node 3 persisted up to %d, want 5", last)
+		}
+		c.drop = nil
+		c.isolate(1)
+		if err := c.nodes[3].rn.Campaign(); err != nil {
+			t.Fatal(err)
+		}
+		c.settle()
+		c.ready(2)
+		for len(c.nodes[2].local) > 0 {
+			c.processLocal(2)
+		}
+		if last := c.nodes[2].last; last >= 8 {
+			t.Fatalf("node 2 handed out its whole backlog (up to %d) in one batch", last)
+		}
+		want := pb.MsgVoteResp
+		if prevote {
+			want = pb.MsgPreVoteResp
+		}
+		answered := false
+		for _, v := range c.votes {
+			if v.from == 2 && v.to == 3 && v.typ == want {
+				answered = true
+			}
+		}
+		if !answered {
+			t.Fatalf("node 2 did not send its %s to node 3 with its next batch, entries handed out only up to %d", want, c.nodes[2].last)
+		}
+		c.paused[2] = false
+		c.converge()
+	})
+}
