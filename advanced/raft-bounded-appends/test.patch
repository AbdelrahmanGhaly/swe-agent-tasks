+		c := newCluster(t, async, map[uint64]uint64{2: 250}, 1, 2, 3, 4, 5)
+		c.campaign(1)
+		for _, id := range []uint64{3, 4, 5} {
+			c.block(1, id)
+		}
+		c.paused[2] = true
+		proposeSizes(c, 1, []int{100, 100, 100, 100, 100, 100})
+		c.settle()
+		handOutOne := func() {
+			c.ready(2)
+			for len(c.nodes[2].local) > 0 {
+				c.processLocal(2)
+			}
+		}
+		handOutOne()
+		if last := c.nodes[2].last; last >= 6 {
+			t.Fatalf("node 2 handed out its entries up to %d in one batch", last)
+		}
+		if err := c.nodes[2].rn.Campaign(); err != nil {
+			t.Fatal(err)
+		}
+		c.isolate(1)
+		c.block(2, 3)
+		c.campaign(3)
+		proposeSizes(c, 3, []int{100, 100, 100, 100, 100, 100})
+		c.settle()
+		c.heal()
+		c.isolate(1)
+		c.tick(3)
+		c.work(3)
+		c.deliver()
+		handOutOne()
+		c.deliver()
+		c.work(3)
+		c.deliver()
+		if last := c.nodes[2].last; last >= 8 {
+			t.Fatalf("node 2 handed out its entries up to %d before the new leader replaced them", last)
+		}
+		c.paused[2] = false
+		for round := 0; c.nodes[3].rn.Status().Progress[2].Match != lastIndex(c.nodes[3].storage); round++ {
+			if round == 20 {
+				t.Fatalf("node 2 did not catch up: %s", c.describe())
+			}
+			c.tick(3)
+			c.settle()
+		}
+		for _, m := range c.outbox {
+			if m.GetFrom() != 2 || (m.GetType() != pb.MsgVote && m.GetType() != pb.MsgPreVote) {
+				continue
+			}
+			if !c.nodes[2].wasHandedOut(m.GetIndex(), m.GetLogTerm()) {
+				t.Fatalf("node 2 sent %s naming entry %d of term %d, which it never handed out", m.GetType(), m.GetIndex(), m.GetLogTerm())
+			}
+		}
+		c.converge()
+	})
+}
+
+func TestWaitingVoteRequestForReplacedEntriesIsNeverSent(t *testing.T) {
+	testWaitingVoteRequestForReplacedEntriesIsNeverSent(t, false)
+}
+
+func TestAsyncWaitingVoteRequestForReplacedEntriesIsNeverSent(t *testing.T) {
+	testWaitingVoteRequestForReplacedEntriesIsNeverSent(t, true)
+}
+
+func TestBootstrapHandsOutItsConfChangesInBatches(t *testing.T) {
+	run(t, func() {
+		boot := func(limit uint64) ([][]*pb.Entry, *pb.ConfState) {
+			st := raft.NewMemoryStorage()
+			rn, err := raft.NewRawNode(&raft.Config{
+				ID:                    1,
+				ElectionTick:          10,
+				HeartbeatTick:         1,
+				Storage:               st,
+				MaxSizePerMsg:         1 << 20,
+				MaxInflightMsgs:       256,
+				MaxAppendSizePerReady: limit,
+				Logger:                discard,
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := rn.Bootstrap([]raft.Peer{{ID: 1}, {ID: 2}, {ID: 3}, {ID: 4}, {ID: 5}}); err != nil {
+				t.Fatal(err)
+			}
+			var pages [][]*pb.Entry
+			var cs *pb.ConfState
+			var applied uint64
+			for k := 0; rn.HasReady(); k++ {
+				if k == 100 {
+					t.Fatalf("node keeps reporting a Ready")
+				}
+				rd := rn.Ready()
+				if len(rd.Entries) > 1 && limit != 0 && entsSize(rd.Entries) > limit {
+					t.Fatalf("handed out %d bytes of entries with limit %d", entsSize(rd.Entries), limit)
+				}
+				if err := st.Append(rd.Entries); err != nil {
+					t.Fatal(err)
+				}
+				if len(rd.Entries) > 0 {
+					pages = append(pages, rd.Entries)
+				}
+				if !raft.IsEmptyHardState(rd.HardState) {
+					if rd.HardState.GetCommit() > lastIndex(st) {
+						t.Fatalf("asked to persist commit index %d with entries only up to %d", rd.HardState.GetCommit(), lastIndex(st))
+					}
+					if err := st.SetHardState(rd.HardState); err != nil {
+						t.Fatal(err)
+					}
+				}
+				for _, e := range rd.CommittedEntries {
+					if e.GetIndex() != applied+1 || e.GetIndex() > lastIndex(st) {
+						t.Fatalf("applied entry %d after %d with entries persisted up to %d", e.GetIndex(), applied, lastIndex(st))
+					}
+					applied = e.GetIndex()
+					var cc pb.ConfChange
+					if err := proto.Unmarshal(e.GetData(), &cc); err != nil {
+						t.Fatal(err)
+					}
+					cs = rn.ApplyConfChange(&cc)
+				}
+				rn.Advance(rd)
+			}
+			if applied != 5 {
+				t.Fatalf("applied %d of the 5 bootstrap entries", applied)
+			}
+			return pages, cs
+		}
+		pages, _ := boot(0)
+		if len(pages) != 1 || len(pages[0]) != 5 {
+			t.Fatalf("without a limit the bootstrap entries came in batches %v", pageIndexes(pages))
+		}
+		limit := uint64(proto.Size(pages[0][0]) + proto.Size(pages[0][1]))
+		pages, cs := boot(limit)
+		if g, w := pageIndexes(pages), [][]uint64{{1, 2}, {3, 4}, {5}}; !slices.EqualFunc(g, w, slices.Equal) {
+			t.Fatalf("bootstrap batches %v, want %v", g, w)
+		}
+		if voters := cs.GetVoters(); !slices.Equal(voters, []uint64{1, 2, 3, 4, 5}) {
+			t.Fatalf("voters %v after bootstrap", voters)
+		}
+	})
+}
+
+func testSnapshotFollowedByEntriesInBatches(t *testing.T, async bool) {
+	run(t, func() {
+		c := newCluster(t, async, map[uint64]uint64{3: 250}, 1, 2, 3)
+		c.campaign(1)
+		c.isolate(3)
+		proposeSizes(c, 1, []int{100, 100, 100, 100, 100, 100, 100, 100, 100, 100})
+		c.settle()
+		c.compact(1)
+		proposeSizes(c, 1, []int{100, 100, 100, 100, 100, 100})
+		c.settle()
+		c.heal()
+		before := len(c.nodes[3].pages)
+		c.tick(1)
+		c.settle()
+		if snapIndex(c.nodes[3].storage) <= 1 {
+			t.Fatalf("node 3 did not receive a snapshot: %s", c.describe())
+		}
+		if pages := c.nodes[3].pages[before:]; len(pages) < 3 {
+			t.Fatalf("node 3 persisted the entries after the snapshot in %d batches", len(pages))
+		}
+		requireCaughtUp(t, c, 1, 3)
+	})
+}
+
+func TestSnapshotFollowedByEntriesInBatches(t *testing.T) {
+	testSnapshotFollowedByEntriesInBatches(t, false)
+}
+
+func TestAsyncSnapshotFollowedByEntriesInBatches(t *testing.T) {
+	testSnapshotFollowedByEntriesInBatches(t, true)
+}
