--- /dev/null
+++ b/test.sh
@@ -0,0 +1,177 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      [ -n "$OUTPUT_PATH" ] || { echo "missing value for --output_path" >&2; usage; }
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")" || exit 2
+
+export GOFLAGS=-buildvcs=false
+export GOTOOLCHAIN=local
+if [ -n "${GOCACHE:-}" ] && [ ! -w "$GOCACHE" ]; then
+  export GOCACHE="/tmp/go-build-$(id -u)"
+fi
+
+NEW_DIR="appendlimit_a366de"
+NEW_PKG="go.etcd.io/raft/v3/$NEW_DIR"
+LOG="$(mktemp)"
+LIST_ERR="$(mktemp)"
+trap 'rm -f "$LOG" "$LIST_ERR"' EXIT
+LIST_STATUS=0
+
+if [ "$MODE" = "base" ]; then
+  PKGS="$(go list ./... 2>"$LIST_ERR")"
+  LIST_STATUS=$?
+  if [ "$LIST_STATUS" -ne 0 ]; then
+    PKGS="$(go list -e ./... 2>/dev/null)"
+  fi
+  cat "$LIST_ERR" >>"$LOG"
+  PKGS="$(printf '%s\n' "$PKGS" | grep -v -e '^$' -e "/$NEW_DIR\$")"
+  if [ -n "$PKGS" ]; then
+    go test -v -count=1 -timeout 20m $PKGS >>"$LOG" 2>&1
+    STATUS=$?
+  else
+    STATUS=1
+  fi
+  if [ "$LIST_STATUS" -ne 0 ]; then
+    echo "[setup failed] go list ./... exited with status $LIST_STATUS" >>"$LOG"
+    [ "$STATUS" -eq 0 ] && STATUS="$LIST_STATUS"
+  fi
+else
+  go test -v -count=1 -timeout 20m "./$NEW_DIR/" >>"$LOG" 2>&1
+  STATUS=$?
+fi
+
+if ! grep -qE '^ *--- (PASS|FAIL|SKIP):' "$LOG"; then
+  echo "no tests were collected in mode $MODE" >>"$LOG"
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+cat "$LOG"
+
+expected_tests() {
+  grep -ho '^func Test[A-Za-z0-9_]*' "$NEW_DIR"/*_test.go | sed 's/^func //'
+}
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+}
+
+add_failures() {
+  suite="$1"
+  message="$2"
+  detail="$3"
+  shift 3
+  grep -q '</testsuites>' "$OUTPUT_PATH" 2>/dev/null || printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n</testsuites>\n' >"$OUTPUT_PATH"
+  EXTRA="$(mktemp)"
+  MERGED="$(mktemp)"
+  {
+    echo "<testsuite name=\"$suite\" tests=\"$#\" failures=\"$#\" errors=\"0\">"
+    for name in "$@"; do
+      echo "<testcase name=\"$name\" classname=\"$suite\"><failure message=\"$message\">$detail</failure></testcase>"
+    done
+    echo '</testsuite>'
+  } >"$EXTRA"
+  awk -v extra="$EXTRA" '/<\/testsuites>/ { while ((getline line < extra) > 0) print line } { print }' "$OUTPUT_PATH" >"$MERGED"
+  TESTS="$(grep -c '<testcase ' "$MERGED")"
+  FAILURES="$(grep -c '<failure' "$MERGED")"
+  ERRORS="$(grep -c '<error' "$MERGED")"
+  sed -E "1,/<testsuites/ s#<testsuites[^>]*>#<testsuites tests=\"$TESTS\" failures=\"$FAILURES\" errors=\"$ERRORS\">#" "$MERGED" >"$OUTPUT_PATH"
+  rm -f "$EXTRA" "$MERGED"
+}
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  go-junit-report <"$LOG" >"$OUTPUT_PATH" 2>/dev/null || true
+  PANICKED="$(awk '/^--- FAIL: /{name=$3} /^panic: /{print name; exit}' "$LOG")"
+  if [ -n "$PANICKED" ] && grep -q "<testcase name=\"$PANICKED\"" "$OUTPUT_PATH" 2>/dev/null; then
+    PANIC_TEXT="$(mktemp)"
+    PATCHED="$(mktemp)"
+    sed -n '/^panic: /,$p' "$LOG" | head -n 40 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' >"$PANIC_TEXT"
+    awk -v name="$PANICKED" -v text="$PANIC_TEXT" '
+      index($0, "<testcase name=\"" name "\"") { inside = 1 }
+      inside && /<failure message="Failed"><\/failure>/ {
+        sub(/<failure message="Failed"><\/failure>/, "<failure message=\"panic\">")
+        printf "%s", $0
+        while ((getline line < text) > 0) print line
+        print "</failure>"
+        inside = 0
+        next
+      }
+      /<\/testcase>/ { inside = 0 }
+      { print }
+    ' "$OUTPUT_PATH" >"$PATCHED" && cat "$PATCHED" >"$OUTPUT_PATH"
+    rm -f "$PANIC_TEXT" "$PATCHED"
+  fi
+  RAN=0
+  NAMES=""
+  if [ "$MODE" = "new" ]; then
+    SUITE="$NEW_PKG"
+    for name in $(expected_tests); do
+      if grep -q "<testcase name=\"$name\"" "$OUTPUT_PATH" 2>/dev/null; then
+        RAN=1
+      else
+        NAMES="$NAMES $name"
+      fi
+    done
+  else
+    SUITE="go.etcd.io/raft/v3"
+    if grep -q '<testcase ' "$OUTPUT_PATH" 2>/dev/null; then
+      RAN=1
+    else
+      NAMES="build"
+    fi
+  fi
+  if [ -n "$NAMES" ]; then
+    [ "$STATUS" -eq 0 ] && STATUS=1
+    DETAIL="$(grep -E '^# |\.go:[0-9]+:[0-9]+: |\[(build|setup) failed\]|^panic' "$LOG" | head -n 40)"
+    [ -n "$DETAIL" ] || DETAIL="$(tail -n 40 "$LOG")"
+    DETAIL="$(printf '%s\n' "$DETAIL" | xml_escape)"
+    if [ "$RAN" -eq 1 ] && [ -n "$PANICKED" ]; then
+      MESSAGE="not run: the test binary exited after $PANICKED panicked"
+    elif [ "$RAN" -eq 1 ]; then
+      MESSAGE="not run: the test binary exited before reaching this test"
+    else
+      MESSAGE="the test package failed to build or run"
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n</testsuites>\n' >"$OUTPUT_PATH"
+    fi
+    add_failures "$SUITE" "$MESSAGE" "$DETAIL" $NAMES
+  fi
+  if [ "$LIST_STATUS" -ne 0 ]; then
+    DETAIL="$(head -n 40 "$LIST_ERR" | xml_escape)"
+    add_failures "$SUITE" "package discovery failed: go list ./... exited with status $LIST_STATUS" "$DETAIL" package_discovery
+  fi
+fi
+
+exit "$STATUS"
