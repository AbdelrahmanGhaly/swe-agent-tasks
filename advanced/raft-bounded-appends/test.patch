+func testWithheldAcknowledgementIsSentOnceItsEntriesAreHandedOut(t *testing.T, async bool) {
+	run(t, func() {
+		c := newCluster(t, async, map[uint64]uint64{2: 250}, 1, 2, 3)
+		c.campaign(1)
+		c.paused[2] = true
+		proposeSizes(c, 1, []int{100, 100, 100, 100, 100, 100})
+		c.settle()
+		before := len(c.acks)
+		c.ready(2)
+		for len(c.nodes[2].local) > 0 {
+			c.processLocal(2)
+		}
+		persisted := lastIndex(c.nodes[2].storage)
+		if persisted >= 8 {
+			t.Fatalf("node 2 persisted the whole backlog (up to %d) in one batch", persisted)
+		}
+		for _, a := range c.acks[before:] {
+			if a.from == 2 && a.index > persisted {
+				t.Fatalf("node 2 acknowledged index %d with entries handed out only up to %d", a.index, persisted)
+			}
+		}
+		c.paused[2] = false
+		c.settle()
+		sent := false
+		for _, a := range c.acks[before:] {
+			if a.from == 2 && a.to == 1 && a.index == 8 {
+				sent = true
+			}
+		}
+		if !sent {
+			t.Fatalf("node 2 never acknowledged index 8 to the leader")
+		}
+		requireCaughtUp(t, c, 1, 2)
+	})
+}
