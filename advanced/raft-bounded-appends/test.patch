diff --git a/appendlimit_a366de/harness_a366de_test.go b/appendlimit_a366de/harness_a366de_test.go
new file mode 100644
index 0000000..c7b4dd1
--- /dev/null
+++ b/appendlimit_a366de/harness_a366de_test.go
@@ -0,0 +1,791 @@
+package appendlimit
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"log"
+	"math/rand"
+	"runtime/debug"
+	"slices"
+	"testing"
+
+	"google.golang.org/protobuf/proto"
+
+	"go.etcd.io/raft/v3"
+	pb "go.etcd.io/raft/v3/raftpb"
+)
+
+var discard = &raft.DefaultLogger{Logger: log.New(io.Discard, "", 0)}
+
+type node struct {
+	id      uint64
+	limit   uint64
+	storage *raft.MemoryStorage
+	rn      *raft.RawNode
+	applied uint64
+	local   []*pb.Message
+	pages   [][]*pb.Entry
+	states  []*pb.HardState
+	ever    map[[2]uint64]bool
+	cur     map[uint64]uint64
+	last    uint64
+	highest uint64
+	reads   []readState
+}
+
+type readState struct {
+	index, handed uint64
+}
+
+type ack struct {
+	from, to, term, index uint64
+}
+
+type response struct {
+	from, to, term uint64
+	typ            pb.MessageType
+	reject         bool
+}
+
+type cluster struct {
+	t       *testing.T
+	label   string
+	async   bool
+	prevote bool
+	ids     []uint64
+	nodes   map[uint64]*node
+	net     []*pb.Message
+	blocked map[[2]uint64]bool
+	paused  map[uint64]bool
+	crash   map[uint64]bool
+	dup     func(m *pb.Message) bool
+	drop    func(m *pb.Message) bool
+	applied map[uint64]uint64
+	sent    map[[3]uint64]uint64
+	acks    []ack
+	outbox  []*pb.Message
+	votes   []response
+	rejects []response
+}
+
+func (c *cluster) fatalf(format string, args ...any) {
+	c.t.Helper()
+	c.t.Fatalf(c.label+format, args...)
+}
+
+func run(t *testing.T, f func()) {
+	t.Helper()
+	defer func() {
+		if r := recover(); r != nil {
+			t.Fatalf("panic: %v\n%s", r, debug.Stack())
+		}
+	}()
+	f()
+}
+
+func newCluster(t *testing.T, async bool, limits map[uint64]uint64, ids ...uint64) *cluster {
+	c := &cluster{
+		t:       t,
+		async:   async,
+		ids:     ids,
+		nodes:   map[uint64]*node{},
+		blocked: map[[2]uint64]bool{},
+		paused:  map[uint64]bool{},
+		crash:   map[uint64]bool{},
+		applied: map[uint64]uint64{},
+		sent:    map[[3]uint64]uint64{},
+	}
+	for _, id := range ids {
+		st := raft.NewMemoryStorage()
+		snap := &pb.Snapshot{Metadata: &pb.SnapshotMetadata{
+			Index:     proto.Uint64(1),
+			Term:      proto.Uint64(1),
+			ConfState: &pb.ConfState{Voters: slices.Clone(ids)},
+		}}
+		if err := st.ApplySnapshot(snap); err != nil {
+			t.Fatal(err)
+		}
+		if err := st.SetHardState(&pb.HardState{Term: proto.Uint64(1), Commit: proto.Uint64(1)}); err != nil {
+			t.Fatal(err)
+		}
+		n := &node{id: id, limit: limits[id], storage: st, applied: 1}
+		c.nodes[id] = n
+		c.start(n)
+	}
+	return c
+}
+
+func (c *cluster) start(n *node) {
+	cfg := &raft.Config{
+		ID:                    n.id,
+		ElectionTick:          10,
+		HeartbeatTick:         1,
+		Storage:               n.storage,
+		Applied:               n.applied,
+		MaxSizePerMsg:         1 << 20,
+		MaxInflightMsgs:       256,
+		MaxAppendSizePerReady: n.limit,
+		AsyncStorageWrites:    c.async,
+		PreVote:               c.prevote,
+		Logger:                discard,
+	}
+	rn, err := raft.NewRawNode(cfg)
+	if err != nil {
+		c.fatalf("node %d: NewRawNode: %v", n.id, err)
+	}
+	n.rn = rn
+	n.local = nil
+	if n.ever == nil {
+		n.ever = map[[2]uint64]bool{}
+	}
+	n.cur = map[uint64]uint64{}
+	n.last = lastIndex(n.storage)
+	n.highest = max(n.highest, n.last)
+}
+
+func (c *cluster) enablePreVote() {
+	c.prevote = true
+	for _, id := range c.ids {
+		c.restart(id)
+	}
+}
+
+func (n *node) handOut(snap *pb.Snapshot, ents []*pb.Entry) {
+	if snap != nil && snap.GetMetadata().GetIndex() != 0 {
+		n.ever[[2]uint64{snap.GetMetadata().GetIndex(), snap.GetMetadata().GetTerm()}] = true
+		n.cur = map[uint64]uint64{snap.GetMetadata().GetIndex(): snap.GetMetadata().GetTerm()}
+		n.last = snap.GetMetadata().GetIndex()
+		n.highest = max(n.highest, n.last)
+	}
+	if len(ents) == 0 {
+		return
+	}
+	for i := ents[0].GetIndex(); i <= n.last; i++ {
+		delete(n.cur, i)
+	}
+	for _, e := range ents {
+		n.ever[[2]uint64{e.GetIndex(), e.GetTerm()}] = true
+		n.cur[e.GetIndex()] = e.GetTerm()
+	}
+	n.last = ents[len(ents)-1].GetIndex()
+	n.highest = max(n.highest, n.last)
+}
+
+func (n *node) wasHandedOut(index, term uint64) bool {
+	if n.ever[[2]uint64{index, term}] {
+		return true
+	}
+	if index <= snapIndex(n.storage) {
+		return true
+	}
+	t, err := n.storage.Term(index)
+	return err == nil && t == term
+}
+
+func (n *node) overwritten(index, term uint64) bool {
+	at := min(index, n.last)
+	t, ok := n.cur[at]
+	if !ok {
+		var err error
+		if t, err = n.storage.Term(at); err != nil {
+			return false
+		}
+	}
+	return t > term
+}
+
+func (c *cluster) checkRefs(n *node, m *pb.Message) {
+	var refs []uint64
+	var id [2]uint64
+	switch m.GetType() {
+	case pb.MsgApp:
+		id = [2]uint64{m.GetIndex(), m.GetLogTerm()}
+		if ents := m.GetEntries(); len(ents) > 0 {
+			id = [2]uint64{ents[len(ents)-1].GetIndex(), ents[len(ents)-1].GetTerm()}
+		}
+		refs = []uint64{id[0], m.GetCommit()}
+	case pb.MsgVote, pb.MsgPreVote:
+		id = [2]uint64{m.GetIndex(), m.GetLogTerm()}
+		refs = []uint64{id[0]}
+	case pb.MsgHeartbeat:
+		refs = []uint64{m.GetCommit()}
+	case pb.MsgReadIndexResp:
+		refs = []uint64{m.GetIndex()}
+	default:
+		return
+	}
+	if n.limit == 0 && id[0] != 0 && !n.wasHandedOut(id[0], id[1]) && n.overwritten(id[0], id[1]) {
+		return
+	}
+	for _, ref := range refs {
+		if ref > n.highest {
+			c.fatalf("node %d sent %s to node %d referring to index %d with entries handed out only up to %d", n.id, m.GetType(), m.GetTo(), ref, n.highest)
+		}
+	}
+	if id[0] != 0 && !n.wasHandedOut(id[0], id[1]) {
+		c.fatalf("node %d sent %s to node %d naming entry %d of term %d, which it never handed out", n.id, m.GetType(), m.GetTo(), id[0], id[1])
+	}
+}
+
+func (c *cluster) restart(id uint64) {
+	c.start(c.nodes[id])
+}
+
+func (c *cluster) quorum() int { return len(c.ids)/2 + 1 }
+
+func lastIndex(st *raft.MemoryStorage) uint64 {
+	last, err := st.LastIndex()
+	if err != nil {
+		panic(err)
+	}
+	return last
+}
+
+func snapIndex(st *raft.MemoryStorage) uint64 {
+	first, err := st.FirstIndex()
+	if err != nil {
+		panic(err)
+	}
+	return first - 1
+}
+
+func persisted(st *raft.MemoryStorage, index, term uint64) bool {
+	if index <= snapIndex(st) {
+		return true
+	}
+	t, err := st.Term(index)
+	return err == nil && t == term
+}
+
+func (c *cluster) durableOn(index, term uint64) int {
+	count := 0
+	for _, id := range c.ids {
+		if persisted(c.nodes[id].storage, index, term) {
+			count++
+		}
+	}
+	return count
+}
+
+func entsSize(ents []*pb.Entry) uint64 {
+	var size uint64
+	for _, e := range ents {
+		size += uint64(proto.Size(e))
+	}
+	return size
+}
+
+func (c *cluster) checkBatch(n *node, ents []*pb.Entry) {
+	for i := 1; i < len(ents); i++ {
+		if ents[i].GetIndex() != ents[i-1].GetIndex()+1 {
+			c.fatalf("node %d handed out entries %d and %d next to each other", n.id, ents[i-1].GetIndex(), ents[i].GetIndex())
+		}
+	}
+	if n.limit != 0 && len(ents) > 1 {
+		if size := entsSize(ents); size > n.limit {
+			c.fatalf("node %d handed out %d entries of %d bytes in one batch, limit %d", n.id, len(ents), size, n.limit)
+		}
+	}
+}
+
+func (c *cluster) persistSnapshot(n *node, snap *pb.Snapshot) {
+	if err := n.storage.ApplySnapshot(snap); err != nil {
+		c.fatalf("node %d: ApplySnapshot: %v", n.id, err)
+	}
+	n.applied = max(n.applied, snap.GetMetadata().GetIndex())
+}
+
+func (c *cluster) persistEntries(n *node, ents []*pb.Entry) {
+	if len(ents) == 0 {
+		return
+	}
+	if err := n.storage.Append(ents); err != nil {
+		c.fatalf("node %d: Append: %v", n.id, err)
+	}
+	n.pages = append(n.pages, ents)
+}
+
+func (c *cluster) persistHardState(n *node, hs *pb.HardState) {
+	if last := lastIndex(n.storage); hs.GetCommit() > last {
+		c.fatalf("node %d asked to persist commit index %d with entries only up to %d", n.id, hs.GetCommit(), last)
+	}
+	if err := n.storage.SetHardState(hs); err != nil {
+		c.fatalf("node %d: SetHardState: %v", n.id, err)
+	}
+	n.states = append(n.states, proto.Clone(hs).(*pb.HardState))
+}
+
+func (c *cluster) apply(n *node, ents []*pb.Entry) {
+	for _, e := range ents {
+		index, term := e.GetIndex(), e.GetTerm()
+		if index != n.applied+1 {
+			c.fatalf("node %d applied entry %d right after %d", n.id, index, n.applied)
+		}
+		if !persisted(n.storage, index, term) {
+			c.fatalf("node %d applied entry %d (term %d) before persisting it", n.id, index, term)
+		}
+		if k := c.durableOn(index, term); k < c.quorum() {
+			c.fatalf("node %d applied entry %d (term %d) persisted on only %d nodes", n.id, index, term, k)
+		}
+		if prev, ok := c.applied[index]; ok && prev != term {
+			c.fatalf("node %d applied entry %d with term %d, another node applied term %d", n.id, index, term, prev)
+		}
+		c.applied[index] = term
+		n.applied = index
+		switch e.GetType() {
+		case pb.EntryConfChange:
+			var cc pb.ConfChange
+			if err := proto.Unmarshal(e.GetData(), &cc); err != nil {
+				c.fatalf("%v", err)
+			}
+			n.rn.ApplyConfChange(&cc)
+		case pb.EntryConfChangeV2:
+			var cc pb.ConfChangeV2
+			if err := proto.Unmarshal(e.GetData(), &cc); err != nil {
+				c.fatalf("%v", err)
+			}
+			n.rn.ApplyConfChange(&cc)
+		}
+	}
+}
+
+func (c *cluster) entryTerm(from *node, msgTerm, index uint64) uint64 {
+	if index > snapIndex(from.storage) {
+		if t, err := from.storage.Term(index); err == nil {
+			return t
+		}
+	}
+	return c.sent[[3]uint64{from.id, msgTerm, index}]
+}
+
+func (c *cluster) check(from *node, m *pb.Message) {
+	switch m.GetType() {
+	case pb.MsgVoteResp, pb.MsgPreVoteResp:
+		c.votes = append(c.votes, response{from: from.id, to: m.GetTo(), term: m.GetTerm(), typ: m.GetType(), reject: m.GetReject()})
+	case pb.MsgAppResp:
+		if m.GetReject() {
+			c.rejects = append(c.rejects, response{from: from.id, to: m.GetTo(), term: m.GetTerm(), reject: true})
+			return
+		}
+		index := m.GetIndex()
+		if last := lastIndex(from.storage); index > last {
+			c.fatalf("node %d acknowledged index %d to node %d with entries persisted only up to %d", from.id, index, m.GetTo(), last)
+		}
+		c.acks = append(c.acks, ack{from: from.id, to: m.GetTo(), term: m.GetTerm(), index: index})
+	case pb.MsgApp, pb.MsgHeartbeat:
+		for _, e := range m.GetEntries() {
+			c.sent[[3]uint64{from.id, m.GetTerm(), e.GetIndex()}] = e.GetTerm()
+		}
+		commit := m.GetCommit()
+		if commit <= 1 {
+			return
+		}
+		term := c.entryTerm(from, m.GetTerm(), commit)
+		if term == 0 {
+			return
+		}
+		if k := c.durableOn(commit, term); k < c.quorum() {
+			c.fatalf("node %d announced commit index %d (term %d) persisted on only %d nodes", from.id, commit, term, k)
+		}
+	}
+}
+
+func (c *cluster) send(from *node, m *pb.Message) {
+	c.outbox = append(c.outbox, m)
+	c.check(from, m)
+	c.checkRefs(from, m)
+	c.net = append(c.net, m)
+}
+
+func (c *cluster) ready(id uint64) {
+	n := c.nodes[id]
+	rd := n.rn.Ready()
+	if c.async {
+		for _, m := range rd.Messages {
+			if m.GetType() == pb.MsgStorageAppend {
+				n.handOut(m.GetSnapshot(), m.GetEntries())
+			}
+		}
+		for _, rs := range rd.ReadStates {
+			n.reads = append(n.reads, readState{index: rs.Index, handed: n.last})
+		}
+		for _, m := range rd.Messages {
+			if m.GetTo() == raft.LocalAppendThread || m.GetTo() == raft.LocalApplyThread {
+				n.local = append(n.local, m)
+			} else {
+				c.send(n, m)
+			}
+		}
+		return
+	}
+	c.checkBatch(n, rd.Entries)
+	n.handOut(rd.Snapshot, rd.Entries)
+	for _, rs := range rd.ReadStates {
+		n.reads = append(n.reads, readState{index: rs.Index, handed: n.last})
+	}
+	if !raft.IsEmptySnap(rd.Snapshot) {
+		c.persistSnapshot(n, rd.Snapshot)
+	}
+	c.persistEntries(n, rd.Entries)
+	if !raft.IsEmptyHardState(rd.HardState) {
+		c.persistHardState(n, rd.HardState)
+	}
+	for _, m := range rd.Messages {
+		c.send(n, m)
+	}
+	c.apply(n, rd.CommittedEntries)
+	n.rn.Advance(rd)
+	if c.crash[id] {
+		c.restart(id)
+	}
+}
+
+func (c *cluster) respond(n *node, m *pb.Message) {
+	if m.GetTo() != n.id {
+		c.send(n, m)
+		return
+	}
+	c.check(n, m)
+	if err := n.rn.Step(m); err != nil {
+		c.fatalf("node %d: stepping %s: %v", n.id, m.GetType(), err)
+	}
+}
+
+func (c *cluster) processLocal(id uint64) {
+	n := c.nodes[id]
+	m := n.local[0]
+	n.local = n.local[1:]
+	switch m.GetType() {
+	case pb.MsgStorageAppend:
+		c.checkBatch(n, m.GetEntries())
+		if m.GetSnapshot() != nil {
+			c.persistSnapshot(n, m.GetSnapshot())
+		}
+		c.persistEntries(n, m.GetEntries())
+		if m.Term != nil || m.Vote != nil || m.Commit != nil {
+			c.persistHardState(n, &pb.HardState{Term: m.Term, Vote: m.Vote, Commit: m.Commit})
+		}
+	case pb.MsgStorageApply:
+		c.apply(n, m.GetEntries())
+	default:
+		c.fatalf("node %d: unexpected local message %s", id, m.GetType())
+	}
+	for _, r := range m.GetResponses() {
+		c.respond(n, r)
+	}
+	if c.crash[id] && m.GetType() == pb.MsgStorageAppend {
+		c.restart(id)
+	}
+}
+
+func (c *cluster) block(a, b uint64) {
+	c.blocked[[2]uint64{a, b}] = true
+	c.blocked[[2]uint64{b, a}] = true
+}
+
+func (c *cluster) isolate(id uint64) {
+	for _, other := range c.ids {
+		if other != id {
+			c.block(id, other)
+		}
+	}
+}
+
+func (c *cluster) heal() {
+	c.blocked = map[[2]uint64]bool{}
+}
+
+func (c *cluster) deliver() bool {
+	if len(c.net) == 0 {
+		return false
+	}
+	msgs := c.net
+	c.net = nil
+	for _, m := range msgs {
+		if c.blocked[[2]uint64{m.GetFrom(), m.GetTo()}] || (c.drop != nil && c.drop(m)) {
+			if m.GetType() == pb.MsgSnap {
+				c.nodes[m.GetFrom()].rn.ReportSnapshot(m.GetTo(), raft.SnapshotFailure)
+			}
+			continue
+		}
+		n := c.nodes[m.GetTo()]
+		if n == nil {
+			continue
+		}
+		_ = n.rn.Step(m)
+		if m.GetType() == pb.MsgSnap {
+			c.nodes[m.GetFrom()].rn.ReportSnapshot(m.GetTo(), raft.SnapshotFinish)
+		}
+		if c.dup != nil && c.dup(m) {
+			_ = n.rn.Step(proto.Clone(m).(*pb.Message))
+		}
+	}
+	return true
+}
+
+func (c *cluster) work(id uint64) bool {
+	n := c.nodes[id]
+	busy := false
+	for k := 0; n.rn.HasReady(); k++ {
+		if k == 1000 {
+			c.fatalf("node %d keeps reporting a Ready", id)
+		}
+		c.ready(id)
+		busy = true
+	}
+	for len(n.local) > 0 {
+		c.processLocal(id)
+		busy = true
+		for k := 0; n.rn.HasReady(); k++ {
+			if k == 1000 {
+				c.fatalf("node %d keeps reporting a Ready", id)
+			}
+			c.ready(id)
+		}
+	}
+	return busy
+}
+
+func (c *cluster) settle() {
+	for round := 0; ; round++ {
+		if round == 2000 {
+			c.fatalf("cluster did not settle")
+		}
+		busy := false
+		for _, id := range c.ids {
+			if !c.paused[id] && c.work(id) {
+				busy = true
+			}
+		}
+		if c.deliver() {
+			busy = true
+		}
+		if !busy {
+			return
+		}
+	}
+}
+
+func (c *cluster) leader() uint64 {
+	var lead, term uint64
+	for _, id := range c.ids {
+		if st := c.nodes[id].rn.BasicStatus(); st.RaftState == raft.StateLeader && st.HardState.GetTerm() > term {
+			lead, term = id, st.HardState.GetTerm()
+		}
+	}
+	return lead
+}
+
+func (c *cluster) maxTerm() uint64 {
+	var term uint64
+	for _, id := range c.ids {
+		term = max(term, c.nodes[id].rn.BasicStatus().HardState.GetTerm())
+	}
+	return term
+}
+
+func (c *cluster) campaign(id uint64) {
+	if err := c.nodes[id].rn.Campaign(); err != nil {
+		c.fatalf("%v", err)
+	}
+	c.settle()
+	if st := c.nodes[id].rn.BasicStatus(); st.RaftState != raft.StateLeader {
+		c.fatalf("node %d did not become leader: %s", id, st.RaftState)
+	}
+}
+
+func payload(n int, tag byte) []byte {
+	return bytes.Repeat([]byte{tag}, n)
+}
+
+func (c *cluster) propose(id uint64, data []byte) {
+	if err := c.nodes[id].rn.Propose(data); err != nil {
+		c.fatalf("node %d: Propose: %v", id, err)
+	}
+}
+
+func (c *cluster) tick(id uint64) {
+	c.nodes[id].rn.Tick()
+}
+
+func (c *cluster) converge() {
+	c.heal()
+	c.paused = map[uint64]bool{}
+	c.crash = map[uint64]bool{}
+	c.settle()
+	next, proposed := 0, false
+	for round := 0; ; round++ {
+		if round == 200 {
+			c.fatalf("cluster did not converge: %s", c.describe())
+		}
+		lead := c.leader()
+		if lead == 0 || c.nodes[lead].rn.BasicStatus().HardState.GetTerm() < c.maxTerm() {
+			id := c.ids[next%len(c.ids)]
+			next++
+			if id != lead {
+				_ = c.nodes[id].rn.Campaign()
+			}
+			c.settle()
+			continue
+		}
+		if !proposed {
+			proposed = c.nodes[lead].rn.Propose([]byte("barrier")) == nil
+			c.settle()
+		}
+		if proposed && c.caughtUp(lead) {
+			break
+		}
+		c.tick(lead)
+		c.settle()
+	}
+	c.checkLogsMatch()
+}
+
+func (c *cluster) caughtUp(lead uint64) bool {
+	want := lastIndex(c.nodes[lead].storage)
+	for _, id := range c.ids {
+		n := c.nodes[id]
+		if lastIndex(n.storage) != want || n.applied != want {
+			return false
+		}
+	}
+	return true
+}
+
+func (c *cluster) describe() string {
+	var buf bytes.Buffer
+	for _, id := range c.ids {
+		n := c.nodes[id]
+		st := n.rn.BasicStatus()
+		fmt.Fprintf(&buf, "[node %d %s term %d commit %d applied %d persisted %d] ", id, st.RaftState, st.HardState.GetTerm(), st.HardState.GetCommit(), n.applied, lastIndex(n.storage))
+	}
+	return buf.String()
+}
+
+func (c *cluster) checkLogsMatch() {
+	ref := c.nodes[c.ids[0]].storage
+	for _, id := range c.ids[1:] {
+		st := c.nodes[id].storage
+		lo := max(snapIndex(ref), snapIndex(st)) + 1
+		hi := lastIndex(ref)
+		if lastIndex(st) != hi {
+			c.fatalf("node %d persisted up to %d, node %d up to %d", c.ids[0], hi, id, lastIndex(st))
+		}
+		for i := lo; i <= hi; i++ {
+			a, _ := ref.Term(i)
+			b, _ := st.Term(i)
+			if a != b {
+				c.fatalf("entry %d has term %d on node %d and term %d on node %d", i, a, c.ids[0], b, id)
+			}
+		}
+	}
+}
+
+func (c *cluster) compact(id uint64) {
+	n := c.nodes[id]
+	if n.applied <= snapIndex(n.storage) {
+		return
+	}
+	if _, err := n.storage.CreateSnapshot(n.applied, &pb.ConfState{Voters: slices.Clone(c.ids)}, nil); err != nil {
+		c.fatalf("%v", err)
+	}
+	if err := n.storage.Compact(n.applied); err != nil {
+		c.fatalf("%v", err)
+	}
+}
+
+func (c *cluster) handedOut(id uint64) []*pb.Entry {
+	var ents []*pb.Entry
+	for _, page := range c.nodes[id].pages {
+		ents = append(ents, page...)
+	}
+	return ents
+}
+
+func greedyPages(ents []*pb.Entry, limit uint64) [][]uint64 {
+	var pages [][]uint64
+	for len(ents) > 0 {
+		n, size := 1, uint64(proto.Size(ents[0]))
+		for n < len(ents) && size+uint64(proto.Size(ents[n])) <= limit {
+			size += uint64(proto.Size(ents[n]))
+			n++
+		}
+		var page []uint64
+		for _, e := range ents[:n] {
+			page = append(page, e.GetIndex())
+		}
+		pages = append(pages, page)
+		ents = ents[n:]
+	}
+	return pages
+}
+
+func pageIndexes(pages [][]*pb.Entry) [][]uint64 {
+	var out [][]uint64
+	for _, page := range pages {
+		var idx []uint64
+		for _, e := range page {
+			idx = append(idx, e.GetIndex())
+		}
+		out = append(out, idx)
+	}
+	return out
+}
+
+func randomOps(t *testing.T, async bool, seed int64) {
+	defer func() {
+		if r := recover(); r != nil {
+			panic(fmt.Sprintf("seed %d: %v", seed, r))
+		}
+	}()
+	rng := rand.New(rand.NewSource(seed))
+	ids := []uint64{1, 2, 3}
+	if rng.Intn(3) == 0 {
+		ids = []uint64{1, 2, 3, 4, 5}
+	}
+	limits := map[uint64]uint64{}
+	for _, id := range ids {
+		limits[id] = []uint64{0, 60, 150, 400}[rng.Intn(4)]
+	}
+	c := newCluster(t, async, limits, ids...)
+	c.label = fmt.Sprintf("seed %d: ", seed)
+	c.campaign(ids[rng.Intn(len(ids))])
+	for step := 0; step < 60; step++ {
+		id := ids[rng.Intn(len(ids))]
+		n := c.nodes[id]
+		switch op := rng.Intn(20); {
+		case op < 6:
+			if lead := c.leader(); lead != 0 {
+				for k := rng.Intn(5) + 1; k > 0; k-- {
+					_ = c.nodes[lead].rn.Propose(payload(rng.Intn(240)+1, byte('a'+step%26)))
+				}
+			}
+		case op < 10:
+			if n.rn.HasReady() {
+				c.ready(id)
+			}
+		case op < 12:
+			if len(n.local) > 0 {
+				c.processLocal(id)
+			}
+		case op < 14:
+			c.deliver()
+		case op < 15:
+			c.isolate(id)
+		case op < 16:
+			c.heal()
+		case op < 17:
+			_ = n.rn.Campaign()
+		case op < 18:
+			c.restart(id)
+		case op < 19:
+			c.compact(id)
+		default:
+			if lead := c.leader(); lead != 0 {
+				c.tick(lead)
+			}
+		}
+	}
+	c.converge()
+}
diff --git a/appendlimit_a366de/node_a366de_test.go b/appendlimit_a366de/node_a366de_test.go
new file mode 100644
index 0000000..4476c92
--- /dev/null
+++ b/appendlimit_a366de/node_a366de_test.go
@@ -0,0 +1,355 @@
+package appendlimit
+
+import (
+	"context"
+	"slices"
+	"testing"
+	"time"
+
+	"google.golang.org/protobuf/proto"
+
+	"go.etcd.io/raft/v3"
+	pb "go.etcd.io/raft/v3/raftpb"
+)
+
+type nodeRun struct {
+	t       *testing.T
+	async   bool
+	limit   uint64
+	n       raft.Node
+	st      *raft.MemoryStorage
+	state   raft.StateType
+	term    uint64
+	pages   [][]*pb.Entry
+	ever    map[[2]uint64]bool
+	last    uint64
+	applied uint64
+}
+
+func startNode(t *testing.T, async bool, limit uint64) *nodeRun {
+	st := raft.NewMemoryStorage()
+	snap := &pb.Snapshot{Metadata: &pb.SnapshotMetadata{
+		Index:     proto.Uint64(1),
+		Term:      proto.Uint64(1),
+		ConfState: &pb.ConfState{Voters: []uint64{1, 2, 3}},
+	}}
+	if err := st.ApplySnapshot(snap); err != nil {
+		t.Fatal(err)
+	}
+	if err := st.SetHardState(&pb.HardState{Term: proto.Uint64(1), Commit: proto.Uint64(1)}); err != nil {
+		t.Fatal(err)
+	}
+	n := raft.RestartNode(&raft.Config{
+		ID:                    1,
+		ElectionTick:          10,
+		HeartbeatTick:         1,
+		Storage:               st,
+		Applied:               1,
+		MaxSizePerMsg:         1 << 20,
+		MaxInflightMsgs:       256,
+		MaxAppendSizePerReady: limit,
+		AsyncStorageWrites:    async,
+		Logger:                discard,
+	})
+	t.Cleanup(n.Stop)
+	return &nodeRun{t: t, async: async, limit: limit, n: n, st: st, term: 1, ever: map[[2]uint64]bool{}, last: 1, applied: 1}
+}
+
+func (r *nodeRun) ctx() context.Context {
+	ctx, cancel := context.WithTimeout(r.t.Context(), 10*time.Second)
+	r.t.Cleanup(cancel)
+	return ctx
+}
+
+func (r *nodeRun) step(m *pb.Message) {
+	if err := r.n.Step(r.ctx(), m); err != nil {
+		r.t.Fatalf("stepping %s: %v", m.GetType(), err)
+	}
+}
+
+func (r *nodeRun) propose(data []byte) {
+	if err := r.n.Propose(r.ctx(), data); err != nil {
+		r.t.Fatalf("Propose: %v", err)
+	}
+}
+
+func (r *nodeRun) next() raft.Ready {
+	select {
+	case rd := <-r.n.Ready():
+		return rd
+	case <-time.After(10 * time.Second):
+		r.t.Fatalf("no Ready arrived: state %s, entries handed out up to %d, applied %d", r.state, r.last, r.applied)
+	}
+	return raft.Ready{}
+}
+
+func (r *nodeRun) handedOut(index, term uint64) bool {
+	return index <= 1 || r.ever[[2]uint64{index, term}]
+}
+
+func (r *nodeRun) handOut(ents []*pb.Entry) {
+	if len(ents) == 0 {
+		return
+	}
+	for i := 1; i < len(ents); i++ {
+		if ents[i].GetIndex() != ents[i-1].GetIndex()+1 {
+			r.t.Fatalf("handed out entries %d and %d next to each other", ents[i-1].GetIndex(), ents[i].GetIndex())
+		}
+	}
+	if r.limit != 0 && len(ents) > 1 && entsSize(ents) > r.limit {
+		r.t.Fatalf("handed out %d entries of %d bytes in one batch, limit %d", len(ents), entsSize(ents), r.limit)
+	}
+	if err := r.st.Append(ents); err != nil {
+		r.t.Fatalf("Append: %v", err)
+	}
+	for _, e := range ents {
+		r.ever[[2]uint64{e.GetIndex(), e.GetTerm()}] = true
+	}
+	r.pages = append(r.pages, ents)
+	r.last = ents[len(ents)-1].GetIndex()
+}
+
+func (r *nodeRun) setHardState(hs *pb.HardState) {
+	if hs.GetCommit() > r.last {
+		r.t.Fatalf("handed out commit index %d with entries handed out only up to %d", hs.GetCommit(), r.last)
+	}
+	if err := r.st.SetHardState(hs); err != nil {
+		r.t.Fatalf("SetHardState: %v", err)
+	}
+	r.term = hs.GetTerm()
+}
+
+func (r *nodeRun) apply(ents []*pb.Entry) {
+	for _, e := range ents {
+		if e.GetIndex() > r.last || !r.handedOut(e.GetIndex(), e.GetTerm()) {
+			r.t.Fatalf("applied entry %d of term %d with entries handed out only up to %d", e.GetIndex(), e.GetTerm(), r.last)
+		}
+		if e.GetType() == pb.EntryConfChange {
+			var cc pb.ConfChange
+			if err := proto.Unmarshal(e.GetData(), &cc); err != nil {
+				r.t.Fatal(err)
+			}
+			r.n.ApplyConfChange(&cc)
+		}
+		r.applied = e.GetIndex()
+	}
+}
+
+func (r *nodeRun) checkSent(m *pb.Message) {
+	switch m.GetType() {
+	case pb.MsgApp:
+		if !r.handedOut(m.GetIndex(), m.GetLogTerm()) {
+			r.t.Fatalf("sent MsgApp to node %d after entry %d of term %d, which it never handed out", m.GetTo(), m.GetIndex(), m.GetLogTerm())
+		}
+		for _, e := range m.GetEntries() {
+			if !r.handedOut(e.GetIndex(), e.GetTerm()) {
+				r.t.Fatalf("sent MsgApp to node %d carrying entry %d of term %d, which it never handed out", m.GetTo(), e.GetIndex(), e.GetTerm())
+			}
+		}
+		if m.GetCommit() > r.last {
+			r.t.Fatalf("sent MsgApp to node %d with commit index %d and entries handed out only up to %d", m.GetTo(), m.GetCommit(), r.last)
+		}
+	case pb.MsgVote, pb.MsgPreVote:
+		if !r.handedOut(m.GetIndex(), m.GetLogTerm()) {
+			r.t.Fatalf("sent %s naming entry %d of term %d, which it never handed out", m.GetType(), m.GetIndex(), m.GetLogTerm())
+		}
+	case pb.MsgHeartbeat:
+		if m.GetCommit() > r.last {
+			r.t.Fatalf("sent MsgHeartbeat with commit index %d and entries handed out only up to %d", m.GetCommit(), r.last)
+		}
+	}
+}
+
+func (r *nodeRun) handle(rd raft.Ready) []*pb.Message {
+	if rd.SoftState != nil {
+		r.state = rd.SoftState.RaftState
+	}
+	var sent []*pb.Message
+	if !r.async {
+		r.handOut(rd.Entries)
+		if !raft.IsEmptyHardState(rd.HardState) {
+			r.setHardState(rd.HardState)
+		}
+		for _, m := range rd.Messages {
+			r.checkSent(m)
+			sent = append(sent, m)
+		}
+		r.apply(rd.CommittedEntries)
+		r.n.Advance()
+		return sent
+	}
+	var local []*pb.Message
+	for _, m := range rd.Messages {
+		if m.GetTo() == raft.LocalAppendThread || m.GetTo() == raft.LocalApplyThread {
+			local = append(local, m)
+			if m.GetType() == pb.MsgStorageAppend {
+				r.handOut(m.GetEntries())
+			}
+		}
+	}
+	for _, m := range rd.Messages {
+		if m.GetTo() != raft.LocalAppendThread && m.GetTo() != raft.LocalApplyThread {
+			r.checkSent(m)
+			sent = append(sent, m)
+		}
+	}
+	for _, m := range local {
+		switch m.GetType() {
+		case pb.MsgStorageAppend:
+			if m.Term != nil || m.Vote != nil || m.Commit != nil {
+				r.setHardState(&pb.HardState{Term: m.Term, Vote: m.Vote, Commit: m.Commit})
+			}
+		case pb.MsgStorageApply:
+			r.apply(m.GetEntries())
+		}
+		for _, resp := range m.GetResponses() {
+			if resp.GetTo() == 1 || raft.IsLocalMsgTarget(resp.GetFrom()) {
+				r.step(resp)
+				continue
+			}
+			r.checkSent(resp)
+			sent = append(sent, resp)
+		}
+	}
+	return sent
+}
+
+func (r *nodeRun) answer(sent []*pb.Message) {
+	for _, m := range sent {
+		switch m.GetType() {
+		case pb.MsgVote:
+			r.step(&pb.Message{Type: pb.MsgVoteResp.Enum(), From: proto.Uint64(m.GetTo()), To: proto.Uint64(1), Term: proto.Uint64(m.GetTerm())})
+		case pb.MsgApp:
+			index := m.GetIndex() + uint64(len(m.GetEntries()))
+			r.step(&pb.Message{Type: pb.MsgAppResp.Enum(), From: proto.Uint64(m.GetTo()), To: proto.Uint64(1), Term: proto.Uint64(m.GetTerm()), Index: proto.Uint64(index)})
+		}
+	}
+}
+
+func (r *nodeRun) drive(done func() bool, peersAnswer bool) {
+	for k := 0; !done(); k++ {
+		if k == 200 {
+			r.t.Fatalf("node did not get there: state %s, entries handed out up to %d, applied %d", r.state, r.last, r.applied)
+		}
+		sent := r.handle(r.next())
+		if peersAnswer {
+			r.answer(sent)
+		}
+	}
+}
+
+func (r *nodeRun) elect() {
+	if err := r.n.Campaign(r.ctx()); err != nil {
+		r.t.Fatalf("Campaign: %v", err)
+	}
+	r.drive(func() bool { return r.state == raft.StateLeader && r.last > 1 && r.applied == r.last }, true)
+}
+
+func testNodeHandsOutTheLongestRunThatFits(t *testing.T, async bool) {
+	run(t, func() {
+		r := startNode(t, async, 270)
+		r.elect()
+		before, last := len(r.pages), r.last+4
+		var want [][]byte
+		for i := 0; i < 4; i++ {
+			want = append(want, payload(100, byte('a'+i)))
+			r.propose(want[i])
+		}
+		r.drive(func() bool { return r.applied >= last }, true)
+		pages := r.pages[before:]
+		if len(pages) != 2 {
+			t.Fatalf("Node.Ready handed out the 4 proposals in batches %v, want two batches of two", pageIndexes(pages))
+		}
+		requirePages(t, pages, want, 270)
+	})
+}
+
+func TestNodeHandsOutTheLongestRunThatFits(t *testing.T) {
+	testNodeHandsOutTheLongestRunThatFits(t, false)
+}
+
+func TestAsyncNodeHandsOutTheLongestRunThatFits(t *testing.T) {
+	testNodeHandsOutTheLongestRunThatFits(t, true)
+}
+
+func testNodeNeverSendsEntriesItDidNotHandOut(t *testing.T, async bool) {
+	run(t, func() {
+		r := startNode(t, async, 270)
+		r.elect()
+		base, term := r.last, r.term
+		for i := 0; i < 4; i++ {
+			r.propose(payload(100, byte('a'+i)))
+		}
+		r.drive(func() bool { return r.last >= base+2 }, true)
+		if r.last >= base+4 {
+			t.Fatalf("Node.Ready handed out the whole backlog (up to %d) in one batch", r.last)
+		}
+		ents := []*pb.Entry{
+			{Term: proto.Uint64(term + 1), Index: proto.Uint64(base + 3)},
+			{Term: proto.Uint64(term + 1), Index: proto.Uint64(base + 4), Data: payload(100, 'x')},
+			{Term: proto.Uint64(term + 1), Index: proto.Uint64(base + 5), Data: payload(100, 'y')},
+		}
+		r.step(&pb.Message{
+			Type:    pb.MsgApp.Enum(),
+			From:    proto.Uint64(2),
+			To:      proto.Uint64(1),
+			Term:    proto.Uint64(term + 1),
+			Index:   proto.Uint64(base + 2),
+			LogTerm: proto.Uint64(term),
+			Entries: ents,
+			Commit:  proto.Uint64(base + 2),
+		})
+		r.drive(func() bool { return r.state == raft.StateFollower && r.last >= base+5 }, false)
+		if !r.handedOut(base+5, term+1) {
+			t.Fatalf("node 1 did not hand out the new leader's entry %d of term %d", base+5, term+1)
+		}
+	})
+}
+
+func TestNodeNeverSendsEntriesItDidNotHandOut(t *testing.T) {
+	testNodeNeverSendsEntriesItDidNotHandOut(t, false)
+}
+
+func TestAsyncNodeNeverSendsEntriesItDidNotHandOut(t *testing.T) {
+	testNodeNeverSendsEntriesItDidNotHandOut(t, true)
+}
+
+func testStartNodeHandsOutItsBootstrapEntriesInBatches(t *testing.T, async bool) {
+	run(t, func() {
+		boot := func(limit uint64) [][]*pb.Entry {
+			st := raft.NewMemoryStorage()
+			n := raft.StartNode(&raft.Config{
+				ID:                    1,
+				ElectionTick:          10,
+				HeartbeatTick:         1,
+				Storage:               st,
+				MaxSizePerMsg:         1 << 20,
+				MaxInflightMsgs:       256,
+				MaxAppendSizePerReady: limit,
+				AsyncStorageWrites:    async,
+				Logger:                discard,
+			}, []raft.Peer{{ID: 1}, {ID: 2}, {ID: 3}, {ID: 4}, {ID: 5}})
+			t.Cleanup(n.Stop)
+			r := &nodeRun{t: t, async: async, limit: limit, n: n, st: st, ever: map[[2]uint64]bool{}}
+			r.drive(func() bool { return r.applied >= 5 }, false)
+			return r.pages
+		}
+		pages := boot(0)
+		if len(pages) != 1 || len(pages[0]) != 5 {
+			t.Fatalf("without a limit Node.Ready handed out the bootstrap entries in batches %v", pageIndexes(pages))
+		}
+		limit := uint64(proto.Size(pages[0][0]) + proto.Size(pages[0][1]))
+		pages = boot(limit)
+		if g, w := pageIndexes(pages), [][]uint64{{1, 2}, {3, 4}, {5}}; !slices.EqualFunc(g, w, slices.Equal) {
+			t.Fatalf("Node.Ready handed out the bootstrap entries in batches %v, want %v", g, w)
+		}
+	})
+}
+
+func TestStartNodeHandsOutItsBootstrapEntriesInBatches(t *testing.T) {
+	testStartNodeHandsOutItsBootstrapEntriesInBatches(t, false)
+}
+
+func TestAsyncStartNodeHandsOutItsBootstrapEntriesInBatches(t *testing.T) {
+	testStartNodeHandsOutItsBootstrapEntriesInBatches(t, true)
+}
diff --git a/test.sh b/test.sh
