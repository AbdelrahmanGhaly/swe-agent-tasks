+func TestReadyHandsOutTheLongestRunOfEntriesThatFits(t *testing.T) {
+	run(t, func() {
+		c := newCluster(t, false, map[uint64]uint64{1: 160}, 1)
+		c.campaign(1)
+		before := len(c.nodes[1].pages)
+		want := proposeSizes(c, 1, []int{40, 90, 10, 150, 60, 60, 60, 5, 200, 30})
+		c.settle()
+		pages := c.nodes[1].pages[before:]
+		if len(pages) < 5 {
+			t.Fatalf("handed out the proposals in %d batches", len(pages))
+		}
+		requirePages(t, pages, want, 160)
+		if c.nodes[1].applied != lastIndex(c.nodes[1].storage) {
+			t.Fatalf("applied %d of %d entries", c.nodes[1].applied, lastIndex(c.nodes[1].storage))
+		}
+	})
+}
