+func testLeaderRestartsFromStorageInTheMiddleOfItsBacklog(t *testing.T, async bool) {
+	run(t, func() {
+		sizes := []int{100, 100, 100, 100, 100, 100, 100, 100, 100, 100}
+		for crashAfter := 1; crashAfter <= 4; crashAfter++ {
+			c := newCluster(t, async, map[uint64]uint64{1: 250}, 1, 2, 3)
+			c.label = fmt.Sprintf("crash after batch %d: ", crashAfter)
+			c.campaign(1)
+			proposeSizes(c, 1, sizes)
+			for batch := 1; batch <= crashAfter; batch++ {
+				c.ready(1)
+				for len(c.nodes[1].local) > 0 {
+					c.processLocal(1)
+				}
+				if batch == 1 {
+					c.paused[1] = true
+					c.settle()
+					c.paused[1] = false
+				}
+			}
+			n := c.nodes[1]
+			persisted := lastIndex(n.storage)
+			if persisted >= 12 {
+				c.fatalf("leader persisted its whole backlog (up to %d) before restarting", persisted)
+			}
+			c.restart(1)
+			st := n.rn.BasicStatus()
+			if commit := st.HardState.GetCommit(); commit > persisted || n.applied > commit {
+				c.fatalf("restarted leader has commit index %d, applied %d and entries up to %d", commit, n.applied, persisted)
+			}
+			c.converge()
+		}
+	})
+}
