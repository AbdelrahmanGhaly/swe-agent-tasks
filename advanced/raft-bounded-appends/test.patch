+func backlogOnFollower(t *testing.T, async bool, follower uint64, limits map[uint64]uint64) *cluster {
+	c := newCluster(t, async, limits, 1, 2, 3)
+	c.campaign(1)
+	c.block(1, follower)
+	proposeSizes(c, 1, []int{100, 100, 100, 100, 100, 100})
+	c.settle()
+	c.heal()
+	c.tick(1)
+	return c
+}
+
+func requireCaughtUp(t *testing.T, c *cluster, lead, id uint64) {
+	t.Helper()
+	last := lastIndex(c.nodes[lead].storage)
+	if got := c.nodes[lead].rn.Status().Progress[id].Match; got != last {
+		t.Fatalf("leader %d has node %d matched at %d, want %d", lead, id, got, last)
+	}
+	if n := c.nodes[id]; n.applied != last || lastIndex(n.storage) != last {
+		t.Fatalf("node %d persisted %d and applied %d, want %d", id, lastIndex(n.storage), n.applied, last)
+	}
+}
