+func testAppendRejectionDoesNotWaitForTheBacklog(t *testing.T, async bool) {
+	run(t, func() {
+		c := newCluster(t, async, map[uint64]uint64{2: 250}, 1, 2, 3)
+		c.campaign(1)
+		c.paused[2] = true
+		proposeSizes(c, 1, []int{100, 100, 100, 100, 100, 100})
+		c.settle()
+		c.block(1, 2)
+		proposeSizes(c, 1, []int{100, 100})
+		c.settle()
+		c.heal()
+		proposeSizes(c, 1, []int{100})
+		c.settle()
+		c.ready(2)
+		for len(c.nodes[2].local) > 0 {
+			c.processLocal(2)
+		}
+		if last := c.nodes[2].last; last >= 8 {
+			t.Fatalf("node 2 handed out its whole backlog (up to %d) in one batch", last)
+		}
+		rejected := false
+		for _, r := range c.rejects {
+			if r.from == 2 && r.to == 1 {
+				rejected = true
+			}
+		}
+		if !rejected {
+			t.Fatalf("node 2 did not reject the append that skipped its missing entries with its next batch, entries handed out only up to %d", c.nodes[2].last)
+		}
+		c.paused[2] = false
+		c.settle()
+		for round := 0; c.nodes[1].rn.Status().Progress[2].Match != lastIndex(c.nodes[1].storage); round++ {
