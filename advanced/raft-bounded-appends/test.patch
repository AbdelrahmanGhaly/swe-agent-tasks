+func testAcknowledgementOfReplacedEntriesIsNeverSent(t *testing.T, async bool) {
+	run(t, func() {
+		c := newCluster(t, async, map[uint64]uint64{2: 250}, 1, 2, 3, 4, 5)
+		c.campaign(1)
+		for _, id := range []uint64{3, 4, 5} {
+			c.block(1, id)
+		}
+		proposeSizes(c, 1, []int{100, 100, 100, 100, 100, 100})
+		c.paused[2] = true
+		c.settle()
+		n := c.nodes[2]
+		c.ready(2)
+		for len(n.local) > 0 {
+			c.processLocal(2)
+		}
+		kept := lastIndex(n.storage)
+		c.isolate(1)
+		if err := c.nodes[3].rn.Campaign(); err != nil {
+			t.Fatal(err)
+		}
+		c.settle()
+		if st := c.nodes[3].rn.BasicStatus(); st.RaftState != raft.StateLeader {
+			t.Fatalf("node 3 did not become leader: %s", c.describe())
+		}
+		c.paused[2] = false
+		c.settle()
+		proposeSizes(c, 3, []int{100, 100, 100, 100, 100, 100, 100, 100})
+		c.settle()
+		for _, a := range c.acks {
+			if a.from == 2 && a.to == 1 && a.index > kept {
+				t.Fatalf("node 2 acknowledged index %d to node 1 in term %d after node 3 replaced its entries past %d", a.index, a.term, kept)
+			}
+		}
+		requireCaughtUp(t, c, 3, 2)
+		c.converge()
+	})
+}
