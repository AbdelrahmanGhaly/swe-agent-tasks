+func TestEntriesThatExactlyFillTheLimitShareABatch(t *testing.T) {
+	run(t, func() {
+		sizes := []int{30, 50, 70, 10}
+		probe := newCluster(t, false, nil, 1)
+		probe.campaign(1)
+		before := len(probe.handedOut(1))
+		proposeSizes(probe, 1, sizes)
+		probe.settle()
+		ents := probe.handedOut(1)[before:]
+		limit := uint64(proto.Size(ents[0]) + proto.Size(ents[1]) + proto.Size(ents[2]))
+
+		c := newCluster(t, false, map[uint64]uint64{1: limit}, 1)
+		c.campaign(1)
+		first := len(c.nodes[1].pages)
+		want := proposeSizes(c, 1, sizes)
+		c.settle()
+		pages := c.nodes[1].pages[first:]
+		if len(pages) != 2 || len(pages[0]) != 3 {
+			t.Fatalf("batches %v with limit %d, want the first three entries together", pageIndexes(pages), limit)
+		}
+		requirePages(t, pages, want, limit)
+	})
+}
