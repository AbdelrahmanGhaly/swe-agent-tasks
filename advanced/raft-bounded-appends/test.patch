+func testFollowerRestartsFromStorageAfterAnyReady(t *testing.T, async bool) {
+	run(t, func() {
+		c := backlogOnFollower(t, async, 2, map[uint64]uint64{1: 250, 2: 250, 3: 250})
+		c.crash[2] = true
+		for round := 0; ; round++ {
+			if round == 100 {
+				t.Fatalf("node 2 did not catch up: %s", c.describe())
+			}
+			c.settle()
+			if n := c.nodes[2]; lastIndex(n.storage) == lastIndex(c.nodes[1].storage) && n.applied == lastIndex(n.storage) {
+				break
+			}
+			c.tick(1)
+		}
+		c.converge()
+	})
+}
