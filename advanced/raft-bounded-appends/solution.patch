+// replaced returns true if the log no longer holds the given entry. Compacted
+// entries are not considered replaced, since their terms are no longer known:
+// the messages naming an entry that a snapshot supersedes are dropped when the
+// snapshot is restored, see supersededBySnapshot.
+func (l *raftLog) replaced(id entryID) bool {
+	t, err := l.term(id.index)
+	if err == ErrCompacted {
+		return false
+	}
+	return err != nil || t != id.term
+}
+
+// supersededBySnapshot returns true if restoring a snapshot at the given index
+// compacts the given entry while it is replaced, or while it is neither handed
+// out for appending to storage nor committed. Committed entries are part of
+// the snapshot. The restore loses the terms of the compacted entries, so this
+// has to be checked before it.
+func (l *raftLog) supersededBySnapshot(id entryID, index uint64) bool {
+	if id.index >= index {
+		return false
+	}
+	return l.replaced(id) || (id.index >= l.unstable.offsetInProgress && id.index > l.committed)
+}
+
+// limitsAppends returns true if MaxAppendSizePerReady limits the entries handed
+// out for appending to storage.
+func (l *raftLog) limitsAppends() bool { return l.unstable.maxNextEntsSize != 0 }
+
+// lastAppendingIndex returns the index of the last log entry that is in stable
+// storage, is being written to it, or is returned by nextUnstableEnts.
+func (l *raftLog) lastAppendingIndex() uint64 {
+	if ents := l.nextUnstableEnts(); len(ents) > 0 {
+		return ents[len(ents)-1].GetIndex()
+	}
+	return l.unstable.offsetInProgress - 1
+}
