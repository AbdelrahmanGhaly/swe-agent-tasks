+// readyHardState returns the HardState to hand out with the next Ready. Its
+// commit index does not exceed the log entries handed out for appending to
+// storage, so that the node can restart from what the application persisted.
+func (r *raft) readyHardState() *pb.HardState {
+	hs := r.hardState()
+	hs.Commit = new(min(r.raftLog.committed, r.raftLog.lastAppendingIndex()))
+	return hs
+}
+
+// afterAppendMsgs splits the messages waiting for the unstable state to be
+// persisted into those that can be released once the log entries up to index
+// are persisted, and the append acknowledgements that cover later entries and
+// have to keep waiting. An acknowledgement is dropped once the term has moved
+// on, since a newer leader may have replaced the entries it acknowledges. Vote
+// responses and append rejections are released right away.
+func (r *raft) afterAppendMsgs(index uint64) (release, wait []*pb.Message) {
+	for _, msgs := range [][]*pb.Message{r.msgsAwaitingAppend, r.msgsAfterAppend} {
+		for _, m := range msgs {
+			if m.GetType() == pb.MsgAppResp && !m.GetReject() {
+				if m.GetTerm() < r.Term {
+					continue
+				}
+				if m.GetIndex() > index {
+					wait = append(wait, m)
+					continue
+				}
+			}
+			release = append(release, m)
+		}
+	}
+	return release, wait
+}
+
+// readyMsgs splits the messages to be sent into those that only refer to log
+// entries up to index, and those that refer to later entries and have to wait.
+// A message naming an entry that has since been replaced is dropped, since the
+// entry it depends on will never be handed out.
+func (r *raft) readyMsgs(index uint64) (release, wait []*pb.Message) {
+	for _, msgs := range [][]*pb.Message{r.msgsAwaitingEntries, r.msgs} {
+		for _, m := range msgs {
+			last, id := msgLogDependency(m)
+			if id.index != 0 && r.raftLog.replaced(id) {
+				continue
+			}
+			if last > index {
+				wait = append(wait, m)
+				continue
+			}
+			release = append(release, m)
+		}
+	}
+	return release, wait
+}
+
+// msgsNotSupersededBy returns the given messages without those naming a log
+// entry that restoring a snapshot at the given index supersedes. Such a message
+// can never be sent, and the restore loses the term readyMsgs would need to
+// tell.
+func (r *raft) msgsNotSupersededBy(msgs []*pb.Message, index uint64) []*pb.Message {
+	var kept []*pb.Message
+	for _, m := range msgs {
+		if _, id := msgLogDependency(m); id.index == 0 || !r.raftLog.supersededBySnapshot(id, index) {
+			kept = append(kept, m)
+		}
+	}
+	return kept
+}
+
+// msgLogDependency returns the highest log index a message refers to, and the
+// last entry it carries or names, if any.
+func msgLogDependency(m *pb.Message) (uint64, entryID) {
+	switch m.GetType() {
+	case pb.MsgApp:
+		id := entryID{term: m.GetLogTerm(), index: m.GetIndex()}
+		if ents := m.GetEntries(); len(ents) > 0 {
+			id = entryID{term: ents[len(ents)-1].GetTerm(), index: ents[len(ents)-1].GetIndex()}
+		}
+		return max(id.index, m.GetCommit()), id
+	case pb.MsgVote, pb.MsgPreVote:
+		return m.GetIndex(), entryID{term: m.GetLogTerm(), index: m.GetIndex()}
+	case pb.MsgHeartbeat:
+		return m.GetCommit(), entryID{}
+	case pb.MsgReadIndexResp:
+		return m.GetIndex(), entryID{}
+	}
+	return 0, entryID{}
+}
+
+// readyReadStates splits the read states into those that only refer to log
+// entries up to index, and those that refer to later entries and have to wait
+// for them to be handed out. Without MaxAppendSizePerReady, read states are
+// returned as soon as they are known, as before.
+func (r *raft) readyReadStates(index uint64) (release, wait []ReadState) {
+	for _, rs := range r.readStates {
+		if r.raftLog.limitsAppends() && rs.Index > index {
+			wait = append(wait, rs)
+			continue
+		}
+		release = append(release, rs)
+	}
+	return release, wait
+}
