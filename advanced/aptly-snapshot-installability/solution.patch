diff --git a/deb/installability.go b/deb/installability.go
new file mode 100644
index 00000000..9e9910a9
--- /dev/null
+++ b/deb/installability.go
@@ -0,0 +1,738 @@
+package deb
+
+import (
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+
+	"github.com/aptly-dev/aptly/aptly"
+	"github.com/aptly-dev/aptly/utils"
+)
+
+// Multi-Arch field values
+const (
+	multiArchNo      = "no"
+	multiArchSame    = "same"
+	multiArchForeign = "foreign"
+	multiArchAllowed = "allowed"
+)
+
+var relationRegexp = regexp.MustCompile(`^([^\s:(]+)(?::([^\s(]+))?\s*(?:\(\s*(<<|<=|>=|>>|=|<|>)\s*([^\s)]+)\s*\))?$`)
+
+type relationAtom struct {
+	name     string
+	archQual string
+	relation int
+	version  string
+}
+
+type providedName struct {
+	node    int
+	version string
+}
+
+type installableNode struct {
+	pkg       *Package
+	arch      string
+	multiArch string
+	depends   [][]int
+}
+
+// installabilityChecker answers installability queries with a SAT solver (unit propagation,
+// conflict-driven clause learning and backjumping): a variable per package, a clause per
+// dependency group, conflicting pair and Essential package name
+type installabilityChecker struct {
+	native        string
+	archs         []string
+	nodes         []installableNode
+	byName        map[string][]int
+	providers     map[string][]providedName
+	essential     [][]int
+	clauses       [][]int
+	watches       [][]int
+	value         []int8
+	level         []int
+	reason        []int
+	seen          []bool
+	trail         []int
+	trailLim      []int
+	cursorLim     []int
+	cursor        int
+	qhead         int
+	installable   []bool
+	contradiction bool
+}
+
+func parseRelationAtom(s string) (relationAtom, error) {
+	m := relationRegexp.FindStringSubmatch(strings.TrimSpace(s))
+	if m == nil {
+		return relationAtom{}, fmt.Errorf("unable to parse relation: %s", s)
+	}
+
+	atom := relationAtom{name: m[1], archQual: m[2], version: m[4]}
+	switch m[3] {
+	case "":
+		atom.relation = VersionDontCare
+	case "<<":
+		atom.relation = VersionLess
+	case "<=", "<":
+		atom.relation = VersionLessOrEqual
+	case "=":
+		atom.relation = VersionEqual
+	case ">=", ">":
+		atom.relation = VersionGreaterOrEqual
+	case ">>":
+		atom.relation = VersionGreater
+	}
+	return atom, nil
+}
+
+func parseRelationField(value string) ([][]relationAtom, error) {
+	var groups [][]relationAtom
+	for _, group := range strings.Split(value, ",") {
+		if strings.TrimSpace(group) == "" {
+			continue
+		}
+		var alternatives []relationAtom
+		for _, alternative := range strings.Split(group, "|") {
+			atom, err := parseRelationAtom(alternative)
+			if err != nil {
+				return nil, err
+			}
+			alternatives = append(alternatives, atom)
+		}
+		groups = append(groups, alternatives)
+	}
+	return groups, nil
+}
+
+func packageMultiArch(p *Package) string {
+	switch strings.ToLower(strings.TrimSpace(p.GetField("Multi-Arch"))) {
+	case multiArchSame:
+		return multiArchSame
+	case multiArchForeign:
+		return multiArchForeign
+	case multiArchAllowed:
+		return multiArchAllowed
+	}
+	return multiArchNo
+}
+
+func positive(node int) int { return 2 * node }
+
+func negative(node int) int { return 2*node + 1 }
+
+func newInstallabilityChecker(native string, foreign []string, archive *PackageList) (*installabilityChecker, error) {
+	c := &installabilityChecker{
+		native:    native,
+		archs:     append([]string{native}, foreign...),
+		byName:    make(map[string][]int),
+		providers: make(map[string][]providedName),
+	}
+
+	if err := c.addNodes(archive); err != nil {
+		return nil, err
+	}
+
+	conflicts := make([]map[int]bool, len(c.nodes))
+	for i := range conflicts {
+		conflicts[i] = make(map[int]bool)
+	}
+	for i := range c.nodes {
+		if err := c.resolveDependencies(i); err != nil {
+			return nil, err
+		}
+
+		explicit, err := c.conflictsOf(i)
+		if err != nil {
+			return nil, err
+		}
+		for _, j := range explicit {
+			conflicts[i][j] = true
+			conflicts[j][i] = true
+		}
+
+		for _, j := range c.byName[c.nodes[i].pkg.Name] {
+			if j != i && !c.coinstallable(i, j) {
+				conflicts[i][j] = true
+			}
+		}
+	}
+
+	n := len(c.nodes)
+	c.watches = make([][]int, 2*n)
+	c.value = make([]int8, n)
+	c.level = make([]int, n)
+	c.reason = make([]int, n)
+	c.seen = make([]bool, n)
+	c.installable = make([]bool, n)
+	for i := range c.reason {
+		c.reason[i] = -1
+	}
+
+	for i := range c.nodes {
+		for _, candidates := range c.nodes[i].depends {
+			clause := []int{negative(i)}
+			for _, candidate := range candidates {
+				clause = append(clause, positive(candidate))
+			}
+			c.addClause(clause)
+		}
+
+		var others []int
+		for j := range conflicts[i] {
+			if j > i {
+				others = append(others, j)
+			}
+		}
+		sort.Ints(others)
+		for _, j := range others {
+			c.addClause([]int{negative(i), negative(j)})
+		}
+	}
+	for _, candidates := range c.essential {
+		var clause []int
+		for _, candidate := range candidates {
+			clause = append(clause, positive(candidate))
+		}
+		c.addClause(clause)
+	}
+
+	if c.propagate() != -1 {
+		c.contradiction = true
+	}
+	return c, nil
+}
+
+// addNodes collects binary packages of the system's architectures (and "all") from archive
+func (c *installabilityChecker) addNodes(archive *PackageList) error {
+	var packages []*Package
+	_ = archive.ForEach(func(p *Package) error {
+		if !p.IsSource && (p.Architecture == ArchitectureAll || utils.StrSliceHasItem(c.archs, p.Architecture)) {
+			packages = append(packages, p)
+		}
+		return nil
+	})
+	sort.Slice(packages, func(i, j int) bool {
+		if packages[i].Name != packages[j].Name {
+			return packages[i].Name < packages[j].Name
+		}
+		if r := compareVersionsDpkg(packages[i].Version, packages[j].Version); r != 0 {
+			return r > 0
+		}
+		return packages[i].Architecture < packages[j].Architecture
+	})
+
+	essential := make(map[string][]int)
+	var essentialNames []string
+	c.nodes = make([]installableNode, len(packages))
+	for i, p := range packages {
+		arch := p.Architecture
+		if arch == ArchitectureAll {
+			arch = c.native
+		}
+		c.nodes[i] = installableNode{pkg: p, arch: arch, multiArch: packageMultiArch(p)}
+		c.byName[p.Name] = append(c.byName[p.Name], i)
+
+		for _, provided := range p.Provides {
+			atom, err := parseRelationAtom(provided)
+			if err != nil {
+				return fmt.Errorf("unable to process package %s: %s", p, err)
+			}
+			c.providers[atom.name] = append(c.providers[atom.name], providedName{node: i, version: atom.version})
+		}
+
+		if strings.EqualFold(strings.TrimSpace(p.GetField("Essential")), "yes") {
+			if _, ok := essential[p.Name]; !ok {
+				essentialNames = append(essentialNames, p.Name)
+			}
+			essential[p.Name] = append(essential[p.Name], i)
+		}
+	}
+
+	sort.Strings(essentialNames)
+	for _, name := range essentialNames {
+		c.essential = append(c.essential, essential[name])
+	}
+	return nil
+}
+
+// resolveDependencies turns Pre-Depends and Depends of a node into groups of candidate nodes
+func (c *installabilityChecker) resolveDependencies(i int) error {
+	node := &c.nodes[i]
+	deps := node.pkg.Deps()
+
+	for _, field := range [][]string{deps.PreDepends, deps.Depends} {
+		groups, err := parseRelationField(strings.Join(field, ", "))
+		if err != nil {
+			return fmt.Errorf("unable to process package %s: %s", node.pkg, err)
+		}
+		for _, alternatives := range groups {
+			var candidates []int
+			for _, atom := range alternatives {
+				candidates = appendUnique(candidates, c.dependencyCandidates(node, atom)...)
+			}
+			node.depends = append(node.depends, candidates)
+		}
+	}
+	return nil
+}
+
+// conflictsOf lists nodes matched by Conflicts and Breaks of a node, other than packages of its own name
+func (c *installabilityChecker) conflictsOf(i int) ([]int, error) {
+	var result []int
+	for _, field := range []string{"Conflicts", "Breaks"} {
+		groups, err := parseRelationField(c.nodes[i].pkg.GetField(field))
+		if err != nil {
+			return nil, fmt.Errorf("unable to process package %s: %s", c.nodes[i].pkg, err)
+		}
+		for _, alternatives := range groups {
+			for _, atom := range alternatives {
+				for _, j := range c.conflictCandidates(atom) {
+					if c.nodes[j].pkg.Name != c.nodes[i].pkg.Name {
+						result = append(result, j)
+					}
+				}
+			}
+		}
+	}
+	return result, nil
+}
+
+// coinstallable reports whether two packages of one name are Multi-Arch: same ones of one version on different architectures
+func (c *installabilityChecker) coinstallable(i, j int) bool {
+	a, b := &c.nodes[i], &c.nodes[j]
+	return a.multiArch == multiArchSame && b.multiArch == multiArchSame && a.arch != b.arch &&
+		compareVersionsDpkg(a.pkg.Version, b.pkg.Version) == 0
+}
+
+func appendUnique(list []int, items ...int) []int {
+	for _, item := range items {
+		found := false
+		for _, existing := range list {
+			if existing == item {
+				found = true
+				break
+			}
+		}
+		if !found {
+			list = append(list, item)
+		}
+	}
+	return list
+}
+
+func versionMatches(version string, atom relationAtom) bool {
+	r := compareVersionsDpkg(version, atom.version)
+	switch atom.relation {
+	case VersionLess:
+		return r < 0
+	case VersionLessOrEqual:
+		return r <= 0
+	case VersionEqual:
+		return r == 0
+	case VersionGreaterOrEqual:
+		return r >= 0
+	case VersionGreater:
+		return r > 0
+	}
+	return true
+}
+
+// provideMatches checks a provided name against a relation, versioned relations need versioned provides
+func provideMatches(provided providedName, atom relationAtom) bool {
+	if atom.relation == VersionDontCare {
+		return true
+	}
+	return provided.version != "" && versionMatches(provided.version, atom)
+}
+
+// archMatches reports whether a dependency of a package of architecture arch can be met by node: without an
+// architecture qualifier by a package of that architecture or a Multi-Arch: foreign one, with a qualifier only
+// by a package of the architecture it names
+func (c *installabilityChecker) archMatches(arch, archQual string, node *installableNode) bool {
+	if archQual != "" {
+		return node.arch == c.qualifiedArch(archQual)
+	}
+	return node.arch == arch || node.multiArch == multiArchForeign
+}
+
+// qualifiedArch returns the architecture an architecture qualifier names, "native" names the native one
+func (c *installabilityChecker) qualifiedArch(archQual string) string {
+	if archQual == "native" {
+		return c.native
+	}
+	return archQual
+}
+
+func (c *installabilityChecker) dependencyCandidates(from *installableNode, atom relationAtom) []int {
+	var result []int
+
+	if atom.archQual == ArchitectureAny {
+		for _, i := range c.byName[atom.name] {
+			if c.nodes[i].multiArch == multiArchAllowed && versionMatches(c.nodes[i].pkg.Version, atom) {
+				result = append(result, i)
+			}
+		}
+		for _, provided := range c.providers[atom.name] {
+			if c.nodes[provided.node].multiArch == multiArchAllowed && provideMatches(provided, atom) {
+				result = append(result, provided.node)
+			}
+		}
+		return result
+	}
+
+	for _, i := range c.byName[atom.name] {
+		if c.archMatches(from.arch, atom.archQual, &c.nodes[i]) && versionMatches(c.nodes[i].pkg.Version, atom) {
+			result = append(result, i)
+		}
+	}
+	for _, provided := range c.providers[atom.name] {
+		if c.archMatches(from.arch, atom.archQual, &c.nodes[provided.node]) && provideMatches(provided, atom) {
+			result = append(result, provided.node)
+		}
+	}
+	return result
+}
+
+func (c *installabilityChecker) conflictCandidates(atom relationAtom) []int {
+	var result []int
+
+	matchesArch := func(node *installableNode) bool {
+		return atom.archQual == "" || atom.archQual == ArchitectureAny || node.arch == c.qualifiedArch(atom.archQual)
+	}
+
+	for _, i := range c.byName[atom.name] {
+		if matchesArch(&c.nodes[i]) && versionMatches(c.nodes[i].pkg.Version, atom) {
+			result = append(result, i)
+		}
+	}
+	for _, provided := range c.providers[atom.name] {
+		node := &c.nodes[provided.node]
+		if matchesArch(node) && (atom.archQual != ArchitectureAny || node.multiArch == multiArchAllowed) && provideMatches(provided, atom) {
+			result = append(result, provided.node)
+		}
+	}
+	return result
+}
+
+// addClause adds a clause of literals (2*node for "installed", 2*node+1 for "not installed"): a tautology is
+// dropped, a unit clause assigns its literal at once or records a contradiction, and any other clause is
+// stored and watched
+func (c *installabilityChecker) addClause(clause []int) {
+	for _, lit := range clause[1:] {
+		if lit == clause[0]^1 {
+			return
+		}
+	}
+	if len(clause) == 1 {
+		switch c.litValue(clause[0]) {
+		case -1:
+			c.contradiction = true
+		case 0:
+			c.enqueue(clause[0], -1)
+		}
+		return
+	}
+	c.clauses = append(c.clauses, clause)
+	c.watches[clause[0]] = append(c.watches[clause[0]], len(c.clauses)-1)
+	c.watches[clause[1]] = append(c.watches[clause[1]], len(c.clauses)-1)
+}
+
+func (c *installabilityChecker) litValue(lit int) int8 {
+	if lit&1 == 1 {
+		return -c.value[lit>>1]
+	}
+	return c.value[lit>>1]
+}
+
+func (c *installabilityChecker) enqueue(lit, reason int) {
+	node := lit >> 1
+	c.value[node] = 1 - 2*int8(lit&1)
+	c.level[node] = len(c.trailLim)
+	c.reason[node] = reason
+	c.trail = append(c.trail, lit)
+}
+
+// propagate assigns literals of unit clauses and returns a falsified clause, or -1
+func (c *installabilityChecker) propagate() int {
+	for c.qhead < len(c.trail) {
+		falseLit := c.trail[c.qhead] ^ 1
+		c.qhead++
+
+		watching := c.watches[falseLit]
+		kept := 0
+		for i := 0; i < len(watching); i++ {
+			index := watching[i]
+			clause := c.clauses[index]
+			if clause[0] == falseLit {
+				clause[0], clause[1] = clause[1], clause[0]
+			}
+			if c.litValue(clause[0]) == 1 {
+				watching[kept] = index
+				kept++
+				continue
+			}
+
+			moved := false
+			for k := 2; k < len(clause); k++ {
+				if c.litValue(clause[k]) != -1 {
+					clause[1], clause[k] = clause[k], clause[1]
+					c.watches[clause[1]] = append(c.watches[clause[1]], index)
+					moved = true
+					break
+				}
+			}
+			if moved {
+				continue
+			}
+
+			watching[kept] = index
+			kept++
+			if c.litValue(clause[0]) == -1 {
+				kept += copy(watching[kept:], watching[i+1:])
+				c.watches[falseLit] = watching[:kept]
+				return index
+			}
+			c.enqueue(clause[0], index)
+		}
+		c.watches[falseLit] = watching[:kept]
+	}
+	return -1
+}
+
+// analyze derives a clause from a conflict (first unique implication point) and the level to backjump to
+func (c *installabilityChecker) analyze(conflict int) ([]int, int) {
+	learnt := []int{0}
+	current := len(c.trailLim)
+	pending := 0
+	lit := -1
+	index := len(c.trail) - 1
+	clause := c.clauses[conflict]
+
+	for {
+		start := 0
+		if lit != -1 {
+			start = 1
+		}
+		for _, q := range clause[start:] {
+			node := q >> 1
+			if !c.seen[node] && c.level[node] > 0 {
+				c.seen[node] = true
+				if c.level[node] == current {
+					pending++
+				} else {
+					learnt = append(learnt, q)
+				}
+			}
+		}
+
+		for !c.seen[c.trail[index]>>1] {
+			index--
+		}
+		lit = c.trail[index]
+		index--
+		c.seen[lit>>1] = false
+		pending--
+		if pending == 0 {
+			break
+		}
+		clause = c.clauses[c.reason[lit>>1]]
+	}
+	learnt[0] = lit ^ 1
+
+	backjump, at := 0, 1
+	for i := 1; i < len(learnt); i++ {
+		node := learnt[i] >> 1
+		c.seen[node] = false
+		if c.level[node] > backjump {
+			backjump, at = c.level[node], i
+		}
+	}
+	if len(learnt) > 1 {
+		learnt[1], learnt[at] = learnt[at], learnt[1]
+	}
+	return learnt, backjump
+}
+
+func (c *installabilityChecker) learn(clause []int) {
+	if len(clause) == 1 {
+		c.enqueue(clause[0], -1)
+		return
+	}
+	c.clauses = append(c.clauses, clause)
+	index := len(c.clauses) - 1
+	c.watches[clause[0]] = append(c.watches[clause[0]], index)
+	c.watches[clause[1]] = append(c.watches[clause[1]], index)
+	c.enqueue(clause[0], index)
+}
+
+func (c *installabilityChecker) decide(lit int) {
+	c.trailLim = append(c.trailLim, len(c.trail))
+	c.cursorLim = append(c.cursorLim, c.cursor)
+	c.enqueue(lit, -1)
+}
+
+func (c *installabilityChecker) backjump(level int) {
+	if len(c.trailLim) <= level {
+		return
+	}
+	for _, lit := range c.trail[c.trailLim[level]:] {
+		c.value[lit>>1] = 0
+		c.reason[lit>>1] = -1
+	}
+	c.trail = c.trail[:c.trailLim[level]]
+	c.cursor = c.cursorLim[level]
+	c.trailLim = c.trailLim[:level]
+	c.cursorLim = c.cursorLim[:level]
+	c.qhead = len(c.trail)
+}
+
+func (c *installabilityChecker) groupSatisfied(candidates []int) bool {
+	for _, candidate := range candidates {
+		if c.value[candidate] == 1 {
+			return true
+		}
+	}
+	return false
+}
+
+// openGroup returns an unsatisfied group, packages before cursor in the trail have theirs satisfied
+func (c *installabilityChecker) openGroup() []int {
+	for ; c.cursor < len(c.trail); c.cursor++ {
+		lit := c.trail[c.cursor]
+		if lit&1 == 1 {
+			continue
+		}
+		for _, candidates := range c.nodes[lit>>1].depends {
+			if !c.groupSatisfied(candidates) {
+				return candidates
+			}
+		}
+	}
+	for _, candidates := range c.essential {
+		if !c.groupSatisfied(candidates) {
+			return candidates
+		}
+	}
+	return nil
+}
+
+// candidate picks a package to install for an open group, preferring the native architecture
+func (c *installabilityChecker) candidate(candidates []int) int {
+	pick := -1
+	for _, candidate := range candidates {
+		if c.value[candidate] == 0 {
+			if c.nodes[candidate].arch == c.native {
+				return candidate
+			}
+			if pick == -1 {
+				pick = candidate
+			}
+		}
+	}
+	return pick
+}
+
+// check finds out whether some installation contains the node, remembering every package
+// of a found installation as installable
+func (c *installabilityChecker) check(node int) bool {
+	if c.contradiction || c.value[node] == -1 {
+		return false
+	}
+	if c.installable[node] {
+		return true
+	}
+
+	c.cursor = 0
+	assumed := 0
+	for {
+		if conflict := c.propagate(); conflict != -1 {
+			if len(c.trailLim) == 0 {
+				c.contradiction = true
+				return false
+			}
+			learnt, level := c.analyze(conflict)
+			if len(c.trailLim) == assumed {
+				c.backjump(0)
+				c.learn(learnt)
+				if c.propagate() != -1 {
+					c.contradiction = true
+				}
+				return false
+			}
+			c.backjump(level)
+			c.learn(learnt)
+			continue
+		}
+
+		if len(c.trailLim) == 0 {
+			switch c.value[node] {
+			case -1:
+				return false
+			case 0:
+				c.decide(positive(node))
+				assumed = 1
+				continue
+			}
+			assumed = 0
+		}
+
+		candidates := c.openGroup()
+		if candidates == nil {
+			for _, lit := range c.trail {
+				if lit&1 == 0 {
+					c.installable[lit>>1] = true
+				}
+			}
+			c.backjump(0)
+			return true
+		}
+		c.decide(positive(c.candidate(candidates)))
+	}
+}
+
+// Uninstallable returns packages of architecture native or "all" from the list which can't be
+// installed from archive (which should include the list) on a system with native architecture native
+// and foreign architectures foreign: no set of packages containing it satisfies every Pre-Depends and
+// Depends, avoids Conflicts, Breaks and two packages of one name (apart from Multi-Arch: same ones of
+// one version) and holds an Essential package of each Essential package name.
+func (l *PackageList) Uninstallable(native string, foreign []string, archive *PackageList, progress aptly.Progress) ([]*Package, error) {
+	checker, err := newInstallabilityChecker(native, foreign, archive)
+	if err != nil {
+		return nil, err
+	}
+
+	index := make(map[string]int, len(checker.nodes))
+	for i := range checker.nodes {
+		index[string(checker.nodes[i].pkg.Key(""))] = i
+	}
+
+	var checked []int
+	_ = l.ForEach(func(p *Package) error {
+		if !p.IsSource && (p.Architecture == native || p.Architecture == ArchitectureAll) {
+			if i, ok := index[string(p.Key(""))]; ok {
+				checked = append(checked, i)
+			}
+		}
+		return nil
+	})
+	sort.Ints(checked)
+
+	if progress != nil {
+		progress.InitBar(int64(len(checked)), false, aptly.BarGeneralVerifyDependencies)
+		defer progress.ShutdownBar()
+	}
+
+	var result []*Package
+	for _, i := range checked {
+		if progress != nil {
+			progress.AddBar(1)
+		}
+		if !checker.check(i) {
+			result = append(result, checker.nodes[i].pkg)
+		}
+	}
+	return result, nil
+}
