+package cmd_test
+
+import (
+	"archive/tar"
+	"bytes"
+	"compress/gzip"
+	"crypto/md5"
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+)
+
+var (
+	aptlyBinary     string
+	aptlyBuildError error
+)
+
+func TestMain(m *testing.M) {
+	dir, err := os.MkdirTemp("", "aptly-verify-installable")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	aptlyBinary = filepath.Join(dir, "aptly")
+	if out, err := exec.Command("go", "build", "-o", aptlyBinary, "..").CombinedOutput(); err != nil {
+		aptlyBuildError = fmt.Errorf("%v\n%s", err, out)
+	}
+	code := m.Run()
+	_ = os.RemoveAll(dir)
+	os.Exit(code)
+}
+
+type aptlyEnv struct {
+	t      *testing.T
+	dir    string
+	config string
+}
+
+func newAptlyEnv(t *testing.T) *aptlyEnv {
+	t.Helper()
+	if aptlyBuildError != nil {
+		t.Fatalf("unable to build aptly: %s", aptlyBuildError)
+	}
+	dir := t.TempDir()
+	config := filepath.Join(dir, "aptly.conf")
+	content := fmt.Sprintf("{\"rootDir\": %q, \"architectures\": []}\n", filepath.Join(dir, "root"))
+	if err := os.WriteFile(config, []byte(content), 0644); err != nil {
+		t.Fatal(err)
+	}
+	return &aptlyEnv{t: t, dir: dir, config: config}
+}
+
+func (e *aptlyEnv) exec(args ...string) (string, string, error) {
+	cmd := exec.Command(aptlyBinary, append([]string{"-config=" + e.config}, args...)...)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	err := cmd.Run()
+	return stdout.String(), stderr.String(), err
+}
+
+func (e *aptlyEnv) run(args ...string) string {
+	e.t.Helper()
+	stdout, stderr, err := e.exec(args...)
+	if err != nil {
+		e.t.Fatalf("aptly %s: %v\nstdout:\n%s\nstderr:\n%s", strings.Join(args, " "), err, stdout, stderr)
+	}
+	return stdout
+}
+
+func splitStanzas(text string) []string {
+	var stanzas []string
+	for _, block := range strings.Split(strings.TrimSpace(text), "\n\n") {
+		if block = strings.TrimSpace(block); block != "" {
+			stanzas = append(stanzas, block+"\n")
+		}
+	}
+	return stanzas
+}
+
+func stanzaField(stanza, field string) string {
+	for _, line := range strings.Split(stanza, "\n") {
+		if strings.HasPrefix(line, field+": ") {
+			return strings.TrimPrefix(line, field+": ")
+		}
+	}
+	return ""
+}
+
+func tarGz(t *testing.T, files map[string]string) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	gz := gzip.NewWriter(&buf)
+	tw := tar.NewWriter(gz)
+	names := make([]string, 0, len(files))
+	for name := range files {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		if err := tw.WriteHeader(&tar.Header{Name: name, Mode: 0644, Size: int64(len(files[name]))}); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := tw.Write([]byte(files[name])); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := tw.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := gz.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
+
+func writeDeb(t *testing.T, path, control string) {
+	t.Helper()
+	var buf bytes.Buffer
+	buf.WriteString("!<arch>\n")
+	members := []struct {
+		name    string
+		content []byte
+	}{
+		{"debian-binary", []byte("2.0\n")},
+		{"control.tar.gz", tarGz(t, map[string]string{"./control": control})},
+		{"data.tar.gz", tarGz(t, nil)},
+	}
+	for _, member := range members {
+		fmt.Fprintf(&buf, "%-16s%-12d%-6d%-6d%-8s%-10d`\n", member.name, 0, 0, 0, "100644", len(member.content))
+		buf.Write(member.content)
+		if len(member.content)%2 == 1 {
+			buf.WriteByte('\n')
+		}
+	}
+	if err := os.WriteFile(path, buf.Bytes(), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func writeDsc(t *testing.T, dir, name, version string) {
+	t.Helper()
+	tarball := name + "_" + version + ".tar.gz"
+	content := tarGz(t, map[string]string{name + "/README": "source\n"})
+	if err := os.WriteFile(filepath.Join(dir, tarball), content, 0644); err != nil {
+		t.Fatal(err)
+	}
+	dsc := fmt.Sprintf("Format: 3.0 (native)\nSource: %s\nBinary: %s\nArchitecture: any\nVersion: %s\n"+
+		"Maintainer: Test <test@example.com>\nChecksums-Sha256:\n %x %d %s\nFiles:\n %x %d %s\n",
+		name, name, version, sha256.Sum256(content), len(content), tarball, md5.Sum(content), len(content), tarball)
+	if err := os.WriteFile(filepath.Join(dir, name+"_"+version+".dsc"), []byte(dsc), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func (e *aptlyEnv) packages(name, stanzas string) string {
+	e.t.Helper()
+	dir := filepath.Join(e.dir, "packages-"+name)
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		e.t.Fatal(err)
+	}
+	for _, stanza := range splitStanzas(stanzas) {
+		file := fmt.Sprintf("%s_%s_%s.deb", stanzaField(stanza, "Package"), stanzaField(stanza, "Version"), stanzaField(stanza, "Architecture"))
+		writeDeb(e.t, filepath.Join(dir, file), stanza)
+	}
+	return dir
+}
+
+func (e *aptlyEnv) snapshotFrom(name, dir string) {
+	e.t.Helper()
+	e.run("repo", "create", name)
+	e.run("repo", "add", name, dir)
+	e.run("snapshot", "create", name, "from", "repo", name)
+}
+
+func (e *aptlyEnv) snapshot(name, stanzas string) {
+	e.t.Helper()
+	e.snapshotFrom(name, e.packages(name, stanzas))
+}
+
+func (e *aptlyEnv) verify(architectures string, args ...string) (string, string) {
+	e.t.Helper()
+	var all []string
+	if architectures != "" {
+		all = append(all, "-architectures="+architectures)
+	}
+	all = append(all, "snapshot", "verify")
+	all = append(all, args...)
+	stdout, stderr, err := e.exec(all...)
+	if err != nil {
+		e.t.Fatalf("aptly %s: %v\nstdout:\n%s\nstderr:\n%s", strings.Join(all, " "), err, stdout, stderr)
+	}
+	return stdout, stderr
+}
+
+func (e *aptlyEnv) assertUninstallable(architectures string, snapshots []string, expected ...string) {
+	e.t.Helper()
+	stdout, stderr := e.verify(architectures, append([]string{"-installable"}, snapshots...)...)
+	lines := strings.Split(stdout, "\n")
+	for i, line := range lines {
+		var count int
+		if _, err := fmt.Sscanf(line, "Uninstallable packages (%d):", &count); err == nil && strings.HasSuffix(line, "):") {
+			got := []string{}
+			for _, item := range lines[i+1:] {
+				if !strings.HasPrefix(item, "  ") {
+					break
+				}
+				got = append(got, strings.TrimPrefix(item, "  "))
+			}
+			if count != len(got) {
+				e.t.Fatalf("report announces %d packages but lists %d:\n%s", count, len(got), stdout)
+			}
+			sort.Strings(got)
+			want := append([]string{}, expected...)
+			sort.Strings(want)
+			if !reflect.DeepEqual(got, want) {
+				e.t.Fatalf("uninstallable packages:\n got %q\nwant %q", got, want)
+			}
+			return
+		}
+	}
+	e.t.Fatalf("no installability report in output\nstdout:\n%s\nstderr:\n%s", stdout, stderr)
+}
+
+type archiveRand struct{ state uint64 }
+
+func (r *archiveRand) next() uint64 {
+	r.state += 0x9E3779B97F4A7C15
+	z := r.state
+	z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
+	z = (z ^ (z >> 27)) * 0x94D049BB133111EB
+	return z ^ (z >> 31)
+}
+
+func (r *archiveRand) intn(n int) int { return int(r.next() % uint64(n)) }
+
+func (r *archiveRand) chance(percent int) bool { return r.intn(100) < percent }
+
+func (r *archiveRand) pick(weights ...int) int {
+	total := 0
+	for _, w := range weights {
+		total += w
+	}
+	n := r.intn(total)
+	for i, w := range weights {
+		if n < w {
+			return i
+		}
+		n -= w
+	}
+	return len(weights) - 1
+}
+
+func (r *archiveRand) perm(n int) []int {
+	p := make([]int, n)
+	for i := range p {
+		p[i] = i
+	}
+	for i := n - 1; i > 0; i-- {
+		j := r.intn(i + 1)
+		p[i], p[j] = p[j], p[i]
+	}
+	return p
+}
+
+type randomPackage struct {
+	name, version, arch string
+	fields              map[string]string
+	extra               bool
+}
+
+type randomArchive struct {
+	architectures []string
+	packages      []randomPackage
+}
+
+var (
+	randomVersions  = []string{"0.9", "1.0", "1.0-1", "1.2~rc1", "1.2", "1.2a", "1.2+b1", "1.2-rc1-1", "2.0", "2.0+b1", "1:0.5", "3"}
+	randomMultiArch = []string{"no", "same", "foreign", "allowed"}
+	randomOperators = []string{"<<", "<=", "=", ">=", ">>"}
+	randomFields    = []string{"Multi-Arch", "Essential", "Pre-Depends", "Depends", "Recommends", "Suggests", "Conflicts", "Breaks", "Provides"}
+)
+
+type randomName struct {
+	name      string
+	multiArch string
+	versions  []string
+	essential bool
+}
+
+func generateArchive(seed uint64) randomArchive {
+	r := &archiveRand{state: seed}
+	var archive randomArchive
+	switch r.pick(20, 55, 25) {
+	case 0:
+		archive.architectures = []string{"amd64"}
+	case 1:
+		archive.architectures = []string{"amd64", "i386"}
+	default:
+		archive.architectures = []string{"amd64", "i386", "arm64"}
+	}
+	archs := append([]string{}, archive.architectures...)
+	if r.chance(30) {
+		archs = append(archs, "armhf")
+	}
+	withExtra := r.chance(40)
+
+	names := make([]*randomName, 5+r.intn(14))
+	virtuals := make([]string, r.intn(5))
+	for i := range names {
+		n := &randomName{name: fmt.Sprintf("p%d", i), multiArch: randomMultiArch[r.pick(50, 15, 20, 15)]}
+		for _, idx := range r.perm(len(randomVersions))[:1+r.intn(3)] {
+			n.versions = append(n.versions, randomVersions[idx])
+		}
+		n.essential = r.chance(8)
+		names[i] = n
+	}
+	for i := range virtuals {
+		virtuals[i] = fmt.Sprintf("v%d", i)
+	}
+	byName := map[string]*randomName{}
+	for _, n := range names {
+		byName[n.name] = n
+	}
+
+	type planned struct {
+		name          *randomName
+		version, arch string
+	}
+	var plan []planned
+	for _, n := range names {
+		for _, v := range n.versions {
+			if n.multiArch != "same" && r.chance(25) {
+				plan = append(plan, planned{n, v, "all"})
+				continue
+			}
+			var chosen []string
+			for _, a := range archs {
+				if r.chance(60) {
+					chosen = append(chosen, a)
+				}
+			}
+			if len(chosen) == 0 {
+				chosen = []string{archs[r.intn(len(archs))]}
+			}
+			for _, a := range chosen {
+				plan = append(plan, planned{n, v, a})
+			}
+		}
+	}
+
+	provided := map[string]bool{}
+	provides := make([][]string, len(plan))
+	for i := range plan {
+		if !r.chance(25) {
+			continue
+		}
+		for j := 1 + r.intn(2); j > 0; j-- {
+			target := names[r.intn(len(names))].name
+			if len(virtuals) > 0 && r.chance(90) {
+				target = virtuals[r.intn(len(virtuals))]
+			}
+			entry := target
+			if r.chance(35) {
+				entry = fmt.Sprintf("%s (= %s)", target, randomVersions[r.intn(len(randomVersions))])
+			}
+			provides[i] = append(provides[i], entry)
+			provided[target] = true
+		}
+	}
+
+	foreign := map[string]bool{}
+	for i, p := range plan {
+		if p.name.multiArch != "foreign" {
+			continue
+		}
+		foreign[p.name.name] = true
+		for _, entry := range provides[i] {
+			foreign[strings.Fields(entry)[0]] = true
+		}
+	}
+
+	versionFor := func(target string) string {
+		if n, ok := byName[target]; ok && r.chance(75) {
+			return n.versions[r.intn(len(n.versions))]
+		}
+		return randomVersions[r.intn(len(randomVersions))]
+	}
+	relation := func() string {
+		var target string
+		switch r.pick(70, 20, 10) {
+		case 0:
+			target = names[r.intn(len(names))].name
+		case 1:
+			if len(virtuals) == 0 {
+				target = names[r.intn(len(names))].name
+			} else {
+				target = virtuals[r.intn(len(virtuals))]
+			}
+		default:
+			target = fmt.Sprintf("ghost%d", r.intn(3))
+		}
+		if n, ok := byName[target]; ok && n.multiArch == "allowed" && !provided[target] && r.chance(30) {
+			return target + ":any"
+		}
+		s := target
+		if r.chance(5) {
+			if qualifier := archs[r.intn(len(archs))]; !foreign[target] {
+				s += ":" + qualifier
+			}
+		}
+		if r.chance(35) {
+			s += fmt.Sprintf(" (%s %s)", randomOperators[r.intn(len(randomOperators))], versionFor(target))
+		}
+		return s
+	}
+	relations := func(groups int) string {
+		var parts []string
+		for g := 0; g < groups; g++ {
+			n := 1
+			if r.chance(30) {
+				n += 1 + r.intn(2)
+			}
+			var alternatives []string
+			for i := 0; i < n; i++ {
+				alternatives = append(alternatives, relation())
+			}
+			parts = append(parts, strings.Join(alternatives, " | "))
+		}
+		return strings.Join(parts, ", ")
+	}
+	conflict := func(p planned, own []string) string {
+		var target string
+		if p.name.multiArch == "same" {
+			var options []string
+			for _, n := range names {
+				if n.name != p.name.name && !provided[n.name] {
+					options = append(options, n.name)
+				}
+			}
+			if len(options) == 0 {
+				return ""
+			}
+			target = options[r.intn(len(options))]
+		} else {
+			switch r.pick(60, 10, 20, 10) {
+			case 0:
+				target = names[r.intn(len(names))].name
+			case 1:
+				target = p.name.name
+			case 2:
+				if len(virtuals) == 0 {
+					target = names[r.intn(len(names))].name
+				} else {
+					target = virtuals[r.intn(len(virtuals))]
+				}
+			default:
+				if len(own) > 0 {
+					target = strings.Fields(own[r.intn(len(own))])[0]
+				} else {
+					target = names[r.intn(len(names))].name
+				}
+			}
+		}
+		if r.chance(40) {
+			return fmt.Sprintf("%s (%s %s)", target, randomOperators[r.intn(len(randomOperators))], versionFor(target))
+		}
+		return target
+	}
+
+	for i, p := range plan {
+		fields := map[string]string{}
+		if p.name.multiArch != "no" || r.chance(10) {
+			fields["Multi-Arch"] = p.name.multiArch
+		}
+		if p.name.essential {
+			fields["Essential"] = "yes"
+		}
+		if groups := r.pick(30, 35, 25, 10); groups > 0 {
+			fields["Depends"] = relations(groups)
+		}
+		if r.chance(15) {
+			fields["Pre-Depends"] = relations(1)
+		}
+		if r.chance(15) {
+			fields["Recommends"] = relations(1 + r.intn(2))
+		}
+		if r.chance(10) {
+			fields["Suggests"] = relations(1)
+		}
+		if r.chance(30) {
+			var conflicts []string
+			for j := 1 + r.intn(2); j > 0; j-- {
+				if c := conflict(p, provides[i]); c != "" {
+					conflicts = append(conflicts, c)
+				}
+			}
+			if len(conflicts) > 0 {
+				fields["Conflicts"] = strings.Join(conflicts, ", ")
+			}
+		}
+		if r.chance(20) {
+			if c := conflict(p, provides[i]); c != "" {
+				fields["Breaks"] = c
+			}
+		}
+		if len(provides[i]) > 0 {
+			fields["Provides"] = strings.Join(provides[i], ", ")
+		}
+		archive.packages = append(archive.packages, randomPackage{
+			name:    p.name.name,
+			version: p.version,
+			arch:    p.arch,
+			fields:  fields,
+			extra:   withExtra && r.chance(25),
+		})
+	}
+	return archive
+}
+
+func (a randomArchive) stanzas(extra bool) string {
+	var b strings.Builder
+	for _, p := range a.packages {
+		if p.extra != extra {
+			continue
+		}
+		fmt.Fprintf(&b, "Package: %s\nVersion: %s\nArchitecture: %s\n", p.name, p.version, p.arch)
+		for _, field := range randomFields {
+			if value, ok := p.fields[field]; ok {
+				fmt.Fprintf(&b, "%s: %s\n", field, value)
+			}
+		}
+		b.WriteString("\n")
+	}
+	return b.String()
+}
+
+func checkRandomArchive(t *testing.T, seed uint64, expected ...string) {
+	t.Helper()
+	archive := generateArchive(seed)
+	e := newAptlyEnv(t)
+	e.snapshot("main", archive.stanzas(false))
+	snapshots := []string{"main"}
+	if extra := archive.stanzas(true); extra != "" {
+		e.snapshot("extra", extra)
+		snapshots = append(snapshots, "extra")
+	}
+	e.assertUninstallable(strings.Join(archive.architectures, ","), snapshots, expected...)
+}
