diff --git a/test.sh b/test.sh
new file mode 100755
index 00000000..b289d108
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,189 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      [ -n "$OUTPUT_PATH" ] || { echo "missing value for --output_path" >&2; usage; }
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")" || exit 2
+
+export GOFLAGS=-buildvcs=false
+export GOTOOLCHAIN=local
+export GOPROXY=off
+for dir in /usr/local/go/bin /opt/go/bin /usr/local/bin; do
+  case ":$PATH:" in
+    *":$dir:"*) ;;
+    *) [ -d "$dir" ] && PATH="$dir:$PATH" ;;
+  esac
+done
+export PATH
+if ! go list -m all >/dev/null 2>&1 && [ -d /opt/go/pkg/mod ]; then
+  export GOPATH=/opt/go
+  export GOMODCACHE=/opt/go/pkg/mod
+fi
+GO_BUILD_CACHE="$(go env GOCACHE 2>/dev/null)"
+if [ -z "$GO_BUILD_CACHE" ] || ! mkdir -p "$GO_BUILD_CACHE" 2>/dev/null || [ ! -w "$GO_BUILD_CACHE" ]; then
+  GO_BUILD_CACHE="/tmp/go-build-$(id -u)"
+fi
+export GOCACHE="$GO_BUILD_CACHE"
+GOPATH="$(go env GOPATH)"
+GOMODCACHE="$(go env GOMODCACHE)"
+export GOPATH GOMODCACHE
+# the api and context suites keep their default aptly root (~/.aptly) under HOME, so every run gets a fresh one
+export HOME="$(mktemp -d)"
+
+NEW_PKG="github.com/aptly-dev/aptly/cmd"
+NEW_FILE="cmd/snapshot_verify_installable_88d50e_test.go"
+NEW_RUN='^TestSnapshotVerifyInstallable'
+LOG="$(mktemp)"
+LIST_ERR="$(mktemp)"
+trap 'rm -f "$LOG" "$LIST_ERR"' EXIT
+LIST_STATUS=0
+
+if [ "$MODE" = "base" ]; then
+  PKGS="$(go list ./... 2>"$LIST_ERR")"
+  LIST_STATUS=$?
+  if [ "$LIST_STATUS" -ne 0 ]; then
+    PKGS="$(go list -e ./... 2>/dev/null)"
+  fi
+  cat "$LIST_ERR" >>"$LOG"
+  # database/etcddb: every test connects to an etcd server on 127.0.0.1:2379, which the image does not run
+  # files: DiskFullSuite needs a tiny filesystem, either loop-mounted (root with mount privileges) or already mounted at /smallfs
+  # http: the *ConnectError tests expect a DNS "no such host" error, while the offline sandbox reports "network is unreachable"
+  # pgp: Gnupg2VerifierSuite.TestVerifyClearsigned expects three good signing keys, the gpgv in the image reports two
+  # swift: each test binds its fake Swift server to a random port in 20000-29999 with no retry (swift/public_test.go:28), so a port already taken on the host fails it
+  PKGS="$(printf '%s\n' "$PKGS" | grep -v -e '^$' -e "^$NEW_PKG\$" \
+    -e '/database/etcddb$' -e '/files$' -e '/http$' -e '/pgp$' -e '/swift$' -e '/api$')"
+  if [ -n "$PKGS" ]; then
+    go test -v -count=1 -timeout 20m $PKGS >>"$LOG" 2>&1
+    STATUS=$?
+  else
+    STATUS=1
+  fi
+  # api: FilesUploadDiskFullSuite provokes permission errors, which never happen when the tests run as root
+  go test -v -count=1 -timeout 20m ./api/ \
+    -check.f '^(APISuite|GPGSuite|MiddlewareSuite|MirrorSuite|PackagesSuite|PublishedFileMissingSuite|ReposSuite|SnapshotsSuite)\.' >>"$LOG" 2>&1
+  API_STATUS=$?
+  [ "$API_STATUS" -ne 0 ] && STATUS="$API_STATUS"
+  if [ "$LIST_STATUS" -ne 0 ]; then
+    echo "[setup failed] go list ./... exited with status $LIST_STATUS" >>"$LOG"
+    [ "$STATUS" -eq 0 ] && STATUS="$LIST_STATUS"
+  fi
+else
+  go test -v -count=1 -timeout 20m -run "$NEW_RUN" ./cmd/ >>"$LOG" 2>&1
+  STATUS=$?
+fi
+
+if ! grep -qE '^ *--- (PASS|FAIL|SKIP):' "$LOG"; then
+  echo "no tests were collected in mode $MODE" >>"$LOG"
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+cat "$LOG"
+
+expected_tests() {
+  grep -ho '^func TestSnapshotVerifyInstallable[A-Za-z0-9_]*' "$NEW_FILE" 2>/dev/null | sed 's/^func //'
+}
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' | tr -d '\000-\010\013\014\016-\037'
+}
+
+add_failures() {
+  suite="$1"
+  message="$2"
+  detail="$3"
+  shift 3
+  grep -q '</testsuites>' "$OUTPUT_PATH" 2>/dev/null || printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n</testsuites>\n' >"$OUTPUT_PATH"
+  EXTRA="$(mktemp)"
+  MERGED="$(mktemp)"
+  {
+    echo "<testsuite name=\"$suite\" tests=\"$#\" failures=\"$#\" errors=\"0\">"
+    for name in "$@"; do
+      echo "<testcase name=\"$name\" classname=\"$suite\"><failure message=\"$message\">$detail</failure></testcase>"
+    done
+    echo '</testsuite>'
+  } >"$EXTRA"
+  awk -v extra="$EXTRA" '/<\/testsuites>/ { while ((getline line < extra) > 0) print line } { print }' "$OUTPUT_PATH" >"$MERGED"
+  TESTS="$(grep -c '<testcase ' "$MERGED")"
+  FAILURES="$(grep -c '<failure' "$MERGED")"
+  ERRORS="$(grep -c '<error' "$MERGED")"
+  sed -E "1,/<testsuites/ s#<testsuites[^>]*>#<testsuites tests=\"$TESTS\" failures=\"$FAILURES\" errors=\"$ERRORS\">#" "$MERGED" >"$OUTPUT_PATH"
+  rm -f "$EXTRA" "$MERGED"
+}
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  sed -e 's/\x1b\[[0-9;]*[A-Za-z]//g' "$LOG" | tr -d '\000-\010\013\014\016-\037' | go-junit-report >"$OUTPUT_PATH" 2>/dev/null || true
+  PANICKED="$(awk '/^--- FAIL: /{name=$3} /^panic: /{print name; exit}' "$LOG")"
+  RAN=0
+  NAMES=""
+  if [ "$MODE" = "new" ]; then
+    SUITE="$NEW_PKG"
+    for name in $(expected_tests); do
+      if grep -q "<testcase name=\"$name\"" "$OUTPUT_PATH" 2>/dev/null; then
+        RAN=1
+      else
+        NAMES="$NAMES $name"
+      fi
+    done
+  else
+    SUITE="github.com/aptly-dev/aptly"
+    if grep -q '<testcase ' "$OUTPUT_PATH" 2>/dev/null; then
+      RAN=1
+    else
+      NAMES="build"
+    fi
+  fi
+  if [ -n "$NAMES" ]; then
+    [ "$STATUS" -eq 0 ] && STATUS=1
+    DETAIL="$(grep -E '^# |\.go:[0-9]+:[0-9]+: |\[(build|setup) failed\]|^panic|timed out' "$LOG" | head -n 40)"
+    [ -n "$DETAIL" ] || DETAIL="$(tail -n 40 "$LOG")"
+    DETAIL="$(printf '%s\n' "$DETAIL" | xml_escape)"
+    if [ "$RAN" -eq 1 ] && [ -n "$PANICKED" ]; then
+      MESSAGE="not run: the test binary exited after $PANICKED panicked"
+    elif [ "$RAN" -eq 1 ]; then
+      MESSAGE="not run: the test binary exited before reaching this test"
+    else
+      MESSAGE="the test package failed to build or run"
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n</testsuites>\n' >"$OUTPUT_PATH"
+    fi
+    add_failures "$SUITE" "$MESSAGE" "$DETAIL" $NAMES
+  fi
+  if [ "$LIST_STATUS" -ne 0 ]; then
+    DETAIL="$(head -n 40 "$LIST_ERR" | xml_escape)"
+    add_failures "$SUITE" "package discovery failed: go list ./... exited with status $LIST_STATUS" "$DETAIL" package_discovery
+  fi
+fi
+
+exit "$STATUS"
