+func TestSnapshotVerifyInstallableKeepsPlainVerify(t *testing.T) {
+	e := newAptlyEnv(t)
+	e.snapshot("main", `
+Package: app
+Version: 1.0
+Architecture: amd64
+Depends: helper
+
+Package: helper
+Version: 1.0
+Architecture: amd64
+Conflicts: app
+
+Package: tool
+Version: 1.0
+Architecture: amd64
+Depends: libmissing (>= 2)
+
+Package: libfoo
+Version: 4.3.5-rc1-1
+Architecture: amd64
+
+Package: needs-old-foo
+Version: 1.0
+Architecture: amd64
+Depends: libfoo (<< 4.3.5a)
+`)
+	stdout, stderr := e.verify("amd64", "main")
+	want := "Loading packages...\nVerifying...\nMissing dependencies (1):\n  libmissing (>= 2) [amd64]\n"
+	if stdout != want {
+		t.Fatalf("plain verify output changed:\n got %q\nwant %q\nstderr:\n%s", stdout, want, stderr)
+	}
+	e.assertUninstallable("amd64", []string{"main"}, "app_1.0_amd64 [amd64]", "needs-old-foo_1.0_amd64 [amd64]", "tool_1.0_amd64 [amd64]")
+}
