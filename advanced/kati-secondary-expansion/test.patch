+
+type normalization struct {
+	regexp  *regexp.Regexp
+	replace string
+}
+
+var normalizeQuotes = normalization{
+	regexp.MustCompile("([`'\"]|\xe2\x80\x98|\xe2\x80\x99)"), `"`,
+}
+
+var normalizeMake = []normalization{
+	normalizeQuotes,
+	{regexp.MustCompile(`make(?:\[\d+\])?: (Entering|Leaving) directory[^\n]*\n`), ""},
+	{regexp.MustCompile(`make(?:\[\d+\])?: `), ""},
+	{regexp.MustCompile(`\s+Stop\.`), ""},
+	{regexp.MustCompile(`\[\S+:\d+: `), "["},
+}
+
+var normalizeKati = []normalization{
+	normalizeQuotes,
+	{regexp.MustCompile(`\*kati\*[^\n]*`), ""},
+	{regexp.MustCompile(`c?kati: `), ""},
+}
+
+var normalizeNinja = []normalization{
+	{regexp.MustCompile(`NINJACMD: [^\n]*\n`), ""},
+	{regexp.MustCompile(`ninja: no work to do\.\n`), ""},
+	{regexp.MustCompile(`ninja: error: (.*, needed by .*),[^\n]*`), "*** No rule to make target ${1}."},
+	{regexp.MustCompile(`FAILED: [^\n]*\n`), ""},
+	{regexp.MustCompile(`ninja: build stopped: [^\n]*\n`), ""},
+}
+
+func normalize(out []byte, normalizations []normalization) string {
+	for _, n := range normalizations {
+		out = n.regexp.ReplaceAll(out, []byte(n.replace))
+	}
+	return string(out)
+}
+
+type result struct {
+	output string
+	ok     bool
+	files  map[string]string
+}
+
+func setup(t *testing.T, tc testCase) string {
+	dir := t.TempDir()
+	files := map[string]string{"Makefile": tc.makefile}
+	for name, content := range tc.files {
+		files[name] = content
+	}
+	for name, content := range files {
+		path := filepath.Join(dir, name)
+		if err := os.MkdirAll(filepath.Dir(path), 0777); err != nil {
+			t.Fatal(err)
+		}
+		if err := ioutil.WriteFile(path, []byte(content), 0666); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return dir
+}
+
+func outputFiles(t *testing.T, dir string) map[string]string {
+	ret := map[string]string{}
+	ignore := map[string]bool{"Makefile": true, "build.ninja": true, "env.sh": true, "ninja.sh": true}
+	err := filepath.Walk(dir, func(path string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(dir, path)
+		if err != nil || rel == "." {
+			return err
+		}
+		if !strings.Contains(rel, "/") && (ignore[rel] || strings.HasPrefix(rel, ".") || strings.HasPrefix(rel, "kati")) {
+			if info.IsDir() {
+				return filepath.SkipDir
+			}
+			return nil
+		}
+		if info.IsDir() {
+			return nil
+		}
+		data, err := ioutil.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		ret[rel] = string(data)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return ret
+}
+
+func run(dir string, name string, args ...string) ([]byte, bool) {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, name, args...)
+	cmd.Dir = dir
+	out, err := cmd.CombinedOutput()
+	return out, err == nil
+}
+
+func runMake(t *testing.T, tc testCase, ninja bool) result {
+	dir := setup(t, tc)
+	args := []string{"SHELL=/bin/bash"}
+	if ninja {
+		args = append(args, "-s")
+	}
+	out, ok := run(dir, "make", append(args, tc.goals...)...)
+	return result{normalize(out, normalizeMake), ok, outputFiles(t, dir)}
+}
+
+func runKati(t *testing.T, kati string, tc testCase, ninja bool) result {
+	dir := setup(t, tc)
+	args := []string{"--use_find_emulator", "SHELL=/bin/bash"}
+	if ninja {
+		args = append(args, "--ninja")
+	}
+	out, ok := run(dir, kati, append(args, tc.goals...)...)
+	if ok && ninja {
+		var ninjaOut []byte
+		ninjaOut, ok = run(dir, "./ninja.sh", "-j1", "-v")
+		out = append(out, normalize(ninjaOut, normalizeNinja)...)
+	}
+	return result{normalize(out, normalizeKati), ok, outputFiles(t, dir)}
+}
+
+func describeFiles(files map[string]string) string {
+	var names []string
+	for name := range files {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	var b bytes.Buffer
+	for _, name := range names {
+		b.WriteString(name + " = " + strings.TrimSuffix(files[name], "\n") + "\n")
+	}
+	return b.String()
+}
+
+func TestMain(m *testing.M) {
+	os.Unsetenv("MAKEFLAGS")
+	os.Unsetenv("MAKELEVEL")
+	os.Setenv("NINJA_STATUS", "NINJACMD: ")
+	os.Exit(m.Run())
+}
+
+func TestSecondExpansion(t *testing.T) {
+	out, err := exec.Command("make", "--version").Output()
+	if err != nil || !bytes.HasPrefix(out, []byte("GNU Make 4.2.1\n")) {
+		t.Fatalf("GNU make 4.2.1 is needed as make: %q %v", out, err)
+	}
+	root, err := filepath.Abs("..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	engines := []struct{ name, path string }{
+		{"ckati", filepath.Join(root, "ckati")},
+		{"rkati", filepath.Join(root, "target", "debug", "rkati")},
+	}
+	for _, e := range engines {
+		if _, err := os.Stat(e.path); err != nil {
+			t.Fatalf("%s must be built before testing: %v", e.name, err)
+		}
+	}
+	for _, tc := range cases {
+		tc := tc
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			for _, ninja := range []bool{false, true} {
+				want := runMake(t, tc, ninja)
+				for _, e := range engines {
+					name := e.name
+					if ninja {
+						name += "_ninja"
+					}
+					t.Run(name, func(t *testing.T) {
+						got := runKati(t, e.path, tc, ninja)
+						if got.output != want.output {
+							t.Errorf("output differs from make\nmake:\n%s\n%s:\n%s", want.output, name, got.output)
+						}
+						if got.ok != want.ok {
+							t.Errorf("make succeeded: %v, %s succeeded: %v", want.ok, name, got.ok)
+						}
+						if wantFiles, gotFiles := describeFiles(want.files), describeFiles(got.files); wantFiles != gotFiles {
+							t.Errorf("files differ from make\nmake:\n%s\n%s:\n%s", wantFiles, name, gotFiles)
+						}
+					})
+				}
+			}
+		})
+	}
+}
