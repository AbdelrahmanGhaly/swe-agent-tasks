+    // $* for a prerequisite list of `merger` that is not from a pattern: like
+    // make, the stem of the target's static pattern rule, or else the target
+    // name less the first known suffix it ends with.
+    fn plain_stem(&self, output: Symbol, merger: &RuleMerger) -> Bytes {
+        let output_str = output.as_bytes();
+        if let Some(r) = merger
+            .rules
+            .iter()
+            .rev()
+            .find(|r| !r.output_patterns.is_empty())
+        {
+            let pat = Pattern::new(r.output_patterns[0].as_bytes());
+            return Bytes::copy_from_slice(pat.stem(&output_str));
+        }
+        let name = listed_name(output_str);
+        for suffix in &self.suffixes {
+            if name.len() > suffix.len() && name.ends_with(suffix) {
+                return name.slice(..name.len() - suffix.len());
+            }
+        }
+        Bytes::new()
+    }
