+// What a prerequisite list gets its second expansion with: the automatic
+// variables, and the location messages are reported at.
+#[derive(Clone)]
+struct SecondaryContext {
+    output: Symbol,
+    stem: Bytes,
+    first_input: Bytes,
+    inputs: Vec<Symbol>,
+    order_only_inputs: Vec<Symbol>,
+    loc: Option<Loc>,
+}
+
+// The value a target-specific or pattern-specific variable has for its own
+// target, without anything inherited from the targets that need it. `scope`
+// holds what the target sees so far; outside of it is the global value. A
+// pattern's `?=` gives way to a global value, as make decides it when the
+// target's variables are set up; a target's own `?=` was decided when its
+// line was read.
+fn own_rule_var(name: Symbol, var: &Var, from_pattern: bool, scope: &Vars) -> Option<Var> {
+    let global = name.get_global_var();
+    let op = var.read().assign_op;
+    match op {
+        Some(AssignOp::PlusEq) => match scope.peek(name).or(global) {
+            Some(outer) => Some(Variable::new_appended(outer, var.clone())),
+            None => Some(var.clone()),
+        },
+        Some(AssignOp::QuestionEq) if from_pattern && global.is_some() => None,
+        _ => Some(var.clone()),
+    }
+}
+
+// The names make gives as $@ and $% for a target: an archive member
+// `lib(member)` is `lib` and `member`, anything else is the target and "".
+fn split_archive_member(name: &Bytes) -> (Bytes, Bytes) {
+    if let Some(paren) = memchr(b'(', name)
+        && paren > 0
+        && name.len() > paren + 2
+        && name.ends_with(b")")
+        && !(name[paren + 1] == b'(' && name[name.len() - 2] == b')')
+    {
+        return (name.slice(..paren), name.slice(paren + 1..name.len() - 1));
+    }
+    (name.clone(), Bytes::new())
+}
+
+// The suffixes make 4.2.1 knows until a makefile changes .SUFFIXES.
+const DEFAULT_SUFFIXES: &[u8] = b".out .a .ln .o .c .cc .C .cpp .p .f .F .m .r .y .l .ym .yl \
+    .s .S .mod .sym .def .h .info .dvi .tex .texinfo .texi .txinfo .w .ch .web .sh .elc .el";
+
+// The name make uses for a file in $^, $+ and $|, and to find the $* of a
+// target without a pattern: an archive member by its member name.
+fn listed_name(name: Bytes) -> Bytes {
+    let (_, member) = split_archive_member(&name);
+    if member.is_empty() { name } else { member }
+}
+
+// Where make reports messages from the second expansion of a target whose
+// recipe is `r`: the first line of the recipe, which is the rule's own line
+// for a recipe after `;`. Without a recipe there is no location.
+fn recipe_loc(r: Option<&Rule>) -> Option<Loc> {
+    let r = r?;
+    if r.cmds.is_empty() {
+        return None;
+    }
+    r.cmd_loc.clone().or_else(|| Some(r.loc.clone()))
+}
+
+fn add_secondary_var(scope: &Vars, name: &str, value: Bytes) {
+    let mut dirs = BytesMut::new();
+    let mut bases = BytesMut::new();
+    {
+        let mut dw = WordWriter::new(&mut dirs);
+        let mut bw = WordWriter::new(&mut bases);
+        for tok in word_scanner(&value) {
+            dw.write(&dirname(&value.slice_ref(tok)));
+            bw.write(basename(tok));
+        }
+    }
+    let mut vars = scope.0.lock();
+    for (name, value) in [
+        (name.to_string(), value),
+        (format!("{name}D"), dirs.freeze()),
+        (format!("{name}F"), bases.freeze()),
+    ] {
+        vars.insert(
+            intern(name),
+            Variable::with_simple_string(value, VarOrigin::Automatic, None, None),
+        );
+    }
+}
+
+// Replaces `%' with `$*' the way make does before the second expansion:
+// every `%' of a static pattern rule, but only the first `%' of each word
+// of a pattern rule. A variable reference stays inside its word.
+fn subst_secondary_stem(r: &Rule, text: &Bytes) -> Bytes {
+    if r.output_patterns.is_empty() {
+        return text.clone();
+    }
+    let mut out = BytesMut::with_capacity(text.len() + 2);
+    if !r.outputs.is_empty() {
+        for &c in text.iter() {
+            if c == b'%' {
+                out.put_slice(b"$*");
+            } else {
+                out.put_u8(c);
+            }
+        }
+        return out.freeze();
+    }
+    let mut i = 0;
+    while i < text.len() {
+        if is_space_byte(&text[i]) {
+            out.put_u8(text[i]);
+            i += 1;
+            continue;
+        }
+        let beg = i;
+        while i < text.len() && !is_space_byte(&text[i]) {
+            let c = text[i];
+            i += 1;
+            if c == b'|' {
+                break;
+            }
+            if c != b'$' || i == text.len() {
+                continue;
+            }
+            let open = text[i];
+            i += 1;
+            if open != b'(' && open != b'{' {
+                continue;
+            }
+            let close = if open == b'(' { b')' } else { b'}' };
+            let mut depth = 0;
+            while i < text.len() {
+                if text[i] == open {
+                    depth += 1;
+                } else if text[i] == close {
+                    depth -= 1;
+                    if depth < 0 {
+                        i += 1;
+                        break;
+                    }
+                }
+                i += 1;
+            }
+        }
+        let word = &text[beg..i];
+        if let Some(pct) = memchr(b'%', word) {
+            out.put_slice(&word[..pct]);
+            out.put_slice(b"$*");
+            out.put_slice(&word[pct + 1..]);
+        } else {
+            out.put_slice(word);
+        }
+    }
+    out.freeze()
+}
