+const { TestEnvironment } = require('jest-environment-node');
+
+class UniqueNamesEnvironment extends TestEnvironment {
+    constructor(config, context) {
+        super(config, context);
+        this.seenNames = new Map();
+    }
+
+    handleTestEvent(event, state) {
+        if (event.name !== 'add_test') return;
+        const block = state.currentDescribeBlock;
+        const test = block.children[block.children.length - 1];
+        const names = [test.name];
+        for (let b = block; b && b.parent; b = b.parent) names.unshift(b.name);
+        const fullName = names.join(' ');
+        const count = (this.seenNames.get(fullName) || 0) + 1;
+        this.seenNames.set(fullName, count);
+        if (count > 1) test.name = `${test.name} (${count})`;
+    }
+}
+
+module.exports = UniqueNamesEnvironment;
