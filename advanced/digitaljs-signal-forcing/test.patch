+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() { echo "usage: $0 [--output_path <path>] base|new" >&2; exit 2; }
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new) MODE="$1"; MODE_COUNT=$((MODE_COUNT + 1)); shift ;;
+    --output_path) shift; [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }; OUTPUT_PATH="$1"; shift ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    *) echo "unknown argument: $1" >&2; usage ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")"
+ROOT="$(pwd)"
+[ -n "$OUTPUT_PATH" ] || OUTPUT_PATH="$ROOT/junit-$MODE.xml"
+case "$OUTPUT_PATH" in /*) ;; *) OUTPUT_PATH="$ROOT/$OUTPUT_PATH" ;; esac
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+NEW_TESTS="tests/pinned_ports_11f5af.test.mjs"
+JEST_JUNIT_REPORTER="$(npm root -g)/jest-junit"
+export JEST_JUNIT_OUTPUT_FILE="$OUTPUT_PATH"
+export JEST_JUNIT_REPORT_TEST_SUITE_ERRORS=true
+
+write_failure() {
+  cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites name="jest tests" tests="1" failures="1" errors="0" time="0">
+<testsuite name="$MODE" tests="1" failures="1" errors="0" time="0">
+<testcase classname="$MODE" name="$1" time="0">
+<failure message="$1">$2</failure>
+</testcase>
+</testsuite>
+</testsuites>
+XMLEOF
+}
+
+rm -rf lib
+if ! BUILD_LOG="$(./node_modules/.bin/babel src -d lib 2>&1)"; then
+  printf '%s\n' "$BUILD_LOG" >&2
+  write_failure "library build" "$(printf '%s' "$BUILD_LOG" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+  exit 1
+fi
+
+JEST_LOG="$(mktemp)"
+if [ "$MODE" = "base" ]; then
+  # The whole existing suite runs. It reuses identical test names within a describe block; the
+  # environment numbers repeated names so every result is reported under its own name.
+  # Math.random is seeded, so the randomized logic table checks and the randomly drawn constants
+  # are the same on every run.
+  timeout 1500 ./node_modules/.bin/jest tests/index.test.mjs --ci --forceExit \
+    --testEnvironment "$ROOT/tests/unique_names_f2a2e1.js" \
+    --setupFiles "$ROOT/tests/seeded_random_f890fd.js" \
+    --reporters=default --reporters="$JEST_JUNIT_REPORTER" 2>&1 | tee "$JEST_LOG"
+  STATUS=${PIPESTATUS[0]}
+  # The two constant-operand families repeat each comparison, arithmetic and shift check for many
+  # constants and widths (10,344 of the 11,880 cases). The report lists them as one case per
+  # engine, operation and family; that case fails, naming its failing tests, if any of them fails.
+  if [ -f "$OUTPUT_PATH" ]; then
+    node "$ROOT/tests/grouped_report_d98768.js" "$OUTPUT_PATH" || STATUS=1
+  fi
+else
+  timeout 1500 ./node_modules/.bin/jest "$NEW_TESTS" --ci --forceExit \
+    --reporters=default --reporters="$JEST_JUNIT_REPORTER" 2>&1 | tee "$JEST_LOG"
+  STATUS=${PIPESTATUS[0]}
+fi
+
+if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  write_failure "jest run" "jest exited with status $STATUS without reporting any test. Last lines of its output:
+$(tail -n 60 "$JEST_LOG" | tr -d '\000-\010\013\014\016-\037' | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+  [ "$STATUS" -ne 0 ] || STATUS=1
+fi
+rm -f "$JEST_LOG"
+exit "$STATUS"
