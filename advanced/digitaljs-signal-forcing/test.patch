@@ -0,0 +1,42 @@
+const fs = require('fs');
+
+const file = process.argv[2];
+const testcasePattern = /\n\s*<testcase [^>]*?(?:\/>|>[\s\S]*?<\/testcase>)/g;
+const familyPattern = /^(\S+) (\S+) with (constant|\d+ bits constant) /;
+const failed = testcase => /<(failure|error)\b/.test(testcase);
+let totalTests = 0;
+let totalFailures = 0;
+
+const xml = fs.readFileSync(file, 'utf8').replace(/<testsuite ([^>]*)>([\s\S]*?)<\/testsuite>/g, (suite, attrs, body) => {
+    const groups = new Map();
+    let kept = body.replace(testcasePattern, testcase => {
+        const name = / name="([^"]*)"/.exec(testcase)[1];
+        const match = familyPattern.exec(name);
+        if (!match) return testcase;
+        const key = match[1] + ' ' + match[2] + ' with ' + (match[3] == 'constant' ? 'constant' : 'bits constant');
+        const group = groups.get(key) || { cases: 0, time: 0, failures: [] };
+        group.cases++;
+        group.time += Number((/ time="([^"]*)"/.exec(testcase) || [])[1]) || 0;
+        if (failed(testcase)) {
+            const detail = /<(?:failure|error)\b[^>]*>([\s\S]*?)<\/(?:failure|error)>/.exec(testcase);
+            group.failures.push(detail ? name + '\n' + detail[1] : name);
+        }
+        groups.set(key, group);
+        return '';
+    }).replace(/\s*$/, '');
+    for (const [key, group] of groups) {
+        kept += `\n    <testcase classname="${key}" name="${key} (all ${group.cases} cases)" time="${group.time.toFixed(3)}">`;
+        if (group.failures.length)
+            kept += `\n      <failure message="${group.failures.length} of ${group.cases} failed">${group.failures.join('\n\n')}</failure>`;
+        kept += '\n    </testcase>';
+    }
+    const testcases = kept.match(testcasePattern) || [];
+    const failures = testcases.filter(failed).length;
+    totalTests += testcases.length;
+    totalFailures += failures;
+    attrs = attrs.replace(/ tests="\d+"/, ` tests="${testcases.length}"`).replace(/ failures="\d+"/, ` failures="${failures}"`);
+    return `<testsuite ${attrs}>${kept}\n  </testsuite>`;
+});
+
+fs.writeFileSync(file, xml.replace(/<testsuites ([^>]*)>/, (tag, attrs) =>
+    `<testsuites ${attrs.replace(/ tests="\d+"/, ` tests="${totalTests}"`).replace(/ failures="\d+"/, ` failures="${totalFailures}"`)}>`));
