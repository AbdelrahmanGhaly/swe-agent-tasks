diff --git a/test.sh b/test.sh
new file mode 100755
index 00000000..753c4a70
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,145 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      if [ $# -lt 1 ] || [ -z "$1" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      if [ -z "$OUTPUT_PATH" ]; then
+        echo "missing value for --output_path" >&2
+        usage
+      fi
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")"
+
+NEW_TESTS=(test/test-decoded-duration-cfccbf.js)
+EXCLUDED_TESTS=(
+  test/test-decoded-duration-cfccbf.js
+  test/test-radio-streams.js
+)
+
+LOG="$(mktemp)"
+BUILD_LOG="$(mktemp)"
+(
+  status=0
+  node_modules/.bin/del-cli 'lib/**/*.js' 'lib/**/*.js.map' 'lib/**/*.d.ts' 'test/**/*.js' 'test/**/*.js.map' 'test/**/*.d.ts' || status=1
+  node_modules/.bin/tsc -p test || status=1
+  node_modules/.bin/tsc -p lib/tsconfig.json || status=1
+  exit "$status"
+) 2>&1 | tee "$BUILD_LOG"
+BUILD_STATUS=${PIPESTATUS[0]}
+cat "$BUILD_LOG" >> "$LOG"
+
+if [ "$MODE" = "new" ]; then
+  SPECS=("${NEW_TESTS[@]}")
+else
+  SPECS=()
+  for spec in test/*.js; do
+    skip=0
+    for excluded in "${EXCLUDED_TESTS[@]}"; do
+      [ "$spec" = "$excluded" ] && skip=1
+    done
+    [ "$skip" -eq 0 ] && SPECS+=("$spec")
+  done
+fi
+
+ARGS=(--no-config --no-package --timeout 40000)
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  rm -f "$OUTPUT_PATH"
+  ARGS+=(--reporter xunit --reporter-option "output=$OUTPUT_PATH")
+fi
+
+node_modules/.bin/mocha "${ARGS[@]}" "${SPECS[@]}" 2>&1 | tee -a "$LOG"
+STATUS=${PIPESTATUS[0]}
+
+if [ -n "$OUTPUT_PATH" ] && [ -f "$OUTPUT_PATH" ]; then
+  node --input-type=commonjs - "$OUTPUT_PATH" "$BUILD_STATUS" "$BUILD_LOG" "$MODE" <<'JSEOF'
+const fs = require('node:fs');
+const [outputPath, buildStatus, buildLogPath, mode] = process.argv.slice(2);
+const escape = text => text.replace(/[<>&"]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[c]);
+const seen = new Map();
+let report = fs
+  .readFileSync(outputPath, 'utf8')
+  .replace(/<testcase classname="([^"]*)" name="([^"]*)"/g, (testcase, classname, name) => {
+    const key = `${classname}\n${name}`;
+    const count = (seen.get(key) ?? 0) + 1;
+    seen.set(key, count);
+    return count === 1 ? testcase : `<testcase classname="${classname}" name="${name} (${count})"`;
+  });
+if (buildStatus !== '0' && report.includes('</testsuite>')) {
+  const detail = fs.readFileSync(buildLogPath, 'utf8').split('\n').slice(-200).join('\n') || 'the build printed nothing';
+  report = report
+    .replace(/<testsuite\b[^>]*>/, tag =>
+      tag
+        .replace(/\btests="(\d+)"/, (_, count) => `tests="${Number(count) + 1}"`)
+        .replace(/\berrors="(\d+)"/, (_, count) => `errors="${Number(count) + 1}"`)
+    )
+    .replace(
+      '</testsuite>',
+      `<testcase classname="mocha.${mode}" name="TypeScript build" time="0">` +
+        `<error message="${escape(`the TypeScript build exited with status ${buildStatus}`)}">${escape(detail)}</error>` +
+        '</testcase>\n</testsuite>'
+    );
+}
+fs.writeFileSync(outputPath, report);
+JSEOF
+fi
+
+if [ -n "$OUTPUT_PATH" ] && ! grep -q "<testcase" "$OUTPUT_PATH" 2>/dev/null; then
+  node --input-type=commonjs - "$OUTPUT_PATH" "$LOG" "$STATUS" "$MODE" <<'JSEOF'
+const fs = require('node:fs');
+const [outputPath, logPath, status, mode] = process.argv.slice(2);
+const escape = text => text.replace(/[<>&"]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[c]);
+const lines = fs.readFileSync(logPath, 'utf8').split('\n');
+const detail = lines.slice(-200).join('\n') || 'mocha printed nothing';
+fs.writeFileSync(
+  outputPath,
+  '<?xml version="1.0" encoding="UTF-8"?>\n' +
+    `<testsuite name="Mocha Tests" tests="1" failures="0" errors="1" skipped="0">\n` +
+    `<testcase classname="mocha.${mode}" name="build and collection" time="0">` +
+    `<error message="${escape(`tests exited with status ${status} without results`)}">${escape(detail)}</error>` +
+    '</testcase>\n</testsuite>\n'
+);
+JSEOF
+  if [ "$STATUS" -eq 0 ]; then
+    STATUS=1
+  fi
+fi
+if [ "$BUILD_STATUS" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+  STATUS=1
+fi
+rm -f "$LOG" "$BUILD_LOG"
+
+exit "$STATUS"
diff --git a/test/mp4-rewrite-cfccbf.ts b/test/mp4-rewrite-cfccbf.ts
new file mode 100644
index 00000000..c4d71685
--- /dev/null
+++ b/test/mp4-rewrite-cfccbf.ts
@@ -0,0 +1,305 @@
+import { concatUint8Arrays } from 'uint8array-extras';
+
+export type Edit = [segmentDuration: number, mediaTime: number];
+
+interface IBox {
+  type: string;
+  start: number;
+  end: number;
+}
+
+type BoxRewrite = (box: IBox) => Uint8Array[] | undefined;
+
+const containers = ['moov', 'trak', 'mdia', 'minf', 'stbl', 'edts'];
+
+function view(data: Uint8Array): DataView {
+  return new DataView(data.buffer, data.byteOffset, data.byteLength);
+}
+
+function latin1(text: string): Uint8Array {
+  return Uint8Array.from(text, char => char.charCodeAt(0));
+}
+
+function children(data: Uint8Array, start: number, end: number): IBox[] {
+  const boxes: IBox[] = [];
+  for (let offset = start; offset + 8 <= end; ) {
+    let size = view(data).getUint32(offset);
+    if (size === 1) {
+      size = Number(view(data).getBigUint64(offset + 8));
+    } else if (size === 0) {
+      size = end - offset;
+    }
+    boxes.push({
+      type: String.fromCharCode(...data.subarray(offset + 4, offset + 8)),
+      start: offset,
+      end: offset + size
+    });
+    offset += size;
+  }
+  return boxes;
+}
+
+function child(data: Uint8Array, parent: IBox | undefined, type: string): IBox | undefined {
+  return parent ? children(data, parent.start + 8, parent.end).find(box => box.type === type) : undefined;
+}
+
+function box(type: string, ...payloads: Uint8Array[]): Uint8Array {
+  const payload = concatUint8Arrays(payloads);
+  const header = new Uint8Array(8);
+  view(header).setUint32(0, 8 + payload.length);
+  header.set(latin1(type), 4);
+  return concatUint8Arrays([header, payload]);
+}
+
+function isAudioTrack(data: Uint8Array, trak: IBox): boolean {
+  const handler = child(data, child(data, trak, 'mdia'), 'hdlr');
+  return (
+    trak.type === 'trak' &&
+    handler !== undefined &&
+    String.fromCharCode(...data.subarray(handler.start + 16, handler.start + 20)) === 'soun'
+  );
+}
+
+function rebuild(data: Uint8Array, parent: IBox, rewrite: BoxRewrite): Uint8Array {
+  const parts = children(data, parent.start + 8, parent.end).flatMap(
+    current =>
+      rewrite(current) ??
+      (containers.includes(current.type)
+        ? [rebuild(data, current, rewrite)]
+        : [data.subarray(current.start, current.end)])
+  );
+  return box(parent.type, ...parts);
+}
+
+function shiftChunkOffsets(moov: Uint8Array, start: number, end: number, delta: number): void {
+  const fields = view(moov);
+  for (const { type, start: boxStart, end: boxEnd } of children(moov, start, end)) {
+    if (['trak', 'mdia', 'minf', 'stbl'].includes(type)) {
+      shiftChunkOffsets(moov, boxStart + 8, boxEnd, delta);
+    } else if (type === 'stco' || type === 'co64') {
+      const count = fields.getUint32(boxStart + 12);
+      for (let n = 0; n < count; ++n) {
+        if (type === 'stco') {
+          const offset = boxStart + 16 + 4 * n;
+          fields.setUint32(offset, fields.getUint32(offset) + delta);
+        } else {
+          const offset = boxStart + 16 + 8 * n;
+          fields.setBigUint64(offset, fields.getBigUint64(offset) + BigInt(delta));
+        }
+      }
+    }
+  }
+}
+
+function rewriteMovie(file: Uint8Array, rewrite: BoxRewrite, append: Uint8Array[] = []): Uint8Array {
+  const topLevel = children(file, 0, file.length);
+  const moov = topLevel.find(({ type }) => type === 'moov');
+  const audio = children(file, moov.start + 8, moov.end).find(trak => isAudioTrack(file, trak));
+  const parts = children(file, moov.start + 8, moov.end).map(current =>
+    current.start === audio.start ? rebuild(file, current, rewrite) : file.subarray(current.start, current.end)
+  );
+  const newMoov = box('moov', ...parts, ...append);
+  if (topLevel.some(({ type, start }) => type === 'mdat' && start > moov.start)) {
+    shiftChunkOffsets(newMoov, 8, newMoov.length, newMoov.length - (moov.end - moov.start));
+  }
+  return concatUint8Arrays([file.subarray(0, moov.start), newMoov, file.subarray(moov.end)]);
+}
+
+function editBox(edits: Edit[], version: number): Uint8Array {
+  const entrySize = version === 1 ? 20 : 12;
+  const elst = new Uint8Array(8 + edits.length * entrySize);
+  const fields = view(elst);
+  fields.setUint8(0, version);
+  fields.setUint32(4, edits.length);
+  edits.forEach(([segmentDuration, mediaTime], index) => {
+    const offset = 8 + index * entrySize;
+    if (version === 1) {
+      fields.setBigUint64(offset, BigInt(segmentDuration));
+      fields.setBigInt64(offset + 8, BigInt(mediaTime));
+      fields.setUint32(offset + 16, 0x10000);
+    } else {
+      fields.setUint32(offset, segmentDuration);
+      fields.setInt32(offset + 4, mediaTime);
+      fields.setUint32(offset + 8, 0x10000);
+    }
+  });
+  return box('edts', box('elst', elst));
+}
+
+export function withEditList(file: Uint8Array, edits: Edit[] | undefined, version = 0): Uint8Array {
+  return rewriteMovie(file, current => {
+    if (current.type === 'edts') {
+      return [];
+    }
+    if (current.type === 'tkhd' && edits) {
+      return [file.subarray(current.start, current.end), editBox(edits, version)];
+    }
+    return undefined;
+  });
+}
+
+export function withTimeScale(file: Uint8Array, timeScale: number): Uint8Array {
+  const moov = children(file, 0, file.length).find(({ type }) => type === 'moov');
+  const audio = children(file, moov.start + 8, moov.end).find(trak => isAudioTrack(file, trak));
+  const mdhd = child(file, child(file, audio, 'mdia'), 'mdhd');
+  const version = file[mdhd.start + 8];
+  const oldTimeScale = view(file).getUint32(mdhd.start + (version === 1 ? 28 : 20));
+  const rescale = (time: number) => Math.floor((time * timeScale * 2 + oldTimeScale) / (2 * oldTimeScale));
+  return rewriteMovie(file, current => {
+    const payload = file.slice(current.start + 8, current.end);
+    const fields = view(payload);
+    switch (current.type) {
+      case 'mdhd':
+        if (version === 1) {
+          fields.setUint32(20, timeScale);
+          fields.setBigUint64(24, BigInt(rescale(Number(fields.getBigUint64(24)))));
+        } else {
+          fields.setUint32(12, timeScale);
+          fields.setUint32(16, rescale(fields.getUint32(16)));
+        }
+        return [box('mdhd', payload)];
+      case 'stts': {
+        const runs: [number, number][] = [];
+        let time = 0;
+        let previous = 0;
+        for (let entry = 0; entry < fields.getUint32(4); ++entry) {
+          const count = fields.getUint32(8 + 8 * entry);
+          const duration = fields.getUint32(12 + 8 * entry);
+          for (let n = 0; n < count; ++n) {
+            time += duration;
+            const next = rescale(time);
+            const ticks = next - previous;
+            previous = next;
+            if (runs.length > 0 && runs[runs.length - 1][1] === ticks) {
+              runs[runs.length - 1][0]++;
+            } else {
+              runs.push([1, ticks]);
+            }
+          }
+        }
+        const stts = new Uint8Array(8 + 8 * runs.length);
+        view(stts).setUint32(4, runs.length);
+        runs.forEach(([count, ticks], index) => {
+          view(stts).setUint32(8 + 8 * index, count);
+          view(stts).setUint32(12 + 8 * index, ticks);
+        });
+        return [box('stts', stts)];
+      }
+      case 'elst': {
+        const entrySize = payload[0] === 1 ? 20 : 12;
+        for (let entry = 0; entry < fields.getUint32(4); ++entry) {
+          const offset = 8 + entry * entrySize + (entrySize === 20 ? 8 : 4);
+          const mediaTime = entrySize === 20 ? Number(fields.getBigInt64(offset)) : fields.getInt32(offset);
+          if (mediaTime >= 0) {
+            if (entrySize === 20) {
+              fields.setBigInt64(offset, BigInt(rescale(mediaTime)));
+            } else {
+              fields.setInt32(offset, rescale(mediaTime));
+            }
+          }
+        }
+        return [box('elst', payload)];
+      }
+      default:
+        return undefined;
+    }
+  });
+}
+
+export function withMoovFirst(file: Uint8Array): Uint8Array {
+  const topLevel = children(file, 0, file.length);
+  const moov = topLevel.find(({ type }) => type === 'moov');
+  const mdat = topLevel.find(({ type }) => type === 'mdat');
+  if (moov.start < mdat.start) {
+    return file;
+  }
+  const movie = file.slice(moov.start, moov.end);
+  shiftChunkOffsets(movie, 8, movie.length, movie.length);
+  return concatUint8Arrays([
+    file.subarray(0, mdat.start),
+    movie,
+    file.subarray(mdat.start, moov.start),
+    file.subarray(moov.end)
+  ]);
+}
+
+export function withITunSMPB(file: Uint8Array, value: string): Uint8Array {
+  const fullBox = (type: string, ...payloads: Uint8Array[]) => box(type, new Uint8Array(4), ...payloads);
+  const handler = fullBox('hdlr', new Uint8Array(4), latin1('mdirappl'), new Uint8Array(9));
+  const item = box(
+    '----',
+    fullBox('mean', latin1('com.apple.iTunes')),
+    fullBox('name', latin1('iTunSMPB')),
+    box('data', new Uint8Array([0, 0, 0, 1, 0, 0, 0, 0]), latin1(value))
+  );
+  return rewriteMovie(file, () => undefined, [box('udta', fullBox('meta', handler, box('ilst', item)))]);
+}
+
+export function withTracksReversed(file: Uint8Array): Uint8Array {
+  const moov = children(file, 0, file.length).find(({ type }) => type === 'moov');
+  const parts = children(file, moov.start + 8, moov.end);
+  const tracks = parts.filter(({ type }) => type === 'trak').reverse();
+  const reordered = parts.map(current => (current.type === 'trak' ? tracks.shift() : current));
+  return concatUint8Arrays([
+    file.subarray(0, moov.start),
+    box('moov', ...reordered.map(({ start, end }) => file.subarray(start, end))),
+    file.subarray(moov.end)
+  ]);
+}
+
+export function withSilentFrames(file: Uint8Array, frames: number): Uint8Array {
+  const topLevel = children(file, 0, file.length);
+  const mdat = topLevel.find(({ type }) => type === 'mdat');
+  const moov = topLevel.find(({ type }) => type === 'moov');
+  const audio = children(file, moov.start + 8, moov.end).find(trak => isAudioTrack(file, trak));
+  const stbl = child(file, child(file, child(file, audio, 'mdia'), 'minf'), 'stbl');
+  const frameSize = view(file).getUint32(child(file, stbl, 'stsz').start + 12);
+  const table = (type: string, ...fields: number[]) => {
+    const payload = new Uint8Array(4 + 4 * fields.length);
+    fields.forEach((field, index) => {
+      view(payload).setUint32(4 + 4 * index, field);
+    });
+    return [box(type, payload)];
+  };
+  const movie = rewriteMovie(file, current => {
+    switch (current.type) {
+      case 'stts':
+        return table('stts', 1, frames, 1);
+      case 'stsc':
+        return table('stsc', 1, 1, frames, 1);
+      case 'stsz':
+        return table('stsz', frameSize, frames);
+      case 'stco':
+        return table('stco', 1, mdat.start + 8);
+      default:
+        return undefined;
+    }
+  });
+  const newMoov = children(movie, 0, movie.length).find(({ type }) => type === 'moov');
+  const header = new Uint8Array(8);
+  view(header).setUint32(0, 8 + frames * frameSize);
+  header.set(latin1('mdat'), 4);
+  return concatUint8Arrays([
+    file.subarray(0, mdat.start),
+    header,
+    new Uint8Array(frames * frameSize),
+    movie.subarray(newMoov.start, newMoov.end)
+  ]);
+}
+
+export function withCompositionOffsets(file: Uint8Array): Uint8Array {
+  return rewriteMovie(file, current => {
+    if (current.type !== 'stts') {
+      return undefined;
+    }
+    const fields = view(file);
+    let samples = 0;
+    for (let entry = 0; entry < fields.getUint32(current.start + 12); ++entry) {
+      samples += fields.getUint32(current.start + 16 + 8 * entry);
+    }
+    const ctts = new Uint8Array(16);
+    view(ctts).setUint32(4, 1);
+    view(ctts).setUint32(8, samples);
+    return [file.subarray(current.start, current.end), box('ctts', ctts)];
+  });
+}
