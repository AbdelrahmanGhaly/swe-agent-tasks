+import { samplePath } from './util.js';
+
+const decoded: mm.IOptions & { decodedDuration: boolean } = { decodedDuration: true };
+
+function checkDecoded(
+  format: Pick<mm.IFormat, 'numberOfSamples' | 'sampleRate' | 'duration'>,
+  numberOfSamples: number,
+  sampleRate: number
+) {
+  assert.strictEqual(format.numberOfSamples, numberOfSamples, 'format.numberOfSamples');
+  assert.strictEqual(format.sampleRate, sampleRate, 'format.sampleRate');
+  assert.approximately(format.duration ?? Number.NaN, numberOfSamples / sampleRate, 1e-9, 'format.duration');
+}
+
+function readSample(file: string): Uint8Array {
+  return new Uint8Array(fs.readFileSync(path.join(samplePath, file)));
+}
