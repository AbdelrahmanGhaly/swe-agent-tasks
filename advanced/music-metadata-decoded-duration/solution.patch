+export class ElstAtom implements IGetToken<IEditListEntry[]> {
+  public constructor(public len: number) {}
+
+  public get(buf: Uint8Array, off: number): IEditListEntry[] {
+    const version = Token.UINT8.get(buf, off);
+    const entrySize = version === 1 ? 20 : 12;
+    const entries: IEditListEntry[] = [];
+    let pos = off + 8;
+    for (let n = Token.UINT32_BE.get(buf, off + 4); n > 0 && pos + entrySize <= off + this.len; --n) {
+      entries.push(
+        version === 1
+          ? {
+              segmentDuration: Number(Token.UINT64_BE.get(buf, pos)),
+              mediaTime: Number(Token.INT64_BE.get(buf, pos + 8))
+            }
+          : { segmentDuration: Token.UINT32_BE.get(buf, pos), mediaTime: Token.INT32_BE.get(buf, pos + 4) }
+      );
+      pos += entrySize;
+    }
+    return entries;
+  }
+}
+
+/**
+ * Decoder configuration from an elementary stream descriptor ('esds')
+ */
+export interface IDecoderConfig {
+  /**
+   * MPEG-4 object type indication, e.g. 0x40 for MPEG-4 audio, 0x6B for MPEG-1 audio
+   */
+  objectTypeIndication: number;
+  /**
+   * Audio object type from the AudioSpecificConfig, for MPEG-4 audio and MPEG-2 AAC
+   */
+  audioObjectType?: number;
+  /**
+   * Samples per AAC frame: 960 or 1024
+   */
+  frameLength?: number;
+}
+
+function readDescriptor(
+  buf: Uint8Array,
+  off: number,
+  end: number
+): { tag: number; start: number; end: number } | undefined {
+  if (off >= end) {
+    return undefined;
+  }
+  const tag = buf[off++];
+  let length = 0;
+  for (let n = 0; n < 4 && off < end; ++n) {
+    const byte = buf[off++];
+    length = (length << 7) | (byte & 0x7f);
+    if ((byte & 0x80) === 0) {
+      break;
+    }
+  }
+  return { tag, start: off, end: Math.min(off + length, end) };
+}
+
+/**
+ * Read the decoder configuration of an 'esds' atom payload
+ * Ref: ISO/IEC 14496-1 ES_Descriptor and ISO/IEC 14496-3 AudioSpecificConfig
+ */
+export function readDecoderConfig(buf: Uint8Array): IDecoderConfig | undefined {
+  const es = readDescriptor(buf, 4, buf.length);
+  if (es?.tag !== 0x03 || es.end - es.start < 3) {
+    return undefined;
+  }
+  const esFlags = buf[es.start + 2];
+  let off = es.start + 3;
+  if (esFlags & 0x80) {
+    off += 2;
+  }
+  if (esFlags & 0x40) {
+    off += 1 + (buf[off] ?? 0);
+  }
+  if (esFlags & 0x20) {
+    off += 2;
+  }
+  const dc = readDescriptor(buf, off, es.end);
+  if (dc?.tag !== 0x04 || dc.end - dc.start < 13) {
+    return undefined;
+  }
+  const config: IDecoderConfig = { objectTypeIndication: buf[dc.start] };
+  const dsi = readDescriptor(buf, dc.start + 13, dc.end);
+  if (![0x40, 0x66, 0x67, 0x68].includes(config.objectTypeIndication) || !dsi || dsi.tag !== 0x05) {
+    return config;
+  }
+  const asc = buf.subarray(dsi.start, dsi.end);
+  let bit = 0;
+  const read = (len: number): number => {
+    const value = util.getBitAllignedNumber(asc, 0, bit, len);
+    bit += len;
+    return value;
+  };
+  let audioObjectType = read(5);
+  if (audioObjectType === 31) {
+    audioObjectType = 32 + read(6);
+  }
+  if (read(4) === 0x0f) {
+    read(24);
+  }
+  read(4);
+  config.audioObjectType = audioObjectType;
+  if ([1, 2, 3, 4, 6, 7, 17, 19, 20, 21, 22, 23].includes(audioObjectType)) {
+    config.frameLength = read(1) ? 960 : 1024;
+  }
+  return config;
+}
