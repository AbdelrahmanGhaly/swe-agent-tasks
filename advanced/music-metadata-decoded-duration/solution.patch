+import type { IEditListEntry } from './AtomToken.js';
+
+/**
+ * Consecutive packets of a track with the same duration and the same decoded length
+ */
+export interface IPacketRun {
+  count: number;
+  /**
+   * Duration of each packet, in media time-scale units
+   */
+  ticks: number;
+  /**
+   * Sample frames the decoder outputs for each packet
+   */
+  samples: number;
+  /**
+   * Sample frames of the last frame the frame parser splits each packet into, when it is not the whole packet
+   */
+  lastFrameSamples?: number;
+}
+
+/**
+ * How the demuxer and decoder of ffmpeg 5.1 trim the decoded audio of a track
+ */
+export interface IDecoderTrim {
+  mediaTimeScale: number;
+  movieTimeScale: number;
+  editList: IEditListEntry[];
+  /**
+   * Encoder delay from an iTunSMPB tag following the track box, which replaces the samples the edit list skips (AAC)
+   */
+  encoderDelay?: number;
+  /**
+   * Samples the decoder drops itself when the container skips none (Opus pre-skip)
+   */
+  decoderDelay: number;
+  /**
+   * The frame parser hands every frame the discard flag of the frame after it (AC-3, E-AC-3)
+   */
+  delayedDiscard: boolean;
+}
+
+interface IEditedFrames {
+  /**
+   * Media time-scale units an applied edit skips, which ffmpeg drops as that many decoded samples
+   */
+  skip: number;
+  kept: number;
+  discarded: number;
+  lastDiscarded?: number;
+}
+
+export function appendPacketRun(
+  runs: IPacketRun[],
+  count: number,
+  ticks: number,
+  samples: number,
+  lastFrameSamples?: number
+): void {
+  if (count <= 0) {
+    return;
+  }
+  const last = runs[runs.length - 1];
+  if (last && last.ticks === ticks && last.samples === samples && last.lastFrameSamples === lastFrameSamples) {
+    last.count += count;
+  } else {
+    runs.push(lastFrameSamples === undefined ? { count, ticks, samples } : { count, ticks, samples, lastFrameSamples });
+  }
+}
+
+function totalSamples(runs: IPacketRun[]): number {
+  return runs.reduce((sum, run) => sum + run.count * run.samples, 0);
+}
+
+/**
+ * Locate the packet decoding starts from: ffmpeg decodes from one second before the edit, starting at the first of
+ * the packets sharing the start time of the last packet that starts at or before that point
+ */
+function findDecodeStart(runs: IPacketRun[], target: number): { run: number; index: number; start: number } {
+  let startTime = 0;
+  let time = 0;
+  for (const { count, ticks } of runs) {
+    if (time > target) {
+      break;
+    }
+    startTime = ticks > 0 ? time + Math.min(count - 1, Math.floor((target - time) / ticks)) * ticks : time;
+    time += count * ticks;
+  }
+  time = 0;
+  for (const [run, { count, ticks }] of runs.entries()) {
+    if (ticks === 0 ? time === startTime : startTime >= time && startTime < time + count * ticks) {
+      const index = ticks === 0 ? 0 : (startTime - time) / ticks;
+      return { run, index, start: time + index * ticks };
+    }
+    time += count * ticks;
+  }
+  return { run: 0, index: 0, start: 0 };
+}
+
+/**
+ * Sort the packets around an edit into decoded and discarded frames, the way ffmpeg rebuilds its index: packets ending
+ * before the edit are decoded and discarded, the packet holding the edit start is kept and partly skipped, and
+ * decoding stops after the first packet reaching the end of the edit. The last packet of a track spans the edit's
+ * whole duration.
+ */
+function applyEdit(runs: IPacketRun[], mediaTime: number, duration: number, timeScale: number): IEditedFrames {
+  const end = mediaTime + duration;
+  const frames: IEditedFrames = { skip: 0, kept: 0, discarded: 0 };
+  let started = false;
+  const discard = (count: number, span: number, { samples, lastFrameSamples }: IPacketRun) => {
+    if (!started) {
+      frames.skip += count * span;
+    }
+    frames.discarded += count * samples;
+    frames.lastDiscarded = lastFrameSamples ?? samples;
+  };
+  const decodeStart = findDecodeStart(runs, Math.max(mediaTime - timeScale, 0));
+  let time = decodeStart.start - decodeStart.index * runs[decodeStart.run].ticks;
+  for (let run = decodeStart.run, index = decodeStart.index; run < runs.length; ++run, index = 0) {
+    const packetRun = runs[run];
+    const { count, ticks, samples } = packetRun;
+    const regular = run === runs.length - 1 ? count - 1 : count;
+    while (index < regular) {
+      const start = time + index * ticks;
+      if (start < mediaTime && start + ticks > mediaTime) {
+        frames.skip += mediaTime - start;
+        frames.kept += samples;
+        started = true;
+        ++index;
+        if (start + ticks >= end) {
+          return frames;
+        }
+      } else if (start < mediaTime || start >= end) {
+        const stop =
+          start < mediaTime
+            ? ticks > 0
+              ? Math.min(regular, Math.floor((mediaTime - time) / ticks))
+              : regular
+            : index + 1;
+        discard(stop - index, ticks, packetRun);
+        index = stop;
+        if (time + index * ticks >= end) {
+          return frames;
+        }
+      } else {
+        started = true;
+        const last = ticks > 0 ? Math.max(index, Math.ceil((end - time) / ticks) - 1) : regular;
+        if (last < regular) {
+          frames.kept += (last - index + 1) * samples;
+          return frames;
+        }
+        frames.kept += (regular - index) * samples;
+        index = regular;
+      }
+    }
+    if (run === runs.length - 1 && index === count - 1) {
+      const start = time + index * ticks;
+      if (start < mediaTime && start + duration > mediaTime) {
+        frames.skip += mediaTime - start;
+        frames.kept += samples;
+      } else if (start < mediaTime || start >= end) {
+        discard(1, duration, packetRun);
+      } else {
+        frames.kept += samples;
+      }
+      return frames;
+    }
+    time += count * ticks;
+  }
+  return frames;
+}
+
+/**
+ * Number of sample frames ffmpeg 5.1 decodes from an audio track
+ * @param runs Packets indexed by the movie box, which the edit list applies to
+ * @param trim Edit list and delays
+ * @param appendedSamples Decoded samples of movie fragments, which follow the edited packets untrimmed
+ */
+export function decodedSampleCount(runs: IPacketRun[], trim: IDecoderTrim, appendedSamples = 0): number {
+  let frames: IEditedFrames = { skip: 0, kept: totalSamples(runs), discarded: 0 };
+  if (trim.editList.length > 0 && runs.length > 0) {
+    const edit = trim.editList.find(entry => entry.mediaTime >= 0);
+    const duration = edit ? Math.round((edit.segmentDuration * trim.mediaTimeScale) / trim.movieTimeScale) : 0;
+    // An edit lasting no media time-scale unit, also after rescaling from the movie time scale, keeps nothing
+    frames =
+      edit && duration > 0
+        ? applyEdit(runs, edit.mediaTime, duration, trim.mediaTimeScale)
+        : { skip: 0, kept: 0, discarded: 0 };
+  }
+  frames.kept += appendedSamples;
+  if (trim.delayedDiscard && frames.lastDiscarded !== undefined) {
+    frames.discarded -= frames.lastDiscarded;
+    frames.kept += frames.lastDiscarded;
+  }
+  // ffmpeg hands the decoder the skipped media time as a sample count, without rescaling it to the sample rate
+  const skip = trim.encoderDelay ?? frames.skip;
+  const decoderSkip = skip > 0 ? skip : trim.decoderDelay;
+  return Math.max(0, frames.kept - Math.max(0, decoderSkip - frames.discarded));
+}
+
+/**
+ * Encoder delay of an iTunSMPB value (reserved, encoder delay, end padding and sample count, in hexadecimal), if it lies
+ * in the range ffmpeg accepts
+ */
+export function iTunSMPBEncoderDelay(value: string): number | undefined {
+  const fields = value.trim().split(/\s+/).slice(1, 4);
+  const priming = Number.parseInt(fields[0] ?? '', 16);
+  return fields.length === 3 && fields.every(field => /^[0-9a-f]+$/i.test(field)) && priming > 0 && priming < 16384
+    ? priming
+    : undefined;
+}
+
+/**
+ * Sample frames (at 48 kHz) an Opus packet decodes to, from its table-of-contents byte
+ * Ref: https://www.rfc-editor.org/rfc/rfc6716#section-3.1
+ */
+export function opusPacketSamples(packet: Uint8Array): number {
+  if (packet.length === 0) {
+    return 0;
+  }
+  const config = packet[0] >> 3;
+  let frameSize: number;
+  if (config < 12) {
+    frameSize = [480, 960, 1920, 2880][config & 3];
+  } else if (config < 16) {
+    frameSize = config & 1 ? 960 : 480;
+  } else {
+    frameSize = 120 << (config & 3);
+  }
+  const code = packet[0] & 3;
+  const frames = code === 0 ? 1 : code < 3 ? 2 : (packet[1] ?? 0) & 0x3f;
+  return frames * frameSize;
+}
+
+const ac3Bitrates = [32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384, 448, 512, 576, 640];
+
+/**
+ * Size and decoded length of an AC-3 or E-AC-3 syncframe, from its header
+ * Ref: ETSI TS 102 366, sections 4.4.1 and E.1.2
+ */
+export function ac3Frame(header: Uint8Array): { size: number; samples: number } | undefined {
+  if (header.length < 6 || header[0] !== 0x0b || header[1] !== 0x77) {
+    return undefined;
+  }
+  const fscod = header[4] >> 6;
+  if (header[5] >> 3 <= 10) {
+    const bitrate = ac3Bitrates[(header[4] & 0x3f) >> 1];
+    if (fscod === 3 || bitrate === undefined) {
+      return undefined;
+    }
+    // Frame size in 16-bit words: 48 kHz, 44.1 kHz (padded by the odd frame size codes) and 32 kHz
+    const words =
+      fscod === 0 ? 2 * bitrate : fscod === 1 ? Math.floor((bitrate * 320) / 147) + (header[4] & 1) : 3 * bitrate;
+    return { size: 2 * words, samples: 1536 };
+  }
+  // E-AC-3 holds 1, 2, 3 or 6 audio blocks of 256 samples; a dependent substream belongs to the frame before it
+  const size = 2 * ((((header[2] & 0x07) << 8) | header[3]) + 1);
+  const blocks = fscod === 3 ? 6 : [1, 2, 3, 6][(header[4] >> 4) & 3];
+  return { size, samples: header[2] >> 6 === 1 ? 0 : 256 * blocks };
+}
+
+/**
+ * Sample frames of an MPEG audio frame, from its frame header
+ * Ref: https://www.mp3-tech.org/programmer/frame_header.html
+ */
+export function mpegFrameSamples(frame: Uint8Array): number | undefined {
+  if (frame.length < 4 || frame[0] !== 0xff || (frame[1] & 0xe0) !== 0xe0) {
+    return undefined;
+  }
+  const mpeg1 = ((frame[1] >> 3) & 3) === 3;
+  switch ((frame[1] >> 1) & 3) {
+    case 3: // Layer I
+      return 384;
+    case 2: // Layer II
+      return 1152;
+    case 1: // Layer III
+      return mpeg1 ? 1152 : 576;
+    default:
+      return undefined;
+  }
+}
+
+/**
+ * Sample frames of an ALAC frame: the frame length of the magic cookie, unless the frame header states its own
+ * Ref: https://github.com/macosforge/alac/blob/master/ALACMagicCookieDescription.txt
+ */
+export function alacFrameSamples(frame: Uint8Array, frameLength: number): number {
+  // Element tag (3 bits), instance tag (4), unused (12), has-size (1), shift (2), escape (1), then the sample count
+  if (frame.length < 7 || ((frame[2] >> 4) & 1) === 0) {
+    return frameLength;
+  }
+  return (frame[2] & 1) * 2 ** 31 + frame[3] * 2 ** 23 + frame[4] * 2 ** 15 + frame[5] * 2 ** 7 + (frame[6] >> 1);
+}
+
+/**
+ * Block size of a FLAC frame, from its frame header
+ * Ref: https://www.rfc-editor.org/rfc/rfc9639.html#name-frame-header
+ */
+export function flacBlockSize(frame: Uint8Array): number | undefined {
+  if (frame.length < 5 || frame[0] !== 0xff || (frame[1] & 0xfe) !== 0xf8) {
+    return undefined;
+  }
+  const code = frame[2] >> 4;
+  if (code === 1) {
+    return 192;
+  }
+  if (code >= 2 && code <= 5) {
+    return 576 << (code - 2);
+  }
+  if (code >= 8) {
+    return 256 << (code - 8);
+  }
+  if (code < 6) {
+    return undefined;
+  }
+  // The block size follows the frame or sample number, coded like UTF-8
+  let numberLength = 1;
+  if (frame[4] & 0x80) {
+    while (numberLength < 7 && frame[4] & (0x80 >> numberLength)) {
+      ++numberLength;
+    }
+  }
+  const offset = 4 + numberLength;
+  if (code === 6) {
+    return offset < frame.length ? frame[offset] + 1 : undefined;
+  }
+  return offset + 1 < frame.length ? ((frame[offset] << 8) | frame[offset + 1]) + 1 : undefined;
+}
