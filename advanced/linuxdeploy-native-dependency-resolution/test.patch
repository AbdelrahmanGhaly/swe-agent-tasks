+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <elf.h>
+#include <filesystem>
+#include <fnmatch.h>
+#include <fstream>
+#include <initializer_list>
+#include <iostream>
+#include <iterator>
+#include <link.h>
+#include <linux/audit.h>
+#include <linux/filter.h>
+#include <linux/seccomp.h>
+#include <map>
+#include <optional>
+#include <poll.h>
+#include <random>
+#include <signal.h>
+#include <sstream>
+#include <string>
+#include <sys/prctl.h>
+#include <sys/resource.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <utility>
+#include <vector>
+
+#include "gtest/gtest.h"
+
+#include "linuxdeploy/core/elf_file.h"
+
+namespace fs = std::filesystem;
+
+using namespace linuxdeploy::core::elf_file;
+
+namespace {
+    using Environment = std::map<std::string, std::string>;
+
+    struct ProcessResult {
+        int status = -1;
+        std::string output;
+
+        bool succeeded() const {
+            return WIFEXITED(status) && WEXITSTATUS(status) == 0;
+        }
+    };
+
+    std::string readAll(int fd) {
+        std::string data;
+        char buffer[4096];
+
+        while (true) {
+            const auto count = read(fd, buffer, sizeof(buffer));
+
+            if (count < 0 && errno == EINTR)
+                continue;
+
+            if (count <= 0)
+                break;
+
+            data.append(buffer, static_cast<size_t>(count));
+        }
+
+        return data;
+    }
+
+    void writeAll(int fd, const std::string& data) {
+        size_t written = 0;
+
+        while (written < data.size()) {
+            const auto count = write(fd, data.data() + written, data.size() - written);
+
+            if (count < 0 && errno == EINTR)
+                continue;
+
+            if (count <= 0)
+                return;
+
+            written += static_cast<size_t>(count);
+        }
+    }
+
+    void flushOutput() {
+        std::cout.flush();
+        std::cerr.flush();
+        fflush(nullptr);
+    }
+
+    ProcessResult runProcess(const std::vector<std::string>& arguments, const fs::path& workingDirectory, const Environment& environment) {
+        std::vector<std::string> environmentStrings;
+        for (const auto& variable : environment)
+            environmentStrings.push_back(variable.first + "=" + variable.second);
+
+        std::vector<char*> argv;
+        for (const auto& argument : arguments)
+            argv.push_back(const_cast<char*>(argument.c_str()));
+        argv.push_back(nullptr);
+
+        std::vector<char*> envp;
+        for (const auto& variable : environmentStrings)
+            envp.push_back(const_cast<char*>(variable.c_str()));
+        envp.push_back(nullptr);
+
+        int fds[2];
+        if (pipe(fds) != 0)
+            throw std::runtime_error("pipe() failed");
+
+        flushOutput();
+        const auto pid = fork();
+
+        if (pid < 0)
+            throw std::runtime_error("fork() failed");
+
+        if (pid == 0) {
+            dup2(fds[1], STDOUT_FILENO);
+            dup2(fds[1], STDERR_FILENO);
+            close(fds[0]);
+            close(fds[1]);
+
+            if (chdir(workingDirectory.c_str()) != 0)
+                _exit(126);
+
+            execve(argv[0], argv.data(), envp.data());
+            _exit(127);
+        }
+
+        close(fds[1]);
+
+        ProcessResult result;
+        result.output = readAll(fds[0]);
+        close(fds[0]);
+
+        while (waitpid(pid, &result.status, 0) < 0 && errno == EINTR) {}
+
+        return result;
+    }
+
+    void runOrThrow(const std::vector<std::string>& arguments) {
+        const auto result = runProcess(arguments, fs::current_path(), {{"PATH", "/usr/bin:/bin"}, {"LC_ALL", "C"}});
+
+        if (!result.succeeded()) {
+            std::string command;
+            for (const auto& argument : arguments)
+                command += argument + " ";
+
+            throw std::runtime_error("command failed: " + command + "\n" + result.output);
+        }
+    }
+
+    void writeFile(const fs::path& path, const std::string& contents) {
+        std::ofstream ofs(path, std::ios::binary);
+        ofs << contents;
+    }
+
+    fs::path makeTemporaryDirectory(const std::string& prefix) {
+        auto pattern = (fs::temp_directory_path() / (prefix + "-XXXXXX")).string();
+
+        if (mkdtemp(pattern.data()) == nullptr)
+            throw std::runtime_error("mkdtemp() failed");
+
+        return fs::canonical(pattern);
+    }
+
+    template<typename Ehdr_T, typename Phdr_T>
+    std::string interpreterOf(const std::vector<char>& data) {
+        Ehdr_T ehdr;
+        memcpy(&ehdr, data.data(), sizeof(ehdr));
+
+        for (size_t i = 0; i < ehdr.e_phnum; ++i) {
+            Phdr_T phdr;
+            memcpy(&phdr, data.data() + ehdr.e_phoff + i * sizeof(Phdr_T), sizeof(phdr));
+
+            if (phdr.p_type == PT_INTERP)
+                return std::string(data.data() + phdr.p_offset, strnlen(data.data() + phdr.p_offset, phdr.p_filesz));
+        }
+
+        return {};
+    }
+
+    struct HostElf {
+        unsigned char elfClass = ELFCLASSNONE;
+        uint16_t machine = EM_NONE;
+        fs::path interpreter;
+    };
+
+    const HostElf& hostElf() {
+        static const HostElf host = []() {
+            std::ifstream ifs("/proc/self/exe", std::ios::binary);
+            const std::vector<char> data{std::istreambuf_iterator<char>(ifs), std::istreambuf_iterator<char>()};
+
+            HostElf result;
+            result.elfClass = static_cast<unsigned char>(data[EI_CLASS]);
+            memcpy(&result.machine, data.data() + offsetof(Elf64_Ehdr, e_machine), sizeof(result.machine));
+
+            if (result.elfClass == ELFCLASS64)
+                result.interpreter = interpreterOf<Elf64_Ehdr, Elf64_Phdr>(data);
+            else
+                result.interpreter = interpreterOf<Elf32_Ehdr, Elf32_Phdr>(data);
+
+            return result;
+        }();
+
+        return host;
+    }
+
+    class Links {
+        public:
+            std::vector<std::string> needed;
+            std::vector<std::string> filtees;
+            std::vector<std::string> auxiliaries;
+            std::optional<std::string> rpath;
+            std::optional<std::string> runpath;
+            std::optional<std::string> soname;
+            bool withoutSoname = false;
+            bool nodeflib = false;
+
+            Links& needs(const std::string& name) {
+                needed.push_back(name);
+                return *this;
+            }
+
+            Links& withRpath(const std::string& value) {
+                rpath = value;
+                return *this;
+            }
+
+            Links& withRunpath(const std::string& value) {
+                runpath = value;
+                return *this;
+            }
+
+            Links& withSoname(const std::string& value) {
+                soname = value;
+                return *this;
+            }
+
+            Links& noSoname() {
+                withoutSoname = true;
+                return *this;
+            }
+
+            Links& noDefaultLibraries() {
+                nodeflib = true;
+                return *this;
+            }
+
+            Links& filter(const std::string& name) {
+                filtees.push_back(name);
+                return *this;
+            }
+
+            Links& auxiliary(const std::string& name) {
+                auxiliaries.push_back(name);
+                return *this;
+            }
+    };
+
+    Links needs(std::initializer_list<std::string> names) {
+        Links links;
+
+        for (const auto& name : names)
+            links.needs(name);
+
+        return links;
+    }
+
+    class Toolchain {
+        private:
+            fs::path directory;
+            std::map<std::string, fs::path> stubs;
+
+            void compile(const std::string& name, bool positionIndependent) {
+                std::vector<std::string> arguments{"/usr/bin/gcc", "-c", "-o", (directory / (name + ".o")).string(), (directory / (name + ".c")).string()};
+
+                if (positionIndependent)
+                    arguments.emplace_back("-fPIC");
+
+                runOrThrow(arguments);
+            }
+
+            fs::path stubFor(const std::string& name) {
+                const auto existing = stubs.find(name);
+
+                if (existing != stubs.end())
+                    return existing->second;
+
+                const auto stub = directory / ("stub" + std::to_string(stubs.size()) + ".so");
+
+                runOrThrow({
+                    "/usr/bin/gcc", "-shared", "-nostdlib", "-o", stub.string(), (directory / "stub.o").string(),
+                    "-Xlinker", "-soname", "-Xlinker", name,
+                });
+
+                stubs.emplace(name, stub);
+                return stub;
+            }
+
+        public:
+            Toolchain() : directory(makeTemporaryDirectory("native-deps-toolchain")) {
+                writeFile(directory / "library.c", "#include <unistd.h>\n__attribute__((constructor)) static void refuseToBeLoaded(void) { _exit(86); }\n");
+                writeFile(directory / "executable.c", "int main(void) { return 0; }\n");
+                writeFile(directory / "stub.c", "int stub;\n");
+
+                compile("library", true);
+                compile("executable", false);
+                compile("stub", true);
+            }
+
+            ~Toolchain() {
+                std::error_code error;
+                fs::remove_all(directory, error);
+            }
+
+            void link(const fs::path& output, bool sharedLibrary, const Links& links) {
+                fs::create_directories(output.parent_path());
+
+                std::vector<std::string> arguments{"/usr/bin/gcc", "-o", output.string()};
+
+                if (sharedLibrary) {
+                    arguments.emplace_back("-shared");
+                    arguments.push_back((directory / "library.o").string());
+                } else {
+                    arguments.push_back((directory / "executable.o").string());
+                }
+
+                arguments.emplace_back("-Wl,--no-as-needed");
+
+                for (const auto& name : links.needed)
+                    arguments.push_back(stubFor(name).string());
+
+                const auto addLinkerArguments = [&arguments](std::initializer_list<std::string> values) {
+                    for (const auto& value : values) {
+                        arguments.emplace_back("-Xlinker");
+                        arguments.push_back(value);
+                    }
+                };
+
+                if (sharedLibrary && !links.withoutSoname)
+                    addLinkerArguments({"-soname", links.soname.value_or(output.filename().string())});
+
+                if (links.rpath.has_value())
+                    addLinkerArguments({"--disable-new-dtags", "-rpath", links.rpath.value()});
+
+                if (links.runpath.has_value())
+                    addLinkerArguments({"--enable-new-dtags", "-rpath", links.runpath.value()});
+
+                if (links.nodeflib)
+                    addLinkerArguments({"-z", "nodefaultlib"});
+
+                for (const auto& name : links.filtees)
+                    addLinkerArguments({"--filter=" + name});
+
+                for (const auto& name : links.auxiliaries)
+                    addLinkerArguments({"--auxiliary=" + name});
+
+                runOrThrow(arguments);
+            }
+    };
+
+    Toolchain& toolchain() {
+        static Toolchain instance;
+        return instance;
+    }
+
+    fs::path buildLibrary(const fs::path& path, const Links& links = Links()) {
+        toolchain().link(path, true, links);
+        return path;
+    }
+
+    fs::path buildExecutable(const fs::path& path, const Links& links = Links()) {
+        toolchain().link(path, false, links);
+        return path;
+    }
+
+    void patchFile(const fs::path& path, size_t offset, const std::vector<unsigned char>& bytes) {
+        std::fstream file(path, std::ios::binary | std::ios::in | std::ios::out);
+        file.seekp(static_cast<std::streamoff>(offset));
+        file.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    }
+
+    fs::path copyForOtherMachine(const fs::path& from, const fs::path& to) {
+        fs::create_directories(to.parent_path());
+        fs::copy_file(from, to, fs::copy_options::overwrite_existing);
+
+        const uint16_t machine = hostElf().machine == EM_X86_64 ? EM_AARCH64 : EM_X86_64;
+        patchFile(to, offsetof(Elf64_Ehdr, e_machine), {static_cast<unsigned char>(machine & 0xff), static_cast<unsigned char>(machine >> 8)});
+
+        return to;
+    }
+
+    fs::path copyForOtherClass(const fs::path& from, const fs::path& to) {
+        fs::create_directories(to.parent_path());
+        fs::copy_file(from, to, fs::copy_options::overwrite_existing);
+
+        const unsigned char elfClass = hostElf().elfClass == ELFCLASS64 ? ELFCLASS32 : ELFCLASS64;
+        patchFile(to, EI_CLASS, {elfClass});
+
+        return to;
+    }
+
+    fs::path makeSymlink(const fs::path& target, const fs::path& link) {
+        fs::create_directories(link.parent_path());
+        fs::create_symlink(target, link);
+        return link;
+    }
+
+    struct Call {
+        fs::path workingDirectory;
+        std::optional<std::string> ldLibraryPath;
+        std::vector<std::string> excludes;
+    };
+
+    bool isExcluded(const std::string& name, const std::vector<std::string>& patterns) {
+        for (const auto& pattern : patterns) {
+            if (pattern == name || fnmatch(pattern.c_str(), name.c_str(), FNM_PATHNAME) == 0)
+                return true;
+        }
+
+        return false;
+    }
+
+    fs::path resolveFrom(const fs::path& workingDirectory, const fs::path& path) {
+        return path.is_absolute() ? path : workingDirectory / path;
+    }
+
+    bool sameFile(const fs::path& a, const fs::path& b) {
+        std::error_code error;
+        return fs::equivalent(a, b, error);
+    }
+
+    struct LddEntry {
+        std::string name;
+        std::optional<fs::path> path;
+    };
+
+    struct LddListing {
+        bool succeeded = false;
+        std::string output;
+        std::vector<LddEntry> entries;
+    };
+
+    Environment environmentFor(const Call& call) {
+        Environment environment{{"PATH", "/usr/bin:/bin"}, {"LC_ALL", "C"}};
+
+        if (call.ldLibraryPath.has_value())
+            environment["LD_LIBRARY_PATH"] = call.ldLibraryPath.value();
+
+        return environment;
+    }
+
+    LddListing runLdd(const fs::path& file, const Call& call) {
+        const auto result = runProcess({"/usr/bin/ldd", file.string()}, call.workingDirectory, environmentFor(call));
+
+        LddListing listing;
+        listing.succeeded = result.succeeded();
+        listing.output = result.output;
+
+        std::istringstream lines(result.output);
+        std::string line;
+
+        while (std::getline(lines, line)) {
+            if (line.empty() || line.front() != '\t')
+                continue;
+
+            line.erase(0, 1);
+
+            LddEntry entry;
+            const auto arrow = line.find(" => ");
+
+            if (arrow != std::string::npos) {
+                entry.name = line.substr(0, arrow);
+                const auto target = line.substr(arrow + 4);
+
+                if (target != "not found")
+                    entry.path = target.substr(0, target.rfind(" ("));
+            } else {
+                entry.name = line.substr(0, line.rfind(" ("));
+                entry.path = entry.name;
+            }
+
+            if (entry.name.rfind("linux-vdso.so", 0) == 0 || entry.name.rfind("linux-gate.so", 0) == 0)
+                continue;
+
+            if (entry.path.has_value() && sameFile(resolveFrom(call.workingDirectory, entry.path.value()), hostElf().interpreter))
+                continue;
+
+            listing.entries.push_back(entry);
+        }
+
+        return listing;
+    }
+
+    struct Traced {
+        std::string failure;
+        bool notFound = false;
+        std::string message;
+        std::vector<fs::path> paths;
+        std::vector<fs::path> loaded;
+    };
+
+    std::vector<std::string> loadedObjects() {
+        std::vector<std::string> names;
+
+        dl_iterate_phdr([](struct dl_phdr_info* info, size_t, void* data) {
+            if (info->dlpi_name != nullptr && info->dlpi_name[0] != '\0')
+                static_cast<std::vector<std::string>*>(data)->emplace_back(info->dlpi_name);
+
+            return 0;
+        }, &names);
+
+        return names;
+    }
+
+    int programAttemptFd = -1;
+
+    void reportProgramAttempt(int) {
+        const char marker = 'x';
+        if (write(programAttemptFd, &marker, 1) < 0) {}
+        _exit(87);
+    }
+
+    bool forbidRunningPrograms() {
+        const uint32_t trap = SECCOMP_RET_TRAP;
+        const uint32_t allow = SECCOMP_RET_ALLOW;
+
+        struct sock_filter filter[] = {
+            BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, arch)),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AUDIT_ARCH_X86_64, 3, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AUDIT_ARCH_AARCH64, 7, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AUDIT_ARCH_I386, 10, 0),
+            BPF_STMT(BPF_RET | BPF_K, trap),
+            BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr)),
+            BPF_JUMP(BPF_JMP | BPF_JGE | BPF_K, 0x40000000, 11, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 59, 10, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 322, 9, 0),
+            BPF_STMT(BPF_RET | BPF_K, allow),
+            BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr)),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 221, 6, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 281, 5, 0),
+            BPF_STMT(BPF_RET | BPF_K, allow),
+            BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr)),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 11, 2, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 358, 1, 0),
+            BPF_STMT(BPF_RET | BPF_K, allow),
+            BPF_STMT(BPF_RET | BPF_K, trap),
+        };
+
+        struct sock_fprog program{};
+        program.len = static_cast<unsigned short>(sizeof(filter) / sizeof(filter[0]));
+        program.filter = filter;
+
+        struct sigaction action{};
+        action.sa_handler = reportProgramAttempt;
+        sigemptyset(&action.sa_mask);
+
+        return sigaction(SIGSYS, &action, nullptr) == 0 &&
+               prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) == 0 &&
+               syscall(SYS_seccomp, SECCOMP_SET_MODE_FILTER, 0, &program) == 0;
+    }
+
+    const char loadedSeparator = '\x1d';
+
+    std::vector<fs::path> splitPaths(const std::string& data) {
+        std::vector<fs::path> paths;
+        size_t start = 0;
+
+        while (start < data.size()) {
+            const auto end = data.find('\0', start);
+            paths.emplace_back(data.substr(start, end - start));
+
+            if (end == std::string::npos)
+                break;
+
+            start = end + 1;
+        }
+
+        return paths;
+    }
+
+    std::string tracedPayload(const fs::path& file, const Call& call) {
+        if (chdir(call.workingDirectory.c_str()) != 0)
+            return "Xcould not change into " + call.workingDirectory.string();
+
+        clearenv();
+        for (const auto& variable : environmentFor(call))
+            setenv(variable.first.c_str(), variable.second.c_str(), 1);
+
+        const auto loadedBefore = loadedObjects();
+        std::string payload;
+
+        try {
+            const auto paths = ElfFile(file).traceDynamicDependencies(call.excludes);
+
+            payload = "P";
+            for (const auto& path : paths) {
+                payload += path.string();
+                payload += '\0';
+            }
+        } catch (const DependencyNotFoundError& error) {
+            payload = std::string("N") + error.what();
+        } catch (const std::exception& error) {
+            payload = std::string("Xthrew an exception other than DependencyNotFoundError: ") + error.what();
+        } catch (...) {
+            payload = "Xthrew an unknown exception";
+        }
+
+        payload += loadedSeparator;
+        for (const auto& name : loadedObjects()) {
+            if (std::find(loadedBefore.begin(), loadedBefore.end(), name) == loadedBefore.end()) {
+                payload += name;
+                payload += '\0';
+            }
+        }
+
+        return payload;
+    }
+
+    const char recordSeparator = '\x1e';
+
+    Traced parseRecord(const std::string& record) {
+        Traced traced;
+
+        const auto separator = record.find(loadedSeparator);
+        const auto result = record.substr(0, separator);
+
+        if (separator != std::string::npos)
+            traced.loaded = splitPaths(record.substr(separator + 1));
+
+        if (result.empty()) {
+            traced.failure = "returned no result";
+        } else if (result.front() == 'X') {
+            traced.failure = result.substr(1);
+        } else if (result.front() == 'N') {
+            traced.notFound = true;
+            traced.message = result.substr(1);
+        } else {
+            traced.paths = splitPaths(result.substr(1));
+        }
+
+        return traced;
+    }
+
+    std::vector<Traced> traceInChild(const fs::path& file, const std::vector<Call>& calls) {
+        std::vector<Traced> results(calls.size());
+
+        int resultFds[2];
+        int attemptFds[2];
+
+        if (pipe(resultFds) != 0 || pipe(attemptFds) != 0) {
+            for (auto& traced : results)
+                traced.failure = "could not be run: pipe() failed";
+
+            return results;
+        }
+
+        flushOutput();
+        const auto pid = fork();
+
+        if (pid == 0) {
+            close(resultFds[0]);
+            close(attemptFds[0]);
+            programAttemptFd = attemptFds[1];
+
+            const bool filtered = forbidRunningPrograms();
+
+            for (const auto& call : calls)
+                writeAll(resultFds[1], tracedPayload(file, call) + recordSeparator);
+
+            struct rusage children{};
+            if (!filtered && getrusage(RUSAGE_CHILDREN, &children) == 0 && children.ru_maxrss > 0)
+                reportProgramAttempt(0);
+
+            _exit(0);
+        }
+
+        close(resultFds[1]);
+        close(attemptFds[1]);
+
+        std::string data;
+        bool timedOut = false;
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(120);
+
+        while (true) {
+            const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now()).count();
+
+            if (remaining <= 0) {
+                timedOut = true;
+                break;
+            }
+
+            pollfd descriptor{resultFds[0], POLLIN, 0};
+            const auto ready = poll(&descriptor, 1, static_cast<int>(remaining));
+
+            if (ready < 0 && errno == EINTR)
+                continue;
+
+            if (ready == 0) {
+                timedOut = true;
+                break;
+            }
+
+            char buffer[4096];
+            const auto count = read(resultFds[0], buffer, sizeof(buffer));
+
+            if (count < 0 && errno == EINTR)
+                continue;
+
+            if (count <= 0)
+                break;
+
+            data.append(buffer, static_cast<size_t>(count));
+        }
+
+        close(resultFds[0]);
+
+        if (timedOut)
+            kill(pid, SIGKILL);
+
+        int status = 0;
+        while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}
+
+        pollfd attempt{attemptFds[0], POLLIN, 0};
+        const bool programAttempted = poll(&attempt, 1, 0) > 0 && (attempt.revents & POLLIN) != 0;
+        close(attemptFds[0]);
+
+        std::string problem;
+
+        if (programAttempted)
+            problem = "tried to run a program, which is not allowed";
+        else if (timedOut)
+            problem = "did not return within 120 seconds";
+        else if (WIFEXITED(status) && WEXITSTATUS(status) == 86)
+            problem = "loaded a library into the process (the library's constructor ran)";
+        else if (WIFSIGNALED(status))
+            problem = "crashed with signal " + std::to_string(WTERMSIG(status));
+        else if (!WIFEXITED(status) || WEXITSTATUS(status) != 0)
+            problem = "ended with exit status " + std::to_string(WEXITSTATUS(status));
+
+        size_t start = 0;
+
+        for (auto& traced : results) {
+            if (!problem.empty()) {
+                traced.failure = problem;
+                continue;
+            }
+
+            const auto end = data.find(recordSeparator, start);
+
+            if (end == std::string::npos) {
+                traced.failure = "returned no result";
+                start = data.size();
+                continue;
+            }
+
+            traced = parseRecord(data.substr(start, end - start));
+            start = end + 1;
+        }
+
+        return results;
+    }
+
+    std::string describe(const std::vector<fs::path>& paths) {
+        std::string description;
+
+        for (const auto& path : paths)
+            description += "\n    " + path.string();
+
+        return description.empty() ? "\n    (none)" : description;
+    }
+
+    void compareWithLdd(const fs::path& file, const Call& call, const Traced& traced) {
+        const auto listing = runLdd(fs::canonical(file), call);
+
+        std::ostringstream context;
+        context << "\nfile: " << file.string()
+                << "\nworking directory: " << call.workingDirectory.string()
+                << "\nLD_LIBRARY_PATH: " << call.ldLibraryPath.value_or("(unset)")
+                << "\nexcludes:";
+        for (const auto& pattern : call.excludes)
+            context << " " << pattern;
+        context << "\nldd output:\n" << listing.output;
+
+        EXPECT_TRUE(listing.succeeded) << "ldd failed" << context.str();
+
+        std::optional<std::string> expectedMissing;
+        std::vector<std::string> missingNames;
+        std::vector<fs::path> expectedPaths;
+
+        for (const auto& entry : listing.entries) {
+            if (entry.path.has_value()) {
+                expectedPaths.push_back(resolveFrom(call.workingDirectory, entry.path.value()));
+                continue;
+            }
+
+            missingNames.push_back(entry.name);
+
+            if (!expectedMissing.has_value() && !isExcluded(entry.name, call.excludes))
+                expectedMissing = entry.name;
+        }
+
+        for (const auto& loaded : traced.loaded) {
+            const auto loadedPath = resolveFrom(call.workingDirectory, loaded);
+
+            bool dependency = sameFile(loadedPath, file);
+            for (const auto& expected : expectedPaths)
+                dependency = dependency || sameFile(loadedPath, expected);
+
+            EXPECT_FALSE(dependency) << "traceDynamicDependencies loaded " << loaded.string() << " into the process" << context.str();
+        }
+
+        if (!traced.failure.empty()) {
+            ADD_FAILURE() << "traceDynamicDependencies " << traced.failure << context.str();
+            return;
+        }
+
+        if (expectedMissing.has_value()) {
+            if (!traced.notFound) {
+                ADD_FAILURE() << "expected DependencyNotFoundError for " << expectedMissing.value()
+                              << ", but got:" << describe(traced.paths) << context.str();
+                return;
+            }
+
+            EXPECT_NE(traced.message.find(expectedMissing.value()), std::string::npos)
+                << "DependencyNotFoundError should name " << expectedMissing.value() << ", got: " << traced.message << context.str();
+
+            for (const auto& other : missingNames) {
+                if (other == expectedMissing.value() || expectedMissing.value().find(other) != std::string::npos)
+                    continue;
+
+                EXPECT_EQ(traced.message.find(other), std::string::npos)
+                    << "DependencyNotFoundError names " << other << " instead of the first missing library "
+                    << expectedMissing.value() << ": " << traced.message << context.str();
+            }
+
+            return;
+        }
+
+        if (traced.notFound) {
+            ADD_FAILURE() << "unexpected DependencyNotFoundError: " << traced.message << context.str();
+            return;
+        }
+
+        for (const auto& path : traced.paths)
+            EXPECT_TRUE(path.is_absolute()) << "returned path is not absolute: " << path.string() << context.str();
+
+        bool same = traced.paths.size() == expectedPaths.size();
+        for (size_t i = 0; same && i < expectedPaths.size(); ++i)
+            same = sameFile(traced.paths[i], expectedPaths[i]);
+
+        EXPECT_TRUE(same) << "expected (in this order):" << describe(expectedPaths)
+                          << "\nbut got:" << describe(traced.paths) << context.str();
+    }
+
+    std::vector<Traced> expectSequenceSameAsLdd(const fs::path& file, const std::vector<Call>& calls) {
+        const auto results = traceInChild(file, calls);
+
+        for (size_t i = 0; i < calls.size(); ++i) {
+            SCOPED_TRACE("call " + std::to_string(i + 1) + " of " + std::to_string(calls.size()));
+            compareWithLdd(file, calls[i], results[i]);
+        }
+
+        return results;
+    }
+
+    Traced expectSameAsLdd(const fs::path& file, const Call& call) {
+        const auto results = traceInChild(file, {call});
+        compareWithLdd(file, call, results.front());
+        return results.front();
+    }
+
+    std::optional<size_t> positionOf(const Traced& traced, const fs::path& path) {
+        for (size_t i = 0; i < traced.paths.size(); ++i) {
+            if (sameFile(traced.paths[i], path))
+                return i;
+        }
+
+        return std::nullopt;
+    }
+
+    void expectListed(const Traced& traced, const fs::path& path) {
+        EXPECT_TRUE(positionOf(traced, path).has_value()) << path.string() << " is not in the result:" << describe(traced.paths);
+    }
+
+    void expectNotListed(const Traced& traced, const fs::path& path) {
+        EXPECT_FALSE(positionOf(traced, path).has_value()) << path.string() << " should not be in the result:" << describe(traced.paths);
+    }
+
+    void expectInOrder(const Traced& traced, const std::vector<fs::path>& paths) {
+        std::optional<size_t> previous;
+
+        for (const auto& path : paths) {
+            const auto position = positionOf(traced, path);
+            ASSERT_TRUE(position.has_value()) << path.string() << " is not in the result:" << describe(traced.paths);
+
+            if (previous.has_value())
+                EXPECT_LT(previous.value(), position.value()) << path.string() << " is listed too early:" << describe(traced.paths);
+
+            previous = position;
+        }
+    }
