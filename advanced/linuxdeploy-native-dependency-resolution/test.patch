+    class Random {
+        private:
+            std::mt19937 engine;
+
+        public:
+            explicit Random(uint32_t seed) : engine(seed) {}
+
+            size_t below(size_t count) {
+                return static_cast<size_t>(engine() % count);
+            }
+
+            bool chance(unsigned percent) {
+                return below(100) < percent;
+            }
+
+            template<typename T>
+            const T& pick(const std::vector<T>& values) {
+                return values[below(values.size())];
+            }
+    };
+
+    struct GraphOptions {
+        bool searchPathVariety = false;
+        bool systemLibraries = false;
+        bool missingLibraries = false;
+    };
+
+    struct Scenario {
+        fs::path input;
+        Call call;
+    };
+
+    class ScenarioBuilder {
+        private:
+            Random& random;
+            const fs::path base;
+            const GraphOptions options;
+
+            std::vector<std::string> directories;
+            std::vector<std::string> names;
+            std::vector<fs::path> files;
+            std::vector<std::string> systemNames;
+            std::string aliasDirectory;
+
+            std::string pickDirectory() {
+                return random.pick(directories);
+            }
+
+            std::vector<std::string> shuffledDirectories() {
+                auto shuffled = directories;
+
+                for (size_t i = shuffled.size(); i > 1; --i)
+                    std::swap(shuffled[i - 1], shuffled[random.below(i)]);
+
+                return shuffled;
+            }
+
+            std::string directoryReference(const std::string& directory, const std::string& owner) {
+                const auto choice = random.below(options.searchPathVariety ? 15 : 10);
+                const auto relative = fs::path(directory).lexically_relative(owner).string();
+
+                if (choice < 5)
+                    return (base / directory).string();
+
+                if (choice < 8)
+                    return "$ORIGIN/" + relative;
+
+                if (choice < 10)
+                    return "${ORIGIN}/" + relative;
+
+                if (choice == 10)
+                    return directory;
+
+                if (choice == 11)
+                    return "$ORIGIN/../" + directory;
+
+                if (choice == 12)
+                    return aliasDirectory + "/../" + directory;
+
+                return directory == "d1" ? aliasDirectory : (base / directory).string();
+            }
+
+            std::string searchPath(size_t minimum, bool forEnvironment, const std::string& owner) {
+                const auto shuffled = shuffledDirectories();
+                const auto count = std::min(shuffled.size(), minimum + random.below(shuffled.size()));
+                const std::string separator = forEnvironment && random.chance(30) ? ";" : ":";
+
+                std::string value;
+                for (size_t i = 0; i < count; ++i) {
+                    if (i > 0)
+                        value += separator;
+
+                    value += directoryReference(shuffled[i], owner);
+                }
+
+                if (options.searchPathVariety && random.chance(15))
+                    value += random.chance(50) ? separator : separator + "$ORIGIN";
+
+                return value;
+            }
+
+            std::string neededName(const std::string& owner) {
+                if (options.systemLibraries && random.chance(15))
+                    return random.pick(systemNames);
+
+                if (!files.empty() && random.chance(6)) {
+                    const auto& target = random.pick(files);
+                    const auto relative = fs::relative(target, base);
+
+                    switch (random.below(3)) {
+                        case 0:
+                            return target.string();
+                        case 1:
+                            return "$ORIGIN/" + relative.lexically_relative(owner).string();
+                        default:
+                            return relative.string();
+                    }
+                }
+
+                return random.pick(names);
+            }
+
+            Links randomLinks(bool executable, const std::string& owner) {
+                Links links;
+
+                const auto count = executable ? 2 + random.below(4) : (random.chance(25) ? 0 : 1 + random.below(3));
+                for (size_t i = 0; i < count; ++i)
+                    links.needs(neededName(owner));
+
+                const auto choice = random.below(20);
+
+                if (executable) {
+                    if (choice < 12)
+                        links.withRpath(searchPath(2, false, owner));
+                    else if (choice < 17)
+                        links.withRunpath(searchPath(2, false, owner));
+                } else {
+                    if (choice < 5)
+                        links.withRpath(searchPath(1, false, owner));
+                    else if (choice < 9)
+                        links.withRunpath(searchPath(1, false, owner));
+                }
+
+                if (random.chance(options.systemLibraries ? 12 : 4))
+                    links.noDefaultLibraries();
+
+                return links;
+            }
+
+        public:
+            ScenarioBuilder(Random& random, fs::path base, GraphOptions options)
+                : random(random), base(std::move(base)), options(options) {}
+
+            Scenario build() {
+                const auto directoryCount = 3 + random.below(3);
+                for (size_t i = 0; i < directoryCount; ++i)
+                    directories.push_back("d" + std::to_string(i));
+
+                if (random.chance(60))
+                    directories.push_back("d" + std::to_string(random.below(directoryCount)) + "/n");
+
+                for (const auto& directory : directories)
+                    fs::create_directories(base / directory);
+
+                if (options.searchPathVariety) {
+                    fs::create_directories(base / "v");
+                    makeSymlink("../d1", base / "v" / "w");
+                    aliasDirectory = (base / "v" / "w").string();
+                }
+
+                if (options.systemLibraries) {
+                    systemNames = {"libz.so.1", systemFileName("libz.so.1"), "libfakeroot-0.so", "libstdc++.so.6", "libm.so.6"};
+
+                    if (const auto cached = cachedLibraryOutsideTheDefaultDirectories())
+                        systemNames.push_back(cached->first);
+                }
+
+                const auto nameCount = 5 + random.below(4);
+                for (size_t i = 0; i < nameCount; ++i)
+                    names.push_back(std::string("libq") + static_cast<char>('a' + i) + ".so");
+
+                std::vector<std::pair<fs::path, std::string>> planned;
+                for (const auto& name : names) {
+                    if (random.chance(options.missingLibraries ? 25 : 10))
+                        continue;
+
+                    const auto copies = 1 + random.below(options.searchPathVariety ? 3 : 2);
+                    std::vector<std::string> used;
+
+                    for (size_t i = 0; i < copies; ++i) {
+                        const auto directory = pickDirectory();
+
+                        if (std::find(used.begin(), used.end(), directory) != used.end())
+                            continue;
+
+                        used.push_back(directory);
+                        planned.emplace_back(base / directory / name, name);
+                        files.push_back(base / directory / name);
+                    }
+                }
+
+                for (const auto& entry : planned) {
+                    auto links = randomLinks(false, fs::relative(entry.first.parent_path(), base).string());
+
+                    const auto sonameChoice = random.below(20);
+                    if (sonameChoice < 3)
+                        links.withSoname(random.pick(names));
+                    else if (sonameChoice == 3)
+                        links.noSoname();
+
+                    buildLibrary(entry.first, links);
+
+                    if (options.searchPathVariety && random.chance(30)) {
+                        const auto decoy = base / "v" / fs::relative(entry.first, base);
+
+                        if (!fs::exists(decoy))
+                            buildLibrary(decoy, randomLinks(false, fs::relative(decoy.parent_path(), base).string()));
+                    }
+                }
+
+                const auto aliases = random.below(options.searchPathVariety ? 3 : 2);
+                for (size_t i = 0; i < aliases && !files.empty(); ++i) {
+                    const auto link = base / pickDirectory() / random.pick(names);
+
+                    if (fs::exists(link) || fs::is_symlink(link))
+                        continue;
+
+                    const auto& target = random.pick(files);
+
+                    if (random.chance(50))
+                        makeSymlink(target, link);
+                    else
+                        makeSymlink(fs::relative(target, link.parent_path()), link);
+                }
+
+                if (options.searchPathVariety) {
+                    const auto decoys = random.below(3);
+
+                    for (size_t i = 0; i < decoys && !files.empty(); ++i) {
+                        const auto target = base / pickDirectory() / random.pick(names);
+
+                        if (fs::exists(target) || fs::is_symlink(target))
+                            continue;
+
+                        if (random.chance(50))
+                            copyForOtherMachine(random.pick(files), target);
+                        else
+                            copyForOtherClass(random.pick(files), target);
+                    }
+                }
+
+                const auto executable = base / "bin" / "app";
+                buildExecutable(executable, randomLinks(true, "bin"));
+
+                Scenario scenario;
+                const auto inputChoice = random.below(10);
+
+                if (inputChoice < 2 && !files.empty())
+                    scenario.input = random.pick(files);
+                else if (inputChoice < 3 && options.searchPathVariety)
+                    scenario.input = makeSymlink("../bin/app", base / "link" / "app");
+                else
+                    scenario.input = executable;
+
+                const auto directoryChoice = random.below(20);
+                if (directoryChoice < 12)
+                    scenario.call.workingDirectory = base;
+                else if (directoryChoice < 17)
+                    scenario.call.workingDirectory = base / pickDirectory();
+                else
+                    scenario.call.workingDirectory = base / "bin";
+
+                if (random.chance(options.searchPathVariety ? 50 : 25))
+                    scenario.call.ldLibraryPath = searchPath(2, true, fs::relative(fs::canonical(scenario.input).parent_path(), base).string());
+
+                return scenario;
+            }
+    };
+
+    void expectRandomScenariosMatchLdd(const fs::path& root, uint32_t seed, size_t count, const GraphOptions& options) {
+        size_t compared = 0;
+
+        for (size_t i = 0; i < count; ++i) {
+            SCOPED_TRACE("scenario " + std::to_string(i) + " of seed " + std::to_string(seed));
+
+            Random random(seed + static_cast<uint32_t>(i) * 7919u);
+            auto scenario = ScenarioBuilder(random, root / ("scenario" + std::to_string(i)), options).build();
+
+            const auto listing = runLdd(fs::canonical(scenario.input), scenario.call);
+            if (!listing.succeeded)
+                continue;
+
+            for (const auto& entry : listing.entries) {
+                if (!entry.path.has_value() && (!options.missingLibraries || random.chance(60)))
+                    scenario.call.excludes.push_back(entry.name);
+            }
+
+            if (options.missingLibraries && random.chance(15))
+                scenario.call.excludes.emplace_back("libq[a-c].so");
+
+            expectSameAsLdd(scenario.input, scenario.call);
+            ++compared;
+
+            if (::testing::Test::HasFailure())
+                return;
+        }
+
+        EXPECT_GE(compared, count * 9 / 10) << "ldd failed on too many scenarios";
+    }
+}
