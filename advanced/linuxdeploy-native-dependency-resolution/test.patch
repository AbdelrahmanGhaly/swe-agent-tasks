@@ -0,0 +1,228 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+    echo "usage: $0 [--output_path <path>] base|new" >&2
+    exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        base|new)
+            MODE="$1"
+            MODE_COUNT=$((MODE_COUNT + 1))
+            shift
+            ;;
+        --output_path)
+            shift
+            if [ $# -lt 1 ] || [ -z "$1" ]; then
+                echo "missing value for --output_path" >&2
+                usage
+            fi
+            OUTPUT_PATH="$1"
+            shift
+            ;;
+        --output_path=*)
+            OUTPUT_PATH="${1#--output_path=}"
+            if [ -z "$OUTPUT_PATH" ]; then
+                echo "missing value for --output_path" >&2
+                usage
+            fi
+            shift
+            ;;
+        *)
+            echo "unknown argument: $1" >&2
+            usage
+            ;;
+    esac
+done
+
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+case "$OUTPUT_PATH" in
+    ""|/*) ;;
+    *) OUTPUT_PATH="$(pwd)/$OUTPUT_PATH" ;;
+esac
+
+REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/linuxdeploy-tests.XXXXXX" 2>/dev/null || mktemp -d /tmp/linuxdeploy-tests.XXXXXX)" || exit 1
+trap 'rm -rf "$WORK_DIR"' EXIT
+
+if [ -z "$OUTPUT_PATH" ]; then
+    OUTPUT_PATH="$WORK_DIR/results.xml"
+else
+    mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+mkdir -p "$WORK_DIR/tmp"
+export TMPDIR="$WORK_DIR/tmp"
+export LC_ALL=C
+export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
+unset LD_LIBRARY_PATH LD_PRELOAD
+
+JOBS="$(nproc 2>/dev/null || echo 2)"
+[ "$JOBS" -gt 8 ] && JOBS=8
+
+CMAKE_ARGS=(-DCMAKE_BUILD_TYPE=Release -DUSE_CCACHE=OFF -DCMAKE_POLICY_VERSION_MINIMUM=3.5)
+
+if [ "$MODE" = base ]; then
+    SOURCE_DIR="$REPO_DIR"
+    CMAKE_ARGS+=(-DBUILD_TESTING=ON)
+    TARGETS=(test_appdir test_linuxdeploy test_elf_file)
+    SOURCES=(tests/core/test_appdir.cpp tests/core/test_linuxdeploy.cpp tests/core/test_elf_file.cpp)
+else
+    SOURCE_DIR="$REPO_DIR/tests/native_deps_9414f5"
+    TARGETS=(test_native_deps_9414f5)
+    SOURCES=(tests/native_deps_9414f5/test_native_deps_9414f5.cpp)
+fi
+
+SOURCE_PATHS=()
+for source in "${SOURCES[@]}"; do
+    SOURCE_PATHS+=("$REPO_DIR/$source")
+done
+
+cat > "$WORK_DIR/junit.py" <<'PYEOF'
+import os
+import re
+import sys
+import xml.etree.ElementTree as ET
+
+
+def tests_in(source):
+    try:
+        with open(source, errors="replace") as f:
+            text = f.read()
+    except OSError:
+        return []
+    return re.findall(r"^\s*TEST(?:_F)?\(\s*(\w+)\s*,\s*(\w+)\s*\)", text, re.M)
+
+
+def tail(path, lines=120):
+    try:
+        with open(path, errors="replace") as f:
+            return "".join(f.readlines()[-lines:])
+    except OSError:
+        return ""
+
+
+def failing_cases(tests, message, detail):
+    suites = {}
+    for suite_name, test_name in tests:
+        suite = suites.get(suite_name)
+        if suite is None:
+            suite = suites[suite_name] = ET.Element("testsuite", {"name": suite_name})
+        case = ET.SubElement(suite, "testcase", {"name": test_name, "classname": suite_name, "status": "run", "time": "0"})
+        failure = ET.SubElement(case, "failure", {"message": message})
+        failure.text = detail
+    return list(suites.values())
+
+
+def write(path, suites):
+    root = ET.Element("testsuites", {"name": "AllTests"})
+    total = failed = 0
+    for suite in suites:
+        cases = suite.findall("testcase")
+        failures = sum(1 for case in cases if case.find("failure") is not None or case.find("error") is not None)
+        suite.set("tests", str(len(cases)))
+        suite.set("failures", str(failures))
+        suite.set("errors", "0")
+        total += len(cases)
+        failed += failures
+        root.append(suite)
+    root.set("tests", str(total))
+    root.set("failures", str(failed))
+    root.set("errors", "0")
+    ET.ElementTree(root).write(path, encoding="UTF-8", xml_declaration=True)
+
+
+def main():
+    output, action = sys.argv[1], sys.argv[2]
+
+    if action == "build-failed":
+        log, sources = sys.argv[3], sys.argv[4:]
+        tests = [test for source in sources for test in tests_in(source)]
+        write(output, failing_cases(tests, "the tests did not build", "The test binaries did not build.\n\n" + tail(log)))
+        return 1
+
+    suites = []
+    synthesized = False
+    entries = sys.argv[3:]
+    for i in range(0, len(entries), 4):
+        report, log, status, source = entries[i:i + 4]
+        expected = tests_in(source)
+        try:
+            found = ET.parse(report).getroot().iter("testsuite")
+            found = [suite for suite in found if suite.findall("testcase")]
+        except Exception:
+            found = None
+
+        if found is None:
+            detail = "The test binary exited with status %s without writing a report.\n\n%s" % (status, tail(log))
+            suites.extend(failing_cases(expected, "the test binary did not report", detail))
+            synthesized = True
+            continue
+
+        reported = {(case.get("classname"), case.get("name")) for suite in found for case in suite.findall("testcase")}
+        suites.extend(found)
+        missing = [test for test in expected if test not in reported]
+        if missing:
+            detail = "The test binary exited with status %s before reporting this test.\n\n%s" % (status, tail(log))
+            suites.extend(failing_cases(missing, "the test did not report", detail))
+            synthesized = True
+            continue
+
+        failed = any(case.find("failure") is not None or case.find("error") is not None
+                     for suite in found for case in suite.findall("testcase"))
+        if status != "0" and not failed:
+            binary = os.path.splitext(os.path.basename(report))[0]
+            detail = "The test binary exited with status %s after reporting every test as passed.\n\n%s" % (status, tail(log))
+            suites.extend(failing_cases([(binary, "exitStatus")], "the test binary exited with status " + status, detail))
+            synthesized = True
+
+    write(output, suites)
+    return 1 if synthesized else 0
+
+
+sys.exit(main())
+PYEOF
+
+echo "configuring and building ${TARGETS[*]}"
+cmake -S "$SOURCE_DIR" -B "$WORK_DIR/build" "${CMAKE_ARGS[@]}" > "$WORK_DIR/build.log" 2>&1 &&
+    cmake --build "$WORK_DIR/build" -j"$JOBS" --target "${TARGETS[@]}" >> "$WORK_DIR/build.log" 2>&1
+BUILD_STATUS=$?
+
+if [ "$BUILD_STATUS" -ne 0 ]; then
+    tail -n 80 "$WORK_DIR/build.log"
+    python3 "$WORK_DIR/junit.py" "$OUTPUT_PATH" build-failed "$WORK_DIR/build.log" "${SOURCE_PATHS[@]}"
+    exit 1
+fi
+
+STATUS=0
+MERGE_ARGS=()
+
+for i in "${!TARGETS[@]}"; do
+    target="${TARGETS[$i]}"
+    binary="$(find "$WORK_DIR/build" -type f -name "$target" -perm -u+x | head -n 1)"
+    report="$WORK_DIR/$target.xml"
+    log="$WORK_DIR/$target.log"
+    status=127
+
+    if [ -n "$binary" ]; then
+        (cd "$(dirname "$binary")" && timeout -k 10 1800 "$binary" --gtest_output="xml:$report") 2>&1 | tee "$log"
+        status=${PIPESTATUS[0]}
+    else
+        echo "$target was not built" | tee "$log"
+    fi
+
+    [ "$status" -ne 0 ] && STATUS=1
+    MERGE_ARGS+=("$report" "$log" "$status" "${SOURCE_PATHS[$i]}")
+done
+
+python3 "$WORK_DIR/junit.py" "$OUTPUT_PATH" merge "${MERGE_ARGS[@]}" || STATUS=1
+
+exit "$STATUS"
