+    void expectMissing(const Traced& traced, const std::string& name) {
+        EXPECT_TRUE(traced.notFound) << "expected DependencyNotFoundError for " << name << ", got:" << describe(traced.paths);
+        EXPECT_NE(traced.message.find(name), std::string::npos) << traced.message;
+    }
+
+    void expectCount(const Traced& traced, const fs::path& path, size_t count) {
+        size_t found = 0;
+
+        for (const auto& listed : traced.paths) {
+            if (sameFile(listed, path))
+                ++found;
+        }
