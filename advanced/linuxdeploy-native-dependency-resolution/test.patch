+    std::optional<fs::path> systemLibrary(const std::string& name) {
+        static std::map<std::string, std::optional<fs::path>> known;
+
+        const auto existing = known.find(name);
+        if (existing != known.end())
+            return existing->second;
+
+        const auto directory = makeTemporaryDirectory("native-deps-probe");
+        const auto probe = buildLibrary(directory / "libprobe.so", needs({name}));
+        const auto listing = runLdd(probe, Call{directory, std::nullopt, {}});
+
+        std::optional<fs::path> path;
+        for (const auto& entry : listing.entries) {
+            if (entry.name == name && entry.path.has_value())
+                path = fs::canonical(entry.path.value());
+        }
+
+        std::error_code error;
+        fs::remove_all(directory, error);
+
+        known.emplace(name, path);
+        return path;
+    }
+
+    fs::path requireSystemLibrary(const std::string& name) {
+        const auto path = systemLibrary(name);
+
+        if (!path.has_value())
+            throw std::runtime_error("the test environment lacks " + name);
+
+        return path.value();
+    }
+
+    std::string systemFileName(const std::string& name) {
+        return requireSystemLibrary(name).filename().string();
+    }
+
+    bool lddListsDependenciesOf(const fs::path& file) {
+        std::ifstream ifs(file, std::ios::binary);
+        char magic[SELFMAG] = {};
+
+        if (!ifs.read(magic, SELFMAG) || memcmp(magic, ELFMAG, SELFMAG) != 0)
+            return false;
+
+        return runLdd(fs::canonical(file), Call{"/", std::nullopt, {}}).succeeded;
+    }
+
+    std::optional<std::pair<std::string, fs::path>> cachedLibraryOutsideTheDefaultDirectories() {
+        static const auto found = []() -> std::optional<std::pair<std::string, fs::path>> {
+            const auto listing = runProcess({"/sbin/ldconfig", "-p"}, "/", {{"PATH", "/usr/bin:/bin"}, {"LC_ALL", "C"}});
+
+            std::istringstream lines(listing.output);
+            std::string line;
+
+            while (std::getline(lines, line)) {
+                const auto arrow = line.find(" => ");
+                if (line.empty() || line.front() != '\t' || arrow == std::string::npos)
+                    continue;
+
+                const auto name = line.substr(1, line.find(' ') - 1);
+                const auto path = line.substr(arrow + 4);
+
+                bool inDefaultDirectory = false;
+                for (const auto* prefix : {"/lib/", "/usr/lib/", "/lib32/", "/usr/lib32/", "/lib64/", "/usr/lib64/", "/libx32/", "/usr/libx32/"})
+                    inDefaultDirectory = inDefaultDirectory || path.rfind(prefix, 0) == 0;
+
+                if (inDefaultDirectory)
+                    continue;
+
+                const auto resolved = systemLibrary(name);
+                if (resolved.has_value() && sameFile(resolved.value(), path))
+                    return std::make_pair(name, resolved.value());
+            }
+
+            return std::nullopt;
+        }();
+
+        return found;
+    }
