diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..3c89f61
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,321 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: $0 [--output_path <path>] base|new" >&2
+  exit 2
+}
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new)
+      MODE="$1"
+      MODE_COUNT=$((MODE_COUNT + 1))
+      shift
+      ;;
+    --output_path)
+      shift
+      [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }
+      OUTPUT_PATH="$1"
+      shift
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      [ -n "$OUTPUT_PATH" ] || { echo "missing value for --output_path" >&2; usage; }
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      usage
+      ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")" || exit 2
+
+# A runner may start this script as another uid, offline, with an environment the image did not set:
+# a PATH without the image's tools, or CARGO_HOME, RUSTUP_HOME, GOPATH and similar variables unset or
+# naming places this uid cannot use. Put the image's tools first on PATH, and use its toolchains and
+# caches unless an offline build already works with the ones the environment names.
+export PATH="/opt/make421:/opt/cargo/bin:${PATH:-}:/usr/local/bin:/usr/bin:/bin"
+export GOFLAGS=-buildvcs=false
+export GOTOOLCHAIN=local
+export GOPROXY=off
+export CARGO_NET_OFFLINE=true
+export RUSTC_BOOTSTRAP=1
+export CARGO_TARGET_DIR="$PWD/target"
+if [ -n "${TMPDIR:-}" ] && ! { [ -d "$TMPDIR" ] && [ -w "$TMPDIR" ]; }; then
+  export TMPDIR=/tmp
+fi
+TOOLCHAIN_NOTES=""
+if ! cargo fetch --offline >/dev/null 2>&1; then
+  TOOLCHAIN_NOTES="cargo cannot build offline with CARGO_HOME=${CARGO_HOME:-} RUSTUP_HOME=${RUSTUP_HOME:-}, using the image's"
+  export CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup
+  unset RUSTUP_TOOLCHAIN
+fi
+GOCACHE_DIR="$(go env GOCACHE 2>/dev/null)"
+if [ -z "$GOCACHE_DIR" ] || ! mkdir -p "$GOCACHE_DIR" 2>/dev/null || [ ! -w "$GOCACHE_DIR" ]; then
+  export GOCACHE="/tmp/go-build-$(id -u)"
+fi
+if ! go list -m all >/dev/null 2>&1; then
+  TOOLCHAIN_NOTES="$TOOLCHAIN_NOTES${TOOLCHAIN_NOTES:+; }go cannot list modules offline with GOPATH=${GOPATH:-}, using the image's"
+  export GOPATH=/opt/go
+  unset GOMODCACHE
+fi
+
+NEW_DIR="testcase/chains_29e905"
+BASE_COMMIT="55ea1e26f4da6d52a4ddca8f36a130dc26120525"
+# "# TODO" cases that expect kati to differ from make; a correct change can make them match,
+# which the harness reports as "Expected failure, but output is the same". chain2 needs implicit
+# rule chains; blank_line_before_command differs only in where a failed recipe's output lands;
+# delete_on_error needs .DELETE_ON_ERROR outside --ninja mode.
+EXCLUDED_BASE_CASES="implicit_pattern_rule_chain2.mk
+blank_line_before_command.mk
+delete_on_error.mk"
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+LOG="$WORK/go.log"
+BUILD_LOG="$WORK/build.log"
+CARGO_JSON="$WORK/cargo.json"
+: >"$LOG"
+: >"$BUILD_LOG"
+: >"$CARGO_JSON"
+[ -z "$TOOLCHAIN_NOTES" ] || echo "$TOOLCHAIN_NOTES" >>"$BUILD_LOG"
+STATUS=0
+BUILD_STATUS=0
+GO_STATUS=0
+CARGO_STATUS=0
+
+build_kati() {
+  rm -rf out ckati find_test ninja_test strutil_test target/debug/rkati
+  if ! make -j"$(nproc)" ckati "$@" >>"$BUILD_LOG" 2>&1; then
+    echo "[build failed] make ckati $*" >>"$BUILD_LOG"
+    BUILD_STATUS=1
+  fi
+  if ! cargo build --offline >>"$BUILD_LOG" 2>&1; then
+    echo "[build failed] cargo build" >>"$BUILD_LOG"
+    BUILD_STATUS=1
+  fi
+}
+
+run_go() {
+  name="$1"
+  shift
+  go test -v -count=1 -timeout 20m "$@" >"$WORK/run.log" 2>&1
+  s=$?
+  if [ "$name" = "TestKati" ]; then
+    cat "$WORK/run.log" >>"$LOG"
+  else
+    sed "s/TestKati/$name/g" "$WORK/run.log" >>"$LOG"
+  fi
+  if [ "$s" -ne 0 ]; then
+    STATUS="$s"
+    GO_STATUS="$s"
+  fi
+}
+
+if [ "$MODE" = "base" ]; then
+  # Regression mode runs the repo's own test runner on the testcases of the base commit, as they
+  # are there; testcases a change adds are not part of it.
+  BASE_CASES=""
+  if git -c safe.directory='*' cat-file -e "$BASE_COMMIT^{commit}" 2>/dev/null; then
+    git -c safe.directory='*' checkout -q "$BASE_COMMIT" -- run_test.go testcase/ >>"$BUILD_LOG" 2>&1
+    BASE_CASES="$(git -c safe.directory='*' ls-tree --name-only "$BASE_COMMIT" testcase/ | sed 's#^testcase/##')"
+  fi
+  [ -n "$BASE_CASES" ] || BASE_CASES="$(cd testcase && ls -1)"
+  build_kati ckati_tests
+  CASES="$(printf '%s\n' "$BASE_CASES" | grep -E '[.](mk|sh)$' | grep -v -x -F -e "$EXCLUDED_BASE_CASES" | sed 's/[.]/\\./g' | paste -sd '|' -)"
+  RUN="^TestKati\$/^(${CASES})\$"
+  run_go TestKati -run "$RUN" .
+  run_go TestKati_ninja -run "$RUN" . --ninja
+  run_go TestKati_rkati -run "$RUN" . --rkati
+  run_go TestKati_rkati_ninja -run "$RUN" . --rkati --ninja
+
+  UNIT_STATUS=0
+  for t in find_test ninja_test strutil_test; do
+    echo "=== RUN   TestCkatiUnit/$t"
+    if [ -x "./$t" ] && "./$t" >"$WORK/unit.log" 2>&1; then
+      echo "--- PASS: TestCkatiUnit/$t (0.00s)"
+    else
+      sed 's/^/    /' "$WORK/unit.log" 2>/dev/null
+      [ -x "./$t" ] || echo "    $t was not built"
+      echo "--- FAIL: TestCkatiUnit/$t (0.00s)"
+      UNIT_STATUS=1
+    fi
+  done >>"$LOG"
+  if [ "$UNIT_STATUS" -eq 0 ]; then
+    printf 'ok  \tgithub.com/google/kati/ckati_unit\t0.000s\n' >>"$LOG"
+  else
+    printf 'FAIL\tgithub.com/google/kati/ckati_unit\t0.000s\n' >>"$LOG"
+    STATUS=1
+    GO_STATUS=1
+  fi
+
+  cargo test --offline -- -Z unstable-options --format json --report-time >"$CARGO_JSON" 2>"$WORK/cargo.err"
+  CARGO_STATUS=$?
+  cat "$WORK/cargo.err" >>"$BUILD_LOG"
+  [ "$CARGO_STATUS" -ne 0 ] && STATUS="$CARGO_STATUS"
+else
+  build_kati
+  run_go TestImplicitChains "./$NEW_DIR/"
+fi
+
+[ "$BUILD_STATUS" -ne 0 ] && [ "$STATUS" -eq 0 ] && STATUS=1
+if ! grep -qE '^ *--- (PASS|FAIL|SKIP):' "$LOG"; then
+  echo "no tests were collected in mode $MODE" >>"$LOG"
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+cat "$BUILD_LOG"
+cat "$LOG"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  : >"$WORK/convert.err"
+  go-junit-report <"$LOG" >"$WORK/go.xml" 2>>"$WORK/convert.err"
+  GO_CONVERT_STATUS=$?
+  CARGO_CONVERT_STATUS=0
+  if [ -s "$CARGO_JSON" ]; then
+    cargo2junit <"$CARGO_JSON" >"$WORK/cargo.xml" 2>>"$WORK/convert.err"
+    CARGO_CONVERT_STATUS=$?
+  fi
+  python3 - "$OUTPUT_PATH" "$MODE" "$BUILD_STATUS" "$BUILD_LOG" "$LOG" "$GO_STATUS" "$GO_CONVERT_STATUS" \
+    "$CARGO_STATUS" "$CARGO_CONVERT_STATUS" "$CARGO_JSON" "$WORK/cargo.err" "$WORK/convert.err" \
+    "$WORK/go.xml" "$WORK/cargo.xml" <<'PY'
+import os
+import re
+import sys
+import xml.etree.ElementTree as ET
+
+(out, mode, build_status, build_log, go_log, go_status, go_convert_status, cargo_status,
+ cargo_convert_status, cargo_json, cargo_err, convert_err, go_xml, cargo_xml) = sys.argv[1:15]
+
+root = ET.Element("testsuites")
+
+
+def load(path):
+    if not os.path.exists(path) or os.path.getsize(path) == 0:
+        return None
+    try:
+        top = ET.parse(path).getroot()
+    except ET.ParseError:
+        return None
+    return [top] if top.tag == "testsuite" else top.findall("testsuite")
+
+
+def count(suites, what):
+    return sum(len(suite.findall("testcase" + what)) for suite in suites or [])
+
+
+go_suites = load(go_xml)
+cargo_suites = load(cargo_xml)
+for suites in (go_suites, cargo_suites):
+    for suite in suites or []:
+        root.append(suite)
+
+
+def tail(path, lines=60):
+    try:
+        with open(path, errors="replace") as f:
+            return "".join(f.readlines()[-lines:])
+    except OSError:
+        return ""
+
+
+def add_failure(suite_name, case_name, message, detail):
+    suite = ET.SubElement(root, "testsuite", name=suite_name, tests="1", failures="1", errors="0")
+    case = ET.SubElement(suite, "testcase", name=case_name, classname=suite_name)
+    failure = ET.SubElement(case, "failure", message=message)
+    failure.text = detail
+
+
+try:
+    with open(go_log, errors="replace") as f:
+        go_lines = f.read().splitlines()
+except OSError:
+    go_lines = []
+
+
+def go_details(name):
+    details = []
+    current = None
+    for line in go_lines:
+        text = line.strip()
+        started = re.match(r"=== (?:RUN|CONT|PAUSE|NAME)\s+(\S+)", text)
+        if started:
+            current = started.group(1)
+        elif text.startswith("--- FAIL: " + name + "/"):
+            details.append(text)
+        elif current and (current == name or current.startswith(name + "/")) and line.startswith("    ") \
+                and not text.startswith(("--- ", "=== ")):
+            details.append(current + ": " + text)
+    return "\n".join(details[-200:])
+
+
+for case in root.iter("testcase"):
+    failure = case.find("failure")
+    if failure is not None and not (failure.text or "").strip():
+        detail = go_details(case.get("name", ""))
+        if detail:
+            failure.text = detail
+
+reporting_failed = False
+go_ran = any(re.match(r"\s*--- (PASS|FAIL|SKIP):", line) for line in go_lines)
+if go_convert_status != "0" or (go_ran and count(go_suites, "") == 0):
+    add_failure("kati_go_results", "convert", "go test results could not be converted to JUnit",
+                tail(convert_err) + tail(go_log))
+    reporting_failed = True
+elif go_status != "0" and count(go_suites, "/failure") + count(go_suites, "/error") == 0:
+    add_failure("kati_go_results", "go_test", "go test failed without reporting a failing test", tail(go_log))
+
+cargo_ran = os.path.exists(cargo_json) and os.path.getsize(cargo_json) > 0
+if cargo_convert_status != "0" or (cargo_ran and cargo_suites is None):
+    add_failure("kati_rust_tests", "convert", "cargo test results could not be converted to JUnit",
+                tail(convert_err) + tail(cargo_err))
+    reporting_failed = True
+elif cargo_status != "0" and count(cargo_suites, "/failure") + count(cargo_suites, "/error") == 0:
+    add_failure("kati_rust_tests", "cargo_test", "cargo test failed without reporting a failing test", tail(cargo_err))
+
+if build_status != "0":
+    add_failure("kati_build", "build", "ckati or rkati failed to build", tail(build_log))
+if root.find(".//testcase") is None:
+    add_failure("kati_" + mode, "collect", "no test results were produced", tail(build_log) + tail(go_log))
+
+ansi = re.compile(r"[\x1b\ufffd]\[[0-9;?]*[ -/]*[@-~]")
+not_xml = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\ufffe\uffff]")
+
+
+def clean(text):
+    return not_xml.sub("", ansi.sub("", text))
+
+
+for element in root.iter():
+    if element.text:
+        element.text = clean(element.text)
+    if element.tail:
+        element.tail = clean(element.tail)
+    for key, value in list(element.attrib.items()):
+        element.set(key, clean(value))
+
+for suite in root.findall("testsuite"):
+    suite.set("tests", str(len(suite.findall("testcase"))))
+    suite.set("failures", str(len(suite.findall("testcase/failure"))))
+    suite.set("errors", str(len(suite.findall("testcase/error"))))
+root.set("tests", str(len(root.findall(".//testcase"))))
+root.set("failures", str(len(root.findall(".//failure"))))
+root.set("errors", str(len(root.findall(".//error"))))
+ET.ElementTree(root).write(out, encoding="UTF-8", xml_declaration=True)
+sys.exit(3 if reporting_failed else 0)
+PY
+  WRITE_STATUS=$?
+  if [ "$WRITE_STATUS" -ne 0 ] && [ "$WRITE_STATUS" -ne 3 ]; then
+    echo "could not write $OUTPUT_PATH" >&2
+  fi
+  [ "$WRITE_STATUS" -ne 0 ] && [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+exit "$STATUS"
