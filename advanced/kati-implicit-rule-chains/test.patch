+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package chains
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"testing"
+)
+
+type replacement struct {
+	re   *regexp.Regexp
+	with string
+}
+
+var quotes = replacement{regexp.MustCompile("([`'\"]|\xe2\x80\x98|\xe2\x80\x99)"), `"`}
+
+var makeReplacements = []replacement{
+	quotes,
+	{regexp.MustCompile(`make(?:\[\d+\])?: (Entering|Leaving) directory[^\n]*\n`), ""},
+	{regexp.MustCompile(`make(?:\[\d+\])?: `), ""},
+	{regexp.MustCompile(" recipe for target "), " commands for target "},
+	{regexp.MustCompile(" recipe commences "), " commands commence "},
+	{regexp.MustCompile("missing rule before recipe."), "missing rule before commands."},
+	{regexp.MustCompile(" (did you mean TAB instead of 8 spaces?)"), ""},
+	{regexp.MustCompile("Extraneous text after"), "extraneous text after"},
+	{regexp.MustCompile(`\s+Stop\.`), ""},
+	{regexp.MustCompile(`Makefile:\d+: commands for target ".*?" failed\n`), ""},
+	{regexp.MustCompile(`/bin/(ba)?sh: line 1: `), ""},
+	{regexp.MustCompile(`(: \S+: No such file or directory)\n\*\*\* No rule to make target "[^"]+".`), "$1"},
+	{regexp.MustCompile(`\[\S+:\d+: `), "["},
+}
+
+var katiReplacements = []replacement{
+	quotes,
+	{regexp.MustCompile(`\*kati\*[^\n]*`), ""},
+	{regexp.MustCompile(`r?c?kati: `), ""},
+	{regexp.MustCompile(`/bin/(ba)?sh: line 1: `), ""},
+	{regexp.MustCompile(`/bin/sh: `), ""},
+	{regexp.MustCompile(`.*: warning for parse error in an unevaluated line: [^\n]*`), ""},
+	{regexp.MustCompile(`([^\n ]+: )?FindEmulator: `), ""},
+	{regexp.MustCompile(` (\./+)+kati\.\S+`), ""},
+	{regexp.MustCompile(` (\./+)+test\S+.json`), ""},
+	{regexp.MustCompile(`(: )open (\S+): n(o such file or directory)\nNOTE:[^\n]*`), "${1}${2}: N${3}"},
+	{regexp.MustCompile(`Too many symbolic links encountered`), "Too many levels of symbolic links"},
+	{regexp.MustCompile(` \(os error \d+\)`), ""},
+}
+
+var circularRE = regexp.MustCompile(`(Circular .* dropped\.\n)`)
+
+var stepRE = regexp.MustCompile(`(?m)^(test\d+):`)
+var goalsRE = regexp.MustCompile(`(?m)^# (test\d+) goals: (.+)$`)
+var rmRE = regexp.MustCompile(`(?m)^rm (.*)$`)
+
+func normalize(out string, replacements []replacement) string {
+	var circular []string
+	for _, m := range circularRE.FindAllStringSubmatch(out, -1) {
+		circular = append(circular, m[1])
+	}
+	out = strings.Join(circular, "") + circularRE.ReplaceAllString(out, "")
+	for _, r := range replacements {
+		out = r.re.ReplaceAllString(out, r.with)
+	}
+	return rmRE.ReplaceAllStringFunc(out, func(line string) string {
+		names := strings.Fields(strings.TrimPrefix(line, "rm "))
+		sort.Strings(names)
+		return "rm " + strings.Join(names, " ")
+	})
+}
+
+type result struct {
+	out   string
+	ok    bool
+	files []string
+}
+
+func listFiles(t *testing.T, dir string) []string {
+	var files []string
+	err := filepath.Walk(dir, func(path string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, _ := filepath.Rel(dir, path)
+		if rel == "." || rel == "Makefile" {
+			return nil
+		}
+		files = append(files, rel)
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sort.Strings(files)
+	return files
+}
+
+type step struct {
+	name  string
+	goals []string
+}
+
+func steps(makefile string) []step {
+	goals := map[string][]string{}
+	for _, m := range stepRE.FindAllStringSubmatch(makefile, -1) {
+		goals[m[1]] = []string{m[1]}
+	}
+	for _, m := range goalsRE.FindAllStringSubmatch(makefile, -1) {
+		goals[m[1]] = strings.Fields(m[2])
+	}
+	var result []step
+	for name, g := range goals {
+		result = append(result, step{name, g})
+	}
+	sort.Slice(result, func(i, j int) bool { return result[i].name < result[j].name })
+	return result
+}
+
+func runSteps(t *testing.T, bin string, env []string, makefile string, all []step, flags []string, replacements []replacement) []result {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "Makefile"), []byte(makefile), 0666); err != nil {
+		t.Fatal(err)
+	}
+	var results []result
+	for _, s := range all {
+		args := append(append(append([]string{}, flags...), "SHELL=/bin/bash"), s.goals...)
+		cmd := exec.Command(bin, args...)
+		cmd.Dir = dir
+		cmd.Env = env
+		out, err := cmd.CombinedOutput()
+		results = append(results, result{
+			out:   normalize(string(out), replacements),
+			ok:    err == nil,
+			files: listFiles(t, dir),
+		})
+	}
+	return results
+}
+
+func TestImplicitChains(t *testing.T) {
+	ckati, _ := filepath.Abs("../../ckati")
+	rkati, _ := filepath.Abs("../../target/debug/rkati")
+	makeBin := os.Getenv("KATI_TEST_MAKE")
+	if makeBin == "" {
+		makeBin = "make"
+	}
+
+	cases, err := filepath.Glob("*.mk")
+	if err != nil || len(cases) == 0 {
+		t.Fatalf("no testcases: %v", err)
+	}
+	for _, c := range cases {
+		c := c
+		name := strings.TrimSuffix(c, ".mk")
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			data, err := os.ReadFile(c)
+			if err != nil {
+				t.Fatal(err)
+			}
+			makefile := string(data)
+			names := steps(makefile)
+			var flags []string
+			if strings.HasPrefix(name, "silent_") {
+				flags = append(flags, "-s")
+			}
+
+			env := append(os.Environ(), "MAKEFLAGS=", "MAKELEVEL=")
+			want := runSteps(t, makeBin, env, makefile, names, flags, makeReplacements)
+
+			for _, tool := range []struct{ name, bin string }{{"ckati", ckati}, {"rkati", rkati}} {
+				tool := tool
+				t.Run(tool.name, func(t *testing.T) {
+					if _, err := os.Stat(tool.bin); err != nil {
+						t.Fatalf("%s is not built: %v", tool.name, err)
+					}
+					got := runSteps(t, tool.bin, env, makefile, names, flags, katiReplacements)
+					for i, s := range names {
+						step := s.name
+						w, g := want[i], got[i]
+						if w.out != g.out {
+							t.Errorf("%s: output differs from make\n--- make ---\n%s--- %s ---\n%s", step, w.out, tool.name, g.out)
+						}
+						if w.ok != g.ok {
+							t.Errorf("%s: make succeeded=%v, %s succeeded=%v", step, w.ok, tool.name, g.ok)
+						}
+						if strings.Join(w.files, " ") != strings.Join(g.files, " ") {
+							t.Errorf("%s: files left differ\nmake: %q\n%s: %q", step, w.files, tool.name, g.files)
+						}
+					}
+				})
+			}
+		})
+	}
+}
