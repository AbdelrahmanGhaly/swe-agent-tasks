+// The targets of a failed recipe that .DELETE_ON_ERROR removes, each with the
+// target whose recipe failed when it is another target of the rule, and the
+// intermediates made before the failure. Like GNU make, which deletes them as
+// it exits, they are removed once the error has been reported.
+type FailedTargets = Vec<(Symbol, Option<Symbol>)>;
+static FAILED_RUN_TARGETS: LazyLock<Mutex<FailedTargets>> =
+    LazyLock::new(|| Mutex::new(Vec::new()));
+static FAILED_RUN_INTERMEDIATES: LazyLock<Mutex<Vec<Symbol>>> =
+    LazyLock::new(|| Mutex::new(Vec::new()));
+
+pub fn clean_up_failed_run() {
+    for (target, failed) in std::mem::take(&mut *FAILED_RUN_TARGETS.lock()) {
+        match failed {
+            Some(failed) => eprintln!("*** [{failed}] Deleting file '{target}'"),
+            None => eprintln!("*** Deleting file '{target}'"),
+        }
+        let _ = std::fs::remove_file(OsStr::from_bytes(&target.as_bytes()));
+    }
+    remove_files(std::mem::take(&mut *FAILED_RUN_INTERMEDIATES.lock()));
