+func TestZeroWeightIsRejected(t *testing.T) {
+	storage := raft.NewMemoryStorage()
+	snap := &pb.Snapshot{Metadata: &pb.SnapshotMetadata{
+		Index:     proto.Uint64(1),
+		Term:      proto.Uint64(1),
+		ConfState: &pb.ConfState{Voters: []uint64{1, 2, 3}},
+	}}
+	if err := storage.ApplySnapshot(snap); err != nil {
+		t.Fatal(err)
+	}
+	cfg := &raft.Config{
+		ID:              1,
+		ElectionTick:    10,
+		HeartbeatTick:   1,
+		Storage:         storage,
+		MaxSizePerMsg:   1 << 20,
+		MaxInflightMsgs: 256,
+		VoterWeights:    map[uint64]uint64{2: 0},
+		Logger:          quietLogger,
+	}
+	if !rejectsConfig(cfg) {
+		t.Fatal("NewRawNode accepted a zero weight")
+	}
+
+	c := newCluster(t, []uint64{1, 2, 3}, nil, map[uint64]uint64{1: 3}, nil)
+	if err := c.peers[1].rn.SetVoterWeights(map[uint64]uint64{1: 0}); err == nil {
+		t.Fatal("SetVoterWeights accepted a zero weight")
+	}
+	if err := c.peers[1].rn.SetVoterWeights(map[uint64]uint64{2: 1, 3: 0}); err == nil {
+		t.Fatal("SetVoterWeights accepted a zero weight")
+	}
+	if err := c.peers[1].rn.SetVoterWeights(map[uint64]uint64{9: 0}); err == nil {
+		t.Fatal("SetVoterWeights accepted a zero weight for a node that is not a voter")
+	}
+	c.isolate(1)
+	c.campaign(1)
+	c.requireState(1, raft.StateLeader)
+
+	cfg.VoterWeights = map[uint64]uint64{9: 0}
+	if !rejectsConfig(cfg) {
+		t.Fatal("NewRawNode accepted a zero weight for a node that is not a voter")
+	}
+
+	withLearner := newCluster(t, []uint64{1, 2, 3}, []uint64{4}, nil, nil)
+	if err := withLearner.peers[1].rn.SetVoterWeights(map[uint64]uint64{4: 0}); err == nil {
+		t.Fatal("SetVoterWeights accepted a zero weight for a learner")
+	}
+}
