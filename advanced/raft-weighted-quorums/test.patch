+func TestJointConfigurationWeighsEachHalf(t *testing.T) {
+	c := newCluster(t, []uint64{1, 2, 3}, nil, map[uint64]uint64{1: 3, 4: 3}, nil)
+	c.campaign(1)
+
+	c.proposeConfChange(1, &pb.ConfChangeV2{
+		Transition: pb.ConfChangeTransitionJointExplicit.Enum(),
+		Changes: []*pb.ConfChangeSingle{
+			{Type: pb.ConfChangeAddNode.Enum(), NodeId: proto.Uint64(4)},
+			{Type: pb.ConfChangeAddNode.Enum(), NodeId: proto.Uint64(5)},
+			{Type: pb.ConfChangeRemoveNode.Enum(), NodeId: proto.Uint64(2)},
+			{Type: pb.ConfChangeRemoveNode.Enum(), NodeId: proto.Uint64(3)},
+		},
+	})
+	cs := c.peers[1].confState
+	if !slices.Equal(cs.GetVotersOutgoing(), []uint64{1, 2, 3}) || !slices.Equal(cs.GetVoters(), []uint64{1, 4, 5}) {
+		t.Fatalf("leader did not enter the joint configuration: %v", cs)
+	}
+	c.compact(1)
+	c.start(4, nil)
+	c.start(5, nil)
+	c.tick(1, 1)
+
+	c.isolate(2, 3, 4, 5)
+	c.propose(1, "j")
+	c.requireApplied(1)
+
+	c.heal(5)
+	c.tick(1, 1)
+	c.requireApplied(1, "j")
+	c.requireApplied(5, "j")
+}
+
+func TestJointConfigurationNeedsBothHalves(t *testing.T) {
+	c := newCluster(t, []uint64{1, 2, 3}, nil, map[uint64]uint64{2: 3, 4: 3}, nil)
+	c.campaign(1)
+	c.requireState(1, raft.StateLeader)
+
+	c.proposeConfChange(1, &pb.ConfChangeV2{
+		Transition: pb.ConfChangeTransitionJointExplicit.Enum(),
+		Changes: []*pb.ConfChangeSingle{
+			{Type: pb.ConfChangeAddNode.Enum(), NodeId: proto.Uint64(4)},
+			{Type: pb.ConfChangeAddNode.Enum(), NodeId: proto.Uint64(5)},
+			{Type: pb.ConfChangeRemoveNode.Enum(), NodeId: proto.Uint64(2)},
+			{Type: pb.ConfChangeRemoveNode.Enum(), NodeId: proto.Uint64(3)},
+		},
+	})
+	cs := c.peers[1].confState
+	if !slices.Equal(cs.GetVotersOutgoing(), []uint64{1, 2, 3}) || !slices.Equal(cs.GetVoters(), []uint64{1, 4, 5}) {
+		t.Fatalf("leader did not enter the joint configuration: %v", cs)
+	}
+	c.compact(1)
+	c.start(4, nil)
+	c.start(5, nil)
+	c.tick(1, 1)
+	commit := c.commit(1)
+
+	c.isolate(2)
+	c.propose(1, "both")
+	c.requireApplied(1)
+	c.readIndex(1, "jr")
+	c.requireReads(1)
+
+	c.heal(2)
+	c.tick(1, 1)
+	c.requireApplied(1, "both")
+	c.requireReads(1, fmt.Sprintf("jr@%d", commit))
+
+	c.isolate(2)
+	c.campaign(4)
+	c.requireState(4, raft.StateCandidate)
+
+	c.heal(2)
+	c.isolate(4)
+	c.campaign(3)
+	c.requireState(3, raft.StateCandidate)
+
+	c.heal(4)
+	c.campaign(3)
+	c.requireState(3, raft.StateLeader)
+}
