+func TestWeightsApplyToVotersAddedLater(t *testing.T) {
+	c := newCluster(t, []uint64{1, 2, 3}, nil, map[uint64]uint64{4: 3}, nil)
+	c.campaign(1)
+	c.proposeConfChange(1, addNode(4))
+	c.compact(1)
+	c.start(4, nil)
+	c.tick(1, 1)
+	if !slices.Contains(c.peers[4].confState.GetVoters(), 4) {
+		t.Fatalf("node 4 did not catch up to its own addition: %v", c.peers[4].confState)
+	}
+
+	c.isolate(4)
+	c.propose(1, "n")
+	c.requireApplied(1)
+	c.requireApplied(2)
+
