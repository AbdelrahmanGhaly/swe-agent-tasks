+func TestPreVoteUsesWeights(t *testing.T) {
+	c := newCluster(t, []uint64{1, 2, 3}, nil, map[uint64]uint64{1: 3}, preVote)
+	start := c.term(2)
+	c.isolate(1)
+	c.campaign(2)
+	c.requireState(2, raft.StatePreCandidate)
+	if got := c.term(2); got != start {
+		t.Fatalf("pre-candidate moved from term %d to %d", start, got)
+	}
+
+	c.campaign(1)
+	c.requireState(1, raft.StateLeader)
+	if got := c.term(1); got != start+1 {
+		t.Fatalf("leader term is %d, want %d", got, start+1)
+	}
+}
