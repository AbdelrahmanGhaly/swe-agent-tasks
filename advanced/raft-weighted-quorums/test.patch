+func weightOf(weights map[uint64]uint64, id uint64) uint64 {
+	if w, ok := weights[id]; ok {
+		return w
+	}
+	return 1
+}
+
+func TestElectionsAndCommitsFollowWeightedMajorities(t *testing.T) {
+	rng := rand.New(rand.NewSource(3964))
+	voters := []uint64{1, 2, 3, 4, 5}
+	for round := range 6 {
+		weights := map[uint64]uint64{}
+		var total uint64
+		for _, id := range voters {
+			if w := uint64(rng.Intn(5)); w > 0 {
+				weights[id] = w
+			}
+			total += weightOf(weights, id)
+		}
+		for _, candidate := range voters {
+			for mask := range 1 << 4 {
+				var reachable []uint64
+				support := weightOf(weights, candidate)
+				bit := 0
+				for _, id := range voters {
+					if id == candidate {
+						continue
+					}
+					if mask&(1<<bit) != 0 {
+						reachable = append(reachable, id)
+						support += weightOf(weights, id)
+					}
+					bit++
+				}
+				quorum := support > total-support
+				name := fmt.Sprintf("round%d/candidate%d/reach%v", round, candidate, reachable)
+
+				c := newCluster(t, voters, nil, weights, nil)
+				for _, id := range voters {
+					if id != candidate && !slices.Contains(reachable, id) {
+						c.isolate(id)
+					}
+				}
+				c.campaign(candidate)
+				if got := c.state(candidate) == raft.StateLeader; got != quorum {
+					t.Fatalf("%s: leader=%v, want %v (weights %v)", name, got, quorum, weights)
+				}
+
+				full := newCluster(t, voters, nil, weights, nil)
+				full.campaign(candidate)
+				if full.state(candidate) != raft.StateLeader {
+					continue
+				}
+				for _, id := range voters {
+					if id != candidate && !slices.Contains(reachable, id) {
+						full.isolate(id)
+					}
+				}
+				full.propose(candidate, "e")
+				if got := slices.Contains(full.peers[candidate].applied, "e"); got != quorum {
+					t.Fatalf("%s: committed=%v, want %v (weights %v)", name, got, quorum, weights)
+				}
+			}
+		}
+	}
+}
