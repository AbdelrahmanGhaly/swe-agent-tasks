+func TestCommitWaitsForWeightedQuorum(t *testing.T) {
+	c := newCluster(t, []uint64{1, 2, 3}, nil, map[uint64]uint64{3: 3}, nil)
+	c.campaign(1)
+	c.requireState(1, raft.StateLeader)
+	committed := c.commit(1)
+
+	c.isolate(3)
+	c.propose(1, "a")
+	c.requireApplied(1)
+	c.requireApplied(2)
+	if got := c.commit(1); got != committed {
+		t.Fatalf("commit moved from %d to %d without the heavy voter", committed, got)
+	}
+
+	c.heal(3)
+	c.tick(1, 1)
+	c.requireApplied(1, "a")
+	c.requireApplied(2, "a")
+	c.requireApplied(3, "a")
+}
