+func TestCheckQuorumCountsWeight(t *testing.T) {
+	heavy := newCluster(t, []uint64{1, 2, 3}, nil, map[uint64]uint64{1: 3}, checkQuorum)
+	heavy.campaign(1)
+	heavy.isolate(1)
+	heavy.tick(1, 25)
+	heavy.requireState(1, raft.StateLeader)
+
+	half := newCluster(t, []uint64{1, 2, 3}, nil, map[uint64]uint64{1: 2}, checkQuorum)
+	half.campaign(1)
+	half.isolate(3)
+	half.tick(1, 25)
+	half.requireState(1, raft.StateLeader)
+	half.isolate(2)
+	half.tick(1, 25)
+	if half.state(1) == raft.StateLeader {
+		t.Fatal("leader with half the weight kept leading without a quorum")
+	}
+}
