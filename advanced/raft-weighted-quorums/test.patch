+package quorumweights
+
+import (
+	"fmt"
+	"io"
+	"log"
+	"math"
+	"math/rand"
+	"slices"
+	"testing"
+
+	"google.golang.org/protobuf/proto"
+
+	"go.etcd.io/raft/v3"
+	pb "go.etcd.io/raft/v3/raftpb"
+)
+
+var quietLogger = &raft.DefaultLogger{Logger: log.New(io.Discard, "", 0)}
+
+type peer struct {
+	rn           *raft.RawNode
+	storage      *raft.MemoryStorage
+	confState    *pb.ConfState
+	appliedIndex uint64
+	applied      []string
+	reads        []string
+}
+
+type cluster struct {
+	t        *testing.T
+	weights  map[uint64]uint64
+	tweak    func(*raft.Config)
+	peers    map[uint64]*peer
+	isolated map[uint64]bool
+	drop     func(*pb.Message) bool
+}
+
+func newCluster(t *testing.T, voters, learners []uint64, weights map[uint64]uint64, tweak func(*raft.Config)) *cluster {
+	t.Helper()
+	c := &cluster{
+		t:        t,
+		weights:  weights,
+		tweak:    tweak,
+		peers:    map[uint64]*peer{},
+		isolated: map[uint64]bool{},
+	}
+	cs := &pb.ConfState{Voters: voters, Learners: learners}
+	for _, id := range append(slices.Clone(voters), learners...) {
+		c.start(id, cs)
+	}
+	return c
+}
+
+func (c *cluster) config(id uint64, storage raft.Storage) *raft.Config {
+	cfg := &raft.Config{
+		ID:              id,
+		ElectionTick:    10,
+		HeartbeatTick:   1,
+		Storage:         storage,
+		MaxSizePerMsg:   1 << 20,
+		MaxInflightMsgs: 256,
+		VoterWeights:    c.weights,
+		Logger:          quietLogger,
+	}
+	if c.tweak != nil {
+		c.tweak(cfg)
+	}
+	return cfg
+}
+
+func (c *cluster) start(id uint64, cs *pb.ConfState) {
+	c.t.Helper()
+	storage := raft.NewMemoryStorage()
+	p := &peer{storage: storage}
+	if cs != nil {
+		snap := &pb.Snapshot{Metadata: &pb.SnapshotMetadata{
+			Index:     proto.Uint64(1),
+			Term:      proto.Uint64(1),
+			ConfState: cs,
+		}}
+		if err := storage.ApplySnapshot(snap); err != nil {
+			c.t.Fatal(err)
+		}
+		if err := storage.SetHardState(&pb.HardState{Term: proto.Uint64(1), Commit: proto.Uint64(1)}); err != nil {
+			c.t.Fatal(err)
+		}
+		p.confState = cs
+		p.appliedIndex = 1
+	}
+	rn, err := raft.NewRawNode(c.config(id, storage))
+	if err != nil {
+		c.t.Fatal(err)
+	}
+	p.rn = rn
+	c.peers[id] = p
+}
+
+func (c *cluster) ids() []uint64 {
+	ids := make([]uint64, 0, len(c.peers))
+	for id := range c.peers {
+		ids = append(ids, id)
+	}
+	slices.Sort(ids)
+	return ids
+}
+
+func (c *cluster) handleReady(p *peer) []*pb.Message {
+	c.t.Helper()
+	rd := p.rn.Ready()
+	if !raft.IsEmptySnap(rd.Snapshot) {
+		if err := p.storage.ApplySnapshot(rd.Snapshot); err != nil {
+			c.t.Fatal(err)
+		}
+		p.confState = rd.Snapshot.GetMetadata().GetConfState()
+		p.appliedIndex = rd.Snapshot.GetMetadata().GetIndex()
+	}
+	if err := p.storage.Append(rd.Entries); err != nil {
+		c.t.Fatal(err)
+	}
+	if !raft.IsEmptyHardState(rd.HardState) {
+		if err := p.storage.SetHardState(rd.HardState); err != nil {
+			c.t.Fatal(err)
+		}
+	}
+	for _, rs := range rd.ReadStates {
+		p.reads = append(p.reads, fmt.Sprintf("%s@%d", rs.RequestCtx, rs.Index))
+	}
+	for _, e := range rd.CommittedEntries {
+		switch e.GetType() {
+		case pb.EntryNormal:
+			if len(e.GetData()) > 0 {
+				p.applied = append(p.applied, string(e.GetData()))
+			}
+		case pb.EntryConfChange:
+			var cc pb.ConfChange
+			if err := proto.Unmarshal(e.GetData(), &cc); err != nil {
+				c.t.Fatal(err)
+			}
+			p.confState = p.rn.ApplyConfChange(&cc)
+		case pb.EntryConfChangeV2:
+			var cc pb.ConfChangeV2
+			if err := proto.Unmarshal(e.GetData(), &cc); err != nil {
+				c.t.Fatal(err)
+			}
+			p.confState = p.rn.ApplyConfChange(&cc)
+		}
+		p.appliedIndex = e.GetIndex()
+	}
+	msgs := rd.Messages
+	p.rn.Advance(rd)
+	return msgs
+}
+
+func (c *cluster) blocked(m *pb.Message) bool {
+	if c.isolated[m.GetFrom()] || c.isolated[m.GetTo()] {
+		return true
+	}
+	return c.drop != nil && c.drop(m)
+}
+
+func (c *cluster) stabilize() {
+	c.t.Helper()
+	for range 10000 {
+		var msgs []*pb.Message
+		for _, id := range c.ids() {
+			p := c.peers[id]
+			for p.rn.HasReady() {
+				msgs = append(msgs, c.handleReady(p)...)
+			}
+		}
+		if len(msgs) == 0 {
+			return
+		}
+		for _, m := range msgs {
+			to, ok := c.peers[m.GetTo()]
+			if !ok || c.blocked(m) {
+				continue
+			}
+			_ = to.rn.Step(m)
+			if m.GetType() == pb.MsgSnap {
+				c.peers[m.GetFrom()].rn.ReportSnapshot(m.GetTo(), raft.SnapshotFinish)
+			}
+		}
+	}
+	c.t.Fatal("cluster did not settle")
+}
+
+func (c *cluster) isolate(ids ...uint64) {
+	for _, id := range ids {
+		c.isolated[id] = true
+	}
+}
+
+func (c *cluster) heal(ids ...uint64) {
+	for _, id := range ids {
+		delete(c.isolated, id)
+	}
+}
+
+func (c *cluster) campaign(id uint64) {
+	c.t.Helper()
+	if err := c.peers[id].rn.Campaign(); err != nil {
+		c.t.Fatal(err)
+	}
+	c.stabilize()
+}
+
+func (c *cluster) electWithoutSaving(id uint64) {
+	c.t.Helper()
+	if err := c.peers[id].rn.Campaign(); err != nil {
+		c.t.Fatal(err)
+	}
+	for range 100 {
+		if c.state(id) == raft.StateLeader {
+			return
+		}
+		var msgs []*pb.Message
+		for _, pid := range c.ids() {
+			p := c.peers[pid]
+			for p.rn.HasReady() {
+				msgs = append(msgs, c.handleReady(p)...)
+			}
+		}
+		for _, m := range msgs {
+			if to, ok := c.peers[m.GetTo()]; ok && !c.blocked(m) {
+				_ = to.rn.Step(m)
+			}
+		}
+	}
+	c.t.Fatalf("node %d did not become leader", id)
+}
+
+func (c *cluster) propose(id uint64, data string) {
+	c.t.Helper()
+	if err := c.peers[id].rn.Propose([]byte(data)); err != nil {
+		c.t.Fatal(err)
+	}
+	c.stabilize()
+}
+
+func (c *cluster) proposeConfChange(id uint64, cc pb.ConfChangeI) {
+	c.t.Helper()
+	if err := c.peers[id].rn.ProposeConfChange(cc); err != nil {
+		c.t.Fatal(err)
+	}
+	c.stabilize()
+}
+
+func (c *cluster) readIndex(id uint64, ctx string) {
+	c.peers[id].rn.ReadIndex([]byte(ctx))
+	c.stabilize()
+}
+
+func (c *cluster) tick(id uint64, n int) {
+	c.t.Helper()
+	for range n {
+		c.peers[id].rn.Tick()
+		c.stabilize()
+	}
+}
+
+func (c *cluster) setWeights(weights map[uint64]uint64, ids ...uint64) {
+	c.t.Helper()
+	for _, id := range ids {
+		if err := c.peers[id].rn.SetVoterWeights(weights); err != nil {
+			c.t.Fatalf("SetVoterWeights on %d: %v", id, err)
+		}
+	}
+	c.stabilize()
+}
+
+func (c *cluster) compact(id uint64) {
+	c.t.Helper()
+	p := c.peers[id]
+	if _, err := p.storage.CreateSnapshot(p.appliedIndex, p.confState, nil); err != nil {
+		c.t.Fatal(err)
+	}
+	if err := p.storage.Compact(p.appliedIndex); err != nil {
+		c.t.Fatal(err)
+	}
+}
+
+func (c *cluster) state(id uint64) raft.StateType {
+	return c.peers[id].rn.Status().RaftState
+}
+
+func (c *cluster) term(id uint64) uint64 {
+	return c.peers[id].rn.Status().GetTerm()
+}
+
+func (c *cluster) commit(id uint64) uint64 {
+	return c.peers[id].rn.Status().GetCommit()
+}
+
+func (c *cluster) requireState(id uint64, want raft.StateType) {
+	c.t.Helper()
+	if got := c.state(id); got != want {
+		c.t.Fatalf("node %d is %s, want %s", id, got, want)
+	}
+}
+
+func (c *cluster) requireApplied(id uint64, want ...string) {
+	c.t.Helper()
+	got := c.peers[id].applied
+	if want == nil {
+		want = []string{}
+	}
+	if got == nil {
+		got = []string{}
+	}
+	if !slices.Equal(got, want) {
+		c.t.Fatalf("node %d applied %q, want %q", id, got, want)
+	}
+}
+
+func (c *cluster) requireReads(id uint64, want ...string) {
+	c.t.Helper()
+	got := c.peers[id].reads
+	if want == nil {
+		want = []string{}
+	}
+	if got == nil {
+		got = []string{}
+	}
+	if !slices.Equal(got, want) {
+		c.t.Fatalf("node %d read states %q, want %q", id, got, want)
+	}
+}
+
+func preVote(cfg *raft.Config) {
+	cfg.PreVote = true
+}
+
+func checkQuorum(cfg *raft.Config) {
+	cfg.CheckQuorum = true
+}
+
+func addNode(id uint64) *pb.ConfChange {
+	return &pb.ConfChange{Type: pb.ConfChangeAddNode.Enum(), NodeId: proto.Uint64(id)}
+}
+
