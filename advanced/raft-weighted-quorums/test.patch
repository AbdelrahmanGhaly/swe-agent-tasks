+func TestWeightAppliesAgainAfterReAdding(t *testing.T) {
+	c := newCluster(t, []uint64{1, 2, 3}, nil, map[uint64]uint64{3: 3}, nil)
+	c.campaign(1)
+	c.requireState(1, raft.StateLeader)
+
+	c.proposeConfChange(1, &pb.ConfChange{Type: pb.ConfChangeRemoveNode.Enum(), NodeId: proto.Uint64(3)})
+	if slices.Contains(c.peers[1].confState.GetVoters(), 3) {
+		t.Fatalf("node 3 was not removed: %v", c.peers[1].confState)
+	}
+	c.proposeConfChange(1, addNode(3))
+	if !slices.Contains(c.peers[1].confState.GetVoters(), 3) {
+		t.Fatalf("node 3 was not added back: %v", c.peers[1].confState)
+	}
+	c.tick(1, 1)
+
+	c.isolate(3)
+	c.propose(1, "again")
+	c.requireApplied(1)
+	c.requireApplied(2)
+
+	c.heal(3)
+	c.tick(1, 1)
+	c.requireApplied(1, "again")
+	c.requireApplied(3, "again")
+}
