+// WeightedCommittedIndex is like CommittedIndex, but an index is committed
+// once the voters that acked it hold more than half of the configuration's total
+// weight.
+func (c MajorityConfig) WeightedCommittedIndex(l AckedIndexer, w Weights) Index {
+	if len(w) == 0 || len(c) == 0 {
+		return c.CommittedIndex(l)
+	}
+
+	type ack struct {
+		idx    Index
+		weight uint64
+	}
+	acks := make([]ack, 0, len(c))
+	var total weightSum
+	for id := range c {
+		weight := w.Of(id)
+		total.add(weight)
+		// Voters that haven't reported in count as having acked index zero.
+		idx, ok := l.AckedIndex(id)
+		if !ok {
+			idx = 0
+		}
+		acks = append(acks, ack{idx: idx, weight: weight})
+	}
+	slices.SortFunc(acks, func(a, b ack) int {
+		return cmp.Compare(b.idx, a.idx)
+	})
+
+	var acked weightSum
+	for _, a := range acks {
+		acked.add(a.weight)
+		if acked.moreThanHalfOf(total) {
+			return a.idx
+		}
+	}
+	return 0
+}
