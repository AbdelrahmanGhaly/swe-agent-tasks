 import (
 	"math"
+	"math/bits"
 	"strconv"
 )
 
@@ -37,6 +38,38 @@ type AckedIndexer interface {
 
 type mapAckIndexer map[uint64]Index
 
+// Weights assigns voting weights to voters. A voter without an entry has
+// weight one, so empty Weights describe plain majorities.
+type Weights map[uint64]uint64
+
+// Of returns the voting weight of the given voter.
+func (w Weights) Of(id uint64) uint64 {
+	if weight, ok := w[id]; ok {
+		return weight
+	}
+	return 1
+}
+
+// weightSum adds up voter weights in 128 bits, so that no set of uint64
+// weights can overflow it.
+type weightSum struct {
+	hi, lo uint64
+}
+
+func (s *weightSum) add(weight uint64) {
+	var carry uint64
+	s.lo, carry = bits.Add64(s.lo, weight, 0)
+	s.hi += carry
+}
+
+// moreThanHalfOf reports whether s is more than half of total, which must not
+// be smaller than s.
+func (s weightSum) moreThanHalfOf(total weightSum) bool {
+	restLo, borrow := bits.Sub64(total.lo, s.lo, 0)
+	restHi, _ := bits.Sub64(total.hi, s.hi, borrow)
+	return s.hi > restHi || (s.hi == restHi && s.lo > restLo)
+}
+
 func (m mapAckIndexer) AckedIndex(id uint64) (Index, bool) {
 	idx, ok := m[id]
 	return idx, ok
