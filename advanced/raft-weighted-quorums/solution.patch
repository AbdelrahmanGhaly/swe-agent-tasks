+// WeightedVoteResult is like VoteResult, but the vote is won once the voters in
+// favor hold more than half of the configuration's total weight, and lost once
+// that is out of reach.
+func (c MajorityConfig) WeightedVoteResult(votes map[uint64]bool, w Weights) VoteResult {
+	if len(w) == 0 || len(c) == 0 {
+		return c.VoteResult(votes)
+	}
+
+	var total, yes, possible weightSum
+	for id := range c {
+		weight := w.Of(id)
+		total.add(weight)
+		if v, ok := votes[id]; !ok || v {
