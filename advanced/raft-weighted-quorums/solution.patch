+// setVoterWeights replaces the voting weights and acts on every quorum decision
+// that the new weights settle.
+func (r *raft) setVoterWeights(weights map[uint64]uint64) error {
+	if err := validateVoterWeights(weights); err != nil {
+		return err
+	}
+	r.voterWeights = maps.Clone(weights)
+	r.trk.Weights = r.voterWeights
+
+	switch r.state {
+	case StateLeader:
+		if r.activeAtLastCheck != nil && !r.trk.HasQuorum(r.activeAtLastCheck...) {
+			r.logger.Warningf("%x stepped down to follower since the voters active at its last quorum check are no longer a quorum", r.id)
+			r.becomeFollower(r.Term, None)
+			return nil
+		}
+		if r.maybeCommit() {
+			releasePendingReadIndexMessages(r)
+			r.bcastAppend()
+		}
+		if r.trk.HasQuorum(r.id) {
+			msgs := r.pendingReadIndexMessages
+			r.pendingReadIndexMessages = nil
+			for _, m := range msgs {
+				if resp := r.responseToReadIndexReq(m, r.raftLog.committed); resp.GetTo() != None {
+					r.send(resp)
+				}
+			}
+		}
+		if r.readOnly.option == ReadOnlySafe {
+			for _, rs := range r.readOnly.maybeAdvance(r.trk.Voters, r.trk.Weights) {
+				if resp := r.responseToReadIndexReq(rs.req, rs.index); resp.GetTo() != None {
+					r.send(resp)
+				}
+			}
+		}
+	case StateCandidate, StatePreCandidate:
+		switch _, _, res := r.trk.TallyVotes(); res {
+		case quorum.VoteWon:
+			if r.state == StatePreCandidate {
+				r.campaign(campaignElection)
+			} else {
+				r.becomeLeader()
+				r.bcastAppend()
+			}
+		case quorum.VoteLost:
+			r.becomeFollower(r.Term, None)
+		}
+	}
+	return nil
+}
