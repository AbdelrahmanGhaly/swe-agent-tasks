+                '#if A == B\n#include "yes.h"\n#else\n#include "no.h"\n#endif\n'
+            ),
+            'no.h': '',
+            'yes.h': '',
+        }
+        deps = self.scan(files, cppdefines=['A=1', 'B=C', 'C=1'])
+        self.assertEqual(deps, ['yes.h'])
