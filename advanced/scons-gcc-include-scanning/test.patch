+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() { echo "usage: $0 [--output_path <path>] base|new" >&2; exit 2; }
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new) MODE="$1"; MODE_COUNT=$((MODE_COUNT + 1)); shift ;;
+    --output_path) shift; [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }; OUTPUT_PATH="$1"; shift ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    *) echo "unknown argument: $1" >&2; usage ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+[ -n "$OUTPUT_PATH" ] || OUTPUT_PATH="test-results-$MODE.xml"
+mkdir -p "$(dirname "$OUTPUT_PATH")" || exit 2
+OUTPUT_PATH="$(cd "$(dirname "$OUTPUT_PATH")" && pwd)/$(basename "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")" || exit 1
+export PYTHONPATH="$PWD/testing/framework:$PWD"
+export PYTHONDONTWRITEBYTECODE=1
+
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+STATUS=0
+GROUP=0
+
+# Runs one group of tests in its own pytest process, so that a module
+# changing the working directory cannot disturb the others.  When a group
+# yields no test cases at all (a collection crash or a hang), every test
+# named in its files is recorded as failed, with pytest's exit status and
+# the end of its output.
+run_group() {
+  GROUP=$((GROUP + 1))
+  local xml="$WORK/group$GROUP.xml"
+  local log="$WORK/group$GROUP.log"
+  timeout 900 python -m pytest -p no:cacheprovider -o addopts= -q \
+    --junitxml="$xml" "$@" 2>&1 | tee "$log"
+  local rc=${PIPESTATUS[0]}
+  if [ "$rc" -ne 0 ]; then
+    STATUS=1
+  fi
+  if [ "$rc" -ne 0 ] && ! grep -q '<testcase' "$xml" 2>/dev/null; then
+    python - "$xml" "$rc" "$log" "$@" <<'PY'
+import re
+import sys
+from xml.sax.saxutils import escape, quoteattr
+
+xml, rc, log, args = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
+reason = 'it timed out after 900 seconds' if rc == '124' else f'pytest exited with status {rc}'
+with open(log, errors='replace') as f:
+    output = ''.join(f.readlines()[-60:])
+output = escape(re.sub(r'[\x00-\x08\x0b\x0c\x0e-\x1f]', '', output))
+targets = []
+skip = False
+for arg in args:
+    if skip or arg.startswith('-'):
+        skip = arg == '--deselect'
+        continue
+    targets.append(arg)
+cases = []
+for target in targets:
+    path, _, wanted = target.partition('::')
+    module = path[:-3].replace('/', '.')
+    with open(path) as f:
+        source = f.read()
+    for cls, body in re.findall(r'^class (\w+)\(.*?\):\n((?:(?:[ \t]+.*)?\n)*)', source, re.M):
+        if wanted and cls != wanted:
+            continue
+        for name in re.findall(r'^    def (test\w*)\(', body, re.M):
+            cases.append((f'{module}.{cls}', name))
+lines = ['<?xml version="1.0" encoding="utf-8"?>',
+         f'<testsuites><testsuite name="pytest" tests="{len(cases)}" failures="{len(cases)}" errors="0">']
+for classname, name in cases:
+    lines.append(f'<testcase classname={quoteattr(classname)} name={quoteattr(name)}>'
+                 f'<failure message={quoteattr("the test module could not be run: " + reason)}>'
+                 f'{output}</failure></testcase>')
+lines.append('</testsuite></testsuites>')
+with open(xml, 'w') as f:
+    f.write('\n'.join(lines) + '\n')
+PY
+  fi
+}
+
+if [ "$MODE" = "base" ]; then
+  # cppTests.py's cppTestCase and cppAllTestCase are abstract bases without
+  # a cpp_class; only the concrete classes are meant to run.
+  run_group SCons/cppTests.py::PreProcessorTestCase \
+            SCons/cppTests.py::DumbPreProcessorTestCase \
+            SCons/cppTests.py::fileTestCase
+  run_group SCons/Scanner/CTests.py
+  run_group SCons/DefaultsTests.py
+  # test_tool is a helper that takes an environment, not a test.
+  run_group SCons/EnvironmentTests.py --deselect SCons/EnvironmentTests.py::test_tool
+  # test_remove_fail skips itself when run as root, and a skipped test
+  # does not count as passed.
+  run_group SCons/Node/FSTests.py --deselect SCons/Node/FSTests.py::FSTestCase::test_remove_fail
+else
+  run_group SCons/Scanner/CConditional35735aTests.py
+fi
+
+python - "$OUTPUT_PATH" "$WORK"/group*.xml <<'PY'
+import sys
+import xml.etree.ElementTree as ET
+
+out, parts = sys.argv[1], sys.argv[2:]
+root = ET.Element('testsuites')
+for part in parts:
+    try:
+        tree = ET.parse(part).getroot()
+    except (ET.ParseError, OSError):
+        continue
+    suites = [tree] if tree.tag == 'testsuite' else tree.findall('testsuite')
+    root.extend(suites)
+ET.ElementTree(root).write(out, encoding='utf-8', xml_declaration=True)
+PY
+
+exit "$STATUS"
