+import collections
+import contextlib
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+from unittest import mock
+
+import SCons.Environment
+import SCons.Node.FS
+import SCons.Scanner.C
+
+try:
+    import _posixsubprocess
+except ImportError:
+    _posixsubprocess = None
+
+LAUNCHERS = [(subprocess, 'Popen'), (os, 'system'), (os, 'popen')]
+LAUNCHERS += [
+    (os, name)
+    for name in (
+        'fork',
+        'forkpty',
+        'posix_spawn',
+        'posix_spawnp',
+        'spawnv',
+        'spawnve',
+        'spawnvp',
+        'spawnvpe',
+        'execv',
+        'execve',
+        'execvp',
+        'execvpe',
+        'startfile',
+    )
+    if hasattr(os, name)
+]
+if _posixsubprocess is not None:
+    LAUNCHERS.append((_posixsubprocess, 'fork_exec'))
+
+
+class Environment(collections.UserDict):
+    def __init__(self, fs, **kwargs) -> None:
+        super().__init__()
+        self.data.update(kwargs)
+        self.fs = fs
+
+    def Dictionary(self, *args):
+        return self.data
+
+    def subst(self, strSubst, target=None, source=None, conv=None):
+        if strSubst[0] == '$':
+            return self.data[strSubst[1:]]
+        return strSubst
+
+    def subst_list(self, strSubst, target=None, source=None, conv=None):
+        if strSubst[0] == '$':
+            return [self.data[strSubst[1:]]]
+        return [[strSubst]]
+
+    def subst_path(self, path, target=None, source=None, conv=None):
+        if not isinstance(path, list):
+            path = [path]
+        return list(map(self.subst, path))
+
+    def get_calculator(self):
+        return None
+
+    def get_factory(self, factory):
+        return factory or self.fs.File
+
+    def Dir(self, filename):
+        return self.fs.Dir(filename)
+
+    def File(self, filename):
+        return self.fs.File(filename)
+
+
+class ConditionalScannerTestCase(unittest.TestCase):
+    def run_without_programs(self, function, *args, **kwargs):
+        started = []
+
+        def refuse(*a, **k):
+            started.append(a)
+            raise OSError('no program may be started while scanning')
+
+        with contextlib.ExitStack() as stack:
+            for module, name in LAUNCHERS:
+                stack.enter_context(mock.patch.object(module, name, refuse))
+            result = function(*args, **kwargs)
+        self.assertEqual(started, [])
+        return result
+
+    def scan(self, files, source='main.c', cpppath=(), cppdefines=None, depth=-1):
+        root = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, root)
+        for name, text in files.items():
+            path = os.path.join(root, *name.split('/'))
+            os.makedirs(os.path.dirname(path), exist_ok=True)
+            if isinstance(text, bytes):
+                with open(path, 'wb') as f:
+                    f.write(text)
+            else:
+                with open(path, 'w', newline='', encoding='utf-8') as f:
+                    f.write(text)
+        fs = SCons.Node.FS.FS(root)
+        variables = {'CPPPATH': list(cpppath)}
+        if cppdefines is not None:
+            variables['CPPDEFINES'] = cppdefines
+        env = Environment(fs, **variables)
+        scanner = SCons.Scanner.C.CConditionalScanner()
+        deps = self.run_without_programs(
+            scanner, fs.File(source), env, scanner.path(env), depth
+        )
+        return sorted(os.path.normpath(str(d)).replace(os.sep, '/') for d in deps)
+
+    def test_object_like_chain_from_cppdefines(self) -> None:
+        files = {
