+def cppdefines_macros(env) -> dict:
+    """Return CPPDEFINES as the macros a compiler would be given.
+
+    Each entry is converted and substituted the way the ``-D`` options
+    for the command line are (see :func:`~SCons.Defaults._defines`), then
+    read the way the shell passes it on.  The result maps every macro
+    name, in order, to its value text, or to None for a name defined
+    without a value; a name may carry a parameter list, as in ``F(x)``.
+    """
+    from SCons.Defaults import processDefines
+
+    macros = {}
+    defines = processDefines(env.get('CPPDEFINES') or [])
+    if defines:
+        for define in SCons.Util.flatten(env.subst_list(defines)):
+            name, eq, value = _shell_word(str(define)).partition('=')
+            macros[name] = value if eq else None
+    return macros
+
+
+def _shell_word(arg) -> str:
+    """Return a command-line argument as the shell hands it to a program.
+
+    SCons puts double quotes around an argument holding white space, and
+    the shell then removes quotes and backslash escapes.  An argument the
+    shell would reject is returned unchanged.
+    """
+    if ' ' in arg or '\t' in arg:
+        arg = f'"{arg}"'
+    try:
+        words = shlex.split(arg)
+    except ValueError:
+        return arg
+    return words[0] if words else ''
+
