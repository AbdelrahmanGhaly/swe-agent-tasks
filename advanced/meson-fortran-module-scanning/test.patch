diff --git a/test.sh b/test.sh
new file mode 100755
index 000000000..de262afac
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,91 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() { echo "usage: $0 [--output_path <path>] base|new" >&2; exit 2; }
+
+MODE=""
+MODE_COUNT=0
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    base|new) MODE="$1"; MODE_COUNT=$((MODE_COUNT + 1)); shift ;;
+    --output_path) shift; [ $# -lt 1 ] && { echo "missing value for --output_path" >&2; usage; }; OUTPUT_PATH="$1"; shift ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    *) echo "unknown argument: $1" >&2; usage ;;
+  esac
+done
+[ "$MODE_COUNT" -eq 1 ] || usage
+
+cd "$(dirname "$0")"
+OUTPUT_PATH="${OUTPUT_PATH:-$PWD/junit-$MODE.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+
+NEW_TESTS=unittests/fortranmodulescan_4e9b1d_tests.py
+STATUS=0
+
+run_pytest() {
+  python -m pytest -p no:cacheprovider -o addopts= -q "$@" --junitxml="$WORK/unit.xml" 2>&1 | tee "$WORK/unit.log"
+}
+
+if [ "$MODE" = base ]; then
+  # The Fortran project tests and the Fortran unit tests cover the module
+  # scanning code. run_project_tests.py deletes files under test cases/ when
+  # it starts, so it runs on a copy of the tree.
+  mkdir "$WORK/tree"
+  tar --exclude=./.git -cf - . | tar -xf - -C "$WORK/tree"
+  PROJECTS=0
+  (cd "$WORK/tree" && python run_project_tests.py --only fortran --use-tmpdir) > "$WORK/projects.log" 2>&1 || PROJECTS=1
+  tail -n 25 "$WORK/projects.log"
+  if [ -f "$WORK/tree/meson-test-run.xml" ]; then
+    mv "$WORK/tree/meson-test-run.xml" "$WORK/projects.xml"
+  fi
+  UNIT=0
+  run_pytest unittests/allplatformstests.py -k fortran || UNIT=1
+  PHASES=("projects=$PROJECTS" "unit=$UNIT")
+else
+  UNIT=0
+  run_pytest "$NEW_TESTS" || UNIT=1
+  PHASES=("unit=$UNIT")
+fi
+
+for phase in "${PHASES[@]}"; do
+  [ "${phase#*=}" = 0 ] || STATUS=1
+done
+
+python - "$OUTPUT_PATH" "$WORK" "${PHASES[@]}" <<'EOF' || STATUS=1
+import os
+import sys
+import xml.etree.ElementTree as ET
+
+out, work = sys.argv[1], sys.argv[2]
+root = ET.Element('testsuites')
+synthesized = False
+for arg in sys.argv[3:]:
+    phase, status = arg.split('=')
+    try:
+        tree = ET.parse(os.path.join(work, phase + '.xml')).getroot()
+        suites = [tree] if tree.tag == 'testsuite' else tree.findall('testsuite')
+    except (OSError, ET.ParseError):
+        suites = []
+    root.extend(suites)
+    cases = [c for s in suites for c in s.iter('testcase')]
+    failing = [c for c in cases if c.find('failure') is not None or c.find('error') is not None]
+    if cases and (status == '0' or failing):
+        continue
+    synthesized = True
+    try:
+        with open(os.path.join(work, phase + '.log'), encoding='utf-8', errors='replace') as f:
+            log = f.read()[-4000:]
+    except OSError:
+        log = ''
+    suite = ET.SubElement(root, 'testsuite', name=f'test.sh {phase}', tests='1', failures='1')
+    case = ET.SubElement(suite, 'testcase', name=phase, classname='test.sh')
+    failure = ET.SubElement(case, 'failure', message=f'{phase} tests exited with status {status} without a failing test result')
+    failure.text = log
+ET.ElementTree(root).write(out, encoding='utf-8', xml_declaration=True)
+sys.exit(1 if synthesized else 0)
+EOF
+
+exit "$STATUS"
diff --git a/unittests/fortranmodulescan_4e9b1d_tests.py b/unittests/fortranmodulescan_4e9b1d_tests.py
new file mode 100644
index 000000000..616ccbe58
--- /dev/null
+++ b/unittests/fortranmodulescan_4e9b1d_tests.py
@@ -0,0 +1,1621 @@
+import json
+import os
+import random
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parent.parent
+MESON = [sys.executable, str(ROOT / 'meson.py')]
+
+NO_PROGRAMS = '''import sys
+
+LAUNCHERS = {'system', 'popen', 'execl', 'execle', 'execlp', 'execv', 'execve', 'execvp', 'execvpe',
+             'fexecve', 'posix_spawn', 'posix_spawnp', 'fork', 'vfork'}
+
+
+def refuse(event, args):
+    programs = {'subprocess.Popen', 'os.system', 'os.exec', 'os.posix_spawn', 'os.spawn', 'os.startfile',
+                '_winapi.CreateProcess'}
+    launcher = event in {'ctypes.dlsym', 'ctypes.dlsym/handle'} and args[1] in LAUNCHERS
+    if (event in programs or launcher) and '--internal' in sys.argv:
+        raise RuntimeError(f'the scan ran a program: {event} {args!r}')
+
+
+sys.addaudithook(refuse)
+'''
+
+
+def lib(name, sources, args=(), incdirs=(), link=()):
+    return {'name': name, 'sources': list(sources), 'args': list(args),
+            'incdirs': list(incdirs), 'link': list(link)}
+
+
+def meson_build(case):
+    out = ["project('scan', 'fortran')"]
+    if case.get('project_args'):
+        out.append(f"add_project_arguments({case['project_args']!r}, language: 'fortran')")
+    headers = []
+    if case.get('build_time_headers'):
+        out.append("fs = import('fs')")
+        for i, (name, template) in enumerate(sorted(case['build_time_headers'].items())):
+            out.append(f"header{i} = fs.copyfile({template!r}, {name!r})")
+            headers.append(f'header{i}')
+    for t in case['targets']:
+        kwargs = [f"fortran_args: {t['args']!r}"]
+        if t['incdirs']:
+            kwargs.append(f"include_directories: include_directories({', '.join(map(repr, t['incdirs']))})")
+        if t['link']:
+            kwargs.append(f"link_with: [{', '.join('t_' + n for n in t['link'])}]")
+        sources = f"{t['sources']!r} + [{', '.join(headers)}]" if headers else repr(t['sources'])
+        out.append(f"t_{t['name']} = static_library({t['name']!r}, {sources}, {', '.join(kwargs)})")
+    return '\n'.join(out) + '\n'
+
+
+def split_unescaped(text, sep):
+    i = 0
+    while i < len(text):
+        if text[i] == '$':
+            i += 2
+            continue
+        if text[i] == sep:
+            return text[:i], text[i + 1:]
+        i += 1
+    return text, ''
+
+
+def ninja_paths(text):
+    paths, cur, i = [], '', 0
+    while i < len(text):
+        c = text[i]
+        if c == '$' and i + 1 < len(text):
+            cur += text[i + 1]
+            i += 2
+            continue
+        if c == ' ':
+            if cur:
+                paths.append(cur)
+            cur = ''
+        else:
+            cur += c
+        i += 1
+    if cur:
+        paths.append(cur)
+    return paths
+
+
+def dyndep_files(build):
+    objects = {}
+    current = None
+    for line in (build / 'build.ninja').read_text().splitlines():
+        if line.startswith('build '):
+            outs, rest = split_unescaped(line[6:], ':')
+            rule = rest.split()[0] if rest.split() else ''
+            current = ninja_paths(outs)[0] if rule.startswith('fortran_COMPILER') else None
+        elif current and line.startswith(' dyndep = '):
+            objects[current] = line.split('=', 1)[1].strip()
+    return objects
+
+
+def read_dyndeps(build, objects):
+    entries = {}
+    for dd in sorted(set(objects.values())):
+        for line in (build / dd).read_text().splitlines():
+            if not line.startswith('build '):
+                continue
+            outs, rest = split_unescaped(line[6:], ':')
+            outs = ninja_paths(outs)
+            ins = ninja_paths(rest)
+            assert ins[:1] == ['dyndep'], line
+            entries[outs[0]] = (set(p for p in outs[1:] if p != '|'), set(p for p in ins[1:] if p != '|'))
+    return entries
+
+
+def setup_project(tmp_path, case):
+    src = tmp_path / 'src'
+    for name, text in case['files'].items():
+        path = src / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text)
+    (src / 'meson.build').write_text(meson_build(case))
+    build = tmp_path / 'build'
+    r = subprocess.run(MESON + ['setup', '--backend=ninja', str(build), str(src)],
+                       capture_output=True, text=True)
+    assert r.returncode == 0, r.stdout + r.stderr
+    if case.get('private_files'):
+        compdb = json.loads((build / 'compile_commands.json').read_text())
+        outputs = {os.path.normpath(build / e['file']): e['output'] for e in compdb}
+        for t in case['targets']:
+            private = build / os.path.dirname(outputs[os.path.normpath(src / t['sources'][0])])
+            for name, text in case['private_files'].get(t['name'], {}).items():
+                (private / name).write_text(text)
+    objects = dyndep_files(build)
+    run_scan(tmp_path, build, objects)
+    return src, build, objects
+
+
+def run_scan(tmp_path, build, objects):
+    guard = tmp_path / 'guard'
+    guard.mkdir(exist_ok=True)
+    (guard / 'sitecustomize.py').write_text(NO_PROGRAMS)
+    env = dict(os.environ)
+    env['PYTHONPATH'] = os.pathsep.join(filter(None, [str(guard), env.get('PYTHONPATH')]))
+    r = subprocess.run(['ninja', '-C', str(build)] + sorted(set(objects.values())),
+                       capture_output=True, text=True, env=env)
+    assert r.returncode == 0, r.stdout + r.stderr
+
+
+def module_dir(argv):
+    for i, a in enumerate(argv):
+        if a == '-J':
+            return argv[i + 1]
+        if a.startswith('-J'):
+            return a[2:]
+    raise AssertionError(argv)
+
+
+def search_dirs(argv):
+    dirs = [module_dir(argv)]
+    for i, a in enumerate(argv):
+        if a == '-I':
+            dirs.append(argv[i + 1])
+        elif a.startswith('-I'):
+            dirs.append(a[2:])
+    return dirs
+
+
+def compile_once(argv, build, scratch):
+    shutil.rmtree(scratch, ignore_errors=True)
+    scratch.mkdir()
+    argv = list(argv)
+    jdir = module_dir(argv)
+    argv = [('-J' + str(scratch)) if a == '-J' + jdir else a for a in argv]
+    argv[argv.index('-o') + 1] = str(scratch / 'probe.o')
+    return subprocess.run(argv, cwd=build, capture_output=True, text=True)
+
+
+def gfortran_truth(src, build, case, tmp_path):
+    compdb = json.loads((build / 'compile_commands.json').read_text())
+    by_source = {os.path.normpath(build / e['file']): e for e in compdb}
+    scratch = tmp_path / 'scratch'
+    pending = [(t['name'], s) for t in case['targets'] for s in t['sources']]
+    info = {}
+    while pending:
+        failures = {}
+        remaining = len(pending)
+        for target, s in list(pending):
+            entry = by_source[os.path.normpath(src / s)]
+            argv = shlex.split(entry['command'])
+            jdir = module_dir(argv)
+            mdir = build / jdir
+            mdir.mkdir(parents=True, exist_ok=True)
+            before = set(os.listdir(mdir))
+            r = subprocess.run(argv, cwd=build, capture_output=True, text=True)
+            new = set(os.listdir(mdir)) - before
+            if r.returncode != 0:
+                for f in new:
+                    (mdir / f).unlink()
+                failures[s] = r.stderr
+                continue
+            pending.remove((target, s))
+            info[s] = {'target': target, 'object': entry['output'], 'dir': jdir, 'argv': argv,
+                       'writes': {f for f in new if f.endswith(('.mod', '.smod'))}}
+        assert len(pending) < remaining, \
+            'invalid case, gfortran fails on ' + ', '.join(failures) + ':\n' + '\n'.join(failures.values())
+    for s, i in info.items():
+        reads = set()
+        for d in dict.fromkeys(os.path.normpath(d) for d in search_dirs(i['argv'])):
+            full = build / d
+            if not full.is_dir():
+                continue
+            for f in sorted(os.listdir(full)):
+                if not f.endswith(('.mod', '.smod')) or (d == os.path.normpath(i['dir']) and f in i['writes']):
+                    continue
+                kept = (full / f).read_bytes()
+                (full / f).write_bytes(b'not a module file\n')
+                try:
+                    probe = compile_once(i['argv'], build, scratch)
+                finally:
+                    (full / f).write_bytes(kept)
+                if probe.returncode != 0 and f in probe.stderr:
+                    reads.add((d, f))
+        i['reads'] = reads
+    provider = {}
+    for s, i in info.items():
+        for f in i['writes']:
+            provider[(os.path.normpath(i['dir']), f)] = s
+    expected = {}
+    for s, i in info.items():
+        ins = set()
+        for d, f in i['reads']:
+            p = provider.get((d, f))
+            if p is None or p == s:
+                continue
+            if info[p]['target'] == i['target']:
+                ins.add(f"{info[p]['dir']}/{f}")
+            else:
+                ins.add(info[p]['object'])
+        expected[i['object']] = ({f"{i['dir']}/{f}" for f in i['writes']}, ins)
+    return expected
+
+
+def check(tmp_path, case):
+    src, build, objects = setup_project(tmp_path, case)
+    compare(tmp_path, case, src, build, objects)
+
+
+def compare(tmp_path, case, src, build, objects):
+    got = read_dyndeps(build, objects)
+    if case.get('build_time_headers'):
+        r = subprocess.run(['ninja', '-C', str(build)] + sorted(case['build_time_headers']),
+                           capture_output=True, text=True)
+        assert r.returncode == 0, r.stdout + r.stderr
+    expected = gfortran_truth(src, build, case, tmp_path)
+    assert set(got) == set(expected), sorted(set(got) ^ set(expected))
+    separate = set(case.get('separate', ()))
+    either_way = {f for outs, _ in expected.values() for f in outs
+                  if f.endswith('.smod') and '@' not in os.path.basename(f)
+                  and os.path.basename(f)[:-len('.smod')] not in separate}
+    listed = {o: got.get(o, (set(), set())) for o in expected}
+    assert {o: (outs - either_way, ins - either_way) for o, (outs, ins) in listed.items()} == \
+        {o: (outs - either_way, ins - either_way) for o, (outs, ins) in expected.items()}
+    assert {o: (outs - expected[o][0], ins - expected[o][1]) for o, (outs, ins) in listed.items()} == \
+        {o: (set(), set()) for o in expected}
+
+
+FREE_SUFFIXES = ['f90', 'F90', 'f95', 'F95', 'f03', 'F08']
+FIXED_SUFFIXES = ['f', 'F', 'for', 'FOR', 'ftn', 'fpp']
+STARTS = 'hjqxyz'
+LETTERS = 'abcdefghijklmnopqrstuvwxyz'
+TRICKY = ['module fake', 'use nothere', '; module y', 'a ! b', 'x & y', "it''s", 'end module', 'include']
+
+
+class Tok:
+    def __init__(self, kind, text):
+        self.kind = kind
+        self.text = text
+
+
+def kw(t):
+    return Tok('kw', t)
+
+
+def nm(t):
+    return Tok('name', t)
+
+
+def op(t):
+    return Tok('op', t)
+
+
+def macro(t):
+    return Tok('macro', t)
+
+
+def lit(t):
+    return Tok('str', t)
+
+
+def lname(t):
+    return Tok('lname', t)
+
+
+class Source:
+    def __init__(self, path, free, preprocessed, target):
+        self.path = path
+        self.free = free
+        self.pp = preprocessed
+        self.target = target
+        self.items = []
+        self.defines = {}
+
+
+class Gen:
+    def __init__(self, seed):
+        self.rng = random.Random(seed)
+        self.seed = seed
+        self.used = set()
+        self.files = {}
+        self.targets = []
+        self.project_args = []
+        self.modules = []
+        self.counter = 0
+
+    def name(self, prefix=''):
+        while True:
+            n = prefix + self.rng.choice(STARTS) + ''.join(
+                self.rng.choice(LETTERS + '0123456789') for _ in range(self.rng.randint(2, 6)))
+            if n not in self.used:
+                self.used.add(n)
+                return n
+
+    def macro_name(self):
+        while True:
+            n = 'ZM_' + ''.join(self.rng.choice('ABCDEFGHJKQXYZ') for _ in range(4))
+            if n.lower() not in self.used:
+                self.used.add(n.lower())
+                return n
+
+    def env_for(self, target, source):
+        env = {}
+        for args in (self.project_args, target['args']):
+            for a in args:
+                if a.startswith('-D'):
+                    k, _, v = a[2:].partition('=')
+                    env[k] = v if '=' in a else '1'
+        env.update(source.defines)
+        return env
+
+    def build(self):
+        rng = self.rng
+        if rng.random() < 0.4:
+            m = self.macro_name()
+            self.project_args += [f'-D{m}=7']
+            self.proj_macro = m
+        else:
+            self.proj_macro = None
+        ntargets = rng.randint(1, 3)
+        for ti in range(ntargets):
+            target = {'name': f't{ti}', 'sources': [], 'args': [], 'incdirs': [], 'frozen': False,
+                      'link': [f't{ti - 1}'] if ti and rng.random() < 0.85 else []}
+            if rng.random() < 0.5:
+                target['incdirs'].append(f'inc{ti}')
+                self.files[f'inc{ti}/README'] = 'include files\n'
+            if rng.random() < 0.5:
+                m = self.macro_name()
+                target['args'].append(f'-D{m}')
+            self.targets.append(target)
+            for si in range(rng.randint(1, 3)):
+                self.make_source(target, ti, si)
+        return {'files': self.files, 'project_args': self.project_args,
+                'targets': [{'name': t['name'], 'sources': t['sources'], 'args': t['args'],
+                             'incdirs': t['incdirs'], 'link': t['link']} for t in self.targets],
+                'separate': sorted(m['name'] for m in self.modules if m['smod'])}
+
+    def visible_modules(self, ti, source):
+        linked = set()
+        stack = [ti]
+        while stack:
+            t = stack.pop()
+            for l in self.targets[t]['link']:
+                j = int(l[1:])
+                if j not in linked:
+                    linked.add(j)
+                    stack.append(j)
+        return [m for m in self.modules
+                if m['target'] == ti or m['target'] in linked]
+
+    def make_source(self, target, ti, si):
+        rng = self.rng
+        free = rng.random() < 0.55
+        suffix = rng.choice(FREE_SUFFIXES if free else FIXED_SUFFIXES)
+        sub = rng.choice(['', '', f'dir{ti}{si}/'])
+        path = f'{sub}s{ti}{si}.{suffix}'
+        pp = suffix != suffix.lower() or suffix == 'fpp'
+        src = Source(path, free, pp, target)
+        target['sources'].append(path)
+        self.current = src
+        has_program = False
+        for _ in range(rng.randint(1, 3)):
+            kind = rng.choices(['module', 'submodule', 'program', 'subroutine'], [6, 2, 1, 1])[0]
+            if kind == 'submodule' and not self.smod_parents(ti):
+                kind = 'module'
+            if kind == 'program':
+                if has_program:
+                    kind = 'subroutine'
+                has_program = True
+            getattr(self, 'unit_' + kind)(src, ti)
+        self.render_source(src)
+
+    def smod_parents(self, ti):
+        return [m for m in self.visible_modules(ti, None) if m['smod']]
+
+    def spell(self, src, name, allow_macro=True):
+        rng = self.rng
+        if src.pp and allow_macro and rng.random() < 0.3:
+            m = self.macro_name()
+            r = rng.random()
+            if r < 0.25 and not src.target['frozen']:
+                src.target['args'].append(f'-D{m}={name}')
+            elif r < 0.4:
+                inner = self.macro_name()
+                src.items.append(('define', inner, name))
+                src.items.append(('define', m, inner))
+                src.defines[inner] = name
+            elif r < 0.6:
+                header = self.header(src, [('define', m, name)])
+                src.items.append(('hinclude', header))
+            else:
+                src.items.append(('define', m, name))
+            src.defines[m] = name
+            return macro(m)
+        return nm(name)
+
+    def header(self, src, items):
+        rng = self.rng
+        self.counter += 1
+        hname = f'zh{self.seed}_{self.counter}.h'
+        srcdir = src.path.rpartition('/')[0]
+        incdir = src.target['incdirs'][0] if src.target['incdirs'] else None
+        text = '\n'.join(f'#define {i[1]} {i[2]}' for i in items) + '\n'
+        if incdir and rng.random() < 0.5:
+            if rng.random() < 0.5:
+                self.counter += 1
+                inner = f'zh{self.seed}_{self.counter}.h'
+                self.files[f'{incdir}/{inner}'] = text
+                text = f'#include "{inner}"\n'
+            self.files[f'{incdir}/{hname}'] = text
+        else:
+            self.files[(srcdir + '/' if srcdir else '') + hname] = text
+            if incdir and rng.random() < 0.6:
+                self.files[f'{incdir}/{hname}'] = '#define ZQ_DECOY 1\n'
+        return hname
+
+    def uses(self, src, ti, exclude=(), module_scope=False):
+        rng = self.rng
+        vis = [m for m in self.visible_modules(ti, src) if m['name'] not in exclude
+               and not (module_scope and m['smod'])]
+        stmts = []
+        for m in rng.sample(vis, min(len(vis), rng.randint(0, 3))):
+            form = rng.randint(0, 4)
+            name = lname(m['name']) if m.get('literal') else self.spell(src, m['name'])
+            if form == 0:
+                stmts.append([kw('use'), name])
+            elif form == 1:
+                stmts.append([kw('use'), op('::'), name])
+            elif form == 2:
+                stmts.append([kw('use'), op(','), kw('non_intrinsic'), op('::'), name])
+            elif form == 3:
+                stmts.append([kw('use'), name, op(','), kw('only'), op(':')])
+            else:
+                stmts.append([kw('use'), op(','), kw('non_intrinsic'), op('::'), name, op(','), kw('only'), op(':')])
+        if rng.random() < 0.3:
+            stmts.append([kw('use'), op(','), kw('intrinsic'), op('::'), nm('iso_c_binding')])
+        if rng.random() < 0.2:
+            stmts.append([kw('use'), nm('iso_fortran_env')])
+        return stmts
+
+    def noise_decls(self):
+        rng = self.rng
+        out = []
+        if rng.random() < 0.5:
+            out.append([kw('integer'), op('::'), nm(self.name()), op('='), Tok('num', str(rng.randint(0, 9)))])
+        if rng.random() < 0.5:
+            text = rng.choice(TRICKY)
+            literal = "'" + text + "'" if rng.random() < 0.6 else '"' + text.replace("''", "'") + '"'
+            out.append([kw('character'), op('('), kw('len'), op('='), op('*'), op(')'), op(','),
+                        kw('parameter'), op('::'), nm(self.name()), op('='), lit(literal)])
+        return out
+
+    def dead(self, src, ti):
+        rng = self.rng
+        out = []
+        if rng.random() < 0.6:
+            n = self.name('d')
+            out.append([kw('module'), nm(n)])
+            out.append([kw('end'), kw('module'), nm(n)])
+        vis = self.visible_modules(ti, src)
+        if vis and rng.random() < 0.6:
+            out.append([kw('use'), lname(rng.choice(vis)['name'])])
+        return out
+
+    def guard(self, src, body, ti):
+        rng = self.rng
+        if not src.pp or rng.random() < 0.55:
+            return body
+        env = self.env_for(src.target, src)
+        options = []
+        options.append(('if 1', True))
+        options.append(('if 0', False))
+        for k in env:
+            if k.startswith('ZM_'):
+                options.append((f'ifdef {k}', True))
+                options.append((f'ifndef {k}', False))
+                options.append((f'if defined({k}) || 0', True))
+        if self.proj_macro and self.proj_macro in env:
+            options.append((f'if {self.proj_macro} * 2 - 1 > 12', True))
+            options.append((f'if ({self.proj_macro} % 3) == 2 && defined({self.proj_macro})', False))
+        cond, live = rng.choice(options)
+        dead = self.dead(src, ti)
+        out = [('pp', cond)]
+        if rng.random() < 0.5:
+            out += (body if live else dead)
+            out.append(('pp', 'else'))
+            out += (dead if live else body)
+        else:
+            if live:
+                out += body
+            else:
+                out += dead
+                out.append(('pp', 'elif 1'))
+                out += body
+        out.append(('pp', 'endif'))
+        return out
+
+    def module_new(self, src, ti, smod):
+        rng = self.rng
+        if rng.random() < 0.15 and not src.target['frozen']:
+            m = self.macro_name()
+            if src.pp:
+                src.items.append(('define', m, self.name()))
+                n = m.lower()
+            else:
+                src.target['args'].append(f'-D{m}={self.name()}')
+                n = m.lower()
+            self.used.add(n)
+            self.modules.append({'name': n, 'target': ti, 'smod': smod, 'subs': [], 'literal': m})
+            return n
+        n = self.name()
+        self.modules.append({'name': n, 'target': ti, 'smod': smod, 'subs': []})
+        return n
+
+    def unit_module(self, src, ti):
+        rng = self.rng
+        smod = rng.random() < 0.45
+        n = self.module_new(src, ti, smod)
+        body = []
+        body.append([kw('module'), lname(n) if self.modules[-1].get('literal') else self.spell(src, n)])
+        body += self.uses(src, ti, exclude={n}, module_scope=True)
+        body.append([kw('implicit'), kw('none')])
+        body += self.noise_decls()
+        if smod:
+            body.append([kw('interface')])
+            for _ in range(rng.randint(1, 2)):
+                p = self.name()
+                form = rng.randint(0, 6)
+                if form == 0:
+                    body.append([kw('module'), kw('subroutine'), nm(p), op('('), op(')')])
+                    body.append([kw('end'), kw('subroutine')])
+                elif form == 1:
+                    body.append([kw('pure'), kw('module'), kw('function'), nm(p), op('('), nm('x'), op(')'),
+                                 kw('result'), op('('), nm('r'), op(')')])
+                    body.append([kw('integer'), op(','), kw('intent'), op('('), kw('in'), op(')'), op('::'), nm('x')])
+                    body.append([kw('integer'), op('::'), nm('r')])
+                    body.append([kw('end'), kw('function')])
+                elif form == 2:
+                    body.append([kw('integer'), kw('module'), kw('function'), nm(p), op('('), op(')')])
+                    body.append([kw('end'), kw('function'), nm(p)])
+                elif form == 3:
+                    body.append([kw('module'), kw('recursive'), kw('subroutine'), nm(p), op('('), nm('a'), op(')')])
+                    body.append([kw('real'), op(','), kw('intent'), op('('), kw('inout'), op(')'), op('::'), nm('a')])
+                    body.append([kw('end'), kw('subroutine'), nm(p)])
+                elif form == 4:
+                    body.append([kw('module'), kw('elemental'), kw('integer'), kw('function'), nm(p), op('('), nm('i'), op(')')])
+                    body.append([kw('integer'), op(','), kw('intent'), op('('), kw('in'), op(')'), op('::'), nm('i')])
+                    body.append([kw('end'), kw('function')])
+                elif form == 5:
+                    body.append([kw('impure'), kw('module'), kw('subroutine'), nm(p)])
+                    body.append([kw('end'), kw('subroutine'), nm(p)])
+                else:
+                    body.append([kw('logical'), kw('module'), kw('function'), nm(p), op('('), op(')')])
+                    body.append([kw('end'), kw('function')])
+            body.append([kw('end'), kw('interface')])
+        procs = []
+        if rng.random() < 0.5:
+            g, p = self.name(), self.name()
+            body.append([kw('interface'), nm(g)])
+            if rng.random() < 0.5:
+                body.append([kw('module'), kw('procedure'), nm(p)])
+            else:
+                body.append([kw('module'), kw('procedure'), op('::'), nm(p)])
+            body.append([kw('end'), kw('interface'), nm(g)])
+            procs.append(p)
+        if procs or rng.random() < 0.4:
+            body.append([kw('contains')])
+            for p in procs or [self.name()]:
+                body.append([kw('subroutine'), nm(p), op('('), op(')')])
+                body += self.uses(src, ti, exclude={n})
+                if rng.random() < 0.5:
+                    body.append([kw('block')])
+                    body += self.uses(src, ti, exclude={n})
+                    body.append([kw('end'), kw('block')])
+                body.append([kw('end'), kw('subroutine'), nm(p)])
+        name_tok = lname(n) if self.modules[-1].get('literal') else nm(n)
+        body.append([kw('end'), kw('module'), name_tok] if rng.random() < 0.7 else [kw('end'), kw('module')])
+        src.items += self.guard(src, body, ti)
+
+    def unit_submodule(self, src, ti):
+        rng = self.rng
+        parent = rng.choice(self.smod_parents(ti))
+        n = self.name()
+        head = [kw('submodule'), op('('), lname(parent['name']) if parent.get('literal') else self.spell(src, parent['name'])]
+        visible = {m['target'] for m in self.visible_modules(ti, src)} | {ti}
+        subs = [n2 for n2, t2 in parent['subs'] if t2 in visible]
+        if subs and rng.random() < 0.5:
+            head += [op(':'), nm(rng.choice(subs))]
+        head += [op(')'), nm(n)]
+        body = [head]
+        body += self.uses(src, ti, exclude={parent['name']})
+        body.append([kw('end'), kw('submodule'), nm(n)] if rng.random() < 0.6 else [kw('end'), kw('submodule')])
+        parent['subs'].append((n, ti))
+        src.items += self.guard(src, body, ti)
+
+    def unit_program(self, src, ti):
+        n = self.name()
+        body = [[kw('program'), nm(n)]]
+        body += self.uses(src, ti)
+        body.append([kw('implicit'), kw('none')])
+        body.append([kw('print'), op('*'), op(','), lit("'" + self.rng.choice(TRICKY) + "'")])
+        body.append([kw('end'), kw('program'), nm(n)] if self.rng.random() < 0.7 else [kw('end')])
+        src.items += self.guard(src, body, ti)
+
+    def unit_subroutine(self, src, ti):
+        n = self.name()
+        body = [[kw('subroutine'), nm(n), op('('), op(')')]]
+        body += self.uses(src, ti)
+        body.append([kw('end'), kw('subroutine'), nm(n)] if self.rng.random() < 0.7 else [kw('end')])
+        src.items += self.guard(src, body, ti)
+
+    def case(self, text):
+        r = self.rng.random()
+        if r < 0.4:
+            return text.lower()
+        if r < 0.7:
+            return text.upper()
+        return ''.join(c.upper() if self.rng.random() < 0.5 else c.lower() for c in text)
+
+    def statement_text(self, toks, fixed, pp):
+        rng = self.rng
+        out = ''
+        prev = None
+        for t in toks:
+            if t.kind in {'kw', 'name', 'lname'}:
+                piece = self.case(t.text) if t.kind != 'lname' else t.text.lower()
+                if fixed and rng.random() < 0.08 and len(piece) > 2:
+                    k = rng.randint(1, len(piece) - 1)
+                    piece = piece[:k] + ' ' + piece[k:]
+            else:
+                piece = t.text
+            word = t.kind in {'kw', 'name', 'lname', 'macro', 'num'}
+            if prev is None:
+                sep = ''
+            elif word and prev in {'kw', 'name', 'lname', 'macro', 'num'}:
+                if fixed and t.kind != 'macro' and prev != 'macro' and rng.random() < 0.3:
+                    sep = ''
+                else:
+                    sep = ' ' * rng.randint(1, 2)
+            else:
+                sep = ' ' * rng.randint(0, 1)
+            if t.kind == 'macro' or prev == 'macro':
+                sep = sep or ' '
+            out += sep + piece
+            prev = t.kind
+        return out
+
+    def comment(self):
+        return self.rng.choice(['module zzfake', 'use zzfake', "don't", 'x & y', '"', 'module', 'ends in &'])
+
+    def render_free(self, stmts):
+        rng = self.rng
+        lines = []
+        i = 0
+        while i < len(stmts):
+            item = stmts[i]
+            if item[0] == 'pp':
+                lines.append('#' + ' ' * rng.randint(0, 2) + item[1])
+                i += 1
+                continue
+            if item[0] == 'define':
+                lines.append(f'#define {item[1]} {item[2]}')
+                i += 1
+                continue
+            if item[0] == 'hinclude':
+                lines.append(f'#include "{item[1]}"')
+                i += 1
+                continue
+            if item[0] == 'include':
+                q = rng.choice(["'", '"'])
+                lines.append(' ' * rng.randint(0, 2) + self.case('include') + ' ' * rng.randint(0, 2) + q + item[1] + q
+                             + (rng.choice(['', '  ! ' + self.comment()])))
+                i += 1
+                continue
+            if item[0] == 'raw':
+                lines.append(item[1])
+                i += 1
+                continue
+            text = self.statement_text(item, False, False)
+            if (i + 1 < len(stmts) and isinstance(stmts[i + 1], list) and rng.random() < 0.15
+                    and item[0].text in {'module', 'use', 'implicit'} and stmts[i + 1][0].text in {'use', 'implicit', 'end'}):
+                text += ' ' * rng.randint(0, 1) + ';' + ' ' * rng.randint(0, 2) + self.statement_text(stmts[i + 1], False, False)
+                i += 1
+            if rng.random() < 0.1 and item[0].text in {'module', 'use', 'end'}:
+                self.counter += 1
+                text = str(self.counter) + ' ' + text
+            indent = ' ' * rng.randint(0, 4)
+            spans = [(m.start(), m.end()) for m in re.finditer(r'ZM_[A-Z]+', text)]
+            candidates = [q for q in range(1, len(text)) if not any(a < q < b for a, b in spans)]
+            if len(text) > 4 and candidates and rng.random() < 0.35:
+                p = rng.choice(candidates)
+                before, after = text[:p], text[p:]
+                in_str = before.count("'") % 2 == 1 or before.count('"') % 2 == 1
+                at_blank = before[-1:] == ' ' or after[:1] == ' '
+                lead = in_str or not at_blank or rng.random() < 0.5
+                first = indent + before + '&' + ('' if in_str else rng.choice(['', '  ! ' + self.comment()]))
+                lines.append(first)
+                if not in_str:
+                    for _ in range(rng.randint(0, 2)):
+                        lines.append(rng.choice(['', '   ! ' + self.comment()]))
+                lines.append(' ' * rng.randint(0, 6) + ('&' if lead else '') + (after if lead else after.lstrip() or after))
+            else:
+                lines.append(indent + text + rng.choice(['', '', '  ! ' + self.comment()]))
+            if rng.random() < 0.1:
+                lines.append(rng.choice(['', '! ' + self.comment(), '!$ use zzsentinel']))
+            i += 1
+        return lines
+
+    def render_fixed(self, stmts, pp):
+        rng = self.rng
+        lines = []
+        joined = set()
+        for item in stmts:
+            if id(item) in joined:
+                continue
+            if item[0] == 'pp':
+                lines.append('#' + ' ' * rng.randint(0, 2) + item[1])
+                continue
+            if item[0] == 'define':
+                lines.append(f'#define {item[1]} {item[2]}')
+                continue
+            if item[0] == 'hinclude':
+                lines.append(f'#include "{item[1]}"')
+                continue
+            if item[0] == 'include':
+                kwtext = self.case('include')
+                if rng.random() < 0.3:
+                    kwtext = ' '.join(kwtext)
+                q = rng.choice(["'", '"'])
+                lines.append('      ' + kwtext + ' ' + q + item[1] + q)
+                continue
+            if item[0] == 'raw':
+                lines.append(item[1])
+                continue
+            text = self.statement_text(item, True, pp)
+            nxt = stmts[stmts.index(item) + 1] if stmts.index(item) + 1 < len(stmts) else None
+            if (isinstance(nxt, list) and item[0].text in {'module', 'use'} and nxt[0].text in {'use', 'implicit'}
+                    and rng.random() < 0.12 and len(text) < 40):
+                joined.add(id(nxt))
+                text += ';' + ' ' * rng.randint(0, 1) + self.statement_text(nxt, True, pp)
+            text_all = text
+            chunks = []
+            while text:
+                room = 66
+                if len(text) > room or (len(text) > 6 and rng.random() < 0.25):
+                    p = rng.randint(1, min(room, len(text) - 1))
+                    if any(t.kind == 'macro' for t in item):
+                        p = min(room, len(text))
+                        if p < len(text):
+                            while p > 1 and (text[p - 1].isalnum() or text[p - 1] == '_'):
+                                p -= 1
+                    chunks.append(text[:p])
+                    text = text[p:]
+                else:
+                    chunks.append(text)
+                    text = ''
+            for k, chunk in enumerate(chunks):
+                tab = rng.random() < 0.2
+                if k == 0:
+                    if tab:
+                        line = '\t' + chunk
+                    else:
+                        label = ''
+                        if rng.random() < 0.08 and item[0].text in {'module', 'use'}:
+                            self.counter += 1
+                            label = str(self.counter % 99999 + 1)
+                        line = label.rjust(5) + ' ' + chunk
+                else:
+                    if tab:
+                        line = '\t' + rng.choice('123456789') + chunk
+                    else:
+                        line = '     ' + rng.choice('&123456789+$!a') + chunk
+                    if rng.random() < 0.3:
+                        lines.append(rng.choice(['C ' + self.comment(), 'c', '* ' + self.comment(), '', '  ! ' + self.comment()]))
+                width = len(line.expandtabs(8)) if not tab else 6 + len(chunk) + (1 if k else 0)
+                has_macro = pp and 'ZM_' in text_all
+                quoted = "'" in chunk or '"' in chunk
+                if '\t' not in line and len(line) < 72 and rng.random() < 0.15 and not quoted and not has_macro:
+                    line = line.ljust(72) + rng.choice(['IGNORED', '; MODULE ZJUNK', ' USE ZJUNK2', '&&&'])
+                elif rng.random() < 0.15 and not quoted and width < 60:
+                    line += '  ! ' + self.comment()
+                lines.append(line)
+            if rng.random() < 0.1:
+                lines.append(rng.choice(['C ' + self.comment(), '*', '', '!$ use zzsentinel']))
+        return lines
+
+    def render_source(self, src):
+        rng = self.rng
+        items = src.items
+        if rng.random() < 0.35 and len(items) > 2:
+            start = rng.randint(0, len(items) - 2)
+            end = rng.randint(start + 1, min(len(items), start + 6))
+            chunk = items[start:end]
+            if all(isinstance(x, list) and all(t.kind != 'macro' for t in x) for x in chunk):
+                self.counter += 1
+                name = f'zi{self.seed}_{self.counter}.inc'
+                incdir = src.target['incdirs'][0] if src.target['incdirs'] else None
+                srcdir = src.path.rpartition('/')[0]
+                if incdir and rng.random() < 0.5:
+                    self.add_include_file(f'{incdir}/{name}', chunk, src)
+                else:
+                    self.add_include_file((srcdir + '/' if srcdir else '') + name, chunk, src)
+                    if incdir and rng.random() < 0.6:
+                        fake = self.name('d')
+                        decoy = [[kw('module'), nm(fake)], [kw('end'), kw('module')]]
+                        self.add_include_file(f'{incdir}/{name}', decoy, src)
+                items = items[:start] + [('include', name)] + items[end:]
+        lines = self.render_free(items) if src.free else self.render_fixed(items, src.pp)
+        if not src.pp and rng.random() < 0.3:
+            lines = ['#if 0', '#define ZZ_NOTHING 1'] + lines + ['#endif']
+        self.files[src.path] = '\n'.join(lines) + '\n'
+
+    def add_include_file(self, rel, chunk, src):
+        lines = self.render_free(chunk) if src.free else self.render_fixed(chunk, False)
+        if self.rng.random() < 0.3:
+            lines = ['#if 0'] + lines + ['#endif']
+        self.files[rel] = '\n'.join(lines) + '\n'
+
