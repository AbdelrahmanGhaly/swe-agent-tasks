+def every_suffix():
+    files = {}
+    used = []
+    for i, suffix in enumerate(SUFFIXES):
+        tag = f'zq_s{i}'
+        free = suffix.lower() in {'f90', 'f95', 'f03', 'f08'}
+        preprocessed = suffix != suffix.lower() or suffix == 'fpp'
+        lead = '' if free else '      '
+        for d in ('a', 'b'):
+            files[f'inc_{d}/{tag}.inc'] = f'{lead}module {tag}_include_{d}\n{lead}end module\n'
+        text = f"{lead}include '{tag}.inc'\n"
+        used.append(f'{tag}_include_a')
+        if preprocessed:
+            for d in ('a', 'b'):
+                files[f'inc_{d}/{tag}.h'] = f'#define ZQ_HNAME {tag}_header_{d}\n'
+            text = (f'#include "{tag}.h"\n' + text
+                    + f'#if ZQ_ORDER == 2\n{lead}module {tag}_target\n{lead}end module\n'
+                    + f'#else\n{lead}module {tag}_project\n{lead}end module\n#endif\n'
+                    + f'{lead}module ZQ_HNAME\n{lead}end module\n')
+            used += [f'{tag}_target', f'{tag}_header_a']
+        files[f'{tag}.{suffix}'] = text
+    files['user.f90'] = 'program p\n' + ''.join(f' use {u}\n' for u in used) + 'end program\n'
+    return one(files, args=['-DZQ_ORDER=2'], incdirs=['inc_a', 'inc_b'], project_args=['-DZQ_ORDER=1'])
