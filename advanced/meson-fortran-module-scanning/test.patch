+@pytest.mark.parametrize('name', sorted(INCLUDE_EDITS))
+def test_dyndep_and_object_follow_an_included_file_that_changes(tmp_path, name):
+    consumer, consumer_name, included, before, after, others = INCLUDE_EDITS[name]
+    case = one({'a.f90': mod('first'), 'c.f90': mod('second'), consumer_name: consumer, included: before, **others})
+    src, build, objects = setup_project(tmp_path, case)
+    compare(tmp_path, case, src, build, objects)
+    target = next(o for o in objects if os.path.basename(o).startswith(consumer_name))
+    clear_outputs(build)
+    build_with_ninja(build, sorted(o for o in objects if o != target))
+    build_with_ninja(build)
+    built = (build / target).stat().st_mtime_ns
+    path = src / included
+    path.write_text(after)
+    later = path.stat().st_mtime + 10
+    os.utime(path, (later, later))
+    run_scan(tmp_path, build, objects)
+    build_with_ninja(build)
+    assert (build / target).stat().st_mtime_ns != built
+    clear_outputs(build)
+    build_with_ninja(build, [target])
+    clear_outputs(build)
+    compare(tmp_path, case, src, build, objects)
