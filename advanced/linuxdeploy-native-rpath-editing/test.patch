+    // gcc links with LLVM's lld when a directory on its program path has an ld.lld; distributions keep lld in the
+    // directory of their LLVM version
+    std::vector<std::string> lldFlags() {
+        static const fs::path directory = []() {
+            const auto result = makeTemporaryDirectory("native-rpath-lld");
+            std::vector<fs::path> candidates{"/usr/bin/ld.lld"};
+
+            for (const auto& entry : fs::directory_iterator("/usr/lib")) {
+                if (entry.path().filename().string().rfind("llvm-", 0) == 0)
+                    candidates.push_back(entry.path() / "bin" / "lld");
+            }
+
+            for (const auto& candidate : candidates) {
+                if (fs::exists(candidate)) {
+                    fs::create_symlink(candidate, result / "ld.lld");
+                    break;
+                }
+            }
+
+            return result;
+        }();
+
+        return {"-B" + directory.string(), "-fuse-ld=lld"};
+    }
