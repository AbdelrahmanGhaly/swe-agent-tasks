+    // an executable whose DT_AUDIT or DT_DEPAUDIT name the linker stored inside its DT_RUNPATH string; the audit
+    // library announces itself when the dynamic loader loads it
+    void expectAuditNameInsideTheOldRunpathWorks(const fs::path& root, int64_t tag) {
+        FixtureOptions options;
+        options.executableTag = Tag::None;
+        const auto fixture = buildFixture(root, options);
+        const auto audit = root / "audit" / "libaudit.so";
+        const auto program = root / "bin" / "audited";
+
+        writeFile(root / "src" / "audit.c", "#include <unistd.h>\nunsigned int la_version(unsigned int version) { if (write(1, \"audited\\n\", 8) < 0) {} return version; }\n");
+        fs::create_directories(audit.parent_path());
+        compile({"/usr/bin/gcc", "-shared", "-fPIC", "-o", audit.string(), (root / "src" / "audit.c").string()}, root);
+        compile({"/usr/bin/gcc", "-DBSS_SIZE=65536", "-o", program.string(), (root / "src" / "main.c").string(), "-L" + (root / "lib").string(), "-lrun",
+                 "-Wl,-rpath-link," + (root / "deps-a").string(), "-Wl,--enable-new-dtags", "-Wl,-rpath,$ORIGIN/../lib:" + audit.string(),
+                 std::string(tag == DT_AUDIT ? "-Wl,--audit=" : "-Wl,--depaudit=") + audit.string()}, root);
+
+        const ElfImage image(program);
+        const auto runpath = image.value(DT_RUNPATH).value();
+        const auto name = image.value(tag).value();
+        ASSERT_TRUE(name > runpath && name < runpath + image.string(runpath).size()) << "the linker did not store the audit name inside the DT_RUNPATH string";
+
+        const auto expected = runProcess({program.string()}, root);
+        ASSERT_TRUE(expected.succeeded() && expected.output == "audited\n" + outputWithA) << expected.output;
+        const auto before = Snapshot(program, root / "snapshots");
+        const auto value = "$ORIGIN/../lib:/" + std::string(audit.string().size() - 1, 'x');
+
+        ASSERT_TRUE(setsRPath(program, value));
+
+        EXPECT_TRUE(hasEntries(program, {}, {value}));
+        EXPECT_TRUE(runsWith(root, program, expected.output));
+        expectOnlyRPathChanged(before, program);
+    }
