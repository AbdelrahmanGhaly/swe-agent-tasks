+    ASSERT_TRUE(setsRPath(root / "bin/checked", "$ORIGIN/../lib"));
+
+    EXPECT_TRUE(runsWith(root, root / "bin/checked", "result=44\n"));
+    expectStrippedCopyWorks(fixture, {root / "lib/libchecked.so", root / "bin/checked"}, {{root / "bin/checked", "result=44\n"}});
+}
