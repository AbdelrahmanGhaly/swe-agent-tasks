+              "int checked(int value) { ++calls; if (value > 100) throw std::runtime_error(\"too big\"); return value + dep_value() + calls; }\n");
+    writeFile(path("cxx/src/main.cpp"),
+              "#include <iostream>\n#include <stdexcept>\n#include <thread>\n"
+              "int checked(int value);\n"
+              "int main() {\n"
+              "    int result = 0;\n"
+              "    std::thread worker([&result]() { try { checked(1000); } catch (const std::exception& e) { result = checked(2); } });\n"
+              "    worker.join();\n"
+              "    std::cout << \"result=\" << result << std::endl;\n"
+              "}\n");
+    writeFile(path("cxx/src/dep.c"), "int dep_value(void) { return 40; }\n");
+
+    const auto root = path("cxx");
+    fs::create_directories(root / "deps");
