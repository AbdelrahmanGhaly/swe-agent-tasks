+    // the offset of a name the linker stored inside another string
+    ::testing::AssertionResult storedInside(const fs::path& file, const std::string& name, int64_t tag) {
+        const ElfImage image(file);
+        const auto value = image.value(tag);
+
+        if (!value.has_value())
+            return ::testing::AssertionFailure() << file << " has no entry with tag " << tag;
+
+        const auto container = image.string(value.value());
+        const auto table = image.at(image.value(DT_STRTAB).value(), image.value(DT_STRSZ).value());
+        const auto end = value.value() + container.size();
+
+        for (uint64_t offset = value.value() + 1; offset < end; ++offset) {
+            if (std::string(table.data() + offset) == name) {
+                const auto symbols = runProcess({"/usr/bin/readelf", "-W", "--dyn-syms", file.string()}, file.parent_path()).output;
+                const auto needed = image.strings(DT_NEEDED);
+
+                if (symbols.find(" " + name + "\n") != std::string::npos || std::find(needed.begin(), needed.end(), name) != needed.end())
+                    return ::testing::AssertionSuccess();
+            }
+        }
+
+        return ::testing::AssertionFailure() << "the linker did not store " << name << " inside \"" << container << "\" in " << file;
+    }
+
+    bool isElfFile(const fs::path& file) {
+        std::ifstream ifs(file, std::ios::binary);
+        char magic[SELFMAG] = {};
+        ifs.read(magic, SELFMAG);
+        return ifs && memcmp(magic, ELFMAG, SELFMAG) == 0;
+    }
