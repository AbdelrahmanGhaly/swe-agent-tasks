+    // gives the fixture's library a DT_RPATH for deps-a and a DT_RUNPATH for deps-b (older linkers wrote both)
+    void giveLibraryBothEntries(const Fixture& fixture) {
+        const auto both = fixture.root / "both" / "librun.so";
+        fs::create_directories(both.parent_path());
+
+        compile({"/usr/bin/gcc", "-shared", "-fPIC", "-o", both.string(), (fixture.root / "src" / "lib.c").string(),
+                 "-L" + (fixture.root / "deps-a").string(), "-ldep", "-Wl,--disable-new-dtags", "-Wl,-rpath,$ORIGIN/../deps-a",
+                 "-Wl,-soname,$ORIGIN/../deps-b"}, fixture.root);
+
+        auto data = readBytes(both);
+        ElfImage image(both);
+
+        for (const auto& phdr : image.phdrs) {
+            if (phdr.p_type != PT_DYNAMIC)
+                continue;
+
+            for (uint64_t position = 0; position + sizeof(Elf64_Dyn) <= phdr.p_filesz; position += sizeof(Elf64_Dyn)) {
+                Elf64_Dyn entry;
+                memcpy(&entry, data.data() + phdr.p_offset + position, sizeof(entry));
+
+                if (entry.d_tag == DT_SONAME) {
+                    entry.d_tag = DT_RUNPATH;
+                    memcpy(data.data() + phdr.p_offset + position, &entry, sizeof(entry));
+                }
+            }
+        }
+
+        writeBytes(both, data);
+        fs::copy_file(both, fixture.library(), fs::copy_options::overwrite_existing);
+    }
