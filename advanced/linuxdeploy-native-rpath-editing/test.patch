+    // an ELF reader of its own, so that the checks do not depend on the code under test
+    class ElfImage {
+        public:
+            fs::path path;
+            std::vector<char> bytes;
+            Elf64_Ehdr ehdr{};
+            std::vector<Elf64_Phdr> phdrs;
+            std::vector<Section> sections;
+            std::vector<Elf64_Dyn> dynamic;
+
+        private:
+            template<typename T>
+            T load(uint64_t offset) const {
+                if (offset > bytes.size() || bytes.size() - offset < sizeof(T))
+                    throw std::runtime_error("truncated ELF file " + path.string());
+
+                T value;
+                memcpy(&value, bytes.data() + offset, sizeof(T));
+                return value;
+            }
+
+        public:
+            explicit ElfImage(const fs::path& file) : path(file), bytes(readBytes(file)) {
+                if (bytes.size() < sizeof(Elf64_Ehdr) || memcmp(bytes.data(), ELFMAG, SELFMAG) != 0 || bytes[EI_CLASS] != ELFCLASS64)
+                    throw std::runtime_error("not a 64-bit ELF file: " + file.string());
+
+                ehdr = load<Elf64_Ehdr>(0);
+
+                for (uint64_t i = 0; i < ehdr.e_phnum; ++i)
+                    phdrs.push_back(load<Elf64_Phdr>(ehdr.e_phoff + i * sizeof(Elf64_Phdr)));
+
+                if (ehdr.e_shoff != 0 && ehdr.e_shnum != 0) {
+                    std::vector<Elf64_Shdr> headers;
+                    for (uint64_t i = 0; i < ehdr.e_shnum; ++i)
+                        headers.push_back(load<Elf64_Shdr>(ehdr.e_shoff + i * sizeof(Elf64_Shdr)));
+
+                    const auto& names = headers.at(ehdr.e_shstrndx);
+
+                    for (const auto& header : headers) {
+                        Section section;
+                        section.header = header;
+                        if (header.sh_name < names.sh_size)
+                            section.name = std::string(bytes.data() + names.sh_offset + header.sh_name);
+                        sections.push_back(section);
+                    }
+                }
+
+                for (const auto& phdr : phdrs) {
+                    if (phdr.p_type != PT_DYNAMIC)
+                        continue;
+
+                    for (uint64_t position = 0; position + sizeof(Elf64_Dyn) <= phdr.p_filesz; position += sizeof(Elf64_Dyn)) {
+                        const auto entry = load<Elf64_Dyn>(phdr.p_offset + position);
+
+                        if (entry.d_tag == DT_NULL)
+                            break;
+
+                        dynamic.push_back(entry);
+                    }
+                }
+            }
+
+            std::vector<char> at(uint64_t address, uint64_t size) const {
+                for (const auto& phdr : phdrs) {
+                    if (phdr.p_type == PT_LOAD && address >= phdr.p_vaddr && address + size <= phdr.p_vaddr + phdr.p_filesz) {
+                        const auto offset = phdr.p_offset + (address - phdr.p_vaddr);
+
+                        if (offset + size > bytes.size())
+                            break;
+
+                        return {bytes.begin() + static_cast<std::ptrdiff_t>(offset), bytes.begin() + static_cast<std::ptrdiff_t>(offset + size)};
+                    }
+                }
+
+                throw std::runtime_error("address not backed by " + path.string());
+            }
+
+            std::optional<uint64_t> value(int64_t tag) const {
+                for (const auto& entry : dynamic) {
+                    if (entry.d_tag == tag)
+                        return entry.d_un.d_val;
+                }
+
+                return std::nullopt;
+            }
+
+            std::string string(uint64_t offset) const {
+                const auto table = at(value(DT_STRTAB).value(), value(DT_STRSZ).value());
+
+                if (offset >= table.size())
+                    throw std::runtime_error("string offset out of range in " + path.string());
+
+                return std::string(table.data() + offset, strnlen(table.data() + offset, table.size() - offset));
+            }
+
+            std::vector<std::string> strings(int64_t tag) const {
+                std::vector<std::string> result;
+
+                for (const auto& entry : dynamic) {
+                    if (entry.d_tag == tag)
+                        result.push_back(string(entry.d_un.d_val));
+                }
+
+                return result;
+            }
+
+            const Section* section(const std::string& name) const {
+                for (const auto& section : sections) {
+                    if (section.name == name)
+                        return &section;
+                }
+
+                return nullptr;
+            }
+
+            std::vector<char> contents(const Section& section) const {
+                if (section.header.sh_type == SHT_NOBITS)
+                    return {};
+
+                const auto begin = section.header.sh_offset;
+                const auto end = begin + section.header.sh_size;
+
+                if (end > bytes.size())
+                    throw std::runtime_error("section " + section.name + " outside of " + path.string());
+
+                return {bytes.begin() + static_cast<std::ptrdiff_t>(begin), bytes.begin() + static_cast<std::ptrdiff_t>(end)};
+            }
+
+            std::vector<Elf64_Phdr> segments(uint32_t type) const {
+                std::vector<Elf64_Phdr> result;
+
+                for (const auto& phdr : phdrs) {
+                    if (phdr.p_type == type)
+                        result.push_back(phdr);
+                }
+
+                return result;
+            }
+
+            std::vector<char> segmentContents(const Elf64_Phdr& phdr) const {
+                if (phdr.p_offset > bytes.size() || bytes.size() - phdr.p_offset < phdr.p_filesz)
+                    throw std::runtime_error("program header outside of " + path.string());
+
+                return {bytes.begin() + static_cast<std::ptrdiff_t>(phdr.p_offset), bytes.begin() + static_cast<std::ptrdiff_t>(phdr.p_offset + phdr.p_filesz)};
+            }
+
+            std::string interpreter() const {
+                for (const auto& phdr : phdrs) {
+                    if (phdr.p_type == PT_INTERP)
+                        return std::string(bytes.data() + phdr.p_offset, strnlen(bytes.data() + phdr.p_offset, phdr.p_filesz));
+                }
+
+                return {};
+            }
+
+            bool hasSectionHeaders() const {
+                return !sections.empty();
+            }
+    };
+
