+namespace {
+    std::string expectedOutput(const std::string& libraryValue) {
+        std::stringstream elements(libraryValue);
+        std::string element;
+
+        while (std::getline(elements, element, ':')) {
+            if (element == "$ORIGIN/../deps-a" || element == "${ORIGIN}/../deps-a")
+                return outputWithA;
+
+            if (element == "$ORIGIN/../deps-b" || element == "${ORIGIN}/../deps-b")
+                return outputWithB;
+        }
+
+        return {};
+    }
+
+    std::string randomValue(std::mt19937& random, const std::vector<std::string>& useful) {
+        std::vector<std::string> elements;
+        const auto count = std::uniform_int_distribution<int>(1, 3)(random);
+
+        for (int i = 0; i < count; ++i) {
+            if (std::uniform_int_distribution<int>(0, 2)(random) == 0) {
+                const auto length = std::uniform_int_distribution<int>(1, 1200)(random);
+                elements.push_back("/nonexistent/" + std::string(static_cast<size_t>(length), static_cast<char>('a' + i)));
+            } else {
+                elements.push_back(useful[std::uniform_int_distribution<size_t>(0, useful.size() - 1)(random)]);
+            }
+        }
+
+        std::string value;
+        for (const auto& element : elements)
+            value += (value.empty() ? "" : ":") + element;
+
+        return value;
+    }
+
+    // random sequences of changes, on random kinds of files, sometimes stripped in between
+    void runRandomScenarios(const fs::path& directory, unsigned seed, int count) {
+        std::mt19937 random(seed);
+
+        std::vector<std::pair<std::string, FixtureOptions>> variants;
+        variants.emplace_back("plain", FixtureOptions{});
+        {
+            FixtureOptions options;
+            options.libraryTag = Tag::RPath;
+            options.executableTag = Tag::None;
+            variants.emplace_back("rpath", options);
+        }
+        {
+            FixtureOptions options;
+            options.libraryTag = Tag::None;
+            options.flags = {"-Wl,-z,max-page-size=0x200000"};
+            variants.emplace_back("aligned", options);
+        }
+        {
+            FixtureOptions options;
+            options.flags = {"-Wl,--hash-style=sysv", "-Wl,-z,now"};
+            variants.emplace_back("sysv", options);
+        }
+
+        std::vector<Fixture> templates;
+        for (const auto& variant : variants)
+            templates.push_back(buildFixture(directory / ("template-" + variant.first), variant.second));
+
+        const std::vector<std::string> libraryValues{"$ORIGIN/../deps-a", "${ORIGIN}/../deps-b", "$ORIGIN/../deps-b", "${ORIGIN}/../deps-a"};
+        const std::vector<std::string> executableValues{"$ORIGIN/../lib", "${ORIGIN}/../lib"};
+
+        for (int scenario = 0; scenario < count; ++scenario) {
+            const auto& base = templates[std::uniform_int_distribution<size_t>(0, templates.size() - 1)(random)];
+            const auto root = directory / ("scenario-" + std::to_string(scenario));
+            fs::copy(base.root, root, fs::copy_options::recursive);
+            const Fixture fixture{root};
+
+            const std::vector<fs::path> files{fixture.library(), fixture.executable(), fixture.nonPieExecutable()};
+            std::map<fs::path, bool> withoutSections;
+
+            for (const auto& file : files) {
+                withoutSections[file] = std::uniform_int_distribution<int>(0, 4)(random) == 0;
+
+                if (withoutSections[file])
+                    removeSectionHeaders(file);
+            }
+
+            auto libraryValue = ElfImage(fixture.library()).strings(DT_RUNPATH);
+            const auto libraryRPath = ElfImage(fixture.library()).strings(DT_RPATH);
+            std::string currentLibrary = !libraryValue.empty() ? libraryValue.front() : (!libraryRPath.empty() ? libraryRPath.front() : "");
+            std::map<fs::path, std::string> currentExecutable;
+            for (const auto& file : {fixture.executable(), fixture.nonPieExecutable()}) {
+                const auto values = ElfImage(file).strings(DT_RUNPATH);
+                currentExecutable[file] = values.empty() ? "" : values.front();
+            }
+
+            const auto steps = std::uniform_int_distribution<int>(1, 4)(random);
+
+            for (int step = 0; step < steps; ++step) {
+                const auto& file = files[std::uniform_int_distribution<size_t>(0, files.size() - 1)(random)];
+                std::string value;
+
+                if (file == fixture.library()) {
+                    value = randomValue(random, libraryValues);
+                    currentLibrary = value;
+                } else {
+                    value = randomValue(random, executableValues);
+                    if (std::uniform_int_distribution<int>(0, 3)(random) != 0 && value.find("/../lib") == std::string::npos)
+                        value += ":$ORIGIN/../lib";
+                    currentExecutable[file] = value;
+                }
+
+                ASSERT_TRUE(setsRPath(file, value)) << "scenario " << scenario << " step " << step;
+                EXPECT_TRUE(rpathIs(file, value)) << "scenario " << scenario << " step " << step;
+
+                if (!withoutSections[file] && std::uniform_int_distribution<int>(0, 5)(random) == 0) {
+                    ASSERT_TRUE(runProcess({"/usr/bin/strip", file.string()}, root).succeeded()) << "strip in scenario " << scenario;
+                }
+
+                for (const auto& executable : {fixture.executable(), fixture.nonPieExecutable()}) {
+                    const auto& executableValue = currentExecutable[executable];
+                    const auto findsLibrary = executableValue.find("$ORIGIN/../lib") != std::string::npos ||
+                                              executableValue.find("${ORIGIN}/../lib") != std::string::npos;
+                    const auto output = expectedOutput(currentLibrary);
+
+                    if (!findsLibrary) {
+                        EXPECT_TRUE(failsToFind(root, executable, "librun.so")) << "scenario " << scenario << " step " << step;
+                    } else if (output.empty()) {
+                        EXPECT_TRUE(failsToFind(root, executable, "libdep.so")) << "scenario " << scenario << " step " << step;
+                    } else {
+                        EXPECT_TRUE(runsWith(root, executable, output)) << "scenario " << scenario << " step " << step;
+                    }
+                }
+            }
+
+            std::error_code error;
+            fs::remove_all(root, error);
+        }
+    }
+}
