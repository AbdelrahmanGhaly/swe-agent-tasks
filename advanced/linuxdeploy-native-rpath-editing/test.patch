+namespace {
+    // the library and both executables export so many symbols that their string tables fit into no gap between
+    // segments
+    FixtureOptions largeMemoryOptions() {
+        FixtureOptions options;
+        options.executableTag = Tag::None;
+        options.librarySymbols = 3000;
+        options.executableSymbols = 3000;
+        return options;
+    }
+
+    // the fixture is built three times, with 8 MiB, 64 MiB and 256 MiB of zero-initialized memory reserved in the library
+    // and in both executables, and gets the same changes each time; no file may grow by as much as the memory it
+    // reserves, and reserving more memory may not make a file grow by as much more
+    void expectLargeMemoryDoesNotBloat(const fs::path& root, FixtureOptions options, bool withoutSectionHeaders, int calls) {
+        const std::vector<intmax_t> reserved{intmax_t{8} << 20, intmax_t{64} << 20, intmax_t{256} << 20};
+        std::vector<std::vector<intmax_t>> growth;
+
+        for (const auto memory : reserved) {
+            options.bssSize = std::to_string(memory);
+            options.libraryBssSize = std::to_string(memory);
+
+            const auto fixture = buildFixture(root / ("reserved-" + std::to_string(memory >> 20)), options);
+            const std::vector<fs::path> files{fixture.library(), fixture.executable(), fixture.nonPieExecutable()};
+            std::vector<intmax_t> sizes;
+            std::vector<Snapshot> snapshots;
+
+            for (const auto& file : files) {
+                if (withoutSectionHeaders)
+                    removeSectionHeaders(file);
+
+                sizes.push_back(static_cast<intmax_t>(fs::file_size(file)));
+                snapshots.emplace_back(file, fixture.root.parent_path() / (fixture.root.filename().string() + "-snapshots"));
+            }
+
+            for (int call = 0; call < calls; ++call) {
+                const auto padding = "/nonexistent/" + std::string(static_cast<size_t>(call + 1) * 40, 'x');
+
+                ASSERT_TRUE(setsRPath(fixture.library(), padding + ":$ORIGIN/../deps-b"));
+                ASSERT_TRUE(setsRPath(fixture.executable(), padding + ":$ORIGIN/../lib"));
+                ASSERT_TRUE(setsRPath(fixture.nonPieExecutable(), padding + ":$ORIGIN/../lib"));
+
+                EXPECT_TRUE(rpathIs(fixture.library(), padding + ":$ORIGIN/../deps-b"));
+                EXPECT_TRUE(runsWith(fixture.root, fixture.executable(), outputWithB));
+                EXPECT_TRUE(runsWith(fixture.root, fixture.nonPieExecutable(), outputWithB));
+            }
+
+            growth.emplace_back();
+
+            for (size_t i = 0; i < files.size(); ++i) {
+                growth.back().push_back(static_cast<intmax_t>(fs::file_size(files[i])) - sizes[i]);
+                EXPECT_LT(growth.back().back(), memory) << files[i] << " grew by at least as much as the zero-initialized memory it reserves";
+                expectOnlyRPathChanged(snapshots[i], files[i]);
+            }
+
+            if (!withoutSectionHeaders) {
+                expectStrippedCopyWorks(fixture, files, {{fixture.executable(), outputWithB}, {fixture.nonPieExecutable(), outputWithB}});
+            }
+        }
+
+        for (size_t i = 0; i < growth.front().size(); ++i) {
+            EXPECT_LT(growth.back()[i] - growth.front()[i], reserved.back() - reserved.front())
+                << "reserving " << ((reserved.back() - reserved.front()) >> 20) << " MiB more zero-initialized memory made file " << i
+                << " grow by " << growth.back()[i] << " instead of " << growth.front()[i] << " bytes";
+        }
+    }
+}
