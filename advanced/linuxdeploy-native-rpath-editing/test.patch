+    // copies a program of the system, changes its search path and checks it behaves as before, also after strip
+    void expectSystemProgramStillRuns(const fs::path& directory, const std::vector<fs::path>& candidates, const std::vector<std::string>& arguments) {
+        // the first candidate that is a real ELF file, as a system may replace a program with a wrapper script
+        std::optional<fs::path> found;
+        for (const auto& candidate : candidates) {
+            std::error_code error;
+            const auto resolved = fs::canonical(candidate, error);
+
+            if (!error && isElfFile(resolved)) {
+                found = resolved;
+                break;
+            }
+        }
+
+        ASSERT_TRUE(found.has_value()) << "none of the candidates is an ELF file: " << candidates.front();
+        const auto original = found.value();
+
+        const auto copy = directory / "bin" / original.filename();
+        fs::create_directories(copy.parent_path());
+        fs::create_directories(directory / "lib");
+        fs::copy_file(original, copy);
+        const auto snapshot = Snapshot(copy, directory / "snapshots");
+
+        auto command = arguments;
+        command.insert(command.begin(), copy.string());
+        const auto expected = runProcess(command, directory);
+
+        ASSERT_TRUE(setsRPath(copy, "$ORIGIN/../lib:$ORIGIN/../lib/private"));
+        EXPECT_TRUE(rpathIs(copy, "$ORIGIN/../lib:$ORIGIN/../lib/private"));
+
+        const auto changed = runProcess(command, directory);
+        EXPECT_EQ(expected.status, changed.status) << copy;
+        EXPECT_EQ(expected.output, changed.output) << copy;
+
+        expectOnlyRPathChanged(snapshot, copy);
+
+        const auto strippedDirectory = directory / "stripped";
+        const auto stripped = strippedDirectory / "bin" / original.filename();
+        fs::create_directories(stripped.parent_path());
+        fs::create_directories(strippedDirectory / "lib");
+        fs::copy_file(copy, stripped);
+        const auto strip = runProcess({"/usr/bin/strip", stripped.string()}, directory);
+        ASSERT_TRUE(strip.succeeded()) << strip.output;
+
+        command[0] = stripped.string();
+        const auto afterStrip = runProcess(command, strippedDirectory);
+        EXPECT_EQ(expected.status, afterStrip.status) << stripped;
+        EXPECT_EQ(normalized(expected.output, directory), normalized(afterStrip.output, strippedDirectory)) << stripped;
+    }
