+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <elf.h>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <iostream>
+#include <iterator>
+#include <linux/audit.h>
+#include <linux/filter.h>
+#include <linux/seccomp.h>
+#include <map>
+#include <optional>
+#include <poll.h>
+#include <random>
+#include <regex>
+#include <signal.h>
+#include <sstream>
+#include <string>
+#include <sys/prctl.h>
+#include <sys/resource.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <utility>
+#include <vector>
+
+#include "gtest/gtest.h"
+
+#include "linuxdeploy/core/elf_file.h"
+
+namespace fs = std::filesystem;
+
+using namespace linuxdeploy::core::elf_file;
+
+namespace {
+    using Environment = std::map<std::string, std::string>;
+
+    struct ProcessResult {
+        int status = -1;
+        bool timedOut = false;
+        std::string output;
+
+        bool succeeded() const {
+            return !timedOut && WIFEXITED(status) && WEXITSTATUS(status) == 0;
+        }
+    };
+
+    std::string readAll(int fd) {
+        std::string data;
+        char buffer[4096];
+
+        while (true) {
+            const auto count = read(fd, buffer, sizeof(buffer));
+
+            if (count < 0 && errno == EINTR)
+                continue;
+
+            if (count <= 0)
+                break;
+
+            data.append(buffer, static_cast<size_t>(count));
+        }
+
+        return data;
+    }
+
+    void writeAll(int fd, const std::string& data) {
+        size_t written = 0;
+
+        while (written < data.size()) {
+            const auto count = write(fd, data.data() + written, data.size() - written);
+
+            if (count < 0 && errno == EINTR)
+                continue;
+
+            if (count <= 0)
+                return;
+
+            written += static_cast<size_t>(count);
+        }
+    }
+
+    void flushOutput() {
+        std::cout.flush();
+        std::cerr.flush();
+        fflush(nullptr);
+    }
+
+    const Environment& plainEnvironment() {
+        static const Environment environment{{"PATH", "/usr/bin:/bin"}, {"LC_ALL", "C"}};
+        return environment;
+    }
+
+    ProcessResult runProcess(const std::vector<std::string>& arguments, const fs::path& workingDirectory,
+                             const Environment& environment = plainEnvironment()) {
+        std::vector<std::string> environmentStrings;
+        for (const auto& variable : environment)
+            environmentStrings.push_back(variable.first + "=" + variable.second);
+
+        std::vector<char*> argv;
+        for (const auto& argument : arguments)
+            argv.push_back(const_cast<char*>(argument.c_str()));
+        argv.push_back(nullptr);
+
+        std::vector<char*> envp;
+        for (const auto& variable : environmentStrings)
+            envp.push_back(const_cast<char*>(variable.c_str()));
+        envp.push_back(nullptr);
+
+        int fds[2];
+        if (pipe(fds) != 0)
+            throw std::runtime_error("pipe() failed");
+
+        flushOutput();
+        const auto pid = fork();
+
+        if (pid < 0)
+            throw std::runtime_error("fork() failed");
+
+        if (pid == 0) {
+            setpgid(0, 0);
+            dup2(fds[1], STDOUT_FILENO);
+            dup2(fds[1], STDERR_FILENO);
+            close(fds[0]);
+            close(fds[1]);
+
+            if (chdir(workingDirectory.c_str()) != 0)
+                _exit(126);
+
+            execve(argv[0], argv.data(), envp.data());
+            _exit(127);
+        }
+
+        setpgid(pid, pid);
+        close(fds[1]);
+
+        ProcessResult result;
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+
+        while (true) {
+            const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now()).count();
+
+            if (remaining <= 0) {
+                result.timedOut = true;
+                break;
+            }
+
+            pollfd descriptor{fds[0], POLLIN, 0};
+            const auto ready = poll(&descriptor, 1, static_cast<int>(remaining));
+
+            if (ready < 0 && errno == EINTR)
+                continue;
+
+            if (ready == 0) {
+                result.timedOut = true;
+                break;
+            }
+
+            char buffer[4096];
+            const auto count = read(fds[0], buffer, sizeof(buffer));
+
+            if (count < 0 && errno == EINTR)
+                continue;
+
+            if (count <= 0)
+                break;
+
+            result.output.append(buffer, static_cast<size_t>(count));
+        }
+
+        if (result.timedOut) {
+            kill(-pid, SIGKILL);
+            result.output += "\n[did not finish within 30 seconds]";
+        }
+
+        close(fds[0]);
+
+        while (waitpid(pid, &result.status, 0) < 0 && errno == EINTR) {}
+
+        return result;
+    }
+
+    std::string describe(const std::vector<std::string>& arguments) {
+        std::string command;
+
+        for (const auto& argument : arguments)
+            command += argument + " ";
+
+        return command;
+    }
+
+    std::string runOrThrow(const std::vector<std::string>& arguments, const fs::path& workingDirectory = fs::current_path()) {
+        const auto result = runProcess(arguments, workingDirectory);
+
+        if (!result.succeeded())
+            throw std::runtime_error("command failed: " + describe(arguments) + "\n" + result.output);
+
+        return result.output;
+    }
+
+    void writeFile(const fs::path& path, const std::string& contents) {
+        fs::create_directories(path.parent_path());
+        std::ofstream ofs(path, std::ios::binary);
+        ofs << contents;
+    }
+
+    std::vector<char> readBytes(const fs::path& path) {
+        std::ifstream ifs(path, std::ios::binary);
+        return {std::istreambuf_iterator<char>(ifs), std::istreambuf_iterator<char>()};
+    }
+
+    void writeBytes(const fs::path& path, const std::vector<char>& data) {
+        std::fstream stream(path, std::ios::binary | std::ios::in | std::ios::out);
+        stream.write(data.data(), static_cast<std::streamsize>(data.size()));
+    }
+
+    fs::path makeTemporaryDirectory(const std::string& prefix) {
+        auto pattern = (fs::temp_directory_path() / (prefix + "-XXXXXX")).string();
+
+        if (mkdtemp(pattern.data()) == nullptr)
+            throw std::runtime_error("mkdtemp() failed");
+
+        return fs::canonical(pattern);
+    }
+
+    class TemporaryDirectory {
+        public:
+            const fs::path path;
+
+            explicit TemporaryDirectory(const std::string& prefix) : path(makeTemporaryDirectory(prefix)) {}
+
+            ~TemporaryDirectory() {
+                std::error_code error;
+                fs::remove_all(path, error);
+            }
+    };
+
+    int programAttemptFd = -1;
+
+    void reportProgramAttempt(int) {
+        const char marker = 'x';
+        if (write(programAttemptFd, &marker, 1) < 0) {}
+        _exit(87);
+    }
+
+    bool forbidRunningPrograms() {
+        const uint32_t trap = SECCOMP_RET_TRAP;
+        const uint32_t allow = SECCOMP_RET_ALLOW;
+
+        struct sock_filter filter[] = {
+            BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, arch)),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AUDIT_ARCH_X86_64, 3, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AUDIT_ARCH_AARCH64, 7, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, AUDIT_ARCH_I386, 10, 0),
+            BPF_STMT(BPF_RET | BPF_K, trap),
+            BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr)),
+            BPF_JUMP(BPF_JMP | BPF_JGE | BPF_K, 0x40000000, 11, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 59, 10, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 322, 9, 0),
+            BPF_STMT(BPF_RET | BPF_K, allow),
+            BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr)),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 221, 6, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 281, 5, 0),
+            BPF_STMT(BPF_RET | BPF_K, allow),
+            BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr)),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 11, 2, 0),
+            BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, 358, 1, 0),
+            BPF_STMT(BPF_RET | BPF_K, allow),
+            BPF_STMT(BPF_RET | BPF_K, trap),
+        };
+
+        struct sock_fprog program{};
+        program.len = static_cast<unsigned short>(sizeof(filter) / sizeof(filter[0]));
+        program.filter = filter;
+
+        struct sigaction action{};
+        action.sa_handler = reportProgramAttempt;
+        sigemptyset(&action.sa_mask);
+
+        return sigaction(SIGSYS, &action, nullptr) == 0 &&
+               prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) == 0 &&
+               syscall(SYS_seccomp, SECCOMP_SET_MODE_FILTER, 0, &program) == 0;
+    }
+
+    struct CallResult {
+        std::string failure;
+        std::string value;
+    };
+
+    // runs the call in a child that cannot start programs; a fake patchelf is also the first one on PATH and in
+    // $PATCHELF, so an attempt to use one is noticed even where the filter cannot be installed
+    CallResult callInChild(const std::function<std::string()>& call) {
+        static const fs::path fakeTools = []() {
+            const auto directory = makeTemporaryDirectory("native-rpath-fake-tools");
+            const auto marker = directory / "patchelf-was-run";
+            writeFile(directory / "patchelf", "#!/bin/sh\ntouch '" + marker.string() + "'\nexit 1\n");
+            fs::permissions(directory / "patchelf", fs::perms::owner_all);
+            return directory;
+        }();
+
+        const auto marker = fakeTools / "patchelf-was-run";
+        std::error_code error;
+        fs::remove(marker, error);
+
+        CallResult result;
+        int resultFds[2];
+        int attemptFds[2];
+
+        if (pipe(resultFds) != 0 || pipe(attemptFds) != 0) {
+            result.failure = "could not be run: pipe() failed";
+            return result;
+        }
+
+        flushOutput();
+        const auto pid = fork();
+
+        if (pid == 0) {
+            close(resultFds[0]);
+            close(attemptFds[0]);
+            programAttemptFd = attemptFds[1];
+
+            setenv("PATCHELF", (fakeTools / "patchelf").c_str(), 1);
+            setenv("PATH", (fakeTools.string() + ":/usr/bin:/bin").c_str(), 1);
+
+            const bool filtered = forbidRunningPrograms();
+
+            std::string payload;
+            try {
+                payload = "R" + call();
+            } catch (const std::exception& e) {
+                payload = std::string("Xthrew an exception: ") + e.what();
+            } catch (...) {
+                payload = "Xthrew an unknown exception";
+            }
+
+            struct rusage children{};
+            if (!filtered && getrusage(RUSAGE_CHILDREN, &children) == 0 && children.ru_maxrss > 0)
+                reportProgramAttempt(0);
+
+            writeAll(resultFds[1], payload);
+            _exit(0);
+        }
+
+        close(resultFds[1]);
+        close(attemptFds[1]);
+
+        std::string data;
+        bool timedOut = false;
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(120);
+
+        while (true) {
+            const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now()).count();
+
+            if (remaining <= 0) {
+                timedOut = true;
+                break;
+            }
+
+            pollfd descriptor{resultFds[0], POLLIN, 0};
+            const auto ready = poll(&descriptor, 1, static_cast<int>(remaining));
+
+            if (ready < 0 && errno == EINTR)
+                continue;
+
+            if (ready == 0) {
+                timedOut = true;
+                break;
+            }
+
+            char buffer[4096];
+            const auto count = read(resultFds[0], buffer, sizeof(buffer));
+
+            if (count < 0 && errno == EINTR)
+                continue;
+
+            if (count <= 0)
+                break;
+
+            data.append(buffer, static_cast<size_t>(count));
+        }
+
+        close(resultFds[0]);
+
+        if (timedOut)
+            kill(pid, SIGKILL);
+
+        int status = 0;
+        while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}
+
+        pollfd attempt{attemptFds[0], POLLIN, 0};
+        const bool programAttempted = poll(&attempt, 1, 0) > 0 && (attempt.revents & POLLIN) != 0;
+        close(attemptFds[0]);
+
+        if (programAttempted || fs::exists(marker))
+            result.failure = "tried to run a program, which is not allowed";
+        else if (timedOut)
+            result.failure = "did not return within 120 seconds";
+        else if (WIFSIGNALED(status))
+            result.failure = "crashed with signal " + std::to_string(WTERMSIG(status));
+        else if (!WIFEXITED(status) || WEXITSTATUS(status) != 0)
+            result.failure = "ended with exit status " + std::to_string(WEXITSTATUS(status));
+        else if (data.empty())
+            result.failure = "returned no result";
+        else if (data.front() == 'X')
+            result.failure = data.substr(1);
+        else
+            result.value = data.substr(1);
+
+        return result;
+    }
