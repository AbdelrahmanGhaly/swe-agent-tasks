+
+        fs::create_directories(root / "lib");
+        std::vector<std::string> library{"/usr/bin/gcc", "-shared", "-fPIC", "-o", fixture.library().string(),
+                                         (root / "src" / "lib.c").string(), "-Wl,-soname,librun.so", "-L" + (root / "deps-a").string(),
+                                         "-Wl,--no-as-needed", "-ldep"};
+        for (const auto& name : options.extraDependencies)
+            library.push_back("-l" + name);
+        const auto libraryTags = tagOptions(options.libraryTag, options.libraryValue);
+        library.insert(library.end(), libraryTags.begin(), libraryTags.end());
+        library.insert(library.end(), options.flags.begin(), options.flags.end());
+        compile(library, root);
+
+        fs::create_directories(root / "bin");
+        for (const bool pie : {true, false}) {
+            const auto output = pie ? fixture.executable() : fixture.nonPieExecutable();
+            std::vector<std::string> executable{"/usr/bin/gcc", "-DBSS_SIZE=" + options.bssSize, "-o", output.string(),
+                                                (root / "src" / "main.c").string(), "-L" + (root / "lib").string(), "-lrun",
+                                                "-Wl,-rpath-link," + (root / "deps-a").string()};
+            if (!pie) {
+                executable.emplace_back("-fno-pie");
+                executable.emplace_back("-no-pie");
+            }
+            if (options.executableSymbols > 0)
+                executable.emplace_back("-rdynamic");
+            const auto executableTags = tagOptions(options.executableTag, options.executableValue);
+            executable.insert(executable.end(), executableTags.begin(), executableTags.end());
+            executable.insert(executable.end(), options.flags.begin(), options.flags.end());
+            compile(executable, root);
+        }
+
+        return fixture;
+    }
+
+    // a copy of the fixture tree in which the given files are stripped with binutils' strip
+    fs::path strippedCopy(const Fixture& fixture, const std::vector<fs::path>& files) {
+        const auto copy = fixture.root.parent_path() / (fixture.root.filename().string() + "-stripped");
+        fs::remove_all(copy);
+        fs::copy(fixture.root, copy, fs::copy_options::recursive);
+
+        for (const auto& file : files) {
+            const auto target = copy / fs::relative(file, fixture.root);
+            const auto result = runProcess({"/usr/bin/strip", target.string()}, copy);
+
+            if (!result.succeeded())
+                throw std::runtime_error("strip " + target.string() + " failed: " + result.output);
+        }
+
+        return copy;
+    }
+
+    ::testing::AssertionResult runsWith(const fs::path& root, const fs::path& executable, const std::string& expected) {
+        const auto result = runProcess({executable.string()}, root);
+
+        if (result.succeeded() && result.output == expected)
+            return ::testing::AssertionSuccess();
+
+        return ::testing::AssertionFailure() << executable << " printed \"" << result.output << "\" (status " << result.status
+                                             << ") instead of \"" << expected << "\"";
+    }
+
+    ::testing::AssertionResult failsToFind(const fs::path& root, const fs::path& executable, const std::string& library) {
+        const auto result = runProcess({executable.string()}, root);
+
+        if (!result.succeeded() && result.output.find(library) != std::string::npos && result.output.find("cannot open shared object file") != std::string::npos)
+            return ::testing::AssertionSuccess();
+
+        return ::testing::AssertionFailure() << executable << " printed \"" << result.output << "\" (status " << result.status
+                                             << ") instead of failing to find " << library;
+    }
+
+    // runs the strip check: the stripped copies still run like the originals and keep their search paths
+    void expectStrippedCopyWorks(const Fixture& fixture, const std::vector<fs::path>& files, const std::vector<std::pair<fs::path, std::string>>& runs) {
+        fs::path copy;
+
+        try {
+            copy = strippedCopy(fixture, files);
+        } catch (const std::exception& e) {
+            FAIL() << e.what();
+        }
+
+        for (const auto& file : files) {
+            const auto original = rpathEntriesOf(file);
+            const auto stripped = copy / fs::relative(file, fixture.root);
+            EXPECT_TRUE(hasEntries(stripped, original.rpath, original.runpath)) << "after strip";
+        }
+
+        for (const auto& run : runs)
+            EXPECT_TRUE(runsWith(copy, copy / fs::relative(run.first, fixture.root), run.second)) << "after strip";
+    }
+
+    void removeSectionHeaders(const fs::path& file) {
+        auto data = readBytes(file);
+        Elf64_Ehdr ehdr;
+        memcpy(&ehdr, data.data(), sizeof(ehdr));
+        ehdr.e_shoff = 0;
+        ehdr.e_shnum = 0;
+        ehdr.e_shstrndx = 0;
+        memcpy(data.data(), &ehdr, sizeof(ehdr));
+        writeBytes(file, data);
+    }
