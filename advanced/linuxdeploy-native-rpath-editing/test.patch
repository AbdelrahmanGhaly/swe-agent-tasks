+    fs::create_directories(root / "bin");
+    compile({"/usr/bin/gcc", "-shared", "-fPIC", "-o", (root / "deps/libdep.so").string(), (root / "src/dep.c").string()}, root);
+    compile({"/usr/bin/g++", "-shared", "-fPIC", "-o", (root / "lib/libchecked.so").string(), (root / "src/lib.cpp").string(),
+             "-L" + (root / "deps").string(), "-ldep"}, root);
+    compile({"/usr/bin/g++", "-o", (root / "bin/checked").string(), (root / "src/main.cpp").string(), "-pthread",
+             "-L" + (root / "lib").string(), "-lchecked", "-Wl,-rpath-link," + (root / "deps").string()}, root);
