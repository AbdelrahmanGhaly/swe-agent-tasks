+    // values that grow well past the gaps between segments, with the files stripped after every other call
+    void expectLongerValuesWithStripInBetweenWork(const fs::path& root, FixtureOptions options) {
+        options.executableTag = Tag::None;
+        const auto fixture = buildFixture(root, options);
+        const std::vector<fs::path> files{fixture.library(), fixture.executable(), fixture.nonPieExecutable()};
+        int call = 0;
+
+        for (const size_t length : {60, 900, 3000, 5000, 9000, 20}) {
+            const auto padding = "/nonexistent/" + std::string(length, static_cast<char>('a' + call));
+            const auto output = call % 2 == 0 ? outputWithB : outputWithA;
+
+            ASSERT_TRUE(setsRPath(fixture.library(), padding + (call % 2 == 0 ? ":$ORIGIN/../deps-b" : ":$ORIGIN/../deps-a")));
+            ASSERT_TRUE(setsRPath(fixture.executable(), padding + ":$ORIGIN/../lib"));
+            ASSERT_TRUE(setsRPath(fixture.nonPieExecutable(), padding + ":$ORIGIN/../lib"));
+            EXPECT_TRUE(runsWith(root, fixture.executable(), output)) << "after call " << call;
+            EXPECT_TRUE(runsWith(root, fixture.nonPieExecutable(), output)) << "after call " << call;
+
+            if (call % 2 == 1) {
+                for (const auto& file : files)
+                    ASSERT_TRUE(runProcess({"/usr/bin/strip", file.string()}, root).succeeded()) << "strip " << file;
+
+                EXPECT_TRUE(runsWith(root, fixture.executable(), output)) << "after strip " << call;
+                EXPECT_TRUE(runsWith(root, fixture.nonPieExecutable(), output)) << "after strip " << call;
+            }
+
+            ++call;
+        }
+    }
