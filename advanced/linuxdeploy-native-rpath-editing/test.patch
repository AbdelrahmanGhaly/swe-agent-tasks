+    // the tables the dynamic loader finds through these tags may live elsewhere afterwards, but must read the same
+    bool isTableTag(int64_t tag) {
+        switch (tag) {
+            case DT_HASH:
+            case DT_GNU_HASH:
+            case DT_SYMTAB:
+            case DT_RELA:
+            case DT_REL:
+            case DT_JMPREL:
+            case DT_VERSYM:
+            case DT_VERDEF:
+            case DT_VERNEED:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    bool isStringTag(int64_t tag) {
+        return tag == DT_NEEDED || tag == DT_SONAME || tag == DT_AUXILIARY || tag == DT_FILTER || tag == DT_AUDIT || tag == DT_DEPAUDIT ||
+               tag == DT_CONFIG;
+    }
+
+    std::optional<uint64_t> tableSize(const ElfImage& image, int64_t tag, uint64_t address) {
+        switch (tag) {
+            case DT_RELA:
+                return image.value(DT_RELASZ);
+            case DT_REL:
+                return image.value(DT_RELSZ);
+            case DT_JMPREL:
+                return image.value(DT_PLTRELSZ);
+            default:
+                break;
+        }
+
+        for (const auto& section : image.sections) {
+            if (section.header.sh_addr == address && (section.header.sh_flags & SHF_ALLOC) != 0 && section.header.sh_type != SHT_NOBITS)
+                return section.header.sh_size;
+        }
+
+        return std::nullopt;
+    }
+
+    std::string normalized(std::string text, const fs::path& file) {
+        static const std::regex lengths(R"(at file offset 0x[0-9a-fA-F]+ with length 0x[0-9a-fA-F]+)");
+        static const std::regex numbers(R"((Addr|Offset|offset|address):? ?0x[0-9a-fA-F]+)");
+
+        size_t position;
+        while ((position = text.find(file.string())) != std::string::npos)
+            text.replace(position, file.string().size(), "FILE");
+
+        text = std::regex_replace(text, lengths, "at file offset X");
+        text = std::regex_replace(text, numbers, "$1 X");
+        return text;
+    }
+
+    std::string readelf(const std::vector<std::string>& options, const fs::path& file) {
+        std::vector<std::string> arguments{"/usr/bin/readelf", "-W"};
+        arguments.insert(arguments.end(), options.begin(), options.end());
+        arguments.push_back(file.string());
+
+        const auto result = runProcess(arguments, file.parent_path());
+        return normalized(result.output, file);
+    }
+
+    // the notes readelf reads, whether it finds them through section headers or through program headers
+    std::vector<std::string> readelfNotes(const std::vector<std::string>& options, const fs::path& file) {
+        std::istringstream text(readelf(options, file));
+        std::vector<std::string> notes;
+
+        for (std::string line; std::getline(text, line);) {
+            if (!line.empty() && line.rfind("Displaying notes found", 0) != 0 && line.rfind("  Owner", 0) != 0)
+                notes.push_back(line);
+        }
+
+        std::sort(notes.begin(), notes.end());
+        return notes;
+    }
+
+    // a copy of a file as it was, to compare the changed file with
+    class Snapshot {
+        public:
+            fs::path copy;
+            std::optional<ElfImage> image;
+
+            Snapshot(const fs::path& file, const fs::path& directory) {
+                static int counter = 0;
+
+                fs::create_directories(directory);
+                copy = directory / (std::to_string(counter++) + "-" + file.filename().string());
+                fs::copy_file(file, copy);
+                image.emplace(copy);
+            }
+    };
+
+    // everything but the search path reads the same as before
+    void expectOnlyRPathChanged(const Snapshot& snapshot, const fs::path& file) {
+        const auto& before = snapshot.image.value();
+        const ElfImage after(file);
+
+        EXPECT_EQ(before.interpreter(), after.interpreter()) << file << ": interpreter changed";
+
+        const auto byTag = [](const ElfImage& image) {
+            std::map<int64_t, std::vector<Elf64_Dyn>> entries;
+
+            for (const auto& entry : image.dynamic) {
+                if (entry.d_tag != DT_STRTAB && entry.d_tag != DT_STRSZ && entry.d_tag != DT_RPATH && entry.d_tag != DT_RUNPATH)
+                    entries[entry.d_tag].push_back(entry);
+            }
+
+            return entries;
+        };
+
+        const auto beforeEntries = byTag(before);
+        const auto afterEntries = byTag(after);
+
+        for (const auto& tagEntries : beforeEntries) {
+            const auto tag = tagEntries.first;
+            const auto now = afterEntries.find(tag);
+
+            if (now == afterEntries.end() || now->second.size() != tagEntries.second.size()) {
+                ADD_FAILURE() << file << ": the dynamic entries with tag " << tag << " changed in number";
+                continue;
+            }
+
+            for (size_t i = 0; i < tagEntries.second.size(); ++i) {
+                const auto& old = tagEntries.second[i];
+                const auto& changed = now->second[i];
+
+                if (isStringTag(tag)) {
+                    EXPECT_EQ(before.string(old.d_un.d_val), after.string(changed.d_un.d_val)) << file << ": dynamic entry " << i << " with tag " << tag << " reads differently";
+                } else if (isTableTag(tag)) {
+                    const auto size = tableSize(before, tag, old.d_un.d_ptr);
+
+                    if (size.has_value()) {
+                        EXPECT_EQ(before.at(old.d_un.d_ptr, size.value()), after.at(changed.d_un.d_ptr, size.value())) << file << ": the table of the dynamic entry with tag " << tag << " reads differently";
+                    }
+                } else if (tag != DT_DEBUG) {
+                    EXPECT_EQ(old.d_un.d_val, changed.d_un.d_val) << file << ": the value of the dynamic entry with tag " << tag << " changed";
+                }
+            }
+        }
+
+        for (const auto& tagEntries : afterEntries) {
+            if (beforeEntries.find(tagEntries.first) == beforeEntries.end()) {
+                ADD_FAILURE() << file << ": a dynamic entry with tag " << tagEntries.first << " was added";
+            }
+        }
+
+        if (before.hasSectionHeaders()) {
+            for (const auto& section : before.sections) {
+                if (section.name.empty() || section.name == ".dynamic" || section.name == ".dynstr" || section.name == ".shstrtab")
+                    continue;
+
+                const auto* now = after.section(section.name);
+
+                if (now == nullptr) {
+                    ADD_FAILURE() << file << ": section " << section.name << " is gone";
+                    continue;
+                }
+
+                EXPECT_EQ(section.header.sh_type, now->header.sh_type) << file << ": section " << section.name << " changed its type";
+                EXPECT_EQ(section.header.sh_size, now->header.sh_size) << file << ": section " << section.name << " changed its size";
+                EXPECT_TRUE(before.contents(section) == after.contents(*now)) << file << ": section " << section.name << " changed its contents";
+
+                if (section.header.sh_type == SHT_NOBITS || (section.header.sh_flags & SHF_EXECINSTR) != 0 || (section.header.sh_flags & SHF_WRITE) != 0) {
+                    EXPECT_EQ(section.header.sh_addr, now->header.sh_addr) << file << ": section " << section.name << " moved in memory";
+                }
+            }
+        }
+
+        for (const auto type : {static_cast<uint32_t>(PT_GNU_STACK), static_cast<uint32_t>(PT_GNU_RELRO), static_cast<uint32_t>(PT_TLS), static_cast<uint32_t>(PT_GNU_EH_FRAME)}) {
+            const auto old = before.segments(type);
+            const auto now = after.segments(type);
+
+            ASSERT_EQ(old.size(), now.size()) << file << ": the number of program headers of type " << std::hex << type << " changed";
+
+            for (size_t i = 0; i < old.size(); ++i) {
+                EXPECT_EQ(old[i].p_flags, now[i].p_flags) << file << ": program header of type " << std::hex << type << " changed its flags";
+                EXPECT_EQ(old[i].p_vaddr, now[i].p_vaddr) << file << ": program header of type " << std::hex << type << " moved";
+                EXPECT_EQ(old[i].p_memsz, now[i].p_memsz) << file << ": program header of type " << std::hex << type << " changed its size";
+            }
+        }
+
+        for (const auto type : {static_cast<uint32_t>(PT_INTERP), static_cast<uint32_t>(PT_NOTE), static_cast<uint32_t>(PT_GNU_PROPERTY)}) {
+            const auto old = before.segments(type);
+            const auto now = after.segments(type);
+
+            ASSERT_EQ(old.size(), now.size()) << file << ": the number of program headers of type " << std::hex << type << " changed";
+
+            for (size_t i = 0; i < old.size(); ++i) {
+                EXPECT_EQ(old[i].p_filesz, now[i].p_filesz) << file << ": program header of type " << std::hex << type << " changed its size";
+                EXPECT_TRUE(before.segmentContents(old[i]) == after.segmentContents(now[i])) << file << ": program header of type " << std::hex << type << " describes other contents";
+            }
+        }
+
+        const std::vector<std::string> dynamicOption = before.hasSectionHeaders() ? std::vector<std::string>{} : std::vector<std::string>{"-D"};
+
+        for (const auto& option : {"--dyn-syms", "-V", "-r"}) {
+            auto options = dynamicOption;
+            options.emplace_back(option);
+            EXPECT_EQ(readelf(options, snapshot.copy), readelf(options, file)) << file << ": readelf " << option << " reads differently";
+        }
+
+        auto noteOptions = dynamicOption;
+        noteOptions.emplace_back("-n");
+        EXPECT_EQ(readelfNotes(noteOptions, snapshot.copy), readelfNotes(noteOptions, file)) << file << ": readelf -n finds other notes";
+    }
+
