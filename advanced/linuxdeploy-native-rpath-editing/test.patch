+    fs::path systemLibrary(const std::string& name) {
+        for (const auto& directory : {"/usr/lib/x86_64-linux-gnu", "/usr/lib/aarch64-linux-gnu", "/lib/x86_64-linux-gnu", "/lib/aarch64-linux-gnu"}) {
+            const auto candidate = fs::path(directory) / name;
+
+            if (fs::exists(candidate))
+                return fs::canonical(candidate);
+        }
+
+        throw std::runtime_error("system library not found: " + name);
