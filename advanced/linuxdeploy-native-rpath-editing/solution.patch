+// system headers
+#include <filesystem>
+#include <string>
+
+#pragma once
+
+namespace linuxdeploy {
+    namespace core {
+        namespace elf_file {
+            // returns the search path the dynamic loader takes from the given file: its DT_RUNPATH value, its DT_RPATH
+            // value if it has no DT_RUNPATH entry, or an empty string if it has neither
+            // throws std::runtime_error if the file is not an ELF file that can be read
+            std::string readRPath(const std::filesystem::path& path);
+
+            // replaces the value of the file's DT_RUNPATH and DT_RPATH entries, or adds a DT_RUNPATH entry if it has
+            // neither, without changing anything else the dynamic loader or the binutils make use of
+            // throws std::runtime_error if the file cannot be changed
+            void writeRPath(const std::filesystem::path& path, const std::string& value);
+        }
+    }
+}
