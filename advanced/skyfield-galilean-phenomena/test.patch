+def _changes(start, end, eph, observer):
+    f = almanac.galilean_phenomena(eph, observer)
+    return almanac.find_discrete(ts.utc(*start), ts.utc(*end), f)
+
+
+def _values(eph, observer, moments):
+    f = almanac.galilean_phenomena(eph, observer)
+    return asarray(f(ts.tt_jd(asarray(moments)))).tolist()
+
+
+def _assert_times(t, expected):
+    assert len(t) == len(expected)
+    for when, row in zip(t, expected):
+        assert abs(when.tt - ts.utc(*row[0]).tt) * 86400.0 < 0.1
+
+
+def _assert_values(y, expected):
+    assert asarray(y).tolist() == [row[1] for row in expected]
+
+
+def _assert_values_between(eph, observer, window, before, expected):
+    start, end = window
+    edges = ([ts.utc(*start).tt] + [ts.utc(*row[0]).tt for row in expected]
+             + [ts.utc(*end).tt])
+    moments = [(a + b) / 2.0 for a, b in zip(edges, edges[1:])]
+    wanted = [before] + [row[1] for row in expected]
+    assert _values(eph, observer, moments) == wanted
+
+
+def _changes_of(state, before, moments, values):
+    mask = sum(1 << (4 * moon + state) for moon in range(4))
+    changes = []
+    for moment, value in zip(moments, values):
+        if value & mask != before & mask:
+            changes.append((moment, value & mask))
+        before = value
+    return changes
+
+
+def _assert_state(state, eph, observer, window, before, expected):
+    start, end = window
+    t, y = _changes(start, end, eph, observer)
+    began = _values(eph, observer, [ts.utc(*start).tt])[0]
+    found = _changes_of(state, began, t.tt, asarray(y).tolist())
+    wanted = _changes_of(state, before,
+                         [ts.utc(*row[0]).tt for row in expected],
+                         [row[1] for row in expected])
+    assert [value for moment, value in found] == [v for m, v in wanted]
+    for (moment, value), (m, v) in zip(found, wanted):
+        assert abs(moment - m) * 86400.0 < 0.1
+
