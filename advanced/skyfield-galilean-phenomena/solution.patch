+def galilean_phenomena(ephemeris, observer):
+    """Build a function of time that tells what Jupiter's four big moons
+    are doing, as seen by an observer.
+
+    The function that this returns will expect a single argument that is
+    a :class:`~skyfield.timelib.Time` and will return an integer whose
+    bit ``4 * i + k`` is set while moon ``i`` is in state ``k``.  The
+    moons Io, Europa, Ganymede, and Callisto are numbered from 0, and so
+    are the states: occulted, in transit, eclipsed, and shadow in
+    transit.
+
+    """
