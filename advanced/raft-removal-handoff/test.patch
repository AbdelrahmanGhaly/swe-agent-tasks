+func testHandOffKeepsTheRemovedLeadersWholeLog(t *testing.T, async bool) {
+	c := elected(t, options{async: async, handOff: true, stepDown: true}, []uint64{1, 2, 3}, nil)
+	c.nodes[1].holdApply = true
+	c.changeWithTail(1, removeNode(1), 3, 2, 3)
+	if len(c.removals) != 0 {
+		t.Fatalf("leader 1 applied the change before the voters did")
+	}
+	c.releaseApply(1)
+	last := c.lastIndex(1)
+	c.requireHandOff(1, 2)
+	c.settle()
+	if commit := c.nodes[2].rn.BasicStatus().HardState.GetCommit(); commit < last {
+		t.Fatalf("new leader 2 committed up to %d, want the removed leader's entries up to %d", commit, last)
+	}
+}
