+func elected(t *testing.T, opts options, voters, learners []uint64) *cluster {
+	t.Helper()
+	c := newCluster(t, opts, voters, learners)
+	c.campaign(1)
+	c.propose(1, 2)
+	c.settle()
+	return c
+}
+
+func (c *cluster) changeWithTail(lead uint64, cc pb.ConfChangeI, tail int, lagging ...uint64) {
+	c.t.Helper()
+	conf := c.lastIndex(lead) + 1
+	c.drop = func(m *pb.Message) bool {
+		if len(c.removals) > 0 || m.GetType() != pb.MsgApp || !slices.Contains(lagging, m.GetTo()) {
+			return false
+		}
+		for _, e := range m.GetEntries() {
+			if e.GetIndex() > conf {
+				return true
+			}
+		}
+		return false
+	}
+	c.proposeConfChange(lead, cc)
+	c.propose(lead, tail)
+	c.settle()
+	c.drop = nil
+}
+
+func (c *cluster) unreachableTarget(lead uint64) {
+	c.drop = func(m *pb.Message) bool {
+		return len(c.removals) > 0 && m.GetFrom() == lead && m.GetTo() == expectedTarget(c.removals[0])
+	}
+}
