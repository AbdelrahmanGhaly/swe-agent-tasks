+func randomRemoval(t *testing.T, async bool, seed int64) {
+	rng := rand.New(rand.NewSource(seed))
+	n := uint64(3 + rng.Intn(3))
+	var voters, learners []uint64
+	for id := uint64(1); id <= n; id++ {
+		voters = append(voters, id)
+	}
+	if rng.Intn(2) == 0 {
+		learners = []uint64{n + 1}
+	}
+	c := elected(t, options{async: async, handOff: true, stepDown: rng.Intn(2) == 0}, voters, learners)
+	var lagging []uint64
+	for _, id := range voters[1:] {
+		if rng.Intn(2) == 0 {
+			lagging = append(lagging, id)
+		}
+	}
+	tail := rng.Intn(4)
+	switch kind := rng.Intn(3); {
+	case kind == 1 && len(learners) == 1:
+		c.proposeConfChange(1, jointChange(single(pb.ConfChangeRemoveNode, 1), single(pb.ConfChangeAddNode, learners[0])))
+		c.settle()
+		c.changeWithTail(1, &pb.ConfChangeV2{}, tail, lagging...)
+	case kind == 2:
+		c.proposeConfChange(1, jointChange(single(pb.ConfChangeAddLearnerNode, 1)))
+		c.settle()
+		c.changeWithTail(1, &pb.ConfChangeV2{}, tail, lagging...)
+	default:
+		c.changeWithTail(1, removeNode(1), tail, lagging...)
+	}
+	if len(c.removals) != 1 {
+		t.Fatalf("seed %d: leader 1 applied %d changes that removed it", seed, len(c.removals))
+	}
+	want := expectedTarget(c.removals[0])
+	defer func() {
+		if t.Failed() {
+			t.Logf("seed %d: voters %v learners %v lagging %v tail %d", seed, voters, learners, lagging, tail)
+		}
+	}()
+	c.requireHandOff(1, want)
+}
+
+func TestRandomRemovalsHandOffToTheRightVoter(t *testing.T) {
+	for seed := int64(1); seed <= 100; seed++ {
+		randomRemoval(t, false, seed)
+	}
+}
+
+func TestAsyncRandomRemovalsHandOffToTheRightVoter(t *testing.T) {
+	for seed := int64(1); seed <= 100; seed++ {
+		randomRemoval(t, true, seed)
+	}
+}
