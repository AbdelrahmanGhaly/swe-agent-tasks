+func testRemovedLeaderStepsDownOneElectionTimeoutAfterTheChange(t *testing.T, async, stepDown bool) {
+	c := elected(t, options{async: async, handOff: true, stepDown: stepDown}, []uint64{1, 2, 3}, nil)
+	for i := 0; i < electionTick/2; i++ {
+		c.tick(1)
+		c.settle()
+	}
+	c.unreachableTarget(1)
+	c.proposeConfChange(1, removeNode(1))
+	c.settle()
+	for i := 1; i < electionTick; i++ {
+		c.tick(1)
+		c.settle()
+		if c.state(1) != raft.StateLeader {
+			t.Fatalf("removed leader 1 stepped down %d ticks after applying the change, want %d", i, electionTick)
+		}
+	}
+	c.tick(1)
+	c.settle()
+	if c.state(1) != raft.StateFollower {
+		t.Fatalf("removed leader 1 is %s %d ticks after applying the change", c.state(1), electionTick)
+	}
+	if lead := c.leader(); lead != 0 {
+		t.Fatalf("node %d leads although the handoff target never heard from node 1", lead)
+	}
+}
