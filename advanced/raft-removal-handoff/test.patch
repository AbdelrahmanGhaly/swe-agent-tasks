+	c.settle()
+	c.releaseApply(1)
+	if c.state(1) != raft.StateLeader {
+		t.Fatalf("removed leader 1 is %s while its handoff is in progress", c.state(1))
+	}
+	if err := c.nodes[1].rn.Propose([]byte("late")); !errors.Is(err, raft.ErrProposalDropped) {
+		t.Fatalf("removed leader 1 accepted a proposal while handing off: %v", err)
+	}
